// The executor: what start begins runs here. An async func is a state machine (the compiler's: its
// frame, its step); its future is its frame. The ready tasks are stepped in turn; one that cannot
// go on parks, and what it waits for wakes it (a task it waits for, once done; a timer; a stream).
// When none is ready, the reactor sleeps until a timer is due; when nothing could wake any task,
// that is a deadlock. The runtime's C keeps the tasks, the ready queue and the timers
// (runtime/yel.h, y_async), so the collector sees them.

from "wasi:clocks" include monotonic-clock;

module async {
    // the executor's parts: a task stepped (its waiters woken once it is done), started (ready at
    // once), the ready queue, whether one is done, and the started ones done let go
    @c(name = "yel_async_run") step-task: extern func(f: future<()>);
    @c(name = "yel_async_spawn", keeps = "f") start-task: extern func(f: future<()>) -> future<()>;
    @c(name = "(y_async_ready && y_async_head < y_async_ready->len)") has-ready: extern func() -> bool;
    @c(name = "yel_async_take_ready") take-ready: extern func() -> future<()>;
    @c(name = "(($1)->done != 0)") task-done: extern func(f: future<()> & readonly) -> bool;
    @c(name = "yel_async_has_ready_of") has-ready-of: extern func(root: future<()> & readonly) -> bool;
    @c(name = "yel_async_take_ready_of") take-ready-of: extern func(root: future<()>) -> future<()>;
    @c(name = "yel_async_prune") drop-done-tasks: extern func();

    // the reactor: no task ready, so sleep until a timer is due (false: none ever will be)
    @c(name = "yel_async_await") await-events: extern func() -> bool;

    // a future done the second time it is stepped: yield-turn wakes its task at once (wait
    // yield-turn() lets the others run), park leaves it waiting for what will wake it
    @c(name = "yel_async_yield") yield-turn: extern func() -> future<()>;
    @c(name = "yel_async_park") park: extern func() -> future<()>;

    // the task being stepped, and a parked one made ready again: a wait for what only yel tells (a
    // place free among several, a signal) is the task kept, parked, and woken by what it waits for
    @c(name = "yel_async_current") current-task: extern func() -> future<()>;
    @c(name = "yel_async_wake") wake-task: extern func(task: future<()>);

    // a future no one waits for any more: the host's end let go (the compiler's, where a local
    // holding one is last used: compiler/ends.yel)
    @c(name = "yel_future_release") release-future: extern func<T>(f: future<T>);

    // YEL_ASYNC_TRACE's: the tasks still waiting and on what (a deadlock: told before the program
    // stops; unset, how to see them), and those never done once main is
    @c(name = "yel_async_trace_deadlock") trace-deadlock: extern func();
    @c(name = "yel_async_trace_end") trace-end: extern func();

    // milliseconds on a clock that only goes on, and the task being stepped woken at one of them
    @c(name = "yel_async_now_ms") now-ms: extern func() -> s64;
    @c(name = "yel_async_timer") wake-at: extern func(at: s64);

    // the root (an async main) started, then each ready task stepped in turn until the root is
    // done (the compiler's C main calls it)
    run-tasks: func(root: future<()>) {
        start-task(root);
        loop {
            if has-ready() { step-task(take-ready()); }
            else {
                // none ready: wait for the host or a timer; nothing to wait for, the program is
                // over once its main is done (a task still writing to the host finishes first)
                drop-done-tasks();
                if !await-events() {
                    if task-done(root) {
                        trace-end();
                        return;
                    }
                    trace-deadlock();
                    panic("every task waits, and nothing will wake one: a deadlock");
                }
            }
        }
    }

    // a component's async export call: its root's ready tasks stepped until none is ready; whether
    // the root is done (else they all wait for the host, which calls back with each event)
    run-ready-of: func(root: future<()>) -> bool {
        loop {
            if !has-ready-of(root) { return task-done(root); }
            step-task(take-ready-of(root));
        }
    }

    // the task waits for ms milliseconds (the others run meanwhile): the clock's wait, the host's
    // in a component (WASI 0.3), the executor's timer natively
    sleep: async func(ms: s64) { wait monotonic-clock.wait-for(ms as u64 * 1000000); }
}
