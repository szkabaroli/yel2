// Characters, as the bytes (s.byte-at(i)) of UTF-8 text: ASCII's classes

is-digit: func(c: s64) -> bool { c >= 48 && c <= 57 }

is-upper: func(c: s64) -> bool { c >= 65 && c <= 90 }

is-lower: func(c: s64) -> bool { c >= 97 && c <= 122 }

is-alpha: func(c: s64) -> bool { is-upper(c) || is-lower(c) }

is-alphanumeric: func(c: s64) -> bool { is-alpha(c) || is-digit(c) }

// a space, a tab, a line break (LF or CR)
is-whitespace: func(c: s64) -> bool { c == 32 || c == 9 || c == 10 || c == 13 }

// a digit's value in radix (2 to 36: 0-9, then a-z or A-Z); none for a byte that is no digit of it
to-digit: func(c: s64, radix: s64) -> option<s64> {
    let value = if is-digit(c) { c - 48 } else if c >= 97 && c <= 122 { c - 87 } else if c >= 65 && c <= 90 { c - 55 } else { radix };
    if value < radix { some(value) } else { none }
}
