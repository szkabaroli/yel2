// Time: an instant (seconds and nanoseconds since 1970-01-01T00:00:00Z, as wasi:clocks' system clock
// and Unix time count them: no leap seconds), a duration, and the calendar (proleptic Gregorian):
// an instant's date and time at an offset from UTC, and back. Written and read as ISO 8601 / RFC
// 3339 (2026-10-05T12:34:56.789Z, as JavaScript's toISOString; an offset as +02:00). Time zones
// beyond a fixed offset are not here: WASI's timezone interface is not in hosts yet.
//
// One of std's packages: from "std:time" include time; then time.now(), time.parse(text),
// time.to-iso(instant), time.to-date-time(instant, offset).

package std:time@0.1.0;

from "std:clocks" include system-clock, monotonic-clock;

module time {
    // a point in time: seconds since 1970-01-01T00:00:00Z, and nanoseconds past them (0 to
    // 999999999, also before 1970: -0.5 s is -1 s and 500000000 ns)
    record instant { seconds: s64, nanoseconds: s64, }

    // a length of time, in nanoseconds (some 292 years either way)
    record duration { nanoseconds: s64, }

    // a date and a time of day, as a calendar has them, at offset minutes from UTC (+120: two hours
    // ahead): month and day from 1, nanosecond past the second
    record date-time { year: s64, month: s64, day: s64, hour: s64, minute: s64, second: s64, nanosecond: s64, offset: s64, }

    // ---- now

    // the time now, by the system's clock
    now: func() -> instant {
        let at = system-clock.now();
        { seconds: at.seconds, nanoseconds: at.nanoseconds as s64, }
    }

    // nanoseconds on a clock that only goes on (for how long something took: one less another)
    monotonic: func() -> u64 { monotonic-clock.now() }

    // ---- instants and durations

    // an instant milliseconds after the epoch (before it: negative), as JavaScript's Date counts
    from-unix-millis: func(milliseconds: s64) -> instant { normalized(floor-div(milliseconds, 1000), floor-mod(milliseconds, 1000) * 1000000) }

    // an instant's milliseconds after the epoch (rounded down)
    unix-millis: func(at: instant) -> s64 { at.seconds * 1000 + at.nanoseconds / 1000000 }

    nanoseconds: func(count: s64) -> duration { { nanoseconds: count, } }
    milliseconds: func(count: s64) -> duration { { nanoseconds: count * 1000000, } }
    seconds: func(count: s64) -> duration { { nanoseconds: count * 1000000000, } }
    minutes: func(count: s64) -> duration { { nanoseconds: count * 60000000000, } }
    hours: func(count: s64) -> duration { { nanoseconds: count * 3600000000000, } }
    days: func(count: s64) -> duration { { nanoseconds: count * 86400000000000, } }

    // an instant a duration later (negative: earlier)
    add: func(at: instant, length: duration) -> instant {
        normalized(at.seconds + floor-div(length.nanoseconds, 1000000000), at.nanoseconds + floor-mod(length.nanoseconds, 1000000000))
    }

    // how long from earlier to later (negative where later is earlier)
    between: func(earlier: instant, later: instant) -> duration {
        { nanoseconds: (later.seconds - earlier.seconds) * 1000000000 + later.nanoseconds - earlier.nanoseconds, }
    }

    // whether a is before b
    before: func(a: instant, b: instant) -> bool { a.seconds < b.seconds || (a.seconds == b.seconds && a.nanoseconds < b.nanoseconds) }

    // ---- the calendar

    // an instant's date and time, offset minutes from UTC
    to-date-time: func(at: instant, offset: s64 = 0) -> date-time {
        let local = at.seconds + offset * 60;
        let day = floor-div(local, 86400);
        let in-day = floor-mod(local, 86400);
        let (year, month, date) = civil(day);
        {
            year: year,
            month: month,
            day: date,
            hour: in-day / 3600,
            minute: in-day / 60 % 60,
            second: in-day % 60,
            nanosecond: at.nanoseconds,
            offset: offset,
        }
    }

    // the instant a date and time is (its offset taken off; its fields need not be in range:
    // month 13 is the next year's first)
    from-date-time: func(when: date-time) -> instant {
        let months = when.month - 1;
        let year = when.year + floor-div(months, 12);
        let month = floor-mod(months, 12) + 1;
        let day = days-from-civil(year, month, 1) + when.day - 1;
        let seconds = day * 86400 + when.hour * 3600 + when.minute * 60 + when.second - when.offset * 60;
        normalized(seconds + floor-div(when.nanosecond, 1000000000), floor-mod(when.nanosecond, 1000000000))
    }

    // the day of the week, 0 Sunday to 6 Saturday
    weekday: func(when: date-time) -> s64 { floor-mod(days-from-civil(when.year, when.month, when.day) + 4, 7) }

    // the day of the year, from 1
    day-of-year: func(when: date-time) -> s64 { days-from-civil(when.year, when.month, when.day) - days-from-civil(when.year, 1, 1) + 1 }

    is-leap-year: func(year: s64) -> bool { year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }

    days-in-month: func(year: s64, month: s64) -> s64 {
        if month == 2 { return if is-leap-year(year) { 29 } else { 28 }; }
        if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }
    }

    // ---- ISO 8601

    // an instant as JavaScript's toISOString writes it: 2026-10-05T12:34:56.789Z (milliseconds; a
    // year past 0..9999 as ±YYYYYY)
    to-iso: func(at: instant) -> string {
        let when = to-date-time(at, 0);
        "{year-text(when.year)}-{two(when.month)}-{two(when.day)}T{two(when.hour)}:{two(when.minute)}:{two(when.second)}.{padded(when.nanosecond / 1000000, 3)}Z"
    }

    // a date and time as RFC 3339 writes it: its offset (Z for none), its second's fraction only
    // where there is one (its digits as many as it needs: .5, .123456789)
    format: func(when: date-time) -> string {
        let fraction = if when.nanosecond == 0 { "" } else { "." + without-zeros(padded(when.nanosecond, 9)) };
        let offset = if when.offset == 0 { "Z" } else {
            let sign = if when.offset < 0 { "-" } else { "+" };
            let minutes = if when.offset < 0 { 0 - when.offset } else { when.offset };
            "{sign}{two(minutes / 60)}:{two(minutes % 60)}"
        };
        "{year-text(when.year)}-{two(when.month)}-{two(when.day)}T{two(when.hour)}:{two(when.minute)}:{two(when.second)}{fraction}{offset}"
    }

    // an ISO 8601 / RFC 3339 date and time's instant: a date (2026-10-05: its start, UTC), a date
    // and a time (T or a space between: 12:34, 12:34:56, 12:34:56.789123), then Z, ±HH:MM, ±HHMM or
    // ±HH (none: UTC)
    parse: func(text: string) -> result<instant, string> {
        match read-date-time(text) {
            ok(when) => ok(from-date-time(when)),
            err(problem) => err(problem),
        }
    }

    // as parse, its date and time as written (at its offset)
    parse-date-time: func(text: string) -> result<date-time, string> { read-date-time(text) }

    // ---- shown

    // an instant as to-iso writes it
    display: func(at: instant) -> string { to-iso(at) }

    // ---- reading

    @(private) read-date-time: func(text: string) -> result<date-time, string> {
        let r: reader = { text: text, at: 0, };
        let year = 0;
        let sign = if text.starts-with("+") { 1 } else if text.starts-with("-") { -1 } else { 0 };
        if sign != 0 {
            r.at = 1;
            match digits(r, 6) {
                some(value) => { year = sign * value; }
                none => { return err("an expanded year is a sign and six digits, at 0"); }
            }
        } else {
            match digits(r, 4) {
                some(value) => { year = value; }
                none => { return err("a year is four digits, at 0"); }
            }
        }
        if !take(r, 45) { return err("expected - at {r.at}"); }
        let month = match digits(r, 2) {
            some(value) => value,
            none => { return err("a month is two digits, at {r.at}"); }
        };
        if !take(r, 45) { return err("expected - at {r.at}"); }
        let day = match digits(r, 2) {
            some(value) => value,
            none => { return err("a day is two digits, at {r.at}"); }
        };
        if month < 1 || month > 12 { return err("no month {month}"); }
        if day < 1 || day > days-in-month(year, month) { return err("no day {day} in {year}-{two(month)}"); }
        let when: date-time = { year: year, month: month, day: day, hour: 0, minute: 0, second: 0, nanosecond: 0, offset: 0, };
        if r.at == text.len() { return ok(when); }
        if !take(r, 84) && !take(r, 116) && !take(r, 32) { return err("expected T at {r.at}"); }
        match digits(r, 2) {
            some(value) => { when.hour = value; }
            none => { return err("an hour is two digits, at {r.at}"); }
        }
        if !take(r, 58) { return err("expected : at {r.at}"); }
        match digits(r, 2) {
            some(value) => { when.minute = value; }
            none => { return err("a minute is two digits, at {r.at}"); }
        }
        if take(r, 58) {
            match digits(r, 2) {
                some(value) => { when.second = value; }
                none => { return err("a second is two digits, at {r.at}"); }
            }
            if take(r, 46) || take(r, 44) {
                // a fraction: its first nine digits (more are read, and dropped)
                let start = r.at;
                let nanos = 0;
                let count = 0;
                loop {
                    if r.at >= text.len() || !is-digit(text.byte-at(r.at)) { break; }
                    if count < 9 { nanos = nanos * 10 + text.byte-at(r.at) - 48; count += 1; }
                    r.at += 1;
                }
                if r.at == start { return err("a fraction has digits, at {start}"); }
                for index in count..9 { nanos *= 10; }
                when.nanosecond = nanos;
            }
        }
        if when.hour > 24 || when.minute > 59 || when.second > 60 || (when.hour == 24 && (when.minute > 0 || when.second > 0 || when.nanosecond > 0)) {
            return err("no time {two(when.hour)}:{two(when.minute)}:{two(when.second)}");
        }
        // (a leap second, :60, is the next minute's first: Unix time has none)
        if r.at == text.len() { return ok(when); }
        if take(r, 90) || take(r, 122) {
            if r.at != text.len() { return err("text after Z at {r.at}"); }
            return ok(when);
        }
        let offset-sign = if take(r, 43) { 1 } else if take(r, 45) { -1 } else { return err("expected Z, + or - at {r.at}"); };
        let hours = match digits(r, 2) {
            some(value) => value,
            none => { return err("an offset's hours are two digits, at {r.at}"); }
        };
        let minutes = 0;
        if r.at < text.len() {
            let _ = take(r, 58);
            match digits(r, 2) {
                some(value) => { minutes = value; }
                none => { return err("an offset's minutes are two digits, at {r.at}"); }
            }
        }
        if r.at != text.len() { return err("text after the offset at {r.at}"); }
        if hours > 23 || minutes > 59 { return err("no offset {two(hours)}:{two(minutes)}"); }
        when.offset = offset-sign * (hours * 60 + minutes);
        ok(when)
    }

    // what is being read, and where
    @(private) resource reader { text: string, at: s64, }

    // count digits' value (none: not that many there)
    @(private) digits: func(r: reader, count: s64) -> option<s64> {
        if r.at + count > r.text.len() { return none; }
        let value = 0;
        for index in 0..count {
            let b = r.text.byte-at(r.at + index);
            if !is-digit(b) { return none; }
            value = value * 10 + b - 48;
        }
        r.at += count;
        some(value)
    }

    // the byte b, taken if it is next
    @(private) take: func(r: reader, b: s64) -> bool {
        if r.at < r.text.len() && r.text.byte-at(r.at) == b {
            r.at += 1;
            return true;
        }
        false
    }

    // ---- the calendar's arithmetic (Howard Hinnant's days-from-civil and civil-from-days)

    // the days from 1970-01-01 to a date
    @(private) days-from-civil: func(y0: s64, month: s64, day: s64) -> s64 {
        let year = if month <= 2 { y0 - 1 } else { y0 };
        let era = floor-div(year, 400);
        let year-of-era = year - era * 400;
        let day-of-year = (153 * (if month > 2 { month - 3 } else { month + 9 }) + 2) / 5 + day - 1;
        let day-of-era = year-of-era * 365 + year-of-era / 4 - year-of-era / 100 + day-of-year;
        era * 146097 + day-of-era - 719468
    }

    // the date days after 1970-01-01: year, month, day
    @(private) civil: func(days: s64) -> tuple<s64, s64, s64> {
        let z = days + 719468;
        let era = floor-div(z, 146097);
        let day-of-era = z - era * 146097;
        let year-of-era = (day-of-era - day-of-era / 1460 + day-of-era / 36524 - day-of-era / 146096) / 365;
        let day-of-year = day-of-era - (365 * year-of-era + year-of-era / 4 - year-of-era / 100);
        let shifted = (5 * day-of-year + 2) / 153;
        let day = day-of-year - (153 * shifted + 2) / 5 + 1;
        let month = if shifted < 10 { shifted + 3 } else { shifted - 9 };
        (year-of-era + era * 400 + (if month <= 2 { 1 } else { 0 }), month, day)
    }

    // seconds and nanoseconds, the nanoseconds brought into 0 to 999999999
    @(private) normalized: func(seconds: s64, nanos: s64) -> instant {
        { seconds: seconds + floor-div(nanos, 1000000000), nanoseconds: floor-mod(nanos, 1000000000), }
    }

    @(private) floor-div: func(a: s64, b: s64) -> s64 {
        let q = a / b;
        if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
    }

    @(private) floor-mod: func(a: s64, b: s64) -> s64 { a - floor-div(a, b) * b }

    // ---- writing

    @(private) two: func(n: s64) -> string { padded(n, 2) }

    @(private) padded: func(n: s64, width: s64) -> string { "{n}".pad-start(width, "0") }

    // a year as ISO 8601 writes it: four digits, or (past 0..9999) a sign and six
    @(private) year-text: func(year: s64) -> string {
        if year >= 0 && year <= 9999 { return padded(year, 4); }
        let sign = if year < 0 { "-" } else { "+" };
        sign + padded(if year < 0 { 0 - year } else { year }, 6)
    }

    // digits with the zeros at their end taken off
    @(private) without-zeros: func(digits: string) -> string {
        let end = digits.len();
        loop {
            if end <= 1 || digits.byte-at(end - 1) != 48 { break; }
            end -= 1;
        }
        digits.slice(0, end)
    }

    // n / unit as a decimal: its fraction's zeros at the end left off (1.5, 2)
    decimal: func(n: s64, unit: s64) -> string {
        let whole = n / unit;
        let rest = n % unit;
        if rest == 0 { return "{whole}"; }
        let width = "{unit}".len() - 1;
        "{whole}.{without-zeros(padded(rest, width))}"
    }
}

// how a duration shows (a module of its own: time's display is an instant's)
module durations {
    // a duration as Go shows one: 1h2m3.5s, 1.5ms, 0s
    display: func(length: time.duration) -> string {
        let n = length.nanoseconds;
        if n == 0 { return "0s"; }
        let sign = if n < 0 { "-" } else { "" };
        let left = if n < 0 { 0 - n } else { n };
        if left < 1000 { return "{sign}{left}ns"; }
        if left < 1000000 { return "{sign}{time.decimal(left, 1000)}µs"; }
        if left < 1000000000 { return "{sign}{time.decimal(left, 1000000)}ms"; }
        let out = sign;
        let hours = left / 3600000000000;
        if hours > 0 { out = out + "{hours}h"; }
        let minutes = left / 60000000000 % 60;
        if hours > 0 || minutes > 0 { out = out + "{minutes}m"; }
        out + "{time.decimal(left % 60000000000, 1000000000)}s"
    }
}
