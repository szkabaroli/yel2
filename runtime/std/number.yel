// Numbers from text: a decimal integer (a - before it for a negative one); none for anything else,
// or one past s64's range

parse-int: func(s: string) -> option<s64> {
    let n = s.len();
    let neg = n > 0 && s.byte-at(0) == 45;
    let start = if neg { 1 } else { 0 };
    if start >= n { return none; }
    // negative all the way, so s64's least value fits
    let least: s64 = -9223372036854775808;
    let v: s64 = 0;
    for i in start..n {
        let c = s.byte-at(i);
        if !is-digit(c) { return none; }
        let d = (c - 48) as s64;
        if v < (least + d) / 10 { return none; }
        v = v * 10 - d;
    }
    if neg { return some(v); }
    if v == least { return none; }
    some(-v)
}
