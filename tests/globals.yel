// globals: let name: T; (its zero value) or let name: T = literal;. No code of the program runs
// before main: a global starts as its literal, or zero (0, false, "", none, a collection made
// empty, and a tuple or fixed-length list of such); a record is held in an option
resource Node { value: s64, next: option<Node>, }

let count: s64;
let label: string = "start";
let ratio: f64 = -0.5;
let last: option<Node>;
let seen: list<string>;
let ages: map<string, s64>;
let tags: set<string>;
let pair: tuple<s32, list<s64>>;
let slots: list<s64, 3>;

module counter {
    let total: u32 = 7;

    bump: func(by: u32) -> u32 {
        total += by;
        total
    }
}

remember: func(text: string) {
    count += 1;
    seen.push(text);
    ages.set(text, text.len());
    tags.add(text);
    last = some({ value: count, next: last, });
}

chain: func() -> s64 {
    let total = 0;
    let at = last;
    loop {
        match at {
            some(n) => {
                total += n.value;
                at = n.next;
            }
            none => { break; }
        }
    }
    total
}

main: func() -> s32 {
    print("{count} {label} {ratio} {last.is-some()} {seen.len()} {ages.len()} {tags.len()} {pair.0} {pair.1.len()} {slots[2]}\n");
    // a local hides a global of its name
    let count = 100;
    print("local {count}\n");
    for word in ["a", "bb", "a", "ccc",] { remember(word); }
    print("{seen} {ages["bb"]} {tags.len()} {chain()}\n");
    label = label + "ed";
    pair.1.push(5);
    slots.set(2, 9);
    print("{label} {pair.1} {slots[2]} {counter.bump(3)} {counter.bump(1)}\n");
    // made while the globals hold what they hold: the collector must keep it
    for i in 0..20000 { remember("w{i % 50}"); }
    print("{seen.len()} {ages.len()} {tags.len()} {chain() % 1000}\n");
    0
}
