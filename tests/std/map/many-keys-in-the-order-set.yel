// ---
// description: a grown map keeps the order of first setting
// features: [map]
// ---
from "std:testing" include expect;

main: func() {
    let m: map<s64, s64> = map.new();
    for key in 0..100 { m.set(99 - key, key); }
    let keys = m.keys();
    for index in 0..100 { expect.equal(keys[index], 99 - index); }
}
