// ---
// description: a map keeps every key as it grows many times over
// features: [map]
// ---
from "std:testing" include expect;

main: func() {
    let m: map<s32, s32> = map.new();
    for key in 0..1000 { m.set(key, key * 3); }
    expect.equal(m.len(), 1000);
    for key in 0..1000 { expect.equal(m[key], key * 3); }
    expect.equal(m.keys()[0], 0);
    expect.equal(m.keys()[999], 999);
}
