// ---
// description: push grows a list of strings and keeps them
// features: [list]
// ---
from "std:testing" include expect;

main: func() {
    let words: list<string> = [];
    for index in 0..200 { words.push("word {index}"); }
    expect.equal(words.len(), 200);
    expect.equal(words[0], "word 0");
    expect.equal(words[199], "word 199");
}
