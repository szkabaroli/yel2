// ---
// description: regex /x*/ on "abc": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /x*/;
    let text = "abc";
    expect.equal(shown(regex-under-test.find(text)), "\"\"@0-0[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"\"@0-0[] \"\"@1-1[] \"\"@2-2[] \"\"@3-3[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "<>a<>b<>c<>");
}
