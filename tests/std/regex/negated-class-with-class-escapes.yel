// ---
// description: regex /[^\d\s]+/ on "12 ab 34": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /[^\d\s]+/;
    let text = "12 ab 34";
    expect.equal(shown(regex-under-test.find(text)), "\"ab\"@3-5[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"ab\"@3-5[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "12 <ab> 34");
}
