// ---
// description: regex /é+/ on "café ééé": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /é+/;
    let text = "café ééé";
    expect.equal(shown(regex-under-test.find(text)), "\"é\"@3-5[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"é\"@3-5[] \"ééé\"@6-12[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "caf<é> <ééé>");
}
