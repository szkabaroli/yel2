// ---
// description: regex /cat|dog|bird/ on "a dog and a bird": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /cat|dog|bird/;
    let text = "a dog and a bird";
    expect.equal(shown(regex-under-test.find(text)), "\"dog\"@2-5[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"dog\"@2-5[] \"bird\"@12-16[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "a <dog> and a <bird>");
}
