// ---
// description: regex /\d+/ on "a12b345": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /\d+/;
    let text = "a12b345";
    expect.equal(shown(regex-under-test.find(text)), "\"12\"@1-3[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"12\"@1-3[] \"345\"@4-7[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "a<12>b<345>");
}
