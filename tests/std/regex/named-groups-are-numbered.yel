// ---
// description: regex /(?<year>\d(4))-(?<month>\d\d)/ on "on 2026-10-05": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /(?<year>\d{4})-(?<month>\d\d)/;
    let text = "on 2026-10-05";
    expect.equal(shown(regex-under-test.find(text)), "\"2026-10\"@3-10[2026,10]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"2026-10\"@3-10[2026,10]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "on <2026-10>-05");
}
