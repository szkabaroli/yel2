// ---
// description: regex /a?/ on "baaac": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /a?/;
    let text = "baaac";
    expect.equal(shown(regex-under-test.find(text)), "\"\"@0-0[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"\"@0-0[] \"a\"@1-2[] \"a\"@2-3[] \"a\"@3-4[] \"\"@4-4[] \"\"@5-5[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "<>b<a><a><a><>c<>");
}
