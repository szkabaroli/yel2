// ---
// description: regex /a(2,3)?/ on "aaaa": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /a{2,3}?/;
    let text = "aaaa";
    expect.equal(shown(regex-under-test.find(text)), "\"aa\"@0-2[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"aa\"@0-2[] \"aa\"@2-4[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "<aa><aa>");
}
