// ---
// description: regex /\bfoo\b/ on "foo food foo": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /\bfoo\b/;
    let text = "foo food foo";
    expect.equal(shown(regex-under-test.find(text)), "\"foo\"@0-3[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"foo\"@0-3[] \"foo\"@9-12[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "<foo> food <foo>");
}
