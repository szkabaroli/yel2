// ---
// description: regex /HeLLo/i on "say hello HELLO": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /HeLLo/i;
    let text = "say hello HELLO";
    expect.equal(shown(regex-under-test.find(text)), "\"hello\"@4-9[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"hello\"@4-9[] \"HELLO\"@10-15[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "say <hello> <HELLO>");
}
