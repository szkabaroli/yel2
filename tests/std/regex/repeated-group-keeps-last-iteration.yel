// ---
// description: regex /([a-c])([d-f])*/ on "adef bfe": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /([a-c])([d-f])*/;
    let text = "adef bfe";
    expect.equal(shown(regex-under-test.find(text)), "\"adef\"@0-4[a,f]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"adef\"@0-4[a,f] \"bfe\"@5-8[b,e]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "<adef> <bfe>");
}
