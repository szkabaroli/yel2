// ---
// description: regex /\Boo\B/ on "food boot": its first match, every match, and each made <$&>
// features: [regex]
// ---
from "std:testing" include expect;

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for group in m.groups { groups.push(group.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

shown: func(found: option<regex-match>) -> string {
    match found {
        some(m) => show(m),
        none => "none",
    }
}

main: func() {
    let regex-under-test = /\Boo\B/;
    let text = "food boot";
    expect.equal(shown(regex-under-test.find(text)), "\"oo\"@1-3[]");
    expect.equal(regex-under-test.find-all(text).map(show).join(" "), "\"oo\"@1-3[] \"oo\"@6-8[]");
    expect.equal(regex-under-test.replace-all(text, "<$&>"), "f<oo>d b<oo>t");
}
