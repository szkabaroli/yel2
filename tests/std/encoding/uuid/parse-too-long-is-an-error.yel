// ---
// description: uuid.parse refuses text that is too long
// features: [encoding, uuid]
// ---
from "std:testing" include expect;
from "std:encoding/uuid" include uuid;

main: func() {
    expect.equal(expect.err(uuid.parse("550e8400-e29b-41d4-a716-4466554400000")), "a UUID is 36 characters, not 37");
}
