// ---
// description: uuid.parse tells where a dash is missing
// features: [encoding, uuid]
// ---
from "std:testing" include expect;
from "std:encoding/uuid" include uuid;

main: func() {
    expect.equal(expect.err(uuid.parse("550e8400xe29b-41d4-a716-446655440000")), "expected '-' at byte 8");
}
