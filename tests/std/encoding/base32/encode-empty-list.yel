// ---
// description: base32 of no bytes is empty
// features: [encoding, base32]
// ---
from "std:testing" include expect;
from "std:encoding/base32" include base32;

main: func() {
    let nothing: list<u8> = [];
    expect.equal(base32.encode(nothing), "");
    expect.equal(base32.encode-unpadded(nothing), "");
}
