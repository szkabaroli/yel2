// ---
// description: base32.decode refuses the digits 0, 1, 8 and 9
// features: [encoding, base32]
// ---
from "std:testing" include expect;
from "std:encoding/base32" include base32;

main: func() {
    expect.equal(expect.err(base32.decode("M1======")), "not a base32 character at byte 1");
    expect.equal(expect.err(base32.decode("M8======")), "not a base32 character at byte 1");
}
