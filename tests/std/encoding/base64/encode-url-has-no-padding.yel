// ---
// description: base64.encode-url leaves out the padding
// features: [encoding, base64]
// ---
from "std:testing" include expect;
from "std:encoding/base64" include base64;

main: func() {
    expect.equal(base64.encode-url([0xFB, 0xFF,]), "-_8");
    expect.equal(base64.encode-url([0xFB,]), "-w");
}
