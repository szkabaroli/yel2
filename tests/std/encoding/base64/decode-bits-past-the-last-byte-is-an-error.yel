// ---
// description: base64.decode refuses spare bits that are not zero
// features: [encoding, base64]
// ---
from "std:testing" include expect;
from "std:encoding/base64" include base64;

main: func() {
    expect.equal(expect.err(base64.decode("Zh==")), "bits past the last byte at byte 1");
    expect.equal(expect.err(base64.decode("Zm9")), "bits past the last byte at byte 2");
}
