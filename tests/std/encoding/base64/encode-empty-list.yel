// ---
// description: base64 of no bytes is empty
// features: [encoding, base64]
// ---
from "std:testing" include expect;
from "std:encoding/base64" include base64;

main: func() {
    let nothing: list<u8> = [];
    expect.equal(base64.encode(nothing), "");
    expect.equal(base64.encode-url(nothing), "");
}
