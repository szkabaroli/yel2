// ---
// description: an array's value holds its items in order
// features: [encoding, json]
// ---
from "std:testing" include expect;
from "std:encoding/json" include json;

// text read, then written again (or where reading it stopped)
again: func(text: string) -> string {
    match json.parse(text) {
        ok(item) => json.write(item),
        err(error) => "error: {error}",
    }
}

main: func() {
    match expect.ok(json.parse("[1, 2, 3]")) {
        array(items) => expect.equal(items.len(), 3),
        _ => expect.fail("not an array"),
    }
}
