// ---
// description: expect.equal passes for two records with the same fields
// features: [testing]
// ---
from "std:testing" include expect;

resource Point { x: s32, y: s32, }

main: func() {
    let first: Point = { x: 1, y: 2, };
    let second: Point = { x: 1, y: 2, };
    expect.equal(first, second);
}
