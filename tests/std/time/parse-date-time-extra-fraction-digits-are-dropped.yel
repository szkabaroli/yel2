// ---
// description: parse-date-time drops fraction digits past the ninth
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when = expect.ok(time.parse-date-time("2026-10-05T12:00:00.1234567899Z"));
    expect.equal(when.nanosecond, 123456789);
}
