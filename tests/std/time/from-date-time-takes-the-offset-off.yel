// ---
// description: from-date-time takes a date and time to be at its offset
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when: time.date-time = { year: 2025, month: 10, day: 5, hour: 12, minute: 34, second: 56, nanosecond: 789000000, offset: 120, };
    expect.equal(time.unix-millis(time.from-date-time(when)), 1759660496789);
}
