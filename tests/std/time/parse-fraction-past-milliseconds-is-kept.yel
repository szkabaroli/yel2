// ---
// description: time.parse of "2026-10-05T12:34:56.789123456Z" gives 1791203696789 milliseconds
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    expect.equal(time.unix-millis(expect.ok(time.parse("2026-10-05T12:34:56.789123456Z"))), 1791203696789);
}
