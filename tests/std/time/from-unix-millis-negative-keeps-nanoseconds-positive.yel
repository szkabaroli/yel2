// ---
// description: from-unix-millis of a negative number gives nanoseconds from 0 to 999999999
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(-500);
    expect.equal(at.seconds, -1);
    expect.equal(at.nanoseconds, 500000000);
}
