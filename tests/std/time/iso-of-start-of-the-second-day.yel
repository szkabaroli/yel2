// ---
// description: time.to-iso and time.weekday of 86400000 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(86400000);
    expect.equal(time.to-iso(at), "1970-01-02T00:00:00.000Z");
    expect.equal(time.weekday(time.to-date-time(at)), 5);
}
