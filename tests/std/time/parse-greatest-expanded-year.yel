// ---
// description: time.parse of "+275760-09-13T00:00:00Z" gives 8640000000000000 milliseconds
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    expect.equal(time.unix-millis(expect.ok(time.parse("+275760-09-13T00:00:00Z"))), 8640000000000000);
}
