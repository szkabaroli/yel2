// ---
// description: to-date-time knows 29 February of a leap year
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when = time.to-date-time(time.from-unix-millis(1709164800000));
    expect.equal((when.year, when.month, when.day), (2024, 2, 29));
}
