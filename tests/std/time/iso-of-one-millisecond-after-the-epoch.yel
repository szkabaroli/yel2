// ---
// description: time.to-iso and time.weekday of 1 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(1);
    expect.equal(time.to-iso(at), "1970-01-01T00:00:00.001Z");
    expect.equal(time.weekday(time.to-date-time(at)), 4);
}
