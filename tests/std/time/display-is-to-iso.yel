// ---
// description: an instant shown in a string is written as to-iso gives it
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(1759660496789);
    expect.equal("{at}", time.to-iso(at));
    expect.equal(time.display(at), "2025-10-05T10:34:56.789Z");
}
