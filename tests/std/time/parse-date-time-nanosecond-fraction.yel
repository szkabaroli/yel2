// ---
// description: parse-date-time reads a fraction of nine digits
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when = expect.ok(time.parse-date-time("2026-10-05T12:00:00.000000001Z"));
    expect.equal(when.nanosecond, 1);
}
