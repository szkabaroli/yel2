// ---
// description: time.to-iso and time.weekday of 4107542399999 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(4107542399999);
    expect.equal(time.to-iso(at), "2100-02-28T23:59:59.999Z");
    expect.equal(time.weekday(time.to-date-time(at)), 0);
}
