// ---
// description: February has 28 days, or 29 in a leap year
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    expect.equal(time.days-in-month(2023, 2), 28);
    expect.equal(time.days-in-month(2024, 2), 29);
    expect.equal(time.days-in-month(1900, 2), 28);
    expect.equal(time.days-in-month(2000, 2), 29);
}
