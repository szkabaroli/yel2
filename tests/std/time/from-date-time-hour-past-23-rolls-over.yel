// ---
// description: from-date-time takes hour 25 as 1 am of the next day
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when: time.date-time = { year: 2026, month: 1, day: 1, hour: 25, minute: 0, second: 0, nanosecond: 0, offset: 0, };
    expect.equal(time.to-iso(time.from-date-time(when)), "2026-01-02T01:00:00.000Z");
}
