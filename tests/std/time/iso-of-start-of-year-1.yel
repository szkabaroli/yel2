// ---
// description: time.to-iso and time.weekday of -62135596800000 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(-62135596800000);
    expect.equal(time.to-iso(at), "0001-01-01T00:00:00.000Z");
    expect.equal(time.weekday(time.to-date-time(at)), 1);
}
