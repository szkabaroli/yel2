// ---
// description: to-iso cuts the nanoseconds below a millisecond
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at: time.instant = { seconds: 0, nanoseconds: 123999999, };
    expect.equal(time.to-iso(at), "1970-01-01T00:00:00.123Z");
}
