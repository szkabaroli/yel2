// ---
// description: time.parse refuses an offset with one digit of minutes
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    expect.equal(expect.err(time.parse("2026-10-05T12:34:56+01:0")), "an offset's minutes are two digits, at 23");
}
