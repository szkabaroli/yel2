// ---
// description: format writes a fraction of nine digits where it needs them
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when: time.date-time = { year: 2026, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 1, offset: 0, };
    expect.equal(time.format(when), "2026-01-01T00:00:00.000000001Z");
}
