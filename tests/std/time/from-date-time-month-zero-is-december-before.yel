// ---
// description: from-date-time takes month 0 as December of the year before
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when: time.date-time = { year: 2026, month: 0, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0, offset: 0, };
    expect.equal(time.to-iso(time.from-date-time(when)), "2025-12-01T00:00:00.000Z");
}
