// ---
// description: parse-date-time reads what format writes
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let text = "2026-10-05T12:34:56.789123+05:45";
    expect.equal(time.format(expect.ok(time.parse-date-time(text))), text);
}
