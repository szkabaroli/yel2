// ---
// description: time.parse of "-000001-01-01T00:00:00Z" gives -62198755200000 milliseconds
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    expect.equal(time.unix-millis(expect.ok(time.parse("-000001-01-01T00:00:00Z"))), -62198755200000);
}
