// ---
// description: time.to-iso and time.weekday of -1000 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(-1000);
    expect.equal(time.to-iso(at), "1969-12-31T23:59:59.000Z");
    expect.equal(time.weekday(time.to-date-time(at)), 3);
}
