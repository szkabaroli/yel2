// ---
// description: parse-date-time keeps the offset it reads
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when = expect.ok(time.parse-date-time("2026-10-05T12:00:00-05:30"));
    expect.equal(when.offset, -330);
    expect.equal(when.hour, 12);
}
