// ---
// description: time.to-iso and time.weekday of 1759660496789 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(1759660496789);
    expect.equal(time.to-iso(at), "2025-10-05T10:34:56.789Z");
    expect.equal(time.weekday(time.to-date-time(at)), 0);
}
