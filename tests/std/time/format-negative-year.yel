// ---
// description: format writes a negative year with a sign and six digits
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when: time.date-time = { year: -44, month: 3, day: 15, hour: 0, minute: 0, second: 0, nanosecond: 0, offset: 0, };
    expect.equal(time.format(when), "-000044-03-15T00:00:00Z");
}
