// ---
// description: time.to-iso and time.weekday of 14 instants, far past
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let rows: list<tuple<s64, string, s64>> = [
        (-1527494855226057, "-046435-08-13T09:32:53.943Z", 5),
        (-7770150362700720, "-244257-09-27T03:14:59.280Z", 5),
        (-6944301660270549, "-218087-11-04T04:35:29.451Z", 2),
        (-4772341115826443, "-149260-07-13T10:02:53.557Z", 6),
        (-7091715668356904, "-222758-06-23T13:00:43.096Z", 1),
        (-1106878903392422, "-033106-05-27T13:56:47.578Z", 4),
        (-4304603876815985, "-134438-07-14T20:53:04.015Z", 6),
        (-7575159819908570, "-238078-09-29T02:54:51.430Z", 5),
        (-7525589355262551, "-236507-07-26T08:25:37.449Z", 3),
        (-7746679458440684, "-243513-07-02T02:52:39.316Z", 3),
        (-4657341352912180, "-145616-09-23T04:38:07.820Z", 0),
        (-6240934955542837, "-195798-08-24T12:47:37.163Z", 2),
        (-1089463429638762, "-032554-04-12T13:32:41.238Z", 0),
        (-6783516789959285, "-212992-11-29T04:34:00.715Z", 2),
    ];
    for row in rows {
        let (millis, iso, weekday) = row;
        let at = time.from-unix-millis(millis);
        expect.equal(time.to-iso(at), iso);
        expect.equal(time.weekday(time.to-date-time(at)), weekday);
    }
}
