// ---
// description: from-date-time takes month 13 as January of the next year
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let when: time.date-time = { year: 2025, month: 13, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0, offset: 0, };
    expect.equal(time.to-iso(time.from-date-time(when)), "2026-01-01T00:00:00.000Z");
}
