// ---
// description: time.to-iso and time.weekday of 1709164800000 milliseconds after the epoch
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let at = time.from-unix-millis(1709164800000);
    expect.equal(time.to-iso(at), "2024-02-29T00:00:00.000Z");
    expect.equal(time.weekday(time.to-date-time(at)), 4);
}
