// ---
// description: time.to-iso and time.weekday of 16 instants, far future
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let rows: list<tuple<s64, string, s64>> = [
        (8435223696684088, "+269271-08-06T21:31:24.088Z", 4),
        (6154762486492979, "+197006-08-29T22:14:52.979Z", 5),
        (1858576679291384, "+060865-12-13T03:48:11.384Z", 0),
        (7747770089538677, "+247487-01-22T22:12:18.677Z", 6),
        (1286782207195097, "+042746-07-04T13:59:55.097Z", 4),
        (1546308767749295, "+050970-07-29T05:15:49.295Z", 0),
        (8427736709561379, "+269034-05-06T22:52:41.379Z", 2),
        (2720344075546713, "+088174-04-09T20:05:46.713Z", 6),
        (1862340194825909, "+060985-03-18T08:47:05.909Z", 5),
        (1908175869641935, "+062437-09-07T20:40:41.935Z", 1),
        (1387980037085104, "+045953-05-03T18:18:05.104Z", 0),
        (1100127453439652, "+036831-08-26T15:17:19.652Z", 2),
        (1644664768405952, "+054087-05-08T20:33:25.952Z", 4),
        (1452697729149496, "+048004-02-28T02:59:09.496Z", 6),
        (3645869124593711, "+117502-12-30T07:29:53.711Z", 2),
        (1649902325579665, "+054253-04-28T17:32:59.665Z", 4),
    ];
    for row in rows {
        let (millis, iso, weekday) = row;
        let at = time.from-unix-millis(millis);
        expect.equal(time.to-iso(at), iso);
        expect.equal(time.weekday(time.to-date-time(at)), weekday);
    }
}
