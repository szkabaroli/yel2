// ---
// description: time.to-iso and time.weekday of 23 instants, modern
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let rows: list<tuple<s64, string, s64>> = [
        (652011554119, "1990-08-30T10:19:14.119Z", 4),
        (3960956903479, "2095-07-08T09:48:23.479Z", 5),
        (3364571358687, "2076-08-13T19:09:18.687Z", 4),
        (3675846713684, "2086-06-25T12:31:53.684Z", 2),
        (3094453084911, "2068-01-22T10:18:04.911Z", 0),
        (2180222211120, "2039-02-02T01:16:51.120Z", 3),
        (1183130875821, "2007-06-29T15:27:55.821Z", 5),
        (583959798823, "1988-07-03T19:03:18.823Z", 0),
        (1639577050799, "2021-12-15T14:04:10.799Z", 3),
        (3353057572641, "2076-04-02T12:52:52.641Z", 4),
        (2023120696007, "2034-02-09T17:58:16.007Z", 4),
        (2950207888672, "2063-06-27T22:11:28.672Z", 3),
        (3501632814864, "2080-12-17T03:46:54.864Z", 2),
        (449199802600, "1984-03-27T01:43:22.600Z", 2),
        (2009729002751, "2033-09-07T18:03:22.751Z", 3),
        (2708656856962, "2055-11-01T04:40:56.962Z", 1),
        (3908136458910, "2093-11-04T01:27:38.910Z", 3),
        (1990644773324, "2033-01-29T20:52:53.324Z", 6),
        (2082477822095, "2035-12-28T18:03:42.095Z", 5),
        (3370534539213, "2076-10-21T19:35:39.213Z", 3),
        (1374879321814, "2013-07-26T22:55:21.814Z", 5),
        (1726022150966, "2024-09-11T02:35:50.966Z", 3),
        (2920540314021, "2062-07-19T13:11:54.021Z", 3),
    ];
    for row in rows {
        let (millis, iso, weekday) = row;
        let at = time.from-unix-millis(millis);
        expect.equal(time.to-iso(at), iso);
        expect.equal(time.weekday(time.to-date-time(at)), weekday);
    }
}
