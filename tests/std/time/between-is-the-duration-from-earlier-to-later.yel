// ---
// description: between gives how long from the first instant to the second
// features: [time]
// ---
from "std:testing" include expect;
from "std:time" include time;

main: func() {
    let start = time.from-unix-millis(1000);
    let later = time.add(start, time.minutes(90));
    expect.equal(time.between(start, later), time.minutes(90));
}
