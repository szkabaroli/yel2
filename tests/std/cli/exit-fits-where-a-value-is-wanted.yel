// ---
// description: a call of exit has the type never, so it fits where a value is wanted
// features: [cli]
// ---
from "std:testing" include expect;
from "std:cli" include environment, exit;

main: func() {
    let value: s32 = if true { 3 } else { exit.exit(err(())) };
    expect.equal(value, 3);
}
