// ---
// description: write leaves out a port, query and fragment that are none
// features: [url]
// ---
from "std:testing" include expect;
from "std:url" include url;

main: func() {
    let made: url.parts = {
        scheme: "https",
        username: "",
        password: "",
        host: some("example.com"),
        port: none,
        path: "/a",
        query: none,
        fragment: none,
    };
    expect.equal(url.write(made), "https://example.com/a");
}
