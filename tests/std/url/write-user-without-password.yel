// ---
// description: write leaves out the : where there is no password
// features: [url]
// ---
from "std:testing" include expect;
from "std:url" include url;

main: func() {
    let made: url.parts = {
        scheme: "http",
        username: "ada",
        password: "",
        host: some("h"),
        port: none,
        path: "/",
        query: none,
        fragment: none,
    };
    expect.equal(url.write(made), "http://ada@h/");
}
