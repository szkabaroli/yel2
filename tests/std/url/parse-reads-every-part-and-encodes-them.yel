// ---
// description: url.parse of "HTTPS://User:pa ss@Example.COM:443/a/./b/../c d?x=1 2#frag"
// features: [url]
// ---
from "std:testing" include expect;
from "std:url" include url;

prefixed: func(part: option<string>, mark: string) -> string {
    match part {
        some(text) => if text == "" { "" } else { mark + text },
        none => "",
    }
}

shown: func(parsed: result<url.parts, string>) -> string {
    match parsed {
        ok(u) => {
            let port = match u.port { some(number) => "{number}", none => "", };
            "{url.write(u)} | {u.scheme}: | {u.username} | {u.password} | {u.host.unwrap-or("")} | {port} | {u.path} | {prefixed(u.query, "?")} | {prefixed(u.fragment, "#")}"
        }
        err(_) => "invalid",
    }
}

main: func() {
    expect.equal(shown(url.parse("HTTPS://User:pa ss@Example.COM:443/a/./b/../c d?x=1 2#frag")), "https://User:pa%20ss@example.com/a/c%20d?x=1%202#frag | https: | User | pa%20ss | example.com |  | /a/c%20d | ?x=1%202 | #frag");
}
