// ---
// description: write puts /. before a path with no host that starts with //
// features: [url]
// ---
from "std:testing" include expect;
from "std:url" include url;

main: func() {
    let made: url.parts = {
        scheme: "web",
        username: "",
        password: "",
        host: none,
        port: none,
        path: "//x",
        query: none,
        fragment: none,
    };
    expect.equal(url.write(made), "web:/.//x");
}
