// ---
// description: is-alphanumeric holds for letters and digits
// features: [char]
// ---
from "std:testing" include expect;

main: func() {
    expect.holds(is-alphanumeric(65));
    expect.holds(is-alphanumeric(97));
    expect.holds(is-alphanumeric(48));
    expect.holds(!is-alphanumeric(45));
    expect.holds(!is-alphanumeric(32));
}
