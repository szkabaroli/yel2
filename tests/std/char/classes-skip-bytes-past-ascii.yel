// ---
// description: no class holds for the bytes of a multibyte character
// features: [char]
// ---
from "std:testing" include expect;

main: func() {
    expect.holds(!is-alpha(195));
    expect.holds(!is-digit(169));
    expect.holds(!is-alphanumeric(200));
    expect.holds(!is-whitespace(160));
    expect.holds(!is-lower(233));
    expect.holds(!is-upper(201));
}
