// ---
// description: is-whitespace holds for space, tab, line feed and carriage return
// features: [char]
// ---
from "std:testing" include expect;

main: func() {
    expect.holds(is-whitespace(32));
    expect.holds(is-whitespace(9));
    expect.holds(is-whitespace(10));
    expect.holds(is-whitespace(13));
}
