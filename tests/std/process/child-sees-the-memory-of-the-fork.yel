// ---
// description: a child starts with its parent's memory as it was at the fork
// features: [process]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: func() {
    let items = [1, 2, 3,];
    match process.fork() {
        ok(none) => process.end(if items.len() == 3 && items[0] == 1 && items[2] == 3 { 0 } else { 9 }),
        ok(some(child)) => expect.equal(status(process.wait(child)), 0),
        err(problem) => expect.fail(problem),
    }
}
