// ---
// description: run passes an argument with spaces as one argument
// features: [process]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: func() {
    expect.equal(status(process.run("sh", ["-c", "test \"$1\" = 'a b'", "sh", "a b",])), 0);
    expect.equal(status(process.run("sh", ["-c", "test $# = 2", "sh", "a b", "c",])), 0);
}
