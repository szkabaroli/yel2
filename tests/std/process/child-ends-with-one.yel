// ---
// description: wait tells 1 for a child that ended with 1
// features: [process]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: func() {
    match process.fork() {
        ok(none) => process.end(1),
        ok(some(child)) => expect.equal(status(process.wait(child)), 1),
        err(problem) => expect.fail(problem),
    }
}
