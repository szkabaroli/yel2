// ---
// description: run-with leaves the other variables of this process in place
// features: [process]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: func() {
    let found = process.run-with("sh", ["-c", "test -n \"$PATH\"",], "", [("YEL_TEST_VALUE", "x"),], "");
    expect.equal(status(found), 0);
}
