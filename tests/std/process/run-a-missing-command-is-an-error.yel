// ---
// description: run gives an error for a command that is not there
// features: [process]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: func() {
    expect.equal(expect.err(process.run("no-such-command-anywhere", [])), "cannot run no-such-command-anywhere");
}
