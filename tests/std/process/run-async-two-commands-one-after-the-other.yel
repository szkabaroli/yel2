// ---
// description: two run-async calls each tell their own code
// features: [process, async]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: async func() {
    let first = wait process.run-async("sh", ["-c", "exit 1",], "", [], "");
    let second = wait process.run-async("sh", ["-c", "exit 2",], "", [], "");
    expect.equal(status(first), 1);
    expect.equal(status(second), 2);
}
