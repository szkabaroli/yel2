// ---
// description: what a child changes is its own, not its parent's
// features: [process]
// ---
from "std:testing" include expect;
from "std:process" include process;

// how a child ended: its code, or minus its signal
status: func(ended: result<process.ended, string>) -> s64 {
    match ended {
        ok(code(number)) => number,
        ok(signal(number)) => -number,
        err(_) => -1000,
    }
}

main: func() {
    let count = 1;
    match process.fork() {
        ok(none) => {
            count = 100;
            process.end(if count == 100 { 0 } else { 9 });
        }
        ok(some(child)) => {
            expect.equal(status(process.wait(child)), 0);
            expect.equal(count, 1);
        }
        err(problem) => expect.fail(problem),
    }
}
