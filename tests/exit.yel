// std:cli's exit: wasi:cli's, its result never (std's module cli-exit: WASI says it does not
// return, WIT cannot). A call of it fits where a value is wanted; the rest of std:cli is WASI's

from "std:cli" include environment, exit;

// n, or the program stopped
positive: func(n: s32) -> s32 {
    if n > 0 { n } else { exit.exit(err(())) }
}

main: func() -> s32 {
    print("arguments: {environment.get-arguments().len() >= 1}\n");
    print("positive: {positive(3)}\n");
    // what was printed is written before the program stops
    print("stopping");
    positive(0)
}
