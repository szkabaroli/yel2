// A list literal every item of which is a constant (numbers, bools, chars, strings, and records,
// tuples and lists of them) is static data, copied when it is evaluated: each evaluation a list of
// its own, every list in it too, whatever was done to one before; every kind of constant read back
// as it was written. A call of a func that only makes a record of its parameters, given constants,
// is such a constant too

record row {
    name: string,
    count: s64,
    small: s8,
    big: u64,
    on: bool,
    mark: char,
    ratio: f64,
    half: f32,
    tags: list<string>,
}

rows: func() -> list<row> {
    [
        { name: "ada", count: 3, small: -7, big: 18446744073709551615, on: true, mark: 'é', ratio: 0.1, half: 1.5, tags: ["a", "b",], },
        { name: "", count: -9223372036854775807, small: 127, big: 0, on: false, mark: 'z', ratio: -2.25e10, half: -0.5, tags: ["quote \" and\nline", "字",], },
    ]
}

pairs: func() -> list<tuple<string, s32>> { [("one", 1), ("two", 2),] }

grid: func() -> list<list<s32>> { [[1, 2,], [3,], [4, 5, 6,],] }

// a func that only makes a record of its parameters: a call of it given constants is a constant
record part { id: string, name: string, size: s32, tags: list<string>, }

part-of: func(name: string, size: s32) -> part { { id: name, name: name, size: size, tags: ["made",], } }

parts: func() -> list<part> { [part-of("inbox", 3), part-of("compose", 4),] }

shown: func(r: row) -> string {
    "{r.name}|{r.count}|{r.small}|{r.big}|{r.on}|{r.mark}|{r.ratio}|{r.half}|{r.tags.join(",")}"
}

main: func() {
    for r in rows() { print("{shown(r)}\n"); }
    for p in pairs() { print("{p.0}={p.1}\n"); }
    for line in grid() { print("{line.len()}:{line.get(0).unwrap-or(0)}\n"); }

    // each evaluation its own: one changed, the next as written
    let first = rows();
    first.push(first[0]);
    first[0].tags.push("added");
    first[1].tags[0] = "changed";
    let again = rows();
    print("first: {first.len()} rows, {first[0].tags.len()} tags, {first[1].tags[0]}\n");
    print("again: {again.len()} rows, {again[0].tags.len()} tags, {again[1].tags[0].len()}\n");
    for p in parts() { print("{p.id}/{p.name}/{p.size}/{p.tags.join(",")}\n"); }
    let made = parts();
    made[0].tags.push("again");
    print("parts again: {parts()[0].tags.len()}\n");
    let g = grid();
    g[1].push(9);
    print("grid again: {grid()[1].len()}, changed {g[1].len()}\n");
}
