// Closures: { params -> body } (or a block where a func of no params is wanted), capturing by
// reference: a closure and the scope it is made in share each variable, through an environment the
// closures made in one scope share (a for's, one each turn)

resource Person { name: string, age: s32, }

// a counter: its count lives on in the environment after make-counter returns
make-counter: func() -> func() -> s32 {
    let count = 0;
    { count += 1; count }
}

apply-twice: func(f: func(s32) -> s32, x: s32) -> s32 { f(f(x)) }

main: func() {
    // params typed from the func wanted, or written
    let people: list<Person> = [
        { name: "grace", age: 85, },
        { name: "ada", age: 36, },
        { name: "alan", age: 41, },
    ];
    let limit = 40;
    print("{people.filter({ p -> p.age > limit }).map({ p -> p.name })}\n");
    people.sort({ a, b -> a.age < b.age });
    print("{people.map({ p: Person -> "{p.name} {p.age}" })}\n");

    // by reference: a write in the closure is seen outside, and the other way round
    let total = 0;
    let add = { n: s32 -> total += n; };
    add(5);
    add(7);
    total += 100;
    add(1);
    print("{total}\n");

    // state that outlives its scope, one environment per counter
    let a = make-counter();
    let b = make-counter();
    print("{a()} {a()} {a()} {b()}\n");

    // each turn of a for its own item: each closure keeps its own
    let greets: list<func() -> string> = [];
    for p in people { greets.push({ "hi {p.name}" }); }
    for g in greets { print("{g()} "); }
    print("\n");
    for i in 0..3 { greets.push({ "turn {i}" }); }
    print("{greets[3]()} {greets[5]()}\n");

    // closures within closures, reaching out through each environment
    let base = 10;
    let adder = { x: s32 -> apply-twice({ y -> y + base + x }, 0) };
    print("{adder(1)} {apply-twice({ x -> x * 3 }, 2)}\n");

    // recursion through a variable it captures
    let fact: func(s32) -> s32 = { n -> 0 };
    fact = { n -> if n < 2 { 1 } else { n * fact(n - 1) } };
    print("{fact(10)}\n");

    // a block where a func of no params is wanted is a closure
    let clicks = 0;
    let on-click: func() = { clicks += 1; };
    on-click();
    on-click();
    // a func value is the same func made in the same environment
    let same = on-click;
    print("{clicks} {on-click == same} {on-click == { clicks += 1; }}\n");
}
