// a writer only this func has, closed where it is last used: its reader sees the stream's end
// (without the close, the wait for below waits for good: a deadlock). One a started task has, or
// one kept, is left to whoever has it

// a writer a record holds too, given a started task: not this func's alone, so not closed here
record Chan { w: writer<s32>, }

producer: async func(c: Chan) {
    wait yield-turn();
    wait c.w.write(2);
    wait c.w.write(3);
    c.w.close();
}

feed: async func(w: writer<s32>, xs: list<s32>) {
    for x in xs { wait w.write(x); }
    w.close();
}

total: async func(s: stream<s32>) -> s32 {
    let t = 0;
    wait for x in s { t += x; }
    t
}

main: async func() {
    let (s, w) = stream-pair(8);
    for i in 0..4 { wait w.write(i * 10); }
    print("{wait total(s)}\n");
    // an early way out closes it too
    let (s2, w2) = stream-pair(8);
    for i in 0..10 {
        if i == 3 { break; }
        wait w2.write(i);
    }
    print("{wait total(s2)}\n");
    // given a started task: that task closes it
    let (s3, w3) = stream-pair(1);
    start feed(w3, [5, 6, 7,]);
    print("{wait total(s3)}\n");
    // taken out of a record a started task has: the task closes it
    let (s4, w0) = stream-pair(8);
    let c: Chan = { w: w0, };
    start producer(c);
    let { w: w4 } = c;
    wait w4.write(1);
    print("{wait total(s4)}\n");
}
