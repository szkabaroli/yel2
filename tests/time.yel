// std:time against JavaScript's Date (node): instants from milliseconds written as toISOString does,
// with their weekday, and ISO 8601 / RFC 3339 texts read (Z, an offset, a date alone; invalid where
// Date.parse gives NaN). The output is node's for the same values

from "std:time" include time;

main: func() -> s32 {
    let a3 = time.from-unix-millis(0);
    print("{time.to-iso(a3)} {time.weekday(time.to-date-time(a3))}\n");
