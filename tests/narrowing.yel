// is tests, and the narrowing they give: in an if's branches, after an if that leaves, across
// && and || and !, and in a match's arms

type method = "get" | "post" | "put" | "delete";
type write = "post" | "put";

reads: func(m: "get") -> string { "read {m}" }

writes: func(m: write) -> string { "write {m}" }

removes: func(m: "delete") -> string { "remove {m}" }

route: func(m: method) -> string {
    if m is "get" { return reads(m); }
    // m is "post" | "put" | "delete" from here
    if m is write { writes(m) } else { removes(m) }
}

// a string's value tested against a union of literals
parse: func(s: string) -> option<method> {
    if s is method { some(s) } else { none }
}

both: func(a: method, b: method) -> string {
    if a is "get" && b is write { return "{reads(a)}, then {writes(b)}"; }
    if !(a is write) || b is "get" { return "other"; }
    // a is write, b is not "get"
    writes(a)
}

kind: func(m: method) -> string {
    match m {
        "get" => reads(m),
        "delete" => removes(m),
        // what the arms before left: "post" | "put"
        let rest => writes(rest),
    }
}

level: func(n: s32) -> string {
    if n is 1 | 2 | 3 { "small {n}" } else { "big {n}" }
}

maybe: func(o: option<method>) -> string {
    if o is option<write> {
        match o {
            some(w) => writes(w),
            none => "nothing",
        }
    } else {
        "not a write"
    }
}

main: func() {
    for m in ["get", "post", "put", "delete",] {
        match parse(m) {
            some(let x) => print("{route(x)} / {kind(x)}\n"),
            none => {}
        }
    }
    print("{parse("patch")}\n");
    print("{both("get", "put")} | {both("post", "get")} | {both("put", "delete")}\n");
    print("{level(2)} {level(9)}\n");
    print("{maybe(some("put"))} {maybe(none)} {maybe(some("get"))}\n");
    // a closure sees the binding, not the narrowing (it may run later)
    let m: method = "get";
    if m is "get" {
        let f: func() -> string = { "{m} later" };
        print("{f()}\n");
    }
}
