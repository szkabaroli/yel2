// A UI component, lowered by hand as the template pass will lower it (tests/ui-driver drives it,
// tests/ui-dom stands in for the shell's host). The template:
//
//     component Counter {
//         count: s32 = 0;
//         items: list<string> = [];
//
//         VStack {
//             Text { "Count: {count}" }
//             HStack {
//                 Button { "-"  clicked: { count -= 1; } }
//                 Button { "+"  clicked: { count += 1; items.push("item {count}"); } }
//             }
//             if count > 3 {
//                 Text { content: "High!" weight: "bold" }
//             }
//             for item in items key(item) {
//                 Text { "{item}" }
//             }
//         }
//     }
//
// becomes a resource (its state its fields) exported as counter-component's resource counter:
// mount builds the tree and the closures that keep it current, a handler changes state and says
// which fields changed (bits), and the update after the event redoes only what reads them.

package test:counter@0.1.0;

from "yel:ui" include dom;

module counter-component {
    // what an event carries (the shell's event-payload, in part)
    variant event-payload { none, value(string), }

    resource Counter {
        count: s32,
        items: list<string>,
        // what changed since the last update: bit 0 count, bit 1 items
        changed: u64,
        // what reads a changed field, again (mount makes it)
        update: func(),
        // whether mounted (before, a change only sets state: mount reads it), and what unmount
        // lets go: the tree's top node, the handlers made
        mounted: bool,
        tree: u32,
        handlers: list<u32>,
    }

    new: func() -> Counter { { count: 0, items: [], changed: 0, update: nothing, mounted: false, tree: 0, handlers: [], } }

    @(private) nothing: func() {}

    // the tree under root, and what keeps it current
    mount: func(self: Counter, root: u32) {
        let vstack = dom.create-element("VStack");
        let text = dom.create-element("Text");
        let text-0 = dom.create-text("Count: {self.count}");
        dom.append-child(text, text-0);
        dom.append-child(vstack, text);

        let hstack = dom.create-element("HStack");
        let minus = dom.create-element("Button");
        dom.append-child(minus, dom.create-text("-"));
        listen(self, minus, "clicked", { payload: event-payload ->
            self.count -= 1;
            touch(self, 1);
        });
        dom.append-child(hstack, minus);
        let plus = dom.create-element("Button");
        dom.append-child(plus, dom.create-text("+"));
        listen(self, plus, "clicked", { payload: event-payload ->
            self.count += 1;
            self.items.push("item {self.count}");
            touch(self, 3);
        });
        dom.append-child(hstack, plus);
        dom.append-child(vstack, hstack);

        // if count > 3: its branch's top node while mounted
        let if-anchor = dom.create-comment("if");
        dom.append-child(vstack, if-anchor);
        let branch: option<u32> = none;
        let sync-if = { ->
            let wanted = self.count > 3;
            match branch {
                some(high) => {
                    if !wanted {
                        dom.remove(high);
                        branch = none;
                    }
                }
                none => {
                    if wanted {
                        let high = dom.create-element("Text");
                        dom.set-attribute(high, "content", dom.attribute-value.str("High!"));
                        dom.set-attribute(high, "weight", dom.attribute-value.str("bold"));
                        dom.insert-before(vstack, high, if-anchor);
                        branch = some(high);
                    }
                }
            }
        };
        sync-if();

        // for item in items key(item): each row by its key, in order
        let for-anchor = dom.create-comment("for");
        dom.append-child(vstack, for-anchor);
        let rows: list<Row> = [];
        let sync-for = { ->
            let kept: map<string, Row> = map.new();
            for row in rows { kept.set(row.key, row); }
            let next: list<Row> = [];
            for item in self.items {
                let row = match kept.get(item) {
                    some(old) => {
                        let _ = kept.remove(item);
                        dom.set-text-content(old.content, "{item}");
                        old
                    }
                    none => {
                        let top = dom.create-element("Text");
                        let content = dom.create-text("{item}");
                        dom.append-child(top, content);
                        let made: Row = { key: item, top: top, content: content, };
                        made
                    }
                };
                dom.insert-before(vstack, row.top, for-anchor);
                next.push(row);
            }
            for row in kept.values() { dom.remove(row.top); }
            rows = next;
        };
        sync-for();

        // what reads a changed field, again
        self.update = { ->
            let bits = self.changed;
            self.changed = 0;
            if (bits & 1) != 0 {
                dom.set-text-content(text-0, "Count: {self.count}");
                sync-if();
            }
            if (bits & 2) != 0 { sync-for(); }
        };

        self.tree = vstack;
        self.mounted = true;
        dom.append-child(root, vstack);
    }

    unmount: func(self: Counter) {
        for id in self.handlers { ui.release(id); }
        self.handlers = [];
        self.mounted = false;
        self.changed = 0;
        dom.remove(self.tree);
    }

    // an event the host fires at one of this component's handlers
    dispatch: func(self: Counter, handler-id: u32, payload: event-payload) { ui.dispatch(handler-id, payload); }

    // the props: read, and set from outside (the update right away: no event is running)
    get-count: func(self: Counter) -> s32 { self.count }
    set-count: func(self: Counter, value: s32) {
        self.count = value;
        touch(self, 1);
        ui.flush();
    }
    get-items: func(self: Counter) -> list<string> { self.items }
    set-items: func(self: Counter, value: list<string>) {
        self.items = value;
        touch(self, 2);
        ui.flush();
    }

    // a row of the for: its key, its top node, the node its text is in
    @(private) record Row { key: string, top: u32, content: u32, }

    // state changed (which fields: bits): the update once, after the handler
    @(private) touch: func(self: Counter, bits: u64) {
        if !self.mounted { return; }
        if self.changed == 0 { ui.schedule(self.update); }
        self.changed = self.changed | bits;
    }

    // a handler made for an event of a node, the component's to let go
    @(private) listen: func(self: Counter, node: u32, event: string, run: func(event-payload)) {
        let id = ui.handler(run);
        self.handlers.push(id);
        dom.add-event-listener(node, event, id);
    }
}

// the handlers by id (what the host's dispatch calls), and the updates an event makes: the
// runtime half every component shares (std's, once templates exist)
@(private) module ui {
    let handlers: list<option<func(counter-component.event-payload)>>;
    let free: list<u32>;
    let pending: list<func()>;

    handler: func(run: func(counter-component.event-payload)) -> u32 {
        if free.len() > 0 {
            let id = free.pop();
            handlers[id as s64] = some(run);
            return id;
        }
        handlers.push(some(run));
        (handlers.len() - 1) as u32
    }

    release: func(id: u32) {
        handlers[id as s64] = none;
        free.push(id);
    }

    schedule: func(update: func()) { pending.push(update); }

    // the updates scheduled, each once, in order (one may schedule another)
    flush: func() {
        let i = 0;
        loop {
            if i >= pending.len() { break; }
            pending[i]();
            i += 1;
        }
        pending = [];
    }

    dispatch: func(id: u32, payload: counter-component.event-payload) {
        match handlers[id as s64] {
            some(run) => run(payload),
            none => {}
        }
        flush();
    }
}
