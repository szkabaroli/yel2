// A resource exported (tests/res-caller imports it): a shared object the host holds handles to,
// its constructor (new), its methods (its module's funcs taking it first as self) and what runs
// when the host drops a handle (drop)

package test:res@0.1.0;

module counters {
    resource Counter { label: string, count: s32, }

    // how many the host has dropped
    let dropped-count: s32;

    new: func(label: string) -> Counter { { label: label, count: 0, } }

    bump: func(self: Counter, by: s32) -> s32 {
        self.count += by;
        self.count
    }

    label: func(self: Counter) -> string { "{self.label}:{self.count}" }

    // a borrowed counter, not its own: another one's count added
    absorb: func(self: Counter, other: Counter) -> s32 {
        self.count += other.count;
        self.count
    }

    drop: func(self: Counter) { dropped-count += 1; }

    dropped: func() -> s32 { dropped-count }
}
