// ---
// description: a writer used only to close: the reader sees an empty stream
// features: [async, streams]
// ---
from "std:testing" include expect;

main: async func() {
    let (items, out) = stream-pair(2);
    out.close();
    let seen = 0;
    wait for x in items { seen += 1; }
    expect.equal(seen, 0);
}
