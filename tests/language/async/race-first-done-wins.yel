// ---
// description: wait a | b gives the result of the one that finishes first
// features: [async]
// ---
from "std:testing" include expect;

quick: async func() -> s32 {
    wait yield-turn();
    1
}

slow: async func() -> string {
    for turn in 0..10 { wait yield-turn(); }
    "slow"
}

main: async func() {
    let first = start quick();
    let second = start slow();
    match wait first | second {
        let number: s32 => expect.equal(number, 1),
        let text: string => expect.fail("the slow one won"),
    }
    wait second;
}
