// ---
// description: wait for over a stream ends once the writer closed it
// features: [async, streams]
// ---
from "std:testing" include expect;

feed: async func(out: writer<s32>) {
    for x in 1..=3 { wait out.write(x); }
    out.close();
}

main: async func() {
    let (items, out) = stream-pair(1);
    let feeder = start feed(out);
    let total = 0;
    wait for x in items { total += x; }
    expect.equal(total, 6);
    wait feeder;
}
