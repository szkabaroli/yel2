// ---
// description: an early way out of the loop that writes closes the writer too
// features: [async, streams]
// ---
from "std:testing" include expect;

total: async func(items: stream<s32>) -> s32 {
    let sum = 0;
    wait for x in items { sum += x; }
    sum
}

main: async func() {
    let (items, out) = stream-pair(8);
    for x in 0..10 {
        if x == 3 { break; }
        wait out.write(x);
    }
    expect.equal(wait total(items), 3);
}
