// ---
// description: read-some gives an empty list once the stream is closed and drained
// features: [async, streams]
// ---
from "std:testing" include expect;

main: async func() {
    let (items, out) = stream-pair(4);
    wait out.write(1);
    out.close();
    expect.equal(wait items.read-some(4), [1,]);
    expect.equal((wait items.read-some(4)).len(), 0);
}
