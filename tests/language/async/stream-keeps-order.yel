// ---
// description: items are read in the order they were written
// features: [async, streams]
// ---
from "std:testing" include expect;

main: async func() {
    let (items, out) = stream-pair(8);
    for x in 0..5 { wait out.write(x); }
    out.close();
    let seen: list<s32> = [];
    wait for x in items { seen.push(x); }
    expect.equal(seen, [0, 1, 2, 3, 4,]);
}
