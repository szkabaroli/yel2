// ---
// description: a u64 range past s64's: its last value in its own kind
// features: [memory, ranges]
// ---
from "std:testing" include expect;

big: func(x: u64) -> string {
    match x {
        0..18446744073709551615 => if x is 0..=2 { "small" } else { "below max" },
        _ => "max",
    }
}

main: func() {
    expect.equal(big(1), "small");
    expect.equal(big(5), "below max");
    expect.equal(big(18446744073709551615), "max");
}
