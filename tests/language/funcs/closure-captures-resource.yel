// ---
// description: a closure captures a resource, the same object
// features: [funcs, closures, resources]
// ---
from "std:testing" include expect;

resource Counter { value: s32, }

main: func() {
    let counter: Counter = { value: 0, };
    let bump: func() = { counter.value += 1; };
    bump();
    bump();
    expect.equal(counter.value, 2);
    counter.value = 40;
    bump();
    expect.equal(counter.value, 41);
}
