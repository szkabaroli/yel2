// ---
// description: does not compile: argument 1 of push is readonly, and push writes it (a closure given a readonly list's item)
// features: [readonly]
// negative: compile
// error: 11:25: argument 1 of push is readonly, and push writes it
// help: give it a value that is not readonly (a copy), or make push only read it
// ---
each: func<T>(xs: list<T> & readonly, f: func(T & readonly)) { for x in xs { f(x); } }
main: func() {
    let grid: list<list<s32>> & readonly = [[1,], [2,],];
    each(grid, { row -> row.push(1); });
}
