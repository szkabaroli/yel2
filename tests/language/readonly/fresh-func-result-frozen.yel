// ---
// description: a func's new result is readonly where that is wanted
// features: [readonly]
// ---
from "std:testing" include expect;
evens: func(n: s32) -> list<s32> {
    let out: list<s32> = [];
    for i in 0..n {
        if i % 2 == 0 { out.push(i); }
    }
    out
}
main: func() {
    let ev: list<s32> & readonly = evens(9);
    expect.equal(ev, [0, 2, 4, 6, 8,]);
}
