// ---
// description: a negative literal as a pattern
// features: [patterns]
// ---
from "std:testing" include expect;
sign: func(n: s32) -> string {
    match n { -1 => "minus one", 0 => "zero", _ => "other", }
}
main: func() {
    expect.equal(sign(-1), "minus one");
    expect.equal(sign(1), "other");
}
