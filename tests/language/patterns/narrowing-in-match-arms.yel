// ---
// description: a match on a literal union narrows the arm's name
// features: [patterns]
// ---
from "std:testing" include expect;
type method = "get" | "post" | "put" | "delete";
type write = "post" | "put";
reads: func(m: "get") -> string { "read {m}" }
writes: func(m: write) -> string { "write {m}" }
removes: func(m: "delete") -> string { "remove {m}" }
kind: func(m: method) -> string {
    match m {
        "get" => reads(m),
        "delete" => removes(m),
        let rest => writes(rest),
    }
}
main: func() {
    expect.equal(kind("get"), "read get");
    expect.equal(kind("delete"), "remove delete");
    expect.equal(kind("post"), "write post");
}
