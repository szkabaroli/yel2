// ---
// description: a char range pattern matches the chars from one to another
// features: [patterns]
// ---
from "std:testing" include expect;
kind: func(c: char) -> string {
    match c {
        'a'..='z' => "lower",
        'A'..='Z' => "upper",
        '0'..='9' => "digit",
        _ => "other",
    }
}
main: func() {
    expect.equal(kind('q'), "lower");
    expect.equal(kind('Q'), "upper");
    expect.equal(kind('7'), "digit");
    expect.equal(kind('?'), "other");
}
