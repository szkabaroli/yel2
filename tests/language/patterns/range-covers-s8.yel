// ---
// description: arms of ranges covering an s8 need no wildcard
// features: [patterns]
// ---
from "std:testing" include expect;
sign: func(n: s8) -> s32 {
    match n {
        -128..=-1 => -1,
        0 => 0,
        1..=127 => 1,
    }
}
main: func() {
    expect.equal(sign(-128), -1);
    expect.equal(sign(-5), -1);
    expect.equal(sign(0), 0);
    expect.equal(sign(100), 1);
    expect.equal(sign(127), 1);
}
