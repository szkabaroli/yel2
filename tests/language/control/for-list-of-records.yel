// ---
// description: for over a list of records reads each record
// features: [control]
// ---
from "std:testing" include expect;
record Point { x: s32, y: s32, }
main: func() {
    let points: list<Point> = [{ x: 1, y: 2, }, { x: 3, y: 4, },];
    let sum = 0;
    for point in points { sum += point.x * point.y; }
    expect.equal(sum, 14);
}
