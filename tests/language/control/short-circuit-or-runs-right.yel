// ---
// description: || runs its right side when the left is false
// features: [control]
// ---
from "std:testing" include expect;
let calls: s32;
touch: func(value: bool) -> bool { calls += 1; value }
main: func() {
    let result = touch(false) || touch(true);
    expect.holds(result);
    expect.equal(calls, 2);
}
