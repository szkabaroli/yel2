// ---
// description: a closure made in a turn keeps that turn's variable
// features: [control]
// ---
from "std:testing" include expect;
main: func() {
    let makers: list<func() -> s32> = [];
    for i in 0..3 {
        makers.push({ i * 10 });
    }
    let got: list<s32> = [];
    for maker in makers { got.push(maker()); }
    expect.equal(got, [0, 10, 20,]);
}
