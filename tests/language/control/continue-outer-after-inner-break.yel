// ---
// description: the outer loop's next turn after an inner break
// features: [control]
// ---
from "std:testing" include expect;
main: func() {
    let pairs: list<string> = [];
    for i in 0..4 {
        if i == 1 { continue; }
        for j in 0..10 {
            if j > i { break; }
            pairs.push("{i}{j}");
        }
    }
    expect.equal(pairs.join(" "), "00 20 21 22 30 31 32 33");
}
