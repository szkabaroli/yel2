// ---
// description: a list literal evaluates its items in order
// features: [control]
// ---
from "std:testing" include expect;
let trace: list<s32>;
mark: func(n: s32) -> s32 { trace.push(n); n }
main: func() {
    let items = [mark(5), mark(6), mark(7),];
    expect.equal(items, [5, 6, 7,]);
    expect.equal(trace, [5, 6, 7,]);
}
