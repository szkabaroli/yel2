// ---
// description: the condition of a branch is itself read
// features: [observable]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let flag: Profile = { id: 0, name: "", at: { x: 0, y: 0, }, items: [], log: [], };
    let profile = fresh();
    let told = 0;
    let watch = observe.track({ -> if flag.id > 0 { let _ = profile.name; } else { let _ = profile.id; } }, { -> told += 1; });
    flag.id = 1;
    expect.equal(told, 1);
}
