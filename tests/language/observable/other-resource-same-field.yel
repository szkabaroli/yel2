// ---
// description: a write to the same field of another resource tells nothing
// features: [observable]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let left = fresh();
    let right = fresh();
    let told = 0;
    let watch = observe.track({ -> let _ = left.id; }, { -> told += 1; });
    right.id = 5;
    expect.equal(told, 0);
}
