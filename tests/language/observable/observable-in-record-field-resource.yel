// ---
// description: an observable resource is an ordinary value elsewhere: it is passed and shared
// features: [observable]
// ---
from "std:testing" include expect;

@(observable) resource Counter { n: s32, }

bump: func(counter: Counter) { counter.n += 1; }

main: func() {
    let counter: Counter = { n: 0, };
    let told = 0;
    let watch = observe.track({ -> let _ = counter.n; }, { -> told += 1; });
    bump(counter);
    expect.equal(told, 1);
    expect.equal(counter.n, 1);
}
