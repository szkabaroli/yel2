// ---
// description: a change to a field the effect did not read does not rerun it
// features: [observable, reactive]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let profile = fresh();
    let runs = 0;
    let owner = reactive.new-owner();
    reactive.within(owner, { -> let _ = reactive.effect({ -> runs += 1; let _ = profile.id; { -> } }); });
    profile.at.x = 1;
    profile.name = "other";
    reactive.flush();
    expect.equal(runs, 1);
    reactive.dispose(owner);
}
