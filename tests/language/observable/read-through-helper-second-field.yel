// ---
// description: the helper's other field is a read too
// features: [observable]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

label: func(profile: Profile) -> string { "{profile.name} #{profile.id}" }

main: func() {
    let profile = fresh();
    let told = 0;
    let watch = observe.track({ -> let _ = label(profile); }, { -> told += 1; });
    profile.id += 1;
    expect.equal(told, 1);
}
