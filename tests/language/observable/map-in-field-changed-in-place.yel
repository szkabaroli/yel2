// ---
// description: a map in an observable field is told when it is written in place
// features: [observable]
// ---
from "std:testing" include expect;

@(observable) resource Registry { names: map<string, s32>, }

main: func() {
    let registry: Registry = { names: map.new(), };
    let told = 0;
    let watch = observe.track({ -> let _ = registry.names; }, { -> told += 1; });
    registry.names.set("ada", 1);
    expect.equal(told, 1);
    expect.equal(registry.names.get-or("ada", 0), 1);
}
