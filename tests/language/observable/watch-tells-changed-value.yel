// ---
// description: reactive.watch tells the new value where it differs from the last
// features: [observable, reactive]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let profile = fresh();
    let told: list<u32> = [];
    let owner = reactive.new-owner();
    reactive.within(owner, { -> reactive.watch({ -> profile.id }, 1, { value: u32 -> told.push(value); }); });
    profile.id = 2;
    reactive.flush();
    profile.name = "other";
    reactive.flush();
    profile.id = 2;
    reactive.flush();
    expect.equal(told, [2,]);
    reactive.dispose(owner);
}
