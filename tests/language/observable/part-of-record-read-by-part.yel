// ---
// description: reading one part of a record in a field is a read of the field
// features: [observable]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let profile = fresh();
    let told = 0;
    let watch = observe.track({ -> let _ = profile.at.x; }, { -> told += 1; });
    profile.at.x = 5;
    expect.equal(told, 1);
}
