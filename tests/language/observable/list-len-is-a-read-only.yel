// ---
// description: len and a read-only helper on a list in a field tell nothing
// features: [observable]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

count: func(items: list<string>) -> s64 { items.len() }

main: func() {
    let profile = fresh();
    let told = 0;
    let watch = observe.track({ -> let _ = profile.items; }, { -> told += 1; });
    expect.equal(profile.items.len(), 0);
    expect.equal(count(profile.items), 0);
    expect.equal(told, 0);
}
