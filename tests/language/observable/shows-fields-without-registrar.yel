// ---
// description: an observable resource shows its fields, not its hidden registrar
// features: [observable]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let profile = fresh();
    let shown = "{profile:?}";
    expect.contains-text(shown, "id: 1, name: \"ada\", at: ");
    expect.contains-text(shown, "x: 0, y: 0");
    expect.contains-text(shown, "items: [], log: []");
    expect.holds(!shown.contains("registrar"));
}
