// ---
// description: an effect reading a list field runs again when the list is pushed to
// features: [observable, reactive]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

@(observable) resource Profile {
    id: u32,
    name: string,
    at: Point,
    items: list<string>,
    @(ignored) log: list<string>,
}

fresh: func() -> Profile {
    { id: 1, name: "ada", at: { x: 0, y: 0, }, items: [], log: [], }
}

main: func() {
    let profile = fresh();
    let lengths: list<s64> = [];
    let owner = reactive.new-owner();
    reactive.within(owner, { -> let _ = reactive.effect({ -> lengths.push(profile.items.len()); { -> } }); });
    profile.items.push("one");
    profile.items.push("two");
    reactive.flush();
    expect.equal(lengths, [0, 2,]);
    reactive.dispose(owner);
}
