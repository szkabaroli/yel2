// ---
// description: comments may follow and precede declarations
// features: [syntax,comments]
// ---
from "std:testing" include expect;

// before the func
double: func(n: s32) -> s32 { n * 2 } // after the func
// between funcs
triple: func(n: s32) -> s32 { n * 3 }

main: func() {
    expect.equal(double(2), 4);
    expect.equal(triple(2), 6);
}
// at the end of the file
