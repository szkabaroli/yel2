// ---
// description: assigning a record over a variable leaves the source alone
// features: [records]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

main: func() {
    let a: Point = { x: 1, y: 2, };
    let b: Point = { x: 0, y: 0, };
    b = a;
    a.y = 50;
    expect.equal(b.y, 2);
    expect.equal(a.y, 50);
}
