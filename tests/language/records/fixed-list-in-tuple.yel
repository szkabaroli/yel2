// ---
// description: a fixed-length list in a tuple is a value
// features: [records, fixed-lists, tuples]
// ---
from "std:testing" include expect;

main: func() {
    let grid: list<list<u8, 2>, ?> = [[1, 2], [3, 4], [5, 6]];
    let pair = (grid[2], "label");
    grid[2] = [0, 0];
    expect.equal(pair.0[1], 6);
    expect.equal(pair.1, "label");
}
