// ---
// description: assigning a record to a new variable copies it
// features: [records]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

main: func() {
    let a: Point = { x: 1, y: 2, };
    let b = a;
    b.x = 10;
    expect.equal(a.x, 1);
    expect.equal(b.x, 10);
    expect.equal(b.y, 2);
}
