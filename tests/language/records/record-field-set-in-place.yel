// ---
// description: a nested record's field is set where the record is
// features: [records]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }
record Line { from: Point, to: Point, }

main: func() {
    let line: Line = { from: { x: 0, y: 0, }, to: { x: 1, y: 1, }, };
    line.to.x += 5;
    expect.equal(line.to, { x: 6, y: 1, });
    expect.equal(line.from, { x: 0, y: 0, });
}
