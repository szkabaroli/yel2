// ---
// description: a list item read into a variable is a copy
// features: [records]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

main: func() {
    let points: list<Point> = [{ x: 1, y: 2, }, { x: 3, y: 4, },];
    let first = points[0];
    first.y = 99;
    expect.equal(points[0].y, 2);
    expect.equal(first.y, 99);
}
