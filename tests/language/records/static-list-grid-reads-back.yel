// ---
// description: a constant nested list reads back as written
// features: [records, static-lists]
// ---
from "std:testing" include expect;

grid: func() -> list<list<s32>> { [[1, 2,], [3,], [4, 5, 6,],] }

main: func() {
    let rows = grid();
    expect.equal(rows.len(), 3);
    expect.equal(rows[0].len(), 2);
    expect.equal(rows[0].get(0).unwrap-or(0), 1);
    expect.equal(rows[1].get(0).unwrap-or(0), 3);
    expect.equal(rows[2][2], 6);
}
