// ---
// description: a record field of a resource is set in place for every name
// features: [resources, records]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }
resource Canvas { cursor: Point, lines: list<Point>, }

main: func() {
    let canvas: Canvas = { cursor: { x: 0, y: 0, }, lines: [], };
    let same = canvas;
    canvas.cursor.x = 5;
    same.cursor.y = 6;
    canvas.lines.push(canvas.cursor);
    expect.equal(same.cursor, { x: 5, y: 6, });
    expect.equal(same.lines.len(), 1);
}
