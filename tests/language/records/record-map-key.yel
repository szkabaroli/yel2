// ---
// description: a record is a map's key by its fields
// features: [records, maps]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }

main: func() {
    let seen: map<Point, string> = map.new();
    seen.set({ x: 1, y: 2, }, "first");
    let probe: Point = { x: 1, y: 2, };
    let other: Point = { x: 2, y: 1, };
    expect.equal(seen[probe], "first");
    expect.holds(seen.has(probe));
    expect.holds(!seen.has(other));
}
