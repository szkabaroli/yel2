// ---
// description: records compare their nested records' fields
// features: [records]
// ---
from "std:testing" include expect;

record Point { x: s32, y: s32, }
record Line { from: Point, to: Point, }

main: func() {
    let one: Line = { from: { x: 0, y: 0, }, to: { x: 1, y: 1, }, };
    let two: Line = { from: { x: 0, y: 0, }, to: { x: 1, y: 1, }, };
    let three: Line = { from: { x: 0, y: 0, }, to: { x: 1, y: 2, }, };
    expect.holds(one == two);
    expect.holds(one != three);
}
