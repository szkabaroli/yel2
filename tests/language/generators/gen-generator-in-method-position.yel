// ---
// description: a generator returns values built from a list parameter and a closure
// features: [generators]
// ---
from "std:testing" include expect;

mapped: func(values: list<s32>, change: func(s32) -> s32) -> seq<s32> {
    for value in values { yield change(value); }
}

main: func() {
    let offset = 100;
    let seen: list<s32> = [];
    for value in mapped([1, 2, 3,], { x: s32 -> x + offset }) { seen.push(value); }
    expect.equal(seen, [101, 102, 103,]);
}
