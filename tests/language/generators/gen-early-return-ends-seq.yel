// ---
// description: return in a generator ends it
// features: [generators]
// ---
from "std:testing" include expect;

until-negative: func(values: list<s32>) -> seq<s32> {
    for value in values {
        if value < 0 { return; }
        yield value;
    }
    yield 100;
}

main: func() {
    let seen: list<s32> = [];
    for value in until-negative([1, 2, -1, 3,]) { seen.push(value); }
    expect.equal(seen, [1, 2,]);
    let all: list<s32> = [];
    for value in until-negative([1, 2,]) { all.push(value); }
    expect.equal(all, [1, 2, 100,]);
}
