// ---
// description: continue in a generator skips to its next turn
// features: [generators]
// ---
from "std:testing" include expect;

odds: func(limit: s32) -> seq<s32> {
    for x in 1..=limit {
        if x % 2 == 0 { continue; }
        yield x;
    }
}

main: func() {
    let seen: list<s32> = [];
    for value in odds(7) { seen.push(value); }
    expect.equal(seen, [1, 3, 5, 7,]);
}
