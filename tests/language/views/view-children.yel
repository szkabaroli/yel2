// ---
// description: does not compile: a view puts its children in one place: one #children
// features: [views]
// negative: compile
// error: 13:13: a view puts its children in one place: one #children
// error: 15:41: #children goes in one place, not in a for's rows (it would be built again in each)
// ---
module twice-view {
    view Twice {
        items: list<string> = [];

        VStack {
            #children
            #children
            for one in items key(one) { #children }
        }
    }
}
