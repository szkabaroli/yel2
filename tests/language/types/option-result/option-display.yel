// ---
// description: an option shows as some(x) or none
// features: [types, option, display]
// ---
from "std:testing" include expect;

main: func() {
    let present: option<s32> = some(3);
    let absent: option<s32> = none;
    expect.equal("{present}", "some(3)");
    expect.equal("{absent}", "none");
    let text: option<string> = some("a");
    expect.equal("{text:?}", "some(\"a\")");
}
