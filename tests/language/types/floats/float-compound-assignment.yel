// ---
// description: += -= *= /= on floats
// features: [types, floats]
// ---
from "std:testing" include expect;

main: func() {
    let value: f64 = 1.5;
    value += 1.0;
    expect.equal(value, 2.5);
    value -= 0.5;
    expect.equal(value, 2.0);
    value *= 4.0;
    expect.equal(value, 8.0);
    value /= 16.0;
    expect.equal(value, 0.5);
}
