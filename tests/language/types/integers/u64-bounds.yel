// ---
// description: u64.MIN and u64.MAX are the type's bounds, of that type
// features: [types, integers]
// ---
from "std:testing" include expect;

main: func() {
    expect.equal("{u64.MIN}", "0");
    expect.equal("{u64.MAX}", "18446744073709551615");
    let low: u64 = u64.MIN;
    let high: u64 = u64.MAX;
    expect.holds(low < high);
}
