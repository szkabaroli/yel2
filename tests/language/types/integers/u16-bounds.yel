// ---
// description: u16.MIN and u16.MAX are the type's bounds, of that type
// features: [types, integers]
// ---
from "std:testing" include expect;

main: func() {
    expect.equal("{u16.MIN}", "0");
    expect.equal("{u16.MAX}", "65535");
    let low: u16 = u16.MIN;
    let high: u16 = u16.MAX;
    expect.holds(low < high);
}
