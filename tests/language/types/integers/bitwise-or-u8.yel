// ---
// description: | keeps the bits either has
// features: [types, integers, bitwise]
// ---
from "std:testing" include expect;

main: func() {
    let flags: u8 = 0b11001100;
    expect.equal(flags | 0b10101010, 0b11101110);
    expect.equal(flags | 0, flags);
    expect.equal(flags | 255, 255);
}
