// ---
// description: ^ keeps the bits only one has
// features: [types, integers, bitwise]
// ---
from "std:testing" include expect;

main: func() {
    let flags: u8 = 0b11001100;
    expect.equal(flags ^ 0b10101010, 0b01100110);
    expect.equal(flags ^ flags, 0);
    expect.equal(flags ^ 255, 0b00110011);
}
