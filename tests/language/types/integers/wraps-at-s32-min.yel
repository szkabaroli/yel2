// ---
// description: s32 subtraction wraps from its minimum to its maximum, and negation of the minimum is itself
// features: [types, integers]
// ---
from "std:testing" include expect;

main: func() {
    let bottom: s32 = s32.MIN;
    expect.equal(bottom - 1, s32.MAX);
    expect.equal(-bottom, s32.MIN);
}
