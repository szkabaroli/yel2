// ---
// description: s64 subtraction wraps from its minimum to its maximum, and negation of the minimum is itself
// features: [types, integers]
// ---
from "std:testing" include expect;

main: func() {
    let bottom: s64 = s64.MIN;
    expect.equal(bottom - 1, s64.MAX);
    expect.equal(-bottom, s64.MIN);
}
