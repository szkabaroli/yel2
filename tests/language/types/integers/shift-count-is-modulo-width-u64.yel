// ---
// description: a 64-bit shift takes its count modulo 64
// features: [types, integers, shifts]
// ---
from "std:testing" include expect;

main: func() {
    let one: u64 = 1;
    expect.equal(one << 64, 1);
    expect.equal(one << 65, 2);
    let top: u64 = 9223372036854775808;
    expect.equal(top >> 64, top);
}
