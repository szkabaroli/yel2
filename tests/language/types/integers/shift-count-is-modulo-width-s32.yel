// ---
// description: a 32-bit shift takes its count modulo 32
// features: [types, integers, shifts]
// ---
from "std:testing" include expect;

main: func() {
    let one: s32 = 1;
    expect.equal(one << 32, 1);
    expect.equal(one << 33, 2);
    expect.equal(one << 31, s32.MIN);
    let big: u32 = 256;
    expect.equal(big >> 40, 1);
}
