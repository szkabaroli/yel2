// ---
// description: a method is also called through its module
// features: [types, type-methods]
// ---
from "std:testing" include expect;

module shapes {
    resource square { side: s64, }

    made: func(side: s64) -> square { { side: side, } }

    area: func(shape: square) -> s64 { shape.side * shape.side }
}

main: func() {
    let shape = shapes.made(4);
    expect.equal(shapes.area(shape), shape.area());
}
