// ---
// description: || does not run its right side after true
// features: [types, bools]
// ---
from "std:testing" include expect;

let count: s32 = 0;

touch: func() -> bool { count += 1; false }

main: func() {
    let result = true || touch();
    expect.equal(result, true);
    expect.equal(count, 0);
    let either = false || touch();
    expect.equal(either, false);
    expect.equal(count, 1);
}
