// ---
// description: && binds tighter than ||, ! tighter than both
// features: [types, bools]
// ---
from "std:testing" include expect;

main: func() {
    expect.equal(true || false && false, true);
    expect.equal((true || false) && false, false);
    expect.equal(!true || true, true);
    expect.equal(!(true || true), false);
}
