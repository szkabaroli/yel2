// ---
// description: an integer cast to a float is the nearest float
// features: [types, casts]
// ---
from "std:testing" include expect;

main: func() {
    let count: s32 = 7;
    expect.equal(count as f64, 7.0);
    let negative: s32 = -1;
    expect.equal(negative as f32, -1.0);
    let big: s64 = 9007199254740993;
    expect.equal(big as f64, 9007199254740992.0);
}
