// ---
// description: casting an unsigned integer to a wider type keeps its value
// features: [types, casts]
// ---
from "std:testing" include expect;

main: func() {
    let high: u8 = 255;
    expect.equal(high as u16, 255);
    expect.equal(high as s32, 255);
    expect.equal(high as u64, 255);
}
