// ---
// description: casting to a wider type and back keeps the value
// features: [types, casts]
// ---
from "std:testing" include expect;

main: func() {
    let value: s16 = -1234;
    expect.equal(value as s64 as s16, value);
    let byte: u8 = 77;
    expect.equal(byte as u64 as u8, byte);
}
