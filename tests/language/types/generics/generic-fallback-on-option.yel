// ---
// description: a generic unwrap-or
// features: [types, generics, option]
// ---
from "std:testing" include expect;

or-else: func<T>(value: option<T>, fallback: T) -> T {
    match value {
        some(inner) => inner,
        none => fallback,
    }
}

main: func() {
    expect.equal(or-else(some(1), 0), 1);
    let absent: option<string> = none;
    expect.equal(or-else(absent, "x"), "x");
}
