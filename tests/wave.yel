// every WAVE type: integers of each width, floats, chars, strings, tuples, results, flags; values
// shown as WAVE writes them

flags Access { read, write, execute, }

record Entry { ok: bool, name: string, size: u64, }

enum Dir { north, south, }

check: func(n: s32) -> result<s32, string> {
    if n < 0 { err("negative: {n}") } else { ok(n * 2) }
}

save: func(fail: bool) -> result<_, string> {
    if fail { err("disk full") } else { ok }
}

describe: func(r: result<s32, string>) -> string {
    match r {
        ok(v) => "doubled {v}",
        err(e) => "failed: {e}",
    }
}

main: func(argv: list<string>) -> s32 {
    // integers: each width, wrapping, literals in every radix
    let byte: u8 = 255;
    let small: s8 = -128;
    let big: u64 = 18446744073709551615;
    let least: s64 = -9223372036854775807 - 1;
    print("{byte + 1} {small - 1} {big} {least} {big + 1}\n");
    print("{0xff} {0o17} {0b1010} {007} {7 / 2} {-7 / 2} {-7 % 3}\n");
    let mask: u32 = 1 << 31;
    print("{mask} {mask >> 31} {0xf0 | 0x0f} {0xff & 0x0f} {6 ^ 3} {1 << 33}\n");

    // floats: shortest digits that read back, inf and nan
    let third: f64 = 1.0 / 3.0;
    let tenth: f32 = 0.1;
    print("{0.1 + 0.2} {third} {tenth} {1e10} {2.5e-3} {inf} {-inf} {nan} {7.5 % 2.0}\n");
    let x: f64 = nan;
    print("{x == x} {x != x} {[1.5, -0.25,]}\n");

    // chars and strings: themselves in an interpolation, quoted and escaped inside a value
    let c = 'é';
    print("{c} {'\u{1F600}'} {['a', '\n', '\'', c,]}\n");
    print("{["tab\there", "quote \" and \\", "bell \u{7}",]}\n");

    // tuples
    let pair = (3, "three");
    let one = (true,);
    print("{pair} {pair.0} {pair.1} {one} {(1, (2.5, 'z'))} {pair == (3, "three")}\n");

    // results
    print("{check(4)} {check(-1)} {save(false)} {save(true)}\n");
    print("{describe(check(21))}; {describe(check(-2))}; {check(1) == ok(2)}\n");
    let results: list<result<s32, string>> = [ok(1), err("no"),];
    print("{results}\n");

    // flags
    let granted = Access.read | Access.write;
    let none-set = granted & Access.execute;
    print("{granted} {none-set} {granted.write} {granted.execute} {granted == Access.write | Access.read}\n");

    // a label that is a WAVE keyword takes a %; options of options
    let entry: Entry = { ok: true, name: "a.txt", size: 12, };
    let nested: option<option<Dir>> = some(some(Dir.south));
    print("{entry} {nested} {Dir.north < Dir.south}\n");
    0
}
