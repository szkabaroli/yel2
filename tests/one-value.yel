// a type of one value: declared (type only = "post": a match on it needs that arm alone), or left
// by a test (b in a match's true arm is true: a closure's result found from it is a bool, as a
// literal's is, not that one value; found by tools/fuzz)

type only = "post";

main: func() -> s32 {
    let o: only = "post";
    match o { "post" => print("only post\n"), }
    let pick = { b: bool -> match b { true => { if true { return b; } }, false => {}, } b };
    let n: s32 = 5;
    let u: s32 | string = -(n * 2);
    print("{pick(true)} {pick(false)} {u}\n");
    0
}
