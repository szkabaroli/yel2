// async: async funcs (WIT's async func), each a state machine the executor steps. wait f(x) waits
// for an async call; start f(x) begins one, its future<T>; wait a | b waits for the first done (a
// union of their results), wait { a: x, b: y } for all (an anonymous record)

resource Job { name: string, steps: s32, }

double: async func(x: s32) -> s32 {
    wait yield-turn();
    x * 2
}

// a turn each step: the others run between them
run-job: async func(job: Job) -> string {
    for i in 0..job.steps {
        print("{job.name} {i}\n");
        wait yield-turn();
    }
    "{job.name} done"
}

// waits for another async func, which waits too: a chain of frames
sum-doubles: async func(xs: list<s32>) -> s32 {
    let total = 0;
    for x in xs { total += wait double(x); }
    total
}

count: async func(n: s32) -> s32 {
    for i in 0..n { wait yield-turn(); }
    n
}

main: async func() {
    print("{wait double(21)}\n");
    print("{wait sum-doubles([1, 2, 3,])}\n");
    let a = start run-job({ name: "a", steps: 3, });
    let b = start run-job({ name: "b", steps: 2, });
    let first = wait a | b;
    print("first: {first}\n");
    let both = wait { x: a, y: b };
    print("{both.x} / {both.y}\n");
    // results of two types: the first done, as a union
    let n = start count(5);
    let s = start run-job({ name: "c", steps: 1, });
    match wait n | s {
        let k: s32 => print("count first: {k}\n"),
        let t: string => print("job first: {t}\n"),
    }
    print("{wait n} {wait s}\n");
}
