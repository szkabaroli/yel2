// types as sets: type aliases (as WIT writes them), unions of literal types, assignability as a
// subset, exhaustiveness over a union's values

type method = "get" | "post" | "put";
type safe = "get";
type level = 1 | 2 | 3;
type name = string;
type pair = tuple<name, level>;
type maybe-level = option<level>;

record Request { method: method, path: name, }

describe: func(m: method) -> string {
    match m {
        "get" => "read",
        "post" | "put" => "write",
    }
}

// a subset where its superset is wanted: no conversion (both are strings)
shout: func(s: string) -> string { s + "!" }

label: func(l: level) -> string {
    match l {
        1 => "low",
        2 => "mid",
        3 => "high",
    }
}

next-level: func(l: level) -> option<level> {
    match l {
        1 => some(2),
        2 => some(3),
        3 => none,
    }
}

main: func() {
    let m: method = "post";
    let s: safe = "get";
    // safe is a subset of method
    let wider: method = s;
    let r: Request = { method: "put", path: "/x", };
    print("{describe(m)} {describe(wider)} {describe(r.method)} {shout(m)} {m.len()}\n");
    print("{m == "post"} {m != wider} {s == "get"}\n");
    // an if's branches each one of the union's values
    let picked: method = if m == "post" { "put" } else { "get" };
    print("{describe(picked)}\n");
    let p: pair = ("/home", 2);
    print("{p.0} {label(p.1)} {p.1 + 10}\n");
    let ls: list<level> = [1, 3, 2,];
    for l in ls { print("{label(l)} "); }
    print("\n");
    let cur: maybe-level = some(1);
    for step in 0..4 {
        match cur {
            some(let l) => {
                print("{label(l)} ");
                cur = next-level(l);
            }
            none => print("done "),
        }
    }
    print("\n");
}
