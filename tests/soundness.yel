// what an audit found the checker let through wrong (each now right): an arm whose pattern binds the
// name it matches, a range at a kind's edge, a narrowed func value called, a record pattern on a
// union's second anonymous record

type v = s32 | string;
type fi = func() -> s32;
type fs = func() -> string;
type either = fi | fs;
type shape = { a: s32 } | { b: string };
type half = 0.5 | 1.0;

resource Counter { n: s32, }

seven: func() -> s32 { 7 }

// some(x) on x: the arm's x is the payload
unwrap: func(x: option<string>) -> string {
    match x {
        some(x) => x,
        none => "-",
    }
}

nested: func(x: option<option<s32>>) -> string {
    match x {
        some(x) => match x {
            some(x) => "{x + 1}",
            none => "inner none",
        },
        none => "none",
    }
}

member: func(x: option<v>) -> string {
    match x {
        some(x) => match x {
            let n: s32 => "n {n}",
            let s: string => "s {s}",
        },
        none => "none",
    }
}

// a u64 range past s64's: its last value in its own kind
big: func(x: u64) -> string {
    match x {
        0..18446744073709551615 => if x is 0..=2 { "small" } else { "below max" },
        _ => "max",
    }
}

which: func(x: shape) -> string {
    match x {
        { a: let a } => "a {a}",
        { b: let b } => "b {b}",
    }
}

main: func() {
    print("{unwrap(some("hi"))} {unwrap(none)}\n");
    print("{nested(some(some(4)))} {nested(some(none))} {nested(none)}\n");
    print("{member(some(3))} {member(some("q"))} {member(none)}\n");
    print("{big(1)} {big(5)} {big(18446744073709551615)}\n");
    let max: u64 = 18446744073709551615;
    print("{max is 0..18446744073709551615} {max is 0..=18446744073709551615}\n");
    let f: either = seven;
    if f is fi { print("{f() + 1}\n"); }
    let x: shape = { b: "hi", };
    let y: shape = { a: 2, };
    print("{which(x)} {which(y)}\n");
    // ranges up to a type's greatest: no step past it (a continue on the last value too)
    let top: s32 = 2147483647;
    let seen = 0;
    for i in 2147483645..=top { seen += 1; }
    let umax: u64 = 18446744073709551615;
    let odd = 0;
    for u in 18446744073709551610..=umax {
        if u % 2 == 0 { continue; }
        odd += 1;
    }
    let past: u64 = 9223372036854775810;
    let high = 0;
    for u in 9223372036854775800..past { high += 1; }
    let empty = 0;
    for i in 5..=4 { empty += 1; }
    print("{seen} {odd} {high} {empty}\n");
    // x op= v: x read first
    let k = 10;
    let bump = { -> k = 20; 2 };
    k += bump();
    let c: Counter = { n: 10, };
    let poke = { -> c.n = 20; 2 };
    c.n += poke();
    print("{k} {c.n}\n");
    // a float literal's type by its value
    let h: half = 1.00;
    print("{h == 1.0}\n");
}
