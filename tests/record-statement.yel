// a record literal that starts a statement, after an if, as a func's value: a shift's << in its
// first field is no type's < (it is no closure's params; found by tools/fuzz)

make: func(c: bool) -> { a: s32, b: char } {
    if c { }
    { a: ((0 as s32) << (32 as s64)), b: if true { 'x' } else { 'y' }, }
}

main: func() -> s32 {
    print("{make(true).a}\n");
    0
}
