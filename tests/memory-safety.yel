// what once let the collector free what was still used (each found by an audit; run under
// YEL_GC_STRESS too): a timer naming a task done and collected, a record put on the stack that a
// union's conversion let escape, a closure's environment not rooted, a directory's names made
// while its list grew

record P { name: string, n: s32, }
type mix = s32 | P;

// the race's loser (the sleep) leaves its timer naming this task, done long before it is due
racer: async func() {
    match wait sleep(30) | yield-turn() {
        () => {}
    }
}

// a record made here, given back as a union: its conversion holds it, so it is on the heap
pick: func(i: s32) -> mix {
    let p: P = { name: "p{i}", n: i, };
    let m: mix = p;
    m
}

keep: func(i: s32, out: list<mix>) {
    let p: P = { name: "k{i}", n: i, };
    let m: mix = p;
    out.push(m);
}

// the closure outlives make: its environment is read after allocations, through its parameter
make: func(n: s32) -> func() -> string {
    let name = "x{n}";
    let count = n;
    {
        let a = "{name}-a";
        count += 1;
        let b = "{name}-b{count}";
        "{a} {b} {name} {count}"
    }
}

main: async func() {
    start racer();
    wait yield-turn();
    // the racer is done: let go, and what is made now may take its place
    let junk: list<string> = [];
    for i in 0..200 { junk.push("{i}{i}{i}{i}{i}{i}{i}{i}"); }
    wait sleep(60);
    let a = pick(1);
    let b = pick(2);
    let xs: list<mix> = [];
    for i in 0..3 { keep(i, xs); }
    print("{a} {b} {xs}\n");
    print("{make(5)()} {make(7)()}\n");
    // more names than the list's first room: each made after the list grows
    let names: list<string> = [];
    for i in 0..40 { names.push("name {i}"); }
    let distinct = true;
    for i in 1..names.len() {
        if names[i] == names[i - 1] { distinct = false; }
    }
    print("{names.len() > 16} {distinct}\n");
}
