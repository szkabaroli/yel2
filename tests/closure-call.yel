// a closure called where it is made: the call's wanted type is its body's, as a closure's given
// where a func is wanted (a fixed-length list, a record, none, a number's type, from the call's
// place; its params' types from what it writes)

resource Point { x: s32, y: s32, }

main: func() -> s32 {
    let a: list<u8, 3> = ({ c: char -> [8, 25, 140,] })('e');
    let p: Point = ({ -> { x: 1, y: 2, } })();
    let o: option<string> = ({ n: s32 -> if n > 0 { none } else { some("negative") } })(3);
    let b: u8 = ({ -> 200 })();
    let k: s64 = ({ x: s64, y: s64 -> x * y })(6, 7);
    let n = ({ -> 5 })();
    print("{a:?} {p.x} {p.y} {o:?} {b} {k} {n}\n");
    0
}
