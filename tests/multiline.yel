// WAVE's multiline strings: """ and a line break open one, a line break, spaces and """ close it,
// and each line gives up as many spaces as the closing """ has before it

main: func(argv: list<string>) -> s32 {
    let name = "yel";
    let text = """
        Hello, {name}!
          indented two
        a "quote", "" two, ""\" three
        escaped \\ and \t tab

        after an empty line
        """;
    print("{text}|\n");
    print("{["""
        one
        two
        """,]}\n");
    let empty = """
    """;
    print("[{empty}] {empty.len()} {text.len()}\n");
    0
}
