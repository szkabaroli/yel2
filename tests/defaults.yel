// parameters' defaults, the directives (what the compiler knows: #file, #line, #column, #func,
// #location where they are written; #caller-location and #caller-expression as a default, the
// call's), and core's assert: a condition that fails tells where, and what (the condition as
// written, or the message given)

// a default for the parameters left out
greeting: func(name: string, word: string = "hello", times: s32 = 1) -> string {
    let words: list<string> = [];
    for step in 0..times { words.push(word); }
    "{words.join(" ")}, {name}"
}

record counter { value: s32, }

// a default after the first parameter: x.bumped() is bumped(x)
bumped: func(count: counter, by: s32 = 1) -> counter { { value: count.value + by, } }

// where it is written: this func's file, line and name
here: func() -> string { "{#file}:{#line}:{#column} in {#func}" }

// the call's place and the text of its argument, as a default
traced: func(value: s32, written: string = #caller-expression(value), at: source-location = #caller-location) -> string {
    "{written} = {value} at line {at.line}, in {at.func}"
}

main: func() -> s32 {
    print("{greeting("yel")} / {greeting("yel", "hi")} / {greeting("yel", "hey", 2)}\n");
    let start: counter = { value: 1, };
    print("{start.bumped().value} {start.bumped(5).value} {bumped(start).value}\n");
    print("{here()}\n");
    let place = #location;
    print("{place} in {place.func}\n");
    print("{traced(2 + 3)}\n");
    let total = 3;
    assert(total == 3);
    assert(total > 0, "total is positive");
    assert(total * 2 == 7);
    0
}
