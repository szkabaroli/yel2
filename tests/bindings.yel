// the analyses (readonly, moves, the host ends let go) know a local by its binding, not its name:
// another binding of the same name is another local

total: async func(s: stream<s32>) -> s32 {
    let t = 0;
    wait for x in s { t += x; }
    t
}

main: async func() {
    // the inner xs is another local: the outer, a literal, is made readonly
    let shared: list<s32> = [1,];
    let xs: list<s32> = [];
    if true {
        let xs = shared;
        xs.push(0);
    }
    let frozen: list<s32> & readonly = xs;
    shared.push(2);
    print("{frozen} {shared}\n");
    // so is a loop's b
    let a: list<s32> = [1,];
    let b: list<s32> = [];
    for i in 0..1 {
        let b = a;
        b.push(i);
    }
    let still: list<s32> & readonly = b;
    print("{still}\n");
    // a writer named w twice: each its own (the first closed where it is last used)
    let (s, w) = stream-pair(4);
    wait w.write(1);
    print("{wait total(s)}\n");
    let (s2, w) = stream-pair(4);
    wait w.write(2);
    print("{wait total(s2)}\n");
}
