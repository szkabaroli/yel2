// Visibility from another package: test:vis-lib's visible declarations, each kind (its private
// ones may not be named here: tests/errors/visibility-*.yel)

from "test:vis-lib" include api, more;

main: func(argv: list<string>) -> s32 {
    let p: api.Point = api.origin();
    let shapes: list<api.Shape> = [api.Shape.dot, api.Shape.circle(2),];
    let access = api.Access.read;
    let m: api.Meters = 4;
    print("{p} {shapes} {api.area(shapes[1])} {m}\n");
    print("same file {api.all-levels()}, other file {more.package-levels()}\n");
    0
}
