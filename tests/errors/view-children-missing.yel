// error: 6:24: the view of module plain-view takes no items: it has no #children
// help: put #children in its tree where what it is given goes
module user-view {
    view User {
        VStack {
            plain-view.Plain { Text { "given" } }
        }
    }
}

module plain-view {
    view Plain {
        Text { "no children here" }
    }
}

module ui {
    @(container)
    widget VStack {}

    @(container)
    widget Text {}
}

// the host's dom, as much as a view calls
module dom {
    variant color { red, }
    variant attribute-value { str(string), bool(bool), s32(s32), f64(f64), color(color), }
    create-element: func(tag: string) -> u32 { 0 }
    create-text: func(content: string) -> u32 { 0 }
    create-comment: func(content: string) -> u32 { 0 }
    set-attribute: func(node: u32, name: string, value: attribute-value) {}
    set-style: func(node: u32, name: string, value: attribute-value) {}
    set-text-content: func(node: u32, content: string) {}
    append-child: func(parent: u32, child: u32) {}
    insert-before: func(parent: u32, node: u32, reference: u32) {}
    remove: func(node: u32) {}
    add-event-listener: func(node: u32, event: string, handler-id: u32) {}
}
