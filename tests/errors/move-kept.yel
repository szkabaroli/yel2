// error: 8:43: out is moved, and it is kept elsewhere (stored, or captured by a closure)
from "wasi:cli" include stdout;

main: async func() {
    let (out, w) = stream-pair(4);
    let keep = [out,];
    w.close();
    let written = stdout.write-via-stream(out);
    print("used after move: {stream-closed(keep[0])}\n");
    wait written;
}
