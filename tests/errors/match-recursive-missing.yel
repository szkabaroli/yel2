// error: 5:5: the match has no arm for node({ left: node({ left: _, right: node(_) }), right: _ }): add one, or a _ arm
variant Tree { leaf, node(Node), }
record Node { left: Tree, right: Tree, }
depth: func(t: Tree) -> s32 {
    match t {
        leaf => 0,
        node({ left: leaf, right: _ }) => 1,
        node({ left: node({ left: _, right: leaf }), right: _ }) => 2,
    }
}
main: func() -> s32 { depth(Tree.leaf) }
