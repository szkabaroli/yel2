package yel:ui@0.1.0;

// Verbatim subset of external/yel/crates/yel-host/wit/deps/meshx-ui/dom.wit —
// only the `dom` interface, which is the sole stable host surface. The
// per-component interfaces in the original (counter, nested-parent, ...) are
// fixtures for the Rust host and are not part of the contract.
interface dom {
    variant color {
        red,
        green,
        blue,
        white,
        black,
        transparent,
        rgba(tuple<u8, u8, u8, u8>),
    }

    variant attribute-value {
        %str(string),
        %bool(bool),
        %s8(s8),
        %s16(s16),
        %s32(s32),
        %s64(s64),
        %u8(u8),
        %u16(u16),
        %u32(u32),
        %u64(u64),
        %f32(f32),
        %f64(f64),
        %char(char),
        %color(color),
        // A row-template binding: the NAME of a data-handle field, resolved
        // host-side per record. Never a value.
        %field(string),
    }

    create-element: func(tag: string) -> u32;
    create-text: func(content: string) -> u32;
    create-comment: func(content: string) -> u32;
    create-fragment: func() -> u32;

    set-attribute: func(node: u32, name: string, value: attribute-value);
    remove-attribute: func(node: u32, name: string);
    set-text-content: func(node: u32, content: string);
    /// `name` is from yel's style vocabulary, not a CSS property; the host builds
    /// the CSS from the value. A number or text; empty text clears the style.
    set-style: func(node: u32, name: string, value: attribute-value);

    append-child: func(parent: u32, child: u32);
    insert-before: func(parent: u32, node: u32, reference: u32);
    insert-after: func(parent: u32, node: u32, anchor: u32);
    remove-child: func(parent: u32, child: u32);
    remove: func(node: u32);

    get-parent: func(node: u32) -> u32;
    get-next-sibling: func(node: u32) -> u32;

    add-event-listener: func(node: u32, event: string, handler-id: u32);
    remove-event-listener: func(node: u32, event: string, handler-id: u32);

    /// Write plain text to the system clipboard. The host executes this only
    /// within a user-gesture callback, so ambient clipboard access is not
    /// possible.
    write-clipboard: func(text: string);
}
