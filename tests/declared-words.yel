// what yel takes as a name where it does not start a declaration: a func named async (not an
// async func: its call needs no wait), one named extern (no extern), a resource named record (a
// resource, shared), a type named distinct (an alias, not a distinct type), an enum named variant

async: func(n: s64) -> s64 { n + 1 }

extern: func() -> string { "not an extern" }

resource record { count: s64, }

type distinct = s64;

enum variant { first, second, }

main: func() {
    print("{async(1)}\n");
    print("{extern()}\n");
    let shared: record = { count: 1, };
    let other = shared;
    other.count = 2;
    print("{shared.count}\n");
    let plain: distinct = 5;
    let sum: s64 = plain + 1;
    print("{sum}\n");
    print("{variant.second:?}\n");
}
