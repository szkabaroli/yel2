// alternatives that bind: an arm for each (the same guard and body), each checked with its own
// bindings' types, so x is a For in one and a Loop in the other; an alternative inside a
// pattern (some(ok(n) | err(n))) is taken out to the arm

record For { name: string, body: list<string>, }
record Loop { body: list<string>, }
variant Stmt { for-stmt(For), loop-stmt(Loop), ret(s32), stop, }
body-len: func(s: Stmt) -> s64 {
    match s {
        for-stmt(x) | loop-stmt(x) => x.body.len(),
        ret(n) if n > 0 => n as s64,
        _ => 0,
    }
}
shape: func(v: option<result<s32, s32>>) -> string {
    match v {
        some(ok(n) | err(n)) => "a number {n}",
        none => "nothing",
    }
}
pair: func(t: tuple<s32, s32>) -> string {
    match t {
        (0, let y) | (let y, 0) => "one zero, other {y}",
        _ => "no zero",
    }
}
main: func() {
    let ss = [Stmt.for-stmt({ name: "i", body: ["a", "b",], }), Stmt.loop-stmt({ body: ["c",], }), Stmt.ret(7), Stmt.stop,];
    for s in ss { print("{body-len(s)} "); }
    print("\n{shape(some(ok(1)))} {shape(some(err(2)))} {shape(none)}\n");
    print("{pair((0, 5))} {pair((6, 0))} {pair((1, 1))}\n");
}
