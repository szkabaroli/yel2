// typed C: generic funcs compiled per type, options of options, equality and showing made per type

record Pair { name: string, scores: list<s32>, }

variant Tree {
    leaf(s32),
    node(list<Tree>),
    empty,
}

// a generic func: compiled once for each list of type arguments it is called with
first-or: func<T>(xs: list<T>, fallback: T) -> T {
    if xs.len() > 0 { xs[0] } else { fallback }
}

wrap: func<T>(v: T) -> option<T> { some(v) }

sum: func(t: Tree) -> s32 {
    match t {
        leaf(n) => n,
        node(kids) => {
            let total = 0;
            for k in kids { total += sum(k); }
            total
        }
        empty => 0,
    }
}

main: func(argv: list<string>) -> s32 {
    print("{first-or([3, 4,], 0)} {first-or([], "none")} {first-or([true,], false)}\n");
    print("{wrap(wrap(1))} {wrap([1, 2,])} {to-string(Tree.leaf(7))}\n");

    let nested: option<option<s32>> = some(none);
    print("{nested} {nested == some(none)} {nested == some(some(1))}\n");

    let t = Tree.node([Tree.leaf(1), Tree.node([Tree.leaf(2), Tree.empty,]), Tree.leaf(3),]);
    print("{t} = {sum(t)}\n");
    // a case by its payload: a list payload by identity
    print("{Tree.node([Tree.leaf(1),]) == Tree.node([Tree.leaf(1),])} {Tree.empty == Tree.empty}\n");

    // records by identity, strings by their bytes
    let a: Pair = { name: "a", scores: [1, 2,], };
    let b: Pair = { name: "a", scores: [1, 2,], };
    let same = a;
    print("{same == a} {a == b} {a.name == b.name} {"ab" == "a" + "b"}\n");

    let people = map.new();
    people.set("ann", a);
    people["ann"].scores.push(9);
    print("{people} {a.scores} {people["ann"]}\n");

    let xs = [[1,], [], [2, 3,],];
    xs.set(1, [4,]);
    let last = xs.pop();
    print("{xs} {last} {xs.len()}\n");

    // an if as a statement: its branches need not agree
    if xs.len() > 1 { print("many\n"); } else { xs.len(); }
    print("{[true, false,]} {to-string(12)}\n");
    0
}
