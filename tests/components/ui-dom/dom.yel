// A stand-in for the shell's host of yel:ui/dom (tests/components/ui-counter imports it): each call printed (to stderr: unbuffered, so its lines and its caller's come in the order made),
// node ids handed out from 1, so a run's output is the wire a host would see. It exports exactly
// yel:ui/dom@0.1.0 (tests/components/ui-wit/dom.wit, the shell's copy)

package yel:ui@0.1.0;

module dom {
    variant color { red, green, blue, white, black, transparent, rgba(tuple<u8, u8, u8, u8>), }

    variant attribute-value {
        str(string),
        bool(bool),
        s8(s8),
        s16(s16),
        s32(s32),
        s64(s64),
        u8(u8),
        u16(u16),
        u32(u32),
        u64(u64),
        f32(f32),
        f64(f64),
        char(char),
        color(color),
        field(string),
    }

    // the next node's id
    let next: u32 = 1;

    @(private) made: func(what: string) -> u32 {
        let id = next;
        next += 1;
        eprint("{what} -> {id}\n");
        id
    }

    create-element: func(tag: string) -> u32 { made("create-element({tag:?})") }
    create-text: func(content: string) -> u32 { made("create-text({content:?})") }
    create-comment: func(content: string) -> u32 { made("create-comment({content:?})") }
    create-fragment: func() -> u32 { made("create-fragment()") }

    set-attribute: func(node: u32, name: string, value: attribute-value) { eprint("set-attribute({node}, {name:?}, {value:?})\n"); }
    remove-attribute: func(node: u32, name: string) { eprint("remove-attribute({node}, {name:?})\n"); }
    set-text-content: func(node: u32, content: string) { eprint("set-text-content({node}, {content:?})\n"); }
    set-style: func(node: u32, name: string, value: attribute-value) { eprint("set-style({node}, {name:?}, {value:?})\n"); }

    append-child: func(parent: u32, child: u32) { eprint("append-child({parent}, {child})\n"); }
    insert-before: func(parent: u32, node: u32, reference: u32) { eprint("insert-before({parent}, {node}, {reference})\n"); }
    insert-after: func(parent: u32, node: u32, anchor: u32) { eprint("insert-after({parent}, {node}, {anchor})\n"); }
    remove-child: func(parent: u32, child: u32) { eprint("remove-child({parent}, {child})\n"); }
    remove: func(node: u32) { eprint("remove({node})\n"); }

    get-parent: func(node: u32) -> u32 { 0 }
    get-next-sibling: func(node: u32) -> u32 { 0 }

    add-event-listener: func(node: u32, event: string, handler-id: u32) { eprint("add-event-listener({node}, {event:?}, {handler-id})\n"); }
    remove-event-listener: func(node: u32, event: string, handler-id: u32) { eprint("remove-event-listener({node}, {event:?}, {handler-id})\n"); }

    write-clipboard: func(text: string) { eprint("write-clipboard({text:?})\n"); }
}
