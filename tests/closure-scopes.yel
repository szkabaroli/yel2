// a closure sees every local in scope where it is made: one bound after an if that leaves (whose
// test narrows the rest of the block) and one a match arm binds, as well as the narrowed names
// themselves, as they were before the test (a closure may run later)

type value = s32 | string;

count: func(n: s64) -> s64 {
    if n > 3 { return 1; }
    let names: list<string> = [];
    let add = { name: string -> names.push(name); };
    add("a");
    add("b");
    names.len()
}

show: func(v: value) -> string {
    if v is string { return "a string"; }
    // v is an s32 here, but not in the closure (it may run later)
    let doubled = v + v;
    let later = { -> v is s32 };
    "{doubled} {later()}"
}

describe: func(o: option<s32>) -> s32 {
    match o {
        some(n) => {
            let twice = { -> n * 2 };
            twice()
        }
        none => 0,
    }
}

main: func() -> s32 {
    print("{count(2)} {count(9)}\n");
    print("{show(4)} {show("x")}\n");
    print("{describe(some(21))} {describe(none)}\n");
    0
}
