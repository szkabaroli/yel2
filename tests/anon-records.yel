// anonymous records: a record by its fields, held by value; one set of fields is one type (in
// any order), a literal with no record wanted is one, and ...rest gathers a record's other fields

resource Person { name: string, age: s32, city: string, }

type point = { x: s32, y: s32 };

// the same type, its fields written in another order
mirror: func(p: { y: s32, x: s32 }) -> point { { x: p.y, y: p.x, } }

// several named results
bounds: func(xs: list<s32>) -> { min: s32, max: s32 } {
    let lo = xs[0];
    let hi = xs[0];
    for x in xs {
        if x < lo { lo = x; }
        if x > hi { hi = x; }
    }
    { min: lo, max: hi, }
}

where: func(p: point) -> string {
    match p {
        { x: 0, y: 0 } => "origin",
        { x: 0 } => "on the y axis",
        let { x, y } if x == y => "on the diagonal",
        _ => "somewhere",
    }
}

// ...rest: the fields not named, as an anonymous record
describe: func(p: Person) -> string {
    let { name, ...rest } = p;
    "{name}: {rest}"
}

// a value: given and changed elsewhere, this one stays
moved: func(p: point, by: s32) -> point { { x: p.x + by, y: p.y + by, } }

main: func() {
    // no record wanted: an anonymous one
    let a = { x: 1, y: 2, };
    let b: point = { y: 2, x: 1, };
    print("{a} {a == b} {mirror(a)} {a.x + a.y}\n");
    let r = bounds([4, -2, 9, 3,]);
    print("{r.min} {r.max} {r}\n");
    let points: list<point> = [{ x: 0, y: 0, }, { x: 0, y: 5, }, { x: 3, y: 3, }, { x: 4, y: 1, },];
    for p in points { print("{where(p)} "); }
    print("\n");
    let ada: Person = { name: "ada", age: 36, city: "london", };
    print("{describe(ada)}\n");
    let c = moved(a, 10);
    print("{a} {c}\n");
    // nested, and in an option and a list
    let nested = { id: 7, at: { x: 1, y: 1, }, tags: ["a", "b",], };
    let found: option<point> = some(nested.at);
    print("{nested} {found}\n");
}
