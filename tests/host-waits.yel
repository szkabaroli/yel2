// an async main waiting for the host's clock: natively a timer, as a component the host's wait
from "wasi:clocks" include monotonic-clock;

tick: async func(name: string, ms: u64) -> string {
    wait monotonic-clock.wait-for(ms * 1000000);
    name
}

main: async func() {
    let t0 = monotonic-clock.now();
    let a = start tick("slow", 90);
    let b = start tick("fast", 30);
    let first = wait a | b;
    let both = wait { x: a, y: b };
    let took = (monotonic-clock.now() - t0) / 1000000;
    print("{first} first, then {both.x} {both.y}, {if took >= 85 && took < 200 { "about 90" } else { "{took}" }} ms\n");
}
