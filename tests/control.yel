// control flow: early returns out of loops, short-circuits, nested blocks, shadowing, escapes

first-over: func(xs: list<s32>, limit: s32) -> s32 {
    for x in xs {
        if x > limit { return x; }
    }
    -1
}

loud: func(label: string, value: bool) -> bool {
    print("[{label}]");
    value
}

grade: func(score: s32) -> string {
    if score >= 90 { "a" }
    else if score >= 80 { "b" }
    else if score >= 70 { "c" }
    else { "f" }
}

main: func(argv: list<string>) -> s32 {
    print("first over 5: {first-over([3, 9, 4, 12,], 5)}\n");
    print("first over 50: {first-over([3, 9,], 50)}\n");

    // && and || stop as soon as the left side decides
    if loud("a", false) && loud("b", true) { print("no"); }
    if loud("c", true) || loud("d", true) { print(" short\n"); }

    let x = 1;
    {
        let x = 2;
        x += 40;
        print("inner {x}\n");
    }
    print("outer {x}\n");

    let grades = [];
    for s in [95, 85, 75, 10,] { grades.push(grade(s)); }
    print("grades {grades.join("")}\n");

    let total = 0;
    for i in 1..4 {
        for j in 1..=i { total += i * j; }
    }
    print("total {total}, 17 / 5 = {17 / 5}, 17 % 5 = {17 % 5}, -(3 - 10) = {-(3 - 10)}\n");
    print("tab:\t| quote: \" | brace: \{ok\} | backslash: \\\n");
    let found = if total > 20 { "big" } else { "small" };
    print("{found} {total == 25} {total != 25}\n");
    3
}
