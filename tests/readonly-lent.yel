// a std func's readonly parameter only reads what it is given (get-or here): a map made in a
// block is lent as a named one is, and what comes back is the caller's to write

main: func() -> s32 {
    let total = 0;
    let grid: map<string, list<list<s32>>> = map.new();
    grid.set("g", [[1,], [2, 3,],]);
    for line in grid.get-or("g", []) { line.push(9); total += line.len() as s32; }
    for row in ({ let m: map<string, list<list<s32>>> = map.new(); m.set("g", [[1,],]); m }).get-or("g", []) {
        row.push(9);
        total += row.len() as s32;
    }
    print("{total}\n");
    0
}
