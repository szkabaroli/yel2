// a module's funcs that take its own type first are that type's methods wherever it goes: called
// as one from outside the module (s.area(), not shapes.area(s)), and before std's of the same name
// (s.len() is shapes', not a list's)

module shapes {
    resource square { side: s64, }

    made: func(side: s64) -> square { { side: side, } }

    area: func(s: square) -> s64 { s.side * s.side }

    grown: func(s: square, by: s64) -> square { { side: s.side + by, } }

    // the length of its outline
    len: func(s: square) -> s64 { 4 * s.side }
}

main: func() {
    let s = shapes.made(3);
    print("{s.area()}\n");
    print("{s.grown(2).area()}\n");
    print("{s.len()}\n");
    let xs = [1, 2,];
    print("{xs.len()}\n");
}
