// a case declared with a () payload carries nothing, as one declared without: matched bare, or
// with () (found by tools/fuzz: a bare arm's pattern and the case had a field apart)

variant Signal { idle, ping(()), level(u32), }

describe: func(s: Signal) -> string {
    match s {
        idle => "idle",
        ping => "ping",
        level(n) => "level {n}",
    }
}

main: func() -> s32 {
    print("{describe(Signal.idle)} {describe(Signal.ping(()))} {describe(Signal.ping)} {describe(Signal.level(3))}\n");
    match Signal.ping {
        ping(()) => print("with ()\n"),
        _ => print("other\n"),
    }
    0
}
