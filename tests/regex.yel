    let t2 = "a\nc";
    print("2: " + (match r2.find(t2) { some(m) => show(m), none => "none", }) + " | " + r2.find-all(t2).map(show).join(" ") + " | " + r2.replace-all(t2, "<$&>").to-string() + "\n");
