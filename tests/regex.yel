// regex literals, compiled with the program: each case's first match (its text, where it is in
// bytes, its groups), every match, and each made <$&> (replace-all). The output is JavaScript's, by
// node, for the same patterns and texts (flag u: code points), its offsets as UTF-8's

show: func(m: regex-match) -> string {
    let groups: list<string> = [];
    for g in m.groups { groups.push(g.unwrap-or("-")); }
    "{m.text:?}@{m.start}-{m.end}[{groups.join(",")}]"
}

main: func() -> s32 {
    let r0 = /abc/;
    let t0 = "xxabcxx";
    print("0: " + (match r0.find(t0) { some(m) => show(m), none => "none", }) + " | " + r0.find-all(t0).map(show).join(" ") + " | " + r0.replace-all(t0, "<$&>").to-string() + "\n");
    let r1 = /a.c/;
    let t1 = "abc a\nc";
    print("1: " + (match r1.find(t1) { some(m) => show(m), none => "none", }) + " | " + r1.find-all(t1).map(show).join(" ") + " | " + r1.replace-all(t1, "<$&>").to-string() + "\n");
