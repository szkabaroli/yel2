    let r6 = /b$/m;
    let t6 = "ab\nab";
    print("6: " + (match r6.find(t6) { some(m) => show(m), none => "none", }) + " | " + r6.find-all(t6).map(show).join(" ") + " | " + r6.replace-all(t6, "<$&>").to-string() + "\n");
