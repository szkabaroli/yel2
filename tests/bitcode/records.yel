// record Name { fields }: a value, copied where it goes (a variable, a field, a parameter, a list's
// item), equal by its fields; a field is set where the record is (a variable, a field of one, a
// resource's field). A resource is a shared object instead: tests/resources-shared.yel

record Point { x: s32, y: s32, }

record Line { from: Point, to: Point, }

resource Canvas { cursor: Point, lines: list<Line>, }

// a global record: its zero value, each field's
let origin: Point;
let moves: s32;

// a parameter is the callee's own copy
nudge: func(p: Point) -> Point {
    p.x += 1;
    p
}

main: func() -> s32 {
    let a: Point = { x: 1, y: 2, };
    let b = a;
    b.x = 10;
    print("copies: {a} {b}\n");
    let moved = nudge(a);
    print("a param is a copy: {a} {moved}\n");
    // a record in a record: its field set in place
    let line: Line = { from: a, to: b, };
    line.to.y = 20;
    print("nested: {line.from} {line.to} {b}\n");
    // in a resource (one shared object): set in place, every name of it sees it
    let canvas: Canvas = { cursor: origin, lines: [], };
    canvas.cursor.x = 5;
    let same = canvas;
    same.cursor.y = 6;
    canvas.lines.push(line);
    print("in a resource: {canvas.cursor} {same.cursor} {canvas.lines.len()}\n");
    // equal by its fields, and so a map's key
    let seen: map<Point, string> = map.new();
    seen.set({ x: 1, y: 2, }, "first");
    print("equal: {a == { x: 1, y: 2, }} {seen[a]} {seen.has(b)}\n");
    // a global's field
    origin.x = 3;
    moves += 1;
    print("global: {origin} {moves}\n");
    // a list's item read is a copy: changing it changes the list's not
    let points: list<Point> = [a, b,];
    let first = points[0];
    first.y = 99;
    print("items: {points[0]} {first}\n");
    0
}
