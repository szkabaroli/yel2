// std:url against the WHATWG URL Standard as node has it (new URL): each URL read (its parts, and
// written again), and RFC 3986's references read against its base, http://a/b/c/d;p?q. The output is
// node's for the same texts (invalid where it throws)

from "std:url" include url;

prefixed: func(part: option<string>, mark: string) -> string {
    match part {
        some(text) => if text == "" { "" } else { mark + text },
        none => "",
    }
}

shown: func(r: result<url.parts, string>) -> string {
    match r {
        ok(u) => {
            let port = match u.port { some(p) => "{p}", none => "", };
            "{url.write(u)} | {u.scheme}: | {u.username} | {u.password} | {u.host.unwrap-or("")} | {port} | {u.path} | {prefixed(u.query, "?")} | {prefixed(u.fragment, "#")}"
        }
        err(_) => "invalid",
    }
}

main: func() -> s32 {
    let base = match url.parse("http://a/b/c/d;p?q") { ok(u) => u, err(e) => panic(e), };
    print(shown(url.parse("https://example.com")) + "\n");
    print(shown(url.parse("HTTPS://User:pa ss@Example.COM:443/a/./b/../c d?x=1 2#frag")) + "\n");
    print(shown(url.parse("http://example.com:8080/path?q=1#h")) + "\n");
    print(shown(url.parse("http://example.com:80/")) + "\n");
    print(shown(url.parse("ws://h:80/s")) + "\n");
    print(shown(url.parse("wss://h:443/")) + "\n");
    print(shown(url.parse("ftp://h:21/f")) + "\n");
    print(shown(url.parse("http://h/a/b/../../../c")) + "\n");
    print(shown(url.parse("http://h/a/%2e/b/%2E%2E/c")) + "\n");
    print(shown(url.parse("http://h/a/./")) + "\n");
    print(shown(url.parse("http://h/a/..")) + "\n");
    print(shown(url.parse("https://h/ä?ä#ä")) + "\n");
    print(shown(url.parse("https://h/a b?c d#e f")) + "\n");
    print(shown(url.parse("https://h/\{x\}^`|")) + "\n");
    print(shown(url.parse("https://h/?'\"<>")) + "\n");
    print(shown(url.parse("foo://h/?'")) + "\n");
    print(shown(url.parse("http://h/\\a\\b")) + "\n");
    print(shown(url.parse("mailto:ada@example.com")) + "\n");
    print(shown(url.parse("data:text/plain,hi there")) + "\n");
    print(shown(url.parse("foo:/a/./b")) + "\n");
    print(shown(url.parse("foo://h/a/../b")) + "\n");
    print(shown(url.parse("foo://h")) + "\n");
    print(shown(url.parse("file:///etc/hosts")) + "\n");
    print(shown(url.parse("file://localhost/a")) + "\n");
    print(shown(url.parse("file://Server/share/x")) + "\n");
    print(shown(url.parse("http://[::1]:8080/x")) + "\n");
    print(shown(url.parse("http://u@h/")) + "\n");
    print(shown(url.parse("http://u:@h/")) + "\n");
    print(shown(url.parse("http://:p@h/")) + "\n");
    print(shown(url.parse("https://h:65535/")) + "\n");
    print(shown(url.parse("https://h:65536/")) + "\n");
    print(shown(url.parse("http://h:x/")) + "\n");
    print(shown(url.parse("http:")) + "\n");
    print(shown(url.parse("http://")) + "\n");
    print(shown(url.parse("nope")) + "\n");
    print(shown(url.parse("  http://h/a\tb\n  ")) + "\n");
    print(shown(url.parse("https://h?")) + "\n");
    print(shown(url.parse("https://h#")) + "\n");
    print(shown(url.parse("https://h/?#")) + "\n");
    print(shown(url.parse("http://ex%41mple.com/")) + "\n");
    print(shown(url.parse("javascript:alert(1)")) + "\n");
    print(shown(url.parse("https://h/a;b=c")) + "\n");
    print(shown(url.parse("http://h/%zz")) + "\n");
    print(shown(url.parse("HTTP://H/P")) + "\n");
    print(shown(url.parse("https://h/a?b=c&d=e+f")) + "\n");
    print(shown(url.parse("sc+-.://h/x")) + "\n");
    print(shown(url.join(base, "g:h")) + "\n");
    print(shown(url.join(base, "g")) + "\n");
    print(shown(url.join(base, "./g")) + "\n");
    print(shown(url.join(base, "g/")) + "\n");
    print(shown(url.join(base, "/g")) + "\n");
    print(shown(url.join(base, "//g")) + "\n");
    print(shown(url.join(base, "?y")) + "\n");
    print(shown(url.join(base, "g?y")) + "\n");
    print(shown(url.join(base, "#s")) + "\n");
    print(shown(url.join(base, "g#s")) + "\n");
    print(shown(url.join(base, "g?y#s")) + "\n");
    print(shown(url.join(base, ";x")) + "\n");
    print(shown(url.join(base, "g;x")) + "\n");
    print(shown(url.join(base, "g;x?y#s")) + "\n");
    print(shown(url.join(base, "")) + "\n");
    print(shown(url.join(base, ".")) + "\n");
    print(shown(url.join(base, "./")) + "\n");
    print(shown(url.join(base, "..")) + "\n");
    print(shown(url.join(base, "../")) + "\n");
    print(shown(url.join(base, "../g")) + "\n");
    print(shown(url.join(base, "../..")) + "\n");
    print(shown(url.join(base, "../../")) + "\n");
    print(shown(url.join(base, "../../g")) + "\n");
    print(shown(url.join(base, "../../../g")) + "\n");
    print(shown(url.join(base, "../../../../g")) + "\n");
    print(shown(url.join(base, "/./g")) + "\n");
    print(shown(url.join(base, "/../g")) + "\n");
    print(shown(url.join(base, "g.")) + "\n");
    print(shown(url.join(base, ".g")) + "\n");
    print(shown(url.join(base, "g..")) + "\n");
    print(shown(url.join(base, "..g")) + "\n");
    print(shown(url.join(base, "./../g")) + "\n");
    print(shown(url.join(base, "./g/.")) + "\n");
    print(shown(url.join(base, "g/./h")) + "\n");
    print(shown(url.join(base, "g/../h")) + "\n");
    print(shown(url.join(base, "g;x=1/./y")) + "\n");
    print(shown(url.join(base, "g;x=1/../y")) + "\n");
    print(shown(url.join(base, "g?y/./x")) + "\n");
    print(shown(url.join(base, "g?y/../x")) + "\n");
    print(shown(url.join(base, "g#s/./x")) + "\n");
    print(shown(url.join(base, "g#s/../x")) + "\n");
    print(shown(url.join(base, "http:g")) + "\n");
    print(shown(url.join(base, "\\g")) + "\n");
    print(shown(url.join(base, "//h:99/x")) + "\n");
    0
}
