// a view composed across packages: kit's card (its title, what it is given, its close button) used
// by this package's page, its children and callback the page's (host: the stand-in dom and widgets
// both include)

package test:app;

from "./kit" include card-view;
from "./host" include dom, ui;

module page-view {
    view Page {
        @(private) count: s32 = 0;
        @(private) closed: s32 = 0;

        VStack {
            card-view.Card {
                title: "Count {count}"
                on.close: { -> closed += 1; }
                Button { on.click: { -> count += 1; }  "+" }
                Text { "closed {closed}" }
            }
        }
    }
}

main: func() {
    let p = page-view.new();
    page-view.mount(p, 0);
    let clicks = dom.handler-ids("click");
    print("click +\n");
    page-view.dispatch(p, clicks[0], event-payload.none);
    print("click close\n");
    page-view.dispatch(p, clicks[1], event-payload.none);
}
