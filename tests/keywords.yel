// keywords' words as names: one that starts what it names (record, type, enum, module, ...) is a
// name wherever a : follows it, as a declaration's name; any keyword is a name written %name, as
// WIT writes one (%in, %match). A % after a value is a remainder still: %if % 4, %if%4

record entry { %type: string, %in: s32, }

// contextual keywords: names where a : follows, with no escape
record: func(value: s32) -> s32 { value + 1 }
type: func() -> string { "a type" }
enum: func() -> string { "an enum" }

// a keyword: %name (a case's name before a ( and a member's after a . need none)
%match: func(%in: s32, %for: s32) -> s32 { %in * 10 + %for }

main: func() -> s32 {
    let %if = 7;
    let %let = %if % 4;
    let tight = %if%4;
    let found: entry = { %type: "file", %in: 3, };
    print("{record(1)} {type()} {enum()} {%match(%if, %let)} {tight}\n");
    print("{found.%type} {found.%in} {found.type} {found}\n");
    0
}
