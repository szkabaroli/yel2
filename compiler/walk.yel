// Walking the syntax tree: what a statement or an expression holds directly (its parts), and
// generators of everything inside a block or an expression, depth first, each in the order it is
// written. An analysis is a for over one of them (and a return once it knows), not a walker of its
// own. A closure's body is walked only where closures says so (what runs later is another
// question), and a loop's body only where loops says so (a break in it is its own).

module walk {
    // a statement's expressions and blocks (its own: what is inside them is theirs)
    stmt-parts: func(statement: Stmt, xs: list<Expr>, bs: list<Block>) {
        match statement {
            let-stmt(declared) => xs.push(declared.value),
            let-pattern(destructured) => xs.push(destructured.value),
            return-stmt(returned) => xs.push(returned),
            for-stmt(iteration) => {
                xs.push(iteration.start);
                match iteration.stop {
                    some(stop) => xs.push(stop),
                    none => {}
                }
                bs.push(iteration.body);
            }
            loop-stmt(repeating) => bs.push(repeating.body),
            assign(assigned) => xs.push(assigned.value),
            assign-field(assigned) => {
                xs.push(assigned.target);
                xs.push(assigned.value);
            }
            expr-stmt(evaluated) => xs.push(evaluated.value),
            break-stmt => {}
            continue-stmt => {}
        }
    }

    // an expression's direct parts: its expressions, and its blocks (a closure's among them)
    expr-parts: func(expression: Expr, xs: list<Expr>, bs: list<Block>) {
        match expression.kind {
            closure(cl) => bs.push(cl.body),
            if-else(conditional) => {
                xs.push(conditional.cond);
                bs.push(conditional.then);
                match conditional.otherwise {
                    some(otherwise) => bs.push(otherwise),
                    none => {}
                }
            }
            block(inner) => bs.push(inner),
            match-expr(matching) => {
                xs.push(matching.value);
                for arm in matching.arms {
                    match arm.guard {
                        some(guard) => xs.push(guard),
                        none => {}
                    }
                    xs.push(arm.body);
                }
            }
            _ => effects.sub-exprs(expression, xs),
        }
    }

    // whether a statement is a loop (its body's breaks and continues are its own)
    is-loop: func(statement: Stmt) -> bool {
        match statement {
            for-stmt(_) => true,
            loop-stmt(_) => true,
            _ => false,
        }
    }

    is-closure: func(expression: Expr) -> bool {
        match expression.kind {
            closure(_) => true,
            _ => false,
        }
    }

    // every expression in a block, the outer before the inner
    exprs: func(block: Block, closures: bool) -> seq<Expr> {
        for statement in block.stmts {
            for expression in stmt-exprs(statement, closures) { yield expression; }
        }
    }

    // every expression in a statement
    stmt-exprs: func(statement: Stmt, closures: bool) -> seq<Expr> {
        let xs: list<Expr> = [];
        let bs: list<Block> = [];
        stmt-parts(statement, xs, bs);
        for part in xs {
            for expression in tree(part, closures) { yield expression; }
        }
        for child in bs {
            for expression in exprs(child, closures) { yield expression; }
        }
    }

    // an expression, and every expression in it
    tree: func(expression: Expr, closures: bool) -> seq<Expr> {
        yield expression;
        if !closures && is-closure(expression) { return; }
        let xs: list<Expr> = [];
        let bs: list<Block> = [];
        expr-parts(expression, xs, bs);
        for part in xs {
            for inner in tree(part, closures) { yield inner; }
        }
        for child in bs {
            for inner in exprs(child, closures) { yield inner; }
        }
    }

    // every statement in a block, nested ones too (in its expressions' blocks), the outer first;
    // a loop's body where loops says so
    stmts: func(block: Block, closures: bool, loops: bool) -> seq<Stmt> {
        for statement in block.stmts {
            yield statement;
            if loops || !is-loop(statement) {
                let xs: list<Expr> = [];
                let bs: list<Block> = [];
                stmt-parts(statement, xs, bs);
                for part in xs {
                    for nested in expr-stmts(part, closures, loops) { yield nested; }
                }
                for child in bs {
                    for nested in stmts(child, closures, loops) { yield nested; }
                }
            }
        }
    }

    // every statement in an expression's blocks
    expr-stmts: func(expression: Expr, closures: bool, loops: bool) -> seq<Stmt> {
        if !closures && is-closure(expression) { return; }
        let xs: list<Expr> = [];
        let bs: list<Block> = [];
        expr-parts(expression, xs, bs);
        for part in xs {
            for nested in expr-stmts(part, closures, loops) { yield nested; }
        }
        for child in bs {
            for nested in stmts(child, closures, loops) { yield nested; }
        }
    }

    // the bindings a pattern makes (its names', ...rest's)
    pattern-marks: func(pattern: Pattern) -> seq<Mark> {
        match pattern {
            name(name) => { if name.kind == "bind" { yield name.mark; } }
            record(record) => {
                for field in record.patterns { for mark in pattern-marks(field) { yield mark; } }
                if record.rest != "" { yield record.rest-mark; }
            }
            _ => { for part in sub-patterns(pattern) { for mark in pattern-marks(part) { yield mark; } } }
        }
    }

    // whether a pattern makes the binding
    pattern-binds: func(pattern: Pattern, binding: Mark) -> bool {
        for mark in pattern-marks(pattern) { if mark == binding { return true; } }
        false
    }

    // the patterns a pattern is made of (a record's: its fields')
    sub-patterns: func(pattern: Pattern) -> list<Pattern> {
        match pattern {
            case(variant-case) => [variant-case.sub,],
            record(record) => record.patterns,
            tuple(parts) => parts,
            alt(alternatives) => alternatives,
            typed(typed) => [typed.sub,],
            member(member) => [member.sub,],
            _ => [],
        }
    }

    // whether an expression reads a name (a closure's too)
    mentions: func(expression: Expr, wanted: string) -> bool {
        for inner in tree(expression, true) {
            match inner.kind {
                name(read) => { if read == intern(wanted) { return true; } }
                _ => {}
            }
        }
        false
    }

}
