// Bytes and names: what the lexer, the parser and the generator all read strings with.

// ================================================================ names

// a name, interned: one id for each distinct string (two names are the same name exactly when
// their ids are equal), so a map keyed by names hashes and compares a number, not the bytes
type Name = distinct s64;

// every name interned so far: its id by its text, and its text by its id (in the order interned)
let name-ids: map<string, Name>;
let name-texts: list<string>;

// text's name (made the first time it is asked for)
intern: func(text: string) -> Name {
    match name-ids.get(text) {
        some(id) => id,
        none => {
            let id = name-texts.len() as Name;
            name-texts.push(text);
            name-ids.set(text, id);
            id
        }
    }
}

// a name's text
name-text: func(name: Name) -> string { name-texts[name as s64] }

// a name as it shows in a string ("record {name} has no field": its text, not its id)
display: func(name: Name) -> string { name-text(name) }

is-alpha: func(byte: s64) -> bool {
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95
}

is-digit: func(byte: s64) -> bool {
    byte >= 48 && byte <= 57
}

is-name-char: func(byte: s64) -> bool {
    is-alpha(byte) || is-digit(byte)
}

// where a name that starts at i ends: a hyphen is part of it only when a name character follows
name-end: func(src: string, begin: s64) -> s64 {
    let length = src.len();
    for index in begin..length {
        let byte = src.byte-at(index);
        if !is-name-char(byte) && !(byte == 45 && is-name-char(src.byte-at(index + 1))) { return index; }
    }
    length
}

digits-end: func(src: string, begin: s64) -> s64 {
    let length = src.len();
    for index in begin..length {
        if !is-digit(src.byte-at(index)) { return index; }
    }
    length
}

// a number that starts at i: where it ends, and whether it is a float. 0x, 0o and 0b take their
// radix's digits; a fraction (when allowed) needs a digit after the `.`, an exponent one after e
record NumberEnd { end: s64, is-float: bool, }

number-end: func(src: string, begin: s64, fraction: bool) -> NumberEnd {
    if src.byte-at(begin) == 48 {
        let radix = radix-of(src.byte-at(begin + 1));
        if radix > 0 && radix-digit(src.byte-at(begin + 2), radix) {
            return { end: radix-end(src, begin + 2, radix), is-float: false, };
        }
    }
    let end = digits-end(src, begin);
    let is-float = false;
    if fraction && src.byte-at(end) == 46 && is-digit(src.byte-at(end + 1)) {
        end = digits-end(src, end + 1);
        is-float = true;
    }
    let marker = src.byte-at(end);
    if marker == 101 || marker == 69 {
        let cursor = end + 1;
        let sign = src.byte-at(cursor);
        if sign == 43 || sign == 45 { cursor += 1; }
        if is-digit(src.byte-at(cursor)) {
            end = digits-end(src, cursor);
            is-float = true;
        }
    }
    { end: end, is-float: is-float, }
}

// 16, 8 or 2 for the letter after a 0 (x, o, b); 0 for none
radix-of: func(byte: s64) -> s64 {
    if byte == 120 { 16 } else if byte == 111 { 8 } else if byte == 98 { 2 } else { 0 }
}

radix-digit: func(byte: s64, radix: s64) -> bool {
    if radix == 16 { is-digit(byte) || (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70) }
    else if radix == 8 { byte >= 48 && byte <= 55 }
    else { byte == 48 || byte == 49 }
}

radix-end: func(src: string, begin: s64, radix: s64) -> s64 {
    let length = src.len();
    for index in begin..length {
        if !radix-digit(src.byte-at(index), radix) { return index; }
    }
    length
}

// where a character literal's text ends (its closing '), from just after the opening one
char-end: func(src: string, from: s64) -> s64 {
    let length = src.len();
    let at = from;
    for step in 0..length + 1 {
        if at >= length { return length; }
        let byte = src.byte-at(at);
        if byte == 39 { return at; }
        if byte == 10 { return length; }
        if byte == 92 { at += 2; } else { at += 1; }
    }
    length
}

line-end: func(src: string, begin: s64) -> s64 {
    let length = src.len();
    for index in begin..length {
        if src.byte-at(index) == 10 { return index; }
    }
    length
}

// where a string's text ends (its closing quote), from just after the opening one: a quote inside
// an interpolation's braces opens a string of that expression's
// whether the { at raw[i] opens an interpolation in a C template (c"..."): a name or a ( follows
opens-interp: func(raw: string, at: s64) -> bool {
    let byte = raw.byte-at(at + 1);
    is-alpha(byte) || byte == 40
}

// where a string's text ends (its closing quote), from just after the opening one: its
// interpolations' braces counted (in a C template, c"...", only those that open one)
string-end: func(src: string, from: s64) -> s64 { quote-end(src, from, false) }

template-end: func(src: string, from: s64) -> s64 { quote-end(src, from, true) }

quote-end: func(src: string, from: s64, template: bool) -> s64 {
    let len = src.len();
    let at = from;
    let depth = 0;
    for step in 0..len + 1 {
        if at >= len { return len; }
        let byte = src.byte-at(at);
        if byte == 92 {
            at += 2;
        } else if byte == 34 && depth == 0 {
            return at;
        } else if byte == 34 {
            at = string-end(src, at + 1) + 1;
        } else {
            if byte == 123 && (!template || depth > 0 || opens-interp(src, at)) { depth += 1; }
            if byte == 125 && (!template || depth > 0) { depth -= 1; }
            at += 1;
        }
    }
    len
}

newlines: func(src: string, from: s64, to: s64) -> s64 {
    let count = 0;
    for index in from..to {
        if src.byte-at(index) == 10 { count += 1; }
    }
    count
}

// the last newline in src[from..to], or -1
last-newline: func(src: string, from: s64, to: s64) -> s64 {
    let found = -1;
    for index in from..to {
        if src.byte-at(index) == 10 { found = index; }
    }
    found
}

hex-value: func(digit: s64) -> s64 {
    if digit <= 57 { digit - 48 } else if digit >= 97 { digit - 87 } else { digit - 55 }
}

// an id without its version: ns:name@1.0.0 is ns:name
without-version: func(id: string) -> string {
    for index in 0..id.len() {
        if id.byte-at(index) == 64 { return id.substring(0, index); }
    }
    id
}

// a number written in decimal digits (a tuple field's name), or -1
tuple-index: func(field: string) -> s64 {
    let value = 0;
    for index in 0..field.len() {
        let digit = field.byte-at(index);
        if !is-digit(digit) || index > 6 { return -1; }
        value = value * 10 + digit - 48;
    }
    value
}

// a key's last part: its name in its module
base-name: func(key: string) -> string {
    let length = key.len();
    for index in 0..length {
        let byte = key.byte-at(length - 1 - index);
        if byte == 46 || byte == 47 { return key.substring(length - index, length); }
    }
    key
}

// an interpolation's format spec ("{x:spec}"): [[fill]align][0][width][.precision][kind]
// align is < (left), > (right) or ^ (centered), "" for the value's own (a number's right, else left);
// width and precision -1 where not given; kind ? (debug: WAVE), x X (hex), b (binary), o (octal),
// "" for its display
resource FormatSpec {
    fill: string,
    align: string,
    zero: bool,
    width: s64,
    precision: s64,
    kind: string,
}

// spec read as a format spec; none where it is not one
format-spec: func(spec: string) -> option<FormatSpec> {
    let out: FormatSpec = { fill: " ", align: "", zero: false, width: -1, precision: -1, kind: "", };
    let len = spec.len();
    let at = 0;
    // a fill is any one char before an align
    let first = char-width(spec.byte-at(0));
    if len > first && is-align(spec.byte-at(first)) {
        out.fill = spec.substring(0, first);
        out.align = from-byte(spec.byte-at(first));
        at = first + 1;
    } else if len > 0 && is-align(spec.byte-at(0)) {
        out.align = from-byte(spec.byte-at(0));
        at = 1;
    }
    if at < len && spec.byte-at(at) == 48 {
        out.zero = true;
        at += 1;
    }
    let width = digits-end(spec, at);
    if width > at { out.width = decimal(spec.substring(at, width)); }
    at = width;
    if at < len && spec.byte-at(at) == 46 {
        let precision = digits-end(spec, at + 1);
        if precision == at + 1 { return none; }
        out.precision = decimal(spec.substring(at + 1, precision));
        at = precision;
    }
    if at < len {
        let kind = from-byte(spec.byte-at(at));
        if kind != "?" && kind != "x" && kind != "X" && kind != "b" && kind != "o" { return none; }
        out.kind = kind;
        at += 1;
    }
    if at != len || len == 0 { return none; }
    some(out)
}

is-align: func(byte: s64) -> bool { byte == 60 || byte == 62 || byte == 94 }

// how many bytes the UTF-8 char that starts with byte takes
char-width: func(byte: s64) -> s64 {
    if byte < 128 { 1 } else if byte >= 240 { 4 } else if byte >= 224 { 3 } else { 2 }
}

// a run of decimal digits' value (capped: a spec's width is small)
decimal: func(digits: string) -> s64 {
    let value = 0;
    for at in 0..digits.len() {
        if value < 100000 { value = value * 10 + digits.byte-at(at) - 48; }
    }
    value
}
