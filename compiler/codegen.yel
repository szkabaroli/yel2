// Codegen: a checked func to the IR (ir.yel), built from the checked tree.
// Part of the generator's module: it reads the types (c-type, and the helpers they make) as the C
// does. An expression's node is pure (ir.yel): anything that calls or reads what may change is
// bound to a local where it is met, so what runs runs in order.

// the func being built: its IR, the statements being added (the innermost body's), and each yel
// name's place, scope by scope; the environments it holds (innermost last); the func a closure is
// made in (whose captured names it reaches through environments); how many closures it has made
resource Codegen {
    g: Gen,
    f: IrFunc,
    out: list<Node>,
    scopes: list<map<Name, Var>>,
    chain: list<EnvRef>,
    parent: option<Codegen>,
    closures: s64,
    // the statement or expression being built: where what is made of it is
    span: Span,
}

// a yel name's place: a local (its index), or (env) a field of an environment (a captured binding)
resource Var { local: s64, env: option<Env>, field: string, ty: Type, }

// an environment: the record the closures made in one unit (a func's, a closure's or a for's body;
// a for's, one each turn) share, holding its captured bindings and (up) the environment around it;
// rec: the record's key, its fields known once the unit is built
resource Env { rec: string, up: option<Env>, fields: list<string>, types: list<Type>, }

// an environment a func holds in a local: one it made (up-value: its up, to store), or (a
// closure's) the one it was made in, its first param
// what a match arm's pattern binds: a name, its value
resource PatternBinding { name: string, value: Node, mark: Mark, }

resource EnvRef { env: Env, local: s64, up-value: option<Node>, }

module gen {
    new-local: func(coding: Codegen, ty: Type, name: string) -> s64 {
        coding.f.locals.push({ ty: ty, name: name, binding: none, });
        coding.f.locals.len() - 1
    }

    // n, the next of the statements being made: none past a call that never returns (they never
    // run); such a call is kept on its own (no value of it to assign), then a halt
    add: func(coding: Codegen, node: Node) {
        if coding.out.len() > 0 {
            match coding.out[coding.out.len() - 1].kind {
                halt => { return; }
                _ => {}
            }
        }
        stamp(node, coding.span);
        let call = match node.kind {
            assign(assignment) => assignment.value,
            _ => node,
        };
        let never = is-never(call.ty) && match call.kind {
            call(_) => true,
            call-ref(_) => true,
            _ => false,
        };
        if never {
            coding.out.push(call);
            coding.out.push(halt-stmt());
        } else {
            coding.out.push(node);
        }
    }

    local-node: func(coding: Codegen, slot: s64) -> Node { local(slot, coding.f.locals[slot].ty) }

    // a node in a new temporary
    temp: func(coding: Codegen, node: Node) -> Node {
        let slot = new-local(coding, node.ty, "");
        add(coding, assign(slot, node));
        local-node(coding, slot)
    }

    // a node as an operand: itself when pure, else in a temporary
    bind: func(coding: Codegen, node: Node) -> Node { if pure(node) { node } else { temp(coding, node) } }

    // a node read more than once: a local or a constant, else in a temporary
    pin: func(coding: Codegen, node: Node) -> Node {
        match node.kind {
            local(_) => node,
            const(_) => node,
            _ => temp(coding, node),
        }
    }

    // the runtime's funcs that never allocate (so never collect): they read and write memory only
    quiet: func() -> list<string> {
        ["yel_eprint", "yel_panic", "yel_buffer_string",]
    }

    // the runtime's funcs an intrinsic may call and stay quiet (they never allocate)
    quiet-helpers: func() -> list<string> {
        ["y_hash_bits", "y_hash_mix",]
    }

    // an intrinsic that calls nothing of the runtime's (y_...) but quiet helpers
    quiet-template: func(template: string) -> bool {
        let at = find(template, "y_").unwrap-or(-1);
        for step in 0..template.len() {
            if at < 0 { return true; }
            let end = at;
            for skip in at..template.len() {
                if end < template.len() && is-name-char(template.byte-at(end)) { end += 1; }
            }
            // a call (y_x(...)); a variable (y_async_now, y_k_) does nothing
            if template.byte-at(end) == 40 && !contains(quiet-helpers(), template.substring(at, end)) { return false; }
            at = find-from(template, "y_", end).unwrap-or(-1);
        }
        true
    }

    // a call to the runtime, which may do anything (collect too) but for a quiet one
    runtime-call: func(c-name: string, args: list<Node>, ty: Type) -> Node {
        // an intrinsic reads and writes memory, and may collect only where it calls the runtime
        let effects = if contains(quiet(), c-name) || (is-template(c-name) && quiet-template(c-name)) {
            fx().read-mem | fx().write-mem
        } else {
            fx().call
        };
        call("", c-name, args, ty, effects)
    }

    // an extern's C name that is C written in place (in parentheses), $1, $2, ... its arguments
    is-template: func(c-name: string) -> bool { find-byte(c-name, 36) != none || c-name.byte-at(0) == 40 }

    // whether a template reads its argument n ($n, not the start of a longer number)
    mentions: func(template: string, position: s64) -> bool {
        let mark = "$" + "{position}";
        let at = find(template, mark).unwrap-or(-1);
        for step in 0..template.len() {
            if at < 0 { return false; }
            if !is-digit(template.byte-at(at + mark.len())) { return true; }
            at = find-from(template, mark, at + 1).unwrap-or(-1);
        }
        false
    }

    // a call of a std func (by its key) the compiler writes: string + and ==
    std-call: func(generator: Gen, key: string, args: list<Node>, ty: Type) -> Node {
        call(key, std-func(generator, key), args, ty, fx().call)
    }

    // a C helper that only computes (y_add_s32, an equality)
    pure-call: func(c-name: string, args: list<Node>, ty: Type) -> Node {
        call("", c-name, args, ty, 0)
    }

    // a yel name's binding, declared in the innermost scope: a local, or (captured: a closure reads
    // it) a field of its unit's environment, the innermost this func holds
    declare: func(coding: Codegen, ty: Type, name: string, mark: Mark) -> Var {
        let value: Var = { local: -1, env: none, field: "", ty: ty, };
        if mark.captured {
            let environment = coding.chain[coding.chain.len() - 1].env;
            // a name its unit binds twice (in two blocks) is two fields
            let field = name;
            for index in 1..environment.fields.len() + 2 {
                if contains(environment.fields, field) { field = "{name}-{index}"; }
            }
            environment.fields.push(field);
            environment.types.push(ty);
            value.env = some(environment);
            value.field = field;
        } else {
            value.local = new-local(coding, ty, name);
            coding.f.locals[value.local].binding = some(mark);
        }
        coding.scopes[coding.scopes.len() - 1].set(intern(name), value);
        value
    }

    // a param: a local (a C function's param), and (captured) a field of the environment, which the
    // prologue copies it to (into stores)
    declare-param: func(coding: Codegen, ty: Type, name: string, mark: Mark, stores: list<Node>) -> s64 {
        let slot = new-local(coding, ty, name);
        coding.f.locals[slot].binding = some(mark);
        if mark.captured {
            let variable = declare(coding, ty, name, mark);
            stores.push(write-var(coding, variable, local-node(coding, slot)));
        } else {
            coding.scopes[coding.scopes.len() - 1].set(intern(name), { local: slot, env: none, field: "", ty: ty, });
        }
        slot
    }

    // a yel name's binding: this func's, or (a closure's) a captured one of the func it is made in
    lookup: func(coding: Codegen, name: Name) -> option<Var> {
        let count = coding.scopes.len();
        for index in 0..count {
            let scope = coding.scopes[count - 1 - index];
            if scope.has(name) { return some(scope[name]); }
        }
        match coding.parent {
            some(payload) => lookup(payload, name),
            none => none,
        }
    }

    is-local: func(coding: Codegen, name: string) -> bool {
        match lookup(coding, intern(name)) {
            some(_) => true,
            none => false,
        }
    }

    // a binding's value
    read-var: func(coding: Codegen, variable: Var) -> Node {
        match variable.env {
            none => local-node(coding, variable.local),
            some(environment) => bind(coding, load(env-node(coding, environment), ["f_" + mangle(variable.field),], true, variable.ty, true)),
        }
    }

    // where a binding's value is: its local, or its field in the environment that holds it (a
    // place written in place: a fixed-length list's item)
    var-place: func(coding: Codegen, variable: Var) -> Node {
        match variable.env {
            none => local-node(coding, variable.local),
            some(environment) => load(env-node(coding, environment), ["f_" + mangle(variable.field),], true, variable.ty, true),
        }
    }

    // a binding given a value
    write-var: func(coding: Codegen, variable: Var, value: Node) -> Node {
        match variable.env {
            none => assign(variable.local, value),
            some(environment) => store(load(env-node(coding, environment), ["f_" + mangle(variable.field),], true, variable.ty, true), value),
        }
    }

    // an environment, reached from the innermost this func holds by its ups
    env-node: func(coding: Codegen, environment: Env) -> Node {
        let innermost = coding.chain[coding.chain.len() - 1];
        let node = local-node(coding, innermost.local);
        let at = innermost.env;
        loop {
            if at.rec == environment.rec { return node; }
            match at.up {
                some(outer) => {
                    node = load(node, ["f_up",], true, Type.named(intern(outer.rec)), false);
                    at = outer;
                }
                none => {
                    panic("{coding.f.c-name}: the environment {environment.rec} is not around it")
                }
            }
        }
    }

    // a unit's start: its environment (when a closure captures one of its bindings), in a local,
    // its up the environment around it
    enter-unit: func(coding: Codegen, unit: Unit) -> option<EnvRef> {
        if !unit.env { return none; }
        coding.g.envs += 1;
        let key = "yel:env/{coding.g.envs}";
        let up: option<Env> = none;
        let up-value: option<Node> = none;
        if coding.chain.len() > 0 {
            let outer = coding.chain[coding.chain.len() - 1].env;
            up = some(outer);
            up-value = some(env-node(coding, outer));
        }
        let environment: Env = { rec: key, up: up, fields: [], types: [], };
        match up {
            some(outer) => {
                environment.fields.push("up");
                environment.types.push(Type.named(intern(outer.rec)));
            }
            none => {}
        }
        let reference: EnvRef = { env: environment, local: new-local(coding, Type.named(intern(key)), ""), up-value: up-value, };
        coding.chain.push(reference);
        some(reference)
    }

    // a unit's end: its environment's record declared (its fields known now), and its prologue:
    // the environment made, its up set, then then (a captured param's copy, a for's variable)
    exit-unit: func(coding: Codegen, unit: option<EnvRef>, then: list<Node>) -> list<Node> {
        match unit {
            none => then,
            some(reference) => {
                coding.chain.pop();
                let generator = coding.g;
                let environment = reference.env;
                let decl: RecordDecl = {
                    span: { source: -1, line: 0, col: 0, end-line: 0, end-col: 0, },
                    scope: blank-scope(generator.file),
                    name: environment.rec,
                    fields: environment.fields,
                    field-types: environment.types,
                    value: false,
                    observable: false,
                    ignored: [],
                };
                generator.symbols.records.set(intern(environment.rec), decl);
                generator.env-decls.push(decl);
                let ty = Type.named(intern(environment.rec));
                let out = [
                    assign(
                        reference.local,
                        alloc("R_" + mangle(environment.rec), environment.rec, true, trace-fn(generator, intern(environment.rec)), ty),
                    ),
                ];
                match reference.up-value {
                    some(outer) => out.push(
                        store(load(local-node(coding, reference.local), ["f_up",], true, outer.ty, false), outer)
                    ),
                    none => {}
                }
                for node in then { out.push(node); }
                out
            }
        }
    }

    concat: func(first: list<Node>, second: list<Node>) -> list<Node> {
        let out: list<Node> = [];
        for node in first { out.push(node); }
        for node in second { out.push(node); }
        out
    }

    // whether the expression names a variant, enum or flags type (Type in Type.case), not a local
    is-type: func(coding: Codegen, expression: Expr) -> bool {
        match expression.kind {
            name(name) => (coding.g.symbols.variants.has(name) || coding.g.symbols.flags.has(name)) && !is-local(coding, name-text(name)),
            _ => false,
        }
    }

    // the func (a func of its own) built: g.subst holds its type arguments, when generic
    codegen-func: func(generator: Gen, function: Func, c-name: string) -> IrFunc {
        let fn: IrFunc = {
            key: function.name,
            span: function.span,
            c-name: c-name,
            name: intern(c-name),
            params: [],
            locals: [],
            body: [],
            // a generator's frame holds the value it yields last
            result: decl-type(generator, function.type-params, if function.is-generator { seq-item(function.result) } else { function.result }),
            labels: 0,
            rooted: [],
            closure: false,
            env-param: -1,
            async: function.is-async || function.is-generator,
            states: 0,
            generator: function.is-generator,
            void-result: false,
            export-name: "",
            build: "",
            release: false,
        };
        let coding: Codegen = {
            g: generator,
            f: fn,
            out: [],
            scopes: [map.new(),],
            chain: [],
            parent: none,
            closures: 0,
            span: { source: -1, line: 0, col: 0, end-line: 0, end-col: 0, },
        };
        let unit = enter-unit(coding, function.unit);
        let stores: list<Node> = [];
        for index in 0..function.params.len() {
            let declared = decl-type(generator, function.type-params, function.param-types[index]);
            fn.params.push(declare-param(coding, declared, function.params[index], function.marks[index], stores));
        }
        if function.is-generator {
            gen-block(coding, function.body, false);
            add(coding, return-stmt(unit-const()));
        } else {
            gen-return(coding, function.body, fn.result);
        }
        fn.body = concat(exit-unit(coding, unit, stores), coding.out);
        fn
    }

    // a body, its value returned (unit for a func of none)
    gen-return: func(coding: Codegen, body: Block, result: Type) {
        match result {
            unit-type => {
                gen-block(coding, body, false);
                add(coding, return-stmt(unit-const()));
            }
            _ => {
                let value = gen-block(coding, body, true);
                // a body that never gets to its end returns from within
                if !checker.leaves(body) { add(coding, return-stmt(value)); }
            }
        }
    }

    // x as T (the checker allowed it): C's conversion where it is defined as the table has it (an
    // integer wraps; to a float, the nearest), else a helper: a float to an integer saturates (NaN
    // is 0), f64 to f32 is an infinity past f32's range, an integer to a char is U+FFFD where it
    // is no Unicode scalar value
    gen-cast: func(coding: Codegen, expression: Expr, casting: Cast) -> Node {
        let generator = coding.g;
        let value = gen-expr(coding, casting.value);
        let from = expr-type(generator, casting.value);
        let to = expr-type(generator, expression);
        if show-type(from) == show-type(to) { return value; }
        let float-from = match from {
            num(number) => !is-int(number),
            _ => false,
        };
        match to {
            char-type => pure-call("y_to_char", [convert(Type.num("s64"), value),], to),
            num(number) => {
                if is-int(number) && float-from { return pure-call("y_sat_{number}", [value,], to); }
                if number == "f32"
                    && show-type(from) == "f64" { return pure-call("y_f64_to_f32", [value,], to); }
                convert(to, value)
            }
            _ => convert(to, value),
        }
    }

    // a closure literal: its body a func of its own (lifted), which takes the environment it is
    // made in (the innermost this func holds) first; its value that func and that environment
    gen-closure: func(coding: Codegen, expression: Expr, cl: Closure) -> Node {
        let generator = coding.g;
        let expression-type = expr-type(generator, expression);
        let ps: list<Type> = [];
        let rt = Type.unit-type;
        match expression-type {
            func-type(function-type) => {
                ps = function-type.params;
                rt = function-type.result;
            }
            _ => {}
        }
        coding.closures += 1;
        let c-name = "{coding.f.c-name}__c{coding.closures}";
        let fn: IrFunc = {
            key: c-name,
            span: expression.span,
            c-name: c-name,
            name: intern(c-name),
            params: [],
            locals: [],
            body: [],
            result: rt,
            labels: 0,
            rooted: [],
            closure: true,
            env-param: -1,
            async: false,
            states: 0,
            generator: false,
            void-result: false,
            export-name: "",
            build: "",
            release: false,
        };
        let inner: Codegen = {
            g: generator,
            f: fn,
            out: [],
            scopes: [map.new(),],
            chain: [],
            parent: some(coding),
            closures: 0,
            span: { source: -1, line: 0, col: 0, end-line: 0, end-col: 0, },
        };
        let env = null-const();
        if coding.chain.len() > 0 {
            let outer = coding.chain[coding.chain.len() - 1].env;
            let slot = new-local(inner, Type.named(intern(outer.rec)), "");
            fn.env-param = slot;
            inner.chain.push({ env: outer, local: slot, up-value: none, });
            env = env-node(coding, outer);
        }
        let unit = enter-unit(inner, cl.unit);
        let stores: list<Node> = [];
        for index in 0..cl.params.len() {
            fn.params.push(declare-param(inner, ps[index], cl.params[index], cl.marks[index], stores));
        }
        gen-return(inner, cl.body, rt);
        fn.body = concat(exit-unit(inner, unit, stores), inner.out);
        generator.lifted.push(fn);
        let ft = func-typedef(generator, expression-type);
        make(ft, ["fn", "env",], [func-ref(c-name, c-name, "(({ft}__fn){c-name})", expression-type), env,], expression-type)
    }

    // ================================================================ expressions

    // expressions in order, each's node; one read before a later one's statements assign a local
    // it reads is kept in a temporary from before them
    gen-operands: func(coding: Codegen, es: list<Expr>) -> list<Node> {
        let nodes: list<Node> = [];
        // where each node's statements end in l.out
        let marks: list<s64> = [];
        for expression in es {
            let before = coding.out.len();
            let node = gen-expr(coding, expression);
            if coding.out.len() > before && nodes.len() > 0 {
                let written: list<s64> = [];
                for index in before..coding.out.len() {
                    for statement in flatten([coding.out[index],]) {
                        match statement.kind {
                            assign(assignment) => written.push(assignment.dest),
                            _ => {}
                        }
                    }
                }
                let moved = 0;
                for index in 0..nodes.len() {
                    marks[index] = marks[index] + moved;
                    let read: list<s64> = [];
                    reads(nodes[index], read);
                    let clash = false;
                    for local in read { if contains-s32(written, local) { clash = true; } }
                    if clash {
                        let slot = new-local(coding, nodes[index].ty, "");
                        insert(coding.out, marks[index], assign(slot, nodes[index]));
                        nodes[index] = local-node(coding, slot);
                        moved += 1;
                    }
                }
            }
            nodes.push(node);
            marks.push(coding.out.len());
        }
        nodes
    }

    contains-s32: func(xs: list<s64>, wanted: s64) -> bool {
        for item in xs { if item == wanted { return true; } }
        false
    }

    insert: func(body: list<Node>, at: s64, node: Node) {
        let by: list<Node> = [];
        for index in 0..body.len() {
            if index == at { by.push(node); }
            by.push(body[index]);
        }
        if at >= body.len() { by.push(node); }
        replace-body(body, by);
    }

    // an expression's value, each node made of it said to be where it is
    gen-expr: func(coding: Codegen, expression: Expr) -> Node {
        let saved = coding.span;
        if expression.span.line != 0 { coding.span = expression.span; }
        let node = gen-expr-node(coding, expression);
        stamp(node, coding.span);
        // a call that never returns, where its value is wanted: made here, so nothing after it is
        // (n, given back, is in what is not kept)
        if is-never(node.ty) { add(coding, node); }
        coding.span = saved;
        node
    }

    gen-expr-node: func(coding: Codegen, expression: Expr) -> Node {
        let generator = coding.g;
        match expression.kind {
            int-lit(literal) => const(Constant.int(int-value(generator, expression, literal, expr-type(generator, expression), false)), expr-type(generator, expression)),
            float-lit(literal) => const(Constant.float(parse-f64(literal)), expr-type(generator, expression)),
            char-lit(code) => int-const(code, Type.char-type),
            tuple-lit(items) => {
                let parts = gen-operands(coding, items);
                let expression-type = expr-type(generator, expression);
                let fields: list<string> = [];
                for part in parts { fields.push(""); }
                make(c-type(generator, expression-type), fields, parts, expression-type)
            }
            bool-lit(flag) => bool-const(flag),
            unit => unit-const(),
            // (the checker gave each its value)
            directive(allocated) => panic("a directive #{allocated.name} not given its value"),
            str-lit(literal) => text-const(literal),
            name(name) => {
                match lookup(coding, name) {
                    // a binding the checker narrowed (an is test held): its value of that kind
                    some(variable) => { return represent-as(coding, read-var(coding, variable), variable.ty, expr-type(generator, expression)); }
                    none => {}
                }
                let expression-type = expr-type(generator, expression);
                // a func as a value (the checker named it by its key): its adapter, no environment
                // a global (no local hides it: the checker named it by its key)
                if generator.symbols.globals.has(name-text(name)) { return bind(coding, global-node(name-text(name), expression-type)); }
                if generator.funcs.has(name-text(name)) {
                    let c-name = generator.funcs[name-text(name)].c-name;
                    let ft = func-typedef(generator, expression-type);
                    let fn = func-ref(name-text(name), c-name, value-adapter(generator, name-text(name), c-name, expression-type), expression-type);
                    return make(ft, ["fn", "env",], [fn, null-const(),], expression-type);
                }
                if name == intern("none") { return zero-const(expression-type); }
                if is-result(generator, expression, name-text(name)) { return result-val(coding, expression, name-text(name), none); }
                if name == intern("inf") || name == intern("nan") { return const(Constant.float(if name == intern("inf") { 1.0 / 0.0 } else { 0.0 / 0.0 }), expression-type); }
                gen-case(coding, expression, name-text(name), none)
            }
            interp(parts) => {
                // a value of a type with a display func: that func's text
                let displayed: list<Expr> = [];
                for part in parts {
                    match display-func(coding, part.ty) {
                        some(key) => displayed.push({ kind: ExprKind.call({ name: key, args: [part,], type-args: [], name-span: nowhere(), }), span: part.span, ty: Type.string-type, }),
                        none => displayed.push(part),
                    }
                }
                // ("{x}" of a string: x itself, no buffer)
                if displayed.len() == 1 {
                    match expr-type(generator, displayed[0]) {
                        string-type => { return gen-expr(coding, displayed[0]); }
                        _ => {}
                    }
                }
                let nodes = gen-operands(coding, displayed);
                let formatters: list<Formatter> = [];
                for part in displayed { formatters.push(display-fn(generator, expr-type(generator, part))); }
                temp(coding, interp(nodes, formatters))
            }
            list-lit(items) => {
                let lt = expr-type(generator, expression);
                // a fixed-length list: a value struct of its items
                match lt {
                    fixed-list(_) => {
                        let parts = gen-operands(coding, items);
                        let fields: list<string> = [];
                        for part in parts { fields.push(""); }
                        return make(c-type(generator, lt), fields, parts, lt);
                    }
                    _ => {}
                }
                let it = match lt {
                    list-type(item) => item,
                    _ => Type.unit-type,
                };
                // (every item a constant: static data, one call copying it)
                if items.len() > 0 {
                    match static-list(coding, lt, items, false) {
                        some(data) => {
                            // (items holding no list: copied as they are; else each list in them too,
                            // by the list's descriptor)
                            if data.flat {
                                scan-fn(generator, it);
                                return temp(coding, runtime-call("y_list_of_data", [int-const(data.items.len(), Type.num("s64")), size-of(it), static-list-node(data), scan(it),], lt));
                            }
                            let desc = type-desc(generator, lt);
                            return temp(coding, runtime-call("y_list_static", [static-list-node(data), descriptor-node(lt, desc),], lt));
                        }
                        none => {}
                    }
                }
                let item = c-type(generator, it);
                let values = gen-operands(coding, items);
                let size = size-of(it);
                scan-fn(generator, it);
                if values.len() == 0 {
                    return temp(coding, runtime-call("y_list_new", [int-const(0, Type.num("s64")), size, scan(it),], lt));
                }
                let fields: list<string> = [];
                for value in values { fields.push(""); }
                let items-c = make("{item}[]", fields, values, Type.unit-type);
                temp(
                    coding,
                    runtime-call(
                        "y_list_of",
                        [int-const(values.len(), Type.num("s64")), size, items-c, scan(it),],
                        lt,
                    ),
                )
            }
            binary(operation) => gen-binary(coding, expression, operation),
            unary(unary) => {
                // -128 is an s8: a literal under a - may be a signed type's least value
                let value = match unary.value.kind {
                    int-lit(text) => if unary.op == "-" {
                        const(
                            Constant.int(int-value(generator, unary.value, text, expr-type(generator, unary.value), true)),
                            expr-type(generator, unary.value),
                        )
                    } else {
                        gen-expr(coding, unary.value)
                    },
                    _ => gen-expr(coding, unary.value),
                };
                let expression-type = expr-type(generator, expression);
                if unary.op == "!" { return un("!", expression-type, value); }
                match expression-type {
                    num(number) => if is-int(number) {
                        pure-call("y_neg_{number}", [value,], expression-type)
                    } else {
                        un("-", expression-type, value)
                    },
                    _ => un("-", expression-type, value),
                }
            }
            call(call) => {
                // f(a) with f a local holding a func: called through it (x.f(a) is always a func's)
                match lookup(coding, intern(call.name)) {
                    some(variable) => {
                        let pinned = pin(coding, read-var(coding, variable));
                        let values = gen-operands(coding, call.args);
                        return temp(coding, call-ref(pinned, values, expr-type(generator, expression)));
                    }
                    none => {}
                }
                gen-call(coding, expression, call.name, call.args, call.type-args)
            }
            method(method) => {
                if is-type(coding, method.target) {
                    return gen-case(coding, expression, method.name, some(gen-expr(coding, method.args[0])));
                }
                if is-result(generator, expression, method.name) && !generator.funcs.has(method.name) {
                    return result-val(coding, expression, method.name, some(gen-expr(coding, method.target)));
                }
                let args = [method.target,];
                for argument in method.args { args.push(argument); }
                gen-call(coding, expression, method.name, args, method.type-args)
            }
            field(pinned) => {
                let expression-type = expr-type(generator, expression);
                if is-type(coding, pinned.target) {
                    let tn = expr-name(pinned.target);
                    if generator.symbols.flags.has(intern(tn)) { return const(Constant.int(flag-bit(generator, tn, pinned.name)), expression-type); }
                    return gen-case(coding, expression, pinned.name, none);
                }
                let base = gen-expr(coding, pinned.target);
                let bt = expr-type(generator, pinned.target);
                match bt {
                    tuple-type(_) => { return load(base, ["f{pinned.name}",], false, expression-type, false); }
                    // an anonymous record: a value, its field read where it is
                    anon-record(_) => { return load(base, ["f_{mangle(pinned.name)}",], false, expression-type, false); }
                    named(tn) => {
                        if generator.symbols.flags.has(tn) {
                            let bits = bin("&", bt, base, const(Constant.int(flag-bit(generator, name-text(tn), pinned.name)), bt));
                            return bin("!=", expression-type, bits, int-const(0, bt));
                        }
                    }
                    _ => {}
                }
                // a field of an observable resource: observe told it is read (and a call that
                // changes what it holds, told of that: call-node)
                match observed-field(generator, bt, pinned.name) {
                    some(field) => {
                        let object = pin(coding, base);
                        add(coding, observe-call(generator, "access", registrar-node(object), field));
                        if changes-in-place(expression-type) { generator.observed-reads.set(expression, { object: object, field: field, }); }
                        return bind(coding, load(again(object), ["f_{mangle(pinned.name)}",], true, expression-type, true));
                    }
                    none => {}
                }
                bind(coding, load(base, ["f_{mangle(pinned.name)}",], true, expression-type, true))
            }
            record-lit(fields) => {
                let exprs: list<Expr> = [];
                for pinned in fields { exprs.push(pinned.value); }
                let values = gen-operands(coding, exprs);
                let expression-type = expr-type(generator, expression);
                // an anonymous record: a value made of its fields
                match expression-type {
                    anon-record(_) => {
                        let names: list<string> = [];
                        for pinned in fields { names.push("f_" + mangle(pinned.name)); }
                        return make(c-type(generator, expression-type), names, values, expression-type);
                    }
                    _ => {}
                }
                let rn = match expression-type {
                    named(record-name) => record-name,
                    _ => intern(""),
                };
                let allocated = temp(coding, alloc("R_" + mangle(name-text(rn)), name-text(rn), true, trace-fn(generator, rn), expression-type));
                for index in 0..fields.len() {
                    add(
                        coding,
                        store(
                            load(allocated, ["f_{mangle(fields[index].name)}",], true, values[index].ty, true),
                            values[index],
                        ),
                    );
                }
                // an observable resource's registrar, made with it
                if generator.symbols.records.has(rn) && generator.symbols.records[rn].observable {
                    let count = int-const(observed-count(generator.symbols.records[rn]), Type.num("u32"));
                    let registrar = temp(coding, std-call(generator, "yel:std/observe.registrar", [count,], observers-type()));
                    add(coding, store(load(allocated, ["f_" + mangle(observers-field()),], true, observers-type(), true), registrar));
                }
                allocated
            }
            match-expr(match-expression) => gen-match(coding, match-expression, true, expr-type(generator, expression)),
            closure(cl) => gen-closure(coding, expression, cl),
            cast(casting) => gen-cast(coding, expression, casting),
            start-expr(start-expression) => {
                // the call begun, and given the executor to run
                let expression-type = expr-type(generator, expression);
                let fut = start-call(coding, start-expression, expression-type);
                temp(coding, call("", "yel_async_spawn", [fut,], expression-type, fx().call))
            }
            wait-expr(wait-expression) => gen-wait(coding, expression, wait-expression),
            // the value into the frame, then left (that state kept) and come back to after it
            yield-expr(yield-expression) => {
                let value = gen-expr(coding, yield-expression);
                coding.f.states += 1;
                let index = coding.f.states;
                add(coding, yield-stmt(value));
                add(coding, suspend-stmt(index));
                add(coding, resume-stmt(index));
                unit-const()
            }
            widen(widened) => represent-as(
                coding,
                gen-expr(coding, widened.value),
                expr-type(generator, widened.value),
                gen-type(generator, widened.ty),
            ),
            // x as? T: some(x as the narrower type) where its pattern's checks hold, else none
            try-as(try-as) => {
                let (value, test) = tested(coding, try-as);
                let expression-type = expr-type(generator, expression);
                let inner = match expression-type {
                    option-type(item) => item,
                    _ => expression-type,
                };
                let found = make(c-type(generator, expression-type), ["", "",], [
                    bool-const(true),
                    represent-as(coding, value, expr-type(generator, try-as.value), inner),
                ], expression-type,);
                match test {
                    none => found,
                    some(test) => {
                        let slot = new-local(coding, expression-type, "");
                        add(
                            coding,
                            if-stmt(
                                test,
                                [assign(slot, found),],
                                [assign(slot, zero-const(expression-type)),],
                            ),
                        );
                        local-node(coding, slot)
                    }
                }
            }
            // x is T: the checks of its pattern (none: it always is)
            is-test(is-test) => {
                let (_, test) = tested(coding, is-test);
                match test {
                    some(value) => value,
                    none => bool-const(true),
                }
            }
            apply(apply) => {
                let pinned = pin(coding, gen-expr(coding, apply.callee));
                let values = gen-operands(coding, apply.args);
                temp(coding, call-ref(pinned, values, expr-type(generator, expression)))
            }
            if-else(if-else) => gen-if(coding, if-else, true, expr-type(generator, expression)),
            block(block) => gen-block(coding, block, true),
        }
    }

    // a case of e's type (a variant or enum), with its payload (or none)
    gen-case: func(coding: Codegen, expression: Expr, case-name: string, payload: option<Node>) -> Node {
        let generator = coding.g;
        let expression-type = expr-type(generator, expression);
        let tn = match expression-type {
            named(name) => name,
            _ => intern(""),
        };
        if !generator.symbols.variants.has(tn) { panic("{generator.file}: {case-name}: its variant is not known"); }
        let declaration = generator.symbols.variants[tn];
        let index = case-index(declaration, case-name);
        if is-enum(generator, tn) { return int-const(index, expression-type); }
        // held by value: made in place, its tag and its case's payload
        if value-variant(generator, tn) {
            let ct = c-type(generator, expression-type);
            let tag = int-const(index, Type.num("s32"));
            return match payload {
                some(payload) => make(ct, ["tag", "u.c_{mangle(case-name)}",], [tag, payload,], expression-type),
                none => make(ct, ["tag",], [tag,], expression-type),
            };
        }
        match payload {
            some(payload) => {
                let slot = temp(coding, alloc("V_" + mangle(name-text(tn)), name-text(tn), false, trace-fn(generator, tn), expression-type));
                add(
                    coding,
                    store(
                        load(slot, ["tag",], true, Type.num("s32"), false),
                        int-const(index, Type.num("s32")),
                    ),
                );
                add(coding, store(load(slot, ["u", "c_{mangle(case-name)}",], true, payload.ty, false), payload));
                slot
            }
            none => const(Constant.case-value({ owner: name-text(tn), name: case-name, }), expression-type),
        }
    }

    // ok or err (which) of e's result type, with its payload (or none)
    result-val: func(coding: Codegen, expression: Expr, which: string, payload: option<Node>) -> Node {
        let expression-type = expr-type(coding.g, expression);
        let ct = c-type(coding.g, expression-type);
        let is-err = bool-const(which == "err");
        match payload {
            some(payload) => make(ct, ["is_err", which,], [is-err, payload,], expression-type),
            none => make(ct, ["is_err",], [is-err,], expression-type),
        }
    }

    // whether two values of type t are equal: an option, result, tuple or case by what it holds,
    // a list, map or record by identity
    eq-node: func(generator: Gen, given: Type, left: Node, right: Node) -> Node {
        match given {
            string-type => std-call(generator, "yel:std/text.equal", [left, right,], Type.bool-type),
            unit-type => bool-const(true),
            option-type(_) => pure-call(eq-fn(generator, given), [left, right,], Type.bool-type),
            result-type(_) => pure-call(eq-fn(generator, given), [left, right,], Type.bool-type),
            tuple-type(_) => pure-call(eq-fn(generator, given), [left, right,], Type.bool-type),
            union-type(_) => pure-call(eq-fn(generator, given), [left, right,], Type.bool-type),
            anon-record(_) => pure-call(eq-fn(generator, given), [left, right,], Type.bool-type),
            fixed-list(_) => pure-call(eq-fn(generator, given), [left, right,], Type.bool-type),
            // the same func, made in the same environment
            func-type(_) => bin(
                "&&",
                Type.bool-type,
                bin(
                    "==",
                    Type.bool-type,
                    load(left, ["fn",], false, Type.address-type, false),
                    load(right, ["fn",], false, Type.address-type, false),
                ),
                bin(
                    "==",
                    Type.bool-type,
                    load(left, ["env",], false, Type.address-type, false),
                    load(right, ["env",], false, Type.address-type, false),
                ),
            ),
            named(name) => if named-kind(generator, name) == "variant" {
                pure-call(eq-fn(generator, given), [left, right,], Type.bool-type)
            } else {
                bin("==", Type.bool-type, left, right)
            },
            _ => bin("==", Type.bool-type, left, right),
        }
    }

    // a op b on values of type t, of type rt: an integer's + - * / % << >> wrap (y_add_s32 and the
    // rest); a float's % is fmod
    arith: func(given: Type, op: string, left: Node, right: Node, rt: Type) -> Node {
        match given {
            num(number) => {
                if !is-int(number) {
                    if op == "%" {
                        return pure-call(if number == "f32" { "fmodf" } else { "fmod" }, [left, right,], rt);
                    }
                    return bin(op, rt, left, right);
                }
                let ops = ["+", "-", "*", "/", "%", "<<", ">>",];
                let names = ["add", "sub", "mul", "div", "mod", "shl", "shr",];
                let index = index-of(ops, op);
                if index >= 0 { return pure-call("y_{names[index]}_{number}", [left, right,], rt); }
            }
            _ => {}
        }
        bin(op, rt, left, right)
    }

    gen-binary: func(coding: Codegen, expression: Expr, operation: Binary) -> Node {
        let generator = coding.g;
        // && and ||: the right side only when the left does not decide
        if operation.op == "&&" || operation.op == "||" {
            let result = new-local(coding, Type.bool-type, "");
            add(coding, assign(result, gen-expr(coding, operation.left)));
            let saved = coding.out;
            coding.out = [];
            add(coding, assign(result, gen-expr(coding, operation.right)));
            let body = coding.out;
            coding.out = saved;
            if operation.op == "&&" { add(coding, if-stmt(local-node(coding, result), body, [])); }
            else { add(coding, if-stmt(local-node(coding, result), [], body)); }
            return local-node(coding, result);
        }
        let sides = gen-operands(coding, [operation.left, operation.right,]);
        let lt = expr-type(generator, operation.left);
        let result = expr-type(generator, expression);
        if operation.op == "==" { return eq-node(generator, lt, sides[0], sides[1]); }
        if operation.op == "!=" { return un("!", result, eq-node(generator, lt, sides[0], sides[1])); }
        match lt {
            string-type => { return temp(coding, std-call(coding.g, "yel:std/text.concat", sides, result)); }
            _ => {}
        }
        arith(lt, operation.op, sides[0], sides[1], result)
    }

    // a call's value; or some(x), ok(x), err(x), or a case with its payload, by the bare name
    gen-call: func(
        coding: Codegen,
        expression: Expr,
        name: string,
        args: list<Expr>,
        type-args: list<Type>,
    ) -> Node {
        let generator = coding.g;
        // a generator's call: its frame made (nothing of it runs until a value is read)
        if generator.generators.has(name) { return start-call(coding, expression, expr-type(generator, expression)); }
        // at, set and len of a fixed-length list (the checker named them ~at, ~set, ~len)
        if name == "~at" || name == "~set" || name == "~len" { return fixed-call(coding, name, args); }
        // an interpolated value with a spec ("{x:>8}")
        if name == "~format" {
            return match args[1].kind {
                str-lit(spec) => format-value(coding, args[0], spec),
                _ => zero-const(Type.string-type),
            };
        }
        if !generator.funcs.has(name) {
            let payload = gen-expr(coding, args[0]);
            if name == "some" {
                let expression-type = expr-type(generator, expression);
                return make(c-type(generator, expression-type), ["", "",], [bool-const(true), payload,], expression-type);
            }
            if is-result(generator, expression, name) { return result-val(coding, expression, name, some(payload)); }
            return gen-case(coding, expression, name, some(payload));
        }
        temp(coding, call-node(coding, name, args, type-args, expr-type(generator, expression)))
    }

    // the display func a value of type value-type shows by (not inside it: its own "{value}" is the
    // value's own text)
    display-func: func(coding: Codegen, value-type: Type) -> option<string> {
        let generator = coding.g;
        if generator.displays.len() == 0 { return none; }
        // (value-type as the checker has it: a distinct type not yet its base)
        let id = type-id(generator, gen-type(generator, value-type));
        for display in generator.displays {
            // a distinct type's: that type's values only (held as its base, which shows as it is)
            let fits = match resolve(display.shows) {
                distinct-type(wanted) => match resolve(value-type) {
                    distinct-type(found) => found.name == wanted.name,
                    _ => false,
                },
                _ => type-id(generator, gen-type(generator, display.shows)) == id,
            };
            if display.key != coding.f.key && fits { return some(display.key); }
        }
        none
    }

    // an interpolated value's text as its spec shapes it, by std's format funcs
    format-value: func(coding: Codegen, value: Expr, spec: string) -> Node {
        let generator = coding.g;
        let format = match format-spec(spec) {
            some(format) => format,
            none => { return zero-const(Type.string-type); }
        };
        let value-type = expr-type(generator, value);
        let number = match erase-distinct(value-type) {
            num(name) => name,
            _ => "",
        };
        let content = if format.kind == "?" {
            temp(coding, interp([gen-expr(coding, value),], [debug-fn(generator, value-type),]))
        } else if format.kind != "" {
            let base = if format.kind == "b" { 2 } else if format.kind == "o" { 8 } else { 16 };
            // (an unsigned integer by its own digits: a u64's past s64's greatest are no negative)
            let unsigned = number.starts-with("u");
            format-call(coding, if unsigned { "to-radix-unsigned" } else { "to-radix" }, [
                converted(coding, value, if unsigned { "u64" } else { "s64" }),
                int-const(base, Type.num("s32")),
                bool-const(format.kind == "X"),
            ])
        } else if format.precision >= 0 {
            format-call(coding, "to-fixed", [converted(coding, value, "f64"), int-const(format.precision, Type.num("s32")),])
        } else {
            match display-func(coding, value.ty) {
                some(key) => temp(coding, call-node(coding, key, [value,], [], Type.string-type)),
                none => temp(coding, interp([gen-expr(coding, value),], [display-fn(generator, value-type),])),
            }
        };
        if format.width < 0 { return content; }
        let width = int-const(format.width, Type.num("s64"));
        if format.zero && number != "" { return format-call(coding, "zero-pad", [content, width,]); }
        // a number to the right, anything else to the left, unless told
        let align = if format.align != "" { format.align } else if number != "" { ">" } else { "<" };
        format-call(coding, "pad", [content, width, text-node(coding, format.fill), text-node(coding, align),])
    }

    // a call of std's format.name (its arguments built)
    format-call: func(coding: Codegen, name: string, args: list<Node>) -> Node {
        let key = "yel:std/format." + name;
        temp(coding, call(key, coding.g.funcs[key].c-name, args, Type.string-type, fx().call))
    }

    // value as a number of kind (as value as kind)
    converted: func(coding: Codegen, value: Expr, kind: string) -> Node {
        let target = Type.num(kind);
        gen-expr(coding, { kind: ExprKind.cast({ value: value, ty: target, }), span: value.span, ty: target, })
    }

    // a string literal's node
    text-node: func(coding: Codegen, content: string) -> Node {
        gen-expr(coding, { kind: ExprKind.str-lit(content), span: coding.span, ty: Type.string-type, })
    }

    // a call to a func (its arguments built first): an extern's type arguments go first
    call-node: func(
        coding: Codegen,
        function-key: string,
        args: list<Expr>,
        type-args: list<Type>,
        ty: Type,
    ) -> Node {
        let generator = coding.g;
        let function = generator.funcs[function-key];
        let prefix: list<Node> = [];
        if function.is-extern {
            if generator.wit-externs.has(function-key) { generator.wit-used.set(function-key, true); }
            for argument in type-arg-nodes(generator, function-key, type-args) { prefix.push(argument); }
        }
        for argument in args { let _ = generator.observed-reads.remove(argument); }
        let values = gen-operands(coding, args);
        // an intrinsic may read an argument more than once: each a local or a constant
        let pinned = function.is-extern && is-template(function.c-name);
        for value in values { prefix.push(if pinned { pin(coding, value) } else { value }); }
        // an observable resource's field given (a list, a map): observe told it changes, before
        // the call, where the call may change it (gen.settle-observed: once the program's flow
        // says which calls do)
        let told: list<Node> = [];
        let at: list<s64> = [];
        for index in 0..args.len() {
            match generator.observed-reads.get(args[index]) {
                some(read) => {
                    let marker = observe-call(generator, "will-set", registrar-node(again(read.object)), read.field);
                    add(coding, marker);
                    told.push(marker);
                    at.push(prefix.len() - args.len() + index);
                }
                none => {}
            }
        }
        let made = if function.is-extern { runtime-call(function.c-name, prefix, ty) }
        else {
            let c-name = if function.type-params.len() > 0 { instance(generator, function-key, type-args) } else { function.c-name };
            let key = if function.type-params.len() > 0 { c-name } else { function-key };
            call(key, c-name, prefix, ty, fx().call)
        };
        match made.kind {
            call(call) => { for index in 0..told.len() { generator.observed-writes.push({ marker: told[index], call: call, arg: at[index], }); } }
            _ => {}
        }
        made
    }

    // ================================================================ observation

    // a local's node again (a node is in one place in the tree)
    again: func(node: Node) -> Node {
        match node.kind {
            local(slot) => local(slot, node.ty),
            _ => node,
        }
    }

    // an observable resource's registrar, of object (a local or a constant: read again)
    registrar-node: func(object: Node) -> Node {
        load(object, ["f_" + mangle(observers-field()),], true, observers-type(), false)
    }

    // std's observe told of a field (by its index) of the resource registrar is of: read
    // (access), or about to change (will-set)
    observe-call: func(generator: Gen, which: string, registrar: Node, field: s64) -> Node {
        std-call(generator, "yel:std/observe." + which, [registrar, int-const(field, Type.num("u32")),], Type.unit-type)
    }

    // observe told a field of object (of type t) is about to change, where it is an observable
    // resource's
    will-set: func(coding: Codegen, object: Node, given: Type, field: string) {
        match observed-field(coding.g, given, field) {
            some(index) => add(coding, observe-call(coding.g, "will-set", registrar-node(again(object)), index)),
            none => {}
        }
    }

    // a value a call may change in place (a list's items, a map's): a field holding one changes
    // with it
    changes-in-place: func(given: Type) -> bool {
        match without-readonly(given) {
            list-type(_) => true,
            map-type(_) => true,
            _ => false,
        }
    }

    // a call of an extern (by its key) the compiler writes: its type arguments first, then args
    extern-call: func(generator: Gen, key: string, type-args: list<Type>, args: list<Node>, ty: Type) -> Node {
        let function = generator.funcs[key];
        let out = type-arg-nodes(generator, key, type-args);
        for argument in args { out.push(argument); }
        runtime-call(function.c-name, out, ty)
    }

    // an extern's type arguments, as its call's first arguments (the C each is written as, made
    // now: the helpers it names)
    type-arg-nodes: func(generator: Gen, key: string, type-args: list<Type>) -> list<Node> {
        let function = generator.funcs[key];
        let out: list<Node> = [];
        let slots = 0;
        for index in 0..type-args.len() {
            let arg: TypeArg = { ty: gen-type(generator, type-args[index]), key: index < function.type-params.len() && function.type-params[index] == "K", };
            slots += type-arg-c(generator, function.c-name, slots, arg).len();
            out.push(type-arg(arg.ty, arg.key));
        }
        out
    }

    // whether a type is held as a value (a record's, an anonymous record's, a tuple's): its fields
    // set where it is, not through a pointer
    is-value: func(given: Type) -> bool {
        match given {
            anon-record(_) => true,
            tuple-type(_) => true,
            _ => false,
        }
    }

    // where a value is (the checker allows only these): a variable's place (its local, its field in
    // an environment, a global), or a field of what holds it (a value's, in place; a resource's,
    // through its pointer)
    value-place: func(coding: Codegen, expression: Expr) -> Node {
        let generator = coding.g;
        let expression-type = expr-type(generator, expression);
        match expression.kind {
            name(name) => {
                let looked = lookup(coding, name);
                if found(looked) { return var-place(coding, binding(looked)); }
                if generator.symbols.globals.has(name-text(name)) { return global-node(name-text(name), expression-type); }
                gen-expr(coding, expression)
            }
            field(field) => {
                let bt = expr-type(generator, field.target);
                let path = [if is-tuple(bt) { "f{field.name}" } else { "f_{mangle(field.name)}" },];
                if is-value(bt) { load(value-place(coding, field.target), path, false, expression-type, true) }
                else {
                    let object = pin(coding, gen-expr(coding, field.target));
                    // (a part of a value in an observable resource's field: the field changes)
                    will-set(coding, object, bt, field.name);
                    load(object, path, true, expression-type, true)
                }
            }
            _ => gen-expr(coding, expression),
        }
    }

    is-tuple: func(given: Type) -> bool {
        match given {
            tuple-type(_) => true,
            _ => false,
        }
    }

    // a fixed-length list's length (a constant), its item (the index checked), or an item set in
    // place: in the local, or the record's field, that holds the list
    fixed-call: func(coding: Codegen, name: string, args: list<Expr>) -> Node {
        let generator = coding.g;
        let lt = expr-type(generator, args[0]);
        let item = match lt {
            fixed-list(fixed) => fixed.item,
            _ => Type.unit-type,
        };
        let len = match lt {
            fixed-list(fixed) => fixed.len,
            _ => 0,
        };
        let s64 = Type.num("s64");
        if name == "~len" {
            gen-expr(coding, args[0]);
            return int-const(len, s64);
        }
        // where the list is: a field's place, or a variable's (a captured one's, in its
        // environment), not a copy of it
        let base = match args[0].kind {
            field(field) => {
                if name == "~set" {
                    let rec = pin(coding, gen-expr(coding, field.target));
                    will-set(coding, rec, expr-type(generator, field.target), field.name);
                    load(rec, ["f_{mangle(field.name)}",], true, lt, true)
                } else {
                    gen-expr(coding, args[0])
                }
            }
            name(called) => {
                let fv = lookup(coding, called);
                if name == "~set" && found(fv) { var-place(coding, binding(fv)) }
                // a global's: set in it
                else if name == "~set" && generator.symbols.globals.has(name-text(called)) { global-node(name-text(called), lt) }
                else { gen-expr(coding, args[0]) }
            }
            _ => gen-expr(coding, args[0]),
        };
        let rest: list<Expr> = [];
        for index in 1..args.len() { rest.push(args[index]); }
        let values = gen-operands(coding, rest);
        let index = pure-call("y_bound", [values[0], int-const(len, s64),], s64);
        let place = list-get(base, index, c-type(generator, item), item, true);
        if name == "~at" { return bind(coding, place); }
        add(coding, store(place, values[1]));
        unit-const()
    }

    // an expression whose value is not used: an if's or a match's branches need not agree (as
    // checked)
    gen-discard: func(coding: Codegen, expression: Expr) {
        let generator = coding.g;
        match expression.kind {
            if-else(if-else) => { gen-if(coding, if-else, false, Type.unit-type); }
            match-expr(match-expression) => { gen-match(coding, match-expression, false, Type.unit-type); }
            block(block) => { gen-block(coding, block, false); }
            call(call) => {
                let fv = lookup(coding, intern(call.name));
                if found(fv) {
                    let callee = pin(coding, read-var(coding, binding(fv)));
                    add(coding, call-ref(callee, gen-operands(coding, call.args), expr-type(generator, expression)));
                } else if generator.funcs.has(call.name) {
                    add(coding, call-node(coding, call.name, call.args, call.type-args, expr-type(generator, expression)));
                }
                else { gen-expr(coding, expression); }
            }
            method(method) => {
                if !is-type(coding, method.target) && generator.funcs.has(method.name) {
                    let args = [method.target,];
                    for argument in method.args { args.push(argument); }
                    add(coding, call-node(coding, method.name, args, method.type-args, expr-type(generator, expression)));
                } else {
                    gen-expr(coding, expression);
                }
            }
            _ => { gen-expr(coding, expression); }
        }
    }

    // ================================================================ control

    // a body built on its own: its statements
    gen-body: func(coding: Codegen, block: Block, keep: bool, dest: s64) -> list<Node> {
        let saved = coding.out;
        coding.out = [];
        let value = gen-block(coding, block, keep);
        // one that never gets to its end has no value to give
        if keep && !checker.leaves(block) { add(coding, assign(dest, value)); }
        let body = coding.out;
        coding.out = saved;
        body
    }

    // an if: its value (keep, of type ty), or unit
    gen-if: func(coding: Codegen, if-else: IfElse, keep: bool, ty: Type) -> Node {
        let cond = gen-expr(coding, if-else.cond);
        match if-else.otherwise {
            some(other) => {
                let result = if keep { new-local(coding, ty, "") } else { -1 };
                let yes = gen-body(coding, if-else.then, keep, result);
                let no = gen-body(coding, other, keep, result);
                add(coding, if-stmt(cond, yes, no));
                if keep { local-node(coding, result) } else { unit-const() }
            }
            none => {
                add(coding, if-stmt(cond, gen-body(coding, if-else.then, false, -1), []));
                unit-const()
            }
        }
    }

    // a match: the value's arms in order, the first that fits (its pattern, then its guard); the
    // checker saw that one does. Its value (keep, of type ty), or unit. Arms without guards chain
    // as ifs; an arm with one leaves the match by its label once its guard holds
    gen-match: func(coding: Codegen, matched: Match, keep: bool, ty: Type) -> Node {
        let generator = coding.g;
        let vt = expr-type(generator, matched.value);
        let subject = temp(coding, gen-expr(coding, matched.value));
        let result = if keep { new-local(coding, ty, "") } else { -1 };
        let label = -1;
        for arm in matched.arms {
            match arm.guard {
                some(_) => {
                    if label < 0 {
                        label = coding.f.labels;
                        coding.f.labels += 1;
                    }
                }
                none => {}
            }
        }
        let saved = coding.out;
        // each arm: its test (none: it always fits), and its body
        let tests: list<option<Node>> = [];
        let bodies: list<list<Node>> = [];
        for arm in matched.arms {
            let checks: list<Node> = [];
            let binds: list<PatternBinding> = [];
            pattern-test(coding, arm.pattern, subject, vt, checks, binds);
            tests.push(all-of(checks));
            coding.out = [];
            coding.scopes.push(map.new());
            for bound in binds {
                let variable = declare(coding, bound.value.ty, bound.name, bound.mark);
                add(coding, write-var(coding, variable, bound.value));
            }
            let outer = coding.out;
            let guard: option<Node> = none;
            match arm.guard {
                some(guard-expression) => {
                    guard = some(gen-expr(coding, guard-expression));
                    outer = coding.out;
                    coding.out = [];
                }
                none => {}
            }
            if keep {
                let body = match arm.body.kind {
                    block(block) => gen-block(coding, block, true),
                    _ => gen-expr(coding, arm.body),
                };
                add(coding, assign(result, body));
            } else {
                match arm.body.kind {
                    block(block) => { gen-block(coding, block, false); }
                    _ => gen-discard(coding, arm.body),
                }
            }
            match guard {
                some(condition) => {
                    add(coding, break-stmt(label));
                    outer.push(if-stmt(condition, coding.out, []));
                    coding.out = outer;
                }
                none => {}
            }
            coding.scopes.pop();
            bodies.push(coding.out);
        }
        // the arms as a chain, the last first: an arm that always fits (no guard) ends it; one with
        // a guard runs, then (it did not leave) the rest
        let chain: list<Node> = [unreachable-stmt(subject, debug-fn(generator, vt)),];
        for position in 0..matched.arms.len() {
            let index = matched.arms.len() - 1 - position;
            let guarded = match matched.arms[index].guard {
                some(_) => true,
                none => false,
            };
            if guarded {
                let next = match tests[index] {
                    none => bodies[index],
                    some(test) => [if-stmt(test, bodies[index], []),],
                };
                chain = concat(next, chain);
            } else {
                match tests[index] {
                    none => { chain = bodies[index]; }
                    some(test) => { chain = [if-stmt(test, bodies[index], chain),]; }
                }
            }
        }
        coding.out = saved;
        if label >= 0 { add(coding, block-stmt(chain, label)); }
        else {
            for variable in chain { add(coding, variable); }
        }
        if keep { local-node(coding, result) } else { unit-const() }
    }

    // a value of type from as type to, where one holds a union of kinds (types as sets): a
    // conversion; anything else as it is
    represent-as: func(coding: Codegen, node: Node, from: Type, to: Type) -> Node {
        let generator = coding.g;
        if type-id(generator, from) == type-id(generator, to) || !has-kinds(from) && !has-kinds(to) { return node; }
        // (a value of never is none: an arm that panics has nothing to convert)
        match from {
            never-type => { return node; }
            _ => {}
        }
        pure-call(conv-fn(generator, from, to), [node,], to)
    }

    // ================================================================ async

    // an async func's call begun: its frame made (its arguments in it), as a future of type t
    start-call: func(coding: Codegen, expression: Expr, given: Type) -> Node {
        let generator = coding.g;
        let key = match expression.kind {
            call(call) => call.name,
            method(method) => method.name,
            _ => "",
        };
        let type-args: list<Type> = match expression.kind {
            call(call) => call.type-args,
            method(method) => method.type-args,
            _ => [],
        };
        let exprs: list<Expr> = match expression.kind {
            call(call) => call.args,
            method(method) => {
                let all: list<Expr> = [method.target,];
                for argument in method.args { all.push(argument); }
                all
            }
            _ => [],
        };
        let args = gen-operands(coding, exprs);
        // its step's C name (a generic func's: this instance's); its start is s_ for u_, and its
        // key keeps it reached (s_<name> reaches u_<name>)
        let step = if generator.generic.has(key) {
            instance(generator, key, type-args)
        } else {
            generator.funcs[key].c-name
        };
        // a WIT async func: its wrapper (once the world imports it)
        if generator.wit-externs.has(key) { generator.wit-used.set(key, true); }
        temp(coding, call(key, "s" + step.substring(1, step.len()), args, given, fx().call))
    }

    // what a wait waits for, as a future: an async call begun here (stepped by the waiter, not the
    // executor), or a future's value
    waited-future: func(coding: Codegen, expression: Expr) -> Node {
        let generator = coding.g;
        if async-call(generator, expression) { return start-call(coding, expression, Type.future-type(expr-type(generator, expression))); }
        temp(coding, gen-expr(coding, expression))
    }

    // the result a future holds, of type t (its frame's result follows its header)
    future-result: func(coding: Codegen, pending: Node, given: Type) -> Node {
        pure-call(result-fn(coding.g, given), [pending,], given)
    }

    // a future stepped: whether it is done
    step-node: func(pending: Node) -> Node { call("", "yel_async_step", [pending,], Type.bool-type, fx().call) }

    // wait: each value a future; a state to come back to, each stepped, and the func left (not
    // done) until it is (one), the first is (any: its result, into the union), or all are (all:
    // their results, an anonymous record)
    gen-wait: func(coding: Codegen, expression: Expr, waiting: Wait) -> Node {
        let generator = coding.g;
        let expression-type = expr-type(generator, expression);
        let futs: list<Node> = [];
        let types: list<Type> = [];
        for value in waiting.values {
            futs.push(waited-future(coding, value));
            types.push(waited-type(generator, value));
        }
        coding.f.states += 1;
        let state = coding.f.states;
        add(coding, resume-stmt(state));
        let bool-t = Type.bool-type;
        if waiting.mode == "one" {
            add(coding, if-stmt(un("!", bool-t, step-node(futs[0])), [suspend-stmt(state),], []));
            return temp(coding, future-result(coding, futs[0], types[0]));
        }
        if waiting.mode == "any" {
            // which was done first (each stepped or waited for); none yet: wait
            let s32-t = Type.num("s32");
            let pick-args: list<Node> = [int-const(futs.len(), s32-t),];
            for pending in futs { pick-args.push(pending); }
            let first = temp(coding, call("", "yel_async_first", pick-args, s32-t, fx().call));
            add(coding, if-stmt(bin("<", bool-t, first, int-const(0, s32-t)), [suspend-stmt(state),], []));
            let slot = new-local(coding, expression-type, "");
            let chain: list<Node> = [];
            for position in 0..futs.len() {
                let index = futs.len() - 1 - position;
                let value = represent-as(coding, future-result(coding, futs[index], types[index]), types[index], expression-type);
                chain = [
                    if-stmt(
                        bin("==", bool-t, first, int-const(index, s32-t)),
                        [assign(slot, value),],
                        chain,
                    ),
                ];
            }
            for statement in chain { add(coding, statement); }
            return local-node(coding, slot);
        }
        // all: each stepped (not one leaving the rest unstepped), then all done
        let dones: list<Node> = [];
        for pending in futs { dones.push(temp(coding, step-node(pending))); }
        let all-done = match all-of(dones) {
            some(value) => value,
            none => bool-const(true),
        };
        add(coding, if-stmt(un("!", bool-t, all-done), [suspend-stmt(state),], []));
        let parts: list<Node> = [];
        let names: list<string> = [];
        match expression-type {
            anon-record(slot) => {
                for index in 0..slot.fields.len() {
                    let at = index-of(waiting.fields, slot.fields[index]);
                    parts.push(future-result(coding, futs[at], types[at]));
                    names.push("f_" + mangle(slot.fields[index]));
                }
            }
            _ => {}
        }
        temp(coding, make(c-type(generator, expression-type), names, parts, expression-type))
    }

    // value is a call of an async func
    async-call: func(generator: Gen, value: Expr) -> bool {
        match value.kind {
            call(call) => async-func(generator, call.name),
            method(method) => async-func(generator, method.name),
            _ => false,
        }
    }

    // a waited value's result type: an async call's, a future's
    waited-type: func(generator: Gen, expression: Expr) -> Type {
        if async-call(generator, expression) { return expr-type(generator, expression); }
        match expr-type(generator, expression) {
            future-type(item) => item,
            _ => Type.unit-type,
        }
    }

    // the checks, all of them (none: there are none)
    // the tested value (bound once) and the checks of its pattern (none: it always matches)
    tested: func(coding: Codegen, test: IsTest) -> tuple<Node, option<Node>> {
        let value = bind(coding, gen-expr(coding, test.value));
        let checks: list<Node> = [];
        let binds: list<PatternBinding> = [];
        match test.pattern {
            some(pattern) => pattern-test(coding, pattern, value, expr-type(coding.g, test.value), checks, binds),
            none => {}
        }
        (value, all-of(checks))
    }

    all-of: func(checks: list<Node>) -> option<Node> {
        if checks.len() == 0 { return none; }
        let out = checks[0];
        for index in 1..checks.len() { out = bin("&&", Type.bool-type, out, checks[index]); }
        some(out)
    }

    // what a pattern checks of v (of type t), pushed to checks (v fits when all hold), and what it
    // binds, to binds
    pattern-test: func(
        coding: Codegen,
        pattern: Pattern,
        subject: Node,
        subject-type: Type,
        checks: list<Node>,
        binds: list<PatternBinding>,
    ) {
        let generator = coding.g;
        let s32-t = Type.num("s32");
        // at a union of kinds, a pattern that looks inside one: its tag, then the pattern on the
        // value of that kind
        match subject-type {
            union-type(ks) => {
                let kind = pattern-kind(coding, pattern, ks);
                if kind >= 0 {
                    checks.push(
                        bin(
                            "==",
                            Type.bool-type,
                            load(subject, ["tag",], false, s32-t, false),
                            int-const(kind, s32-t),
                        )
                    );
                    pattern-test(coding, pattern, load(subject, ["c{kind}",], false, ks[kind], false), ks[kind], checks, binds);
                    return;
                }
            }
            _ => {}
        }
        match pattern {
            wild => {}
            member(field) => {
                match subject-type {
                    union-type(ks) => {
                        let kind = kind-index(generator, gen-type(generator, field.ty), ks);
                        checks.push(
                            bin(
                                "==",
                                Type.bool-type,
                                load(subject, ["tag",], false, s32-t, false),
                                int-const(kind, s32-t),
                            )
                        );
                        pattern-test(
                            coding,
                            field.sub,
                            load(subject, ["c{kind}",], false, ks[kind], false),
                            ks[kind],
                            checks,
                            binds,
                        );
                    }
                    _ => pattern-test(coding, field.sub, subject, subject-type, checks, binds),
                }
            }
            // let n: T: the test of T's values, and n the whole value (narrowed where it is read)
            typed(field) => {
                match field.test {
                    some(tp) => pattern-test(coding, tp, subject, subject-type, checks, binds),
                    none => {}
                }
                pattern-test(coding, field.sub, subject, subject-type, checks, binds);
            }
            literal(literal) => checks.push(eq-node(generator, subject-type, subject, gen-expr(coding, literal))),
            // lo <= v && v <= hi (v < hi: not inclusive)
            range(field) => {
                let bool-t = Type.bool-type;
                checks.push(bin(">=", bool-t, subject, gen-expr(coding, field.lo)));
                checks.push(
                    bin(if field.inclusive { "<=" } else { "<" }, bool-t, subject, gen-expr(coding, field.hi))
                );
            }
            name(pn) => {
                if pn.kind == "case" { case-test(coding, pn.name, Pattern.wild, subject, subject-type, checks, binds); }
                else if pn.kind == "const" {
                    match pn.value {
                        some(environment) => checks.push(eq-node(generator, subject-type, subject, gen-expr(coding, environment))),
                        none => {}
                    }
                } else {
                    binds.push({ name: pn.name, value: subject, mark: pn.mark, });
                }
            }
            case(pc) => case-test(coding, pc.name, pc.sub, subject, subject-type, checks, binds),
            record(pr) => {
                // a declared record's fields through its pointer, an anonymous one's in it
                let shape: option<RecordShape> = match subject-type {
                    named(rn) => some({
                        fields: generator.symbols.records[rn].fields,
                        types: generator.symbols.records[rn].field-types,
                        value: generator.symbols.records[rn].value,
                    }),
                    anon-record(anonymous) => some({ fields: anonymous.fields, types: anonymous.types, value: true, }),
                    _ => none,
                };
                let arrow = match subject-type {
                    named(_) => true,
                    _ => false,
                };
                match shape {
                    some(record-shape) => {
                        for kind in 0..pr.fields.len() {
                            let position = index-of(record-shape.fields, pr.fields[kind]);
                            let ft = gen-type(generator, record-shape.types[position]);
                            let field = load(subject, ["f_{mangle(pr.fields[kind])}",], arrow, ft, false);
                            pattern-test(coding, pr.patterns[kind], field, ft, checks, binds);
                        }
                        // ...rest: an anonymous record of the fields not named
                        if pr.rest != "" {
                            let names: list<string> = [];
                            let ts: list<Type> = [];
                            let parts: list<Node> = [];
                            for position in 0..record-shape.fields.len() {
                                if !contains(pr.fields, record-shape.fields[position]) {
                                    let ft = gen-type(generator, record-shape.types[position]);
                                    names.push("f_" + mangle(record-shape.fields[position]));
                                    ts.push(ft);
                                    parts.push(
                                        load(subject, ["f_{mangle(record-shape.fields[position])}",], arrow, ft, false)
                                    );
                                }
                            }
                            let rest-fields: list<string> = [];
                            for position in 0..record-shape.fields.len() {
                                if !contains(pr.fields, record-shape.fields[position]) {
                                    rest-fields.push(record-shape.fields[position]);
                                }
                            }
                            let rt = Type.anon-record({ fields: rest-fields, types: ts, name: "", });
                            binds.push({
                                name: pr.rest,
                                value: make(c-type(generator, rt), names, parts, rt),
                                mark: pr.rest-mark,
                            });
                        }
                    }
                    none => {}
                }
            }
            tuple(ps) => {
                match subject-type {
                    tuple-type(xs) => {
                        for kind in 0..ps.len() {
                            pattern-test(
                                coding,
                                ps[kind],
                                load(subject, ["f{kind}",], false, xs[kind], false),
                                xs[kind],
                                checks,
                                binds,
                            );
                        }
                    }
                    _ => {}
                }
            }
            alt(ps) => {
                // any of them (they bind nothing)
                let any: option<Node> = none;
                let always = false;
                for alternative in ps {
                    let sub: list<Node> = [];
                    pattern-test(coding, alternative, subject, subject-type, sub, binds);
                    match all-of(sub) {
                        none => { always = true; }
                        some(check) => {
                            any = some(match any {
                                none => check,
                                some(earlier) => bin("||", Type.bool-type, earlier, check),
                            });
                        }
                    }
                }
                if !always {
                    match any {
                        some(check) => checks.push(check),
                        none => {}
                    }
                }
            }
        }
    }

    // which of a union's kinds a pattern looks inside (-1: none, as _, a binding, | and let n: T,
    // which test the whole value)
    pattern-kind: func(coding: Codegen, pattern: Pattern, ks: list<Type>) -> s64 {
        let generator = coding.g;
        let none-found = -1;
        match pattern {
            literal(literal) => { return kind-index(generator, expr-type(generator, literal), ks); }
            range(range) => { return kind-index(generator, expr-type(generator, range.lo), ks); }
            name(pn) => {
                if pn.kind == "case" { return case-kind(pn.name, ks, generator); }
                if pn.kind == "const" {
                    match pn.value {
                        some(environment) => { return kind-index(generator, expr-type(generator, environment), ks); }
                        none => {}
                    }
                }
            }
            case(pc) => { return case-kind(pc.name, ks, generator); }
            // the record kind with every field the pattern names (the checker saw one does)
            record(pr) => {
                for index in 0..ks.len() {
                    let fields: list<string> = match ks[index] {
                        named(name) => if generator.symbols.records.has(name) { generator.symbols.records[name].fields } else { [] },
                        anon-record(anonymous) => anonymous.fields,
                        _ => [],
                    };
                    let all = fields.len() > 0;
                    for field in pr.fields {
                        if !contains(fields, field) { all = false; }
                    }
                    if all { return index; }
                }
            }
            tuple(ps) => {
                for index in 0..ks.len() {
                    match ks[index] {
                        tuple-type(xs) => { if ps.len() > 0 && xs.len() == ps.len() { return index; } }
                        unit-type => { if ps.len() == 0 { return index; } }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        none-found
    }

    // the kind with a case n
    case-kind: func(name: string, ks: list<Type>, generator: Gen) -> s64 {
        for index in 0..ks.len() {
            let has = match ks[index] {
                option-type(_) => name == "none" || name == "some",
                result-type(_) => name == "ok" || name == "err",
                bool-type => name == "true" || name == "false",
                named(vn) => generator.symbols.variants.has(vn) && case-index(generator.symbols.variants[vn], name) >= 0,
                _ => false,
            };
            if has { return index; }
        }
        -1
    }

    // the case n of t: v is it, and its payload fits sub
    case-test: func(
        coding: Codegen,
        name: string,
        sub: Pattern,
        subject: Node,
        subject-type: Type,
        checks: list<Node>,
        binds: list<PatternBinding>,
    ) {
        let generator = coding.g;
        let bool-t = Type.bool-type;
        match subject-type {
            option-type(item) => {
                let has = load(subject, ["has",], false, bool-t, false);
                checks.push(if name == "none" { un("!", bool-t, has) } else { has });
                pattern-test(coding, sub, load(subject, ["value",], false, item, false), item, checks, binds);
            }
            result-type(result) => {
                let is-err = load(subject, ["is_err",], false, bool-t, false);
                checks.push(if name == "ok" { un("!", bool-t, is-err) } else { is-err });
                let side = if name == "ok" { result.ok } else { result.err };
                pattern-test(coding, sub, load(subject, [name,], false, side, false), side, checks, binds);
            }
            bool-type => checks.push(if name == "true" { subject } else { un("!", bool-t, subject) }),
            named(vn) => {
                let dv = generator.symbols.variants[vn];
                let index = case-index(dv, name);
                let s32-t = Type.num("s32");
                if is-enum(generator, vn) { checks.push(bin("==", bool-t, subject, int-const(index, subject-type))); }
                else {
                    // (a variant held by value: its parts in it, not through a pointer)
                    let arrow = !value-variant(generator, vn);
                    checks.push(
                        bin("==", bool-t, load(subject, ["tag",], arrow, s32-t, false), int-const(index, s32-t))
                    );
                    let pt = dv.cases[index].payload;
                    pattern-test(
                        coding,
                        sub,
                        load(subject, ["u", "c_{mangle(name)}",], arrow, pt, false),
                        pt,
                        checks,
                        binds,
                    );
                }
            }
            _ => {}
        }
    }

    // ================================================================ statements

    // a block's statements in a scope of their own: its value when keep (as checked), else unit
    gen-block: func(coding: Codegen, block: Block, keep: bool) -> Node {
        let generator = coding.g;
        coding.scopes.push(map.new());
        let value = unit-const();
        let outer = coding.span;
        for index in 0..block.stmts.len() {
            let statement = block.stmts[index];
            if index < block.spans.len() && block.spans[index].line != 0 { coding.span = block.spans[index]; }
            value = unit-const();
            match statement {
                let-stmt(let-statement) => {
                    let value = gen-expr(coding, let-statement.value);
                    let variable = declare(coding, expr-type(generator, let-statement.value), let-statement.name, let-statement.mark);
                    add(coding, write-var(coding, variable, value));
                }
                let-pattern(let-pattern) => {
                    // every value fits (the checker saw): only what it binds
                    let value = temp(coding, gen-expr(coding, let-pattern.value));
                    let checks: list<Node> = [];
                    let binds: list<PatternBinding> = [];
                    pattern-test(coding, let-pattern.pattern, value, expr-type(generator, let-pattern.value), checks, binds);
                    for bound in binds {
                        let variable = declare(coding, bound.value.ty, bound.name, bound.mark);
                        add(coding, write-var(coding, variable, bound.value));
                    }
                }
                return-stmt(value) => { add(coding, return-stmt(gen-expr(coding, value))); }
                // x op= v: x read first, then v (left to right, as xs[i] op= v and every call's
                // arguments)
                assign(assignment) => {
                    let at = expr-type(generator, assignment.value);
                    let named = lookup(coding, assignment.name);
                    // a global's (no local hides it: the checker named it by its key)
                    if !found(named) && generator.symbols.globals.has(name-text(assignment.name)) {
                        let gt = gen-type(generator, generator.symbols.globals[name-text(assignment.name)].ty);
                        if assignment.op == "=" { add(coding, store(global-node(name-text(assignment.name), gt), bind(coding, gen-expr(coding, assignment.value)))); }
                        else {
                            let now = temp(coding, global-node(name-text(assignment.name), gt));
                            let value = gen-expr(coding, assignment.value);
                            add(coding, store(global-node(name-text(assignment.name), gt), bind(coding, arith(at, from-byte(assignment.op.byte-at(0)), now, value, at))));
                        }
                    } else {
                        let variable = binding(named);
                        if assignment.op == "=" { add(coding, write-var(coding, variable, gen-expr(coding, assignment.value))); }
                        else {
                            let now = temp(coding, read-var(coding, variable));
                            let value = gen-expr(coding, assignment.value);
                            add(coding, write-var(coding, variable, arith(at, from-byte(assignment.op.byte-at(0)), now, value, at)));
                        }
                    }
                }
                assign-field(field-assignment) => {
                    let at = expr-type(generator, field-assignment.value);
                    let path = ["f_{mangle(field-assignment.name)}",];
                    // a record's (a value's) field: set where the record is (its local, a global, the
                    // field of what holds it)
                    if is-value(expr-type(generator, field-assignment.target)) {
                        let place = load(value-place(coding, field-assignment.target), path, false, at, true);
                        if field-assignment.op == "=" { add(coding, store(place, bind(coding, gen-expr(coding, field-assignment.value)))); }
                        else {
                            let cur = temp(coding, place);
                            let value = gen-expr(coding, field-assignment.value);
                            add(coding, store(place, bind(coding, arith(at, from-byte(field-assignment.op.byte-at(0)), cur, value, at))));
                        }
                        continue;
                    }
                    let tt = expr-type(generator, field-assignment.target);
                    if field-assignment.op == "=" {
                        let sides = gen-operands(coding, [field-assignment.target, field-assignment.value,]);
                        let object = pin(coding, sides[0]);
                        will-set(coding, object, tt, field-assignment.name);
                        add(coding, store(load(object, ["f_{mangle(field-assignment.name)}",], true, at, true), sides[1]));
                    } else {
                        let target = temp(coding, gen-expr(coding, field-assignment.target));
                        let place = load(target, ["f_{mangle(field-assignment.name)}",], true, at, true);
                        let cur = temp(coding, place);
                        let value = gen-expr(coding, field-assignment.value);
                        will-set(coding, target, tt, field-assignment.name);
                        add(coding, store(place, arith(at, from-byte(field-assignment.op.byte-at(0)), cur, value, at)));
                    }
                }
                for-stmt(for-statement) => gen-for(coding, for-statement),
                loop-stmt(loop-statement) => gen-loop(coding, loop-statement),
                break-stmt => add(coding, break-stmt(-1)),
                continue-stmt => add(coding, continue-stmt(-1)),
                expr-stmt(expression-statement) => {
                    if expression-statement.is-value && keep { value = gen-expr(coding, expression-statement.value); }
                    else { gen-discard(coding, expression-statement.value); }
                }
            }
        }
        coding.span = outer;
        coding.scopes.pop();
        value
    }

    // a for: a loop with its counter (s64), counted up by its step; over a list, each item, its
    // length read each turn (items pushed on are reached)
    gen-for: func(coding: Codegen, for-statement: For) {
        let generator = coding.g;
        let s64 = Type.num("s64");
        let bool-t = Type.bool-type;
        let index-slot = new-local(coding, s64, "");
        let counter = local-node(coding, index-slot);
        let step = assign(index-slot, bin("+", s64, counter, int-const(1, s64)));
        match for-statement.stop {
            none => {
                let lt = expr-type(generator, for-statement.start);
                // a generator's values: stepped for each (its frame's result), until it is done
                match lt {
                    seq-type(element-type) => {
                        let src = temp(coding, gen-expr(coding, for-statement.start));
                        coding.scopes.push(map.new());
                        let unit = enter-unit(coding, for-statement.unit);
                        let item = declare(coding, element-type, for-statement.name, for-statement.mark);
                        let body = gen-body(coding, for-statement.body, false, -1);
                        let first = write-var(coding, item, future-result(coding, src, element-type));
                        let turn = exit-unit(coding, unit, [first,]);
                        coding.scopes.pop();
                        // each turn first: the next value (a call: into a local), or the end
                        let saved = coding.out;
                        coding.out = [];
                        let more = temp(coding, call("", "y_seq_next", [src,], bool-t, fx().call));
                        add(coding, if-stmt(un("!", bool-t, more), [break-stmt(-1),], []));
                        let head = coding.out;
                        coding.out = saved;
                        add(coding, loop-stmt(none, none, concat(head, concat(turn, body)), -1));
                        return;
                    }
                    _ => {}
                }
                let it = match lt {
                    list-type(item) => item,
                    fixed-list(fixed) => fixed.item,
                    _ => Type.unit-type,
                };
                // a fixed-length list's copy, its length a constant
                let len = match lt {
                    fixed-list(fixed) => fixed.len,
                    _ => -1,
                };
                let xs = temp(coding, gen-expr(coding, for-statement.start));
                add(coding, assign(index-slot, int-const(0, s64)));
                coding.scopes.push(map.new());
                // each turn: its environment (when a closure captures a binding of it), then its
                // item
                let unit = enter-unit(coding, for-statement.unit);
                let item = declare(coding, it, for-statement.name, for-statement.mark);
                let body = gen-body(coding, for-statement.body, false, -1);
                let first = write-var(coding, item, list-get(xs, counter, c-type(generator, it), it, len >= 0));
                let turn = exit-unit(coding, unit, [first,]);
                coding.scopes.pop();
                let end = if len >= 0 {
                    int-const(len, s64)
                } else {
                    load(xs, ["len",], true, s64, true)
                };
                let test = bin("<", bool-t, counter, end);
                add(coding, loop-stmt(some(test), some(step), concat(turn, body), -1));
            }
            some(stop) => {
                // the counter of the range's own type (a u64's past s64's); it never steps past
                // the end: a..b steps while it is before b, a..=b checks it is not b before each
                // step (b may be the type's greatest)
                let ends = gen-operands(coding, [for-statement.start, stop,]);
                let vt = expr-type(generator, for-statement.start);
                let at = new-local(coding, vt, "");
                let end-slot = new-local(coding, vt, "");
                add(coding, assign(at, ends[0]));
                add(coding, assign(end-slot, ends[1]));
                let here = local-node(coding, at);
                let last = local-node(coding, end-slot);
                let next = assign(at, bin("+", vt, here, int-const(1, vt)));
                coding.scopes.push(map.new());
                let unit = enter-unit(coding, for-statement.unit);
                let var = declare(coding, vt, for-statement.name, for-statement.mark);
                let body = gen-body(coding, for-statement.body, false, -1);
                let turn = exit-unit(coding, unit, [write-var(coding, var, here),]);
                coding.scopes.pop();
                if for-statement.inclusive {
                    // the step at the top of each turn but the first (so a continue steps too)
                    let first = new-local(coding, bool-t, "");
                    add(coding, assign(first, bool-const(true)));
                    let advance = if-stmt(
                        un("!", bool-t, local-node(coding, first)),
                        [if-stmt(bin("==", bool-t, here, last), [break-stmt(-1),], []), next,],
                        [],
                    );
                    let each = concat([advance, assign(first, bool-const(false)),], concat(turn, body));
                    add(coding, if-stmt(bin("<=", bool-t, here, last), [loop-stmt(none, none, each, -1),], []));
                } else {
                    let test = bin("<", bool-t, here, last);
                    add(coding, loop-stmt(some(test), some(next), concat(turn, body), -1));
                }
            }
        }
    }

    // loop { … }: its body each turn (its environment first, when a closure captures a binding of
    // it), until a break leaves
    gen-loop: func(coding: Codegen, loop-statement: Loop) {
        coding.scopes.push(map.new());
        let unit = enter-unit(coding, loop-statement.unit);
        let body = gen-body(coding, loop-statement.body, false, -1);
        let turn = exit-unit(coding, unit, []);
        coding.scopes.pop();
        add(coding, loop-stmt(none, none, concat(turn, body), -1));
    }

    found: func(variable: option<Var>) -> bool {
        match variable {
            some(_) => true,
            none => false,
        }
    }

    // the binding an option holds (the checker saw it bound)
    binding: func(optional: option<Var>) -> Var {
        match optional {
            some(variable) => variable,
            none => panic("codegen: a name the checker bound has no binding"),
        }
    }


    // ---- constants as static data

    // a list literal every item of which is a constant (numbers, bools, chars, strings, and records,
    // tuples and non-empty lists of them): its static data, defined for C (its items' definition
    // among the helpers, and its header's but for a flat one); none where any item is computed
    static-list: func(coding: Codegen, lt: Type, items: list<Expr>, nested: bool) -> option<StaticList> {
        let generator = coding.g;
        let item = match resolve(lt) {
            list-type(item) => item,
            _ => { return none; }
        };
        let values: list<StaticValue> = [];
        for one in items {
            match static-value(coding, item, one) {
                some(variable) => values.push(variable),
                none => { return none; }
            }
        }
        let name = "Y_SL_{generator.helper-bodies.len()}";
        let ct = c-type(generator, item);
        let shown: list<string> = [];
        for value in values { shown.push(static-c(generator, item, value)); }
        // (one in another's items: a header the other points at)
        let flat = !nested && !holds-list(generator, item);
        generator.helper-bodies.push(c"static {ct} {name}_items[{values.len()}] = { {shown.join(", ")} };");
        if !flat { generator.helper-bodies.push(c"static ylist {name} = { {values.len()}, {values.len()}, sizeof({ct}), (char *){name}_items, {scan-fn(generator, item)} };"); }
        some({ ty: lt, items: values, c-name: name, flat: flat, })
    }

    // whether a value of type t holds a list (static data of it then copied list by list)
    holds-list: func(generator: Gen, t0: Type) -> bool {
        match resolve(t0) {
            list-type(_) => true,
            anon-record(anonymous) => anonymous.types.any({ one -> holds-list(generator, one) }),
            tuple-type(items) => items.any({ one -> holds-list(generator, one) }),
            _ => false,
        }
    }

    // a constant of type t as static data holds it (none: e is computed, or of a type static data
    // holds none of: an object, a variant, a map)
    static-value: func(coding: Codegen, t0: Type, expression: Expr) -> option<StaticValue> {
        let generator = coding.g;
        let resolved = resolve(t0);
        match expression.kind {
            record-lit(inits) => {
                let fields = match resolved {
                    anon-record(anonymous) => anonymous,
                    _ => { return none; }
                };
                let parts: list<StaticValue> = [];
                for index in 0..fields.fields.len() {
                    let named = inits.filter({ one -> one.name == fields.fields[index] });
                    if named.len() != 1 { return none; }
                    match static-value(coding, fields.types[index], named[0].value) {
                        some(variable) => parts.push(variable),
                        none => { return none; }
                    }
                }
                some(StaticValue.parts(parts))
            }
            tuple-lit(members) => {
                let types = match resolved {
                    tuple-type(items) => items,
                    _ => { return none; }
                };
                if types.len() != members.len() { return none; }
                let parts: list<StaticValue> = [];
                for index in 0..types.len() {
                    match static-value(coding, types[index], members[index]) {
                        some(variable) => parts.push(variable),
                        none => { return none; }
                    }
                }
                some(StaticValue.parts(parts))
            }
            list-lit(items) => {
                if items.len() == 0 { return none; }
                match resolved {
                    list-type(_) => {}
                    _ => { return none; }
                }
                match static-list(coding, resolved, items, true) {
                    some(data) => some(StaticValue.list(data)),
                    none => none,
                }
            }
            // a func that only makes a record of its parameters, given constants: that record
            call(call) => {
                if !generator.constructors.has(call.name) { return none; }
                let constructor = generator.constructors[call.name];
                if call.args.len() != constructor.params.len() { return none; }
                let made = match constructor.body.stmts[0] {
                    expr-stmt(expression-statement) => expression-statement.value,
                    _ => { return none; }
                };
                let inits = match made.kind {
                    record-lit(record-literal) => record-literal,
                    _ => { return none; }
                };
                let given: list<FieldInit> = [];
                for init in inits {
                    let value = match init.value.kind {
                        name(name) => {
                            let at = constructor.params.index-of(name-text(name));
                            if at < 0 { return none; }
                            call.args[at]
                        }
                        _ => init.value,
                    };
                    given.push({ name: init.name, value: value, name-span: init.name-span, });
                }
                static-value(coding, resolved, { kind: ExprKind.record-lit(given), span: expression.span, ty: expression.ty, })
            }
            str-lit(_) => scalar(coding, resolved, expression),
            int-lit(_) => scalar(coding, resolved, expression),
            float-lit(_) => scalar(coding, resolved, expression),
            bool-lit(_) => scalar(coding, resolved, expression),
            char-lit(_) => scalar(coding, resolved, expression),
            unary(unary) => {
                if unary.op != "-" { return none; }
                match unary.value.kind {
                    int-lit(_) => scalar(coding, resolved, expression),
                    float-lit(_) => scalar(coding, resolved, expression),
                    _ => none,
                }
            }
            _ => none,
        }
    }

    // a literal of a scalar type (a string a ystr: a literal union of strings too), as its
    // constant gives it
    scalar: func(coding: Codegen, wanted: Type, expression: Expr) -> option<StaticValue> {
        let ct = c-type(coding.g, wanted);
        let node = gen-expr(coding, expression);
        match node.kind {
            const(constant) => match constant {
                int(integer) => if ct == "ystr" { none } else { some(StaticValue.int(integer)) },
                float(number) => some(StaticValue.float(number)),
                bool(flag) => some(StaticValue.int(if flag { 1 } else { 0 })),
                text(contents) => if ct == "ystr" { some(StaticValue.text(contents)) } else { none },
                _ => none,
            },
            _ => none,
        }
    }

    // a static value's C initializer (of type t)
    static-c: func(generator: Gen, t0: Type, static-value: StaticValue) -> string {
        let resolved = resolve(t0);
        match static-value {
            int(bits) => int-c(generator, bits, resolved),
            float(number) => float-c(number, resolved),
            text(contents) => c"{ {contents.len()}, \"{c-escape(contents)}\" }",
            list(data) => "&{data.c-name}",
            parts(members) => {
                let types: list<Type> = match resolved {
                    anon-record(anonymous) => anonymous.types,
                    tuple-type(items) => items,
                    _ => [],
                };
                let shown: list<string> = [];
                for index in 0..members.len() { shown.push(static-c(generator, types[index], members[index])); }
                c"{ {shown.join(", ")} }"
            }
        }
    }
}
