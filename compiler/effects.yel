// The readonly and move checks. The checker lets a readonly value be given a parameter that is
// not readonly, and a value a readonly parameter, and records where (EffectSite), and where a
// stream or a future is moved to a WIT func; once the program's flow is known (escape.yel, on the
// IR, after codegen: what each func writes, keeps and gives back, which locals may hold one value),
// each such place is checked here: a readonly value only to a parameter its func never writes or
// keeps (nor gives back, unless the func is generic and its result's type says readonly again), a
// value only to a readonly parameter its func never keeps nor gives back (else the readonly name
// would see it change), a value made readonly only where no other name may write it, a moved one
// never used again. Where each local is used, and from what it is made, is read here from the
// syntax tree, by binding (LocalFacts); who else may hold it, from the flow. Nothing of this is in
// the C: it is all known when compiling.

// where readonly and not meet: a readonly value given a parameter that is not (read), a value given
// a readonly parameter (borrow), or a value where readonly is wanted otherwise (freeze: a typed
// let, a result, a field); or a local holding a stream or a future given a WIT func (move: its end
// leaves the component, so the local has nothing left)
type site-kind = "read" | "borrow" | "freeze" | "move";

// such a place: the call (callee, the parameter's index) for read and borrow, and the value given:
// a local (local) or a call's result (source), else neither
record EffectSite {
    file: string,
    span: Span,
    in-func: string,
    kind: site-kind,
    callee: string,
    index: s64,
    local: string,
    // the local's binding (none for a value that is not a local's)
    binding: option<Mark>,
    source: string,
    // a started call's (start f(…): the task holds its arguments while it runs, past the call)
    started: bool,
    // whether the call's result, its type arguments given, is readonly (a generic func gives back
    // a readonly argument as readonly only then)
    result-readonly: bool,
}

// what a local made readonly is given, and where it is: whether everything given it is new,
// how many loops deep it is made and made readonly (the walk's depth now), and a use after
record LocalFacts {
    // the local (its binding), and its func's bindings (which names are it)
    binding: Mark,
    bindings: Bindings,
    at: Span,
    sources-fresh: bool,
    bound: bool,
    depth: s64,
    made-depth: s64,
    at-depth: s64,
    used-after: option<Span>,
    // the name it is made readonly as (let frozen: T & readonly = x: a name that cannot write it)
    frozen-as: option<Mark>,
    // whether a pattern's part of a new value is new (let (s, w) = stream-pair(1): a stream's ends
    // are its own; not for readonly, where a func's new value may hold one list twice)
    parts-fresh: bool,
}

// what a func does with one parameter
record ParamEffect { writes: bool, keeps: bool, gives: bool, }

// an IR local a binding is (its func's C name, its index): a generic func's binding is one in
// each instance
record IrLocalRef { func: Name, local: s64, }

// the program's flow as the checks read it: what each func (by key: its instances together) does
// with each parameter and whether its result is new, what each extern does (by name), and the IR
// locals each binding is
record FlowView {
    // the compile's context: its sources, the errors found so far, what was asked for
    context: Context,
    facts: Facts,
    all: map<string, list<ParamEffect>>,
    fresh: map<string, bool>,
    externs: map<string, RuntimeEffect>,
    locals: map<Mark, list<IrLocalRef>>,
}

module effects {
    // each site checked against the program's flow
    check-sites: func(decls: list<Decl>, sites: list<EffectSite>, p: Facts, context: Context) {
        if sites.len() == 0 { return; }
        let funcs: map<string, Func> = map.new();
        let externs: map<string, RuntimeEffect> = map.new();
        for d in decls {
            match d {
                func-decl(f) => funcs.set(f.name, f),
                extern-decl(x) => externs.set(x.name, flow.derive(x)),
                _ => {}
            }
        }
        let v = view(p, externs, context);
        for s in sites { check-site(s, funcs, v); }
    }

    // the flow by func key and by binding
    view: func(p: Facts, externs: map<string, RuntimeEffect>, context: Context) -> FlowView {
        let v: FlowView = {
            context: context,
            facts: p,
            all: map.new(),
            fresh: map.new(),
            externs: externs,
            locals: map.new(),
        };
        for c in p.funcs.keys() {
            let f = p.funcs[c];
            for i in 0..f.locals.len() {
                match f.locals[i].binding {
                    some(m) => {
                        if !v.locals.has(m) { v.locals.set(m, []); }
                        v.locals[m].push({ func: c, local: i, });
                    }
                    none => {}
                }
            }
            if !f.closure && p.param-escapes.has(c) {
                let keeps = p.param-escapes[c];
                let kept-in = p.param-kept-in[c];
                let gives = p.param-gives[c];
                let ws = p.param-writes[c];
                let mine: list<ParamEffect> = [];
                // kept in another argument is kept, for readonly's sake (that one may write it)
                for i in 0..keeps.len() { mine.push({ writes: ws[i], keeps: keeps[i] || kept-in[i].len() > 0, gives: gives[i], }); }
                if v.all.has(f.key) {
                    let had = v.all[f.key];
                    for i in 0..had.len() {
                        if i < mine.len() {
                            had[i] = {
                                writes: had[i].writes || mine[i].writes,
                                keeps: had[i].keeps || mine[i].keeps,
                                gives: had[i].gives || mine[i].gives,
                            };
                        }
                    }
                } else {
                    v.all.set(f.key, mine);
                }
                let fresh = p.fresh-result[c];
                v.fresh.set(f.key, if v.fresh.has(f.key) { v.fresh[f.key] && fresh } else { fresh });
            }
        }
        v
    }

    check-site: func(s: EffectSite, funcs: map<string, Func>, v: FlowView) {
        let callee = base-name(s.callee);
        if s.kind == "move" {
            if funcs.has(s.in-func) {
                check-move(s, funcs[s.in-func], callee, v);
            }
            return;
        }
        if s.kind == "read" {
            let e = effect(s.callee, s.index, v);
            let generic = funcs.has(s.callee) && funcs[s.callee].type-params.len() > 0
                || v.externs.has(s.callee);
            let what = "argument {s.index + 1} of {callee} is readonly";
            if e.writes {
                site-error(v, s, "{what}, and {callee} writes it", "readonly", "", "give it a value that is not readonly (a copy), or make {callee} only read it");
                return;
            }
            if e.keeps {
                site-error(v, s, "{what}, and {callee} keeps it where it may be written", "readonly", "", "");
                return;
            }
            // a generic func gives back what it is given: readonly where its result's type is
            if e.gives && !(generic && s.result-readonly) {
                site-error(v, s, "{what}, and {callee} gives it back as a value that may be written", "readonly", "", "");
                return;
            }
            return;
        }
        if s.kind == "borrow" {
            let e = effect(s.callee, s.index, v);
            // lent for the call: fine where the func keeps nothing; else it must be a value no
            // other name has (then given away). A started call's task holds it while it runs
            if !e.keeps && !e.gives && !s.started { return; }
        }
        let why = unique-why(s, funcs, v);
        if why == "" { return; }
        // a use after it is made readonly: shown where it is
        let d = diagnostics.error(
            s.span,
            if s.kind == "borrow" && s.started {
                "argument {s.index + 1} of {callee} is wanted readonly, and the started task holds it while it runs: {why}"
            } else if s.kind == "borrow" {
                "argument {s.index + 1} of {callee} is wanted readonly, and {callee} keeps it or gives it back: {why}"
            } else {
                "readonly is wanted here: {why}"
            },
            "",
        );
        match s.binding {
            some(m) => {
                if funcs.has(s.in-func) {
                    match used-after(funcs[s.in-func], m, s.span, v) {
                        some(sp) => diagnostics.also(d, sp, "used here, after it is made readonly"),
                        none => {}
                    }
                }
            }
            none => {}
        }
        diagnostics.report(v.context, d);
    }

    // an error at a site, kept (its caller goes on to the next site: one error for each): its
    // label, a note and help ("" for none)
    site-error: func(v: FlowView, s: EffectSite, message: string, label: string, note: string, help: string) {
        let d = diagnostics.error(s.span, message, label);
        if note != "" { diagnostics.note(d, note); }
        if help != "" { diagnostics.help(d, help); }
        diagnostics.report(v.context, d);
    }

    // where a local is used after a place (at), if it is
    used-after: func(f: Func, x: Mark, at: Span, v: FlowView) -> option<Span> {
        let facts = facts-for(f, x, at, false);
        local-facts-block(facts, f.body, v);
        facts.used-after
    }

    // why a site's value may have another name that writes it ("" when it has none: a value made
    // by a func that gives back such values, or a local made so and not used after)
    unique-why: func(s: EffectSite, funcs: map<string, Func>, v: FlowView) -> string {
        if s.source != "" {
            if is-fresh(s.source, v) { return ""; }
            return "{base-name(s.source)} may give back a value another name has (make it in the func, or give back one no one else has)";
        }
        match s.binding {
            some(m) => {
                if funcs.has(s.in-func) {
                    return local-why(funcs[s.in-func], m, s.span, v);
                }
            }
            none => {}
        }
        "the value may have another name that writes it"
    }

    // whether a call's result is a value no other name has
    is-fresh: func(callee: string, v: FlowView) -> bool {
        if v.fresh.has(callee) { return v.fresh[callee]; }
        // an extern's: new values, but for those that give back part of an argument
        if v.externs.has(callee) { return flow.is-new(v.externs[callee]); }
        false
    }

    // why a func's local x may have another name that writes it where it is made readonly (at):
    // "" when everything given it is new, it is never kept nor given another name, and it is not
    // used after (nor made readonly in a loop it was made outside of)
    local-why: func(f: Func, x: Mark, at: Span, v: FlowView) -> string {
        let n = binding-name(f, x);
        if contains(f.marks, x) || is-param(v, x) { return "{n} is a parameter: its caller may have it too"; }
        let facts = facts-for(f, x, at, false);
        local-facts-block(facts, f.body, v);
        if !facts.sources-fresh {
            return "{n} is given a value another name may have (only a literal, or a func's new value, can be made readonly)";
        }
        if facts.at-depth > facts.made-depth && facts.made-depth >= 0 {
            return "{n} is made outside the loop it is made readonly in (the next turn would see it)";
        }
        match facts.used-after {
            some(sp) => {
                return "{n} is used again after (once readonly, use the readonly name)";
            }
            none => {}
        }
        // kept, or given another name: as the flow says
        let held = held-by(v, x, facts.frozen-as);
        if held == "kept" { return "{n} is kept where it may be written (stored, or captured by a closure)"; }
        if held != "" { return "{held} is another name for {n} (or part of it), and may write it"; }
        ""
    }

    // whether a binding is a parameter (a closure's too: the IR's lifted func's)
    is-param: func(v: FlowView, x: Mark) -> bool {
        if !v.locals.has(x) { return false; }
        for r in v.locals[x] {
            let f = v.facts.funcs[r.func];
            for q in f.params {
                if q == r.local { return true; }
            }
        }
        false
    }

    // what the flow says of a binding's value: "kept" (it escapes: stored, kept by a func it is
    // given, captured), another binding's name that may hold it (but but's: the name it is made
    // readonly as), or "" for neither
    held-by: func(v: FlowView, x: Mark, but: option<Mark>) -> string {
        if x.captured { return "kept"; }
        if !v.locals.has(x) { return ""; }
        for r in v.locals[x] {
            if v.facts.groups.has(r.func) {
                let f = v.facts.funcs[r.func];
                let made = derived(v, f, r.local);
                // kept: it, or a value made of it, let escape (a spawned task's frame among them)
                for n in flatten(f.body) {
                    for e in opt.escaping(v.facts, n) {
                        if reads-any(e, made) { return "kept"; }
                    }
                }
                // another name: a binding whose value is made from it (through any chain of
                // assignments: a copy, a call given it, a value built of it) and may hold one that is
                // written
                for j in made {
                    match f.locals[j].binding {
                        some(m) => {
                            let other = m != x && match but {
                                some(b) => m != b,
                                none => true,
                            };
                            // a readonly binding never writes it (what it holds is read only)
                            if other && opt.local-mutable(v.facts, f, j) && !is-readonly(resolve(m.ty)) {
                                return f.locals[j].name;
                            }
                        }
                        none => {}
                    }
                }
            }
        }
        ""
    }

    // a local moved where it is given (s.span) may not be used again: not after, not in the next
    // turn of a loop it is made outside of, not through another name
    check-move: func(s: EffectSite, f: Func, callee: string, v: FlowView) {
        let n = s.local;
        let x = match s.binding {
            some(m) => m,
            none => { return; }
        };
        let moved = "moved here: {callee} takes its end (it leaves the component)";
        let facts = facts-for(f, x, s.span, true);
        if contains(f.marks, x) { facts.made-depth = 0; }
        local-facts-block(facts, f.body, v);
        if !facts.sources-fresh {
            site-error(
                v,
                s,
                "{n} is moved, and another name may hold it",
                moved,
                "{n} is given a value made elsewhere (a name's, a field's, or part of one)",
                "move a stream or a future made here: a func's new value, or a part of one (let (s, w) = stream-pair(8))",
            );
            return;
        }
        match facts.used-after {
            some(sp) => {
                let d = diagnostics.error(sp, "{n} is used after it is moved", "used here, after the move");
                diagnostics.also(d, s.span, moved);
                diagnostics.help(d, "a stream or a future given a WIT func is the callee's: read what you need from it first");
                diagnostics.report(v.context, d);
                return;
            }
            none => {}
        }
        if facts.at-depth > facts.made-depth && facts.made-depth >= 0 {
            site-error(
                v,
                s,
                "{n} is moved in a loop it is made outside of",
                "moved here, in every turn",
                "the next turn would move it again",
                "make it in the loop, or break out of the loop once it is moved",
            );
            return;
        }
        let held = held-by(v, x, none);
        if held == "kept" {
            site-error(
                v,
                s,
                "{n} is moved, and it is kept elsewhere (stored, or captured by a closure)",
                moved,
                "what keeps it could still use it after the move",
                "",
            );
            return;
        }
        if held != "" {
            site-error(
                v,
                s,
                "{n} is moved while {held} is another name for it (or holds it)",
                moved,
                "{held} could still use it after the move",
                "",
            );
            return;
        }
    }

    // what a call's callee does with its parameter i: a func's (as read so far), the runtime's
    // (by its C name), or (a func value, something not known) everything
    effect: func(callee: string, i: s64, v: FlowView) -> ParamEffect {
        if v.all.has(callee) {
            let es = v.all[callee];
            if i < es.len() { return es[i]; }
            return { writes: false, keeps: false, gives: false, };
        }
        if v.externs.has(callee) { return extern-effect(v.externs[callee], i); }
        { writes: true, keeps: true, gives: true, }
    }

    // what an extern does with argument i (flow.yel derives it from its declaration)
    extern-effect: func(e: RuntimeEffect, i: s64) -> ParamEffect {
        { writes: flow.writes(e, i), keeps: flow.keeps(e, i) || flow.kept-in(e, i).len() > 0, gives: flow.gives(e, i), }
    }

    // whether a (checked) type's values cannot be written: numbers, bools, chars, strings, their
    // literal types and ranges, unions of them, and options, results and tuples of them (another
    // type, or one not known: they may be)
    settled-immutable: func(t: Type) -> bool {
        match resolve(t) {
            num(n) => true,
            bool-type => true,
            char-type => true,
            string-type => true,
            singleton(s) => true,
            range-type(x) => true,
            unit-type => true,
            distinct-type(x) => settled-immutable(x.base),
            // held by value: one of these values (an option<u8> read from a stream) is no other
            // value's
            union-type(xs) => !any-child(t, { x -> !settled-immutable(x) }),
            option-type(x) => !any-child(t, { y -> !settled-immutable(y) }),
            result-type(r) => !any-child(t, { y -> !settled-immutable(y) }),
            tuple-type(xs) => !any-child(t, { y -> !settled-immutable(y) }),
            _ => false,
        }
    }

    // the locals made from local i: it, and each assigned a value made of one of them (a copy, a
    // value built of it, a part of it; a call's result where its callee gives that argument back)
    derived: func(v: FlowView, f: IrFunc, i: s64) -> list<s64> {
        let out = [i,];
        let assigns: list<AssignNode> = [];
        for n in flatten(f.body) {
            match n.kind {
                assign(x) => assigns.push(x),
                _ => {}
            }
        }
        loop {
            let grew = false;
            for x in assigns {
                if !contains(out, x.dest) && made-of(v, x.value, out) {
                    out.push(x.dest);
                    grew = true;
                }
            }
            if !grew { return out; }
        }
    }

    // whether a value is made of one of the locals (a call's: an argument it gives back)
    made-of: func(v: FlowView, n: Node, locals: list<s64>) -> bool {
        match n.kind {
            call(c) => {
                let cf = opt.call-flow(v.facts, c);
                for i in 0..c.args.len() {
                    if cf.gives[i] && reads-any(c.args[i], locals) { return true; }
                }
                false
            }
            _ => reads-any(n, locals),
        }
    }

    reads-any: func(n: Node, locals: list<s64>) -> bool {
        let read: list<s64> = [];
        reads(n, read);
        for r in read {
            if contains(locals, r) { return true; }
        }
        false
    }

    // what a local's facts start as: its binding, where it is looked at from (at), and whether a
    // pattern's part of a new value counts as new
    facts-for: func(f: Func, x: Mark, at: Span, parts-fresh: bool) -> LocalFacts {
        {
            binding: x,
            bindings: f.bindings,
            at: at,
            sources-fresh: true,
            bound: false,
            depth: 0,
            made-depth: -1,
            at-depth: -1,
            used-after: none,
            frozen-as: none,
            parts-fresh: parts-fresh,
        }
    }

    // a binding's name (a parameter's, or any name read as it)
    binding-name: func(f: Func, m: Mark) -> string {
        for i in 0..f.params.len() {
            if f.marks[i] == m { return f.params[i]; }
        }
        for e in f.bindings.exprs.keys() {
            if f.bindings.exprs[e] == m {
                match e.kind {
                    name(n) => { return name-text(n); }
                    _ => {}
                }
            }
        }
        "it"
    }

    // ================================================================ a local made readonly

    local-facts-block: func(lf: LocalFacts, b: Block, v: FlowView) {
        for i in 0..b.stmts.len() {
            let sp = b.spans[i];
            match b.stmts[i] {
                let-stmt(x) => {
                    local-facts(lf, x.value, v);
                    if x.value.span.line == lf.at.line
                        && x.value.span.col == lf.at.col { lf.frozen-as = some(x.mark); }
                    if x.mark == lf.binding {
                        lf.made-depth = lf.depth;
                        if !new-value(x.value, v) { lf.sources-fresh = false; }
                    }
                }
                let-pattern(x) => {
                    local-facts(lf, x.value, v);
                    if walk.pattern-binds(x.pattern, lf.binding) {
                        if !lf.parts-fresh || !new-value(x.value, v) {
                            lf.sources-fresh = false;
                        }
                        lf.made-depth = lf.depth;
                    }
                }
                return-stmt(e) => local-facts(lf, e, v),
                for-stmt(x) => {
                    local-facts(lf, x.start, v);
                    match x.stop {
                        some(e) => local-facts(lf, e, v),
                        none => {}
                    }
                    if x.mark == lf.binding {
                        lf.sources-fresh = false;
                        lf.made-depth = lf.depth + 1;
                    }
                    lf.depth += 1;
                    local-facts-block(lf, x.body, v);
                    lf.depth -= 1;
                }
                loop-stmt(x) => {
                    lf.depth += 1;
                    local-facts-block(lf, x.body, v);
                    lf.depth -= 1;
                }
                assign(x) => {
                    local-facts(lf, x.value, v);
                    if lf.bindings.assigns.has(x) && lf.bindings.assigns[x] == lf.binding {
                        if !new-value(x.value, v) { lf.sources-fresh = false; }
                        mention(lf, sp);
                    }
                }
                assign-field(x) => {
                    local-facts(lf, x.target, v);
                    local-facts(lf, x.value, v);
                }
                expr-stmt(x) => local-facts(lf, x.value, v),
                break-stmt => {}
                continue-stmt => {}
            }
        }
    }

    local-facts: func(lf: LocalFacts, e: Expr, v: FlowView) {
        match e.kind {
            name(n) => {
                if lf.bindings.exprs.has(e) && lf.bindings.exprs[e] == lf.binding {
                    if e.span.line == lf.at.line
                        && e.span.col == lf.at.col { lf.at-depth = lf.depth; }
                    else { mention(lf, e.span); }
                }
            }
            closure(cl) => {
                lf.depth += 1;
                local-facts-block(lf, cl.body, v);
                lf.depth -= 1;
            }
            if-else(x) => {
                local-facts(lf, x.cond, v);
                local-facts-block(lf, x.then, v);
                match x.otherwise {
                    some(b) => local-facts-block(lf, b, v),
                    none => {}
                }
            }
            block(b) => local-facts-block(lf, b, v),
            match-expr(m) => {
                local-facts(lf, m.value, v);
                for arm in m.arms {
                    if walk.pattern-binds(arm.pattern, lf.binding) {
                        lf.sources-fresh = false;
                        lf.made-depth = lf.depth;
                    }
                    match arm.guard {
                        some(g) => local-facts(lf, g, v),
                        none => {}
                    }
                    local-facts(lf, arm.body, v);
                }
            }
            _ => {
                let names: list<Expr> = [];
                sub-exprs(e, names);
                for x in names { local-facts(lf, x, v); }
            }
        }
    }

    // a use of the local: after where it is made readonly, an error
    mention: func(lf: LocalFacts, sp: Span) {
        let after = sp.line > lf.at.line || sp.line == lf.at.line && sp.col > lf.at.col;
        if after {
            match lf.used-after {
                none => { lf.used-after = some(sp); }
                some(x) => {}
            }
        }
    }

    // a value no other name has: a literal, or a call of a func (or the runtime's) that makes one
    new-value: func(e: Expr, v: FlowView) -> bool {
        match e.kind {
            list-lit(xs) => true,
            record-lit(fs) => true,
            call(x) => is-fresh(x.name, v),
            method(m) => is-fresh(m.name, v),
            _ => settled-immutable(e.ty),
        }
    }

    // an expression's direct parts that are expressions (blocks aside)
    sub-exprs: func(e: Expr, out: list<Expr>) {
        match e.kind {
            field(f) => out.push(f.target),
            call(x) => { for a in x.args { out.push(a); } }
            method(m) => {
                out.push(m.target);
                for a in m.args { out.push(a); }
            }
            apply(x) => {
                out.push(x.callee);
                for a in x.args { out.push(a); }
            }
            record-lit(fields) => { for f in fields { out.push(f.value); } }
            list-lit(xs) => { for x in xs { out.push(x); } }
            tuple-lit(xs) => { for x in xs { out.push(x); } }
            interp(xs) => { for x in xs { out.push(x); } }
            binary(b) => {
                out.push(b.left);
                out.push(b.right);
            }
            unary(u) => out.push(u.value),
            cast(x) => out.push(x.value),
            widen(x) => out.push(x.value),
            is-test(x) => out.push(x.value),
            try-as(x) => out.push(x.value),
            start-expr(x) => out.push(x),
            yield-expr(x) => out.push(x),
            wait-expr(w) => { for v in w.values { out.push(v); } }
            _ => {}
        }
    }

}
