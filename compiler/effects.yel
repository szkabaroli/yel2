// The readonly and move checks. The checker lets a readonly value be given a parameter that is
// not readonly, and a value a readonly parameter, and records where (EffectSite), and where a
// stream or a future is moved to a WIT func; once the program's flow is known (escape.yel, on the
// IR, after codegen: what each func writes, keeps and gives back, which locals may hold one value),
// each such place is checked here: a readonly value only to a parameter its func never writes or
// keeps (nor gives back, unless the func is generic and its result's type says readonly again), a
// value only to a readonly parameter its func never keeps nor gives back (else the readonly name
// would see it change), a value made readonly only where no other name may write it, a moved one
// never used again. Where each local is used, and from what it is made, is read here from the
// syntax tree, by binding (LocalFacts); who else may hold it, from the flow. Nothing of this is in
// the C: it is all known when compiling.

// where readonly and not meet: a readonly value given a parameter that is not (read), a value given
// a readonly parameter (borrow), or a value where readonly is wanted otherwise (freeze: a typed
// let, a result, a field); or a local holding a stream or a future given a WIT func (move: its end
// leaves the component, so the local has nothing left)
type site-kind = "read" | "borrow" | "freeze" | "move";

// such a place: the call (callee, the parameter's index) for read and borrow, and the value given:
// a local (local) or a call's result (source), else neither
resource EffectSite {
    file: string,
    span: Span,
    in-func: string,
    kind: site-kind,
    callee: string,
    index: s64,
    local: string,
    // the local's binding (none for a value that is not a local's)
    binding: option<Mark>,
    source: string,
    // a started call's (start f(…): the task holds its arguments while it runs, past the call)
    started: bool,
    // whether the call's result, its type arguments given, is readonly (a generic func gives back
    // a readonly argument as readonly only then)
    result-readonly: bool,
    // whether what the parameter holds of the func's type parameters is readonly (its type
    // arguments given): a generic func whose result is new gives back only parts of it, readonly
    items-readonly: bool,
}

// what a local made readonly is given, and where it is: whether everything given it is new,
// how many loops deep it is made and made readonly (the walk's depth now), and a use after
resource LocalFacts {
    // the local (its binding), and its func's bindings (which names are it)
    binding: Mark,
    bindings: Bindings,
    at: Span,
    sources-fresh: bool,
    bound: bool,
    depth: s64,
    made-depth: s64,
    at-depth: s64,
    used-after: option<Span>,
    // the name it is made readonly as (let frozen: T & readonly = x: a name that cannot write it)
    frozen-as: option<Mark>,
    // whether a pattern's part of a new value is new (let (s, w) = stream-pair(1): a stream's ends
    // are its own; not for readonly, where a func's new value may hold one list twice)
    parts-fresh: bool,
}

// what a func does with one parameter
record ParamEffect { writes: bool, keeps: bool, gives: bool, }

// an IR local a binding is (its func's C name, its index): a generic func's binding is one in
// each instance
record IrLocalRef { func: Name, local: s64, }

// the program's flow as the checks read it: what each func (by key: its instances together) does
// with each parameter and whether its result is new, what each extern does (by name), and the IR
// locals each binding is
resource FlowView {
    // the compile's context: its sources, the errors found so far, what was asked for
    context: Context,
    facts: Facts,
    all: map<string, list<ParamEffect>>,
    // what each func (by key) gives the func values it is given (Lend), each parameter's
    lent: map<string, list<list<Lend>>>,
    fresh: map<string, bool>,
    // whether what each func (by key) gives back is new itself (escape.yel's new-top)
    new-top: map<string, bool>,
    externs: map<string, RuntimeEffect>,
    locals: map<Mark, list<IrLocalRef>>,
}

module effects {
    // each site checked against the program's flow
    check-sites: func(decls: list<Decl>, sites: list<EffectSite>, facts: Facts, context: Context) {
        if sites.len() == 0 { return; }
        let funcs: map<string, Func> = map.new();
        let externs: map<string, RuntimeEffect> = map.new();
        for declaration in decls {
            match declaration {
                func-decl(declared) => funcs.set(declared.name, declared),
                extern-decl(declared) => externs.set(declared.name, flow.derive(declared)),
                _ => {}
            }
        }
        let viewing = view(facts, externs, context);
        for site in sites { check-site(site, funcs, viewing); }
    }

    // the flow by func key and by binding
    view: func(facts: Facts, externs: map<string, RuntimeEffect>, context: Context) -> FlowView {
        let viewing: FlowView = {
            context: context,
            facts: facts,
            all: map.new(),
            lent: map.new(),
            fresh: map.new(),
            new-top: map.new(),
            externs: externs,
            locals: map.new(),
        };
        for key in facts.funcs.keys() {
            let function = facts.funcs[key];
            for index in 0..function.locals.len() {
                match function.locals[index].binding {
                    some(mark) => {
                        if !viewing.locals.has(mark) { viewing.locals.set(mark, []); }
                        viewing.locals[mark].push({ func: key, local: index, });
                    }
                    none => {}
                }
            }
            if !function.closure && facts.param-escapes.has(key) {
                let keeps = facts.param-escapes[key];
                let kept-in = facts.param-kept-in[key];
                let gives = facts.param-gives[key];
                let ws = facts.param-writes[key];
                let mine: list<ParamEffect> = [];
                // kept in another argument is kept, for readonly's sake (that one may write it)
                for index in 0..keeps.len() { mine.push({ writes: ws[index], keeps: keeps[index] || kept-in[index].len() > 0, gives: gives[index], }); }
                if viewing.all.has(function.key) {
                    let had = viewing.all[function.key];
                    for index in 0..had.len() {
                        if index < mine.len() {
                            had[index] = {
                                writes: had[index].writes || mine[index].writes,
                                keeps: had[index].keeps || mine[index].keeps,
                                gives: had[index].gives || mine[index].gives,
                            };
                        }
                    }
                } else {
                    viewing.all.set(function.key, mine);
                }
                let lent = facts.param-lent[key];
                if viewing.lent.has(function.key) {
                    let had = viewing.lent[function.key];
                    for index in 0..had.len() {
                        if index < lent.len() {
                            for borrowed in lent[index] {
                                if !had[index].contains(borrowed) { had[index].push(borrowed); }
                            }
                        }
                    }
                } else {
                    viewing.lent.set(function.key, lent.map({ ls -> ls.slice(0, ls.len()) }));
                }
                let top = facts.new-top[key];
                viewing.new-top.set(function.key, if viewing.new-top.has(function.key) { viewing.new-top[function.key] && top } else { top });
                let fresh = facts.fresh-result[key];
                viewing.fresh.set(function.key, if viewing.fresh.has(function.key) { viewing.fresh[function.key] && fresh } else { fresh });
            }
        }
        viewing
    }

    check-site: func(site: EffectSite, funcs: map<string, Func>, viewing: FlowView) {
        let callee = base-name(site.callee);
        if site.kind == "move" {
            if funcs.has(site.in-func) {
                check-move(site, funcs[site.in-func], callee, viewing);
            }
            return;
        }
        if site.kind == "read" {
            let parameter-effect = with-lent(effect(site.callee, site.index, viewing), site, funcs, viewing);
            let generic = funcs.has(site.callee) && funcs[site.callee].type-params.len() > 0
                || viewing.externs.has(site.callee);
            let what = "argument {site.index + 1} of {callee} is readonly";
            if parameter-effect.writes {
                site-error(viewing, site, "{what}, and {callee} writes it", "readonly", "", "give it a value that is not readonly (a copy), or make {callee} only read it");
                return;
            }
            if parameter-effect.keeps {
                site-error(viewing, site, "{what}, and {callee} keeps it where it may be written", "readonly", "", "");
                return;
            }
            // a generic func gives back what it is given: readonly where its result's type is
            // (or, its result new, gives back only parts of it, which its type arguments say are
            // readonly: filter's items)
            let parts = site.items-readonly && viewing.new-top.get-or(site.callee, false);
            if parameter-effect.gives && !(generic && (site.result-readonly || parts)) {
                site-error(viewing, site, "{what}, and {callee} gives it back as a value that may be written", "readonly", "", "");
                return;
            }
            return;
        }
        if site.kind == "borrow" {
            let parameter-effect = effect(site.callee, site.index, viewing);
            // lent for the call: fine where the func keeps nothing; else it must be a value no
            // other name has (then given away). A started call's task holds it while it runs
            if !parameter-effect.keeps && !parameter-effect.gives && !site.started { return; }
        }
        let why = unique-why(site, funcs, viewing);
        if why == "" { return; }
        // a use after it is made readonly: shown where it is
        let diagnostic = diagnostics.error(
            site.span,
            if site.kind == "borrow" && site.started {
                "argument {site.index + 1} of {callee} is wanted readonly, and the started task holds it while it runs: {why}"
            } else if site.kind == "borrow" {
                "argument {site.index + 1} of {callee} is wanted readonly, and {callee} keeps it or gives it back: {why}"
            } else {
                "readonly is wanted here: {why}"
            },
            "",
        );
        match site.binding {
            some(mark) => {
                if funcs.has(site.in-func) {
                    match used-after(funcs[site.in-func], mark, site.span, viewing) {
                        some(sp) => diagnostics.also(diagnostic, sp, "used here, after it is made readonly"),
                        none => {}
                    }
                }
            }
            none => {}
        }
        diagnostics.report(viewing.context, diagnostic);
    }

    // an error at a site, kept (its caller goes on to the next site: one error for each): its
    // label, a note and help ("" for none)
    site-error: func(viewing: FlowView, site: EffectSite, message: string, label: string, note: string, help: string) {
        let diagnostic = diagnostics.error(site.span, message, label);
        if note != "" { diagnostics.note(diagnostic, note); }
        if help != "" { diagnostics.help(diagnostic, help); }
        diagnostics.report(viewing.context, diagnostic);
    }

    // where a local is used after a place (at), if it is
    used-after: func(function: Func, mark: Mark, at: Span, viewing: FlowView) -> option<Span> {
        let facts = facts-for(function, mark, at, false);
        local-facts-block(facts, function.body, viewing);
        facts.used-after
    }

    // why a site's value may have another name that writes it ("" when it has none: a value made
    // by a func that gives back such values, or a local made so and not used after)
    unique-why: func(site: EffectSite, funcs: map<string, Func>, viewing: FlowView) -> string {
        if site.source != "" {
            if is-fresh(site.source, viewing) { return ""; }
            return "{base-name(site.source)} may give back a value another name has (make it in the func, or give back one no one else has)";
        }
        match site.binding {
            some(mark) => {
                if funcs.has(site.in-func) {
                    return local-why(funcs[site.in-func], mark, site.span, site.kind, viewing);
                }
            }
            none => {}
        }
        "the value may have another name that writes it"
    }

    // whether a call's result is a value no other name has
    is-fresh: func(callee: string, viewing: FlowView) -> bool {
        if viewing.fresh.has(callee) { return viewing.fresh[callee]; }
        // an extern's: new values, but for those that give back part of an argument
        if viewing.externs.has(callee) { return flow.is-new(viewing.externs[callee]); }
        false
    }

    // why a func's local x may have another name that writes it where it is made readonly (at):
    // "" when everything given it is new, it is never kept nor given another name, and it is not
    // used after (nor made readonly in a loop it was made outside of)
    local-why: func(function: Func, mark: Mark, at: Span, kind: site-kind, viewing: FlowView) -> string {
        let name = binding-name(function, mark);
        if contains(function.marks, mark) || is-param(viewing, mark) { return "{name} is a parameter: its caller may have it too"; }
        let facts = facts-for(function, mark, at, false);
        local-facts-block(facts, function.body, viewing);
        if !facts.sources-fresh {
            return "{name} is given a value another name may have (only a literal, or a func's new value, can be made readonly)";
        }
        if facts.at-depth > facts.made-depth && facts.made-depth >= 0 {
            return "{name} is made outside the loop it is made readonly in (the next turn would see it)";
        }
        match facts.used-after {
            some(_) => {
                return "{name} is used again after (once readonly, use the readonly name)";
            }
            none => {}
        }
        // kept, or given another name: as the flow says
        // a borrow's call keeps it in its readonly parameter: given away there, not kept
        let held = held-by(viewing, mark, facts.frozen-as, if kind == "borrow" { some(at) } else { none });
        if held == "kept" { return "{name} is kept where it may be written (stored, or captured by a closure)"; }
        if held != "" { return "{held} is another name for {name} (or part of it), and may write it"; }
        ""
    }

    // whether a binding is a parameter (a closure's too: the IR's lifted func's)
    is-param: func(viewing: FlowView, mark: Mark) -> bool {
        if !viewing.locals.has(mark) { return false; }
        for reference in viewing.locals[mark] {
            let function = viewing.facts.funcs[reference.func];
            for parameter in function.params {
                if parameter == reference.local { return true; }
            }
        }
        false
    }

    // what the flow says of a binding's value: "kept" (it escapes: stored, kept by a func it is
    // given, captured), another binding's name that may hold it (but but's: the name it is made
    // readonly as), or "" for neither; what it is given as at given (a readonly parameter, which
    // keeps it given away) is not its keeping
    held-by: func(viewing: FlowView, mark: Mark, but: option<Mark>, given: option<Span>) -> string {
        if mark.captured { return "kept"; }
        if !viewing.locals.has(mark) { return ""; }
        for reference in viewing.locals[mark] {
            if viewing.facts.groups.has(reference.func) {
                let function = viewing.facts.funcs[reference.func];
                let made = derived(viewing, function, reference.local);
                // kept: it, or a value made of it, let escape (a spawned task's frame among them)
                for node in flatten(function.body) {
                    for escaping in opt.escaping(viewing.facts, node) {
                        if reads-any(escaping, made) && !same-place(escaping.span, given) { return "kept"; }
                    }
                }
                // another name: a binding whose value is made from it (through any chain of
                // assignments: a copy, a call given it, a value built of it) and may hold one that is
                // written
                for producer in made {
                    match function.locals[producer].binding {
                        some(produced) => {
                            let other = produced != mark && match but {
                                some(excluded) => produced != excluded,
                                none => true,
                            };
                            // a readonly binding never writes it (what it holds is read only)
                            if other && opt.local-mutable(viewing.facts, function, producer) && !is-readonly(resolve(produced.ty)) {
                                return function.locals[producer].name;
                            }
                        }
                        none => {}
                    }
                }
            }
        }
        ""
    }

    // whether a span is where one is (none: nowhere)
    same-place: func(sp: Span, at: option<Span>) -> bool {
        match at {
            some(place) => sp.source == place.source && sp.line == place.line && sp.col == place.col,
            none => false,
        }
    }

    // a local moved where it is given (s.span) may not be used again: not after, not in the next
    // turn of a loop it is made outside of, not through another name
    check-move: func(site: EffectSite, function: Func, callee: string, viewing: FlowView) {
        let name = site.local;
        let mark = match site.binding {
            some(bound) => bound,
            none => { return; }
        };
        let moved = "moved here: {callee} takes its end (it leaves the component)";
        let facts = facts-for(function, mark, site.span, true);
        if contains(function.marks, mark) { facts.made-depth = 0; }
        local-facts-block(facts, function.body, viewing);
        if !facts.sources-fresh {
            site-error(
                viewing,
                site,
                "{name} is moved, and another name may hold it",
                moved,
                "{name} is given a value made elsewhere (a name's, a field's, or part of one)",
                "move a stream or a future made here: a func's new value, or a part of one (let (s, w) = stream-pair(8))",
            );
            return;
        }
        match facts.used-after {
            some(sp) => {
                let diagnostic = diagnostics.error(sp, "{name} is used after it is moved", "used here, after the move");
                diagnostics.also(diagnostic, site.span, moved);
                diagnostics.help(diagnostic, "a stream or a future given a WIT func is the callee's: read what you need from it first");
                diagnostics.report(viewing.context, diagnostic);
                return;
            }
            none => {}
        }
        if facts.at-depth > facts.made-depth && facts.made-depth >= 0 {
            site-error(
                viewing,
                site,
                "{name} is moved in a loop it is made outside of",
                "moved here, in every turn",
                "the next turn would move it again",
                "make it in the loop, or break out of the loop once it is moved",
            );
            return;
        }
        let held = held-by(viewing, mark, none, none);
        if held == "kept" {
            site-error(
                viewing,
                site,
                "{name} is moved, and it is kept elsewhere (stored, or captured by a closure)",
                moved,
                "what keeps it could still use it after the move",
                "",
            );
            return;
        }
        if held != "" {
            site-error(
                viewing,
                site,
                "{name} is moved while {held} is another name for it (or holds it)",
                moved,
                "{held} could still use it after the move",
                "",
            );
            return;
        }
    }

    // what a call's callee does with its parameter i: a func's (as read so far), the runtime's
    // (by its C name), or (a func value, something not known) everything
    effect: func(callee: string, index: s64, viewing: FlowView) -> ParamEffect {
        if viewing.all.has(callee) {
            let es = viewing.all[callee];
            if index < es.len() { return es[index]; }
            return { writes: false, keeps: false, gives: false, };
        }
        if viewing.externs.has(callee) { return extern-effect(viewing.externs[callee], index); }
        { writes: true, keeps: true, gives: true, }
    }

    // what a call does with an argument, with what the func values it is given do with it (the
    // closures given at the site's call, found in the IR by the argument's place: one not found,
    // or a func value not made there, may write it and keep it)
    with-lent: func(parameter-effect: ParamEffect, site: EffectSite, funcs: map<string, Func>, viewing: FlowView) -> ParamEffect {
        if !viewing.lent.has(site.callee) || site.index >= viewing.lent[site.callee].len() { return parameter-effect; }
        let lent = viewing.lent[site.callee][site.index];
        if lent.len() == 0 { return parameter-effect; }
        for key in viewing.facts.funcs.keys() {
            let function = viewing.facts.funcs[key];
            for node in flatten(function.body) {
                match site-call(node, site, viewing) {
                    some(found) => {
                        let writes = parameter-effect.writes;
                        let keeps = parameter-effect.keeps;
                        for borrowed in lent {
                            // a closure whose parameter is readonly: what it does with it is
                            // checked in it (it neither writes it nor keeps it where it may be)
                            if borrowed.param < found.args.len() && takes-readonly(viewing, funcs, site, function.body, found.args[borrowed.param], borrowed.position) { continue; }
                            let use = if borrowed.param < found.args.len() {
                                opt.lent-effect(viewing.facts, function.body, found.args[borrowed.param], borrowed.position, false)
                            } else {
                                { writes: true, keeps: true, }
                            };
                            writes = writes || use.writes;
                            keeps = keeps || use.keeps;
                        }
                        return { writes: writes, keeps: keeps, gives: parameter-effect.gives, };
                    }
                    none => {}
                }
            }
        }
        { writes: true, keeps: true, gives: parameter-effect.gives, }
    }

    // whether a func value is a closure made here whose parameter at a position is readonly (as
    // the checker typed the literal, in the site's func: the IR's types are the C's)
    takes-readonly: func(viewing: FlowView, funcs: map<string, Func>, site: EffectSite, body: list<Node>, func-value: Node, position: s64) -> bool {
        if !funcs.has(site.in-func) { return false; }
        let at = match opt.closure-made(viewing.facts, body, func-value) {
            some(referred) => viewing.facts.funcs[referred].span,
            none => { return false; }
        };
        for expression in walk.exprs(funcs[site.in-func].body, true) {
            if walk.is-closure(expression) && same-place(expression.span, some(at)) {
                match resolve(expression.ty) {
                    func-type(signature) => { return position < signature.params.len() && is-readonly(signature.params[position]); }
                    _ => { return false; }
                }
            }
        }
        false
    }

    // the call of a site's callee in a node (its operands too) given the site's value where it is
    site-call: func(node: Node, site: EffectSite, viewing: FlowView) -> option<CallNode> {
        match node.kind {
            call(called) => {
                // (a generic func's instance: its key is the func's)
                let callee = called.key == site.callee || viewing.facts.funcs.has(called.name) && viewing.facts.funcs[called.name].key == site.callee;
                if callee && site.index < called.args.len()
                    && same-place(called.args[site.index].span, some(site.span)) { return some(called); }
            }
            _ => {}
        }
        for index in 0..operand-count(node) {
            match site-call(operand(node, index), site, viewing) {
                some(found) => { return some(found); }
                none => {}
            }
        }
        none
    }

    // what an extern does with argument i (flow.yel derives it from its declaration)
    extern-effect: func(runtime-effect: RuntimeEffect, index: s64) -> ParamEffect {
        { writes: flow.writes(runtime-effect, index), keeps: flow.keeps(runtime-effect, index) || flow.kept-in(runtime-effect, index).len() > 0, gives: flow.gives(runtime-effect, index), }
    }

    // whether a (checked) type's values cannot be written: numbers, bools, chars, strings, their
    // literal types and ranges, unions of them, and options, results and tuples of them (another
    // type, or one not known: they may be)
    settled-immutable: func(given: Type) -> bool {
        match resolve(given) {
            num(_) => true,
            bool-type => true,
            char-type => true,
            string-type => true,
            singleton(_) => true,
            range-type(_) => true,
            unit-type => true,
            distinct-type(distinct) => settled-immutable(distinct.base),
            // held by value: one of these values (an option<u8> read from a stream) is no other
            // value's
            union-type(_) => !any-child(given, { item -> !settled-immutable(item) }),
            option-type(_) => !any-child(given, { item -> !settled-immutable(item) }),
            result-type(_) => !any-child(given, { item -> !settled-immutable(item) }),
            tuple-type(_) => !any-child(given, { item -> !settled-immutable(item) }),
            _ => false,
        }
    }

    // the locals made from local i: it, and each assigned a value made of one of them (a copy, a
    // value built of it, a part of it; a call's result where its callee gives that argument back)
    derived: func(viewing: FlowView, function: IrFunc, local-index: s64) -> list<s64> {
        let out = [local-index,];
        let assigns: list<AssignNode> = [];
        for node in flatten(function.body) {
            match node.kind {
                assign(assigned) => assigns.push(assigned),
                _ => {}
            }
        }
        loop {
            let grew = false;
            for assigned in assigns {
                if !contains(out, assigned.dest) && made-of(viewing, assigned.value, out) {
                    out.push(assigned.dest);
                    grew = true;
                }
            }
            if !grew { return out; }
        }
    }

    // whether a value is made of one of the locals (a call's: an argument it gives back)
    made-of: func(viewing: FlowView, node: Node, locals: list<s64>) -> bool {
        match node.kind {
            call(called) => {
                let cf = opt.call-flow(viewing.facts, called);
                for index in 0..called.args.len() {
                    if cf.gives[index] && reads-any(called.args[index], locals) { return true; }
                }
                false
            }
            _ => reads-any(node, locals),
        }
    }

    reads-any: func(node: Node, locals: list<s64>) -> bool {
        let read: list<s64> = [];
        reads(node, read);
        for local-index in read {
            if contains(locals, local-index) { return true; }
        }
        false
    }

    // what a local's facts start as: its binding, where it is looked at from (at), and whether a
    // pattern's part of a new value counts as new
    facts-for: func(function: Func, mark: Mark, at: Span, parts-fresh: bool) -> LocalFacts {
        {
            binding: mark,
            bindings: function.bindings,
            at: at,
            sources-fresh: true,
            bound: false,
            depth: 0,
            made-depth: -1,
            at-depth: -1,
            used-after: none,
            frozen-as: none,
            parts-fresh: parts-fresh,
        }
    }

    // a binding's name (a parameter's, or any name read as it)
    binding-name: func(function: Func, mark: Mark) -> string {
        for index in 0..function.params.len() {
            if function.marks[index] == mark { return function.params[index]; }
        }
        for expression in function.bindings.exprs.keys() {
            if function.bindings.exprs[expression] == mark {
                match expression.kind {
                    name(written) => { return name-text(written); }
                    _ => {}
                }
            }
        }
        "it"
    }

    // ================================================================ a local made readonly

    local-facts-block: func(lf: LocalFacts, block: Block, viewing: FlowView) {
        for index in 0..block.stmts.len() {
            let sp = block.spans[index];
            match block.stmts[index] {
                let-stmt(declared) => {
                    local-facts(lf, declared.value, viewing);
                    if declared.value.span.line == lf.at.line
                        && declared.value.span.col == lf.at.col { lf.frozen-as = some(declared.mark); }
                    if declared.mark == lf.binding {
                        lf.made-depth = lf.depth;
                        if !new-value(declared.value, viewing) { lf.sources-fresh = false; }
                    }
                }
                let-pattern(destructured) => {
                    local-facts(lf, destructured.value, viewing);
                    if walk.pattern-binds(destructured.pattern, lf.binding) {
                        if !lf.parts-fresh || !new-value(destructured.value, viewing) {
                            lf.sources-fresh = false;
                        }
                        lf.made-depth = lf.depth;
                    }
                }
                return-stmt(returned) => local-facts(lf, returned, viewing),
                for-stmt(iteration) => {
                    local-facts(lf, iteration.start, viewing);
                    match iteration.stop {
                        some(stop) => local-facts(lf, stop, viewing),
                        none => {}
                    }
                    if iteration.mark == lf.binding {
                        lf.sources-fresh = false;
                        lf.made-depth = lf.depth + 1;
                    }
                    lf.depth += 1;
                    local-facts-block(lf, iteration.body, viewing);
                    lf.depth -= 1;
                }
                loop-stmt(repeating) => {
                    lf.depth += 1;
                    local-facts-block(lf, repeating.body, viewing);
                    lf.depth -= 1;
                }
                assign(assigned) => {
                    local-facts(lf, assigned.value, viewing);
                    if lf.bindings.assigns.has(assigned) && lf.bindings.assigns[assigned] == lf.binding {
                        if !new-value(assigned.value, viewing) { lf.sources-fresh = false; }
                        mention(lf, sp);
                    }
                }
                assign-field(assigned) => {
                    local-facts(lf, assigned.target, viewing);
                    local-facts(lf, assigned.value, viewing);
                }
                expr-stmt(evaluated) => local-facts(lf, evaluated.value, viewing),
                break-stmt => {}
                continue-stmt => {}
            }
        }
    }

    local-facts: func(lf: LocalFacts, expression: Expr, viewing: FlowView) {
        match expression.kind {
            name(_) => {
                if lf.bindings.exprs.has(expression) && lf.bindings.exprs[expression] == lf.binding {
                    if expression.span.line == lf.at.line
                        && expression.span.col == lf.at.col { lf.at-depth = lf.depth; }
                    else { mention(lf, expression.span); }
                }
            }
            closure(cl) => {
                lf.depth += 1;
                local-facts-block(lf, cl.body, viewing);
                lf.depth -= 1;
            }
            if-else(conditional) => {
                local-facts(lf, conditional.cond, viewing);
                local-facts-block(lf, conditional.then, viewing);
                match conditional.otherwise {
                    some(otherwise) => local-facts-block(lf, otherwise, viewing),
                    none => {}
                }
            }
            block(inner) => local-facts-block(lf, inner, viewing),
            match-expr(matching) => {
                local-facts(lf, matching.value, viewing);
                for arm in matching.arms {
                    if walk.pattern-binds(arm.pattern, lf.binding) {
                        lf.sources-fresh = false;
                        lf.made-depth = lf.depth;
                    }
                    match arm.guard {
                        some(guard) => local-facts(lf, guard, viewing),
                        none => {}
                    }
                    local-facts(lf, arm.body, viewing);
                }
            }
            _ => {
                let names: list<Expr> = [];
                sub-exprs(expression, names);
                for part in names { local-facts(lf, part, viewing); }
            }
        }
    }

    // a use of the local: after where it is made readonly, an error
    mention: func(lf: LocalFacts, sp: Span) {
        let after = sp.line > lf.at.line || sp.line == lf.at.line && sp.col > lf.at.col;
        if after {
            match lf.used-after {
                none => { lf.used-after = some(sp); }
                some(_) => {}
            }
        }
    }

    // a value no other name has: a literal, or a call of a func (or the runtime's) that makes one
    new-value: func(expression: Expr, viewing: FlowView) -> bool {
        match expression.kind {
            list-lit(_) => true,
            record-lit(_) => true,
            call(called) => is-fresh(called.name, viewing),
            method(invoked) => is-fresh(invoked.name, viewing),
            _ => settled-immutable(expression.ty),
        }
    }

    // an expression's direct parts that are expressions (blocks aside)
    sub-exprs: func(expression: Expr, out: list<Expr>) {
        match expression.kind {
            field(accessed) => out.push(accessed.target),
            call(called) => { for argument in called.args { out.push(argument); } }
            method(invoked) => {
                out.push(invoked.target);
                for argument in invoked.args { out.push(argument); }
            }
            apply(applied) => {
                out.push(applied.callee);
                for argument in applied.args { out.push(argument); }
            }
            record-lit(fields) => { for entry in fields { out.push(entry.value); } }
            list-lit(xs) => { for item in xs { out.push(item); } }
            tuple-lit(xs) => { for item in xs { out.push(item); } }
            interp(xs) => { for item in xs { out.push(item); } }
            binary(operation) => {
                out.push(operation.left);
                out.push(operation.right);
            }
            unary(operation) => out.push(operation.value),
            cast(converted) => out.push(converted.value),
            widen(widened) => out.push(widened.value),
            is-test(tested) => out.push(tested.value),
            try-as(attempted) => out.push(attempted.value),
            start-expr(started) => out.push(started),
            yield-expr(yielded) => out.push(yielded),
            wait-expr(waiting) => { for awaited in waiting.values { out.push(awaited); } }
            _ => {}
        }
    }

}
