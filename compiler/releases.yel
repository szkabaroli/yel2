// Host ends let go, on the IR. A stream or a future a func has from the host (a WIT func's result,
// or part of one) holds an end of the host's: read to its end, or waited for, the runtime lets it go
// itself, but one a func stops using before then would hold it for good (the host's writer waiting
// for a reader that is gone). So after the statement that last uses a local holding one, and before
// each way out until then (return, break, continue), its end is let go (yel_stream_release,
// yel_future_release: nothing for a stream or a future of yel's own); a writer is closed there (no
// one can write to it after: its reader, the host's or a task's, is told the stream is done).
//
// Only a binding's local (not one codegen made, nor a parameter, nor one a closure captures) that
// no one else has, as escape.yel's flow says of its group: not let escape (stored, kept by a func it
// is given, moved to a WIT func, given a started call), not given back, not holding a value made
// elsewhere (a parameter's, a field's, a result that is not new), no other binding in it holding
// the same end, and assigned once. A func only ever started owns its parameters too (the caller
// gives up what it gives a started call): one never assigned is let go as such a local is.
// Everything else is whoever has it's to let go (or the host's, once the component is done).

module gen {
    // every func's such locals, let go where they are last used
    // the program's flow (escape.yel), what both the releases and the readonly and move checks
    // read
    flow-facts: func(
        g: Gen,
        funcs: list<IrFunc>,
        pointer-types: map<Name, bool>,
        func-holders: map<Name, bool>,
        externs: map<string, RuntimeEffect>,
    ) -> Facts {
        let p: Facts = {
            funcs: map.new(),
            param-escapes: map.new(),
            param-kept-in: map.new(),
            param-gives: map.new(),
            param-writes: map.new(),
            param-changes: map.new(),
            fresh-result: map.new(),
            wit: wit-wrappers(g),
            externs: externs,
            pointer-types: pointer-types,
            observable-types: observable-types(g),
            func-holders: func-holders,
            groups: map.new(),
            callees: map.new(),
            flows: map.new(),
            mutable-locals: map.new(),
            env-escapes: map.new(),
        };
        for f in funcs { p.funcs.set(f.name, f); }
        opt.param-escapes(p, funcs);
        p
    }

    // the @(observable) resources, by name (what escape.yel's param-changes stops at)
    observable-types: func(g: Gen) -> map<Name, bool> {
        let found: map<Name, bool> = map.new();
        for r in g.symbols.records.keys() { if g.symbols.records[r].observable { found.set(r, true); } }
        found
    }

    release-ends: func(g: Gen, funcs: list<IrFunc>, p: Facts) {
        let given = given-over(g, funcs);
        for f in funcs {
            if p.groups.has(f.name) {
                let gr = p.groups[f.name];
                let start = intern("s" + f.c-name.substring(1, f.c-name.len()));
                let owned: list<bool> = if f.async && given.has(start) { given[start] } else { [] };
                for i in 0..f.locals.len() {
                    if owned-end(f, gr, i, owned) { release-local(g, f, gr, i); }
                }
            }
        }
    }

    // what each async func only ever started (start f(...): its frame given the executor) has
    // given over to it, by its start's C name: for each parameter, whether at every start its
    // argument is a local the caller has no more (that read its only one, and the only one of each
    // local it is a copy of, with no loop between where it is made and the start). Such a parameter
    // is the func's own; anything else it is given, its caller may still have (a value given two
    // tasks, or read after the start). A func waited for, called by the host or taken as a value
    // owns none of its parameters.
    given-over: func(g: Gen, funcs: list<IrFunc>) -> map<Name, list<bool>> {
        let calls: map<Name, s64> = map.new();
        let spawned: map<Name, s64> = map.new();
        let given: map<Name, list<bool>> = map.new();
        let taken: set<Name> = set.new();
        let seen: set<Name> = set.new();
        let all: list<IrFunc> = [];
        for f in funcs { all.push(f); }
        for h in g.helpers { all.push(h); }
        for f in all {
            if seen.has(f.name) { continue; }
            seen.add(f.name);
            let nodes = flatten(f.body);
            // how often each local is read
            let read-counts: list<s64> = [];
            for i in 0..f.locals.len() { read-counts.push(0); }
            for n in nodes {
                let read: list<s64> = [];
                reads(n, read);
                for i in read { read-counts[i] = read-counts[i] + 1; }
            }
            // the locals a start's frame is put in
            let frames: map<s64, Name> = map.new();
            starts-given(f, f.body, true, read-counts, frames, given);
            for n in nodes { started-calls(n, frames, calls, spawned, taken); }
        }
        let out: map<Name, list<bool>> = map.new();
        for name in spawned.keys() {
            if !taken.has(name) && calls.get-or(name, 0) == spawned[name] && given.has(name) {
                out.set(name, given[name]);
            }
        }
        out
    }

    // each start's call in body (a statement putting its frame in a local), and in the bodies it
    // holds: its frame's local kept, and whether each argument is given over (top: body is the
    // func's own, where its parameters are as if made)
    starts-given: func(
        f: IrFunc,
        body: list<Node>,
        top: bool,
        read-counts: list<s64>,
        frames: map<s64, Name>,
        given: map<Name, list<bool>>,
    ) {
        for n in body {
            match n.kind {
                assign(x) => {
                    match x.value.kind {
                        call(c) => {
                            if starts-at(c.c-name, 0, "s_") {
                                frames.set(x.dest, c.name);
                                let before = if given.has(c.name) { given[c.name] } else { [] };
                                let each: list<bool> = [];
                                for at in 0..c.args.len() {
                                    let own = match c.args[at].kind {
                                        local(j) => ((top && contains(f.params, j)) || made-in(body, j)) && read-once(f, j, read-counts),
                                        _ => false,
                                    };
                                    each.push(own && (before.len() == 0 || before[at]));
                                }
                                given.set(c.name, each);
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            for index in 0..nested-count(n) { starts-given(f, nested-body(n, index), false, read-counts, frames, given); }
        }
    }

    // whether body itself (not a body it holds) assigns j
    made-in: func(body: list<Node>, j: s64) -> bool {
        for n in body {
            match n.kind {
                assign(x) => { if x.dest == j { return true; } }
                _ => {}
            }
        }
        false
    }

    // whether j is read once, and each local it is a copy of (through any chain) once too: no
    // other name has its value after that read
    read-once: func(f: IrFunc, j: s64, read-counts: list<s64>) -> bool {
        if read-counts[j] != 1 { return false; }
        for n in flatten(f.body) {
            match n.kind {
                assign(x) => {
                    if x.dest == j {
                        match x.value.kind {
                            local(k) => { if k != j && !read-once(f, k, read-counts) { return false; } }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
        true
    }

    // the WIT funcs' wrappers by C name, and an async one's start
    wit-wrappers: func(g: Gen) -> set<Name> {
        let out: set<Name> = set.new();
        for k in g.wit-externs.keys() {
            let c = g.funcs[k].c-name;
            out.add(intern(c));
            out.add(intern("s" + c.substring(1, c.len())));
        }
        out
    }

    // n's calls of starts, its operands' too: each counted, and as spawned where it is a frame
    // given the executor; a func taken as a value
    started-calls: func(n: Node, frames: map<s64, Name>, calls: map<Name, s64>, spawned: map<Name, s64>, taken: set<Name>) {
        match n.kind {
            call(c) => {
                if starts-at(c.c-name, 0, "s_") { calls.set(c.name, calls.get-or(c.name, 0) + 1); }
                if c.c-name == "yel_async_spawn" && c.args.len() == 1 {
                    match c.args[0].kind {
                        local(i) => {
                            if frames.has(i) {
                                let name = frames[i];
                                spawned.set(name, spawned.get-or(name, 0) + 1);
                            }
                        }
                        _ => {}
                    }
                }
            }
            func-ref(r) => {
                taken.add(r.name);
                if starts-at(r.c-name, 0, "u_") { taken.add(intern("s" + r.c-name.substring(1, r.c-name.len()))); }
            }
            _ => {}
        }
        for index in 0..operand-count(n) { started-calls(operand(n, index), frames, calls, spawned, taken); }
    }

    // whether a local is a binding's (not one codegen made)
    is-binding: func(f: IrFunc, i: s64) -> bool {
        match f.locals[i].binding {
            some(m) => true,
            none => false,
        }
    }

    // what end a type holds: "stream", "writer", "future", or "" (none of its own)
    end-kind: func(t: Type) -> string {
        match resolve(t) {
            stream-type(x) => if x.writer { "writer" } else { "stream" },
            future-type(x) => "future",
            _ => "",
        }
    }

    // whether a local is a binding's end that no one else has (see the top)
    // (owned: of a func only ever started, whether each parameter is given over, its own: one
    // never assigned, its value the one it was given, whoever else made it)
    owned-end: func(f: IrFunc, gr: Groups, i: s64, owned: list<bool>) -> bool {
        let kind = end-kind(f.locals[i].ty);
        let at = f.params.index-of(i);
        let param = at >= 0;
        if kind == "" || (param && (at >= owned.len() || !owned[at])) { return false; }
        let m = match f.locals[i].binding {
            some(x) => x,
            none => { return false; }
        };
        if m.captured { return false; }
        let root = opt.find(gr, i);
        // nor one another value holds (a list it is pushed to may read it after)
        if gr.escapes[root] || gr.returned[root] || (gr.stale[root] && !param) || gr.moved[root] || gr.holding-params[root].len() > 0
            || opt.holder-roots(gr, root).len() > 1 {
            return false;
        }
        for j in 0..f.locals.len() {
            if j != i && opt.find(gr, j) == root && is-binding(f, j)
                && end-kind(f.locals[j].ty) == kind {
                return false;
            }
        }
        let assigned = 0;
        for n in flatten(f.body) {
            match n.kind {
                assign(x) => { if x.dest == i { assigned += 1; } }
                _ => {}
            }
        }
        assigned == if param { 0 } else { 1 }
    }

    // the locals whose reading is a use of it: itself, and codegen's made from it (a block's value,
    // a call's frame that holds it: a read begun, waited for later), through any chain of them
    users: func(f: IrFunc, gr: Groups, i: s64) -> list<s64> {
        let out = [i,];
        let assigns: list<AssignNode> = [];
        for n in flatten(f.body) {
            match n.kind {
                assign(x) => { if !is-binding(f, x.dest) { assigns.push(x); } }
                _ => {}
            }
        }
        loop {
            let grew = false;
            for x in assigns {
                if !contains(out, x.dest) && uses(x.value, out) {
                    out.push(x.dest);
                    grew = true;
                }
            }
            if !grew { return out; }
        }
    }

    // whether a statement (and what it holds) reads any of the locals
    uses: func(n: Node, locals: list<s64>) -> bool {
        for x in flatten([n,]) {
            let read: list<s64> = [];
            reads(x, read);
            for r in read {
                if contains(locals, r) { return true; }
            }
        }
        false
    }

    // the release after the local's last use, and before each way out until then
    release-local: func(g: Gen, f: IrFunc, gr: Groups, i: s64) {
        // (a parameter's: the func's, from its start)
        let body = if contains(f.params, i) { f.body } else {
            match defining-list(f.body, i) {
                some(b) => b,
                none => { return; }
            }
        };
        let def = -1;
        for k in 0..body.len() {
            match body[k].kind {
                assign(x) => { if x.dest == i && def < 0 { def = k; } }
                _ => {}
            }
        }
        let locals = users(f, gr, i);
        let last = def;
        for k in def + 1..body.len() {
            if uses(body[k], locals) { last = k; }
        }
        // the labels inside what follows (a break to one stays in it)
        let inner: list<s64> = [];
        for k in def + 1..last + 1 {
            for x in flatten([body[k],]) {
                match x.kind {
                    loop(l) => { if l.label >= 0 { inner.push(l.label); } }
                    block(b) => { if b.label >= 0 { inner.push(b.label); } }
                    _ => {}
                }
            }
        }
        let out: list<Node> = [];
        // a parameter never used: let go at once
        if last < 0 { out.push(release-node(g, f, i)); }
        for k in 0..body.len() {
            let n = body[k];
            if k > def && k <= last {
                if leaves(n, false, inner) { out.push(release-node(g, f, i)); }
                else { before-exits(g, f, i, n, false, inner); }
            }
            out.push(n);
            if k == last && !is-release(n, i) { out.push(release-node(g, f, i)); }
        }
        replace-body(body, out);
    }

    // the statement list the local is first assigned in
    defining-list: func(body: list<Node>, i: s64) -> option<list<Node>> {
        for n in body {
            match n.kind {
                assign(x) => { if x.dest == i { return some(body); } }
                _ => {}
            }
            for index in 0..nested-count(n) {
                match defining-list(nested-body(n, index), i) {
                    some(found) => { return some(found); }
                    none => {}
                }
            }
        }
        none
    }

    // whether a statement leaves the list it is in (in-loop: inside a loop of that list, where a
    // break or a continue of its own stays)
    leaves: func(n: Node, in-loop: bool, inner: list<s64>) -> bool {
        match n.kind {
            return(v) => true,
            break(l) => if l < 0 { !in-loop } else { !contains(inner, l) },
            continue(l) => if l < 0 { !in-loop } else { !contains(inner, l) },
            _ => false,
        }
    }

    // the release before each way out inside a statement
    before-exits: func(g: Gen, f: IrFunc, i: s64, n: Node, in-loop: bool, inner: list<s64>) {
        let deeper = match n.kind {
            loop(l) => true,
            _ => in-loop,
        };
        for index in 0..nested-count(n) {
            let b = nested-body(n, index);
            let out: list<Node> = [];
            for x in b {
                if leaves(x, deeper, inner) { out.push(release-node(g, f, i)); }
                else { before-exits(g, f, i, x, deeper, inner); }
                out.push(x);
            }
            replace-body(b, out);
        }
    }

    // whether a statement is the local's release already (a writer's close, written)
    is-release: func(n: Node, i: s64) -> bool {
        match n.kind {
            call(c) => {
                if c.c-name != "yel_writer_close" && c.c-name != "yel_stream_release"
                    && c.c-name != "yel_future_release" {
                    return false;
                }
                for a in c.args {
                    match a.kind {
                        local(r) => { if r == i { return true; } }
                        _ => {}
                    }
                }
                false
            }
            _ => false,
        }
    }

    // the runtime's release of the local's end (a generic extern's: its item's type first)
    release-node: func(g: Gen, f: IrFunc, i: s64) -> Node {
        let t = resolve(f.locals[i].ty);
        let item = match t {
            stream-type(x) => x.item,
            future-type(x) => x,
            _ => Type.unit-type,
        };
        let c-name = match end-kind(t) {
            "writer" => "yel_writer_close",
            "stream" => "yel_stream_release",
            _ => "yel_future_release",
        };
        let arg: TypeArg = { ty: item, key: false, };
        type-arg-c(g, c-name, 0, arg);
        let args = [type-arg(item, false), local(i, t),];
        call("", c-name, args, Type.unit-type, fx().call)
    }
}
