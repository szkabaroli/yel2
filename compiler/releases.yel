// Host ends let go, on the IR. A stream or a future a func has from the host (a WIT func's result,
// or part of one) holds an end of the host's: read to its end, or waited for, the runtime lets it go
// itself, but one a func stops using before then would hold it for good (the host's writer waiting
// for a reader that is gone). So after the statement that last uses a local holding one, and before
// each way out until then (return, break, continue), its end is let go (yel_stream_release,
// yel_future_release: nothing for a stream or a future of yel's own); a writer is closed there (no
// one can write to it after: its reader, the host's or a task's, is told the stream is done).
//
// Only a binding's local (not one codegen made, nor a parameter, nor one a closure captures) that
// no one else has, as escape.yel's flow says of its group: not let escape (stored, kept by a func it
// is given, moved to a WIT func, given a started call), not given back, not holding a value made
// elsewhere (a parameter's, a field's, a result that is not new), no other binding in it holding
// the same end, and assigned once. A func only ever started owns its parameters too (the caller
// gives up what it gives a started call): one never assigned is let go as such a local is.
// Everything else is whoever has it's to let go (or the host's, once the component is done).

module gen {
    // every func's such locals, let go where they are last used
    // the program's flow (escape.yel), what both the releases and the readonly and move checks
    // read
    flow-facts: func(
        generator: Gen,
        funcs: list<IrFunc>,
        pointer-types: map<Name, bool>,
        value-payloads: map<Name, list<Type>>,
        func-holders: map<Name, bool>,
        externs: map<string, RuntimeEffect>,
    ) -> Facts {
        let facts: Facts = {
            funcs: map.new(),
            param-escapes: map.new(),
            param-kept-in: map.new(),
            param-gives: map.new(),
            param-writes: map.new(),
            param-lent: map.new(),
            param-changes: map.new(),
            fresh-result: map.new(),
            new-top: map.new(),
            wit: wit-wrappers(generator),
            externs: externs,
            pointer-types: pointer-types,
            value-payloads: value-payloads,
            observable-types: observable-types(generator),
            func-holders: func-holders,
            groups: map.new(),
            callees: map.new(),
            flows: map.new(),
            mutable-locals: map.new(),
            env-escapes: map.new(),
        };
        for function in funcs { facts.funcs.set(function.name, function); }
        opt.param-escapes(facts, funcs);
        facts
    }

    // the @(observable) resources, by name (what escape.yel's param-changes stops at)
    observable-types: func(generator: Gen) -> map<Name, bool> {
        let found: map<Name, bool> = map.new();
        for record-name in generator.symbols.records.keys() { if generator.symbols.records[record-name].observable { found.set(record-name, true); } }
        found
    }

    release-ends: func(generator: Gen, funcs: list<IrFunc>, facts: Facts) {
        let given = given-over(generator, funcs);
        for function in funcs {
            if facts.groups.has(function.name) {
                let gr = facts.groups[function.name];
                let start = intern("s" + function.c-name.substring(1, function.c-name.len()));
                let owned: list<bool> = if function.async && given.has(start) { given[start] } else { [] };
                for index in 0..function.locals.len() {
                    if owned-end(function, gr, index, owned) { release-local(generator, function, index); }
                }
            }
        }
    }

    // what each async func only ever started (start f(...): its frame given the executor) has
    // given over to it, by its start's C name: for each parameter, whether at every start its
    // argument is a local the caller has no more (that read its only one, and the only one of each
    // local it is a copy of, with no loop between where it is made and the start). Such a parameter
    // is the func's own; anything else it is given, its caller may still have (a value given two
    // tasks, or read after the start). A func waited for, called by the host or taken as a value
    // owns none of its parameters.
    given-over: func(generator: Gen, funcs: list<IrFunc>) -> map<Name, list<bool>> {
        let calls: map<Name, s64> = map.new();
        let spawned: map<Name, s64> = map.new();
        let given: map<Name, list<bool>> = map.new();
        let taken: set<Name> = set.new();
        let seen: set<Name> = set.new();
        let all: list<IrFunc> = [];
        for function in funcs { all.push(function); }
        for helper in generator.helpers { all.push(helper); }
        for function in all {
            if seen.has(function.name) { continue; }
            seen.add(function.name);
            let nodes = flatten(function.body);
            // how often each local is read
            let read-counts: list<s64> = [];
            for index in 0..function.locals.len() { read-counts.push(0); }
            for node in nodes {
                let read: list<s64> = [];
                reads(node, read);
                for local-index in read { read-counts[local-index] = read-counts[local-index] + 1; }
            }
            // the locals a start's frame is put in
            let frames: map<s64, Name> = map.new();
            starts-given(function, function.body, true, read-counts, frames, given);
            for node in nodes { started-calls(node, frames, calls, spawned, taken); }
        }
        let out: map<Name, list<bool>> = map.new();
        for name in spawned.keys() {
            if !taken.has(name) && calls.get-or(name, 0) == spawned[name] && given.has(name) {
                out.set(name, given[name]);
            }
        }
        out
    }

    // each start's call in body (a statement putting its frame in a local), and in the bodies it
    // holds: its frame's local kept, and whether each argument is given over (top: body is the
    // func's own, where its parameters are as if made)
    starts-given: func(
        function: IrFunc,
        body: list<Node>,
        top: bool,
        read-counts: list<s64>,
        frames: map<s64, Name>,
        given: map<Name, list<bool>>,
    ) {
        for node in body {
            match node.kind {
                assign(assigned) => {
                    match assigned.value.kind {
                        call(called) => {
                            if starts-at(called.c-name, 0, "s_") {
                                frames.set(assigned.dest, called.name);
                                let before = if given.has(called.name) { given[called.name] } else { [] };
                                let each: list<bool> = [];
                                for at in 0..called.args.len() {
                                    let own = match called.args[at].kind {
                                        local(local-index) => ((top && contains(function.params, local-index)) || made-in(body, local-index)) && read-once(function, local-index, read-counts),
                                        _ => false,
                                    };
                                    each.push(own && (before.len() == 0 || before[at]));
                                }
                                given.set(called.name, each);
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            for index in 0..nested-count(node) { starts-given(function, nested-body(node, index), false, read-counts, frames, given); }
        }
    }

    // whether body itself (not a body it holds) assigns j
    made-in: func(body: list<Node>, local-index: s64) -> bool {
        for node in body {
            match node.kind {
                assign(assigned) => { if assigned.dest == local-index { return true; } }
                _ => {}
            }
        }
        false
    }

    // whether j is read once, and each local it is a copy of (through any chain) once too: no
    // other name has its value after that read
    read-once: func(function: IrFunc, local-index: s64, read-counts: list<s64>) -> bool {
        if read-counts[local-index] != 1 { return false; }
        for node in flatten(function.body) {
            match node.kind {
                assign(assigned) => {
                    if assigned.dest == local-index {
                        match assigned.value.kind {
                            local(other) => { if other != local-index && !read-once(function, other, read-counts) { return false; } }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
        true
    }

    // the WIT funcs' wrappers by C name, and an async one's start
    wit-wrappers: func(generator: Gen) -> set<Name> {
        let out: set<Name> = set.new();
        for name in generator.wit-externs.keys() {
            let native = generator.funcs[name].c-name;
            out.add(intern(native));
            out.add(intern("s" + native.substring(1, native.len())));
        }
        out
    }

    // n's calls of starts, its operands' too: each counted, and as spawned where it is a frame
    // given the executor; a func taken as a value
    started-calls: func(node: Node, frames: map<s64, Name>, calls: map<Name, s64>, spawned: map<Name, s64>, taken: set<Name>) {
        match node.kind {
            call(called) => {
                if starts-at(called.c-name, 0, "s_") { calls.set(called.name, calls.get-or(called.name, 0) + 1); }
                if called.c-name == "yel_async_spawn" && called.args.len() == 1 {
                    match called.args[0].kind {
                        local(local-index) => {
                            if frames.has(local-index) {
                                let name = frames[local-index];
                                spawned.set(name, spawned.get-or(name, 0) + 1);
                            }
                        }
                        _ => {}
                    }
                }
            }
            func-ref(referred) => {
                taken.add(referred.name);
                if starts-at(referred.c-name, 0, "u_") { taken.add(intern("s" + referred.c-name.substring(1, referred.c-name.len()))); }
            }
            _ => {}
        }
        for index in 0..operand-count(node) { started-calls(operand(node, index), frames, calls, spawned, taken); }
    }

    // whether a local is a binding's (not one codegen made)
    is-binding: func(function: IrFunc, local-index: s64) -> bool {
        match function.locals[local-index].binding {
            some(_) => true,
            none => false,
        }
    }

    // what end a type holds: "stream", "writer", "future", or "" (none of its own)
    end-kind: func(given: Type) -> string {
        match resolve(given) {
            stream-type(streamed) => if streamed.writer { "writer" } else { "stream" },
            future-type(_) => "future",
            _ => "",
        }
    }

    // whether a local is a binding's end that no one else has (see the top)
    // (owned: of a func only ever started, whether each parameter is given over, its own: one
    // never assigned, its value the one it was given, whoever else made it)
    owned-end: func(function: IrFunc, gr: Groups, local-index: s64, owned: list<bool>) -> bool {
        let kind = end-kind(function.locals[local-index].ty);
        let at = function.params.index-of(local-index);
        let param = at >= 0;
        if kind == "" || (param && (at >= owned.len() || !owned[at])) { return false; }
        let mark = match function.locals[local-index].binding {
            some(bound) => bound,
            none => { return false; }
        };
        if mark.captured { return false; }
        let root = opt.find(gr, local-index);
        // nor one another value holds (a list it is pushed to may read it after)
        if gr.escapes[root] || gr.returned[root] || (gr.stale[root] && !param) || gr.moved[root] || gr.holding-params[root].len() > 0
            || opt.holder-roots(gr, root).len() > 1 {
            return false;
        }
        for other in 0..function.locals.len() {
            if other != local-index && opt.find(gr, other) == root && is-binding(function, other)
                && end-kind(function.locals[other].ty) == kind {
                return false;
            }
        }
        let assigned = 0;
        for node in flatten(function.body) {
            match node.kind {
                assign(assignment) => { if assignment.dest == local-index { assigned += 1; } }
                _ => {}
            }
        }
        assigned == if param { 0 } else { 1 }
    }

    // the locals whose reading is a use of it: itself, and codegen's made from it (a block's value,
    // a call's frame that holds it: a read begun, waited for later), through any chain of them
    users: func(function: IrFunc, local-index: s64) -> list<s64> {
        let out = [local-index,];
        let assigns: list<AssignNode> = [];
        for node in flatten(function.body) {
            match node.kind {
                assign(assigned) => { if !is-binding(function, assigned.dest) { assigns.push(assigned); } }
                _ => {}
            }
        }
        loop {
            let grew = false;
            for assigned in assigns {
                if !contains(out, assigned.dest) && uses(assigned.value, out) {
                    out.push(assigned.dest);
                    grew = true;
                }
            }
            if !grew { return out; }
        }
    }

    // whether a statement (and what it holds) reads any of the locals
    uses: func(node: Node, locals: list<s64>) -> bool {
        for inner in flatten([node,]) {
            let read: list<s64> = [];
            reads(inner, read);
            for local-index in read {
                if contains(locals, local-index) { return true; }
            }
        }
        false
    }

    // the release after the local's last use, and before each way out until then
    release-local: func(generator: Gen, function: IrFunc, local-index: s64) {
        // (a parameter's: the func's, from its start)
        let body = if contains(function.params, local-index) { function.body } else {
            match defining-list(function.body, local-index) {
                some(found) => found,
                none => { return; }
            }
        };
        let def = -1;
        for index in 0..body.len() {
            match body[index].kind {
                assign(assigned) => { if assigned.dest == local-index && def < 0 { def = index; } }
                _ => {}
            }
        }
        let locals = users(function, local-index);
        let last = def;
        for index in def + 1..body.len() {
            if uses(body[index], locals) { last = index; }
        }
        // the labels inside what follows (a break to one stays in it)
        let inner: list<s64> = [];
        for index in def + 1..last + 1 {
            for nested in flatten([body[index],]) {
                match nested.kind {
                    loop(looping) => { if looping.label >= 0 { inner.push(looping.label); } }
                    block(blocked) => { if blocked.label >= 0 { inner.push(blocked.label); } }
                    _ => {}
                }
            }
        }
        let out: list<Node> = [];
        // a parameter never used: let go at once
        if last < 0 { out.push(release-node(generator, function, local-index)); }
        for index in 0..body.len() {
            let node = body[index];
            if index > def && index <= last {
                if leaves(node, false, inner) { out.push(release-node(generator, function, local-index)); }
                else { before-exits(generator, function, local-index, node, false, inner); }
            }
            out.push(node);
            if index == last && !is-release(node, local-index) { out.push(release-node(generator, function, local-index)); }
        }
        replace-body(body, out);
    }

    // the statement list the local is first assigned in
    defining-list: func(body: list<Node>, local-index: s64) -> option<list<Node>> {
        for node in body {
            match node.kind {
                assign(assigned) => { if assigned.dest == local-index { return some(body); } }
                _ => {}
            }
            for index in 0..nested-count(node) {
                match defining-list(nested-body(node, index), local-index) {
                    some(found) => { return some(found); }
                    none => {}
                }
            }
        }
        none
    }

    // whether a statement leaves the list it is in (in-loop: inside a loop of that list, where a
    // break or a continue of its own stays)
    leaves: func(node: Node, in-loop: bool, inner: list<s64>) -> bool {
        match node.kind {
            return(_) => true,
            break(label) => if label < 0 { !in-loop } else { !contains(inner, label) },
            continue(label) => if label < 0 { !in-loop } else { !contains(inner, label) },
            _ => false,
        }
    }

    // the release before each way out inside a statement
    before-exits: func(generator: Gen, function: IrFunc, local-index: s64, node: Node, in-loop: bool, inner: list<s64>) {
        let deeper = match node.kind {
            loop(_) => true,
            _ => in-loop,
        };
        for index in 0..nested-count(node) {
            let nested = nested-body(node, index);
            let out: list<Node> = [];
            for statement in nested {
                if leaves(statement, deeper, inner) { out.push(release-node(generator, function, local-index)); }
                else { before-exits(generator, function, local-index, statement, deeper, inner); }
                out.push(statement);
            }
            replace-body(nested, out);
        }
    }

    // whether a statement is the local's release already (a writer's close, written)
    is-release: func(node: Node, local-index: s64) -> bool {
        match node.kind {
            call(called) => {
                if called.c-name != "yel_writer_close" && called.c-name != "yel_stream_release"
                    && called.c-name != "yel_future_release" {
                    return false;
                }
                for argument in called.args {
                    match argument.kind {
                        local(read-index) => { if read-index == local-index { return true; } }
                        _ => {}
                    }
                }
                false
            }
            _ => false,
        }
    }

    // the runtime's release of the local's end (a generic extern's: its item's type first)
    release-node: func(generator: Gen, function: IrFunc, local-index: s64) -> Node {
        let given = resolve(function.locals[local-index].ty);
        let item = match given {
            stream-type(streamed) => streamed.item,
            future-type(ended) => ended,
            _ => Type.unit-type,
        };
        let c-name = match end-kind(given) {
            "writer" => "yel_writer_close",
            "stream" => "yel_stream_release",
            _ => "yel_future_release",
        };
        let arg: TypeArg = { ty: item, key: false, };
        type-arg-c(generator, c-name, 0, arg);
        let args = [type-arg(item, false), local(local-index, given),];
        call("", c-name, args, Type.unit-type, fx().call)
    }
}
