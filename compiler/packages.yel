// Packages: a package's files read, its includes loaded, and every declaration keyed.

// the program being loaded: its declarations, its packages (by directory), where included
// packages are looked for (-I), the standard library's directory (library: runtime/std, its own
// files every program's, each directory a std: package), and the prelude's names (reached from
// every package)
// wit: the WIT packages in the WIT directories (wit-dirs), by id, once read; wit-types: each WIT
// interface's type names (ns:name/iface.name) as yel types; wit-done: the interfaces made modules
resource Program {
    // the compile's context: its sources, the errors found so far, what was asked for
    context: Context,
    decls: list<Decl>,
    packages: map<string, Package>,
    search: list<string>,
    library: string,
    prelude: map<string, bool>,
    wit-dirs: list<string>,
    wit: map<string, WitPackage>,
    wit-read: bool,
    wit-types: map<string, Type>,
    wit-done: map<string, bool>,
    root: Package,
    // what not everyone may name (@(private), @(private="file")), by key: declarations, and
    // modules (their package's prefix and name)
    visibility: map<string, Visibility>,
}

module packages {
    // the directory a path is in ("." for none)
    dir-name: func(path: string) -> string {
        let length = path.len();
        for offset in 0..length {
            if path.byte-at(length - 1 - offset) == 47 {
                if offset == length - 1 { return "/"; }
                return path.substring(0, length - 1 - offset);
            }
        }
        "."
    }

    // a path with its . and x/.. steps taken out (so one package is one path, however it is
    // reached)
    clean-path: func(path: string) -> string {
        let parts: list<string> = [];
        let start = 0;
        let length = path.len();
        for index in 0..length + 1 {
            if index == length || path.byte-at(index) == 47 {
                let part = path.substring(start, index);
                if part == ".." && parts.len() > 0 && parts[parts.len() - 1] != ".." {
                    parts.pop();
                }
                else if part != "." && part != "" { parts.push(part); }
                else if part == "" && index == 0 { parts.push(""); }
                start = index + 1;
            }
        }
        if parts.len() == 0 { return "."; }
        parts.join("/")
    }

    // a package (the files of a directory, or one file) and, before its own, those it includes (at:
    // where it is included, for an error; "" for the program's own)
    load-package: async func(prog: Program, path: string, at: string) -> Package {
        let root = at == "";
        let dir = clean-path(path);
        let pkg: Package = {
            id: "",
            version: "",
            prefix: "",
            dir: dir,
            modules: map.new(),
            private-modules: map.new(),
            state: 0,
            wit: false,
            views: false,
            views-dom: "",
            included: !root,
        };
        prog.packages.set(dir, pkg);
        let files: list<string> = [];
        // (a test file, <name>.test.yel, is its package's only where that package is tested or
        // checked: the input of yelc test, yelc check, a language server's check. A build, and a
        // package included, leave it out, and what it includes)
        let context = prog.context;
        let with-tests = (context.testing || context.mode == "check") && dir == clean-path(context.input);
        if wait diagnostics.is-source-dir(prog.context, dir) {
            // (the standard library's core: its files in the directories in it too, one package)
            wait source-files(prog, dir, dir == core-dir(prog), with-tests, files);
            if files.len() == 0 {
                diagnostics.report(
                    prog.context,
                    diagnostics.error-at(dir, "no .yel files in the package"),
                );
            }
        } else {
            files.push(dir);
        }
        let scopes: list<Scope> = [];
        for file in files {
            let source = wait diagnostics.read-source(prog.context, file);
            let reading = lower.reader(prog.context, source);
            wait diagnostics.read-embeds(prog.context, file, lower.embedded(reading));
            reading.scope = {
                pkg: pkg,
                module: "",
                file: file,
                build: reading.scope.build,
                includes: map.new(),
                requests: [],
                private: "",
            };
            lower.declarations(reading, prog.decls);
            scopes.push(reading.scope);
        }
        // (a package with views: the compiler's view-host module too, what they do with the host's
        // dom; once: an editor's next check lists it as one of its files)
        let host-file = (if wait diagnostics.is-source-dir(prog.context, dir) { dir } else { dir-name(dir) }) + "/yel-view-host.yel";
        if pkg.views && !files.contains(host-file) {
            prog.context.overlays.set(host-file, view-host-source(pkg.views-dom));
            let source = wait diagnostics.read-source(prog.context, host-file);
            let reading = lower.reader(prog.context, source);
            reading.scope = { pkg: pkg, module: "", file: host-file, build: reading.scope.build, includes: map.new(), requests: [], private: "", };
            lower.declarations(reading, prog.decls);
            scopes.push(reading.scope);
        }
        // an included package's items are keyed by its id
        if !root {
            if pkg.id == "" {
                diagnostics.report(
                    prog.context,
                    diagnostics.error-at(
                        at,
                        "{dir} is included, so it names itself (package ns:name;)",
                    ),
                );
            }
            pkg.prefix = pkg.id + "/";
        }
        for sc in scopes {
            for request in sc.requests { wait include(prog, pkg, sc, request); }
        }
        pkg.state = 1;
        pkg
    }

    // the view-host module a package with views has (the compiler's, as the file yel-view-host.yel):
    // its dom from where its views' is (an include's spec; "": the package's own module dom)
    view-host-source: func(dom-from: string) -> string {
        let including = if dom-from == "" { "" } else { "from \"{dom-from}\" include dom;" };
        c"// What the views of this package do with the host's dom (the compiler adds this file to a package
// that has views): std's view-nodes given the program's dom, a value as the host takes it, a style
// set or kept current

{including}

@(private) module view-host {
    // std's view-nodes.Dom, its funcs this program's dom's
    host: func() -> view-nodes.Dom {
        {
            comment: { content: string -> dom.create-comment(content) },
            insert: { parent: u32, node: u32, before: u32 -> dom.insert-before(parent, node, before); },
            append: { parent: u32, node: u32 -> dom.append-child(parent, node); },
            remove: { node: u32 -> dom.remove(node); },
            element: { tag: string -> dom.create-element(tag) },
            text: { content: string -> dom.create-text(content) },
            attribute: { node: u32, name: string, value: view-nodes.Value -> dom.set-attribute(node, name, host-value(value)); },
            style: { node: u32, name: string, value: view-nodes.Value -> dom.set-style(node, name, host-value(value)); },
            set-text: { node: u32, content: string -> dom.set-text-content(node, content); },
        }
    }

    // a value as the host takes it
    host-value: func(v: view-nodes.Value) -> dom.attribute-value {
        match v {
            text(x) => dom.attribute-value.str(x),
            flag(x) => dom.attribute-value.%bool(x),
            whole(x) => dom.attribute-value.%s32(x),
            real(x) => dom.attribute-value.%f64(x),
        }
    }

    // a style's value as the host takes it
    style-value: func(v: string | bool | s32 | f64 | dom.color) -> dom.attribute-value {
        match v {
            let x: string => dom.attribute-value.str(x),
            let x: bool => dom.attribute-value.%bool(x),
            let x: s32 => dom.attribute-value.%s32(x),
            let x: f64 => dom.attribute-value.%f64(x),
            let x: dom.color => dom.attribute-value.color(x),
        }
    }

    // a style set once
    style: func(node: u32, name: string, v: string | bool | s32 | f64 | dom.color) { dom.set-style(node, name, style-value(v)); }

    // a style kept current: read, set, and set again each time what it reads changes to a value
    // it was not
    keep-style: func(node: u32, name: string, read: func() -> string | bool | s32 | f64 | dom.color) {
        let last = read();
        dom.set-style(node, name, style-value(last));
        reactive.watch(read, last, { now -> dom.set-style(node, name, style-value(now)); });
    }
}
"
    }

    // the .yel files of dir, into files (a test file only with-tests); nested: each directory's in it
    // too, one after another, as listed (the standard library's core: its folders one package)
    source-files: async func(prog: Program, dir: string, nested: bool, with-tests: bool, files: list<string>) {
        let dirs: list<string> = [dir,];
        let at = 0;
        loop {
            if at >= dirs.len() { break; }
            let here = dirs[at];
            at += 1;
            for entry in wait diagnostics.source-entries(prog.context, here) {
                let path = here + "/" + entry;
                if ends-with(entry, ".yel") {
                    if ends-with(entry, ".test.yel") && !with-tests { continue; }
                    files.push(path);
                } else if nested && wait diagnostics.is-source-dir(prog.context, path) {
                    dirs.push(path);
                }
            }
        }
    }

    // whether a directory's package is id: what its first file with a package line says
    @(private) declares: async func(prog: Program, dir: string, id: string) -> bool {
        for entry in wait diagnostics.source-entries(prog.context, dir) {
            if !ends-with(entry, ".yel") { continue; }
            let source = wait diagnostics.read-source(prog.context, dir + "/" + entry);
            let root = tree.root(grammar.parse-file(prog.context, source));
            for node in tree.child-nodes(root) {
                if tree.kind(node) != NodeKind.package-decl { continue; }
                let written: list<string> = [];
                let past = false;
                for token in tree.own-tokens(node) {
                    if token.green.text == ";" { break; }
                    if past { written.push(token.green.text); }
                    if token.green.text == "package" { past = true; }
                }
                return without-version(written.join("")) == id;
            }
        }
        false
    }

    // the standard library's core: its directory (core, in the library's), every program's
    core-dir: func(prog: Program) -> string { clean-path(prog.library + "/core") }

    // an include: its package loaded (once), and each module it names bound in the file's scope
    include: async func(prog: Program, pkg: Package, sc: Scope, request: Include) {
        let at = "{sc.file}:{request.span.line}:{request.span.col}";
        let spec = request.spec;
        let dir = "";
        let id = "";
        if starts-at(spec, 0, "./") || starts-at(spec, 0, "../") {
            dir = dir-name(sc.file) + "/" + spec;
        } else if find-byte(spec, 58).unwrap-or(-1) > 0 {
            // ns:name, or ns:name/module: looked for as a directory `name` beside this package,
            // then in each -I directory. std:name is the standard library's: a directory of
            // runtime/std (but core, every program's), looked for only there;
            // else WASI's wasi:name, yel's name for the system's interfaces (an interface std
            // gives itself, its module <name>-<interface>, is std's: below)
            id = without-version(spec);
            let from-std = starts-with(id, "std:");
            let slash = find-byte(id, 47).unwrap-or(-1);
            if slash > 0 {
                let module-name = id.substring(slash + 1, id.len());
                id = id.substring(0, slash);
                if request.names.len() != 1 || request.names[0] != module-name {
                    diagnostics.report(
                        prog.context,
                        diagnostics.error-at(
                            at,
                            "{spec} is module {module-name}: include {module-name} (or {module-name} as another name)",
                        ),
                    );
                }
            }
            let name = id.substring(find-byte(id, 58).unwrap-or(-1) + 1, id.len());
            if from-std && name == "core" {
                diagnostics.report(
                    prog.context,
                    diagnostics.error-at(at, "std:core is the standard library's core: every program has it, with no include"),
                );
                return;
            }
            let dirs: list<string> = if from-std { [prog.library,] } else { [dir-name(pkg.dir),] };
            if !from-std {
                for directory in prog.search { dirs.push(directory); }
            }
            // (a directory of that name only where it is that package: a package's folder of
            // its own named ui is not yel:ui, nor the package including it)
            for directory in dirs {
                let candidate = directory + "/" + name;
                if dir == ""
                    && clean-path(candidate) != clean-path(pkg.dir)
                    && wait diagnostics.is-source-dir(prog.context, candidate)
                    && (from-std || wait declares(prog, candidate, id)) {
                    dir = candidate;
                }
            }
            // (the name as written, for an error)
            let asked = id;
            if dir == "" && from-std { id = "wasi:" + name; }
            // not a yel package: a WIT one, its interfaces made modules
            if dir == "" {
                wait wit-index(prog);
                if prog.wit.has(id) {
                    let wp = prog.wit[id];
                    for index in 0..request.names.len() {
                        if sc.includes.has(request.aliases[index]) {
                            diagnostics.report(
                                prog.context,
                                diagnostics.error-at(at, "{request.aliases[index]} is included twice"),
                            );
                        }
                        let own = if from-std {
                            std-module(prog, "{name}-{request.names[index]}")
                        } else {
                            ""
                        };
                        sc.includes.set(request.aliases[index], if own != "" { own } else {
                            wait wit-interface(prog, wp, request.names[index], at)
                        });
                    }
                    return;
                }
                let problem = diagnostics.error-at(at, "no package {asked}");
                let wit = if asked == id { "a WIT package" } else { "WASI's {id}" };
                diagnostics.note(
                    problem,
                    "looked for {name}/ in {dirs.join(", ")}, and for {wit} in {prog.wit-dirs.join(", ")}",
                );
                diagnostics.report(prog.context, problem);
                return;
            }
        } else {
            diagnostics.report(
                prog.context,
                diagnostics.error-at(at, "an include names a package: \"./dir\" or \"ns:name\""),
            );
            return;
        }
        dir = clean-path(dir);
        let target = if prog.packages.has(dir) {
            prog.packages[dir]
        } else {
            wait load-package(prog, dir, at)
        };
        if target.state == 0 {
            diagnostics.report(
                prog.context,
                diagnostics.error-at(
                    at,
                    "{dir} includes this package back: packages cannot include each other",
                ),
            );
        }
        if id != ""
            && target.id != id {
            diagnostics.report(
                prog.context,
                diagnostics.error-at(at, "{dir} is package {target.id}, not {id}"),
            );
        }
        for index in 0..request.names.len() {
            let module-name = request.names[index];
            if !target.modules.has(module-name) {
                diagnostics.report(
                    prog.context,
                    diagnostics.error-at(at, "package {target.id} has no module {module-name}"),
                );
            }
            // (a private module: its own package's, never another's to include)
            if target.private-modules.has(module-name) && target.prefix != sc.pkg.prefix {
                let problem = diagnostics.error(
                    request.span,
                    "module {module-name} is private to package {target.id}",
                    "",
                );
                diagnostics.note(
                    problem,
                    "declared @(private) at {where(prog, target.private-modules[module-name].span)}",
                );
                diagnostics.report(prog.context, problem);
            }
            if sc.includes.has(request.aliases[index]) {
                diagnostics.report(
                    prog.context,
                    diagnostics.error-at(at, "{request.aliases[index]} is included twice"),
                );
            }
            sc.includes.set(request.aliases[index], target.prefix + module-name);
        }
    }

    // std's module of that name, by its key ("" for none): one std gives in place of WASI's
    // interface (cli-exit: wasi:cli's exit, its funcs' result never)
    std-module: func(prog: Program, module: string) -> string {
        for pkg in prog.packages.values() {
            if pkg.id == "yel:std" && pkg.modules.has(module) { return pkg.prefix + module; }
        }
        ""
    }

    // a declaration's key: its package's prefix, its module's name and a dot, its name
    item-key: func(sc: Scope, name: string) -> string {
        if sc.module == "" { return sc.pkg.prefix + name; }
        sc.pkg.prefix + sc.module + "." + name
    }

    // every declaration named by its key, and what not everyone may name (a private declaration,
    // a private module) put in the program's table of visibility
    // yelc test's program: the root package's tests (its @(test) funcs), its own main left out,
    // and a runner of them as main (a source made, not read: parsed into the package as one of its
    // files): each test the runner's arguments name (all, for none) run in a process of its own,
    // so a failure (a panic) ends only it; each told, ok or FAIL, then how many failed (its exit
    // status 1 where any did)
    // (tested: the directory of the package whose tests run: the root's, or the standard library's,
    // whose runner is a package of its own then)
    test-runner: async func(prog: Program, tested: string) {
        let root = prog.root;
        let tests: list<Func> = [];
        let kept: list<Decl> = [];
        for declaration in prog.decls {
            match declaration {
                func-decl(function) => {
                    if function.scope.pkg.dir == tested {
                        if function.is-test { tests.push(function); }
                        if function.name == "main" && function.scope.module == "" { continue; }
                    }
                }
                _ => {}
            }
            kept.push(declaration);
        }
        prog.decls = kept;
        // (as the package's own files name each: module.name, or name)
        let names = tests.map({ function -> if function.scope.module == "" { function.name } else { "{function.scope.module}.{function.name}" } });
        let lines = if prog.context.test-exports { exported-runner(prog, tests, names) } else { process-runner(tests, names) };
        let base = if wait diagnostics.is-source-dir(prog.context, root.dir) { root.dir } else { dir-name(root.dir) };
        let path = "{base}/yelc-test-runner.yel";
        prog.context.overlays.set(path, lines.join("\n"));
        let source = wait diagnostics.read-source(prog.context, path);
        let reading = lower.reader(prog.context, source);
        reading.scope = {
            pkg: root,
            module: "",
            file: path,
            build: "",
            includes: map.new(),
            requests: [],
            private: "",
        };
        lower.declarations(reading, prog.decls);
        for request in reading.scope.requests { wait include(prog, root, reading.scope, request); }
    }

    // the runner as a program: main runs each test the arguments name (all, for none) in a child
    // process of its own (std:testing's runner, on std:process), its snapshots loaded and written
    // once it passed (in the child, as all its I/O), each told, then the count
    process-runner: func(tests: list<Func>, names: list<string>) -> list<string> {
        let lines: list<string> = [
            "// yelc test's runner of the package's tests",
            "from \"std:cli\" include environment;",
            "from \"std:testing\" include runner;",
            "",
            "main: async func() -> s32 \{",
            "    let arguments = environment.get-arguments();",
            "    let ran = 0;",
            "    let failed = 0;",
        ];
        for index in 0..tests.len() {
            let named = names[index];
            lines.push("    if runner.chosen(arguments, \"{named}\") \{");
            lines.push("        ran += 1;");
            lines.push("        let child = runner.start();");
            lines.push("        if child <= 0 \{");
            // (its snapshots read in the child: the runner itself does no I/O on libuv's threads, so
            // it forks with none, which a system's frameworks need of a child: macOS's)
            lines.push("            wait runner.prepare(\"{named}\", \"{snapshot-file(tests[index])}\");");
            lines.push("            {if tests[index].is-async { "wait " } else { "" }}{named}();");
            lines.push("            wait runner.save();");
            lines.push("            if child == 0 \{ runner.passed(); \}");
            lines.push("        \}");
            lines.push("        if !runner.report(\"{named}\", child) \{ failed += 1; \}");
            lines.push("    \}");
        }
        lines.push("    runner.summary(ran, failed)");
        lines.push("\}");
        lines.push("");
        lines
    }

    // the runner as a component's exports (a reactor: no main): module tests, the WIT interface the
    // host calls, names (the tests') and run(name) (the one so named: a failure, a panic, ends the
    // call, and a fresh instance runs the next: tools/test-component.sh). The package's other
    // modules are its own, not exports
    exported-runner: func(prog: Program, tests: list<Func>, names: list<string>) -> list<string> {
        for declaration in prog.decls {
            let sc = declared-scope(declaration);
            if sc.pkg.dir == prog.root.dir && sc.module != "" && sc.private == "" { sc.private = "package"; }
        }
        let quoted = names.map({ named -> "\"{named}\"" });
        let lines: list<string> = [
            "// yelc test's runner of the package's tests, as a component's exports",
            "from \"std:testing\" include runner;",
            "",
            "module tests \{",
            "    // the tests, by name",
            "    names: func() -> list<string> \{ [{quoted.join(", ")}{if quoted.len() > 0 { "," } else { "" }}] \}",
            "",
            "    // the test so named, run (its snapshots loaded first, and written once it passed): a",
            "    // failure ends the call (the host's call fails)",
            "    run: async func(name: string) \{",
        ];
        for index in 0..tests.len() {
            lines.push("        if name == \"{names[index]}\" \{");
            lines.push("            wait runner.prepare(\"{names[index]}\", \"{snapshot-file(tests[index])}\");");
            lines.push("            {if tests[index].is-async { "wait " } else { "" }}{names[index]}();");
            lines.push("            wait runner.save();");
            lines.push("            return;");
            lines.push("        \}");
        }
        lines.push("        panic(\"no test \{name\}\");");
        lines.push("    \}");
        lines.push("\}");
        lines.push("");
        lines
    }

    // a package of no files (the standard library's tests' runner's, at dir: the library is a
    // package included, not the program's)
    empty-package: func(prog: Program, dir: string) -> Package {
        let pkg: Package = {
            id: "",
            version: "",
            prefix: "",
            dir: dir,
            modules: map.new(),
            private-modules: map.new(),
            state: 1,
            wit: false,
            views: false,
            views-dom: "",
            included: true,
        };
        prog.packages.set(dir, pkg);
        pkg
    }

    // the file of a test's snapshots: snapshots/<file>.snap beside its file
    snapshot-file: func(function: Func) -> string {
        let file = function.scope.file;
        let slash = file.find-last("/").unwrap-or(-1);
        let base = file.substring(slash + 1, file.len());
        let stem = if base.ends-with(".yel") { base.substring(0, base.len() - 4) } else { base };
        if slash < 0 { "snapshots/{stem}.snap" } else { "{file.substring(0, slash)}/snapshots/{stem}.snap" }
    }

    // where a declaration is declared
    declared-scope: func(declaration: Decl) -> Scope {
        match declaration {
            func-decl(declared) => declared.scope,
            extern-decl(declared) => declared.scope,
            record-decl(declared) => declared.scope,
            variant-decl(declared) => declared.scope,
            flags-decl(declared) => declared.scope,
            resource-decl(declared) => declared.scope,
            const-decl(declared) => declared.scope,
            global-decl(declared) => declared.scope,
            type-decl(declared) => declared.scope,
        }
    }

    key-decls: func(prog: Program) {
        let keep = {
            key: string, sc: Scope, span: Span ->
                if sc.private != "" {
                prog.visibility.set(key, {
                    level: sc.private,
                    pkg: sc.pkg,
                    file: sc.file,
                    span: span,
                });
            }
        };
        for declaration in prog.decls {
            match declaration {
                func-decl(function) => {
                    function.name = item-key(function.scope, function.name);
                    keep(function.name, function.scope, function.span);
                }
                extern-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
                record-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
                variant-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
                flags-decl(fl) => {
                    fl.name = item-key(fl.scope, fl.name);
                    keep(fl.name, fl.scope, fl.span);
                }
                resource-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
                const-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
                global-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
                type-decl(declared) => {
                    declared.name = item-key(declared.scope, declared.name);
                    keep(declared.name, declared.scope, declared.span);
                }
            }
        }
        for pkg in prog.packages.values() {
            for module-name in pkg.private-modules.keys() {
                prog.visibility.set(pkg.prefix + module-name, pkg.private-modules[module-name]);
            }
        }
    }

    // a place as an error's note shows it (path:line)
    where: func(prog: Program, span: Span) -> string {
        if span.source < 0 { return "?"; }
        "{prog.context.sources[span.source].path}:{span.line}"
    }
}

// ================================================================ WIT packages

module packages {
    // the WIT packages in the WIT directories, by id (a package's files merged): read once, when
    // first included
    wit-index: async func(prog: Program) {
        if prog.wit-read { return; }
        prog.wit-read = true;
        for directory in prog.wit-dirs {
            if wait diagnostics.is-dir(directory) {
                for entry in wait diagnostics.entries(directory) {
                    if ends-with(entry, ".wit") {
                        let wp = grammar.wit-file(
                            prog.context,
                            wait diagnostics.read-source(prog.context, directory + "/" + entry),
                        );
                        if wp.id == "" { continue; }
                        // (a package in several files, as WIT allows: each file's interfaces
                        // the package's, the first read of one name kept)
                        match prog.wit.get(wp.id) {
                            some(known) => {
                                known.files.push(wp.file);
                                for name in wp.interfaces.keys() {
                                    if !known.interfaces.has(name) { known.interfaces.set(name, wp.interfaces[name]); }
                                }
                            }
                            none => prog.wit.set(wp.id, wp),
                        }
                    }
                }
            }
        }
    }

    // a WIT interface as a yel module (once; the interfaces it uses first): its types as records,
    // variants, flags and resources, its funcs as externs a component imports (a resource's as
    // <resource>.<func>, its constructor <resource>.new, its drop <resource>.drop); its key back.
    // What needs streams or async (not yet) is left out
    wit-interface: async func(prog: Program, wp: WitPackage, iface: string, at: string) -> string {
        let mkey = wp.id + "/" + iface;
        if prog.wit-done.has(mkey) { return mkey; }
        if !wp.interfaces.has(iface) {
            diagnostics.report(
                prog.context,
                diagnostics.error-at(at, "WIT package {wp.id} has no interface {iface}"),
            );
            return mkey;
        }
        prog.wit-done.set(mkey, true);
        let face = wp.interfaces[iface];
        let pkg: Package = {
            id: wp.id,
            version: wp.version,
            prefix: wp.id + "/",
            dir: wp.file,
            modules: map.new(),
            private-modules: map.new(),
            state: 1,
            wit: true,
            views: false,
            views-dom: "",
            included: true,
        };
        for name in wp.interfaces.keys() { pkg.modules.set(name, "extern"); }
        let sc: Scope = {
            pkg: pkg,
            module: iface,
            file: wp.file,
            build: "",
            includes: map.new(),
            requests: [],
            private: "",
        };
        let span: Span = { source: -1, line: 0, col: 0, end-line: 0, end-col: 0, };
        // each name the interface can write: its uses', then its own types
        let names: map<string, Type> = map.new();
        for used in face.uses {
            let src = if used.pkg == "" { wp } else { wait wit-package(prog, used.pkg, at) };
            let skey = wait wit-interface(prog, src, used.iface, at);
            for index in 0..used.names.len() {
                let key = skey + "." + used.names[index];
                // (one missing: told, and an error type in its place, so the phase goes on)
                if prog.wit-types.has(key) {
                    names.set(used.aliases[index], prog.wit-types[key]);
                } else {
                    diagnostics.report(
                        prog.context,
                        diagnostics.error-at(at, "{skey} has no type {used.names[index]}"),
                    );
                    names.set(used.aliases[index], Type.error-type);
                }
            }
        }
        for declared in face.types {
            if declared.kind != "alias" { names.set(declared.name, Type.named(intern(mkey + "." + declared.name))); }
        }
        for declared in face.types {
            if declared.kind == "alias" { names.set(declared.name, wit-resolve(names, declared.target)); }
        }
        // the types that need what is not there yet are left out, and so is what needs them
        let out: list<Decl> = [];
        for declared in face.types {
            if declared.kind == "record" {
                let types = wit-resolve-all(names, declared.types);
                if wit-missing-all(types) { names.set(declared.name, Type.named(intern("!" + declared.name))); }
                else {
                    out.push(Decl.record-decl({
                        span: span,
                        scope: sc,
                        name: declared.name,
                        fields: declared.fields,
                        field-types: types,
                        // (a WIT record is a value: copied across)
                        value: true,
                        observable: false,
                        ignored: [],
                    }));
                }
            } else if declared.kind == "variant" || declared.kind == "enum" {
                let cases: list<CaseDecl> = [];
                let missing = false;
                for branch in declared.cases {
                    let pt = wit-resolve(names, branch.payload);
                    if wit-missing(pt) { missing = true; }
                    cases.push({ name: branch.name, has-payload: branch.has-payload, payload: pt, });
                }
                if missing { names.set(declared.name, Type.named(intern("!" + declared.name))); }
                else {
                    out.push(Decl.variant-decl({
                        span: span,
                        scope: sc,
                        name: declared.name,
                        cases: cases,
                    }));
                }
            } else if declared.kind == "flags" {
                out.push(Decl.flags-decl({
                    span: span,
                    scope: sc,
                    name: declared.name,
                    flags: declared.fields,
                }));
            } else if declared.kind == "resource" {
                out.push(Decl.resource-decl({ span: span, scope: sc, name: declared.name, }));
            }
        }
        for declared in face.types { prog.wit-types.set(mkey + "." + declared.name, names[declared.name]); }
        let module = mkey + (if wp.version == "" { "" } else { "@" + wp.version });
        for function in face.funcs { wit-extern(names, sc, span, module, function.name, function, [], [], out); }
        for declared in face.types {
            if declared.kind == "resource" {
                let self = Type.named(intern(mkey + "." + declared.name));
                for function in declared.funcs {
                    let wit-name = if function.kind == "constructor" {
                        "[constructor]{declared.name}"
                    } else {
                        "[{function.kind}]{declared.name}.{function.name}"
                    };
                    let params: list<string> = if function.kind == "method" { ["self",] } else { [] };
                    let types: list<Type> = if function.kind == "method" { [self,] } else { [] };
                    wit-extern(names, sc, span, module, wit-name, {
                        name: "{declared.name}.{function.name}",
                        kind: function.kind,
                        params: function.params,
                        types: function.types,
                        result: function.result,
                        is-async: function.is-async,
                    }, params, types, out,);
                }
                let drop: WitFunc = {
                    name: "{declared.name}.drop",
                    kind: "method",
                    params: [],
                    types: [],
                    result: Type.unit-type,
                    is-async: false,
                };
                wit-extern(
                    names,
                    sc,
                    span,
                    module,
                    "[resource-drop]{declared.name}",
                    drop,
                    ["self",],
                    [self,],
                    out,
                );
            }
        }
        for declaration in out { prog.decls.push(declaration); }
        mkey
    }

    // a WIT func as an extern (its params after first and its types after first-types), unless it
    // needs what is not there yet
    wit-extern: func(
        names: map<string, Type>,
        sc: Scope,
        span: Span,
        module: string,
        wit-name: string,
        function: WitFunc,
        first: list<string>,
        first-types: list<Type>,
        out: list<Decl>,
    ) {
        let params: list<string> = [];
        let types: list<Type> = [];
        for parameter in first { params.push(parameter); }
        for parameter-type in first-types { types.push(parameter-type); }
        for parameter in function.params { params.push(parameter); }
        for parameter-type in wit-resolve-all(names, function.types) { types.push(parameter-type); }
        let result = wit-resolve(names, function.result);
        if wit-missing-all(types) || wit-missing(result) { return; }
        out.push(Decl.extern-decl({
            span: span,
            scope: sc,
            name: function.name,
            type-params: [],
            params: params,
            param-types: types,
            result: result,
            c-name: "",
            keeps: [],
            gives: [],
            wit-module: module,
            wit-name: wit-name,
            is-async: function.is-async,
            defaults: params.map({ _ -> none }),
        }));
    }

    // (one missing: told, and an empty one in its place, so the phase goes on)
    wit-package: async func(prog: Program, id: string, at: string) -> WitPackage {
        match prog.wit.get(id) {
            some(found) => found,
            none => {
                diagnostics.report(
                    prog.context,
                    diagnostics.error-at(at, "no WIT package {id} (for a use)"),
                );
                { id: id, version: "", file: "", files: [], interfaces: map.new(), }
            }
        }
    }

    // a WIT type with its names as the interface's types
    wit-resolve: func(names: map<string, Type>, given: Type) -> Type {
        match given {
            named(written) => if names.has(name-text(written)) {
                names[name-text(written)]
            } else if starts-at(name-text(written), 0, "!") || starts-at(name-text(written), 0, "~") {
                given
            } else {
                Type.named(intern("!" + name-text(written)))
            },
            // WIT's stream: its reading end
            stream-type(streamed) => Type.stream-type({
                item: wit-resolve(names, streamed.item),
                writer: false,
            }),
            _ => map-children(given, { child -> wit-resolve(names, child) }),
        }
    }

    wit-resolve-all: func(names: map<string, Type>, ts: list<Type>) -> list<Type> {
        let out: list<Type> = [];
        for given in ts { out.push(wit-resolve(names, given)); }
        out
    }

    // whether a param's or result's type needs what is not there yet: a name not known
    wit-missing: func(given: Type) -> bool { wit-missing-inside(given) }

    wit-missing-inside: func(given: Type) -> bool {
        match given {
            named(written) => starts-at(name-text(written), 0, "!") || starts-at(name-text(written), 0, "~"),
            _ => any-child(given, wit-missing-inside),
        }
    }

    wit-missing-all: func(ts: list<Type>) -> bool {
        for given in ts {
            if wit-missing(given) { return true; }
        }
        false
    }
}
