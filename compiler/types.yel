// Types: what one stands for once settled, how two become one, and the records the checker and
// the generator keep.

// what a type stands for now: a settled variable is its type
// a number literal's type where nothing settled it: an integer's s32, a float's f32 (what the code
// made of it holds: gen's); unit for any other variable
unsettled-number: func(kind: s64) -> Type {
    if kind == 1 { Type.num("s32") } else if kind == 2 { Type.num("f32") } else { Type.unit-type }
}

// t resolved, each number literal's type nothing settled given as its code holds it (an integer's
// s32): what it is once compiled, as a language server tells it
settled-type: func(t0: Type) -> Type {
    match resolve(t0) {
        var(variable) => if variable.kind == 1 || variable.kind == 2 { unsettled-number(variable.kind) } else { resolve(t0) },
        let concrete => map-children(concrete, settled-type),
    }
}

resolve: func(given: Type) -> Type {
    match given {
        var(variable) => match variable.bound {
            some(bound) => resolve(bound),
            none => given,
        },
        _ => given,
    }
}

// whether a number type is an integer's (s8 to u64), not a float's
is-int: func(name: string) -> bool { name.byte-at(0) != 102 }

is-signed: func(name: string) -> bool { name.byte-at(0) == 115 }

// a type as the compiler tells it (an error's message): a named type by its key
show-type: func(t0: Type) -> string { shown-type(t0, false) }

// a type as a program writes it (a hover's signature): a named type without its package, as an
// include names it (source-location, types.tcp-socket)
written-type: func(t0: Type) -> string { shown-type(t0, true) }

// a type's key without its package (pkg/m.t: m.t)
written-name: func(key: string) -> string {
    match key.find-last("/") {
        some(slash) => key.substring(slash + 1, key.len()),
        none => key,
    }
}

// (written: as written-type tells it, else as show-type)
shown-type: func(t0: Type, written: bool) -> string {
    let resolved = resolve(t0);
    match resolved {
        num(name) => name,
        bool-type => "bool",
        char-type => "char",
        string-type => "string",
        buffer-type => "buffer",
        unit-type => "()",
        never-type => "never",
        // an error's echo has this in its message (the checker tells no message with it)
        error-type => "\{error\}",
        // (the IR's only: no program has one)
        address-type => "address",
        canonical-type(inner) => "canonical<{shown-type(inner, written)}>",
        list-type(item) => "list<{shown-type(item, written)}>",
        fixed-list(fixed) => "list<{shown-type(fixed.item, written)}, {if fixed.len < 0 { "?" } else { "{fixed.len}" }}>",
        map-type(mapping) => match resolve(mapping.value) {
            unit-type => "set<{shown-type(mapping.key, written)}>",
            _ => "map<{shown-type(mapping.key, written)}, {shown-type(mapping.value, written)}>",
        },
        func-type(signature) => {
            let parts: list<string> = [];
            for parameter in signature.params { parts.push(shown-type(parameter, written)); }
            let returned = match resolve(signature.result) {
                unit-type => "",
                _ => " -> {shown-type(signature.result, written)}",
            };
            "func({parts.join(", ")}){returned}"
        }
        option-type(inner) => "option<{shown-type(inner, written)}>",
        future-type(inner) => "future<{shown-type(inner, written)}>",
        seq-type(item) => "seq<{shown-type(item, written)}>",
        stream-type(streamed) => "{if streamed.writer { "writer" } else { "stream" }}<{shown-type(streamed.item, written)}>",
        result-type(outcome) => "result<{shown-part(outcome.ok, written)}, {shown-part(outcome.err, written)}>",
        tuple-type(xs) => {
            let parts: list<string> = [];
            for item in xs { parts.push(shown-type(item, written)); }
            "tuple<{parts.join(", ")}>"
        }
        readonly-type(wrapped) => {
            let inner = shown-type(wrapped, written);
            match resolve(wrapped) {
                union-type(_) => "({inner}) & readonly",
                _ => "{inner} & readonly",
            }
        }
        anon-record(anonymous) => {
            let parts: list<string> = [];
            for index in 0..anonymous.fields.len() { parts.push("{anonymous.fields[index]}: {shown-type(anonymous.types[index], written)}"); }
            if parts.len() == 0 { "\{\}" } else { "\{ " + parts.join(", ") + " \}" }
        }
        union-type(xs) => {
            let parts: list<string> = [];
            for member in xs { parts.push(shown-type(member, written)); }
            parts.join(" | ")
        }
        singleton(single) => single.text,
        range-type(range) => range.text,
        distinct-type(distinct) => distinct.name,
        named(name) => if written { written-name(name-text(name)) } else { name-text(name) },
        param(name) => name,
        var(variable) => if variable.kind == 1 { "an integer" } else if variable.kind == 2 { "a float" } else { "_" },
    }
}

// a result's payload type, _ for none
shown-part: func(given: Type, written: bool) -> string {
    match resolve(given) {
        unit-type => "_",
        _ => shown-type(given, written),
    }
}

// whether a variable of this kind (0 any, 1 an integer's, 2 a float's) can be this type
fits-kind: func(kind: s64, given: Type) -> bool {
    if kind == 0 { return true; }
    match given {
        num(name) => if kind == 1 { is-int(name) } else { !is-int(name) },
        _ => false,
    }
}

// whether two types can be one, settling variables to make them so
unifies: func(a0: Type, b0: Type) -> bool {
    let left = resolve(a0);
    let right = resolve(b0);
    // an error's type fits anything: it was told already. A type not known yet becomes it (what an
    // error made is an error's too: its uses are not told again)
    if is-error(left) || is-error(right) {
        match left {
            var(left-variable) => { left-variable.bound = some(right); }
            _ => {}
        }
        match right {
            var(right-variable) => { right-variable.bound = some(left); }
            _ => {}
        }
        return true;
    }
    // T & readonly, T not known yet, and a value readonly anyway (a number, a string, …): T is it
    match readonly-var(left) {
        some(held) => { if readonly-anyway(right) { return unifies(held, right); } }
        none => {}
    }
    match readonly-var(right) {
        some(held) => { if readonly-anyway(left) { return unifies(left, held); } }
        none => {}
    }
    match left {
        var(left-variable) => {
            match right {
                var(right-variable) => {
                    if right-variable.id == left-variable.id { return true; }
                    // the one of the two that is less particular settles as the other
                    if left-variable.kind == 0 || left-variable.kind == right-variable.kind {
                        left-variable.bound = some(right);
                        return true;
                    }
                    if right-variable.kind == 0 {
                        right-variable.bound = some(left);
                        return true;
                    }
                    return false;
                }
                _ => {}
            }
            if !fits-kind(left-variable.kind, right) { return false; }
            left-variable.bound = some(right);
            return true;
        }
        _ => {}
    }
    match right {
        var(right-variable) => {
            if !fits-kind(right-variable.kind, left) { return false; }
            right-variable.bound = some(left);
            return true;
        }
        _ => {}
    }
    // a length left to its value (?) is any
    match left {
        fixed-list(left-fixed) => match right {
            fixed-list(right-fixed) => { if left-fixed.len != right-fixed.len && left-fixed.len >= 0 && right-fixed.len >= 0 { return false; } }
            _ => {}
        },
        _ => {}
    }
    match pair-parts(left, right, unifies) {
        some(unified) => unified,
        none => show-type(left) == show-type(right),
    }
}

// a structured type's kind and what it has besides its parts (a func's or tuple's count, a
// record's fields, a stream's end); "" for any other type (a union, a declared type)
shape: func(whole: Type) -> string {
    match whole {
        list-type(_) => "list",
        fixed-list(_) => "fixed",
        func-type(signature) => "func {signature.params.len()}",
        map-type(_) => "map",
        option-type(_) => "option",
        result-type(_) => "result",
        tuple-type(parts) => "tuple {parts.len()}",
        anon-record(fields) => "record " + fields.fields.join(","),
        readonly-type(_) => "readonly",
        future-type(_) => "future",
        seq-type(_) => "seq",
        stream-type(stream) => if stream.writer { "writer" } else { "stream" },
        _ => "",
    }
}

// whether left and right have one shape and holds is true of each pair of their parts, in order (a fixed
// list's length left to the caller); none where left has no shape
pair-parts: func(left: Type, right: Type, holds: func(Type, Type) -> bool) -> option<bool> {
    let kind = shape(left);
    if kind == "" { return none; }
    if kind != shape(right) { return some(false); }
    for index in 0..child-count(left) {
        if !holds(child(left, index), child(right, index)) { return some(false); }
    }
    some(true)
}

// a union's members settled: unions in it flattened, a literal whose base is a member dropped
// (string | "a" is string), each once, in order of how they show; one member is that type
union-of: func(members: list<Type>) -> Type {
    let flat: list<Type> = [];
    for member in members { flatten-union(resolve(member), flat); }
    let bases: list<string> = [];
    for member in flat {
        match member {
            singleton(_) => {}
            _ => bases.push(show-type(member)),
        }
    }
    let kept: list<Type> = [];
    let shown: list<string> = [];
    for member in flat {
        let covered = match member {
            singleton(single) => contains(bases, show-type(single.base)),
            _ => false,
        };
        let key = show-type(member);
        if !covered && !contains(shown, key) {
            kept.push(member);
            shown.push(key);
        }
    }
    shown-union(kept, shown)
}

// T & readonly, settled: readonly where it can be written (a list, a map, a buffer, a declared
// type, a parameter), each part of a value (an option's, a tuple's, a union's) readonly, and a
// value that cannot be written (a number, a string) itself
// the type T & readonly is of, where T is not known yet
readonly-var: func(given: Type) -> option<Type> {
    match given {
        readonly-type(wrapped) => match resolve(wrapped) {
            var(_) => some(wrapped),
            _ => none,
        },
        _ => none,
    }
}

// whether a type's values are readonly with or without & readonly (nothing in them is written)
readonly-anyway: func(given: Type) -> bool {
    match resolve(given) {
        num(_) => true,
        bool-type => true,
        char-type => true,
        string-type => true,
        unit-type => true,
        singleton(_) => true,
        range-type(_) => true,
        var(variable) => variable.kind != 0,
        _ => false,
    }
}

readonly-of: func(t0: Type) -> Type {
    let resolved = resolve(t0);
    match resolved {
        list-type(item) => Type.readonly-type(Type.list-type(readonly-of(item))),
        map-type(mapping) => Type.readonly-type(Type.map-type({ key: mapping.key, value: readonly-of(mapping.value), })),
        buffer-type => Type.readonly-type(resolved),
        named(_) => Type.readonly-type(resolved),
        param(_) => Type.readonly-type(resolved),
        var(variable) => if variable.kind == 0 { Type.readonly-type(resolved) } else { resolved },
        fixed-list(fixed) => Type.fixed-list({ item: readonly-of(fixed.item), len: fixed.len, }),
        option-type(inner) => Type.option-type(readonly-of(inner)),
        result-type(outcome) => Type.result-type({ ok: readonly-of(outcome.ok), err: readonly-of(outcome.err), }),
        tuple-type(xs) => {
            let out: list<Type> = [];
            for item in xs { out.push(readonly-of(item)); }
            Type.tuple-type(out)
        }
        anon-record(anonymous) => {
            let out: list<Type> = [];
            for item in anonymous.types { out.push(readonly-of(item)); }
            Type.anon-record({ fields: anonymous.fields, types: out, name: anonymous.name, })
        }
        union-type(xs) => {
            let out: list<Type> = [];
            for member in xs { out.push(readonly-of(member)); }
            union-of(out)
        }
        _ => resolved,
    }
}

// a type with readonly taken out, at every depth (what it reads, as written)
without-readonly: func(t0: Type) -> Type {
    let resolved = resolve(t0);
    match resolved {
        readonly-type(wrapped) => without-readonly(wrapped),
        // its members may be one once readonly is gone
        union-type(_) => union-of(children(map-children(resolved, without-readonly))),
        _ => map-children(resolved, without-readonly),
    }
}

// whether a type is readonly at its top
is-readonly: func(given: Type) -> bool {
    match resolve(given) {
        readonly-type(_) => true,
        _ => false,
    }
}

// a record type by its fields: in order of their names (one set of fields is one type)
anon-record-of: func(fields: list<string>, types: list<Type>) -> Type {
    let fs: list<string> = [];
    let ts: list<Type> = [];
    let taken: list<string> = [];
    for step in 0..fields.len() {
        let least = -1;
        for index in 0..fields.len() {
            if !contains(taken, fields[index])
                && (least < 0 || text-less(fields[index], fields[least])) { least = index; }
        }
        taken.push(fields[least]);
        fs.push(fields[least]);
        ts.push(types[least]);
    }
    Type.anon-record({ fields: fs, types: ts, name: "", })
}

// whether a sorts before b, byte by byte
text-less: func(one: string, other: string) -> bool {
    let shorter = if one.len() < other.len() { one.len() } else { other.len() };
    for index in 0..shorter {
        if one.byte-at(index) != other.byte-at(index) { return one.byte-at(index) < other.byte-at(index); }
    }
    one.len() < other.len()
}

flatten-union: func(given: Type, out: list<Type>) {
    match given {
        union-type(xs) => { for member in xs { flatten-union(resolve(member), out); } }
        _ => out.push(given),
    }
}

// the type a value is held as: a literal's, its base; a union's, its kinds (one kind: that kind's
// type; more: a union of the kinds, a tag and a field for each)
representation: func(given: Type) -> Type {
    match resolve(given) {
        singleton(single) => single.base,
        range-type(range) => range.base,
        union-type(xs) => {
            let reps: list<Type> = [];
            for member in xs { reps.push(represented(member)); }
            kinds-union(reps)
        }
        _ => resolve(given),
    }
}

// the union of kinds of values: each once, in order of how they show (so one set of kinds is one
// C type); one kind is that kind
kinds-union: func(reps: list<Type>) -> Type {
    let kinds: list<Type> = [];
    let shown: list<string> = [];
    for representing in reps {
        let parts = union-members(representing);
        for part in parts {
            let key = show-type(part);
            if !contains(shown, key) {
                kinds.push(part);
                shown.push(key);
            }
        }
    }
    shown-union(kinds, shown)
}

// the union of members (each shown as shown[index]), in order of how they show: each turn, the least not
// taken (one type: itself)
shown-union: func(members: list<Type>, shown: list<string>) -> Type {
    if members.len() == 1 { return members[0]; }
    let out: list<Type> = [];
    let taken: list<string> = [];
    for step in 0..members.len() {
        let least = -1;
        for index in 0..members.len() {
            if !contains(taken, shown[index])
                && (least < 0 || text-less(shown[index], shown[least])) { least = index; }
        }
        taken.push(shown[least]);
        out.push(members[least]);
    }
    Type.union-type(out)
}

// a union's members (another type: itself)
union-members: func(whole: Type) -> list<Type> {
    match resolve(whole) {
        union-type(members) => members,
        _ => [whole,],
    }
}

// a union's kinds (a type of one kind: itself)
kinds: func(given: Type) -> list<Type> {
    match representation(given) {
        union-type(xs) => xs,
        _ => [representation(given),],
    }
}

// a type with the literal and union types taken out, as C holds its values (at every depth)
// a type with each distinct type its base, deep (what the back end and WIT see: checking is done)
erase-distinct: func(t0: Type) -> Type {
    let resolved = resolve(t0);
    match resolved {
        distinct-type(distinct) => erase-distinct(distinct.base),
        _ => map-children(resolved, erase-distinct),
    }
}

// a seq's item type (any other type: itself)
seq-item: func(given: Type) -> Type {
    match resolve(given) {
        seq-type(item) => item,
        _ => given,
    }
}

represented: func(t0: Type) -> Type {
    let base = representation(t0);
    match base {
        // held as what it reads; a distinct type as its base
        readonly-type(wrapped) => represented(wrapped),
        distinct-type(distinct) => represented(distinct.base),
        union-type(_) => base,
        _ => map-children(base, represented),
    }
}

// whether a (represented) type holds a union of kinds anywhere a conversion reaches: itself, an
// option's, a result's or a tuple's
has-kinds: func(given: Type) -> bool {
    match given {
        union-type(_) => true,
        option-type(inner) => has-kinds(inner),
        result-type(outcome) => has-kinds(outcome.ok) || has-kinds(outcome.err),
        tuple-type(xs) => {
            for item in xs {
                if has-kinds(item) { return true; }
            }
            false
        }
        anon-record(anonymous) => {
            for item in anonymous.types {
                if has-kinds(item) { return true; }
            }
            false
        }
        _ => false,
    }
}

// whether a type is not held as written (it holds a literal type, or a union not of its kinds)
needs-representing: func(given: Type) -> bool {
    has-set-types(given) && show-type(represented(given)) != show-type(given)
}

// whether a type holds a literal or union type anywhere
has-set-types: func(t0: Type) -> bool {
    let resolved = resolve(t0);
    match resolved {
        singleton(_) => true,
        range-type(_) => true,
        union-type(_) => true,
        // not held as written (as what it reads)
        readonly-type(_) => true,
        _ => any-child(resolved, has-set-types),
    }
}

// a signature's type, its type parameters' names made parameters
generalize: func(given: Type, tps: list<string>) -> Type {
    match given {
        named(name) => if contains(tps, name-text(name)) { Type.param(name-text(name)) } else { given },
        _ => map-children(given, { child -> generalize(child, tps) }),
    }
}

// a type with its parameters replaced (a call's fresh variables)
substitute: func(given: Type, replacements: map<string, Type>) -> Type {
    match given {
        param(name) => if replacements.has(name) { replacements[name] } else { given },
        // a parameter made a type: readonly where it reaches (list<T> & readonly with T a list)
        readonly-type(wrapped) => readonly-of(substitute(wrapped, replacements)),
        _ => map-children(given, { child -> substitute(child, replacements) }),
    }
}

// ================================================================ a type's parts

// whether a type is an error's (what an expression the checker found wrong has)
is-error: func(given: Type) -> bool {
    match resolve(given) {
        error-type => true,
        _ => false,
    }
}

// whether a type is never's (a call of it does not return)
is-never: func(given: Type) -> bool {
    match resolve(given) {
        never-type => true,
        _ => false,
    }
}

// the types a type is made of: a list's item, a map's key and value, a func's parameters and
// result, an option's, a result's sides, a tuple's, an anonymous record's and a union's members,
// what readonly, a future, a seq, a stream and a distinct type hold; a declared type's (named) none
children: func(t0: Type) -> list<Type> {
    let resolved = resolve(t0);
    match resolved {
        list-type(item) => [item,],
        fixed-list(fixed) => [fixed.item,],
        func-type(signature) => {
            let out: list<Type> = [];
            for parameter in signature.params { out.push(parameter); }
            out.push(signature.result);
            out
        }
        map-type(mapping) => [mapping.key, mapping.value,],
        option-type(inner) => [inner,],
        result-type(outcome) => [outcome.ok, outcome.err,],
        tuple-type(xs) => xs,
        anon-record(anonymous) => anonymous.types,
        union-type(xs) => xs,
        readonly-type(wrapped) => [wrapped,],
        future-type(inner) => [inner,],
        seq-type(item) => [item,],
        stream-type(streamed) => [streamed.item,],
        distinct-type(distinct) => [distinct.base,],
        _ => [],
    }
}

// how many parts a type is made of (children's), and each by its index: a walk over them makes
// nothing
child-count: func(t0: Type) -> s64 {
    let resolved = resolve(t0);
    match resolved {
        list-type(_) => 1,
        fixed-list(_) => 1,
        func-type(signature) => signature.params.len() + 1,
        map-type(_) => 2,
        option-type(_) => 1,
        result-type(_) => 2,
        tuple-type(xs) => xs.len(),
        anon-record(anonymous) => anonymous.types.len(),
        union-type(xs) => xs.len(),
        readonly-type(_) => 1,
        future-type(_) => 1,
        seq-type(_) => 1,
        stream-type(_) => 1,
        distinct-type(_) => 1,
        _ => 0,
    }
}

child: func(t0: Type, index: s64) -> Type {
    let resolved = resolve(t0);
    match resolved {
        list-type(item) => item,
        fixed-list(fixed) => fixed.item,
        func-type(signature) => if index < signature.params.len() { signature.params[index] } else { signature.result },
        map-type(mapping) => if index == 0 { mapping.key } else { mapping.value },
        option-type(inner) => inner,
        result-type(outcome) => if index == 0 { outcome.ok } else { outcome.err },
        tuple-type(xs) => xs[index],
        anon-record(anonymous) => anonymous.types[index],
        union-type(xs) => xs[index],
        readonly-type(wrapped) => wrapped,
        future-type(inner) => inner,
        seq-type(item) => item,
        stream-type(streamed) => streamed.item,
        distinct-type(distinct) => distinct.base,
        _ => panic("a type read past its parts"),
    }
}

// a type made of other parts (those children gives, in its order)
rebuild: func(t0: Type, cs: list<Type>) -> Type {
    let resolved = resolve(t0);
    match resolved {
        list-type(_) => Type.list-type(cs[0]),
        fixed-list(fixed) => Type.fixed-list({ item: cs[0], len: fixed.len, }),
        func-type(_) => Type.func-type({ params: cs.slice(0, cs.len() - 1), result: cs[cs.len() - 1], }),
        map-type(_) => Type.map-type({ key: cs[0], value: cs[1], }),
        option-type(_) => Type.option-type(cs[0]),
        result-type(_) => Type.result-type({ ok: cs[0], err: cs[1], }),
        tuple-type(_) => Type.tuple-type(cs),
        anon-record(anonymous) => Type.anon-record({ fields: anonymous.fields, types: cs, name: anonymous.name, }),
        union-type(_) => Type.union-type(cs),
        readonly-type(_) => Type.readonly-type(cs[0]),
        future-type(_) => Type.future-type(cs[0]),
        seq-type(_) => Type.seq-type(cs[0]),
        stream-type(streamed) => Type.stream-type({ item: cs[0], writer: streamed.writer, }),
        distinct-type(distinct) => Type.distinct-type({ name: distinct.name, base: cs[0], }),
        _ => resolved,
    }
}

// a type with each of its parts f's
map-children: func(given: Type, transform: func(Type) -> Type) -> Type {
    let cs = children(given);
    if cs.len() == 0 { return resolve(given); }
    let out: list<Type> = [];
    for child in cs { out.push(transform(child)); }
    rebuild(given, out)
}

// whether f holds for any of a type's parts
any-child: func(given: Type, holds: func(Type) -> bool) -> bool {
    for index in 0..child-count(given) {
        if holds(child(given, index)) { return true; }
    }
    false
}
