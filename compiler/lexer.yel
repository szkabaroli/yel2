// The lexer: a source's bytes to tokens, with their spans.

// a multiline string: its text (dedented, its first and last line breaks gone), its indent, and
// where it ends (just past its closing """)
record Multiline { text: string, indent: s64, end: s64, }

module lexer {
    // an error at line:col (a character's width), kept: the lexer goes on past it (an unterminated
    // literal taken to the end of the file, an unexpected character passed over)
    lex-error: func(context: Context, source: s64, line: s64, col: s64, message: string) {
        let at: Span = { source: source, line: line, col: col, end-line: line, end-col: col + 1, };
        diagnostics.report(context, diagnostics.error(at, message, ""));
    }

    operators: func() -> list<string> {
        // << and >> are two tokens, so list<list<T>> closes twice; the parser joins adjacent ones
        [
            "...", "..=", "->", "=>", "..", "==", "!=", "<=", ">=", "&&", "||", "+=", "-=", "*=",
            "/=",
            "%=",
            "+", "-", "*", "/", "%", "<", ">", "=", "!", "|", "&", "^", "(", ")", "\{", "\}", "[",
            "]",
            ",", ";", ":", ".", "@", "?",
        ]
    }

    operator-at: func(src: string, i: s64, ops: list<string>) -> string {
        for op in ops {
            if starts-at(src, i, op) { return op; }
        }
        ""
    }

    // whether the % at i, a name's letter after it, is a name's escape (%in) and not a remainder:
    // where nothing is before it that a value ends (a name, a number, a string, a closing bracket),
    // or a space is (a % b is a remainder, a %b a name after a)
    escapes: func(src: string, i: s64, toks: list<Token>) -> bool {
        if toks.len() == 0 || i == 0 { return true; }
        let before = src.byte-at(i - 1);
        if before == 32 || before == 9 || before == 10 || before == 13 { return true; }
        let last = toks[toks.len() - 1];
        match last.kind {
            id => false,
            int => false,
            float => false,
            str => false,
            string-end => false,
            char => false,
            op => !(last.text == ")" || last.text == "]" || last.text == "\}"),
            _ => true,
        }
    }

    // whether a / starts a regex literal: nothing before it a value ends (a name, a number, a
    // string, a closing bracket), but a keyword (return /a/, match /a/.test(…))
    regex-starts: func(toks: list<Token>) -> bool {
        if toks.len() == 0 { return true; }
        let last = toks[toks.len() - 1];
        match last.kind {
            id => !last.escaped && (last.text == "return" || last.text == "in" || last.text == "if" || last.text == "else"
                || last.text == "match" || last.text == "wait" || last.text == "start" || last.text == "yield" || last.text == "is"
                || last.text == "as" || last.text == "let"),
            int => false,
            float => false,
            str => false,
            string-end => false,
            char => false,
            regex => false,
            op => !(last.text == ")" || last.text == "]" || last.text == "\}"),
            _ => true,
        }
    }

    // where the regex literal at i ends (past its flags), 0 for none: a / not closed on its line
    // (a / in a class or after a \ is its pattern's)
    regex-end: func(src: string, i: s64) -> s64 {
        let at = i + 1;
        let in-class = false;
        loop {
            if at >= src.len() { return 0; }
            let b = src.byte-at(at);
            if b == 10 { return 0; }
            if b == 92 {
                at += 2;
                continue;
            }
            if b == 91 { in-class = true; }
            else if b == 93 { in-class = false; }
            else if b == 47 && !in-class { break; }
            at += 1;
        }
        if at == i + 1 { return 0; }
        at += 1;
        loop {
            if at >= src.len() || !is-alpha(src.byte-at(at)) { break; }
            at += 1;
        }
        at
    }

    token: func(kind: TokenKind, text: string, span: Span) -> Token {
        { kind: kind, text: text, span: span, indent: -1, template: false, start: 0, end: 0, escaped: false, }
    }

    // a whole file's tokens: each string in pieces (its quotes, its text as written, each
    // interpolation's braces, expression and format: TokenKind's), every token's bytes (start,
    // end) its place in src. What is between tokens (whitespace, comments) the syntax tree takes
    // from src; a character no token starts with is a token of its own (unknown), told
    lex-file: func(src: string, context: Context, source: s64) -> list<Token> {
        scan(src, context, source, 1, 1, false)
    }

    // (quiet: no error told, an interpolation's expression's: a string's braces may be no
    // interpolation where it is read, @c(name = "…"), so the parser tells what is wrong in one it
    // reads)
    scan: func(
        src: string,
        context: Context,
        source: s64,
        first-line: s64,
        first-col: s64,
        quiet: bool,
    ) -> list<Token> {
        let toks = [];
        let ops = operators();
        let n = src.len();
        let i = 0;
        let line = first-line;
        // where line starts, so that byte i is at column i - line-start + 1
        let line-start = 1 - first-col;
        for step in 0..n + 1 {
            if i >= n {
                let col = i - line-start + 1;
                toks.push(token(TokenKind.eof, "", {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: col,
                }));
                return toks;
            }
            let c = src.byte-at(i);
            let col = i - line-start + 1;
            let at = i;
            let count = toks.len();
            if c == 10 {
                line += 1;
                i += 1;
                line-start = i;
            } else if c == 32 || c == 9 || c == 13 {
                i += 1;
            } else if c == 47 && src.byte-at(i + 1) == 47 {
                // (a comment: the syntax tree's, between tokens)
                i = line-end(src, i);
            } else if c == 99 && src.byte-at(i + 1) == 34 && !is-name-char(src.byte-at(i - 1)) {
                // c"...": a C template
                let end = template-end(src, i + 2);
                if end >= n {
                    if !quiet { lex-error(context, source, line, col, "unterminated C template"); }
                    end = n;
                }
                // (its line breaks counted: a template spans lines, and what follows is on the
                // line after its last)
                let start-line = line;
                line += newlines(src, i, end);
                let nl = last-newline(src, i, end);
                if nl >= 0 { line-start = nl + 1; }
                pieces(src, context, source, toks, quiet, i, 2, end, start-line, col, true);
                i = end + 1;
            } else if c == 35 && i + 1 < src.len() && is-alpha(src.byte-at(i + 1)) {
                // #name: a directive (#file, #caller-location), one token
                let end = name-end(src, i + 1);
                toks.push(token(TokenKind.id, src.substring(i, end), {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: end - line-start + 1,
                }));
                i = end;
            } else if c == 47 && i + 1 < n && src.byte-at(i + 1) != 47 && regex-starts(toks) && regex-end(src, i) > 0 {
                // /pattern/flags: a regex literal, where no value is before the / (else a division)
                let end = regex-end(src, i);
                toks.push(token(TokenKind.regex, src.substring(i, end), {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: end - line-start + 1,
                }));
                i = end;
            } else if c == 37 && i + 1 < src.len() && is-alpha(src.byte-at(i + 1)) && escapes(src, i, toks) {
                // %name: a name, though a keyword's word (as WIT's %record): its text the name's
                let end = name-end(src, i + 1);
                let named = token(TokenKind.id, src.substring(i + 1, end), {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: end - line-start + 1,
                });
                named.escaped = true;
                toks.push(named);
                i = end;
            } else if is-alpha(c) {
                let end = name-end(src, i);
                toks.push(token(TokenKind.id, src.substring(i, end), {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: end - line-start + 1,
                }));
                i = end;
            } else if is-digit(c) {
                // after a `.` a number takes no fraction: t.0.1 is two tuple fields
                let after-dot = toks.len() > 0 && toks[toks.len() - 1].text == "." && toks[
                    toks.len() - 1
                ].kind == TokenKind.op;
                let num = number-end(src, i, !after-dot);
                let kind = if num.is-float { TokenKind.float } else { TokenKind.int };
                toks.push(token(kind, src.substring(i, num.end), {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: num.end - line-start + 1,
                }));
                i = num.end;
            } else if c == 39 {
                let end = char-end(src, i + 1);
                if end >= n {
                    if !quiet { lex-error(context, source, line, col, "unterminated character"); }
                    end = n;
                }
                toks.push(token(TokenKind.char, src.substring(i + 1, end), {
                    source: source,
                    line: line,
                    col: col,
                    end-line: line,
                    end-col: end + 1 - line-start + 1,
                }));
                i = end + 1;
            } else if c == 34 && src.byte-at(i + 1) == 34 && src.byte-at(i + 2) == 34 {
                let m = multiline(src, context, source, i, line, col, quiet);
                let start-line = line;
                line += newlines(src, i, m.end);
                // (one with no line break, an error's: the line goes on)
                let nl = last-newline(src, i, m.end);
                if nl >= 0 { line-start = nl + 1; }
                // (its closing """ where it has one: else its text runs to the file's end)
                let close = if m.end >= 3 && m.end <= n && starts-at(src, m.end - 3, "\"\"\"") && m.end - 3 >= i + 3 { m.end - 3 } else { n };
                let opened = toks.len();
                pieces(src, context, source, toks, quiet, i, 3, close, start-line, col, false);
                // (its indent on its opening quote)
                let opening = toks[opened];
                opening.indent = m.indent;
                toks[opened] = opening;
                i = m.end;
            } else if c == 34 {
                let end = string-end(src, i + 1);
                if end >= n {
                    if !quiet { lex-error(context, source, line, col, "unterminated string"); }
                    end = n;
                }
                let start-line = line;
                line += newlines(src, i, end);
                let nl = last-newline(src, i, end);
                if nl >= 0 { line-start = nl + 1; }
                pieces(src, context, source, toks, quiet, i, 1, end, start-line, col, false);
                i = end + 1;
            } else {
                let op = operator-at(src, i, ops);
                if op == "" {
                    // passed over whole (a UTF-8 sequence's continuation bytes too), and shown so
                    let first = i;
                    i += 1;
                    loop {
                        if i >= n || src.byte-at(i) < 128 || src.byte-at(i) >= 192 { break; }
                        i += 1;
                    }
                    toks.push(token(TokenKind.unknown, src.substring(first, i), {
                        source: source,
                        line: line,
                        col: col,
                        end-line: line,
                        end-col: i - line-start + 1,
                    }));
                    if !quiet {
                        lex-error(
                            context,
                            source,
                            line,
                            col,
                            "unexpected character '{src.substring(first, i)}'",
                        );
                    }
                } else {
                    toks.push(token(TokenKind.op, op, {
                        source: source,
                        line: line,
                        col: col,
                        end-line: line,
                        end-col: col + op.len(),
                    }));
                    i += op.len();
                }
            }
            // the token just made: its bytes (a string's pieces have theirs)
            if toks.len() > count && toks[toks.len() - 1].end == 0 {
                // (a token is a value: the list's copy changed, then put back)
                let made = toks[toks.len() - 1];
                made.start = at;
                made.end = i;
                toks[toks.len() - 1] = made;
            }
        }
        panic("{context.sources[source].path}: the lexer did not finish")
    }

    // a string's pieces (lex-file's), its opening quote at open (width bytes: " c" """), its
    // closing one at close (none where close is past the text: an unterminated string), on line at
    // col: the quote, its text as written up to each interpolation, each interpolation ({, its
    // expression's tokens, : and its format where it has one, }), the closing quote. As the parser
    // reads a string: a \ takes its escape whole (\u\{…\} too); a { opens an interpolation (in a C
    // template only before a name or a paren), its expression up to the last : outside brackets
    // and strings before its }
    pieces: func(
        src: string,
        context: Context,
        source: s64,
        toks: list<Token>,
        quiet: bool,
        open: s64,
        width: s64,
        close: s64,
        line: s64,
        col: s64,
        template: bool,
    ) {
        let n = src.len();
        let end = if close < n { close } else { n };
        let opening = piece(src, source, TokenKind.string-start, open, open + width, open, line, col);
        opening.template = template;
        toks.push(opening);
        let text-from = open + width;
        let at = open + width;
        loop {
            if at >= end { break; }
            let byte = src.byte-at(at);
            if byte == 92 {
                at += escape-width(src, at, end);
            } else if byte == 123 && (!template || opens-interp(src, at)) {
                if at > text-from { toks.push(piece(src, source, TokenKind.string-text, text-from, at, open, line, col)); }
                toks.push(piece(src, source, TokenKind.interp-start, at, at + 1, open, line, col));
                let closing = brace-end(src, at + 1, end);
                let colon = spec-colon(src, at + 1, closing);
                let code-end = if colon < 0 { closing } else { colon };
                // the expression's tokens, lexed where they are
                let code-place = place-in(src, open, line, col, at + 1);
                let code = scan(src.substring(at + 1, code-end), context, source, code-place.line, code-place.col, true);
                for t in code {
                    if t.kind == TokenKind.eof { continue; }
                    let moved = t;
                    moved.start = t.start + at + 1;
                    moved.end = t.end + at + 1;
                    toks.push(moved);
                }
                if colon >= 0 {
                    toks.push(piece(src, source, TokenKind.op, colon, colon + 1, open, line, col));
                    toks.push(piece(src, source, TokenKind.format-spec, colon + 1, closing, open, line, col));
                }
                if closing < end {
                    toks.push(piece(src, source, TokenKind.interp-end, closing, closing + 1, open, line, col));
                    at = closing + 1;
                } else {
                    at = end;
                }
                text-from = at;
            } else {
                at += 1;
            }
        }
        if end > text-from { toks.push(piece(src, source, TokenKind.string-text, text-from, end, open, line, col)); }
        // (its closing quote: one ", or """)
        let closer = if width == 3 { 3 } else { 1 };
        if close < n { toks.push(piece(src, source, TokenKind.string-end, close, close + closer, open, line, col)); }
    }

    // a piece of a string: from..to of src, its place found from the string's start (open, on
    // line at col)
    piece: func(src: string, source: s64, kind: TokenKind, from: s64, to: s64, open: s64, line: s64, col: s64) -> Token {
        let first = place-in(src, open, line, col, from);
        let last = place-in(src, open, line, col, to);
        {
            kind: kind,
            text: src.substring(from, to),
            span: { source: source, line: first.line, col: first.col, end-line: last.line, end-col: last.col, },
            indent: -1,
            template: false,
            start: from,
            end: to,
            escaped: false,
        }
    }

    // the line and column of byte at, src's byte open being on line at col
    place-in: func(src: string, open: s64, line: s64, col: s64, at: s64) -> Span {
        let nl = last-newline(src, open, at);
        let found-line = line + newlines(src, open, at);
        let found-col = if nl < 0 { col + at - open } else { at - nl };
        { source: -1, line: found-line, col: found-col, end-line: found-line, end-col: found-col, }
    }

    // how many bytes the escape at at takes (\u\{…\}: to its \}; any other two)
    escape-width: func(src: string, at: s64, end: s64) -> s64 {
        if at + 2 < end && src.byte-at(at + 1) == 117 && src.byte-at(at + 2) == 123 {
            for index in at + 3..end {
                if src.byte-at(index) == 125 { return index + 1 - at; }
                if index - at > 10 { return 2; }
            }
        }
        2
    }

    // the } closing an interpolation whose expression starts at from (strings in it skipped); end
    // where none is before it
    brace-end: func(src: string, from: s64, end: s64) -> s64 {
        let at = from;
        let depth = 1;
        loop {
            if at >= end { return end; }
            let byte = src.byte-at(at);
            if byte == 34 {
                at = string-end(src, at + 1) + 1;
            } else {
                if byte == 123 { depth += 1; }
                if byte == 125 {
                    depth -= 1;
                    if depth == 0 { return at; }
                }
                at += 1;
            }
        }
        end
    }

    // where an interpolation's format starts (its colon) between from and to: the last colon
    // outside brackets, strings and chars; -1 for none
    spec-colon: func(src: string, from: s64, to: s64) -> s64 {
        let depth = 0;
        let colon = -1;
        let at = from;
        loop {
            if at >= to { break; }
            let byte = src.byte-at(at);
            if byte == 34 {
                at = string-end(src, at + 1);
            } else if byte == 39 {
                // a char: past its closing quote (an escaped one skipped)
                at += 1;
                loop {
                    if at >= to || src.byte-at(at) == 39 { break; }
                    at += if src.byte-at(at) == 92 { 2 } else { 1 };
                }
            } else if byte == 40 || byte == 91 || byte == 123 {
                depth += 1;
            } else if byte == 41 || byte == 93 || byte == 125 {
                depth -= 1;
            } else if byte == 58 && depth == 0 {
                colon = at;
            }
            at += 1;
        }
        colon
    }

    // the multiline string (WAVE's) whose opening """ is at i, on line (at col): """ and a line
    // break open it, a line break, spaces and """ close it, and each line gives up as many spaces
    // as the closing """ has before it. One error in it is the one told: past it, the string is
    // taken to its closing """ where that is plain, else to the end of the file
    multiline: func(
        src: string,
        context: Context,
        source: s64,
        i: s64,
        line: s64,
        col: s64,
        quiet: bool,
    ) -> Multiline {
        let first = i + 3;
        if src.byte-at(first) == 13 && src.byte-at(first + 1) == 10 { first += 2; }
        else if src.byte-at(first) == 10 { first += 1; }
        else {
            if !quiet { lex-error(context, source, line, col, "a \"\"\" string's text starts on the next line"); }
            return { text: "", indent: 0, end: triple-end(src, first) + 3, };
        }
        let close = triple-end(src, first);
        if close >= src.len() {
            if !quiet { lex-error(context, source, line, col, "unterminated multiline string"); }
            return { text: "", indent: 0, end: src.len(), };
        }
        let indent = spaces-before(src, first, close);
        // the line break before the closing line's spaces (the opening's own, for an empty string)
        let brk = close - indent - 1;
        if src.byte-at(brk) != 10 {
            let at-line = line + newlines(src, i, close);
            if !quiet { lex-error(
                context,
                source,
                at-line,
                close - last-newline(src, i, close),
                "a multiline string's closing \"\"\" goes on a line of its own (in its text, break up \"\"\" by escaping a quote after the first)",
            ); }
            // where the string ends is not plain: the rest of the file with it
            return { text: "", indent: 0, end: src.len(), };
        }
        if brk < first { return { text: "", indent: indent, end: close + 3, }; }
        let stop = brk;
        if stop > first && src.byte-at(stop - 1) == 13 { stop -= 1; }
        // each line, its indent taken off (an empty line has none to give)
        let lines: list<string> = [];
        let start = first;
        let number = line + 1;
        for step in 0..stop - first + 2 {
            let e = line-end(src, start);
            if e > stop { e = stop; }
            let text = src.substring(start, e);
            if text.len() > 0 && src.byte-at(e - 1) == 13 {
                text = text.substring(0, text.len() - 1);
            }
            if text.len() > 0 {
                if spaces-before(text, 0, indent) < indent || text.len() < indent {
                    if !quiet { lex-error(
                        context,
                        source,
                        number,
                        1,
                        "this line of a multiline string is indented less than its closing \"\"\" ({indent} spaces)",
                    ); }
                }
                text = text.substring(indent, text.len());
            }
            lines.push(text);
            if e >= stop {
                return { text: lines.join(from-byte(10)), indent: indent, end: close + 3, };
            }
            start = e + 1;
            number += 1;
        }
        { text: lines.join(from-byte(10)), indent: indent, end: close + 3, }
    }

    // where a multiline string's closing """ is: the first """ in its text outside an
    // interpolation, even one after a backslash (WAVE prohibits \""", as its readers see """ first)
    triple-end: func(src: string, from: s64) -> s64 {
        let n = src.len();
        let i = from;
        let depth = 0;
        for step in 0..n + 1 {
            if i >= n { return n; }
            let c = src.byte-at(i);
            if c == 92 {
                if depth == 0 && src.byte-at(i + 1) == 34 && src.byte-at(i + 2) == 34
                    && src.byte-at(i + 3) == 34 {
                    return i + 1;
                }
                i += 2;
            } else if c == 34 && depth == 0 {
                if src.byte-at(i + 1) == 34 && src.byte-at(i + 2) == 34 { return i; }
                i += 1;
            } else if c == 34 {
                i = string-end(src, i + 1) + 1;
            } else {
                if c == 123 { depth += 1; }
                if c == 125 { depth -= 1; }
                i += 1;
            }
        }
        n
    }

    // how many spaces come just before to (none before from)
    spaces-before: func(s: string, from: s64, to: s64) -> s64 {
        for k in 0..to - from {
            if s.byte-at(to - 1 - k) != 32 { return k; }
        }
        to - from
    }
}
