// Types as sets of values (semantic subtyping): a type is the set of values it holds, a subtype a
// subset, and union, intersection and difference are the set operations. Whether a match covers its
// value is whether the value's type minus its arms' patterns is empty; what is left names a value
// no arm fits.
//
// The values are partitioned by kind: (), the bools, each number type's, the chars, the strings,
// the tagged products (a tuple, some and none, ok and err, a declared record, a declared variant's
// case), and the opaque types, held whole and told apart by identity alone (a list, a func, a map,
// a buffer, a flags type, a resource, a type parameter: a mutable value's type is invariant).
//
// A declared record, variant or enum is a nominal atom: its own values, no other type's. It is
// held whole (a ref) until another set restricts it (a pattern looking inside), and only then
// opened one level into its products, whose fields hold refs again: so a recursive declaration is
// never opened further than a pattern reaches.

// a set of values of one kind, by key: vals, or (co) every value but vals
record ValueSet { co: bool, vals: list<string>, }

// what a set's keys are of
type key-kind = "int" | "float" | "char" | "string";

// a float type's values (kind: f32, f64)
resource NumSet { kind: string, set: ValueSet, }

// an integer type's values, or the chars (kind: s8 to u64, char): ranges apart and in order, each
// from lo to hi (a u64's moved down by 2^63, so the order holds in an s64)
resource IntSet { kind: string, ranges: list<Interval>, }

record Interval { lo: s64, hi: s64, }

// one tagged product: its tag (some, none, ok, err, tuple/N, a record's key, a variant's key.case),
// the declared type it is one of (owner, "" for none), and its fields' sets
record Atom { tag: string, owner: string, fields: list<SemType>, }

// the products every pos atom holds and no neg atom does
resource Conj { pos: list<Atom>, neg: list<Atom>, }

resource SemType {
    units: bool,
    // 1: true, 2: false
    bools: s64,
    nums: list<NumSet>,
    // the integers' and the chars' (ranges)
    ints: list<IntSet>,
    strings: ValueSet,
    opaque: ValueSet,
    // the declared records, variants and enums held whole, by key
    refs: list<string>,
    // a union of conjunctions
    products: list<Conj>,
}

module semtype {
    // ================================================================ building

    nothing: func() -> SemType {
        {
            units: false,
            bools: 0,
            nums: [],
            ints: [],
            strings: no-values(),
            opaque: no-values(),
            refs: [],
            products: [],
        }
    }

    no-values: func() -> ValueSet { { co: false, vals: [], } }

    all-values: func() -> ValueSet { { co: true, vals: [], } }

    one-value: func(k: string) -> ValueSet { { co: false, vals: [k,], } }

    // the values of a type as the checker settled it
    translate: func(d: Symbols, t0: Type) -> SemType {
        let t = settled(t0);
        let s = nothing();
        match t {
            num(n) => {
                if is-int(n) { s.ints = [{ kind: n, ranges: domain(n), },]; }
                else { s.nums = [{ kind: n, set: all-values(), },]; }
            }
            bool-type => { s.bools = 3; }
            char-type => { s.ints = [{ kind: "char", ranges: domain("char"), },]; }
            // lo..=hi: its values of its base type
            range-type(r) => {
                let kind = int-kind(r.base);
                let v: list<Interval> = [
                    { lo: key-value(kind, r.lo), hi: key-value(kind, r.hi), },
                ];
                s.ints = [{ kind: kind, ranges: ranges-and(v, domain(kind)), },];
            }
            string-type => { s.strings = all-values(); }
            unit-type => { s.units = true; }
            // never: no value is one (the empty set)
            never-type => {}
            option-type(x) => {
                s.products = [
                    conj(atom("none", "", [])),
                    conj(atom("some", "", [translate(d, x),])),
                ];
            }
            result-type(r) => {
                s.products = [
                    conj(atom("ok", "", side(d, r.ok))),
                    conj(atom("err", "", side(d, r.err))),
                ];
            }
            tuple-type(xs) => {
                let fields: list<SemType> = [];
                for x in xs { fields.push(translate(d, x)); }
                s.products = [conj(atom("tuple/{xs.len()}", "", fields)),];
            }
            union-type(xs) => {
                for x in xs { s = union(s, translate(d, x)); }
            }
            anon-record(r) => {
                let fields: list<SemType> = [];
                for x in r.types { fields.push(translate(d, x)); }
                s.products = [conj(atom(anon-tag(r.fields), "", fields)),];
            }
            // readonly: a list's items covariant (no one writes them through it), as long as they
            // are held one way (its tag, the items' representation); anything else by identity
            readonly-type(x) => {
                match resolve(x) {
                    list-type(y) => {
                        let tag = "readonly-list:" + show-type(represented(y));
                        s.products = [conj(atom(tag, "", [translate(d, y),])),];
                    }
                    _ => { s.opaque = one-value(show-type(t)); }
                }
            }
            singleton(x) => {
                match x.base {
                    bool-type => { s.bools = if x.key == "true" { 1 } else { 2 }; }
                    _ => { s = literal(x.base, x.key); }
                }
            }
            named(n) => {
                if d.records.has(n) || d.variants.has(n) { s.refs = [name-text(n),]; }
                else { s.opaque = one-value(name-text(n)); }
            }
            // a type of its own: none of its values is another type's
            distinct-type(x) => { s.opaque = one-value("distinct " + x.name); }
            _ => { s.opaque = one-value(show-type(t)); }
        }
        s
    }

    // a type, a literal's left open taken as C takes it (an integer's s32, a float's f32)
    settled: func(t0: Type) -> Type {
        let t = resolve(t0);
        match t {
            var(v) => {
                if v.kind == 1 { return Type.num("s32"); }
                if v.kind == 2 { return Type.num("f32"); }
                t
            }
            _ => t,
        }
    }

    // an anonymous record's product's tag: its fields' names
    anon-tag: func(fields: list<string>) -> string { "\{" + fields.join(",") + "\}" }

    // a result's side: its payload's values, or no field when it carries nothing
    side: func(d: Symbols, t: Type) -> list<SemType> {
        match resolve(t) {
            unit-type => [],
            _ => [translate(d, t),],
        }
    }

    atom: func(tag: string, owner: string, fields: list<SemType>) -> Atom {
        { tag: tag, owner: owner, fields: fields, }
    }

    conj: func(a: Atom) -> Conj { { pos: [a,], neg: [], } }

    // the products of a tag (a case of an option, a result or a variant; a tuple; a record)
    product: func(tag: string, owner: string, fields: list<SemType>) -> SemType {
        let s = nothing();
        s.products = [conj(atom(tag, owner, fields)),];
        s
    }

    // the bools: 1 true, 2 false
    bools: func(bits: s64) -> SemType {
        let s = nothing();
        s.bools = bits;
        s
    }

    // one value of a type whose values are keyed (a number's, a char's, a string's)
    literal: func(t: Type, k: string) -> SemType {
        let s = nothing();
        match representation(settled(t)) {
            num(n) => {
                if is-int(n) {
                    let v = key-value(n, k);
                    s.ints = [{ kind: n, ranges: [{ lo: v, hi: v, },], },];
                } else {
                    s.nums = [{ kind: n, set: one-value(k), },];
                }
            }
            char-type => {
                let v = key-value("char", k);
                s.ints = [{ kind: "char", ranges: [{ lo: v, hi: v, },], },];
            }
            string-type => { s.strings = one-value(k); }
            _ => {}
        }
        s
    }

    // a declared type's values, opened one level: a record's one product, a variant's cases
    open-ref: func(d: Symbols, n: string) -> list<Conj> {
        let type-name = intern(n);
        let out: list<Conj> = [];
        if d.records.has(type-name) {
            let fields: list<SemType> = [];
            for t in d.records[type-name].field-types { fields.push(translate(d, t)); }
            out.push(conj(atom(n, n, fields)));
            return out;
        }
        for k in d.variants[type-name].cases {
            let fields: list<SemType> = [];
            // a payload of () carries nothing: no field, as a case declared without one (and as its
            // pattern has: checker.case-type)
            let carries = k.has-payload && match resolve(k.payload) {
                unit-type => false,
                _ => true,
            };
            if carries { fields.push(translate(d, k.payload)); }
            out.push(conj(atom(n + "." + k.name, n, fields)));
        }
        out
    }

    // ================================================================ value sets

    vs-union: func(a: ValueSet, b: ValueSet) -> ValueSet {
        if a.co && b.co { return { co: true, vals: keys-and(a.vals, b.vals), }; }
        if a.co { return { co: true, vals: keys-but(a.vals, b.vals), }; }
        if b.co { return { co: true, vals: keys-but(b.vals, a.vals), }; }
        { co: false, vals: keys-or(a.vals, b.vals), }
    }

    vs-inter: func(a: ValueSet, b: ValueSet) -> ValueSet {
        if a.co && b.co { return { co: true, vals: keys-or(a.vals, b.vals), }; }
        if a.co { return { co: false, vals: keys-but(b.vals, a.vals), }; }
        if b.co { return { co: false, vals: keys-but(a.vals, b.vals), }; }
        { co: false, vals: keys-and(a.vals, b.vals), }
    }

    vs-diff: func(a: ValueSet, b: ValueSet) -> ValueSet {
        vs-inter(a, { co: !b.co, vals: b.vals, })
    }

    vs-empty: func(a: ValueSet) -> bool { !a.co && a.vals.len() == 0 }

    keys-or: func(a: list<string>, b: list<string>) -> list<string> {
        let out: list<string> = [];
        for k in a { out.push(k); }
        for k in b {
            if !contains(a, k) { out.push(k); }
        }
        out
    }

    keys-and: func(a: list<string>, b: list<string>) -> list<string> {
        let out: list<string> = [];
        for k in a {
            if contains(b, k) { out.push(k); }
        }
        out
    }

    keys-but: func(a: list<string>, b: list<string>) -> list<string> {
        let out: list<string> = [];
        for k in a {
            if !contains(b, k) { out.push(k); }
        }
        out
    }

    nums-with: func(
        a: list<NumSet>,
        b: list<NumSet>,
        how: func(ValueSet, ValueSet) -> ValueSet,
    ) -> list<NumSet> {
        let out: list<NumSet> = [];
        let kinds: list<string> = [];
        for x in a { kinds.push(x.kind); }
        for x in b {
            if !contains(kinds, x.kind) { kinds.push(x.kind); }
        }
        for k in kinds {
            let set = how(num-set(a, k), num-set(b, k));
            if !vs-empty(set) { out.push({ kind: k, set: set, }); }
        }
        out
    }

    num-set: func(xs: list<NumSet>, kind: string) -> ValueSet {
        for x in xs {
            if x.kind == kind { return x.set; }
        }
        no-values()
    }

    // ================================================================ integers and chars

    // the values of t (an integer or char type) from lo to hi (one before hi: not inclusive)
    range: func(t: Type, lo: string, hi: string, inclusive: bool) -> SemType {
        let kind = int-kind(representation(settled(t)));
        let l = key-value(kind, lo);
        let h = key-value(kind, hi);
        let s = nothing();
        // hi..hi of the kind's least: no value (h - 1 would wrap to its greatest)
        if !inclusive {
            if h == -9223372036854775807 as s64 - 1 { return s; }
            h = h - 1;
        }
        if l <= h {
            let v: list<Interval> = [{ lo: l, hi: h, },];
            s.ints = [{ kind: kind, ranges: ranges-and(v, domain(kind)), },];
        }
        s
    }

    // the integer kind (or char) of a type
    int-kind: func(t: Type) -> string {
        match resolve(t) {
            num(n) => n,
            char-type => "char",
            _ => "s32",
        }
    }

    // every value of a kind, as ranges (a char: the Unicode scalar values, the surrogates out)
    domain: func(kind: string) -> list<Interval> {
        let s64-min = -9223372036854775807 as s64 - 1;
        let s64-max = 9223372036854775807 as s64;
        if kind == "char" { return [{ lo: 0, hi: 55295, }, { lo: 57344, hi: 1114111, },]; }
        if kind == "s8" { return [{ lo: -128, hi: 127, },]; }
        if kind == "s16" { return [{ lo: -32768, hi: 32767, },]; }
        if kind == "s32" { return [{ lo: -2147483648, hi: 2147483647, },]; }
        if kind == "u8" { return [{ lo: 0, hi: 255, },]; }
        if kind == "u16" { return [{ lo: 0, hi: 65535, },]; }
        if kind == "u32" { return [{ lo: 0, hi: 4294967295, },]; }
        // s64, and u64 moved down by 2^63: all of an s64
        [{ lo: s64-min, hi: s64-max, },]
    }

    // a literal's key (decimal, - before a negative) as the kind's value (a u64's moved down)
    key-value: func(kind: string, k: string) -> s64 {
        let neg = k.len() > 0 && k.byte-at(0) == 45;
        let mag: u64 = 0;
        for i in (if neg { 1 } else { 0 })..k.len() { mag = mag * 10 + (k.byte-at(i) - 48) as u64; }
        if kind == "u64" { return (mag as s64) ^ (-9223372036854775807 as s64 - 1); }
        let v = mag as s64;
        if neg { 0 - v } else { v }
    }

    // a decimal one less, exactly (as text: no width wraps it): "0" is "-1", "-5" is "-6"
    decimal-before: func(k: string) -> string {
        if k == "0" { return "-1"; }
        if k.len() > 0 && k.byte-at(0) == 45 { return "-" + decimal-after(k.substring(1, k.len())); }
        let digits: list<s64> = [];
        for i in 0..k.len() { digits.push(k.byte-at(i) - 48); }
        let i = digits.len() - 1;
        loop {
            if i < 0 { break; }
            if digits[i] > 0 {
                digits[i] = digits[i] - 1;
                break;
            }
            digits[i] = 9;
            i -= 1;
        }
        let out = "";
        let leading = true;
        for d in digits {
            if !(leading && d == 0) {
                leading = false;
                out = out + from-byte(48 + d);
            }
        }
        if out == "" { "0" } else { out }
    }

    // a non-negative decimal one more, exactly
    decimal-after: func(k: string) -> string {
        let digits: list<s64> = [];
        for i in 0..k.len() { digits.push(k.byte-at(i) - 48); }
        let i = digits.len() - 1;
        loop {
            if i < 0 { return "1" + digits-text(digits); }
            if digits[i] < 9 {
                digits[i] = digits[i] + 1;
                return digits-text(digits);
            }
            digits[i] = 0;
            i -= 1;
        }
    }

    digits-text: func(digits: list<s64>) -> string {
        let out = "";
        for d in digits { out = out + from-byte(48 + d); }
        out
    }

    // how two decimals compare: -1, 0 or 1, exactly
    decimal-order: func(a: string, b: string) -> s64 {
        let an = a.len() > 0 && a.byte-at(0) == 45;
        let bn = b.len() > 0 && b.byte-at(0) == 45;
        if an && !bn { return -1; }
        if bn && !an { return 1; }
        let x = if an { a.substring(1, a.len()) } else { a };
        let y = if bn { b.substring(1, b.len()) } else { b };
        let order = 0;
        if x.len() != y.len() { order = if x.len() < y.len() { -1 } else { 1 }; }
        else {
            for i in 0..x.len() {
                if order == 0 && x.byte-at(i) != y.byte-at(i) {
                    order = if x.byte-at(i) < y.byte-at(i) { -1 } else { 1 };
                }
            }
        }
        if an { 0 - order } else { order }
    }

    // the key one before a key of a kind (as a key: decimal, a u64's unsigned), or the key itself
    // at the kind's least
    key-before: func(kind: string, k: string) -> string {
        let v = key-value(kind, k);
        if v == -9223372036854775807 as s64 - 1 { return k; }
        let w = v - 1;
        if kind == "u64" { return "{(w ^ (-9223372036854775807 as s64 - 1)) as u64}"; }
        "{w}"
    }

    // a kind's value as a pattern shows it
    value-text: func(kind: string, v: s64) -> string {
        if kind == "u64" { return "{(v ^ (-9223372036854775807 as s64 - 1)) as u64}"; }
        if kind == "char" {
            if v > 32 && v < 127 && v != 39 && v != 92 { return "'{from-byte(v as s64)}'"; }
            return "{v} as char";
        }
        "{v}"
    }

    // a value of an int set: _ when it is the whole kind, else the one nearest 0 (the least for a
    // u64 or a char, whose order starts there)
    int-sample: func(x: IntSet) -> string {
        let all = domain(x.kind);
        if same-ranges(x.ranges, all) { return "_"; }
        if x.kind == "u64" || x.kind == "char" { return value-text(x.kind, x.ranges[0].lo); }
        for r in x.ranges {
            if r.hi >= 0 { return value-text(x.kind, if r.lo > 0 { r.lo } else { 0 }); }
        }
        value-text(x.kind, x.ranges[x.ranges.len() - 1].hi)
    }

    same-ranges: func(a: list<Interval>, b: list<Interval>) -> bool {
        if a.len() != b.len() { return false; }
        for i in 0..a.len() {
            if a[i].lo != b[i].lo || a[i].hi != b[i].hi { return false; }
        }
        true
    }

    ints-with: func(a: list<IntSet>, b: list<IntSet>, how: string) -> list<IntSet> {
        let kinds: list<string> = [];
        for x in a { kinds.push(x.kind); }
        for x in b {
            if !contains(kinds, x.kind) { kinds.push(x.kind); }
        }
        let out: list<IntSet> = [];
        for k in kinds {
            let ra = int-ranges(a, k);
            let rb = int-ranges(b, k);
            let r = if how == "union" {
                ranges-or(ra, rb)
            } else if how == "inter" {
                ranges-and(ra, rb)
            } else {
                ranges-and(ra, ranges-not(rb, domain(k)))
            };
            if r.len() > 0 { out.push({ kind: k, ranges: r, }); }
        }
        out
    }

    int-ranges: func(xs: list<IntSet>, kind: string) -> list<Interval> {
        for x in xs {
            if x.kind == kind { return x.ranges; }
        }
        []
    }

    // ranges in order and apart: a's and b's, merged where they meet
    ranges-or: func(a: list<Interval>, b: list<Interval>) -> list<Interval> {
        let all: list<Interval> = [];
        let i = 0;
        let j = 0;
        for step in 0..a.len() + b.len() {
            if j >= b.len() || i < a.len() && a[i].lo <= b[j].lo {
                all.push(a[i]);
                i += 1;
            } else {
                all.push(b[j]);
                j += 1;
            }
        }
        let out: list<Interval> = [];
        for x in all {
            if out.len() > 0 {
                let last = out[out.len() - 1];
                // touching or overlapping: one range (the last's hi at the top meets anything)
                if last.hi == 9223372036854775807 as s64 || x.lo <= last.hi + 1 {
                    if x.hi > last.hi { out[out.len() - 1] = { lo: last.lo, hi: x.hi, }; }
                    continue;
                }
            }
            out.push(x);
        }
        out
    }

    ranges-and: func(a: list<Interval>, b: list<Interval>) -> list<Interval> {
        let out: list<Interval> = [];
        for x in a {
            for y in b {
                let lo = if x.lo > y.lo { x.lo } else { y.lo };
                let hi = if x.hi < y.hi { x.hi } else { y.hi };
                if lo <= hi { out.push({ lo: lo, hi: hi, }); }
            }
        }
        ranges-or(out, [])
    }

    // a kind's values not in a
    ranges-not: func(a: list<Interval>, all: list<Interval>) -> list<Interval> {
        let out = all;
        for x in a {
            let next: list<Interval> = [];
            for y in out {
                if x.hi < y.lo || x.lo > y.hi { next.push(y); }
                else {
                    if y.lo < x.lo { next.push({ lo: y.lo, hi: x.lo - 1, }); }
                    if x.hi < y.hi { next.push({ lo: x.hi + 1, hi: y.hi, }); }
                }
            }
            out = next;
        }
        out
    }

    // ================================================================ set operations

    union: func(a: SemType, b: SemType) -> SemType {
        {
            units: a.units || b.units,
            bools: a.bools | b.bools,
            nums: nums-with(a.nums, b.nums, vs-union),
            ints: ints-with(a.ints, b.ints, "union"),
            strings: vs-union(a.strings, b.strings),
            opaque: vs-union(a.opaque, b.opaque),
            refs: keys-or(a.refs, b.refs),
            products: concat-conjs(a.products, b.products),
        }
    }

    inter: func(d: Symbols, a0: SemType, b0: SemType) -> SemType {
        // a declared type the other side restricts, opened
        let a = opened(d, a0, b0);
        let b = opened(d, b0, a0);
        let products: list<Conj> = [];
        for x in a.products {
            for y in b.products {
                products.push({ pos: atoms-and(x.pos, y.pos), neg: atoms-and(x.neg, y.neg), });
            }
        }
        // the products of a declared type the other side holds whole
        for x in a.products {
            if owned-by(x, b.refs) { products.push(x); }
        }
        for y in b.products {
            if owned-by(y, a.refs) { products.push(y); }
        }
        {
            units: a.units && b.units,
            bools: a.bools & b.bools,
            nums: nums-with(a.nums, b.nums, vs-inter),
            ints: ints-with(a.ints, b.ints, "inter"),
            strings: vs-inter(a.strings, b.strings),
            opaque: vs-inter(a.opaque, b.opaque),
            refs: keys-and(a.refs, b.refs),
            products: inhabited-conjs(d, products),
        }
    }

    diff: func(d: Symbols, a0: SemType, b0: SemType) -> SemType {
        let a = opened(d, a0, b0);
        let b = opened(d, b0, a0);
        // the products less each of b's (a conjunction's complement: one of its atoms not held),
        // and less those of a declared type b holds whole
        let rest: list<Conj> = [];
        for x in a.products {
            if !owned-by(x, b.refs) { rest.push(x); }
        }
        for y in b.products {
            let next: list<Conj> = [];
            for x in rest {
                for p in y.pos { next.push({ pos: x.pos, neg: atoms-and(x.neg, [p,]), }); }
                for n in y.neg { next.push({ pos: atoms-and(x.pos, [n,]), neg: x.neg, }); }
            }
            rest = inhabited-conjs(d, next);
        }
        {
            units: a.units && !b.units,
            bools: a.bools & (3 ^ b.bools),
            nums: nums-with(a.nums, b.nums, vs-diff),
            ints: ints-with(a.ints, b.ints, "diff"),
            strings: vs-diff(a.strings, b.strings),
            opaque: vs-diff(a.opaque, b.opaque),
            refs: keys-but(a.refs, b.refs),
            products: rest,
        }
    }

    // a, its declared types the other side looks inside of (and does not hold whole) opened
    opened: func(d: Symbols, a: SemType, other: SemType) -> SemType {
        let refs: list<string> = [];
        let products = concat-conjs(a.products, []);
        for r in a.refs {
            if !contains(other.refs, r) && mentions(other.products, r) {
                for x in open-ref(d, r) { products.push(x); }
            } else {
                refs.push(r);
            }
        }
        {
            units: a.units,
            bools: a.bools,
            nums: a.nums,
            ints: a.ints,
            strings: a.strings,
            opaque: a.opaque,
            refs: refs,
            products: products,
        }
    }

    // whether a conjunction's products are one of the declared types refs
    owned-by: func(x: Conj, refs: list<string>) -> bool {
        for a in x.pos {
            if a.owner != "" && contains(refs, a.owner) { return true; }
        }
        false
    }

    mentions: func(xs: list<Conj>, r: string) -> bool {
        for x in xs {
            for a in x.pos {
                if a.owner == r { return true; }
            }
            for a in x.neg {
                if a.owner == r { return true; }
            }
        }
        false
    }

    atoms-and: func(a: list<Atom>, b: list<Atom>) -> list<Atom> {
        let out: list<Atom> = [];
        for x in a { out.push(x); }
        for x in b { out.push(x); }
        out
    }

    concat-conjs: func(a: list<Conj>, b: list<Conj>) -> list<Conj> {
        let out: list<Conj> = [];
        for x in a { out.push(x); }
        for x in b { out.push(x); }
        out
    }

    inhabited-conjs: func(d: Symbols, xs: list<Conj>) -> list<Conj> {
        let out: list<Conj> = [];
        for x in xs {
            match conj-sample(d, x) {
                some(s) => out.push(x),
                none => {}
            }
        }
        out
    }

    // ================================================================ emptiness, and a value

    is-empty: func(d: Symbols, a: SemType) -> bool {
        match sample(d, a) {
            some(s) => false,
            none => true,
        }
    }

    // a value of the set, shown as a pattern (_ for any value of a part held whole); none when it
    // is empty
    sample: func(d: Symbols, a: SemType) -> option<string> {
        for x in a.products {
            match conj-sample(d, x) {
                some(s) => { return some(s); }
                none => {}
            }
        }
        if a.refs.len() > 0 { return some("_"); }
        if a.units { return some("()"); }
        if a.bools == 3 { return some("_"); }
        if a.bools == 1 { return some("true"); }
        if a.bools == 2 { return some("false"); }
        for n in a.nums {
            if !vs-empty(n.set) {
                return some(key-sample(n.set, if is-int(n.kind) { "int" } else { "float" }));
            }
        }
        for x in a.ints {
            if x.ranges.len() > 0 { return some(int-sample(x)); }
        }
        if !vs-empty(a.strings) { return some(key-sample(a.strings, "string")); }
        if !vs-empty(a.opaque) { return some("_"); }
        none
    }

    // a key of a set not held out of it: _ for every value
    key-sample: func(s: ValueSet, kind: key-kind) -> string {
        if !s.co {
            let k = s.vals[0];
            if kind == "char" { return "'{from-byte(decimal(k))}'"; }
            if kind == "string" { return "\"{k}\""; }
            return k;
        }
        if s.vals.len() == 0 { return "_"; }
        for i in 0..s.vals.len() + 1 {
            let k = if kind == "int" {
                "{i}"
            } else if kind == "float" {
                "{i}.5"
            } else if kind == "char" {
                "{97 + i}"
            } else {
                from-byte(97 + i)
            };
            if !contains(s.vals, k) {
                if kind == "char" { return "'{from-byte(97 + i)}'"; }
                if kind == "string" { return "\"{k}\""; }
                return k;
            }
        }
        "_"
    }

    // a key's digits as a number (a char's code point)
    decimal: func(k: string) -> s64 {
        let v = 0;
        for i in 0..k.len() { v = v * 10 + k.byte-at(i) - 48; }
        v
    }

    // a product every pos atom holds and no neg one does, shown; none when there is none
    conj-sample: func(d: Symbols, x: Conj) -> option<string> {
        if x.pos.len() == 0 { return some("_"); }
        let first = x.pos[0];
        let fields: list<SemType> = [];
        for f in first.fields { fields.push(f); }
        for k in 1..x.pos.len() {
            let a = x.pos[k];
            if a.tag != first.tag { return none; }
            for i in 0..fields.len() { fields[i] = inter(d, fields[i], a.fields[i]); }
        }
        for f in fields {
            if is-empty(d, f) { return none; }
        }
        let negs: list<Atom> = [];
        for a in x.neg {
            if a.tag == first.tag { negs.push(a); }
        }
        match explore(d, fields, negs, 0) {
            some(found) => {
                let shown: list<string> = [];
                for f in found {
                    match sample(d, f) {
                        some(s) => shown.push(s),
                        none => shown.push("_"),
                    }
                }
                some(show-product(d, first, shown))
            }
            none => none,
        }
    }

    // fields (each inhabited) whose products none of negs from i on holds: for each of them, one
    // field outside its field's set (the standard search for a product with negations)
    explore: func(
        d: Symbols,
        fields: list<SemType>,
        negs: list<Atom>,
        i: s64,
    ) -> option<list<SemType>> {
        if i == negs.len() { return some(fields); }
        let n = negs[i];
        for j in 0..fields.len() {
            let rest = diff(d, fields[j], n.fields[j]);
            if !is-empty(d, rest) {
                let next: list<SemType> = [];
                for k in 0..fields.len() { next.push(if k == j { rest } else { fields[k] }); }
                match explore(d, next, negs, i + 1) {
                    some(found) => { return some(found); }
                    none => {}
                }
            }
        }
        none
    }

    show-product: func(d: Symbols, a: Atom, fields: list<string>) -> string {
        if a.tag.starts-with("tuple/") { return "(" + fields.join(", ") + ")"; }
        // an anonymous record's: its fields' names in its tag
        if a.tag == "\{\}" { return "\{\}"; }
        if a.tag.starts-with("\{") {
            let names = a.tag.substring(1, a.tag.len() - 1).split(",");
            let parts: list<string> = [];
            for i in 0..names.len() { parts.push("{names[i]}: {fields[i]}"); }
            return "\{ " + parts.join(", ") + " \}";
        }
        if a.owner != "" && d.records.has(intern(a.owner)) {
            let names = d.records[intern(a.owner)].fields;
            let parts: list<string> = [];
            for i in 0..names.len() { parts.push("{names[i]}: {fields[i]}"); }
            return "\{ " + parts.join(", ") + " \}";
        }
        let name = if a.owner != "" {
            a.tag.substring(a.owner.len() + 1, a.tag.len())
        } else {
            a.tag
        };
        if fields.len() == 1 { return "{name}({fields[0]})"; }
        name
    }

    // ================================================================ literals

    // a literal's key: an integer's value in decimal (- before a negative one), a float's text, a
    // char's code point, a string's text
    literal-key: func(e: Expr) -> string {
        match e.kind {
            int-lit(x) => int-key(x),
            // by its value (1.0 and 1.00 are one; -0.0 and 0.0 are ==, so one too)
            float-lit(x) => {
                let v = parse-f64(x);
                if v == 0.0 { "0.0" } else { "{v}" }
            }
            char-lit(x) => "{x}",
            str-lit(x) => x,
            bool-lit(x) => if x { "true" } else { "false" },
            unary(u) => "-" + literal-key(u.value),
            _ => "",
        }
    }

    // an integer as written (0x, 0o or 0b before it, _ between digits) in decimal
    int-key: func(text: string) -> string {
        let radix: u64 = 10;
        let start = 0;
        if text.len() > 2 && text.byte-at(0) == 48 {
            let r = text.byte-at(1);
            if r == 120 { radix = 16; }
            else if r == 111 { radix = 8; }
            else if r == 98 { radix = 2; }
            if radix != 10 { start = 2; }
        }
        let v: u64 = 0;
        for i in start..text.len() {
            let c = text.byte-at(i);
            if c != 95 { v = v * radix + hex-value(c) as u64; }
        }
        "{v}"
    }
}
