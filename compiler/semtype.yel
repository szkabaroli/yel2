// Types as sets of values (semantic subtyping): a type is the set of values it holds, a subtype a
// subset, and union, intersection and difference are the set operations. Whether a match covers its
// value is whether the value's type minus its arms' patterns is empty; what is left names a value
// no arm fits.
//
// The values are partitioned by kind: (), the bools, each number type's, the chars, the strings,
// the tagged products (a tuple, some and none, ok and err, a declared record, a declared variant's
// case), and the opaque types, held whole and told apart by identity alone (a list, a func, a map,
// a buffer, a flags type, a resource, a type parameter: a mutable value's type is invariant).
//
// A declared record, variant or enum is a nominal atom: its own values, no other type's. It is
// held whole (a ref) until another set restricts it (a pattern looking inside), and only then
// opened one level into its products, whose fields hold refs again: so a recursive declaration is
// never opened further than a pattern reaches.

// a set of values of one kind, by key: vals, or (co) every value but vals
record ValueSet { co: bool, vals: list<string>, }

// what a set's keys are of
type key-kind = "int" | "float" | "char" | "string";

// a float type's values (kind: f32, f64)
resource NumSet { kind: string, set: ValueSet, }

// an integer type's values, or the chars (kind: s8 to u64, char): ranges apart and in order, each
// from lo to hi (a u64's moved down by 2^63, so the order holds in an s64)
resource IntSet { kind: string, ranges: list<Interval>, }

record Interval { lo: s64, hi: s64, }

// one tagged product: its tag (some, none, ok, err, tuple/N, a record's key, a variant's key.case),
// the declared type it is one of (owner, "" for none), and its fields' sets
record Atom { tag: string, owner: string, fields: list<SemType>, }

// the products every pos atom holds and no neg atom does
resource Conj { pos: list<Atom>, neg: list<Atom>, }

resource SemType {
    units: bool,
    // 1: true, 2: false
    bools: s64,
    nums: list<NumSet>,
    // the integers' and the chars' (ranges)
    ints: list<IntSet>,
    strings: ValueSet,
    opaque: ValueSet,
    // the declared records, variants and enums held whole, by key
    refs: list<string>,
    // a union of conjunctions
    products: list<Conj>,
}

module semtype {
    // ================================================================ building

    nothing: func() -> SemType {
        {
            units: false,
            bools: 0,
            nums: [],
            ints: [],
            strings: no-values(),
            opaque: no-values(),
            refs: [],
            products: [],
        }
    }

    no-values: func() -> ValueSet { { co: false, vals: [], } }

    all-values: func() -> ValueSet { { co: true, vals: [], } }

    one-value: func(key: string) -> ValueSet { { co: false, vals: [key,], } }

    // the values of a type as the checker settled it
    translate: func(symbols: Symbols, t0: Type) -> SemType {
        let given = settled(t0);
        let meaning = nothing();
        match given {
            num(name) => {
                if is-int(name) { meaning.ints = [{ kind: name, ranges: domain(name), },]; }
                else { meaning.nums = [{ kind: name, set: all-values(), },]; }
            }
            bool-type => { meaning.bools = 3; }
            char-type => { meaning.ints = [{ kind: "char", ranges: domain("char"), },]; }
            // lo..=hi: its values of its base type
            range-type(range) => {
                let kind = int-kind(range.base);
                let intervals: list<Interval> = [
                    { lo: key-value(kind, range.lo), hi: key-value(kind, range.hi), },
                ];
                meaning.ints = [{ kind: kind, ranges: ranges-and(intervals, domain(kind)), },];
            }
            string-type => { meaning.strings = all-values(); }
            unit-type => { meaning.units = true; }
            // never: no value is one (the empty set)
            never-type => {}
            option-type(inner) => {
                meaning.products = [
                    conj(atom("none", "", [])),
                    conj(atom("some", "", [translate(symbols, inner),])),
                ];
            }
            result-type(outcome) => {
                meaning.products = [
                    conj(atom("ok", "", side(symbols, outcome.ok))),
                    conj(atom("err", "", side(symbols, outcome.err))),
                ];
            }
            tuple-type(xs) => {
                let fields: list<SemType> = [];
                for item in xs { fields.push(translate(symbols, item)); }
                meaning.products = [conj(atom("tuple/{xs.len()}", "", fields)),];
            }
            union-type(xs) => {
                for member in xs { meaning = union(meaning, translate(symbols, member)); }
            }
            anon-record(anonymous) => {
                let fields: list<SemType> = [];
                for item in anonymous.types { fields.push(translate(symbols, item)); }
                meaning.products = [conj(atom(anon-tag(anonymous.fields), "", fields)),];
            }
            // readonly: a list's items covariant (no one writes them through it), as long as they
            // are held one way (its tag, the items' representation); anything else by identity
            readonly-type(wrapped) => {
                match resolve(wrapped) {
                    list-type(item) => {
                        let tag = "readonly-list:" + show-type(represented(item));
                        meaning.products = [conj(atom(tag, "", [translate(symbols, item),])),];
                    }
                    _ => { meaning.opaque = one-value(show-type(given)); }
                }
            }
            singleton(single) => {
                match single.base {
                    bool-type => { meaning.bools = if single.key == "true" { 1 } else { 2 }; }
                    _ => { meaning = literal(single.base, single.key); }
                }
            }
            named(name) => {
                if symbols.records.has(name) || symbols.variants.has(name) { meaning.refs = [name-text(name),]; }
                else { meaning.opaque = one-value(name-text(name)); }
            }
            // a type of its own: none of its values is another type's
            distinct-type(distinct) => { meaning.opaque = one-value("distinct " + distinct.name); }
            _ => { meaning.opaque = one-value(show-type(given)); }
        }
        meaning
    }

    // a type, a literal's left open taken as C takes it (an integer's s32, a float's f32)
    settled: func(t0: Type) -> Type {
        let resolved = resolve(t0);
        match resolved {
            var(variable) => {
                if variable.kind == 1 { return Type.num("s32"); }
                if variable.kind == 2 { return Type.num("f32"); }
                resolved
            }
            _ => resolved,
        }
    }

    // an anonymous record's product's tag: its fields' names
    anon-tag: func(fields: list<string>) -> string { "\{" + fields.join(",") + "\}" }

    // a result's side: its payload's values, or no field when it carries nothing
    side: func(symbols: Symbols, given: Type) -> list<SemType> {
        match resolve(given) {
            unit-type => [],
            _ => [translate(symbols, given),],
        }
    }

    atom: func(tag: string, owner: string, fields: list<SemType>) -> Atom {
        { tag: tag, owner: owner, fields: fields, }
    }

    conj: func(positive: Atom) -> Conj { { pos: [positive,], neg: [], } }

    // the products of a tag (a case of an option, a result or a variant; a tuple; a record)
    product: func(tag: string, owner: string, fields: list<SemType>) -> SemType {
        let meaning = nothing();
        meaning.products = [conj(atom(tag, owner, fields)),];
        meaning
    }

    // the bools: 1 true, 2 false
    bools: func(bits: s64) -> SemType {
        let meaning = nothing();
        meaning.bools = bits;
        meaning
    }

    // one value of a type whose values are keyed (a number's, a char's, a string's)
    literal: func(given: Type, key: string) -> SemType {
        let meaning = nothing();
        match representation(settled(given)) {
            num(name) => {
                if is-int(name) {
                    let value = key-value(name, key);
                    meaning.ints = [{ kind: name, ranges: [{ lo: value, hi: value, },], },];
                } else {
                    meaning.nums = [{ kind: name, set: one-value(key), },];
                }
            }
            char-type => {
                let value = key-value("char", key);
                meaning.ints = [{ kind: "char", ranges: [{ lo: value, hi: value, },], },];
            }
            string-type => { meaning.strings = one-value(key); }
            _ => {}
        }
        meaning
    }

    // a declared type's values, opened one level: a record's one product, a variant's cases
    open-ref: func(symbols: Symbols, name: string) -> list<Conj> {
        let type-name = intern(name);
        let out: list<Conj> = [];
        if symbols.records.has(type-name) {
            let fields: list<SemType> = [];
            for field in symbols.records[type-name].field-types { fields.push(translate(symbols, field)); }
            out.push(conj(atom(name, name, fields)));
            return out;
        }
        for case in symbols.variants[type-name].cases {
            let fields: list<SemType> = [];
            // a payload of () carries nothing: no field, as a case declared without one (and as its
            // pattern has: checker.case-type)
            let carries = case.has-payload && match resolve(case.payload) {
                unit-type => false,
                _ => true,
            };
            if carries { fields.push(translate(symbols, case.payload)); }
            out.push(conj(atom(name + "." + case.name, name, fields)));
        }
        out
    }

    // ================================================================ value sets

    vs-union: func(left: ValueSet, right: ValueSet) -> ValueSet {
        if left.co && right.co { return { co: true, vals: keys-and(left.vals, right.vals), }; }
        if left.co { return { co: true, vals: keys-but(left.vals, right.vals), }; }
        if right.co { return { co: true, vals: keys-but(right.vals, left.vals), }; }
        { co: false, vals: keys-or(left.vals, right.vals), }
    }

    vs-inter: func(left: ValueSet, right: ValueSet) -> ValueSet {
        if left.co && right.co { return { co: true, vals: keys-or(left.vals, right.vals), }; }
        if left.co { return { co: false, vals: keys-but(right.vals, left.vals), }; }
        if right.co { return { co: false, vals: keys-but(left.vals, right.vals), }; }
        { co: false, vals: keys-and(left.vals, right.vals), }
    }

    vs-diff: func(left: ValueSet, right: ValueSet) -> ValueSet {
        vs-inter(left, { co: !right.co, vals: right.vals, })
    }

    vs-empty: func(values: ValueSet) -> bool { !values.co && values.vals.len() == 0 }

    keys-or: func(left: list<string>, right: list<string>) -> list<string> {
        let out: list<string> = [];
        for key in left { out.push(key); }
        for key in right {
            if !contains(left, key) { out.push(key); }
        }
        out
    }

    keys-and: func(left: list<string>, right: list<string>) -> list<string> {
        let out: list<string> = [];
        for key in left {
            if contains(right, key) { out.push(key); }
        }
        out
    }

    keys-but: func(left: list<string>, right: list<string>) -> list<string> {
        let out: list<string> = [];
        for key in left {
            if !contains(right, key) { out.push(key); }
        }
        out
    }

    nums-with: func(
        left: list<NumSet>,
        right: list<NumSet>,
        how: func(ValueSet, ValueSet) -> ValueSet,
    ) -> list<NumSet> {
        let out: list<NumSet> = [];
        let kinds: list<string> = [];
        for entry in left { kinds.push(entry.kind); }
        for entry in right {
            if !contains(kinds, entry.kind) { kinds.push(entry.kind); }
        }
        for kind in kinds {
            let set = how(num-set(left, kind), num-set(right, kind));
            if !vs-empty(set) { out.push({ kind: kind, set: set, }); }
        }
        out
    }

    num-set: func(xs: list<NumSet>, kind: string) -> ValueSet {
        for entry in xs {
            if entry.kind == kind { return entry.set; }
        }
        no-values()
    }

    // ================================================================ integers and chars

    // the values of t (an integer or char type) from lo to hi (one before hi: not inclusive)
    range: func(given: Type, lo: string, hi: string, inclusive: bool) -> SemType {
        let kind = int-kind(representation(settled(given)));
        let low = key-value(kind, lo);
        let high = key-value(kind, hi);
        let meaning = nothing();
        // hi..hi of the kind's least: no value (h - 1 would wrap to its greatest)
        if !inclusive {
            if high == -9223372036854775807 as s64 - 1 { return meaning; }
            high = high - 1;
        }
        if low <= high {
            let intervals: list<Interval> = [{ lo: low, hi: high, },];
            meaning.ints = [{ kind: kind, ranges: ranges-and(intervals, domain(kind)), },];
        }
        meaning
    }

    // the integer kind (or char) of a type
    int-kind: func(given: Type) -> string {
        match resolve(given) {
            num(name) => name,
            char-type => "char",
            _ => "s32",
        }
    }

    // every value of a kind, as ranges (a char: the Unicode scalar values, the surrogates out)
    domain: func(kind: string) -> list<Interval> {
        let s64-min = -9223372036854775807 as s64 - 1;
        let s64-max = 9223372036854775807 as s64;
        if kind == "char" { return [{ lo: 0, hi: 55295, }, { lo: 57344, hi: 1114111, },]; }
        if kind == "s8" { return [{ lo: -128, hi: 127, },]; }
        if kind == "s16" { return [{ lo: -32768, hi: 32767, },]; }
        if kind == "s32" { return [{ lo: -2147483648, hi: 2147483647, },]; }
        if kind == "u8" { return [{ lo: 0, hi: 255, },]; }
        if kind == "u16" { return [{ lo: 0, hi: 65535, },]; }
        if kind == "u32" { return [{ lo: 0, hi: 4294967295, },]; }
        // s64, and u64 moved down by 2^63: all of an s64
        [{ lo: s64-min, hi: s64-max, },]
    }

    // a literal's key (decimal, - before a negative) as the kind's value (a u64's moved down)
    key-value: func(kind: string, key: string) -> s64 {
        let neg = key.len() > 0 && key.byte-at(0) == 45;
        let mag: u64 = 0;
        for index in (if neg { 1 } else { 0 })..key.len() { mag = mag * 10 + (key.byte-at(index) - 48) as u64; }
        if kind == "u64" { return (mag as s64) ^ (-9223372036854775807 as s64 - 1); }
        let value = mag as s64;
        if neg { 0 - value } else { value }
    }

    // a decimal one less, exactly (as text: no width wraps it): "0" is "-1", "-5" is "-6"
    decimal-before: func(key: string) -> string {
        if key == "0" { return "-1"; }
        if key.len() > 0 && key.byte-at(0) == 45 { return "-" + decimal-after(key.substring(1, key.len())); }
        let digits: list<s64> = [];
        for index in 0..key.len() { digits.push(key.byte-at(index) - 48); }
        let index = digits.len() - 1;
        loop {
            if index < 0 { break; }
            if digits[index] > 0 {
                digits[index] = digits[index] - 1;
                break;
            }
            digits[index] = 9;
            index -= 1;
        }
        let out = "";
        let leading = true;
        for digit in digits {
            if !(leading && digit == 0) {
                leading = false;
                out = out + from-byte(48 + digit);
            }
        }
        if out == "" { "0" } else { out }
    }

    // a non-negative decimal one more, exactly
    decimal-after: func(key: string) -> string {
        let digits: list<s64> = [];
        for index in 0..key.len() { digits.push(key.byte-at(index) - 48); }
        let index = digits.len() - 1;
        loop {
            if index < 0 { return "1" + digits-text(digits); }
            if digits[index] < 9 {
                digits[index] = digits[index] + 1;
                return digits-text(digits);
            }
            digits[index] = 0;
            index -= 1;
        }
    }

    digits-text: func(digits: list<s64>) -> string {
        let out = "";
        for digit in digits { out = out + from-byte(48 + digit); }
        out
    }

    // how two decimals compare: -1, 0 or 1, exactly
    decimal-order: func(left: string, right: string) -> s64 {
        let an = left.len() > 0 && left.byte-at(0) == 45;
        let bn = right.len() > 0 && right.byte-at(0) == 45;
        if an && !bn { return -1; }
        if bn && !an { return 1; }
        let left-digits = if an { left.substring(1, left.len()) } else { left };
        let right-digits = if bn { right.substring(1, right.len()) } else { right };
        let order = 0;
        if left-digits.len() != right-digits.len() { order = if left-digits.len() < right-digits.len() { -1 } else { 1 }; }
        else {
            for index in 0..left-digits.len() {
                if order == 0 && left-digits.byte-at(index) != right-digits.byte-at(index) {
                    order = if left-digits.byte-at(index) < right-digits.byte-at(index) { -1 } else { 1 };
                }
            }
        }
        if an { 0 - order } else { order }
    }

    // the key one before a key of a kind (as a key: decimal, a u64's unsigned), or the key itself
    // at the kind's least
    key-before: func(kind: string, key: string) -> string {
        let value = key-value(kind, key);
        if value == -9223372036854775807 as s64 - 1 { return key; }
        let below = value - 1;
        if kind == "u64" { return "{(below ^ (-9223372036854775807 as s64 - 1)) as u64}"; }
        "{below}"
    }

    // a kind's value as a pattern shows it
    value-text: func(kind: string, value: s64) -> string {
        if kind == "u64" { return "{(value ^ (-9223372036854775807 as s64 - 1)) as u64}"; }
        if kind == "char" {
            if value > 32 && value < 127 && value != 39 && value != 92 { return "'{from-byte(value as s64)}'"; }
            return "{value} as char";
        }
        "{value}"
    }

    // a value of an int set: _ when it is the whole kind, else the one nearest 0 (the least for a
    // u64 or a char, whose order starts there)
    int-sample: func(integers: IntSet) -> string {
        let all = domain(integers.kind);
        if same-ranges(integers.ranges, all) { return "_"; }
        if integers.kind == "u64" || integers.kind == "char" { return value-text(integers.kind, integers.ranges[0].lo); }
        for interval in integers.ranges {
            if interval.hi >= 0 { return value-text(integers.kind, if interval.lo > 0 { interval.lo } else { 0 }); }
        }
        value-text(integers.kind, integers.ranges[integers.ranges.len() - 1].hi)
    }

    same-ranges: func(left: list<Interval>, right: list<Interval>) -> bool {
        if left.len() != right.len() { return false; }
        for index in 0..left.len() {
            if left[index].lo != right[index].lo || left[index].hi != right[index].hi { return false; }
        }
        true
    }

    ints-with: func(left: list<IntSet>, right: list<IntSet>, how: string) -> list<IntSet> {
        let kinds: list<string> = [];
        for entry in left { kinds.push(entry.kind); }
        for entry in right {
            if !contains(kinds, entry.kind) { kinds.push(entry.kind); }
        }
        let out: list<IntSet> = [];
        for kind in kinds {
            let ra = int-ranges(left, kind);
            let rb = int-ranges(right, kind);
            let combined = if how == "union" {
                ranges-or(ra, rb)
            } else if how == "inter" {
                ranges-and(ra, rb)
            } else {
                ranges-and(ra, ranges-not(rb, domain(kind)))
            };
            if combined.len() > 0 { out.push({ kind: kind, ranges: combined, }); }
        }
        out
    }

    int-ranges: func(xs: list<IntSet>, kind: string) -> list<Interval> {
        for integers in xs {
            if integers.kind == kind { return integers.ranges; }
        }
        []
    }

    // ranges in order and apart: a's and b's, merged where they meet
    ranges-or: func(left: list<Interval>, right: list<Interval>) -> list<Interval> {
        let all: list<Interval> = [];
        let left-index = 0;
        let right-index = 0;
        for step in 0..left.len() + right.len() {
            if right-index >= right.len() || left-index < left.len() && left[left-index].lo <= right[right-index].lo {
                all.push(left[left-index]);
                left-index += 1;
            } else {
                all.push(right[right-index]);
                right-index += 1;
            }
        }
        let out: list<Interval> = [];
        for interval in all {
            if out.len() > 0 {
                let last = out[out.len() - 1];
                // touching or overlapping: one range (the last's hi at the top meets anything)
                if last.hi == 9223372036854775807 as s64 || interval.lo <= last.hi + 1 {
                    if interval.hi > last.hi { out[out.len() - 1] = { lo: last.lo, hi: interval.hi, }; }
                    continue;
                }
            }
            out.push(interval);
        }
        out
    }

    ranges-and: func(left: list<Interval>, right: list<Interval>) -> list<Interval> {
        let out: list<Interval> = [];
        for left-interval in left {
            for right-interval in right {
                let lo = if left-interval.lo > right-interval.lo { left-interval.lo } else { right-interval.lo };
                let hi = if left-interval.hi < right-interval.hi { left-interval.hi } else { right-interval.hi };
                if lo <= hi { out.push({ lo: lo, hi: hi, }); }
            }
        }
        ranges-or(out, [])
    }

    // a kind's values not in a
    ranges-not: func(removed: list<Interval>, all: list<Interval>) -> list<Interval> {
        let out = all;
        for removed-interval in removed {
            let next: list<Interval> = [];
            for kept-interval in out {
                if removed-interval.hi < kept-interval.lo || removed-interval.lo > kept-interval.hi { next.push(kept-interval); }
                else {
                    if kept-interval.lo < removed-interval.lo { next.push({ lo: kept-interval.lo, hi: removed-interval.lo - 1, }); }
                    if removed-interval.hi < kept-interval.hi { next.push({ lo: removed-interval.hi + 1, hi: kept-interval.hi, }); }
                }
            }
            out = next;
        }
        out
    }

    // ================================================================ set operations

    union: func(left: SemType, right: SemType) -> SemType {
        {
            units: left.units || right.units,
            bools: left.bools | right.bools,
            nums: nums-with(left.nums, right.nums, vs-union),
            ints: ints-with(left.ints, right.ints, "union"),
            strings: vs-union(left.strings, right.strings),
            opaque: vs-union(left.opaque, right.opaque),
            refs: keys-or(left.refs, right.refs),
            products: concat-conjs(left.products, right.products),
        }
    }

    inter: func(symbols: Symbols, a0: SemType, b0: SemType) -> SemType {
        // a declared type the other side restricts, opened
        let left = opened(symbols, a0, b0);
        let right = opened(symbols, b0, a0);
        let products: list<Conj> = [];
        for left-product in left.products {
            for right-product in right.products {
                products.push({ pos: atoms-and(left-product.pos, right-product.pos), neg: atoms-and(left-product.neg, right-product.neg), });
            }
        }
        // the products of a declared type the other side holds whole
        for left-product in left.products {
            if owned-by(left-product, right.refs) { products.push(left-product); }
        }
        for right-product in right.products {
            if owned-by(right-product, left.refs) { products.push(right-product); }
        }
        {
            units: left.units && right.units,
            bools: left.bools & right.bools,
            nums: nums-with(left.nums, right.nums, vs-inter),
            ints: ints-with(left.ints, right.ints, "inter"),
            strings: vs-inter(left.strings, right.strings),
            opaque: vs-inter(left.opaque, right.opaque),
            refs: keys-and(left.refs, right.refs),
            products: inhabited-conjs(symbols, products),
        }
    }

    diff: func(symbols: Symbols, a0: SemType, b0: SemType) -> SemType {
        let left = opened(symbols, a0, b0);
        let right = opened(symbols, b0, a0);
        // the products less each of b's (a conjunction's complement: one of its atoms not held),
        // and less those of a declared type b holds whole
        let rest: list<Conj> = [];
        for left-product in left.products {
            if !owned-by(left-product, right.refs) { rest.push(left-product); }
        }
        for right-product in right.products {
            let next: list<Conj> = [];
            for remaining in rest {
                for positive in right-product.pos { next.push({ pos: remaining.pos, neg: atoms-and(remaining.neg, [positive,]), }); }
                for negative in right-product.neg { next.push({ pos: atoms-and(remaining.pos, [negative,]), neg: remaining.neg, }); }
            }
            rest = inhabited-conjs(symbols, next);
        }
        {
            units: left.units && !right.units,
            bools: left.bools & (3 ^ right.bools),
            nums: nums-with(left.nums, right.nums, vs-diff),
            ints: ints-with(left.ints, right.ints, "diff"),
            strings: vs-diff(left.strings, right.strings),
            opaque: vs-diff(left.opaque, right.opaque),
            refs: keys-but(left.refs, right.refs),
            products: rest,
        }
    }

    // a, its declared types the other side looks inside of (and does not hold whole) opened
    opened: func(symbols: Symbols, given: SemType, other: SemType) -> SemType {
        let refs: list<string> = [];
        let products = concat-conjs(given.products, []);
        for reference in given.refs {
            if !contains(other.refs, reference) && mentions(other.products, reference) {
                for conjunction in open-ref(symbols, reference) { products.push(conjunction); }
            } else {
                refs.push(reference);
            }
        }
        {
            units: given.units,
            bools: given.bools,
            nums: given.nums,
            ints: given.ints,
            strings: given.strings,
            opaque: given.opaque,
            refs: refs,
            products: products,
        }
    }

    // whether a conjunction's products are one of the declared types refs
    owned-by: func(conjunction: Conj, refs: list<string>) -> bool {
        for positive in conjunction.pos {
            if positive.owner != "" && contains(refs, positive.owner) { return true; }
        }
        false
    }

    mentions: func(xs: list<Conj>, reference: string) -> bool {
        for conjunction in xs {
            for positive in conjunction.pos {
                if positive.owner == reference { return true; }
            }
            for negative in conjunction.neg {
                if negative.owner == reference { return true; }
            }
        }
        false
    }

    atoms-and: func(left: list<Atom>, right: list<Atom>) -> list<Atom> {
        let out: list<Atom> = [];
        for item in left { out.push(item); }
        for item in right { out.push(item); }
        out
    }

    concat-conjs: func(left: list<Conj>, right: list<Conj>) -> list<Conj> {
        let out: list<Conj> = [];
        for item in left { out.push(item); }
        for item in right { out.push(item); }
        out
    }

    inhabited-conjs: func(symbols: Symbols, xs: list<Conj>) -> list<Conj> {
        let out: list<Conj> = [];
        for conjunction in xs {
            match conj-sample(symbols, conjunction) {
                some(_) => out.push(conjunction),
                none => {}
            }
        }
        out
    }

    // ================================================================ emptiness, and a value

    is-empty: func(symbols: Symbols, given: SemType) -> bool {
        match sample(symbols, given) {
            some(_) => false,
            none => true,
        }
    }

    // a value of the set, shown as a pattern (_ for any value of a part held whole); none when it
    // is empty
    sample: func(symbols: Symbols, given: SemType) -> option<string> {
        for conjunction in given.products {
            match conj-sample(symbols, conjunction) {
                some(found) => { return some(found); }
                none => {}
            }
        }
        if given.refs.len() > 0 { return some("_"); }
        if given.units { return some("()"); }
        if given.bools == 3 { return some("_"); }
        if given.bools == 1 { return some("true"); }
        if given.bools == 2 { return some("false"); }
        for number in given.nums {
            if !vs-empty(number.set) {
                return some(key-sample(number.set, if is-int(number.kind) { "int" } else { "float" }));
            }
        }
        for integers in given.ints {
            if integers.ranges.len() > 0 { return some(int-sample(integers)); }
        }
        if !vs-empty(given.strings) { return some(key-sample(given.strings, "string")); }
        if !vs-empty(given.opaque) { return some("_"); }
        none
    }

    // a key of a set not held out of it: _ for every value
    key-sample: func(values: ValueSet, kind: key-kind) -> string {
        if !values.co {
            let key = values.vals[0];
            if kind == "char" { return "'{from-byte(decimal(key))}'"; }
            if kind == "string" { return "\"{key}\""; }
            return key;
        }
        if values.vals.len() == 0 { return "_"; }
        for index in 0..values.vals.len() + 1 {
            let key = if kind == "int" {
                "{index}"
            } else if kind == "float" {
                "{index}.5"
            } else if kind == "char" {
                "{97 + index}"
            } else {
                from-byte(97 + index)
            };
            if !contains(values.vals, key) {
                if kind == "char" { return "'{from-byte(97 + index)}'"; }
                if kind == "string" { return "\"{key}\""; }
                return key;
            }
        }
        "_"
    }

    // a key's digits as a number (a char's code point)
    decimal: func(key: string) -> s64 {
        let value = 0;
        for index in 0..key.len() { value = value * 10 + key.byte-at(index) - 48; }
        value
    }

    // a product every pos atom holds and no neg one does, shown; none when there is none
    conj-sample: func(symbols: Symbols, conjunction: Conj) -> option<string> {
        if conjunction.pos.len() == 0 { return some("_"); }
        let first = conjunction.pos[0];
        let fields: list<SemType> = [];
        for field in first.fields { fields.push(field); }
        for position in 1..conjunction.pos.len() {
            let positive = conjunction.pos[position];
            if positive.tag != first.tag { return none; }
            for index in 0..fields.len() { fields[index] = inter(symbols, fields[index], positive.fields[index]); }
        }
        for field in fields {
            if is-empty(symbols, field) { return none; }
        }
        let negs: list<Atom> = [];
        for negative in conjunction.neg {
            if negative.tag == first.tag { negs.push(negative); }
        }
        match explore(symbols, fields, negs, 0) {
            some(found) => {
                let shown: list<string> = [];
                for field in found {
                    match sample(symbols, field) {
                        some(found) => shown.push(found),
                        none => shown.push("_"),
                    }
                }
                some(show-product(symbols, first, shown))
            }
            none => none,
        }
    }

    // fields (each inhabited) whose products none of negs from i on holds: for each of them, one
    // field outside its field's set (the standard search for a product with negations)
    explore: func(
        symbols: Symbols,
        fields: list<SemType>,
        negs: list<Atom>,
        index: s64,
    ) -> option<list<SemType>> {
        if index == negs.len() { return some(fields); }
        let negative = negs[index];
        for field-index in 0..fields.len() {
            let rest = diff(symbols, fields[field-index], negative.fields[field-index]);
            if !is-empty(symbols, rest) {
                let next: list<SemType> = [];
                for position in 0..fields.len() { next.push(if position == field-index { rest } else { fields[position] }); }
                match explore(symbols, next, negs, index + 1) {
                    some(found) => { return some(found); }
                    none => {}
                }
            }
        }
        none
    }

    show-product: func(symbols: Symbols, given: Atom, fields: list<string>) -> string {
        if given.tag.starts-with("tuple/") { return "(" + fields.join(", ") + ")"; }
        // an anonymous record's: its fields' names in its tag
        if given.tag == "\{\}" { return "\{\}"; }
        if given.tag.starts-with("\{") {
            let names = given.tag.substring(1, given.tag.len() - 1).split(",");
            let parts: list<string> = [];
            for index in 0..names.len() { parts.push("{names[index]}: {fields[index]}"); }
            return "\{ " + parts.join(", ") + " \}";
        }
        if given.owner != "" && symbols.records.has(intern(given.owner)) {
            let names = symbols.records[intern(given.owner)].fields;
            let parts: list<string> = [];
            for index in 0..names.len() { parts.push("{names[index]}: {fields[index]}"); }
            return "\{ " + parts.join(", ") + " \}";
        }
        let name = if given.owner != "" {
            given.tag.substring(given.owner.len() + 1, given.tag.len())
        } else {
            given.tag
        };
        if fields.len() == 1 { return "{name}({fields[0]})"; }
        name
    }

    // ================================================================ literals

    // a literal's key: an integer's value in decimal (- before a negative one), a float's text, a
    // char's code point, a string's text
    literal-key: func(expression: Expr) -> string {
        match expression.kind {
            int-lit(number) => int-key(number),
            // by its value (1.0 and 1.00 are one; -0.0 and 0.0 are ==, so one too)
            float-lit(number) => {
                let parsed = parse-f64(number);
                if parsed == 0.0 { "0.0" } else { "{parsed}" }
            }
            char-lit(character) => "{character}",
            str-lit(contents) => contents,
            bool-lit(flag) => if flag { "true" } else { "false" },
            unary(negation) => "-" + literal-key(negation.value),
            _ => "",
        }
    }

    // an integer as written (0x, 0o or 0b before it, _ between digits) in decimal
    int-key: func(text: string) -> string {
        let radix: u64 = 10;
        let start = 0;
        if text.len() > 2 && text.byte-at(0) == 48 {
            let radix-byte = text.byte-at(1);
            if radix-byte == 120 { radix = 16; }
            else if radix-byte == 111 { radix = 8; }
            else if radix-byte == 98 { radix = 2; }
            if radix != 10 { start = 2; }
        }
        let value: u64 = 0;
        for index in start..text.len() {
            let byte = text.byte-at(index);
            if byte != 95 { value = value * radix + hex-value(byte) as u64; }
        }
        "{value}"
    }
}
