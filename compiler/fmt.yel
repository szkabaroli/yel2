// The formatter (yelc --fmt): a file's tokens, as written, laid out again, 100 columns wide. Every
// (), [] and {} is a group, printed on one line where it fits and else broken: its items one to a
// line, indented four spaces, a list's last given a comma. What the author laid out over lines (a
// newline between a group's items) stays laid out as written, each of its lines one group of its
// own; blank lines stay (one at most). A block's braces break with the line they are on, so an if
// and its elses break together; a call whose last argument is a group keeps the call on one line
// and breaks only that group (out.push({ ... })), but a call holding a broken argument before its
// last breaks. A closure keeps its params and -> on the line it opens on and breaks only its body.
// Tokens are printed as their source bytes, so strings and comments are never changed.
//
// Formatting what this makes changes nothing: each choice made of a group this breaks is made the
// same once that group is written broken (a fill's separator measured only to the next {} or []
// group's opening break, a broken group holding no flat group around it, a block's lines filled
// as lines fills them)

// a layout: text; a line (a space where its group fits, else a line break); a soft line (nothing,
// else a line break); a hard line; the break after a {} or [] group's opening bracket (a line or a
// soft line: where a line's measure for a fill's separator ends, as a second formatting's ends at
// the hard line that break has become); text only where its group breaks; a sequence; the lines
// inside four spaces further in; a group
variant Doc {
    text(string),
    line,
    softline,
    hardline,
    opening-break(Doc),
    ifbreak(string),
    concat(list<Doc>),
    nest(Doc),
    group(DocGroup),
    fill(list<Doc>),
}

// forced: it breaks whatever the width; hug (a call's last argument a group): prefix (what comes
// before that group), last (that group) and suffix (what closes the call), for printing the call
// on one line and breaking only the last group
resource DocGroup { doc: Doc, forced: bool, hug: bool, prefix: Doc, last: Doc, suffix: Doc, }

// a token (its index), or a group: its opening token, its items, its closing token
variant Item {
    tok(s64),
    group(GroupItem),
}

record GroupItem { open: s64, items: list<Item>, close: s64, }

// a layout, and whether it must break the group it is in (a hard line in it)
resource Built { doc: Doc, forced: bool, }

// the file: its source and tokens; the tree's walk position
// angled: each token's, whether it is inside a type's <...> (a comma there separates no items)
// failed: its brackets do not match (the file is left as it is)
resource Fmt { src: string, toks: list<Token>, pos: s64, angled: list<bool>, failed: bool, }

// a printing step: the layout, its indentation, whether its group is flat, and (a hugged call's
// last group) that it breaks
resource Cmd { doc: Doc, indent: s64, flat: bool, must-break: bool, }

// the printer's output: finished lines, the line being made, its column, and whether it has
// anything yet (its indentation is written with its first text)
resource Out { lines: list<string>, cur: list<string>, col: s64, indent: s64, started: bool, }

module fmt {
    width: func() -> s64 { 100 }

    // a source's text, formatted: read from its syntax tree (grammar.yel's: each token as written,
    // its comments, a string whole, and which tokens are inside a type's <…>)
    format: func(src: string, file: string) -> string {
        let formatting = tokens-of(src, file);
        let items = tree(formatting, "");
        if formatting.failed {
            eprint("{file}: not formatted: its brackets do not match\n");
            return src;
        }
        let body = lines(formatting, items);
        let doc = Doc.concat([body.doc, Doc.hardline,]);
        print-doc(doc)
    }

    // a file's tokens as the formatter reads them, from its syntax tree: each token (a comment
    // too; a string one token, its pieces and interpolations whole), where it is, and whether it
    // is inside a type's <…> (a type's arguments or a func's type parameters: a comma there
    // separates no items)
    tokens-of: func(src: string, file: string) -> Fmt {
        let context: Context = {
            sources: [{ path: file, text: src, },],
            errors: [],
            input: file,
            mode: "",
            backend: "",
            debug: false,
            testing: false,
            test-exports: false,
            turns: false,
            triple: "",
            overlays: map.new(),
            exits: false,
            type-names: [],
            uses: [],
            modules: [],
            declarations: [],
            members: [],
            locals: [],
            bodies: [],
            trees: map.new(),
            cache: none,
            interface: [],
            func-texts: map.new(),
            embed-names: map.new(),
            embeds: map.new(),
            symbols: symbols(),
        };
        let formatting: Fmt = { src: src, toks: [], pos: 0, angled: [], failed: false, };
        let root = tree.root(grammar.parse-file(context, 0));
        let lines: list<s64> = [0,];
        for index in 0..src.len() { if src.byte-at(index) == 10 { lines.push(index + 1); } }
        read-tokens(formatting, root, false, lines);
        let end = place(lines, src.len());
        formatting.toks.push({ kind: TokenKind.eof, text: "", span: { source: 0, line: end.line, col: end.col, end-line: end.line, end-col: end.col, }, indent: -1, template: false, start: src.len(), end: src.len(), escaped: false, });
        formatting.angled.push(false);
        formatting
    }

    @(private) read-tokens: func(formatting: Fmt, syntax: SyntaxNode, angled: bool, lines: list<s64>) {
        // (a string taken whole, an attribute's or an include's: its pieces are its holder's own,
        // one token from its opening quote to its closing one)
        let string-start = -1;
        let depth = 0;
        for child in tree.children(syntax) {
            match child {
                token(leaf) => {
                    if leaf.green.kind == TokenKind.string-start {
                        if depth == 0 { string-start = leaf.offset; }
                        depth += 1;
                        continue;
                    }
                    if depth > 0 {
                        if leaf.green.kind == TokenKind.string-end {
                            depth -= 1;
                            if depth == 0 { push-token(formatting, TokenKind.str, string-start, leaf.offset + leaf.green.text.len(), angled, lines); }
                        }
                        continue;
                    }
                    if leaf.green.kind == TokenKind.space || leaf.green.kind == TokenKind.unknown { continue; }
                    push-token(formatting, leaf.green.kind, leaf.offset, leaf.offset + leaf.green.text.len(), angled, lines);
                }
                node(inner) => {
                    let kind = tree.kind(inner);
                    if kind == NodeKind.string-lit {
                        // (a string one token: what is in it is its own)
                        push-token(formatting, TokenKind.str, inner.offset, tree.end-offset(inner), angled, lines);
                    } else {
                        read-tokens(formatting, inner, angled || kind == NodeKind.type-args || kind == NodeKind.type-params, lines);
                    }
                }
            }
        }
    }

    @(private) push-token: func(formatting: Fmt, kind: TokenKind, start: s64, end: s64, angled: bool, lines: list<s64>) {
        let first = place(lines, start);
        let last = place(lines, end);
        formatting.toks.push({
            kind: kind,
            text: formatting.src.substring(start, end),
            span: { source: 0, line: first.line, col: first.col, end-line: last.line, end-col: last.col, },
            indent: -1,
            template: false,
            start: start,
            end: end,
            escaped: false,
        });
        formatting.angled.push(angled);
    }

    // the line and column of byte at (lines: where each starts)
    @(private) place: func(lines: list<s64>, at: s64) -> Span {
        let low = 0;
        let high = lines.len() - 1;
        loop {
            if low >= high { break; }
            let middle = (low + high + 1) / 2;
            if lines[middle] <= at { low = middle; } else { high = middle - 1; }
        }
        { source: 0, line: low + 1, col: at - lines[low] + 1, end-line: low + 1, end-col: at - lines[low] + 1, }
    }

    // ================================================================ the tree

    // the items up to close (its closing bracket; "" for the file's end), which is left unread
    tree: func(formatting: Fmt, close: string) -> list<Item> {
        let out: list<Item> = [];
        for step in formatting.pos..formatting.toks.len() {
            let token = formatting.toks[formatting.pos];
            if token.kind == TokenKind.eof { return out; }
            if token.kind == TokenKind.op && token.text == close { return out; }
            let closer = closing(token);
            if closer != "" {
                let open = formatting.pos;
                formatting.pos += 1;
                let inner = tree(formatting, closer);
                if formatting.toks[formatting.pos].kind == TokenKind.eof {
                    formatting.failed = true;
                    return out;
                }
                out.push(Item.group({ open: open, items: inner, close: formatting.pos, }));
            } else {
                if token.kind == TokenKind.op && (token.text == ")" || token.text == "]" || token.text == "\}") {
                    formatting.failed = true;
                }
                out.push(Item.tok(formatting.pos));
            }
            formatting.pos += 1;
        }
        out
    }

    // an opening bracket's closing one; "" for any other token
    closing: func(token: Token) -> string {
        if token.kind != TokenKind.op { return ""; }
        if token.text == "(" {
            ")"
        } else if token.text == "[" {
            "]"
        } else if token.text == "\{" {
            "\}"
        } else {
            ""
        }
    }

    first: func(item: Item) -> s64 {
        match item {
            tok(index) => index,
            group(grouped) => grouped.open,
        }
    }

    last: func(item: Item) -> s64 {
        match item {
            tok(index) => index,
            group(grouped) => grouped.close,
        }
    }

    is-op: func(formatting: Fmt, item: Item, op: string) -> bool {
        match item {
            tok(index) => formatting.toks[index].kind == TokenKind.op && formatting.toks[index].text == op,
            group(_) => false,
        }
    }

    // a comma between items (not one of a type's, as in result<_, string>)
    is-comma: func(formatting: Fmt, item: Item) -> bool {
        match item {
            tok(index) => is-op(formatting, item, ",") && !formatting.angled[index],
            group(_) => false,
        }
    }

    is-comment: func(formatting: Fmt, item: Item) -> bool {
        match item {
            tok(index) => formatting.toks[index].kind == TokenKind.comment,
            group(_) => false,
        }
    }

    // the line a token starts on, and the one it ends on
    line-of: func(formatting: Fmt, index: s64) -> s64 { formatting.toks[index].span.line }

    end-line: func(formatting: Fmt, index: s64) -> s64 { formatting.toks[index].span.end-line }

    // a token as written (a comment without its trailing spaces)
    raw: func(formatting: Fmt, index: s64) -> string {
        let token = formatting.toks[index];
        let written = formatting.src.substring(token.start, token.end);
        if token.kind == TokenKind.comment { trim-end(written) } else { written }
    }

    trim-end: func(line: string) -> string {
        let length = line.len();
        for index in 0..length {
            let byte = line.byte-at(length - 1 - index);
            if byte != 32 && byte != 9 && byte != 13 { return line.substring(0, length - index); }
        }
        ""
    }

    // ================================================================ layouts

    // items laid out as written: their lines (a line ends where the source breaks one and a
    // statement or an item ends there), each a group, one blank line kept between them; the lines
    // of a statement written over several go four spaces further in
    lines: func(formatting: Fmt, items: list<Item>) -> Built {
        let out: list<Doc> = [];
        // the line being made: its parts (between the lines after its commas), the part being made
        let parts: list<Doc> = [];
        let part: list<Doc> = [];
        let part-forced = false;
        for index in 0..items.len() {
            if index > 0 {
                let before = last(items[index - 1]);
                let after = first(items[index]);
                if line-of(formatting, after) > end-line(formatting, before) && !continues(formatting, before) {
                    parts.push(part-doc(part, part-forced));
                    out.push(Doc.fill(parts));
                    out.push(Doc.hardline);
                    if line-of(formatting, after) - end-line(formatting, before) >= 2 { out.push(Doc.hardline); }
                    parts = [];
                    part = [];
                    part-forced = false;
                } else {
                    let gap = between(formatting, items[index - 1], items[index], true);
                    if breaks(gap.doc) {
                        parts.push(part-doc(part, part-forced));
                        parts.push(gap.doc);
                        part = [];
                        part-forced = false;
                    } else {
                        part.push(gap.doc);
                        if gap.forced { part-forced = true; }
                    }
                }
            }
            let built = item(formatting, items[index]);
            part.push(built.doc);
            if built.forced { part-forced = true; }
        }
        if items.len() > 0 {
            parts.push(part-doc(part, part-forced));
            out.push(Doc.fill(parts));
        }
        { doc: Doc.concat(out), forced: true, }
    }

    // whether a separator is a place a line may break (a line, or one further in: before && or ||)
    breaks: func(document: Doc) -> bool {
        match document {
            line => true,
            nest(nested) => {
                match nested {
                    line => true,
                    _ => false,
                }
            }
            _ => false,
        }
    }

    // a part of a line: broken where it holds a hard line (so its blocks break together)
    part-doc: func(part: list<Doc>, forced: bool) -> Doc {
        if forced { Doc.group(plain-group(Doc.concat(part), true)) } else { Doc.concat(part) }
    }

    // whether the line after token a goes on with a's statement: a ends none (a ; , or block, or
    // a comment)
    continues: func(formatting: Fmt, index: s64) -> bool {
        let token = formatting.toks[index];
        if token.kind == TokenKind.comment { return false; }
        if token.kind != TokenKind.op { return true; }
        !(token.text == ";" || token.text == "," || token.text == "\}" || token.text == "\{")
    }

    // what goes between two items on one line: after a , or ; a line, before && or || a line four
    // spaces further in, else a space where the source has one; a line break the source has (only
    // where written = true: an item spanning lines) goes four spaces further in
    between: func(formatting: Fmt, earlier: Item, later: Item, written: bool) -> Built {
        let before = last(earlier);
        let after = first(later);
        if (is-op(formatting, later, "&&") || is-op(formatting, later, "||")) && !is-comment(formatting, earlier) {
            return { doc: Doc.nest(Doc.line), forced: false, };
        }
        if line-of(formatting, after) > end-line(formatting, before) {
            if written { return { doc: Doc.nest(Doc.hardline), forced: true, }; }
            return { doc: Doc.line, forced: false, };
        }
        if is-comment(formatting, later) { return { doc: Doc.text(" "), forced: false, }; }
        if is-comma(formatting, earlier) || is-op(formatting, earlier, ";") { return { doc: Doc.line, forced: false, }; }
        let space = formatting.toks[after].start > formatting.toks[before].end;
        { doc: Doc.text(if space { " " } else { "" }), forced: false, }
    }

    item: func(formatting: Fmt, item: Item) -> Built {
        match item {
            tok(index) => {
                let written = raw(formatting, index);
                // a string over lines (a multiline one) ends the line it starts
                { doc: Doc.text(written), forced: find-byte(written, 10) != none, }
            }
            group(grouped) => group-doc(formatting, grouped),
        }
    }

    plain-group: func(doc: Doc, forced: bool) -> DocGroup {
        {
            doc: doc,
            forced: forced,
            hug: false,
            prefix: Doc.text(""),
            last: Doc.text(""),
            suffix: Doc.text(""),
        }
    }

    // a bracketed group. Its items are a list where a , separates them at its level, a block where
    // it is braces without; laid out as written where a line break separates two of them (or one
    // from a bracket), else each list item (or all of a () or []) a group. A block's braces are no
    // group of their own: they break with the line they are on
    group-doc: func(formatting: Fmt, grouped: GroupItem) -> Built {
        let open = raw(formatting, grouped.open);
        let close = raw(formatting, grouped.close);
        let items = grouped.items;
        if items.len() == 0 {
            let space = formatting.toks[grouped.close].start > formatting.toks[grouped.open].end;
            return { doc: Doc.text(open + (if space { " " } else { "" }) + close), forced: false, };
        }
        // one token alone (a long string): breaking around it would not make it fit
        let alone = items.len() == 1 && !is-comment(formatting, items[0]) && !ends-block(formatting, items[0]);
        if alone && open != "\{" {
            match items[0] {
                tok(_) => {
                    return {
                        doc: Doc.concat([Doc.text(open), item(formatting, items[0]).doc, Doc.text(close),]),
                        forced: false,
                    };
                }
                group(_) => {}
            }
        }
        // a closure ({ params -> body }): its params' commas make it no list
        let arrow = if open == "\{" { closure-arrow(formatting, grouped) } else { -1 };
        if arrow >= 0 { return closure-doc(formatting, grouped, arrow); }
        let is-list = false;
        for part in items { if is-comma(formatting, part) { is-list = true; } }
        let is-block = open == "\{" && !is-list;
        // how the author broke a [] or {} over lines is kept; a () is laid out afresh (but around a
        // comment)
        let written = line-of(formatting, first(items[0])) > end-line(formatting, grouped.open)
            || line-of(formatting, grouped.close) > end-line(formatting, last(items[items.len() - 1]));
        for index in 1..items.len() {
            if line-of(formatting, first(items[index])) > end-line(formatting, last(items[index - 1])) { written = true; }
        }
        if open == "(" {
            written = false;
            for part in items { if is-comment(formatting, part) { written = true; } }
        }
        let content = if written {
            lines(formatting, items)
        } else {
            flat-items(formatting, items, is-list, is-block)
        };
        let forced = written || content.forced;
        // a list broken gets a comma after its last item (but after a block, as match arms write
        // it)
        let tail = Doc.text("");
        let end = items[items.len() - 1];
        if is-list && !is-comma(formatting, end) && !is-comment(formatting, end) && !ends-block(formatting, end) {
            tail = Doc.ifbreak(",");
        }
        let brk = if written {
            Doc.hardline
        } else if open == "\{" {
            Doc.line
        } else {
            Doc.softline
        };
        let first = if open == "(" { brk } else { Doc.opening-break(brk) };
        let doc = Doc.concat([
            Doc.text(open),
            Doc.nest(Doc.concat([first, content.doc, tail,])),
            brk,
            Doc.text(close),
        ]);
        if is-block { return { doc: doc, forced: forced, }; }
        // a call whose last argument is a group: that group may break alone, broken already or not
        // (so formatting this again keeps it so), where nothing before it is broken; but not the
        // last block of an if's elses, which break together. Its last argument: the last item but
        // a comma after it (one a broken list was given, as formatting adds them)
        let at = last-argument(formatting, items);
        let before-forced = written;
        for index in 0..at { if item(formatting, items[index]).forced { before-forced = true; } }
        let ends-chain = at >= 1 && is-word(formatting, items[at - 1], "else");
        if open == "(" && huggable(formatting, items[at]) && !before-forced && !ends-chain {
            let before: list<Doc> = [Doc.text(open),];
            for index in 0..at {
                before.push(item(formatting, items[index]).doc);
                before.push(between(formatting, items[index], items[index + 1], false).doc);
            }
            let after: list<Doc> = [];
            for index in at + 1..items.len() { after.push(item(formatting, items[index]).doc); }
            after.push(Doc.text(close));
            let gr: DocGroup = {
                doc: doc,
                forced: false,
                hug: true,
                prefix: Doc.concat(before),
                last: item(formatting, items[at]).doc,
                suffix: Doc.concat(after),
            };
            return { doc: Doc.group(gr), forced: false, };
        }
        { doc: Doc.group(plain-group(doc, forced)), forced: false, }
    }

    // where a {} group's closure arrow is among its items (-1: it is no closure). A closure is a
    // value, so its { comes after an operator or an opening bracket (=, (, ',', =>, :, return); a
    // block's or a body's comes after a name, a type, ), ] or > (if x {, -> s64 {, module m {).
    // Its arrow: the first -> at its top but one that ends a param's func type (func(...) -> T),
    // with no comment before it (the params are laid out on one line)
    closure-arrow: func(formatting: Fmt, grouped: GroupItem) -> s64 {
        if grouped.open == 0 { return -1; }
        let before = formatting.toks[grouped.open - 1];
        let value-place = (
            before.kind == TokenKind.op
                && before.text != ")"
                && before.text != "]"
                && before.text != ">"
                && before.text != "\}"
        )
            || before.text == "return";
        if !value-place { return -1; }
        let items = grouped.items;
        for index in 0..items.len() {
            if is-comment(formatting, items[index]) { return -1; }
            if is-op(formatting, items[index], "->") {
                let in-type = index >= 2 && is-word(formatting, items[index - 2], "func") && !is-tok(items[index - 1]);
                if !in-type { return index; }
            }
        }
        -1
    }

    // whether an item is the word w (a name's token: func)
    is-word: func(formatting: Fmt, item: Item, word: string) -> bool {
        match item {
            tok(index) => formatting.toks[index].kind == TokenKind.id && formatting.toks[index].text == word,
            group(_) => false,
        }
    }

    // whether an item is a token (not a group)
    is-tok: func(item: Item) -> bool {
        match item {
            tok(_) => true,
            group(_) => false,
        }
    }

    // a closure: its params and -> always on the line it opens on, its body after them where it
    // fits, else a block's lines (as the author broke them, or a line after each ;), never a list's
    // comma
    closure-doc: func(formatting: Fmt, grouped: GroupItem, arrow: s64) -> Built {
        let items = grouped.items;
        let head: list<Doc> = [Doc.text(raw(formatting, grouped.open)), Doc.text(" "),];
        let head-forced = false;
        for index in 0..arrow + 1 {
            let built = item(formatting, items[index]);
            head.push(built.doc);
            if built.forced { head-forced = true; }
            if index < arrow {
                let gap = between(formatting, items[index], items[index + 1], false);
                head.push(gap.doc);
            }
        }
        // (on one line however long: a break between params would read as a list)
        head = [flattened(Doc.concat(head)),];
        let body = items.slice(arrow + 1, items.len());
        if body.len() == 0 {
            head.push(Doc.text(" " + raw(formatting, grouped.close)));
            return { doc: Doc.concat(head), forced: head-forced, };
        }
        // the body broken as its author broke it over lines, else laid out afresh
        let written = line-of(formatting, first(body[0])) > end-line(formatting, last(items[arrow]))
            || line-of(formatting, grouped.close) > end-line(formatting, last(body[body.len() - 1]));
        for index in 1..body.len() {
            if line-of(formatting, first(body[index])) > end-line(formatting, last(body[index - 1])) { written = true; }
        }
        let content = if written { lines(formatting, body) } else { flat-items(formatting, body, false, true) };
        let forced = written || content.forced || head-forced;
        let brk = if written { Doc.hardline } else { Doc.line };
        let doc = Doc.concat([
            Doc.concat(head),
            Doc.nest(Doc.concat([Doc.opening-break(brk), content.doc,])),
            brk,
            Doc.text(raw(formatting, grouped.close)),
        ]);
        { doc: Doc.group(plain-group(doc, forced)), forced: false, }
    }

    // a layout printed flat: its lines spaces, its soft lines and its breaks' text nothing, its
    // groups flat (a hard line, which cannot be, stays)
    flattened: func(document: Doc) -> Doc {
        match document {
            line => Doc.text(" "),
            softline => Doc.text(""),
            ifbreak(_) => Doc.text(""),
            concat(parts) => {
                let out: list<Doc> = [];
                for part in parts { out.push(flattened(part)); }
                Doc.concat(out)
            }
            nest(inner) => flattened(inner),
            opening-break(inner) => flattened(inner),
            group(grouped) => flattened(grouped.doc),
            fill(parts) => {
                let out: list<Doc> = [];
                for index in 0..parts.len() { out.push(flattened(parts[index])); }
                Doc.concat(out)
            }
            _ => document,
        }
    }

    // the index of a group's last argument: its last item, but a comma after it
    last-argument: func(formatting: Fmt, items: list<Item>) -> s64 {
        let at = items.len() - 1;
        if at > 0 && is-comma(formatting, items[at]) { at -= 1; }
        at
    }

    // whether a call's last argument may break alone: a {} or [] group with items, or a call whose
    // own last argument may
    huggable: func(formatting: Fmt, item: Item) -> bool {
        match item {
            group(grouped) => {
                if grouped.items.len() == 0 { return false; }
                let open = raw(formatting, grouped.open);
                if open == "(" { return huggable(formatting, grouped.items[last-argument(formatting, grouped.items)]); }
                // a [] against what comes before it is an index (xs[i]), not a list
                let prev = formatting.toks[grouped.open - 1];
                !(open == "[" && prev.end == formatting.toks[grouped.open].start && prev.kind != TokenKind.op) && !(
                    open == "["
                        && prev.end == formatting.toks[grouped.open].start
                        && (prev.text == ")" || prev.text == "]")
                )
            }
            tok(_) => false,
        }
    }

    // whether an item is a group closed by } (a block)
    ends-block: func(formatting: Fmt, item: Item) -> bool {
        match item {
            group(grouped) => raw(formatting, grouped.close) == "\}",
            tok(_) => false,
        }
    }

    // items written on one line: a list's items each a group, a line after each comma; a block's
    // statements a line after each ; (no groups: they break with the braces), each statement a
    // fill as lines lays one out (so a block broken here lays out as it does once written broken);
    // anything else one group. A list holding a broken item breaks
    flat-items: func(formatting: Fmt, items: list<Item>, is-list: bool, is-block: bool) -> Built {
        if is-block { return block-items(formatting, items); }
        let out: list<Doc> = [];
        let part: list<Doc> = [];
        let part-forced = false;
        let forced = false;
        for index in 0..items.len() {
            let built = item(formatting, items[index]);
            part.push(built.doc);
            if built.forced { part-forced = true; }
            let at-end = index == items.len() - 1;
            if is-list && (is-comma(formatting, items[index]) || at-end) {
                out.push(Doc.group(plain-group(Doc.concat(part), part-forced)));
                if part-forced { forced = true; }
                if !at-end { out.push(Doc.line); }
                part = [];
                part-forced = false;
            } else if !at-end {
                let gap = between(formatting, items[index], items[index + 1], false);
                part.push(gap.doc);
                if gap.forced { part-forced = true; }
            }
        }
        if is-list { return { doc: Doc.concat(out), forced: forced, }; }
        { doc: Doc.group(plain-group(Doc.concat(part), part-forced)), forced: false, }
    }

    // a block's statements: a line after each ;, each statement a fill of its parts (split where
    // a line may break: before && or ||, after a comma), as lines makes each line of one
    block-items: func(formatting: Fmt, items: list<Item>) -> Built {
        let out: list<Doc> = [];
        let parts: list<Doc> = [];
        let part: list<Doc> = [];
        let part-forced = false;
        let forced = false;
        for index in 0..items.len() {
            let built = item(formatting, items[index]);
            part.push(built.doc);
            if built.forced { part-forced = true; }
            if index == items.len() - 1 { break; }
            let gap = between(formatting, items[index], items[index + 1], false);
            if is-op(formatting, items[index], ";") {
                // the statement ends: its parts a fill, then the line between statements
                parts.push(part-doc(part, part-forced));
                if part-forced { forced = true; }
                out.push(Doc.fill(parts));
                out.push(gap.doc);
                parts = [];
                part = [];
                part-forced = false;
            } else if breaks(gap.doc) {
                parts.push(part-doc(part, part-forced));
                if part-forced { forced = true; }
                parts.push(gap.doc);
                part = [];
                part-forced = false;
            } else {
                part.push(gap.doc);
                if gap.forced { part-forced = true; }
            }
        }
        parts.push(part-doc(part, part-forced));
        if part-forced { forced = true; }
        out.push(Doc.fill(parts));
        { doc: Doc.concat(out), forced: forced, }
    }

    // ================================================================ printing

    // a layout's text: Wadler's printer: a group flat where it fits up to the next
    // line break, else broken; a nest in a flat group adds nothing (so a group broken inside a flat
    // one is indented from the line it starts on)
    print-doc: func(doc: Doc) -> string {
        let output: Out = { lines: [], cur: [], col: 0, indent: 0, started: false, };
        let stack: list<Cmd> = [{ doc: doc, indent: 0, flat: false, must-break: false, },];
        loop {
            if stack.len() == 0 { break; }
            let command = stack.pop();
            match command.doc {
                text(written) => emit(output, written),
                line => { if command.flat { emit(output, " "); } else { newline(output, command.indent); } }
                softline => { if !command.flat { newline(output, command.indent); } }
                hardline => newline(output, command.indent),
                opening-break(broken) => stack.push({
                    doc: broken,
                    indent: command.indent,
                    flat: command.flat,
                    must-break: false,
                }),
                ifbreak(written) => { if !command.flat { emit(output, written); } }
                concat(ds) => {
                    for index in 0..ds.len() {
                        stack.push({
                            doc: ds[ds.len() - 1 - index],
                            indent: command.indent,
                            flat: command.flat,
                            must-break: false,
                        });
                    }
                }
                nest(nested) => stack.push({
                    doc: nested,
                    indent: if command.flat { command.indent } else { command.indent + 4 },
                    flat: command.flat,
                    must-break: false,
                }),
                fill(parts) => {
                    // a content flat where it fits, else broken; the line after it flat where the
                    // next content fits after it too
                    let content = parts[0];
                    let flat = fits(width() - column(output), content, []);
                    if parts.len() >= 3 {
                        let two = Doc.concat([content, parts[1], parts[2],]);
                        let rest: list<Doc> = [];
                        for index in 2..parts.len() { rest.push(parts[index]); }
                        stack.push({
                            doc: Doc.fill(rest),
                            indent: command.indent,
                            flat: command.flat,
                            must-break: false,
                        });
                        let sep-flat = command.flat || fits-opening(width() - column(output), two);
                        stack.push({
                            doc: parts[1],
                            indent: command.indent,
                            flat: sep-flat,
                            must-break: false,
                        });
                    }
                    stack.push({
                        doc: content,
                        indent: command.indent,
                        flat: command.flat || flat,
                        must-break: false,
                    });
                }
                group(gr) => {
                    if gr.forced {
                        stack.push({
                            doc: gr.doc,
                            indent: command.indent,
                            flat: false,
                            must-break: false,
                        });
                    }
                    else if command.flat {
                        stack.push({
                            doc: gr.doc,
                            indent: command.indent,
                            flat: true,
                            must-break: false,
                        });
                    }
                    else if !command.must-break && fits(width() - column(output), gr.doc, stack) {
                        stack.push({
                            doc: gr.doc,
                            indent: command.indent,
                            flat: true,
                            must-break: false,
                        });
                    } else if gr.hug && fits-open(width() - column(output), gr.prefix, gr.last) {
                        stack.push({
                            doc: gr.suffix,
                            indent: command.indent,
                            flat: true,
                            must-break: false,
                        });
                        stack.push({
                            doc: gr.last,
                            indent: command.indent,
                            flat: false,
                            must-break: true,
                        });
                        stack.push({
                            doc: gr.prefix,
                            indent: command.indent,
                            flat: true,
                            must-break: false,
                        });
                    } else {
                        stack.push({
                            doc: gr.doc,
                            indent: command.indent,
                            flat: false,
                            must-break: false,
                        });
                    }
                }
            }
        }
        newline(output, 0);
        // the file ends in one line break
        let count = output.lines.len();
        for index in 0..count {
            if count - index - 1 > 0 && output.lines[output.lines.len() - 1] == "" { output.lines.pop(); }
        }
        reflow(output.lines).join(from-byte(10)) + from-byte(10)
    }

    // ================================================================ comments

    // lines with each run of comment lines that has one too wide filled again, word by word; a
    // comment line indented further (an example, a usage) or empty is a paragraph of its own
    reflow: func(lines: list<string>) -> list<string> {
        let out: list<string> = [];
        let index = 0;
        for step in 0..lines.len() + 1 {
            if index >= lines.len() { return out; }
            let indent = comment-indent(lines[index]);
            if indent < 0 {
                out.push(lines[index]);
                index += 1;
            } else {
                // the run: the comment lines after it at its indentation
                let end = index;
                let wide = false;
                for following in index..lines.len() {
                    if end == following && comment-indent(lines[following]) == indent {
                        if display-width(lines[following]) > width() { wide = true; }
                        end = following + 1;
                    }
                }
                if wide {
                    fill(lines, index, end, indent, out);
                } else {
                    for following in index..end {
                        out.push(lines[following]);
                    }
                }
                index = end;
            }
        }
        out
    }

    // a line that is only a comment: its indentation; -1 for any other
    comment-indent: func(line: string) -> s64 {
        let length = line.len();
        for index in 0..length {
            let byte = line.byte-at(index);
            if byte != 32 { return if byte == 47 && line.byte-at(index + 1) == 47 { index } else { -1 }; }
        }
        -1
    }

    // lines[from..to] (comments at indent) filled to the width: a paragraph's words joined, a line
    // written as "//" alone, with more than one space after it, or as a label (// error: ...) kept
    // as it is
    fill: func(lines: list<string>, from: s64, to: s64, indent: s64, out: list<string>) {
        let lead = spaces(indent) + "//";
        let words: list<string> = [];
        for index in from..to {
            let body = lines[index].substring(indent + 2, lines[index].len());
            let plain = body.len() > 1 && body.byte-at(0) == 32 && body.byte-at(1) != 32
                && !is-label(body);
            if plain {
                split-words(body, words);
            } else {
                flush(words, lead, out);
                words = [];
                out.push(lines[index]);
            }
        }
        flush(words, lead, out);
    }

    // whether a comment's text (after //) is a label: one word, then a colon (" error: ...", as a
    // test pins its error with)
    is-label: func(body: string) -> bool {
        let length = body.len();
        for index in 1..length {
            let byte = body.byte-at(index);
            if byte == 58 { return index > 1 && (index + 1 == length || body.byte-at(index + 1) == 32); }
            if !(is-alpha(byte) || is-digit(byte) || byte == 45) { return false; }
        }
        false
    }

    // the words of s (split at spaces) onto words
    split-words: func(line: string, words: list<string>) {
        let start = 0;
        let length = line.len();
        for index in 0..length + 1 {
            if index == length || line.byte-at(index) == 32 {
                if index > start { words.push(line.substring(start, index)); }
                start = index + 1;
            }
        }
    }

    flush: func(words: list<string>, lead: string, out: list<string>) {
        let cur = lead;
        let empty = true;
        for word in words {
            if !empty && display-width(cur) + 1 + display-width(word) > width() {
                out.push(cur);
                cur = lead;
                empty = true;
            }
            cur = cur + " " + word;
            empty = false;
        }
        if !empty { out.push(cur); }
    }

    // the column the next text goes at (a line not started yet: its indentation)
    column: func(output: Out) -> s64 { if output.started { output.col } else { output.indent } }

    emit: func(output: Out, written: string) {
        if written == "" { return; }
        if !output.started {
            output.cur.push(spaces(output.indent));
            output.col = output.indent;
            output.started = true;
        }
        output.cur.push(written);
        let nl = last-newline-at(written);
        if nl >= 0 {
            output.col = display-width(written.substring(nl + 1, written.len()));
        } else {
            output.col += display-width(written);
        }
    }

    newline: func(output: Out, indent: s64) {
        output.lines.push(trim-end(output.cur.join("")));
        output.cur = [];
        output.col = 0;
        output.indent = indent;
        output.started = false;
    }

    spaces: func(count: s64) -> string {
        let out: list<string> = [];
        for step in 0..count { out.push(" "); }
        out.join("")
    }

    last-newline-at: func(line: string) -> s64 {
        let length = line.len();
        for index in 0..length {
            if line.byte-at(length - 1 - index) == 10 { return length - 1 - index; }
        }
        -1
    }

    // columns: characters, not bytes (a UTF-8 continuation byte adds none)
    display-width: func(line: string) -> s64 {
        let columns = 0;
        for index in 0..line.len() {
            let byte = line.byte-at(index);
            if byte < 128 || byte >= 192 { columns += 1; }
        }
        columns
    }

    // whether doc, flat, and what follows it up to the next line break fits in w columns
    fits: func(width: s64, doc: Doc, rest: list<Cmd>) -> bool { measure(width, doc, rest, false) }

    // whether a layout fits in w columns up to a {} or [] group's opening break, which ends the
    // line there: what a fill's separator stays flat by, so that formatting what this makes again
    // (that break a hard line then) decides the same
    fits-opening: func(width: s64, doc: Doc) -> bool { measure(width, doc, [], true) }

    // a layout's measure: whether it fits in w columns, flat, up to its first line break (in it,
    // or after it, in rest: the line going on). A group broken already inside it cannot be flat:
    // it does not fit. to-opening: a {} or [] group's opening break ends the line there
    measure: func(width: s64, doc: Doc, rest: list<Cmd>, to-opening: bool) -> bool {
        let left = width;
        // what is left to measure, and of each whether it is the layout's own (else rest's)
        let todo: list<Doc> = [doc,];
        let flats: list<bool> = [true,];
        let owns: list<bool> = [true,];
        let remaining = rest.len();
        loop {
            if todo.len() == 0 {
                if remaining == 0 { return true; }
                remaining -= 1;
                todo.push(rest[remaining].doc);
                flats.push(rest[remaining].flat);
                owns.push(false);
            }
            let command = todo.pop();
            let flat = flats.pop();
            let own = owns.pop();
            match command {
                text(written) => {
                    let nl = find-byte(written, 10).unwrap-or(-1);
                    left -= display-width(if nl >= 0 { written.substring(0, nl) } else { written });
                    if left < 0 { return false; }
                    if nl >= 0 { return true; }
                }
                line => {
                    if !flat { return true; }
                    left -= 1;
                    if left < 0 { return false; }
                }
                softline => { if !flat { return true; } }
                hardline => { return true; }
                opening-break(inner) => {
                    if to-opening { return true; }
                    todo.push(inner);
                    flats.push(flat);
                    owns.push(own);
                }
                ifbreak(written) => {
                    if !flat {
                        left -= display-width(written);
                        if left < 0 { return false; }
                    }
                }
                concat(ds) | fill(ds) => {
                    for index in 0..ds.len() {
                        todo.push(ds[ds.len() - 1 - index]);
                        flats.push(flat);
                        owns.push(own);
                    }
                }
                nest(inner) => {
                    todo.push(inner);
                    flats.push(flat);
                    owns.push(own);
                }
                group(gr) => {
                    if gr.forced && own && !to-opening { return false; }
                    todo.push(gr.doc);
                    flats.push(flat && !gr.forced);
                    owns.push(own);
                }
            }
        }
        true
    }

    // whether a hugged call's prefix, and its last group's opening, fit in w columns
    fits-open: func(width: s64, prefix: Doc, last: Doc) -> bool {
        fits(width, Doc.concat([prefix, opening(last),]), [])
    }

    // a group's layout up to its first break: its opening bracket's text
    opening: func(document: Doc) -> Doc {
        match document {
            group(gr) => opening(gr.doc),
            concat(ds) => if ds.len() > 0 { opening(ds[0]) } else { document },
            _ => document,
        }
    }
}
