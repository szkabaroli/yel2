// The formatter (yelc --fmt): a file's tokens, as written, laid out again, 100 columns wide, as
// Prettier lays out JavaScript. Every (), [] and {} is a group, printed on one line where it fits
// and else broken: its items one to a line, indented four spaces, a list's last given a comma. What
// the author laid out over lines (a newline between a group's items) stays laid out as written,
// each of its lines one group of its own; blank lines stay (one at most). A block's braces break
// with the line they are on, so an if and its elses break together; a call whose last argument is
// a group keeps the call on one line and breaks only that group (out.push({ ... })), but a call
// holding a broken argument before its last breaks. A closure keeps its params and -> on the line
// it opens on and breaks only its body. Tokens are printed as their source bytes, so strings and
// comments are never changed.
//
// Formatting what this makes changes nothing: each choice made of a group this breaks is made the
// same once that group is written broken (a fill's separator measured only to the next {} or []
// group's opening break, a broken group holding no flat group around it, a block's lines filled
// as lines fills them)

// a layout: text; a line (a space where its group fits, else a line break); a soft line (nothing,
// else a line break); a hard line; the break after a {} or [] group's opening bracket (a line or a
// soft line: where a line's measure for a fill's separator ends, as a second formatting's ends at
// the hard line that break has become); text only where its group breaks; a sequence; the lines
// inside four spaces further in; a group
variant Doc {
    text(string),
    line,
    softline,
    hardline,
    opening-break(Doc),
    ifbreak(string),
    concat(list<Doc>),
    nest(Doc),
    group(DocGroup),
    fill(list<Doc>),
}

// forced: it breaks whatever the width; hug (a call's last argument a group): prefix (what comes
// before that group), last (that group) and suffix (what closes the call), for printing the call
// on one line and breaking only the last group
resource DocGroup { doc: Doc, forced: bool, hug: bool, prefix: Doc, last: Doc, suffix: Doc, }

// a token (its index), or a group: its opening token, its items, its closing token
variant Item {
    tok(s64),
    group(GroupItem),
}

record GroupItem { open: s64, items: list<Item>, close: s64, }

// a layout, and whether it must break the group it is in (a hard line in it)
resource Built { doc: Doc, forced: bool, }

// the file: its source and tokens; the tree's walk position
// angled: each token's, whether it is inside a type's <...> (a comma there separates no items)
// failed: its brackets do not match (the file is left as it is)
resource Fmt { src: string, toks: list<Token>, pos: s64, angled: list<bool>, failed: bool, }

// a printing step: the layout, its indentation, whether its group is flat, and (a hugged call's
// last group) that it breaks
resource Cmd { doc: Doc, indent: s64, flat: bool, must-break: bool, }

// the printer's output: finished lines, the line being made, its column, and whether it has
// anything yet (its indentation is written with its first text)
resource Out { lines: list<string>, cur: list<string>, col: s64, indent: s64, started: bool, }

module fmt {
    width: func() -> s64 { 100 }

    // a source's text, formatted: read from its syntax tree (grammar.yel's: each token as written,
    // its comments, a string whole, and which tokens are inside a type's <…>)
    format: func(src: string, file: string) -> string {
        let f = tokens-of(src, file);
        let items = tree(f, "");
        if f.failed {
            eprint("{file}: not formatted: its brackets do not match\n");
            return src;
        }
        let body = lines(f, items);
        let doc = Doc.concat([body.doc, Doc.hardline,]);
        print-doc(doc)
    }

    // a file's tokens as the formatter reads them, from its syntax tree: each token (a comment
    // too; a string one token, its pieces and interpolations whole), where it is, and whether it
    // is inside a type's <…> (a type's arguments or a func's type parameters: a comma there
    // separates no items)
    tokens-of: func(src: string, file: string) -> Fmt {
        let context: Context = {
            sources: [{ path: file, text: src, },],
            errors: [],
            input: file,
            mode: "",
            backend: "",
            debug: false,
            testing: false,
            test-exports: false,
            turns: false,
            triple: "",
            overlays: map.new(),
            exits: false,
            type-names: [],
            uses: [],
            modules: [],
            declarations: [],
            members: [],
            locals: [],
            bodies: [],
            trees: map.new(),
            cache: none,
            interface: [],
            func-texts: map.new(),
            embed-names: map.new(),
            embeds: map.new(),
            symbols: symbols(),
        };
        let f: Fmt = { src: src, toks: [], pos: 0, angled: [], failed: false, };
        let root = tree.root(grammar.parse-file(context, 0));
        let lines: list<s64> = [0,];
        for index in 0..src.len() { if src.byte-at(index) == 10 { lines.push(index + 1); } }
        read-tokens(f, root, false, lines);
        let end = place(lines, src.len());
        f.toks.push({ kind: TokenKind.eof, text: "", span: { source: 0, line: end.line, col: end.col, end-line: end.line, end-col: end.col, }, indent: -1, template: false, start: src.len(), end: src.len(), escaped: false, });
        f.angled.push(false);
        f
    }

    @(private) read-tokens: func(f: Fmt, n: SyntaxNode, angled: bool, lines: list<s64>) {
        // (a string taken whole, an attribute's or an include's: its pieces are its holder's own,
        // one token from its opening quote to its closing one)
        let string-start = -1;
        let depth = 0;
        for child in tree.children(n) {
            match child {
                token(t) => {
                    if t.green.kind == TokenKind.string-start {
                        if depth == 0 { string-start = t.offset; }
                        depth += 1;
                        continue;
                    }
                    if depth > 0 {
                        if t.green.kind == TokenKind.string-end {
                            depth -= 1;
                            if depth == 0 { push-token(f, TokenKind.str, string-start, t.offset + t.green.text.len(), angled, lines); }
                        }
                        continue;
                    }
                    if t.green.kind == TokenKind.space || t.green.kind == TokenKind.unknown { continue; }
                    push-token(f, t.green.kind, t.offset, t.offset + t.green.text.len(), angled, lines);
                }
                node(inner) => {
                    let kind = tree.kind(inner);
                    if kind == NodeKind.string-lit {
                        // (a string one token: what is in it is its own)
                        push-token(f, TokenKind.str, inner.offset, tree.end-offset(inner), angled, lines);
                    } else {
                        read-tokens(f, inner, angled || kind == NodeKind.type-args || kind == NodeKind.type-params, lines);
                    }
                }
            }
        }
    }

    @(private) push-token: func(f: Fmt, kind: TokenKind, start: s64, end: s64, angled: bool, lines: list<s64>) {
        let first = place(lines, start);
        let last = place(lines, end);
        f.toks.push({
            kind: kind,
            text: f.src.substring(start, end),
            span: { source: 0, line: first.line, col: first.col, end-line: last.line, end-col: last.col, },
            indent: -1,
            template: false,
            start: start,
            end: end,
            escaped: false,
        });
        f.angled.push(angled);
    }

    // the line and column of byte at (lines: where each starts)
    @(private) place: func(lines: list<s64>, at: s64) -> Span {
        let low = 0;
        let high = lines.len() - 1;
        loop {
            if low >= high { break; }
            let middle = (low + high + 1) / 2;
            if lines[middle] <= at { low = middle; } else { high = middle - 1; }
        }
        { source: 0, line: low + 1, col: at - lines[low] + 1, end-line: low + 1, end-col: at - lines[low] + 1, }
    }

    // ================================================================ the tree

    // the items up to close (its closing bracket; "" for the file's end), which is left unread
    tree: func(f: Fmt, close: string) -> list<Item> {
        let out: list<Item> = [];
        for step in f.pos..f.toks.len() {
            let t = f.toks[f.pos];
            if t.kind == TokenKind.eof { return out; }
            if t.kind == TokenKind.op && t.text == close { return out; }
            let closer = closing(t);
            if closer != "" {
                let open = f.pos;
                f.pos += 1;
                let inner = tree(f, closer);
                if f.toks[f.pos].kind == TokenKind.eof {
                    f.failed = true;
                    return out;
                }
                out.push(Item.group({ open: open, items: inner, close: f.pos, }));
            } else {
                if t.kind == TokenKind.op && (t.text == ")" || t.text == "]" || t.text == "\}") {
                    f.failed = true;
                }
                out.push(Item.tok(f.pos));
            }
            f.pos += 1;
        }
        out
    }

    // an opening bracket's closing one; "" for any other token
    closing: func(t: Token) -> string {
        if t.kind != TokenKind.op { return ""; }
        if t.text == "(" {
            ")"
        } else if t.text == "[" {
            "]"
        } else if t.text == "\{" {
            "\}"
        } else {
            ""
        }
    }

    first: func(i: Item) -> s64 {
        match i {
            tok(k) => k,
            group(g) => g.open,
        }
    }

    last: func(i: Item) -> s64 {
        match i {
            tok(k) => k,
            group(g) => g.close,
        }
    }

    is-op: func(f: Fmt, i: Item, op: string) -> bool {
        match i {
            tok(k) => f.toks[k].kind == TokenKind.op && f.toks[k].text == op,
            group(g) => false,
        }
    }

    // a comma between items (not one of a type's, as in result<_, string>)
    is-comma: func(f: Fmt, i: Item) -> bool {
        match i {
            tok(k) => is-op(f, i, ",") && !f.angled[k],
            group(g) => false,
        }
    }

    is-comment: func(f: Fmt, i: Item) -> bool {
        match i {
            tok(k) => f.toks[k].kind == TokenKind.comment,
            group(g) => false,
        }
    }

    // the line a token starts on, and the one it ends on
    line-of: func(f: Fmt, k: s64) -> s64 { f.toks[k].span.line }

    end-line: func(f: Fmt, k: s64) -> s64 { f.toks[k].span.end-line }

    // a token as written (a comment without its trailing spaces)
    raw: func(f: Fmt, k: s64) -> string {
        let t = f.toks[k];
        let s = f.src.substring(t.start, t.end);
        if t.kind == TokenKind.comment { trim-end(s) } else { s }
    }

    trim-end: func(s: string) -> string {
        let n = s.len();
        for k in 0..n {
            let c = s.byte-at(n - 1 - k);
            if c != 32 && c != 9 && c != 13 { return s.substring(0, n - k); }
        }
        ""
    }

    // ================================================================ layouts

    // items laid out as written: their lines (a line ends where the source breaks one and a
    // statement or an item ends there), each a group, one blank line kept between them; the lines
    // of a statement written over several go four spaces further in
    lines: func(f: Fmt, items: list<Item>) -> Built {
        let out: list<Doc> = [];
        // the line being made: its parts (between the lines after its commas), the part being made
        let parts: list<Doc> = [];
        let part: list<Doc> = [];
        let part-forced = false;
        for k in 0..items.len() {
            if k > 0 {
                let a = last(items[k - 1]);
                let b = first(items[k]);
                if line-of(f, b) > end-line(f, a) && !continues(f, a) {
                    parts.push(part-doc(part, part-forced));
                    out.push(Doc.fill(parts));
                    out.push(Doc.hardline);
                    if line-of(f, b) - end-line(f, a) >= 2 { out.push(Doc.hardline); }
                    parts = [];
                    part = [];
                    part-forced = false;
                } else {
                    let s = between(f, items[k - 1], items[k], true);
                    if breaks(s.doc) {
                        parts.push(part-doc(part, part-forced));
                        parts.push(s.doc);
                        part = [];
                        part-forced = false;
                    } else {
                        part.push(s.doc);
                        if s.forced { part-forced = true; }
                    }
                }
            }
            let x = item(f, items[k]);
            part.push(x.doc);
            if x.forced { part-forced = true; }
        }
        if items.len() > 0 {
            parts.push(part-doc(part, part-forced));
            out.push(Doc.fill(parts));
        }
        { doc: Doc.concat(out), forced: true, }
    }

    // whether a separator is a place a line may break (a line, or one further in: before && or ||)
    breaks: func(d: Doc) -> bool {
        match d {
            line => true,
            nest(x) => {
                match x {
                    line => true,
                    _ => false,
                }
            }
            _ => false,
        }
    }

    // a part of a line: broken where it holds a hard line (so its blocks break together)
    part-doc: func(part: list<Doc>, forced: bool) -> Doc {
        if forced { Doc.group(plain-group(Doc.concat(part), true)) } else { Doc.concat(part) }
    }

    // whether the line after token a goes on with a's statement: a ends none (a ; , or block, or
    // a comment)
    continues: func(f: Fmt, a: s64) -> bool {
        let t = f.toks[a];
        if t.kind == TokenKind.comment { return false; }
        if t.kind != TokenKind.op { return true; }
        !(t.text == ";" || t.text == "," || t.text == "\}" || t.text == "\{")
    }

    // what goes between two items on one line: after a , or ; a line, before && or || a line four
    // spaces further in, else a space where the source has one; a line break the source has (only
    // where written = true: an item spanning lines) goes four spaces further in
    between: func(f: Fmt, x: Item, y: Item, written: bool) -> Built {
        let a = last(x);
        let b = first(y);
        if (is-op(f, y, "&&") || is-op(f, y, "||")) && !is-comment(f, x) {
            return { doc: Doc.nest(Doc.line), forced: false, };
        }
        if line-of(f, b) > end-line(f, a) {
            if written { return { doc: Doc.nest(Doc.hardline), forced: true, }; }
            return { doc: Doc.line, forced: false, };
        }
        if is-comment(f, y) { return { doc: Doc.text(" "), forced: false, }; }
        if is-comma(f, x) || is-op(f, x, ";") { return { doc: Doc.line, forced: false, }; }
        let space = f.toks[b].start > f.toks[a].end;
        { doc: Doc.text(if space { " " } else { "" }), forced: false, }
    }

    item: func(f: Fmt, i: Item) -> Built {
        match i {
            tok(k) => {
                let s = raw(f, k);
                // a string over lines (a multiline one) ends the line it starts
                { doc: Doc.text(s), forced: find-byte(s, 10) != none, }
            }
            group(g) => group-doc(f, g),
        }
    }

    plain-group: func(doc: Doc, forced: bool) -> DocGroup {
        {
            doc: doc,
            forced: forced,
            hug: false,
            prefix: Doc.text(""),
            last: Doc.text(""),
            suffix: Doc.text(""),
        }
    }

    // a bracketed group. Its items are a list where a , separates them at its level, a block where
    // it is braces without; laid out as written where a line break separates two of them (or one
    // from a bracket), else each list item (or all of a () or []) a group. A block's braces are no
    // group of their own: they break with the line they are on
    group-doc: func(f: Fmt, g: GroupItem) -> Built {
        let open = raw(f, g.open);
        let close = raw(f, g.close);
        let items = g.items;
        if items.len() == 0 {
            let space = f.toks[g.close].start > f.toks[g.open].end;
            return { doc: Doc.text(open + (if space { " " } else { "" }) + close), forced: false, };
        }
        // one token alone (a long string): breaking around it would not make it fit
        let alone = items.len() == 1 && !is-comment(f, items[0]) && !ends-block(f, items[0]);
        if alone && open != "\{" {
            match items[0] {
                tok(k) => {
                    return {
                        doc: Doc.concat([Doc.text(open), item(f, items[0]).doc, Doc.text(close),]),
                        forced: false,
                    };
                }
                group(x) => {}
            }
        }
        // a closure ({ params -> body }): its params' commas make it no list
        let arrow = if open == "\{" { closure-arrow(f, g) } else { -1 };
        if arrow >= 0 { return closure-doc(f, g, arrow); }
        let is-list = false;
        for i in items { if is-comma(f, i) { is-list = true; } }
        let is-block = open == "\{" && !is-list;
        // how the author broke a [] or {} over lines is kept; a () is laid out afresh (but around a
        // comment)
        let written = line-of(f, first(items[0])) > end-line(f, g.open)
            || line-of(f, g.close) > end-line(f, last(items[items.len() - 1]));
        for k in 1..items.len() {
            if line-of(f, first(items[k])) > end-line(f, last(items[k - 1])) { written = true; }
        }
        if open == "(" {
            written = false;
            for i in items { if is-comment(f, i) { written = true; } }
        }
        let content = if written {
            lines(f, items)
        } else {
            flat-items(f, items, is-list, is-block)
        };
        let forced = written || content.forced;
        // a list broken gets a comma after its last item (but after a block, as match arms write
        // it)
        let tail = Doc.text("");
        let end = items[items.len() - 1];
        if is-list && !is-comma(f, end) && !is-comment(f, end) && !ends-block(f, end) {
            tail = Doc.ifbreak(",");
        }
        let brk = if written {
            Doc.hardline
        } else if open == "\{" {
            Doc.line
        } else {
            Doc.softline
        };
        let first = if open == "(" { brk } else { Doc.opening-break(brk) };
        let doc = Doc.concat([
            Doc.text(open),
            Doc.nest(Doc.concat([first, content.doc, tail,])),
            brk,
            Doc.text(close),
        ]);
        if is-block { return { doc: doc, forced: forced, }; }
        // a call whose last argument is a group: that group may break alone, broken already or not
        // (so formatting this again keeps it so), where nothing before it is broken; but not the
        // last block of an if's elses, which break together. Its last argument: the last item but
        // a comma after it (one a broken list was given, as formatting adds them)
        let at = last-argument(f, items);
        let before-forced = written;
        for k in 0..at { if item(f, items[k]).forced { before-forced = true; } }
        let ends-chain = at >= 1 && is-word(f, items[at - 1], "else");
        if open == "(" && huggable(f, items[at]) && !before-forced && !ends-chain {
            let before: list<Doc> = [Doc.text(open),];
            for k in 0..at {
                before.push(item(f, items[k]).doc);
                before.push(between(f, items[k], items[k + 1], false).doc);
            }
            let after: list<Doc> = [];
            for k in at + 1..items.len() { after.push(item(f, items[k]).doc); }
            after.push(Doc.text(close));
            let gr: DocGroup = {
                doc: doc,
                forced: false,
                hug: true,
                prefix: Doc.concat(before),
                last: item(f, items[at]).doc,
                suffix: Doc.concat(after),
            };
            return { doc: Doc.group(gr), forced: false, };
        }
        { doc: Doc.group(plain-group(doc, forced)), forced: false, }
    }

    // where a {} group's closure arrow is among its items (-1: it is no closure). A closure is a
    // value, so its { comes after an operator or an opening bracket (=, (, ',', =>, :, return); a
    // block's or a body's comes after a name, a type, ), ] or > (if x {, -> s64 {, module m {).
    // Its arrow: the first -> at its top but one that ends a param's func type (func(...) -> T),
    // with no comment before it (the params are laid out on one line)
    closure-arrow: func(f: Fmt, g: GroupItem) -> s64 {
        if g.open == 0 { return -1; }
        let before = f.toks[g.open - 1];
        let value-place = (
            before.kind == TokenKind.op
                && before.text != ")"
                && before.text != "]"
                && before.text != ">"
                && before.text != "\}"
        )
            || before.text == "return";
        if !value-place { return -1; }
        let items = g.items;
        for k in 0..items.len() {
            if is-comment(f, items[k]) { return -1; }
            if is-op(f, items[k], "->") {
                let in-type = k >= 2 && is-word(f, items[k - 2], "func") && !is-tok(items[k - 1]);
                if !in-type { return k; }
            }
        }
        -1
    }

    // whether an item is the word w (a name's token: func)
    is-word: func(f: Fmt, i: Item, w: string) -> bool {
        match i {
            tok(k) => f.toks[k].kind == TokenKind.id && f.toks[k].text == w,
            group(g) => false,
        }
    }

    // whether an item is a token (not a group)
    is-tok: func(i: Item) -> bool {
        match i {
            tok(k) => true,
            group(g) => false,
        }
    }

    // a closure: its params and -> always on the line it opens on, its body after them where it
    // fits, else a block's lines (as the author broke them, or a line after each ;), never a list's
    // comma
    closure-doc: func(f: Fmt, g: GroupItem, arrow: s64) -> Built {
        let items = g.items;
        let head: list<Doc> = [Doc.text(raw(f, g.open)), Doc.text(" "),];
        let head-forced = false;
        for k in 0..arrow + 1 {
            let x = item(f, items[k]);
            head.push(x.doc);
            if x.forced { head-forced = true; }
            if k < arrow {
                let s = between(f, items[k], items[k + 1], false);
                head.push(s.doc);
            }
        }
        // (on one line however long: a break between params would read as a list)
        head = [flattened(Doc.concat(head)),];
        let body = items.slice(arrow + 1, items.len());
        if body.len() == 0 {
            head.push(Doc.text(" " + raw(f, g.close)));
            return { doc: Doc.concat(head), forced: head-forced, };
        }
        // the body broken as its author broke it over lines, else laid out afresh
        let written = line-of(f, first(body[0])) > end-line(f, last(items[arrow]))
            || line-of(f, g.close) > end-line(f, last(body[body.len() - 1]));
        for k in 1..body.len() {
            if line-of(f, first(body[k])) > end-line(f, last(body[k - 1])) { written = true; }
        }
        let content = if written { lines(f, body) } else { flat-items(f, body, false, true) };
        let forced = written || content.forced || head-forced;
        let brk = if written { Doc.hardline } else { Doc.line };
        let doc = Doc.concat([
            Doc.concat(head),
            Doc.nest(Doc.concat([Doc.opening-break(brk), content.doc,])),
            brk,
            Doc.text(raw(f, g.close)),
        ]);
        { doc: Doc.group(plain-group(doc, forced)), forced: false, }
    }

    // a layout printed flat: its lines spaces, its soft lines and its breaks' text nothing, its
    // groups flat (a hard line, which cannot be, stays)
    flattened: func(d: Doc) -> Doc {
        match d {
            line => Doc.text(" "),
            softline => Doc.text(""),
            ifbreak(_) => Doc.text(""),
            concat(parts) => {
                let out: list<Doc> = [];
                for part in parts { out.push(flattened(part)); }
                Doc.concat(out)
            }
            nest(inner) => flattened(inner),
            opening-break(inner) => flattened(inner),
            group(g) => flattened(g.doc),
            fill(parts) => {
                let out: list<Doc> = [];
                for k in 0..parts.len() { out.push(flattened(parts[k])); }
                Doc.concat(out)
            }
            _ => d,
        }
    }

    // the index of a group's last argument: its last item, but a comma after it
    last-argument: func(f: Fmt, items: list<Item>) -> s64 {
        let at = items.len() - 1;
        if at > 0 && is-comma(f, items[at]) { at -= 1; }
        at
    }

    // whether a call's last argument may break alone: a {} or [] group with items, or a call whose
    // own last argument may
    huggable: func(f: Fmt, i: Item) -> bool {
        match i {
            group(g) => {
                if g.items.len() == 0 { return false; }
                let open = raw(f, g.open);
                if open == "(" { return huggable(f, g.items[last-argument(f, g.items)]); }
                // a [] against what comes before it is an index (xs[i]), not a list
                let prev = f.toks[g.open - 1];
                !(open == "[" && prev.end == f.toks[g.open].start && prev.kind != TokenKind.op) && !(
                    open == "["
                        && prev.end == f.toks[g.open].start
                        && (prev.text == ")" || prev.text == "]")
                )
            }
            tok(k) => false,
        }
    }

    // whether an item is a group closed by } (a block)
    ends-block: func(f: Fmt, i: Item) -> bool {
        match i {
            group(g) => raw(f, g.close) == "\}",
            tok(k) => false,
        }
    }

    // items written on one line: a list's items each a group, a line after each comma; a block's
    // statements a line after each ; (no groups: they break with the braces), each statement a
    // fill as lines lays one out (so a block broken here lays out as it does once written broken);
    // anything else one group. A list holding a broken item breaks
    flat-items: func(f: Fmt, items: list<Item>, is-list: bool, is-block: bool) -> Built {
        if is-block { return block-items(f, items); }
        let out: list<Doc> = [];
        let part: list<Doc> = [];
        let part-forced = false;
        let forced = false;
        for k in 0..items.len() {
            let x = item(f, items[k]);
            part.push(x.doc);
            if x.forced { part-forced = true; }
            let at-end = k == items.len() - 1;
            if is-list && (is-comma(f, items[k]) || at-end) {
                out.push(Doc.group(plain-group(Doc.concat(part), part-forced)));
                if part-forced { forced = true; }
                if !at-end { out.push(Doc.line); }
                part = [];
                part-forced = false;
            } else if !at-end {
                let s = between(f, items[k], items[k + 1], false);
                part.push(s.doc);
                if s.forced { part-forced = true; }
            }
        }
        if is-list { return { doc: Doc.concat(out), forced: forced, }; }
        { doc: Doc.group(plain-group(Doc.concat(part), part-forced)), forced: false, }
    }

    // a block's statements: a line after each ;, each statement a fill of its parts (split where
    // a line may break: before && or ||, after a comma), as lines makes each line of one
    block-items: func(f: Fmt, items: list<Item>) -> Built {
        let out: list<Doc> = [];
        let parts: list<Doc> = [];
        let part: list<Doc> = [];
        let part-forced = false;
        let forced = false;
        for k in 0..items.len() {
            let x = item(f, items[k]);
            part.push(x.doc);
            if x.forced { part-forced = true; }
            if k == items.len() - 1 { break; }
            let s = between(f, items[k], items[k + 1], false);
            if is-op(f, items[k], ";") {
                // the statement ends: its parts a fill, then the line between statements
                parts.push(part-doc(part, part-forced));
                if part-forced { forced = true; }
                out.push(Doc.fill(parts));
                out.push(s.doc);
                parts = [];
                part = [];
                part-forced = false;
            } else if breaks(s.doc) {
                parts.push(part-doc(part, part-forced));
                if part-forced { forced = true; }
                parts.push(s.doc);
                part = [];
                part-forced = false;
            } else {
                part.push(s.doc);
                if s.forced { part-forced = true; }
            }
        }
        parts.push(part-doc(part, part-forced));
        if part-forced { forced = true; }
        out.push(Doc.fill(parts));
        { doc: Doc.concat(out), forced: forced, }
    }

    // ================================================================ printing

    // a layout's text: Wadler's printer, as Prettier's: a group flat where it fits up to the next
    // line break, else broken; a nest in a flat group adds nothing (so a group broken inside a flat
    // one is indented from the line it starts on)
    print-doc: func(doc: Doc) -> string {
        let o: Out = { lines: [], cur: [], col: 0, indent: 0, started: false, };
        let stack: list<Cmd> = [{ doc: doc, indent: 0, flat: false, must-break: false, },];
        loop {
            if stack.len() == 0 { break; }
            let c = stack.pop();
            match c.doc {
                text(s) => emit(o, s),
                line => { if c.flat { emit(o, " "); } else { newline(o, c.indent); } }
                softline => { if !c.flat { newline(o, c.indent); } }
                hardline => newline(o, c.indent),
                opening-break(d) => stack.push({
                    doc: d,
                    indent: c.indent,
                    flat: c.flat,
                    must-break: false,
                }),
                ifbreak(s) => { if !c.flat { emit(o, s); } }
                concat(ds) => {
                    for k in 0..ds.len() {
                        stack.push({
                            doc: ds[ds.len() - 1 - k],
                            indent: c.indent,
                            flat: c.flat,
                            must-break: false,
                        });
                    }
                }
                nest(d) => stack.push({
                    doc: d,
                    indent: if c.flat { c.indent } else { c.indent + 4 },
                    flat: c.flat,
                    must-break: false,
                }),
                fill(parts) => {
                    // a content flat where it fits, else broken; the line after it flat where the
                    // next content fits after it too
                    let content = parts[0];
                    let flat = fits(width() - column(o), content, []);
                    if parts.len() >= 3 {
                        let two = Doc.concat([content, parts[1], parts[2],]);
                        let rest: list<Doc> = [];
                        for k in 2..parts.len() { rest.push(parts[k]); }
                        stack.push({
                            doc: Doc.fill(rest),
                            indent: c.indent,
                            flat: c.flat,
                            must-break: false,
                        });
                        let sep-flat = c.flat || fits-opening(width() - column(o), two);
                        stack.push({
                            doc: parts[1],
                            indent: c.indent,
                            flat: sep-flat,
                            must-break: false,
                        });
                    }
                    stack.push({
                        doc: content,
                        indent: c.indent,
                        flat: c.flat || flat,
                        must-break: false,
                    });
                }
                group(gr) => {
                    if gr.forced {
                        stack.push({
                            doc: gr.doc,
                            indent: c.indent,
                            flat: false,
                            must-break: false,
                        });
                    }
                    else if c.flat {
                        stack.push({
                            doc: gr.doc,
                            indent: c.indent,
                            flat: true,
                            must-break: false,
                        });
                    }
                    else if !c.must-break && fits(width() - column(o), gr.doc, stack) {
                        stack.push({
                            doc: gr.doc,
                            indent: c.indent,
                            flat: true,
                            must-break: false,
                        });
                    } else if gr.hug && fits-open(width() - column(o), gr.prefix, gr.last) {
                        stack.push({
                            doc: gr.suffix,
                            indent: c.indent,
                            flat: true,
                            must-break: false,
                        });
                        stack.push({
                            doc: gr.last,
                            indent: c.indent,
                            flat: false,
                            must-break: true,
                        });
                        stack.push({
                            doc: gr.prefix,
                            indent: c.indent,
                            flat: true,
                            must-break: false,
                        });
                    } else {
                        stack.push({
                            doc: gr.doc,
                            indent: c.indent,
                            flat: false,
                            must-break: false,
                        });
                    }
                }
            }
        }
        newline(o, 0);
        // the file ends in one line break
        let n = o.lines.len();
        for k in 0..n {
            if n - k - 1 > 0 && o.lines[o.lines.len() - 1] == "" { o.lines.pop(); }
        }
        reflow(o.lines).join(from-byte(10)) + from-byte(10)
    }

    // ================================================================ comments

    // lines with each run of comment lines that has one too wide filled again, word by word; a
    // comment line indented further (an example, a usage) or empty is a paragraph of its own
    reflow: func(lines: list<string>) -> list<string> {
        let out: list<string> = [];
        let k = 0;
        for step in 0..lines.len() + 1 {
            if k >= lines.len() { return out; }
            let indent = comment-indent(lines[k]);
            if indent < 0 {
                out.push(lines[k]);
                k += 1;
            } else {
                // the run: the comment lines after it at its indentation
                let end = k;
                let wide = false;
                for j in k..lines.len() {
                    if end == j && comment-indent(lines[j]) == indent {
                        if display-width(lines[j]) > width() { wide = true; }
                        end = j + 1;
                    }
                }
                if wide {
                    fill(lines, k, end, indent, out);
                } else {
                    for j in k..end {
                        out.push(lines[j]);
                    }
                }
                k = end;
            }
        }
        out
    }

    // a line that is only a comment: its indentation; -1 for any other
    comment-indent: func(l: string) -> s64 {
        let n = l.len();
        for k in 0..n {
            let c = l.byte-at(k);
            if c != 32 { return if c == 47 && l.byte-at(k + 1) == 47 { k } else { -1 }; }
        }
        -1
    }

    // lines[from..to] (comments at indent) filled to the width: a paragraph's words joined, a line
    // written as "//" alone, with more than one space after it, or as a label (// error: ...) kept
    // as it is
    fill: func(lines: list<string>, from: s64, to: s64, indent: s64, out: list<string>) {
        let lead = spaces(indent) + "//";
        let words: list<string> = [];
        for j in from..to {
            let body = lines[j].substring(indent + 2, lines[j].len());
            let plain = body.len() > 1 && body.byte-at(0) == 32 && body.byte-at(1) != 32
                && !is-label(body);
            if plain {
                split-words(body, words);
            } else {
                flush(words, lead, out);
                words = [];
                out.push(lines[j]);
            }
        }
        flush(words, lead, out);
    }

    // whether a comment's text (after //) is a label: one word, then a colon (" error: ...", as a
    // test pins its error with)
    is-label: func(body: string) -> bool {
        let n = body.len();
        for k in 1..n {
            let c = body.byte-at(k);
            if c == 58 { return k > 1 && (k + 1 == n || body.byte-at(k + 1) == 32); }
            if !(is-alpha(c) || is-digit(c) || c == 45) { return false; }
        }
        false
    }

    // the words of s (split at spaces) onto words
    split-words: func(s: string, words: list<string>) {
        let start = 0;
        let n = s.len();
        for k in 0..n + 1 {
            if k == n || s.byte-at(k) == 32 {
                if k > start { words.push(s.substring(start, k)); }
                start = k + 1;
            }
        }
    }

    flush: func(words: list<string>, lead: string, out: list<string>) {
        let cur = lead;
        let empty = true;
        for w in words {
            if !empty && display-width(cur) + 1 + display-width(w) > width() {
                out.push(cur);
                cur = lead;
                empty = true;
            }
            cur = cur + " " + w;
            empty = false;
        }
        if !empty { out.push(cur); }
    }

    // the column the next text goes at (a line not started yet: its indentation)
    column: func(o: Out) -> s64 { if o.started { o.col } else { o.indent } }

    emit: func(o: Out, s: string) {
        if s == "" { return; }
        if !o.started {
            o.cur.push(spaces(o.indent));
            o.col = o.indent;
            o.started = true;
        }
        o.cur.push(s);
        let nl = last-newline-at(s);
        if nl >= 0 {
            o.col = display-width(s.substring(nl + 1, s.len()));
        } else {
            o.col += display-width(s);
        }
    }

    newline: func(o: Out, indent: s64) {
        o.lines.push(trim-end(o.cur.join("")));
        o.cur = [];
        o.col = 0;
        o.indent = indent;
        o.started = false;
    }

    spaces: func(n: s64) -> string {
        let out: list<string> = [];
        for k in 0..n { out.push(" "); }
        out.join("")
    }

    last-newline-at: func(s: string) -> s64 {
        let n = s.len();
        for k in 0..n {
            if s.byte-at(n - 1 - k) == 10 { return n - 1 - k; }
        }
        -1
    }

    // columns: characters, not bytes (a UTF-8 continuation byte adds none)
    display-width: func(s: string) -> s64 {
        let w = 0;
        for k in 0..s.len() {
            let c = s.byte-at(k);
            if c < 128 || c >= 192 { w += 1; }
        }
        w
    }

    // whether doc, flat, and what follows it up to the next line break fits in w columns
    fits: func(w: s64, doc: Doc, rest: list<Cmd>) -> bool { measure(w, doc, rest, false) }

    // whether a layout fits in w columns up to a {} or [] group's opening break, which ends the
    // line there: what a fill's separator stays flat by, so that formatting what this makes again
    // (that break a hard line then) decides the same
    fits-opening: func(w: s64, doc: Doc) -> bool { measure(w, doc, [], true) }

    // a layout's measure: whether it fits in w columns, flat, up to its first line break (in it,
    // or after it, in rest: the line going on). A group broken already inside it cannot be flat:
    // it does not fit. to-opening: a {} or [] group's opening break ends the line there
    measure: func(w: s64, doc: Doc, rest: list<Cmd>, to-opening: bool) -> bool {
        let left = w;
        // what is left to measure, and of each whether it is the layout's own (else rest's)
        let todo: list<Doc> = [doc,];
        let flats: list<bool> = [true,];
        let owns: list<bool> = [true,];
        let r = rest.len();
        loop {
            if todo.len() == 0 {
                if r == 0 { return true; }
                r -= 1;
                todo.push(rest[r].doc);
                flats.push(rest[r].flat);
                owns.push(false);
            }
            let d = todo.pop();
            let flat = flats.pop();
            let own = owns.pop();
            match d {
                text(s) => {
                    let nl = find-byte(s, 10).unwrap-or(-1);
                    left -= display-width(if nl >= 0 { s.substring(0, nl) } else { s });
                    if left < 0 { return false; }
                    if nl >= 0 { return true; }
                }
                line => {
                    if !flat { return true; }
                    left -= 1;
                    if left < 0 { return false; }
                }
                softline => { if !flat { return true; } }
                hardline => { return true; }
                opening-break(inner) => {
                    if to-opening { return true; }
                    todo.push(inner);
                    flats.push(flat);
                    owns.push(own);
                }
                ifbreak(s) => {
                    if !flat {
                        left -= display-width(s);
                        if left < 0 { return false; }
                    }
                }
                concat(ds) | fill(ds) => {
                    for k in 0..ds.len() {
                        todo.push(ds[ds.len() - 1 - k]);
                        flats.push(flat);
                        owns.push(own);
                    }
                }
                nest(inner) => {
                    todo.push(inner);
                    flats.push(flat);
                    owns.push(own);
                }
                group(gr) => {
                    if gr.forced && own && !to-opening { return false; }
                    todo.push(gr.doc);
                    flats.push(flat && !gr.forced);
                    owns.push(own);
                }
            }
        }
        true
    }

    // whether a hugged call's prefix, and its last group's opening, fit in w columns
    fits-open: func(w: s64, prefix: Doc, last: Doc) -> bool {
        fits(w, Doc.concat([prefix, opening(last),]), [])
    }

    // a group's layout up to its first break: its opening bracket's text
    opening: func(d: Doc) -> Doc {
        match d {
            group(gr) => opening(gr.doc),
            concat(ds) => if ds.len() > 0 { opening(ds[0]) } else { d },
            _ => d,
        }
    }
}
