// Inlining for escape analysis: a func that returns a record it makes is
// inlined where it is called, so that record can stay on the caller's stack (escape.yel). Inlined
// for that alone: clang inlines for call overhead. Mode size: where called once (the func then
// dropped) or where tiny, so the program grows no bigger; speed: up to 40 statements too. Funcs no
// longer called are dropped; then every record that never escapes its func goes on its stack.

module opt {
    // a func's size: its statements, nested ones counted
    size: func(body: list<Node>) -> s64 { flatten(body).len() }

    // whether a func can reach itself through its calls
    recursive: func(facts: Facts, name: Name) -> bool {
        let seen: map<Name, bool> = map.new();
        let todo: list<Name> = [name,];
        let first = true;
        loop {
            if todo.len() == 0 { return false; }
            let current = todo.pop();
            if !first && current == name { return true; }
            first = false;
            if !seen.has(current) && facts.callees.has(current) {
                seen.set(current, true);
                for callee in facts.callees[current] {
                    if callee == name { return true; }
                    todo.push(callee);
                }
            }
        }
    }

    // the funcs a node takes as values or calls inside an expression (their C names, into out),
    // and the writers that show a value (an interpolation's, a match no arm fits: a func's C name
    // each; std's walker the backends keep as a root)
    func-refs: func(node: Node, out: list<Name>) {
        match node.kind {
            func-ref(reference) => out.push(reference.name),
            call(reference) => if reference.key != "" { out.push(reference.name); },
            interp(reference) => {
                for formatter in reference.formatters {
                    match formatter {
                        writer(name) => out.push(intern(name)),
                        _ => {}
                    }
                }
            }
            // (a match no arm fits shows its value by one too)
            unreachable(reference) => match reference.formatter {
                writer(name) => out.push(intern(name)),
                _ => {}
            },
            _ => {}
        }
        for index in 0..operand-count(node) { func-refs(operand(node, index), out); }
    }

    // whether a func returns a record it makes
    returns-fresh: func(facts: Facts, function: IrFunc) -> bool {
        let gr = facts.groups[function.name];
        for statement in flatten(function.body) {
            match statement.kind {
                return(returned) => {
                    match returned.kind {
                        local(local) => {
                            for made in gr.records {
                                if find(gr, local) == find(gr, made) { return true; }
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        false
    }

    // the funcs a root reaches by its calls (and the funcs they take as values), in funcs' order
    reachable: func(funcs: list<IrFunc>, roots: list<string>) -> list<IrFunc> {
        let by-name: map<Name, IrFunc> = map.new();
        for function in funcs { by-name.set(function.name, function); }
        let reached: map<Name, bool> = map.new();
        let todo: list<Name> = [];
        for root in roots { todo.push(intern(root)); }
        loop {
            if todo.len() == 0 { break; }
            let current = todo.pop();
            if !reached.has(current) && by-name.has(current) {
                reached.set(current, true);
                let out: list<Name> = [];
                calls(by-name[current].body, out, map.new());
                for statement in flatten(by-name[current].body) { func-refs(statement, out); }
                for callee in out {
                    todo.push(callee);
                    // an async func's call begun (s_<name>): its step (u_<name>)
                    let text = name-text(callee);
                    if starts-at(text, 0, "s_") { todo.push(intern("u_" + text.substring(2, text.len()))); }
                }
            }
        }
        funcs.filter({ function -> reached.has(function.name) })
    }

    // the program optimized (see the top of this file); roots: the funcs kept whatever calls them
    // (main, and each exported func)
    optimize: func(
        funcs: list<IrFunc>,
        pointer-types: map<Name, bool>,
        value-payloads: map<Name, list<Type>>,
        func-holders: map<Name, bool>,
        mode: string,
        roots: list<string>,
        wit: set<Name>,
        externs: map<string, RuntimeEffect>,
    ) -> list<IrFunc> {
        let facts: Facts = {
            funcs: map.new(),
            param-escapes: map.new(),
            param-kept-in: map.new(),
            param-gives: map.new(),
            param-writes: map.new(),
            param-lent: map.new(),
            param-changes: map.new(),
            fresh-result: map.new(),
            new-top: map.new(),
            wit: wit,
            externs: externs,
            pointer-types: pointer-types,
            value-payloads: value-payloads,
            observable-types: map.new(),
            func-holders: func-holders,
            groups: map.new(),
            callees: map.new(),
            flows: map.new(),
            mutable-locals: map.new(),
            env-escapes: map.new(),
        };
        for function in funcs { facts.funcs.set(function.name, function); }
        param-escapes(facts, funcs);
        let counts: map<Name, s64> = map.new();
        for function in funcs { calls(function.body, [], counts); }
        let rooted: set<Name> = set.new();
        for root in roots { rooted.add(intern(root)); }
        let inline: map<Name, bool> = map.new();
        for function in funcs {
            let count = counts.get-or(function.name, 0);
            let small = if mode == "speed" { 40 } else { 0 };
            if !rooted.has(function.name) && count > 0 && (count == 1 || size(function.body) <= small)
                && returns-fresh(facts, function) && !recursive(facts, function.name) {
                inline.set(function.name, true);
            }
        }
        // callees before their callers, so what is inlined is already inlined into
        let done: map<Name, bool> = map.new();
        for function in funcs { inline-into(facts, function, inline, done); }
        // what is still called (from a root) is kept
        let kept = reachable(funcs, roots);
        param-escapes(facts, kept);
        for function in kept { place-records(facts, function); }
        kept
    }

    inline-into: func(facts: Facts, function: IrFunc, inline: map<Name, bool>, done: map<Name, bool>) {
        if done.has(function.name) { return; }
        done.set(function.name, true);
        let out: list<Name> = [];
        calls(function.body, out, map.new());
        for callee in out {
            if inline.has(callee) && facts.funcs.has(callee) {
                inline-into(facts, facts.funcs[callee], inline, done);
            }
        }
        inline-body(facts, function, function.body, inline);
    }

    // a body with the calls of funcs to inline spliced in, in place
    inline-body: func(facts: Facts, function: IrFunc, body: list<Node>, inline: map<Name, bool>) {
        let out: list<Node> = [];
        for statement in body {
            let target = callee(statement).unwrap-or(function.name);
            if inline.has(target) && target != function.name {
                let dest = match statement.kind {
                    assign(assignment) => assignment.dest,
                    _ => -1,
                };
                for spliced in splice(function, facts.funcs[target], value(statement), dest) { out.push(spliced); }
            } else {
                for index in 0..nested-count(statement) { inline-body(facts, function, nested-body(statement, index), inline); }
                out.push(statement);
            }
        }
        replace-body(body, out);
    }

    // a call of g in f, as g's body (its params given the arguments, its returns leaving the block
    // with their value in dest)
    splice: func(function: IrFunc, inlined: IrFunc, call-n: Node, dest: s64) -> list<Node> {
        let args = match call-n.kind {
            call(called) => called.args,
            _ => [],
        };
        let base = function.locals.len();
        for local in inlined.locals { function.locals.push({ ty: local.ty, name: local.name, binding: local.binding, }); }
        let label = function.labels;
        function.labels += 1 + inlined.labels;
        let out: list<Node> = [];
        for index in 0..inlined.params.len() { out.push(assign(base + inlined.params[index], args[index])); }
        let called: Clone = { base: base, lbase: label + 1, exit: label, dest: dest, };
        out.push(block-stmt(clone-body(called, inlined.body), label));
        out
    }
}

// a body copied into another func: its locals from base, its labels from lbase, its returns
// leaving block exit with their value in dest (-1: none)
resource Clone { base: s64, lbase: s64, exit: s64, dest: s64, }

module opt {
    clone-body: func(cloning: Clone, body: list<Node>) -> list<Node> {
        let out: list<Node> = [];
        for statement in body {
            match statement.kind {
                return(returned) => {
                    if cloning.dest >= 0 { out.push(assign(cloning.dest, clone(cloning, returned))); }
                    out.push(break-stmt(cloning.exit));
                }
                _ => out.push(clone(cloning, statement)),
            }
        }
        out
    }

    clone-label: func(cloning: Clone, label: s64) -> s64 { if label >= 0 { label + cloning.lbase } else { label } }

    clone-all: func(cloning: Clone, ns: list<Node>) -> list<Node> {
        let out: list<Node> = [];
        for statement in ns { out.push(clone(cloning, statement)); }
        out
    }

    clone-some: func(cloning: Clone, optional: option<Node>) -> option<Node> {
        match optional {
            some(node) => some(clone(cloning, node)),
            none => none,
        }
    }

    // a node copied: its type and effects kept
    clone: func(cloning: Clone, node: Node) -> Node {
        let kind = match node.kind {
            const(_) => node.kind,
            local(slot) => Kind.local(slot + cloning.base),
            assign(assignment) => Kind.assign({ dest: assignment.dest + cloning.base, value: clone(cloning, assignment.value), }),
            bin(binary) => Kind.bin({ op: binary.op, a: clone(cloning, binary.a), b: clone(cloning, binary.b), }),
            un(unary) => Kind.un({ op: unary.op, a: clone(cloning, unary.a), }),
            convert(operand) => Kind.convert(clone(cloning, operand)),
            load(load) => Kind.load({ base: clone(cloning, load.base), path: load.path, arrow: load.arrow, }),
            store(store) => Kind.store({ target: clone(cloning, store.target), value: clone(cloning, store.value), }),
            if(conditional) => Kind.if({
                test: clone(cloning, conditional.test),
                yes: clone-body(cloning, conditional.yes),
                no: clone-body(cloning, conditional.no),
            }),
            loop(repeat) => Kind.loop({
                test: clone-some(cloning, repeat.test),
                step: clone-some(cloning, repeat.step),
                body: clone-body(cloning, repeat.body),
                label: clone-label(cloning, repeat.label),
            }),
            break(label) => Kind.break(clone-label(cloning, label)),
            continue(label) => Kind.continue(clone-label(cloning, label)),
            block(block) => Kind.block({
                body: clone-body(cloning, block.body),
                label: clone-label(cloning, block.label),
            }),
            return(returned) => Kind.return(clone(cloning, returned)),
            unreachable(unreachable) => Kind.unreachable({ value: clone(cloning, unreachable.value), formatter: unreachable.formatter, }),
            halt => node.kind,
            // an async func's states (it is never inlined: its own)
            resume(_) => node.kind,
            suspend(_) => node.kind,
            yield(yielded) => Kind.yield(clone(cloning, yielded)),
            call(called) => Kind.call({ key: called.key, c-name: called.c-name, name: called.name, args: clone-all(cloning, called.args), }),
            func-ref(_) => node.kind,
            call-ref(reference) => Kind.call-ref({
                callee: clone(cloning, reference.callee),
                args: clone-all(cloning, reference.args),
            }),
            alloc(alloc) => Kind.alloc({
                ctype: alloc.ctype,
                rec: alloc.rec,
                is-record: alloc.is-record,
                trace: alloc.trace,
                stack: false,
            }),
            make(make) => Kind.make({
                ctype: make.ctype,
                fields: make.fields,
                parts: clone-all(cloning, make.parts),
            }),
            list-get(list-get) => Kind.list-get({
                fixed: list-get.fixed,
                list: clone(cloning, list-get.list),
                index: clone(cloning, list-get.index),
                ctype: list-get.ctype,
            }),
            interp(interpolation) => Kind.interp({ parts: clone-all(cloning, interpolation.parts), formatters: interpolation.formatters, }),
            deref(operand) => Kind.deref(clone(cloning, operand)),
            address-of(operand) => Kind.address-of(clone(cloning, operand)),
            size-of(measured) => Kind.size-of(measured),
            type-arg(_) => node.kind,
            global(_) => node.kind,
            scan(_) => node.kind,
            static-list(_) => node.kind,
            descriptor(_) => node.kind,
            element(element) => Kind.element({ base: clone(cloning, element.base), index: clone(cloning, element.index), item: element.item, }),
        };
        new-node(kind, node.ty, node.fx)
    }
}
