// The parser: a file's tokens (lexer.lex-file's: each string in pieces) to its syntax tree
// (syntax.yel's, lossless: every byte of the file in it). Each construct is a node of its kind,
// wrapped once parsed around what was built since a mark taken before it (a call around its
// callee, a binary around its left); whitespace and comments before a construct are its holder's.
// What a construct's errors pass over is an error node, so the tree of a broken file is whole.
// Its errors are told as they are met (a missing token just past the last taken), the statement
// or declaration in error passed over to where the next one starts. What the tree means (the
// declarations and expressions the checker reads) is lower.yel's.
//
// The parser reads tokens in units: a string is one (its quotes, its text and its interpolations)
// where it is taken whole (an include's package, an attribute's value) or looked past; an
// expression's string is read piece by piece, each interpolation's expression parsed where it is
// (an error in one is its own: the statement goes on past it).

resource Grammar {
    toks: list<Token>,
    // each token's kind, text and whether it is a %name (what lookahead reads: no token copied)
    kinds: list<TokenKind>,
    texts: list<string>,
    escaped: list<bool>,
    starts: list<s64>,
    // each precedence level's operators, lowest first
    levels: list<list<string>>,
    // the unit after each token (a string's start: the token past its end), and before
    next-unit: list<s64>,
    pos: s64,
    context: Context,
    source: s64,
    tree: TreeBuilder,
    recovering: bool,
    quiet: bool,
    // the characters no token starts with, inside an interpolation (the lexer told none there:
    // told where one is parsed)
    unknowns: list<Token>,
    // the module the parser is in ("" at the top), and the attributes on what it parses
    // (@(observable), @(context), @(container): where they may go)
    module: string,
    observable: bool,
    in-context: bool,
    container: bool,
}

module grammar {
    // the syntax tree of sources[source], kept in the context's trees (an analysis's: a build
    // lowers each file's as it is read, and keeps none); one its cache has of the same text, not
    // parsed again (its errors told again, as its parse told them)
    parse-file: func(context: Context, source: s64) -> GreenNode {
        // (a file the cache has, its text the same: its tree, its errors told again)
        let path = context.sources[source].path;
        let text = context.sources[source].text;
        match context.cache {
            some(cache) => {
                match cache.files.get(path) {
                    some(parsed) => {
                        if parsed.text == text {
                            for diagnostic in parsed.errors { diagnostics.report(context, moved-diagnostic(diagnostic, parsed.source, source)); }
                            if !context.exits { context.trees.set(source, parsed.green); }
                            return parsed.green;
                        }
                    }
                    none => {}
                }
            }
            none => {}
        }
        let before = context.errors.len();
        let parsing = grammar(context, source);
        for step in 0..parsing.toks.len() {
            if is-kind(parsing, 0, TokenKind.eof) { break; }
            recovering-declaration(parsing);
        }
        let green = tree.finish-file(parsing.tree);
        if !context.exits { context.trees.set(source, green); }
        match context.cache {
            some(cache) => cache.files.set(path, { text: text, green: green, errors: context.errors.slice(before, context.errors.len()), source: source, }),
            none => {}
        }
        green
    }

    @(private) grammar: func(context: Context, source: s64) -> Grammar {
        let before = context.errors.len();
        let text = context.sources[source].text;
        let lexed = lexer.lex-file(text, context, source);
        let toks: list<Token> = [];
        let unknowns: list<Token> = [];
        for token in lexed {
            if token.kind == TokenKind.unknown { unknowns.push(token); } else { toks.push(token); }
        }
        let parsing: Grammar = {
            toks: toks,
            kinds: toks.map({ token -> token.kind }),
            texts: toks.map({ token -> token.text }),
            escaped: toks.map({ token -> token.escaped }),
            starts: toks.map({ token -> token.start }),
            levels: [
                ["||",], ["&&",], ["==", "!=",], ["<", "<=", ">", ">=",], ["|",], ["^",], ["&",], ["<<", ">>",],
                ["+", "-",], ["*", "/", "%",],
            ],
            next-unit: units(toks),
            pos: 0,
            context: context,
            source: source,
            tree: tree.builder(text),
            recovering: false,
            quiet: context.errors.len() > before,
            unknowns: unknowns,
            module: "",
            observable: false,
            container: false,
            in-context: false,
        };
        parsing
    }

    // the unit after each token: the next, but past a whole string from its start
    @(private) units: func(toks: list<Token>) -> list<s64> {
        let out: list<s64> = [];
        for index in 0..toks.len() { out.push(index + 1); }
        let open: list<s64> = [];
        for index in 0..toks.len() {
            if toks[index].kind == TokenKind.string-start { open.push(index); }
            else if toks[index].kind == TokenKind.string-end && open.len() > 0 {
                out[open.pop()] = index + 1;
            }
        }
        // (an unterminated string: to the file's end)
        for index in open { out[index] = toks.len() - 1; }
        out
    }

    // ---- tokens

    // the token o units past the next (a string's: its start), the end of the file's past the last
    tok: func(parsing: Grammar, offset: s64) -> Token {
        let at = unit-at(parsing, offset);
        if at >= parsing.toks.len() { return parsing.toks[parsing.toks.len() - 1]; }
        if at < 0 { return parsing.toks[0]; }
        parsing.toks[at]
    }

    // the index of the unit o past the next (o < 0: the token o before it)
    @(private) unit-at: func(parsing: Grammar, offset: s64) -> s64 {
        if offset < 0 { return parsing.pos + offset; }
        let at = parsing.pos;
        for step in 0..offset {
            if at >= parsing.toks.len() - 1 { return parsing.toks.len() - 1; }
            at = parsing.next-unit[at];
        }
        at
    }

    here: func(parsing: Grammar) -> Span { tok(parsing, 0).span }

    // from start to the end of the last token taken
    span-from: func(parsing: Grammar, start: Span) -> Span {
        let last = tok(parsing, -1).span;
        { source: start.source, line: start.line, col: start.col, end-line: last.end-line, end-col: last.end-col, }
    }

    text: func(parsing: Grammar) -> string { parsing.texts[index-at(parsing, 0)] }

    // the next unit as an error says what was found: quoted (a string by its text), or the end of
    // the file
    found: func(parsing: Grammar) -> string {
        if is-kind(parsing, 0, TokenKind.eof) { return "the end of the file"; }
        if is-string(parsing, 0) { return "'{string-text(parsing, parsing.pos)}'"; }
        "'{text(parsing)}'"
    }

    // a string's text as written between its quotes (a multiline one's, its lines past its indent)
    string-text: func(parsing: Grammar, start: s64) -> string {
        let opening = parsing.toks[start];
        let src = parsing.context.sources[parsing.source].text;
        let after = parsing.next-unit[start];
        let closing = parsing.toks[after - 1];
        let end = if closing.kind == TokenKind.string-end && after - 1 > start { closing.start } else { src.len() };
        if opening.text == "\"\"\"" {
            let block = lexer.multiline(src, parsing.context, parsing.source, opening.start, opening.span.line, opening.span.col, true);
            return block.text;
        }
        src.substring(opening.end, end)
    }

    // the next unit taken: a token, or a string whole
    advance: func(parsing: Grammar) {
        if parsing.pos >= parsing.toks.len() - 1 { return; }
        let after = parsing.next-unit[parsing.pos];
        for index in parsing.pos..after {
            if index < parsing.toks.len() - 1 { tree.token(parsing.tree, parsing.toks[index]); }
        }
        parsing.pos = if after < parsing.toks.len() { after } else { parsing.toks.len() - 1 };
    }

    // the next token taken (a string's piece)
    bump: func(parsing: Grammar) {
        if parsing.pos >= parsing.toks.len() - 1 { return; }
        tree.token(parsing.tree, parsing.toks[parsing.pos]);
        parsing.pos += 1;
    }

    // the next unit's text, taken (a string's text as written between its quotes)
    next: func(parsing: Grammar) -> string {
        let taken = if is-string(parsing, 0) { string-text(parsing, parsing.pos) } else { text(parsing) };
        advance(parsing);
        taken
    }

    // the index of the unit at o, within the tokens (the end of the file's past them)
    @(private) index-at: func(parsing: Grammar, offset: s64) -> s64 {
        let at = if offset == 0 { parsing.pos } else { unit-at(parsing, offset) };
        if at >= parsing.toks.len() { parsing.toks.len() - 1 } else if at < 0 { 0 } else { at }
    }

    // whether the unit at o is the operator or name v (a name written %name is never the keyword
    // of its word)
    at-off: func(parsing: Grammar, word: string, offset: s64) -> bool {
        let at = index-at(parsing, offset);
        let kind = parsing.kinds[at];
        // (not a char: '!' is no !)
        (kind == TokenKind.id || kind == TokenKind.op || kind == TokenKind.float || kind == TokenKind.regex)
            && !parsing.escaped[at] && parsing.texts[at] == word
    }

    at: func(parsing: Grammar, word: string) -> bool { at-off(parsing, word, 0) }

    // whether the unit at o is of kind k (a string's: is-string)
    is-kind: func(parsing: Grammar, offset: s64, kind: TokenKind) -> bool { parsing.kinds[index-at(parsing, offset)] == kind }

    is-string: func(parsing: Grammar, offset: s64) -> bool { parsing.kinds[index-at(parsing, offset)] == TokenKind.string-start }

    // ---- the tree

    // where the tree is, past the whitespace and comments before the next token (the holder's)
    mark: func(parsing: Grammar) -> TreeMark {
        tree.trivia(parsing.tree, parsing.starts[parsing.pos]);
        tree.mark(parsing.tree)
    }

    // what was built since at made a node of kind
    wrap: func(parsing: Grammar, at: TreeMark, kind: NodeKind) {
        tree.start-at(parsing.tree, at, kind);
        tree.finish(parsing.tree);
    }

    // ---- errors

    // a syntax error at the next token, kept: the parser goes on (recovering, until the statement
    // or declaration is passed over); its callers go on as if what was not there were
    fail: func(parsing: Grammar, message: string) { fail-at(parsing, here(parsing), message); }

    // an error at what a span covers
    fail-at: func(parsing: Grammar, at: Span, message: string) {
        if parsing.recovering || parsing.quiet { return; }
        parsing.recovering = true;
        diagnostics.report(parsing.context, diagnostics.error(at, message, ""));
    }

    // a missing token is told just past the last one taken, where it belongs
    fail-missing: func(parsing: Grammar, message: string) {
        if parsing.pos == 0 {
            fail(parsing, message);
            return;
        }
        let last = tok(parsing, -1).span;
        let at: Span = { source: last.source, line: last.end-line, col: last.end-col, end-line: last.end-line, end-col: last.end-col + 1, };
        fail-at(parsing, at, message);
    }

    // an error told with the parse going on (not recovering): what comes after still parses
    tell: func(parsing: Grammar, at: Span, message: string) {
        if parsing.recovering || parsing.quiet { return; }
        diagnostics.report(parsing.context, diagnostics.error(at, message, ""));
    }

    // past an error, the statement or declaration it is in passed over (from its first token,
    // start): to its ; (taken), past a { … } that closes it (and a ; after), or to the } of what
    // holds it (left for its holder), its brackets matched as they open and close (one left open
    // given up, so a } still closes what it belongs to). What it passes over is an error node; the
    // parser goes on from there, no longer recovering
    pass-over: func(parsing: Grammar, start: s64) {
        let begun = mark(parsing);
        let from = parsing.pos;
        let to = passed-to(parsing, start);
        parsing.recovering = false;
        if to > from {
            for index in from..to {
                if index < parsing.toks.len() - 1 { tree.token(parsing.tree, parsing.toks[index]); }
            }
            parsing.pos = to;
            wrap(parsing, begun, NodeKind.error);
        }
    }

    // where pass-over goes on from (start: the statement's first token)
    @(private) passed-to: func(parsing: Grammar, start: s64) -> s64 {
        let open: list<string> = [];
        let index = start;
        loop {
            if index >= parsing.toks.len() { return parsing.pos; }
            let token = parsing.toks[index];
            if token.kind == TokenKind.eof { return index; }
            // (a string: one token)
            if token.kind == TokenKind.string-start {
                index = parsing.next-unit[index];
                continue;
            }
            let bracket = token.kind == TokenKind.op;
            if bracket && (token.text == "\{" || token.text == "(" || token.text == "[") { open.push(token.text); }
            else if bracket && (token.text == "\}" || token.text == ")" || token.text == "]") {
                let opener = if token.text == "\}" { "\{" } else if token.text == ")" { "(" } else { "[" };
                // the brackets it closes past, left open, given up
                loop {
                    if open.len() == 0 || open[open.len() - 1] == opener { break; }
                    open.pop();
                }
                if open.len() == 0 {
                    // the holder's: left for it
                    return if index >= parsing.pos { index } else { parsing.pos };
                }
                open.pop();
                if open.len() == 0 && token.text == "\}" && index + 1 >= parsing.pos {
                    let after = parsing.next-unit[index];
                    let following = if after < parsing.toks.len() { parsing.toks[after] } else { parsing.toks[parsing.toks.len() - 1] };
                    // if … { } else { }: the else is the statement's too; a ; after it, taken
                    if following.kind == TokenKind.op && following.text == ";" { return parsing.next-unit[after]; }
                    if !(following.kind == TokenKind.id && following.text == "else") { return after; }
                }
            } else if bracket && token.text == ";" && !open.contains("\{") && index >= parsing.pos {
                return index + 1;
            }
            index = parsing.next-unit[index];
        }
        parsing.pos
    }

    // v taken; where the next unit is another, an error (and it is left)
    expect: func(parsing: Grammar, word: string) {
        if !at(parsing, word) {
            fail-missing(parsing, "expected '{word}', found {found(parsing)}");
            return;
        }
        advance(parsing);
    }

    // a name taken (its text): never a directive, nor a keyword but written %name (a case's name
    // before a ( and a member's after a . may be one: Kind.return(x))
    name: func(parsing: Grammar) -> string {
        if !is-kind(parsing, 0, TokenKind.id) { fail(parsing, "expected a name, found {found(parsing)}"); }
        if tok(parsing, 0).text.starts-with("#") { fail(parsing, "expected a name, found the directive {tok(parsing, 0).text}"); }
        let member = at-off(parsing, "(", 1) || (parsing.pos > 0 && tok(parsing, -1).kind == TokenKind.op && tok(parsing, -1).text == ".");
        if !tok(parsing, 0).escaped && !member && is-keyword(tok(parsing, 0).text) {
            fail(parsing, "expected a name, found the keyword {tok(parsing, 0).text} (a name of that word is written %{tok(parsing, 0).text})");
        }
        next(parsing)
    }

    // whether a word is one of yel's keywords (never a name, but written %name)
    is-keyword: func(word: string) -> bool {
        word == "if" || word == "else" || word == "match" || word == "for" || word == "in" || word == "return"
            || word == "break" || word == "continue" || word == "let" || word == "as" || word == "is"
    }

    // ================================================================ types

    // a type: one, or a union of several (A | B)
    parse-type: func(parsing: Grammar) {
        let begun = mark(parsing);
        readonly-member(parsing);
        if !at(parsing, "|") { return; }
        for step in parsing.pos..parsing.toks.len() {
            if !at(parsing, "|") { break; }
            advance(parsing);
            readonly-member(parsing);
        }
        wrap(parsing, begun, NodeKind.union-type);
    }

    // a type, and & readonly after it (tighter than |)
    readonly-member: func(parsing: Grammar) {
        let begun = mark(parsing);
        type-member(parsing);
        if at(parsing, "&") && at-off(parsing, "readonly", 1) {
            advance(parsing);
            advance(parsing);
            wrap(parsing, begun, NodeKind.readonly-type);
        }
    }

    // a type a union is made of: a literal (its one value: "get", 3, -1, 'a', true) or a range
    // of them (1..=9), (), { field: T }, or a type named (with its arguments)
    type-member: func(parsing: Grammar) {
        let begun = mark(parsing);
        if is-kind(parsing, 0, TokenKind.int) || is-kind(parsing, 0, TokenKind.float)
            || is-string(parsing, 0) || is-kind(parsing, 0, TokenKind.char) || at(parsing, "-")
            && (is-kind(parsing, 1, TokenKind.int) || is-kind(parsing, 1, TokenKind.float)) || at(parsing, "true")
            || at(parsing, "false") {
            let written = tok(parsing, 0);
            let first = unary(parsing);
            if at(parsing, "..=") || at(parsing, "..") {
                advance(parsing);
                unary(parsing);
                range-ends(parsing, first, written);
                wrap(parsing, begun, NodeKind.range-type);
                return;
            }
            literal-kind(parsing, first);
            wrap(parsing, begun, NodeKind.literal-type);
            return;
        }
        // (): unit
        if at(parsing, "(") {
            advance(parsing);
            expect(parsing, ")");
            wrap(parsing, begun, NodeKind.unit-type);
            return;
        }
        // { x: s32, y: string }: an anonymous record
        if at(parsing, "\{") {
            advance(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    break;
                }
                let field = mark(parsing);
                name(parsing);
                expect(parsing, ":");
                parse-type(parsing);
                wrap(parsing, field, NodeKind.record-type-field);
                if !at(parsing, "\}") { expect(parsing, ","); }
            }
            wrap(parsing, begun, NodeKind.record-type);
            return;
        }
        let dotted = name(parsing);
        if at(parsing, ".") {
            advance(parsing);
            dotted = dotted + "." + name(parsing);
        }
        // func(T, U) -> R
        if dotted == "func" && at(parsing, "(") {
            advance(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, ")") { break; }
                parse-type(parsing);
                if !at(parsing, ")") { expect(parsing, ","); }
            }
            expect(parsing, ")");
            if at(parsing, "->") {
                advance(parsing);
                parse-type(parsing);
            }
            wrap(parsing, begun, NodeKind.func-type);
            return;
        }
        if dotted == "map" || dotted == "set" || dotted == "list" || dotted == "option" || dotted == "future" || dotted == "seq" || dotted == "stream"
            || dotted == "writer" || dotted == "tuple" || dotted == "result" {
            type-args(parsing, dotted);
        }
        if dotted == "_" { fail(parsing, "_ is only a result's absent payload"); }
        wrap(parsing, begun, NodeKind.named-type);
    }

    // a type's arguments, as its name takes them: map<K, V>, set<T>, list<T> (list<T, N>,
    // list<T, ?>), option<T>, …, tuple<T, …>, result<T, E> (_ for none, either left out)
    type-args: func(parsing: Grammar, written: string) {
        let begun = mark(parsing);
        if written == "map" || written == "set" {
            expect(parsing, "<");
            parse-type(parsing);
            if written == "map" {
                expect(parsing, ",");
                parse-type(parsing);
            }
            expect(parsing, ">");
        } else if written == "tuple" {
            expect(parsing, "<");
            let items = 0;
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, ">") {
                    advance(parsing);
                    if items == 0 { fail(parsing, "a tuple needs a type (no value's type is ())"); }
                    break;
                }
                parse-type(parsing);
                items += 1;
                if !at(parsing, ">") { expect(parsing, ","); }
            }
        } else if written == "result" {
            if at(parsing, "<") {
                advance(parsing);
                result-part(parsing);
                if at(parsing, ",") {
                    advance(parsing);
                    if !at(parsing, ">") {
                        result-part(parsing);
                        if at(parsing, ",") { advance(parsing); }
                    }
                }
                expect(parsing, ">");
            }
        } else {
            expect(parsing, "<");
            parse-type(parsing);
            if at(parsing, ",") { advance(parsing); }
            // list<T, N> or list<T, ?>: fixed-length
            if written == "list" && (at(parsing, "?") || is-kind(parsing, 0, TokenKind.int)) {
                if is-kind(parsing, 0, TokenKind.int) { let _ = fixed-len(parsing, text(parsing)); }
                advance(parsing);
            }
            expect(parsing, ">");
        }
        wrap(parsing, begun, NodeKind.type-args);
    }

    // a result's payload type, or _ for none
    result-part: func(parsing: Grammar) {
        if at(parsing, "_") {
            let begun = mark(parsing);
            advance(parsing);
            wrap(parsing, begun, NodeKind.named-type);
            return;
        }
        parse-type(parsing);
    }

    // a fixed-length list's length: a decimal from 1
    fixed-len: func(parsing: Grammar, digits: string) -> s64 {
        let value = 0;
        for index in 0..digits.len() {
            let byte = digits.byte-at(index);
            if !is-digit(byte) || value > 100000000 { fail(parsing, "a list's length is a decimal integer: {digits}"); }
            value = value * 10 + (byte - 48);
        }
        if value < 1 { fail(parsing, "a fixed-length list holds at least one item"); }
        value
    }

    // a literal type's value: a number, a string, a char or a bool (- before a number); not a
    // string that interpolates
    literal-kind: func(parsing: Grammar, kind: NodeKind) {
        if kind != NodeKind.literal && kind != NodeKind.string-lit && kind != NodeKind.unary-expr {
            fail(parsing, "a literal type is a number, a string, a char or a bool");
        }
    }

    // a range type's first end: an integer or a char (- before a number)
    range-ends: func(parsing: Grammar, first: NodeKind, written: Token) {
        let integer = first == NodeKind.literal && (written.kind == TokenKind.int || written.kind == TokenKind.char);
        if !integer && first != NodeKind.unary-expr { fail(parsing, "a range type is of integers or chars"); }
    }

    // ================================================================ patterns

    // a pattern: alternatives (p | q), each a single one
    pattern: func(parsing: Grammar) {
        let begun = mark(parsing);
        single-pattern(parsing);
        if !at(parsing, "|") { return; }
        for step in parsing.pos..parsing.toks.len() {
            if !at(parsing, "|") { break; }
            advance(parsing);
            single-pattern(parsing);
        }
        wrap(parsing, begun, NodeKind.alt-pattern);
    }

    // _; let and a pattern (its names binding), let n: T; a literal or a range; { field: pattern,
    // field, ...rest }; (a, b) or (p); name(pattern); a name
    single-pattern: func(parsing: Grammar) {
        let begun = mark(parsing);
        if at(parsing, "_") {
            advance(parsing);
            wrap(parsing, begun, NodeKind.wild-pattern);
            return;
        }
        if at(parsing, "let") {
            advance(parsing);
            if is-kind(parsing, 0, TokenKind.id) && at-off(parsing, ":", 1) {
                name(parsing);
                advance(parsing);
                type-member(parsing);
                wrap(parsing, begun, NodeKind.typed-pattern);
                return;
            }
            single-pattern(parsing);
            wrap(parsing, begun, NodeKind.let-pattern);
            return;
        }
        if is-kind(parsing, 0, TokenKind.int) || is-kind(parsing, 0, TokenKind.float)
            || is-string(parsing, 0) || is-kind(parsing, 0, TokenKind.char) || at(parsing, "-") && (
            is-kind(parsing, 1, TokenKind.int) || is-kind(parsing, 1, TokenKind.float)
        ) {
            unary(parsing);
            if at(parsing, "..=") || at(parsing, "..") {
                advance(parsing);
                unary(parsing);
                wrap(parsing, begun, NodeKind.range-pattern);
                return;
            }
            wrap(parsing, begun, NodeKind.literal-pattern);
            return;
        }
        if at(parsing, "\{") {
            advance(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    break;
                }
                // ...rest: the fields not named, last
                if at(parsing, "...") {
                    let rest = mark(parsing);
                    advance(parsing);
                    let named = name(parsing);
                    wrap(parsing, rest, NodeKind.rest-pattern);
                    if !at(parsing, "\}") { expect(parsing, ","); }
                    if !at(parsing, "\}") { fail(parsing, "...{named} is a record pattern's last"); }
                    continue;
                }
                let field = mark(parsing);
                name(parsing);
                if at(parsing, ":") {
                    advance(parsing);
                    pattern(parsing);
                }
                wrap(parsing, field, NodeKind.record-pattern-field);
                if !at(parsing, "\}") { expect(parsing, ","); }
            }
            wrap(parsing, begun, NodeKind.record-pattern);
            return;
        }
        if at(parsing, "(") {
            advance(parsing);
            if at(parsing, ")") {
                advance(parsing);
                wrap(parsing, begun, NodeKind.tuple-pattern);
                return;
            }
            pattern(parsing);
            if at(parsing, ")") {
                advance(parsing);
                wrap(parsing, begun, NodeKind.paren-pattern);
                return;
            }
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, ")") {
                    advance(parsing);
                    break;
                }
                expect(parsing, ",");
                if at(parsing, ")") {
                    advance(parsing);
                    break;
                }
                pattern(parsing);
            }
            wrap(parsing, begun, NodeKind.tuple-pattern);
            return;
        }
        name(parsing);
        if at(parsing, "(") {
            advance(parsing);
            pattern(parsing);
            expect(parsing, ")");
            wrap(parsing, begun, NodeKind.case-pattern);
            return;
        }
        wrap(parsing, begun, NodeKind.name-pattern);
    }

    // ================================================================ what was just built

    // the node the parser finished last (an expression just parsed: what follows it may depend on
    // what it is)
    last-node: func(parsing: Grammar) -> option<GreenNode> {
        let holder = parsing.tree.open[parsing.tree.open.len() - 1];
        if holder.children.len() == 0 { return none; }
        match holder.children[holder.children.len() - 1] {
            node(inner) => some(inner),
            token(_) => none,
        }
    }

    // what an expression is, as what follows it asks (its parens looked through: (f)(x) is a
    // call of f); a string that interpolates is an interpolation's
    shape: func(green: GreenNode) -> NodeKind {
        if green.kind == NodeKind.paren-expr {
            for child in green.children {
                match child {
                    node(inner) => { return shape(inner); }
                    token(_) => {}
                }
            }
        }
        if green.kind == NodeKind.string-lit {
            for child in green.children {
                match child {
                    node(inner) => { if inner.kind == NodeKind.interpolation { return NodeKind.interpolation; } }
                    token(_) => {}
                }
            }
        }
        green.kind
    }

    // what the expression just parsed is (error: none was)
    last-shape: func(parsing: Grammar) -> NodeKind {
        match last-node(parsing) {
            some(last) => shape(last),
            none => NodeKind.error,
        }
    }

    // whether an expression ends at its brace (an if, a match or a block: it takes no ; as a
    // statement)
    ends-at-brace: func(kind: NodeKind) -> bool {
        kind == NodeKind.if-expr || kind == NodeKind.match-expr || kind == NodeKind.block
    }

    // ================================================================ blocks and statements

    // whether a { opens a closure literal: its params (names, each with a type or not, between
    // commas) and then -> (a record literal's name: value never reaches one)
    closure-ahead: func(parsing: Grammar) -> bool {
        if at-off(parsing, "->", 1) { return true; }
        let ahead = 1;
        for step in 0..parsing.toks.len() {
            if !is-kind(parsing, ahead, TokenKind.id) { return false; }
            ahead += 1;
            if at-off(parsing, ":", ahead) {
                ahead += 1;
                let depth = 0;
                let braces = 0;
                for skip in 0..parsing.toks.len() {
                    if depth == 0 && braces == 0 && (at-off(parsing, ",", ahead) || at-off(parsing, "->", ahead)) { break; }
                    if at-off(parsing, "\{", ahead) { braces += 1; }
                    if at-off(parsing, "\}", ahead) {
                        if braces == 0 { return false; }
                        braces -= 1;
                    }
                    if at-off(parsing, "(", ahead) || at-off(parsing, "<", ahead) || at-off(parsing, "[", ahead) { depth += 1; }
                    if at-off(parsing, ")", ahead) || at-off(parsing, ">", ahead) || at-off(parsing, "]", ahead) { depth -= 1; }
                    if at-off(parsing, ";", ahead) || at-off(parsing, "=", ahead) || depth < 0 || is-kind(parsing, ahead, TokenKind.eof) {
                        return false;
                    }
                    ahead += 1;
                }
            }
            if at-off(parsing, "->", ahead) { return true; }
            if !at-off(parsing, ",", ahead) { return false; }
            ahead += 1;
        }
        false
    }

    // { params -> body }: a closure literal (its body a block's, without its {)
    closure: func(parsing: Grammar) {
        expect(parsing, "\{");
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, "->") { break; }
            let param = mark(parsing);
            name(parsing);
            if at(parsing, ":") {
                advance(parsing);
                parse-type(parsing);
            }
            wrap(parsing, param, NodeKind.closure-param);
            if !at(parsing, "->") { expect(parsing, ","); }
        }
        expect(parsing, "->");
        block-rest(parsing);
    }

    block: func(parsing: Grammar) {
        let begun = mark(parsing);
        expect(parsing, "\{");
        block-rest(parsing);
        wrap(parsing, begun, NodeKind.block);
    }

    // a block's statements, after its {, and its }
    block-rest: func(parsing: Grammar) {
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, "\}") {
                advance(parsing);
                return;
            }
            let first = parsing.pos;
            statement(parsing);
            if parsing.recovering { pass-over(parsing, first); }
        }
    }

    // a statement's ; taken. One missing before a line after it (x. being written above another
    // line) is told, and the statement taken as ended there: nothing is passed over
    end-statement: func(parsing: Grammar) {
        if !at(parsing, ";") && next-line-statement(parsing) {
            let last = tok(parsing, -1).span;
            tell(parsing, { source: last.source, line: last.end-line, col: last.end-col, end-line: last.end-line, end-col: last.end-col + 1, }, "expected ';', found {found(parsing)}");
            return;
        }
        expect(parsing, ";");
    }

    // whether the next token is on a line after the last token's (and not a } or the file's end)
    next-line-statement: func(parsing: Grammar) -> bool {
        parsing.pos > 0 && !at(parsing, "\}") && !is-kind(parsing, 0, TokenKind.eof) && tok(parsing, 0).span.line > tok(parsing, -1).span.end-line
    }

    statement: func(parsing: Grammar) {
        let begun = mark(parsing);
        if at(parsing, "let") {
            advance(parsing);
            // a record's, a tuple's or _: a pattern, its names binding
            let destructures = at(parsing, "\{") || at(parsing, "(") || at(parsing, "_");
            if destructures { pattern(parsing); } else { name(parsing); }
            if at(parsing, ":") {
                advance(parsing);
                parse-type(parsing);
            }
            expect(parsing, "=");
            expr(parsing);
            end-statement(parsing);
            wrap(parsing, begun, NodeKind.let-stmt);
            return;
        }
        if at(parsing, "return") {
            advance(parsing);
            if !at(parsing, ";") { expr(parsing); }
            end-statement(parsing);
            wrap(parsing, begun, NodeKind.return-stmt);
            return;
        }
        // wait for x in s { … }: each item of a stream, waited for in turn
        if at(parsing, "wait") && at-off(parsing, "for", 1) {
            advance(parsing);
            advance(parsing);
            name(parsing);
            expect(parsing, "in");
            expr(parsing);
            block(parsing);
            wrap(parsing, begun, NodeKind.wait-for-stmt);
            return;
        }
        // loop { … } (loop is a name otherwise)
        if at(parsing, "loop") && at-off(parsing, "\{", 1) {
            advance(parsing);
            block(parsing);
            wrap(parsing, begun, NodeKind.loop-stmt);
            return;
        }
        if at(parsing, "for") {
            advance(parsing);
            name(parsing);
            expect(parsing, "in");
            expr(parsing);
            if at(parsing, "..") || at(parsing, "..=") {
                advance(parsing);
                expr(parsing);
            }
            block(parsing);
            wrap(parsing, begun, NodeKind.for-stmt);
            return;
        }
        if at(parsing, "break") || at(parsing, "continue") {
            let kind = if at(parsing, "break") { NodeKind.break-stmt } else { NodeKind.continue-stmt };
            advance(parsing);
            end-statement(parsing);
            wrap(parsing, begun, kind);
            return;
        }
        // an if, a match or a block that starts a statement is the statement: what
        // follows its } is the next one, not an operator's other side
        let start = here(parsing);
        if at(parsing, "if") || at(parsing, "match") || at(parsing, "\{") { postfix(parsing); } else { expr(parsing); }
        let target = last-node(parsing);
        let kind = last-shape(parsing);
        let target-span = span-from(parsing, start);
        for op in ["=", "+=", "-=", "*=", "/=", "%=",] {
            if at(parsing, op) {
                advance(parsing);
                expr(parsing);
                end-statement(parsing);
                assignable(parsing, target, kind, op, target-span);
                wrap(parsing, begun, NodeKind.assign-stmt);
                return;
            }
        }
        if at(parsing, ";") {
            advance(parsing);
            wrap(parsing, begun, NodeKind.expr-stmt);
            return;
        }
        // an if, a match or a block needs no `;`
        if ends-at-brace(kind) {
            wrap(parsing, begun, NodeKind.expr-stmt);
            return;
        }
        if !at(parsing, "\}") {
            if next-line-statement(parsing) {
                end-statement(parsing);
            } else {
                fail(parsing, "expected ';' after an expression, found {found(parsing)}");
            }
        }
        wrap(parsing, begun, NodeKind.expr-stmt);
    }

    // what is assigned: a variable, a field, or a list's item (xs[i] = v, xs.at(i) = v; with = only)
    assignable: func(parsing: Grammar, target: option<GreenNode>, kind: NodeKind, op: string, at: Span) {
        if kind == NodeKind.name-ref || kind == NodeKind.field-expr { return; }
        let item = kind == NodeKind.index-expr || match target {
            some(call) => kind == NodeKind.method-call-expr && method-name(call) == "at" && call-arity(call) == 1,
            none => false,
        };
        if !item {
            fail-at(parsing, at, "only a variable, a field or a list's item can be assigned");
            return;
        }
        if op != "=" {
            fail-at(parsing, at, "xs[i] {op} v would read xs and i twice: write xs[i] = xs[i] {from-byte(op.byte-at(0))} v");
        }
    }

    // a method call's name (the name after its .)
    @(private) method-name: func(green: GreenNode) -> string {
        let dot = false;
        for child in green.children {
            match child {
                token(leaf) => {
                    if leaf.kind == TokenKind.op && leaf.text == "." { dot = true; }
                    else if dot && leaf.kind == TokenKind.id { return leaf.text; }
                }
                node(_) => {}
            }
        }
        ""
    }

    // how many arguments a call's argument list holds
    @(private) call-arity: func(green: GreenNode) -> s64 {
        for child in green.children {
            match child {
                node(inner) => {
                    if inner.kind == NodeKind.arg-list {
                        let count = 0;
                        for arg in inner.children {
                            match arg {
                                node(_) => { count += 1; }
                                token(_) => {}
                            }
                        }
                        return count;
                    }
                }
                token(_) => {}
            }
        }
        0
    }

    // ================================================================ expressions

    expr: func(parsing: Grammar) { binary(parsing, 0); }

    // the operator of ops next, or "": << and >> are two adjacent < or > tokens (and then no
    // comparison)
    op-at: func(parsing: Grammar, ops: list<string>) -> string {
        if parsing.kinds[parsing.pos] != TokenKind.op { return ""; }
        let unit = parsing.texts[parsing.pos];
        let doubled = (unit == "<" || unit == ">") && at-off(parsing, unit, 1) && adjacent(parsing);
        for op in ops {
            if doubled && op == unit + unit { return op; }
            if !doubled && op == unit { return op; }
        }
        ""
    }

    // whether the next two tokens touch
    adjacent: func(parsing: Grammar) -> bool {
        let earlier = tok(parsing, 0).span;
        let later = tok(parsing, 1).span;
        earlier.end-line == later.line && earlier.end-col == later.col
    }

    binary: func(parsing: Grammar, level: s64) {
        if level == 10 {
            cast(parsing);
            return;
        }
        let ops = parsing.levels[level];
        let begun = mark(parsing);
        binary(parsing, level + 1);
        // x is T, as a comparison is
        if level == 3 && at(parsing, "is") {
            advance(parsing);
            parse-type(parsing);
            wrap(parsing, begun, NodeKind.is-expr);
            return;
        }
        for step in parsing.pos..parsing.toks.len() {
            let op = op-at(parsing, ops);
            if op == "" { return; }
            advance(parsing);
            if op == "<<" || op == ">>" { advance(parsing); }
            binary(parsing, level + 1);
            wrap(parsing, begun, NodeKind.binary-expr);
        }
    }

    // x as T, x as? T: tighter than * and +, looser than - and !
    cast: func(parsing: Grammar) {
        let begun = mark(parsing);
        unary(parsing);
        for step in parsing.pos..parsing.toks.len() {
            if !at(parsing, "as") { return; }
            advance(parsing);
            if at(parsing, "?") {
                advance(parsing);
                type-member(parsing);
                wrap(parsing, begun, NodeKind.try-cast-expr);
            } else {
                type-member(parsing);
                wrap(parsing, begun, NodeKind.cast-expr);
            }
        }
    }

    // yield v, start f(x), wait …, -x, !x, else a postfix expression: what it is
    unary: func(parsing: Grammar) -> NodeKind {
        let begun = mark(parsing);
        if at(parsing, "yield") {
            advance(parsing);
            expr(parsing);
            wrap(parsing, begun, NodeKind.yield-expr);
            return NodeKind.yield-expr;
        }
        // start f(x) (a name after it: start alone is a variable's)
        if at(parsing, "start") && is-kind(parsing, 1, TokenKind.id) {
            advance(parsing);
            postfix(parsing);
            wrap(parsing, begun, NodeKind.start-expr);
            return NodeKind.start-expr;
        }
        // wait f(x), wait a | b, wait { a: x, b: y } (wait alone is a variable's)
        let waits = is-kind(parsing, 1, TokenKind.id) || at-off(parsing, "\{", 1) && is-kind(parsing, 2, TokenKind.id) && at-off(parsing, ":", 3);
        if at(parsing, "wait") && waits {
            advance(parsing);
            if at(parsing, "\{") {
                advance(parsing);
                for step in parsing.pos..parsing.toks.len() {
                    if at(parsing, "\}") {
                        advance(parsing);
                        wrap(parsing, begun, NodeKind.wait-expr);
                        return NodeKind.wait-expr;
                    }
                    let field = mark(parsing);
                    name(parsing);
                    expect(parsing, ":");
                    expr(parsing);
                    wrap(parsing, field, NodeKind.wait-field);
                    if !at(parsing, "\}") { expect(parsing, ","); }
                }
            }
            postfix(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if !at(parsing, "|") { break; }
                advance(parsing);
                postfix(parsing);
            }
            wrap(parsing, begun, NodeKind.wait-expr);
            return NodeKind.wait-expr;
        }
        if at(parsing, "-") || at(parsing, "!") {
            advance(parsing);
            unary(parsing);
            wrap(parsing, begun, NodeKind.unary-expr);
            return NodeKind.unary-expr;
        }
        postfix(parsing);
        last-shape(parsing)
    }

    call-args: func(parsing: Grammar) {
        let begun = mark(parsing);
        expect(parsing, "(");
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, ")") {
                advance(parsing);
                break;
            }
            expr(parsing);
            if !at(parsing, ")") { expect(parsing, ","); }
        }
        wrap(parsing, begun, NodeKind.arg-list);
    }

    postfix: func(parsing: Grammar) {
        // an if, a match or a block ends at its brace ({ … }.f is not read as one); in parens it
        // is an operand like any
        let parenthesized = at(parsing, "(");
        let begun = mark(parsing);
        primary(parsing);
        if ends-at-brace(last-shape(parsing)) && !parenthesized { return; }
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, ".") {
                advance(parsing);
                // (a member's name is written on its dot's line: one on a line after it is what
                // follows, not this member's name: x. being written above another line)
                let dot = tok(parsing, -1).span;
                if !is-kind(parsing, 0, TokenKind.int) && !is-kind(parsing, 0, TokenKind.id) || tok(parsing, 0).span.line > dot.end-line {
                    // (no name after the .: told, and kept as a member with none)
                    tell(parsing, { source: dot.source, line: dot.end-line, col: dot.end-col, end-line: dot.end-line, end-col: dot.end-col, }, "expected a name after .");
                    wrap(parsing, begun, NodeKind.field-expr);
                    continue;
                }
                if is-kind(parsing, 0, TokenKind.int) {
                    advance(parsing);
                    wrap(parsing, begun, NodeKind.field-expr);
                } else {
                    name(parsing);
                    if at(parsing, "(") {
                        call-args(parsing);
                        wrap(parsing, begun, NodeKind.method-call-expr);
                    } else {
                        wrap(parsing, begun, NodeKind.field-expr);
                    }
                }
            } else if at(parsing, "(") && last-shape(parsing) == NodeKind.name-ref {
                call-args(parsing);
                wrap(parsing, begun, NodeKind.call-expr);
            } else if at(parsing, "(") {
                // a call of any other expression's value: xs[i](), make()(), (x.f)(a)
                call-args(parsing);
                wrap(parsing, begun, NodeKind.apply-expr);
            } else if at(parsing, "[") {
                // xs[i] is xs.at(i)
                advance(parsing);
                expr(parsing);
                expect(parsing, "]");
                wrap(parsing, begun, NodeKind.index-expr);
            } else {
                return;
            }
        }
    }

    primary: func(parsing: Grammar) {
        let begun = mark(parsing);
        if is-kind(parsing, 0, TokenKind.int) || is-kind(parsing, 0, TokenKind.float) {
            advance(parsing);
            wrap(parsing, begun, NodeKind.literal);
            return;
        }
        if is-kind(parsing, 0, TokenKind.char) {
            check-char(parsing, tok(parsing, 0));
            advance(parsing);
            wrap(parsing, begun, NodeKind.literal);
            return;
        }
        if is-string(parsing, 0) {
            string-lit(parsing);
            return;
        }
        if at(parsing, "true") || at(parsing, "false") {
            advance(parsing);
            wrap(parsing, begun, NodeKind.literal);
            return;
        }
        // /pattern/flags: a regex literal
        if is-kind(parsing, 0, TokenKind.regex) {
            advance(parsing);
            wrap(parsing, begun, NodeKind.regex-lit);
            return;
        }
        // #name, #name(args): a directive
        if is-kind(parsing, 0, TokenKind.id) && tok(parsing, 0).text.starts-with("#") {
            advance(parsing);
            if at(parsing, "(") { call-args(parsing); }
            wrap(parsing, begun, NodeKind.directive);
            return;
        }
        // (e), (), or a tuple: (a, b), and (a,) of one
        if at(parsing, "(") {
            advance(parsing);
            if at(parsing, ")") {
                advance(parsing);
                wrap(parsing, begun, NodeKind.unit-expr);
                return;
            }
            expr(parsing);
            if at(parsing, ")") {
                advance(parsing);
                wrap(parsing, begun, NodeKind.paren-expr);
                return;
            }
            expect(parsing, ",");
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, ")") {
                    advance(parsing);
                    break;
                }
                expr(parsing);
                if !at(parsing, ")") { expect(parsing, ","); }
            }
            wrap(parsing, begun, NodeKind.tuple-expr);
            return;
        }
        if at(parsing, "[") {
            advance(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "]") {
                    advance(parsing);
                    break;
                }
                expr(parsing);
                if !at(parsing, "]") { expect(parsing, ","); }
            }
            wrap(parsing, begun, NodeKind.list-expr);
            return;
        }
        if at(parsing, "if") {
            advance(parsing);
            expr(parsing);
            block(parsing);
            if at(parsing, "else") {
                advance(parsing);
                if at(parsing, "if") { primary(parsing); } else { block(parsing); }
            }
            wrap(parsing, begun, NodeKind.if-expr);
            return;
        }
        // a closure literal: { params -> body }
        if at(parsing, "\{") && closure-ahead(parsing) {
            closure(parsing);
            wrap(parsing, begun, NodeKind.closure);
            return;
        }
        // a record literal: { name: value, ... } (any other { is a block)
        if at(parsing, "\{") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, ":", 2) {
            advance(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    break;
                }
                let field = mark(parsing);
                name(parsing);
                expect(parsing, ":");
                expr(parsing);
                wrap(parsing, field, NodeKind.record-field);
                if !at(parsing, "\}") { expect(parsing, ","); }
            }
            wrap(parsing, begun, NodeKind.record-expr);
            return;
        }
        if at(parsing, "match") {
            advance(parsing);
            expr(parsing);
            expect(parsing, "\{");
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    break;
                }
                let arm = mark(parsing);
                pattern(parsing);
                if at(parsing, "if") {
                    advance(parsing);
                    expr(parsing);
                }
                expect(parsing, "=>");
                // a block; a { that opens a record literal or a closure is an expression's
                let literal = is-kind(parsing, 1, TokenKind.id) && at-off(parsing, ":", 2) || closure-ahead(parsing);
                if at(parsing, "\{") && !literal { block(parsing); } else { expr(parsing); }
                if at(parsing, ",") { advance(parsing); }
                wrap(parsing, arm, NodeKind.match-arm);
            }
            wrap(parsing, begun, NodeKind.match-expr);
            return;
        }
        if at(parsing, "\{") {
            block(parsing);
            return;
        }
        if is-kind(parsing, 0, TokenKind.id) {
            advance(parsing);
            wrap(parsing, begun, NodeKind.name-ref);
            return;
        }
        fail(parsing, "unexpected {found(parsing)}");
    }

    // ---- strings, read in pieces

    // "text {expr} text": its quotes, its text (its escapes checked), each interpolation
    string-lit: func(parsing: Grammar) {
        let begun = mark(parsing);
        bump(parsing);
        for step in parsing.pos..parsing.toks.len() {
            let token = parsing.toks[parsing.pos];
            if token.kind == TokenKind.string-text {
                check-escapes(parsing, token);
                bump(parsing);
            } else if token.kind == TokenKind.interp-start {
                interpolation(parsing);
            } else {
                if token.kind == TokenKind.string-end { bump(parsing); }
                break;
            }
        }
        wrap(parsing, begun, NodeKind.string-lit);
    }

    // {expr} or {expr:spec}: the expression parsed as its own (an error in it its own, the
    // statement going on past it; quiet where a character in it is no token's, which is told)
    interpolation: func(parsing: Grammar) {
        let begun = mark(parsing);
        let opening = parsing.toks[parsing.pos];
        bump(parsing);
        // where its expression ends: its format's :, or its }
        let end = parsing.pos;
        loop {
            if end >= parsing.toks.len() - 1 { break; }
            let token = parsing.toks[end];
            if token.kind == TokenKind.interp-end || token.kind == TokenKind.string-end && parsing.next-unit[end] == end + 1 && false { break; }
            if token.kind == TokenKind.op && token.text == ":" && end + 1 < parsing.toks.len() && parsing.toks[end + 1].kind == TokenKind.format-spec { break; }
            if token.kind == TokenKind.interp-end { break; }
            end = parsing.next-unit[end];
        }
        let code-end = if end < parsing.toks.len() { parsing.toks[end].start } else { opening.end };
        let outer-recovering = parsing.recovering;
        let outer-quiet = parsing.quiet;
        parsing.recovering = false;
        let unknown = false;
        for stray in parsing.unknowns {
            if stray.start >= opening.end && stray.start < code-end {
                diagnostics.report(parsing.context, diagnostics.error(stray.span, "unexpected character '{stray.text}'", ""));
                unknown = true;
            }
        }
        if unknown { parsing.quiet = true; }
        // (an empty one: what the expression would be is nothing)
        expr(parsing);
        if parsing.pos < end { fail(parsing, "unexpected {found(parsing)} after an interpolation's expression"); }
        // what its error left of it, passed over
        if parsing.pos < end {
            let rest = mark(parsing);
            for index in parsing.pos..end { tree.token(parsing.tree, parsing.toks[index]); }
            parsing.pos = end;
            wrap(parsing, rest, NodeKind.error);
        }
        parsing.recovering = outer-recovering;
        parsing.quiet = outer-quiet;
        // its format (std's: [[fill]align][0][width][.precision][? x X b o])
        if parsing.pos < parsing.toks.len() - 1 && parsing.toks[parsing.pos].kind == TokenKind.op && parsing.toks[parsing.pos].text == ":" {
            bump(parsing);
            let spec = parsing.toks[parsing.pos];
            if spec.kind == TokenKind.format-spec {
                match format-spec(spec.text) {
                    some(_) => {}
                    none => fail-at(parsing, { source: spec.span.source, line: spec.span.line, col: spec.span.col, end-line: spec.span.line, end-col: spec.span.col + 2, }, "unknown format spec '{spec.text}': [[fill]align][0][width][.precision][? x X b o]"),
                }
                bump(parsing);
            }
        }
        if parsing.toks[parsing.pos].kind == TokenKind.interp-end { bump(parsing); }
        wrap(parsing, begun, NodeKind.interpolation);
    }

    // a string's text's escapes: WAVE's (\\ \" \' \n \r \t \u\{hex\}) and yel's \{ \} \0
    check-escapes: func(parsing: Grammar, token: Token) {
        let raw = token.text;
        let index = 0;
        loop {
            if index >= raw.len() { break; }
            if raw.byte-at(index) == 92 {
                index += escape-checked(parsing, token, index);
            } else {
                index += 1;
            }
        }
    }

    // the escape at raw[at] (a backslash) checked, as the parser read it: how many bytes it takes
    @(private) escape-checked: func(parsing: Grammar, token: Token, at: s64) -> s64 {
        let raw = token.text;
        let escaped = raw.byte-at(at + 1);
        if escaped == 110 || escaped == 116 || escaped == 114 || escaped == 48 || escaped == 92 || escaped == 34 || escaped == 39 || escaped == 123 || escaped == 125 { return 2; }
        if escaped == 117 && raw.byte-at(at + 2) == 123 {
            let code = 0;
            for index in at + 3..raw.len() {
                let digit = raw.byte-at(index);
                if digit == 125 {
                    if index == at + 3 || code > 1114111 || (code >= 55296 && code <= 57343) {
                        raw-fail(parsing, token, at, "\\u\{...\} needs a Unicode scalar value");
                    }
                    return index + 1 - at;
                }
                if !radix-digit(digit, 16) || index - at > 9 {
                    raw-fail(parsing, token, at, "\\u\{...\} takes 1 to 6 hex digits");
                }
                code = code * 16 + hex-value(digit);
            }
        }
        raw-fail(parsing, token, at, "unknown escape \\{from-byte(escaped)}");
        2
    }

    // an error at byte at of a token's text (where it is in the file)
    raw-fail: func(parsing: Grammar, token: Token, at: s64, message: string) {
        let src = parsing.context.sources[parsing.source].text;
        let where = lexer.place-in(src, token.start, token.span.line, token.span.col, token.start + at);
        fail-at(parsing, { source: parsing.source, line: where.line, col: where.col, end-line: where.line, end-col: where.col + 2, }, message);
    }

    // a char literal: an escape, or one UTF-8 scalar
    check-char: func(parsing: Grammar, token: Token) {
        let raw = token.text;
        // (its text starts past its opening quote)
        let inner: Token = {
            kind: token.kind,
            text: raw,
            span: { source: token.span.source, line: token.span.line, col: token.span.col + 1, end-line: token.span.end-line, end-col: token.span.end-col, },
            indent: -1,
            template: false,
            start: token.start + 1,
            end: token.end,
            escaped: false,
        };
        let length = raw.len();
        let width = 0;
        if length > 0 && raw.byte-at(0) == 92 {
            let taken = escape-checked(parsing, inner, 0);
            if taken != length { raw-fail(parsing, inner, 0, "a char is one character"); }
            return;
        }
        let byte = if length > 0 { raw.byte-at(0) } else { 0 };
        width = if byte < 128 { 1 } else if byte >= 240 { 4 } else if byte >= 224 { 3 } else { 2 };
        if length == 0 || length != width { raw-fail(parsing, inner, 0, "a char is one character"); }
    }

    // ================================================================ declarations

    // a declaration, or (past an error in it) what is left of it passed over (a stray token: an
    // error of its own)
    recovering-declaration: func(parsing: Grammar) {
        let begun = mark(parsing);
        let first = parsing.pos;
        let kind = declaration(parsing);
        if parsing.recovering { pass-over(parsing, first); }
        if parsing.pos == first {
            advance(parsing);
            kind = NodeKind.error;
        }
        wrap(parsing, begun, kind);
    }

    // a declaration (its attributes first): what it is
    declaration: func(parsing: Grammar) -> NodeKind {
        // @(private), @(private="file"), @(observable), @(test), @(context), @(container),
        // @(container(Part, …)), @(base): one or several
        if at(parsing, "@") && at-off(parsing, "(", 1) {
            let attribute = mark(parsing);
            advance(parsing);
            advance(parsing);
            let observable = false;
            let in-context = false;
            let container = false;
            loop {
                if at(parsing, "private") {
                    advance(parsing);
                    if at(parsing, "=") {
                        advance(parsing);
                        if !is-string(parsing, 0) { fail(parsing, "expected @(private=\"file\")"); }
                        let taken = next(parsing);
                        if taken != "file" { fail(parsing, "@(private=\"{taken}\"): private is the package's (@(private)) or the file's (@(private=\"file\"))"); }
                    }
                } else if at(parsing, "observable") {
                    advance(parsing);
                    observable = true;
                } else if at(parsing, "test") {
                    advance(parsing);
                } else if at(parsing, "context") {
                    advance(parsing);
                    in-context = true;
                } else if at(parsing, "container") {
                    advance(parsing);
                    container = true;
                    // (container(Tab, …): the parts it holds, no others; a comma after the last)
                    if at(parsing, "(") {
                        advance(parsing);
                        loop {
                            let _ = name(parsing);
                            if !at(parsing, ",") { break; }
                            advance(parsing);
                            if at(parsing, ")") { break; }
                        }
                        expect(parsing, ")");
                    }
                } else if at(parsing, "base") {
                    advance(parsing);
                    container = true;
                } else {
                    fail(parsing, "an attribute @(...) is @(private), @(private=\"file\"), @(observable), @(test), @(context), @(container) or @(base)");
                    wrap(parsing, attribute, NodeKind.attribute);
                    return NodeKind.error;
                }
                if !at(parsing, ",") { break; }
                advance(parsing);
            }
            expect(parsing, ")");
            wrap(parsing, attribute, NodeKind.attribute);
            if observable && !at(parsing, "resource") && !at(parsing, "@") && !at(parsing, "record") {
                fail(parsing, "@(observable) goes on a resource: it tells who reads and writes its fields");
                return NodeKind.error;
            }
            let outer-observable = parsing.observable;
            parsing.observable = outer-observable || observable;
            if in-context && !at(parsing, "let") && !at(parsing, "@") {
                fail(parsing, "@(context) goes on a global (let name: T;): each task's own value of it");
                return NodeKind.error;
            }
            let outer-context = parsing.in-context;
            parsing.in-context = outer-context || in-context;
            if container && !at(parsing, "widget") && !at(parsing, "@") {
                fail(parsing, "@(container) and @(base) go on a widget (widget Name \{ … \})");
                return NodeKind.error;
            }
            let outer-container = parsing.container;
            parsing.container = outer-container || container;
            let kind = declaration(parsing);
            parsing.observable = outer-observable;
            parsing.in-context = outer-context;
            parsing.container = outer-container;
            return kind;
        }
        // name: … (a func, in member syntax): a declaration of that name, whatever word it is
        let named = is-kind(parsing, 0, TokenKind.id) && at-off(parsing, ":", 1);
        // package ns:name@version;
        if !named && at(parsing, "package") && is-kind(parsing, 1, TokenKind.id) && !at-off(parsing, ":", 1) {
            advance(parsing);
            let _ = package-id(parsing);
            if parsing.module != "" { fail(parsing, "a package is named at the top of a file, not in a module"); }
            return NodeKind.package-decl;
        }
        // from "<package>" include a, b as c;
        if !named && at(parsing, "from") && is-string(parsing, 1) {
            if parsing.module != "" { fail(parsing, "an include goes at the top of a file, not in a module"); }
            advance(parsing);
            advance(parsing);
            if next(parsing) != "include" { fail-missing(parsing, "expected include"); }
            include-names(parsing);
            return NodeKind.include-decl;
        }
        if !named && at(parsing, "extern") && at-off(parsing, "module", 1) {
            fail(parsing, "extern module, an interface the host implements, comes with WIT imports");
        }
        // module name { ... }: one layer
        if !named && at(parsing, "module") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, "\{", 2) {
            if parsing.module != "" { fail(parsing, "module {parsing.module} holds a module: modules are one layer"); }
            advance(parsing);
            let module-name = name(parsing);
            expect(parsing, "\{");
            let outer = parsing.module;
            parsing.module = module-name;
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    parsing.module = outer;
                    return NodeKind.module-decl;
                }
                if is-kind(parsing, 0, TokenKind.eof) {
                    fail(parsing, "module {module-name} is not closed");
                    parsing.module = outer;
                    return NodeKind.module-decl;
                }
                recovering-declaration(parsing);
            }
            parsing.module = outer;
            return NodeKind.module-decl;
        }
        // view Name { fields; its element }
        if !named && at(parsing, "view") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, "\{", 2) {
            view-decl(parsing, false);
            return NodeKind.view-decl;
        }
        // widget Name { attributes; events }: an element the host draws (@(container): one that
        // takes items); widget Name: Base, … { … }: with its bases' too
        if !named && at(parsing, "widget") && is-kind(parsing, 1, TokenKind.id) && (at-off(parsing, "\{", 2) || at-off(parsing, ":", 2)) {
            view-decl(parsing, true);
            return NodeKind.widget-decl;
        }
        // record Name { fields }, resource Name { fields }
        if !named && (at(parsing, "record") || (at(parsing, "resource") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, "\{", 2))) {
            let value = at(parsing, "record");
            let observable = parsing.observable;
            parsing.observable = false;
            if observable && value {
                fail(parsing, "@(observable) goes on a resource: a record is a value, copied where it goes, so no one sees it change");
            }
            advance(parsing);
            let rname = name(parsing);
            expect(parsing, "\{");
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    return NodeKind.record-decl;
                }
                let field = mark(parsing);
                // @(ignored): a field of an observable resource no one is told of
                if at(parsing, "@") && at-off(parsing, "(", 1) {
                    advance(parsing);
                    advance(parsing);
                    if !at(parsing, "ignored") { fail(parsing, "a field's attribute is @(ignored)"); }
                    advance(parsing);
                    expect(parsing, ")");
                    if !observable { fail(parsing, "@(ignored) is for a field of an @(observable) resource: {rname} is not one"); }
                }
                name(parsing);
                expect(parsing, ":");
                parse-type(parsing);
                wrap(parsing, field, NodeKind.field-decl);
                if !at(parsing, "\}") { expect(parsing, ","); }
            }
            return NodeKind.record-decl;
        }
        // type name = T; type name = distinct T;
        if !named && at(parsing, "type") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, "=", 2) {
            advance(parsing);
            name(parsing);
            expect(parsing, "=");
            let distinct = at(parsing, "distinct") && !at-off(parsing, ";", 1) && !at-off(parsing, "|", 1);
            if distinct { advance(parsing); }
            parse-type(parsing);
            expect(parsing, ";");
            return NodeKind.type-decl;
        }
        // let name: T; let name: T = value; (a global)
        if !named && at(parsing, "let") && is-kind(parsing, 1, TokenKind.id) {
            advance(parsing);
            name(parsing);
            expect(parsing, ":");
            parse-type(parsing);
            if at(parsing, "=") {
                advance(parsing);
                expr(parsing);
            }
            expect(parsing, ";");
            return NodeKind.global-decl;
        }
        // const name = value; const name: T = value;
        if !named && at(parsing, "const") && is-kind(parsing, 1, TokenKind.id) {
            advance(parsing);
            name(parsing);
            if at(parsing, ":") {
                advance(parsing);
                parse-type(parsing);
            }
            expect(parsing, "=");
            expr(parsing);
            expect(parsing, ";");
            return NodeKind.const-decl;
        }
        if !named && at(parsing, "flags") {
            advance(parsing);
            name(parsing);
            expect(parsing, "\{");
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    return NodeKind.flags-decl;
                }
                let flag = mark(parsing);
                name(parsing);
                wrap(parsing, flag, NodeKind.flag);
                if !at(parsing, "\}") { expect(parsing, ","); }
            }
            return NodeKind.flags-decl;
        }
        if !named && (at(parsing, "variant") || at(parsing, "enum")) {
            advance(parsing);
            name(parsing);
            expect(parsing, "\{");
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, "\}") {
                    advance(parsing);
                    return NodeKind.variant-decl;
                }
                let case = mark(parsing);
                name(parsing);
                if at(parsing, "(") {
                    advance(parsing);
                    parse-type(parsing);
                    expect(parsing, ")");
                }
                wrap(parsing, case, NodeKind.case-decl);
                if !at(parsing, "\}") { expect(parsing, ","); }
            }
            return NodeKind.variant-decl;
        }
        // @c(name = "c_func", keeps = "p", gives = "q"): an extern's C name, and what it does
        // with its parameters that their types cannot say
        let c-named = false;
        if at(parsing, "@") {
            let attribute = mark(parsing);
            advance(parsing);
            if name(parsing) != "c" { fail(parsing, "the only attribute is @c(name = \"...\")"); }
            expect(parsing, "(");
            loop {
                let key = name(parsing);
                expect(parsing, "=");
                if !is-string(parsing, 0) { fail(parsing, "expected a string: @c({key} = \"...\")"); }
                next(parsing);
                if key == "name" { c-named = true; }
                else if key != "keeps" && key != "gives" { fail(parsing, "@c takes name, keeps and gives"); }
                if !at(parsing, ",") { break; }
                advance(parsing);
            }
            expect(parsing, ")");
            if !c-named { fail(parsing, "expected @c(name = \"...\")"); }
            wrap(parsing, attribute, NodeKind.c-attribute);
        }
        let fname = name(parsing);
        expect(parsing, ":");
        let is-extern = at(parsing, "extern");
        if is-extern { advance(parsing); }
        if at(parsing, "async") { advance(parsing); }
        expect(parsing, "func");
        // type parameters: func<T, U>(...)
        if at(parsing, "<") {
            let params = mark(parsing);
            advance(parsing);
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, ">") {
                    advance(parsing);
                    break;
                }
                name(parsing);
                if !at(parsing, ">") { expect(parsing, ","); }
            }
            wrap(parsing, params, NodeKind.type-params);
        }
        declare-params(parsing, fname, is-extern, c-named);
        NodeKind.func-decl
    }

    // a package's id as written up to its ; (ns:name@version)
    package-id: func(parsing: Grammar) -> string {
        let parts: list<string> = [];
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, ";") {
                advance(parsing);
                return parts.join("");
            }
            if is-kind(parsing, 0, TokenKind.eof) { fail(parsing, "expected ';' after the package's name"); }
            parts.push(next(parsing));
        }
        parts.join("")
    }

    // an include's names, each with its alias (a as b), up to its ;
    include-names: func(parsing: Grammar) {
        for step in parsing.pos..parsing.toks.len() {
            let included = mark(parsing);
            name(parsing);
            if at(parsing, "as") {
                advance(parsing);
                name(parsing);
            }
            wrap(parsing, included, NodeKind.include-name);
            if at(parsing, ";") {
                advance(parsing);
                return;
            }
            expect(parsing, ",");
        }
    }

    // a func's parameters (each name: T, or name: T = default), result and body (or, for an
    // extern, its ;)
    declare-params: func(parsing: Grammar, fname: string, is-extern: bool, c-named: bool) {
        let list = mark(parsing);
        expect(parsing, "(");
        let defaulted = false;
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, ")") {
                advance(parsing);
                wrap(parsing, list, NodeKind.param-list);
                if at(parsing, "->") {
                    advance(parsing);
                    parse-type(parsing);
                }
                if is-extern {
                    if !c-named { fail(parsing, "extern func {fname} needs @c(name = \"...\")"); }
                    expect(parsing, ";");
                } else {
                    block(parsing);
                }
                return;
            }
            let param = mark(parsing);
            let named-at = here(parsing);
            let pname = name(parsing);
            expect(parsing, ":");
            parse-type(parsing);
            if at(parsing, "=") {
                advance(parsing);
                expr(parsing);
                defaulted = true;
            } else if defaulted {
                fail-at(parsing, named-at, "parameter {pname} needs a default: every one after a parameter with a default has one");
            }
            wrap(parsing, param, NodeKind.param);
            if !at(parsing, ")") { expect(parsing, ","); }
        }
        wrap(parsing, list, NodeKind.param-list);
    }

    // ================================================================ views

    // view Name { fields; its element }: its fields (name: T = value;, @(private) or not) and one
    // element at its top
    view-decl: func(parsing: Grammar, widget: bool) {
        let span = here(parsing);
        advance(parsing);
        let vname = name(parsing);
        // (a widget's bases: Name: Base, …)
        if widget && at(parsing, ":") {
            advance(parsing);
            loop {
                let _ = name(parsing);
                if !at(parsing, ",") { break; }
                advance(parsing);
            }
        }
        if widget && parsing.module == "" { fail(parsing, "widget {vname} goes in a module: a widget set's"); }
        if !widget && parsing.module == "" { fail(parsing, "view {vname} goes in a module: the module is its WIT interface"); }
        expect(parsing, "\{");
        let top = false;
        for step in parsing.pos..parsing.toks.len() {
            if parsing.recovering { return; }
            if at(parsing, "\}") {
                advance(parsing);
                break;
            }
            if is-kind(parsing, 0, TokenKind.eof) {
                fail(parsing, "view {vname} is not closed");
                return;
            }
            let field = mark(parsing);
            // (@(private): the view's own state; @(mount): a prop mount is given; @(once): a let
            // made once, as the view is first built)
            let private = false;
            let mounted = false;
            let once = false;
            if at(parsing, "@") && at-off(parsing, "(", 1) && (at-off(parsing, "private", 2) || at-off(parsing, "mount", 2) || at-off(parsing, "once", 2)) && at-off(parsing, ")", 3) {
                private = at-off(parsing, "private", 2);
                once = at-off(parsing, "once", 2);
                mounted = !private && !once;
                for step in 0..4 { advance(parsing); }
            }
            // let name: T = value; (a value made of what it reads, made again when that changes;
            // @(once): made once)
            if !widget && at(parsing, "let") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, ":", 2) {
                advance(parsing);
                let lname = name(parsing);
                expect(parsing, ":");
                parse-type(parsing);
                expect(parsing, "=");
                expr(parsing);
                expect(parsing, ";");
                wrap(parsing, field, NodeKind.view-field);
                if private || mounted { fail-at(parsing, span, "let {lname} is the view's own, made of what it reads: no @(private), no @(mount)"); }
                continue;
            }
            if once {
                fail(parsing, "@(once) in a view is a let's: @(once) let name: T = value;");
                return;
            }
            // name: T = value; (a field: a prop, its value to start with); on.name: func(T); (a
            // callback, none given: it does nothing)
            let callback = at(parsing, "on") && at-off(parsing, ".", 1) && is-kind(parsing, 2, TokenKind.id) && at-off(parsing, ":", 3);
            if callback || (is-kind(parsing, 0, TokenKind.id) && at-off(parsing, ":", 1)) {
                if callback {
                    advance(parsing);
                    advance(parsing);
                }
                let fname = name(parsing);
                expect(parsing, ":");
                parse-type(parsing);
                if at(parsing, "=") {
                    if widget { fail(parsing, "{fname} is a widget's attribute: the host gives it its value to start with (no = value)"); }
                    advance(parsing);
                    expr(parsing);
                }
                expect(parsing, ";");
                wrap(parsing, field, NodeKind.view-field);
                if widget && (private || mounted) { fail-at(parsing, span, "a widget's attributes are all given: no @(private), no @(mount)"); }
                continue;
            }
            if private || mounted {
                fail(parsing, "@({if private { "private" } else { "mount" }}) in a view is a field's: @({if private { "private" } else { "mount" }}) name: T = value;");
                return;
            }
            if widget {
                fail(parsing, "expected an attribute (name: T;) or an event (on.name: func(T);): the host draws widget {vname}");
                return;
            }
            if element-ahead(parsing) {
                if top {
                    fail(parsing, "view {vname} has one element at its top: put its elements in one (a VStack)");
                    return;
                }
                view-element(parsing);
                top = true;
                continue;
            }
            fail(parsing, "expected a field (name: T = value;) or the view's element (Name \{ … \})");
            return;
        }
        if parsing.recovering { return; }
        if !top && !widget { fail-at(parsing, span, "view {vname} has no element: what it shows"); }
    }

    // whether an element begins here: Tag { (the host's), or module.View { (another view)
    element-ahead: func(parsing: Grammar) -> bool {
        if !is-kind(parsing, 0, TokenKind.id) { return false; }
        at-off(parsing, "\{", 1) || (at-off(parsing, ".", 1) && is-kind(parsing, 2, TokenKind.id) && at-off(parsing, "\{", 3))
    }

    // Tag { items }, or module.View { props }: an element, the host's or another view's
    view-element: func(parsing: Grammar) {
        let begun = mark(parsing);
        name(parsing);
        // (another view's: module.View)
        if at(parsing, ".") {
            advance(parsing);
            name(parsing);
        }
        expect(parsing, "\{");
        view-items(parsing, true);
        wrap(parsing, begun, NodeKind.view-element);
    }

    // a view's items up to the } that closes them: text ("…"), an element, if, for; and in an
    // element (in-element), its attributes (name: value, style.name: value; a handler, on.event:
    // { params -> … }, one of them)
    view-items: func(parsing: Grammar, in-element: bool) {
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, "\}") {
                advance(parsing);
                return;
            }
            if is-kind(parsing, 0, TokenKind.eof) {
                fail(parsing, "expected \} closing the view's items");
                return;
            }
            let start = here(parsing);
            let item = mark(parsing);
            if is-string(parsing, 0) {
                expr(parsing);
                wrap(parsing, item, NodeKind.view-text);
            } else if at(parsing, "#children") {
                // (where the view puts the items it is given)
                advance(parsing);
                wrap(parsing, item, NodeKind.view-children);
            } else if at(parsing, "if") {
                view-if(parsing);
            } else if at(parsing, "for") && is-kind(parsing, 1, TokenKind.id) && at-off(parsing, "in", 2) {
                view-for(parsing);
            } else if at(parsing, "on") && is-kind(parsing, 1, TokenKind.id) && (at-off(parsing, "\{", 2) || at-off(parsing, "(", 2)) {
                // (a handler is an on. attribute, a closure: on.click: { -> … })
                fail(parsing, "a handler is an on. attribute, a closure: on.{parsing.texts[index-at(parsing, 1)]}: \{ -> … \}");
                return;
            } else if at(parsing, "style") && at-off(parsing, ".", 1) && style-name-end(parsing) > 0 {
                // (style.name: a style, its name of one segment or more: style.pad.x, the
                // vocabulary's own)
                let prefix = buffer.buffer(32);
                prefix.push("style.");
                advance(parsing);
                advance(parsing);
                loop {
                    if !(is-kind(parsing, 0, TokenKind.id) && at-off(parsing, ".", 1)) { break; }
                    prefix.push(text(parsing));
                    prefix.push(".");
                    advance(parsing);
                    advance(parsing);
                }
                view-attribute(parsing, item, in-element, start, prefix.to-string());
            } else if at(parsing, "on") && at-off(parsing, ".", 1) && is-kind(parsing, 2, TokenKind.id) && at-off(parsing, ":", 3) {
                // (on.name: a handler, or another view's callback)
                let prefix = text(parsing) + ".";
                advance(parsing);
                advance(parsing);
                view-attribute(parsing, item, in-element, start, prefix);
            } else if is-kind(parsing, 0, TokenKind.id) && at-off(parsing, ":", 1) {
                view-attribute(parsing, item, in-element, start);
            } else if element-ahead(parsing) {
                view-element(parsing);
            } else {
                fail(parsing, "expected text (\"…\"), an element (Name \{ … \}), an attribute (name: value), on event \{ … \}, if, for or #children");
                return;
            }
            if at(parsing, ",") { advance(parsing); }
            if parsing.recovering { return; }
        }
    }

    // where style.a.b…: ends (the offset of its last name; 0: no such name, ahead)
    style-name-end: func(parsing: Grammar) -> s64 {
        let at = 2;
        loop {
            if !is-kind(parsing, at, TokenKind.id) { return 0; }
            if at-off(parsing, ":", at + 1) { return at; }
            if !at-off(parsing, ".", at + 1) { return 0; }
            at += 2;
        }
        0
    }

    view-attribute: func(parsing: Grammar, item: TreeMark, in-element: bool, start: Span, prefix: string = "") {
        let aname = name(parsing);
        expect(parsing, ":");
        expr(parsing);
        wrap(parsing, item, NodeKind.view-attribute);
        if !in-element { fail-at(parsing, start, "{prefix}{aname} is an element's attribute: put it in one"); }
    }

    // if cond { items } else { items } (else if …: an if in the else's items)
    view-if: func(parsing: Grammar) {
        let begun = mark(parsing);
        advance(parsing);
        expr(parsing);
        expect(parsing, "\{");
        view-items(parsing, false);
        if at(parsing, "else") {
            advance(parsing);
            if at(parsing, "if") {
                view-if(parsing);
            } else {
                expect(parsing, "\{");
                view-items(parsing, false);
            }
        }
        wrap(parsing, begun, NodeKind.view-if);
    }

    // for name in items key(key) { body }: a row for each item, kept by its key
    view-for: func(parsing: Grammar) {
        let begun = mark(parsing);
        advance(parsing);
        let item = name(parsing);
        expect(parsing, "in");
        expr(parsing);
        if !at(parsing, "key") { fail(parsing, "a view's for says what keeps each row: for {item} in … key({item}) \{ … \}"); }
        advance(parsing);
        expect(parsing, "(");
        expr(parsing);
        expect(parsing, ")");
        expect(parsing, "\{");
        view-items(parsing, false);
        wrap(parsing, begun, NodeKind.view-for);
    }
}
