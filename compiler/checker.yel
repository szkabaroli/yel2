// The checker: every func's body against the types, names resolved to their keys.

record Instance { params: list<Type>, result: Type, type-args: list<Type>, }
// a record type's fields and their types: a declared record's, or an anonymous one's (value)
record RecordShape { fields: list<string>, types: list<Type>, value: bool, }

resource Checker {
    // the compile's context: its sources, the errors found so far, what was asked for
    context: Context,
    // whether uses are noted (a caller asks for them: analysis.check's, not yelc's compile)
    noting: bool,
    // each open scope's extent (push-scope's)
    extents: list<Span>,
    // an error was told in the statement being checked: another there is its echo (not told)
    quiet: bool,
    // the declarations by key, as resolved here (the table the generator and an analysis read)
    symbols: Symbols,
    // the names of the WIT resources' methods (a call x.name(...) of one is looked up by x's type)
    methods: map<string, bool>,
    // the standard library's modules (by name: set.add names its module)
    std-modules: set<string>,
    // the builtins (the prelude's funcs and the standard library's) by name: their keys (a name
    // with more than one is chosen by its first argument's type, builtin-pick)
    builtins: map<string, list<string>>,
    // a case name -> its variant or enum ("" when two declare it: then write Type.case)
    case-owner: map<string, list<string>>,
    // where each resource is declared (one a reactor's visible module declares is exported)
    resource-scopes: map<Name, Scope>,
    // what not everyone may name, by key (packages.key-decls' table); whether the program is a
    // reactor (no main: its visible modules are its exports)
    visibility: map<string, Visibility>,
    reactor: bool,
    // the type aliases being expanded (one naming itself is an error)
    expanding: list<string>,
    // the literal and union types aliases name, by how they show (their WIT names)
    set-names: map<string, string>,
    // the calls given readonly where the parameter is not, or not where it is (effects.yel checks
    // them once every func's effects are known)
    sites: list<EffectSite>,
    // async: whether the body being checked is an async func's (a closure's is not); and whether
    // the call being checked is a wait's or a start's
    in-async: bool,
    // the type a generator being checked yields (none: no yield here)
    yield-type: option<Type>,
    // the func being checked's bindings: where each name it reads or assigns is bound
    bindings: Bindings,
    async-call: bool,
    // whether the call being checked is a start's (its arguments are the task's while it runs)
    starting: bool,
    // the names each scope narrows (an is test held there: not in a closure, which may run later;
    // the other names the scope binds are its own, seen anywhere), and the names the func being
    // checked assigns anywhere (never narrowed: a value tested once stays that value)
    narrows: list<set<Name>>,
    assigned: map<Name, bool>,
    scopes: list<map<Name, Type>>,
    // each scope's bindings' marks, and how many closures deep it is (a name read from a closure
    // deeper than its binding is captured); the closure depth and unit being checked
    marks: list<map<Name, Mark>>,
    depths: list<s64>,
    closure-depth: s64,
    unit: Unit,
    result: Type,
    file: string,
    in-func: string,
    // the checked func's type parameters
    type-params: list<string>,
    vars: s64,
    // the type arguments of the last generic call checked
    last-type-args: list<Type>,
    // what is being checked, for errors
    span: Span,
    // where the func being checked is written, and the prelude's names (reached from anywhere)
    scope: Scope,
    prelude: map<string, bool>,
    // how many for loops enclose what is being checked (break and continue need one)
    loops: s64,
}

module checker {
    // what a view in another's tree is given each prop through (lower.yel's: view-set-<prop>)
    const PROP-SETTER: string = "view-set-";
    // and what reads one kept current is typed by (lower.yel's: view-as-<prop>)
    const PROP-AS: string = "view-as-";
    // what a widget's element is made through (lower.yel's: widget-<Tag>-make, -set-<attribute>,
    // -on-<event>, -container), each of the module of a widget set in scope
    const WIDGET-FUNC: string = "widget-";

    // an error at what is being checked (the innermost expression), told: the checker goes on (what
    // was wrong given the error type, which fits anything)
    type-error: func(checking: Checker, message: string) { tell(checking, diagnostics.error(checking.span, message, "")); }

    // an error found, kept, unless it is an echo: one more in a statement that has one already, or
    // one about an error's type (what was wrong made it)
    tell: func(checking: Checker, diagnostic: Diagnostic) {
        if checking.quiet || diagnostic.message.contains("\{error\}") { return; }
        // in a func's body, the rest of the statement is quiet (a declaration's errors are each its own)
        if checking.in-func != "the declarations" { checking.quiet = true; }
        diagnostics.report(checking.context, diagnostic);
    }

    // a name not found: the error, and a name like it that is there (a likely typo), if one is
    not-found: func(checking: Checker, message: string, name: string, candidates: list<string>) {
        let like = diagnostics.closest(name, candidates);
        type-error-help(checking, message, "", if like == "" { "" } else { "did you mean {like}?" });
    }

    // a WIT interface's or resource's func not found (key: its module's or resource's): a name
    // like it, else why it may not be there
    wit-not-found: func(checking: Checker, message: string, name: string, key: string) {
        let diagnostic = diagnostics.error(checking.span, message, "");
        let like = diagnostics.closest(name, funcs-of(checking, key));
        if like != "" { diagnostics.help(diagnostic, "did you mean {like}?"); }
        else if find-byte(key, 58).unwrap-or(-1) > 0 {
            diagnostics.note(diagnostic, "a WIT func that needs a WIT type that is not known is left out");
        }
        tell(checking, diagnostic);
    }

    // a prop a view in another's tree is given that its view has not (its module's view-set-<prop>,
    // lower.yel's: one for each field of the view not @(private))
    no-prop: func(checking: Checker, module: string, setter: string, key: string) {
        let prefix = if setter.starts-with(PROP-AS) { PROP-AS } else { PROP-SETTER };
        let prop = prop-name(setter.substring(prefix.len(), setter.len()));
        // (items given: its children, which only a view with #children takes)
        if prop == "view-children" {
            let given = diagnostics.error(checking.span, "the view of module {module} takes no items: it has no #children", "");
            diagnostics.help(given, "put #children in its tree where what it is given goes");
            tell(checking, given);
            return;
        }
        let diagnostic = diagnostics.error(checking.span, "the view of module {module} has no prop {prop}", "");
        let props: list<string> = [];
        for candidate in funcs-of(checking, key) {
            if candidate.starts-with(PROP-SETTER) { props.push(prop-name(candidate.substring(PROP-SETTER.len(), candidate.len()))); }
        }
        let like = diagnostics.closest(prop, props);
        if like != "" { diagnostics.help(diagnostic, "did you mean {like}?"); }
        diagnostics.note(diagnostic, "a view's props are its fields, but those @(private)");
        tell(checking, diagnostic);
    }

    // the f of the module x's type is declared in (pkg/module.T: pkg/module.f), where it is
    // visible here and takes x first ("": none such, or x's type in no module)
    type-module-key: func(checking: Checker, target: Expr, callee: string, args: list<Expr>) -> string {
        let named = match resolve(check(checking, target, fresh(checking), "a method's target")) {
            named(name) => name-text(name),
            _ => { return ""; }
        };
        // (a module's type: pkg/module.T, or module.T; one of a package's top level, pkg/T or T,
        // has no module)
        let dot = named.len() - base-name(named).len() - 1;
        if dot <= 0 || named.byte-at(dot) != 46 { return ""; }
        let key = named.substring(0, dot) + "." + callee;
        if !checking.symbols.funcs.has(key) || !visible(checking, checking.scope, key) || !takes-first(checking, key, args) { return ""; }
        key
    }

    // the modules a widget's funcs may be in: those included where sc is, and its package's
    widget-modules: func(sc: Scope) -> list<string> {
        let out: list<string> = [];
        for key in sc.includes.values() { if !out.contains(key) { out.push(key); } }
        for module-name in sc.pkg.modules.keys() {
            let key = sc.pkg.prefix + module-name;
            if !out.contains(key) { out.push(key); }
        }
        out
    }

    // a widget's func not found (widget-Tag-what): told as what is missing. A widget not found is
    // told once, at its make (its attributes', events' and items' calls say nothing more)
    no-widget: func(checking: Checker, function-name: string) {
        let rest = function-name.substring(WIDGET-FUNC.len(), function-name.len());
        let dash = find-byte(rest, 45).unwrap-or(-1);
        if dash < 0 { type-error(checking, "no func {function-name}"); return; }
        let tag = rest.substring(0, dash);
        let what = rest.substring(dash + 1, rest.len());
        let widgets: list<string> = [];
        let parts: list<string> = [];
        let known = false;
        for key in widget-modules(checking.scope) {
            for candidate in funcs-of(checking, key) {
                if !candidate.starts-with(WIDGET-FUNC) { continue; }
                let inner = candidate.substring(WIDGET-FUNC.len(), candidate.len());
                let at = find-byte(inner, 45).unwrap-or(-1);
                if at < 0 { continue; }
                let name = inner.substring(0, at);
                let part = inner.substring(at + 1, inner.len());
                if part == "make" && !widgets.contains(name) { widgets.push(name); }
                if name == tag {
                    known = true;
                    parts.push(part);
                }
            }
        }
        if what == "make" {
            let diagnostic = diagnostics.error(checking.span, "no widget {tag}", "");
            let like = diagnostics.closest(tag, widgets);
            if like != "" { diagnostics.help(diagnostic, "did you mean {like}?"); }
            diagnostics.note(diagnostic, "a widget is a widget set's, its module included (from \"yel:widgets\" include meshx;)");
            tell(checking, diagnostic);
            return;
        }
        // (its widget not found: told at its make)
        if !known { return; }
        if what == "container" {
            type-error(checking, "{tag} is not a container: it takes no items");
            return;
        }
        // (one it may not hold: told only where it holds parts, a container with none is told
        // at container)
        if what.starts-with("holds-") {
            let holds: list<string> = [];
            for part in parts { if part.starts-with("holds-") { holds.push(part.substring(6, part.len())); } }
            if holds.len() == 0 { return; }
            let held = what.substring(6, what.len());
            type-error(checking, "{tag} holds {holds.join(", ")}, not {held}");
            return;
        }
        let kind = if what.starts-with("on-") || what.starts-with("when-") { "event" } else { "attribute" };
        let prefix = if what.starts-with("when-") { "when-" } else if kind == "event" { "on-" } else if what.starts-with("as-") { "as-" } else if what.starts-with("value-") { "value-" } else { "set-" };
        let name = what.substring(prefix.len(), what.len());
        let names: list<string> = [];
        for part in parts { if part.starts-with(prefix) { names.push(part.substring(prefix.len(), part.len())); } }
        let diagnostic = diagnostics.error(checking.span, "{tag} has no {kind} {if kind == "event" { "on." } else { "" }}{name}", "");
        let like = diagnostics.closest(name, names);
        if like != "" { diagnostics.help(diagnostic, "did you mean {if kind == "event" { "on." } else { "" }}{like}?"); }
        tell(checking, diagnostic);
    }

    // the attribute a widget's func of that part is for (widget-Tag-set-name, part -set-: name;
    // "" for another func)
    widget-attribute: func(function-name: string, part: string) -> string {
        if !function-name.starts-with(WIDGET-FUNC) { return ""; }
        match function-name.find(part) {
            some(index) => function-name.substring(index + part.len(), function-name.len()),
            none => "",
        }
    }

    // a prop as it is written: a callback's field (on-name) on.name
    prop-name: func(field: string) -> string {
        if field.starts-with("on-") { "on.{field.substring(3, field.len())}" } else { field }
    }

    // the names a name may be here: the locals in scope, the funcs, the constants and the cases
    names-here: func(checking: Checker) -> list<string> {
        let out: list<string> = [];
        for sc in checking.scopes {
            for name in sc.keys() { out.push(name-text(name)); }
        }
        for key in checking.symbols.funcs.keys() { out.push(base-name(key)); }
        for key in checking.symbols.consts.keys() { out.push(base-name(key)); }
        for key in checking.case-owner.keys() { out.push(key); }
        for key in checking.builtins.keys() { out.push(key); }
        out
    }

    // the funcs of a module or a resource (by its key): their names
    funcs-of: func(checking: Checker, key: string) -> list<string> {
        let out: list<string> = [];
        let prefix = key + ".";
        for candidate in checking.symbols.funcs.keys() {
            if starts-at(candidate, 0, prefix) { out.push(candidate.substring(prefix.len(), candidate.len())); }
        }
        out
    }

    // one with more to say: a label under it, and help ("" for none)
    type-error-help: func(checking: Checker, message: string, label: string, help: string) {
        let diagnostic = diagnostics.error(checking.span, message, label);
        if help != "" { diagnostics.help(diagnostic, help); }
        tell(checking, diagnostic);
    }

    fresh: func(checking: Checker) -> Type {
        checking.vars += 1;
        Type.var({ id: checking.vars, kind: 0, bound: none, })
    }

    // a variable for a literal: kind 1, an integer's; 2, a float's
    fresh-kind: func(checking: Checker, kind: s64) -> Type {
        checking.vars += 1;
        Type.var({ id: checking.vars, kind: kind, bound: none, })
    }

    // that t is a number (a variable not yet one becomes an integer's)
    numeric: func(checking: Checker, t0: Type, what: string) {
        let resolved = resolve(t0);
        match resolved {
            var(variable) => { if variable.kind == 0 { variable.bound = some(fresh-kind(checking, 1)); } }
            num(_) => {}
            _ => type-error(checking, "{what}: expected a number, found {show-type(resolved)}"),
        }
    }

    // that t is an integer, or (flags) a flags type
    integral: func(checking: Checker, t0: Type, what: string, flags: bool) {
        let resolved = resolve(t0);
        match resolved {
            var(variable) => {
                if variable.kind == 0 { variable.bound = some(fresh-kind(checking, 1)); }
                if variable.kind == 2 { type-error(checking, "{what}: expected an integer, found a float"); }
            }
            num(name) => { if !is-int(name) { type-error(checking, "{what}: expected an integer, found {name}"); } }
            named(name) => {
                if !(flags && checking.symbols.flags.has(name)) {
                    type-error(checking, "{what}: expected an integer, found {name}");
                }
            }
            _ => type-error(checking, "{what}: expected an integer, found {show-type(resolved)}"),
        }
    }

    // that < and the rest compare t: a number, char, bool or enum
    comparable: func(checking: Checker, t0: Type, what: string) {
        let resolved = resolve(t0);
        match resolved {
            var(variable) => { if variable.kind == 0 { variable.bound = some(fresh-kind(checking, 1)); } }
            num(_) => {}
            char-type => {}
            bool-type => {}
            // a distinct type: as what it is held as
            distinct-type(distinct) => comparable(checking, distinct.base, what),
            named(name) => {
                if !checking.symbols.variants.has(name) || !all-bare(checking.symbols.variants[name].cases) {
                    type-error(checking, "{what}: {name} is not ordered");
                }
            }
            _ => type-error(checking, "{what}: a {show-type(resolved)} is not ordered"),
        }
    }

    // whether no case carries a payload (an enum)
    all-bare: func(cases: list<CaseDecl>) -> bool {
        for case in cases {
            if case.has-payload { return false; }
        }
        true
    }

    // got where want is wanted: the same type, or (types as sets) a subset of it
    unify: func(checking: Checker, want: Type, got: Type, what: string) {
        // a call that never returns gives no value: it fits whatever is wanted (and settles nothing)
        if is-never(got) { return; }
        if !unifies(want, got) && !subtype(checking, got, want) {
            type-error-help(
                checking,
                "{what}: expected {show-type(want)}, found {show-type(got)}",
                "",
                literal-hint(checking, want, got),
            );
        }
    }

    // why a record literal is not the declared record wanted later: it is one only where one is
    // wanted ("" when that is not the mismatch)
    literal-hint: func(checking: Checker, want: Type, got: Type) -> string {
        match resolve(want) {
            named(name) => {
                match resolve(got) {
                    anon-record(anonymous) => {
                        if checking.symbols.records.has(name) && same-fields(
                            checking.symbols.records[name].fields,
                            anonymous.fields,
                        ) {
                            return "a record literal is a {base-name(name-text(name))} where one is wanted: write its type (let p: {base-name(name-text(name))} = …)";
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        ""
    }

    // t, each name in it a known type (else told), and as the checker goes on with it: what was not
    // known an error's type (its uses not told again)
    known: func(checking: Checker, given: Type, what: string, open: bool) -> Type {
        known-type-in(checking, given, what, open);
        without-unknown(checking, given)
    }

    without-unknown: func(checking: Checker, given: Type) -> Type {
        match given {
            named(name) => if is-type-key(checking, name-text(name)) { given } else { Type.error-type },
            _ => if child-count(given) == 0 { given } else { map-children(given, { child -> without-unknown(checking, child) }) },
        }
    }

    // open: a list's length may be left to the value (list<T, ?>: a let's type)
    known-type-in: func(checking: Checker, given: Type, what: string, open: bool) {
        match given {
            named(name) => if !is-type-key(checking, name-text(name)) { type-error(checking, "{what}: no type {name}"); },
            fixed-list(fixed) => {
                if fixed.len < 0 && !open {
                    type-error(
                        checking,
                        "{what}: list<T, ?> takes its length from a let's value: write the length",
                    );
                }
            }
            _ => {}
        }
        for index in 0..child-count(given) { known-type-in(checking, child(given, index), what, open); }
    }

    // n bound in the innermost scope, its mark in the unit being checked
    bind: func(checking: Checker, name: Name, given: Type, mark: Mark) {
        checking.scopes[checking.scopes.len() - 1].set(name, given);
        checking.marks[checking.marks.len() - 1].set(name, mark);
        // a binding of its own (not what a test narrowed): seen in a closure too
        let _ = checking.narrows[checking.narrows.len() - 1].remove(name);
        mark.unit = checking.unit;
        mark.ty = given;
        if checking.noting && checking.extents.len() > 0 { checking.context.locals.push({ mark: mark, until: checking.extents[checking.extents.len() - 1], }); }
    }

    // the binding a local's name is where it is read (the innermost: narrowing keeps its binding)
    binding-of: func(checking: Checker, name: Name) -> option<Mark> {
        let count = checking.marks.len();
        for step in 0..count {
            let index = count - 1 - step;
            if checking.marks[index].has(name) { return some(checking.marks[index][name]); }
        }
        none
    }

    // a scope, visible in extent (a block's span, a body's, a match arm's): what its bindings are
    // visible in, as a language server's completion asks
    push-scope: func(checking: Checker, extent: Span) {
        checking.extents.push(extent);
        checking.scopes.push(map.new());
        checking.marks.push(map.new());
        checking.depths.push(checking.closure-depth);
        checking.narrows.push(set.new());
    }

    pop-scope: func(checking: Checker) {
        checking.extents.pop();
        checking.scopes.pop();
        checking.marks.pop();
        checking.depths.pop();
        checking.narrows.pop();
    }

    // a local's type (none: no local has that name); read from a closure deeper than its binding,
    // the binding is captured (and its unit has an environment)
    local-type: func(checking: Checker, name: Name) -> option<Type> {
        let count = checking.scopes.len();
        for step in 0..count {
            let index = count - 1 - step;
            // a closure may run later: what an is test found does not hold in it
            let skip = checking.narrows[index].has(name) && checking.depths[index] < checking.closure-depth;
            if checking.scopes[index].has(name) && !skip {
                if checking.depths[index] < checking.closure-depth {
                    let mark = checking.marks[index][name];
                    mark.captured = true;
                    mark.unit.env = true;
                }
                return some(checking.scopes[index][name]);
            }
        }
        none
    }

    instantiate: func(checking: Checker, sig: FuncSymbol) -> Instance {
        let vars: map<string, Type> = map.new();
        let type-args: list<Type> = [];
        for tp in sig.type-params {
            let variable = fresh(checking);
            vars.set(tp, variable);
            type-args.push(variable);
        }
        let params: list<Type> = [];
        for parameter in sig.params { params.push(substitute(parameter, vars)); }
        { params: params, result: substitute(sig.result, vars), type-args: type-args, }
    }

    // the program: every func's body against its signature
    // every func's body checked; the places readonly and moves are checked at once the program's
    // flow is known (effects.yel, after codegen)
    check-program: func(context: Context, decls: list<Decl>, prelude: map<string, bool>, visibility: map<string, Visibility>) -> list<EffectSite> {
        let file = context.input;
        let checking: Checker = {
            context: context,
            noting: !context.exits,
            extents: [],
            quiet: false,
            symbols: context.symbols, methods: map.new(), std-modules: set.new(), builtins: map.new(),
            case-owner: map.new(), resource-scopes: map.new(), visibility: visibility, reactor: is-reactor(decls), expanding: [],
            set-names: map.new(), sites: [], in-async: false,
            async-call: false,
            starting: false,
            yield-type: none,
            bindings: { exprs: map.new(), assigns: map.new(), },
            narrows: [], assigned: map.new(),
            scopes: [], marks: [], depths: [], closure-depth: 0, unit: { env: false, },
            result: Type.unit-type, file: file, in-func: "the declarations",
            type-params: [], vars: 0, last-type-args: [],
            span: { source: -1, line: 0, col: 0, end-line: 0, end-col: 0, }, scope: blank-scope(file),
            prelude: prelude, loops: 0,
        };
        // (a cache kept: its funcs' bodies taken where every declaration's interface and the
        // sources read are as its check found them: no body's check reads more)
        let sources = context.sources.map({ source -> source.path });
        let reusing = match context.cache {
            some(cache) => same-texts(cache.interface, context.interface) && same-texts(cache.sources, sources),
            none => false,
        };
        let kept: map<string, CheckedBody> = map.new();
        // the builtins, by name: the prelude's funcs (keyed by their names) and the standard
        // library's
        for declaration in decls {
            match declaration {
                func-decl(function) => {
                    if function.scope.pkg.id == "yel:std"
                        || prelude.has(function.name) { builtin(checking, function.name); }
                    if function.scope.pkg.id == "yel:std" && function.scope.module != "" { checking.std-modules.add(function.scope.module); }
                }
                extern-decl(extern) => {
                    if extern.scope.pkg.id == "yel:std"
                        || prelude.has(extern.name) { builtin(checking, extern.name); }
                    if extern.scope.pkg.id == "yel:std" && extern.scope.module != "" { checking.std-modules.add(extern.scope.module); }
                }
                // (a module of only constants too: u32.MAX)
                const-decl(constant) => { if constant.scope.pkg.id == "yel:std" && constant.scope.module != "" { checking.std-modules.add(constant.scope.module); } }
                _ => {}
            }
        }
        // the types' names first, then every type written in a declaration resolved to its key;
        // a name declared again told, the first kept (as a func's: add-sig)
        let types: map<string, bool> = map.new();
        let values: map<string, bool> = map.new();
        for declaration in decls {
            let fresh = match declaration {
                record-decl(declared-record) => once(checking, types, if declared-record.value { "record" } else { "resource" }, declared-record.name, declared-record.span),
                variant-decl(declared-variant) => once(checking, types, "variant", declared-variant.name, declared-variant.span),
                flags-decl(fl) => once(checking, types, "flags", fl.name, fl.span),
                type-decl(alias) => once(checking, types, "type", alias.name, alias.span),
                const-decl(constant) => once(checking, values, "const", constant.name, constant.span),
                global-decl(global) => once(checking, values, "global", global.name, global.span),
                _ => true,
            };
            if !fresh { continue; }
            match declaration {
                record-decl(declared-record) => {
                    for at in 0..declared-record.fields.len() {
                        if declared-record.fields.index-of(declared-record.fields[at]) < at {
                            checking.span = declared-record.span;
                            type-error(checking, "{if declared-record.value { "record" } else { "resource" }} {base-name(declared-record.name)} has the field {declared-record.fields[at]} twice");
                        }
                    }
                    checking.symbols.records.set(intern(declared-record.name), declared-record);
                    if !declared-record.value { checking.resource-scopes.set(intern(declared-record.name), declared-record.scope); }
                }
                variant-decl(declared-variant) => {
                    checking.symbols.variants.set(intern(declared-variant.name), declared-variant);
                    for case in declared-variant.cases {
                        if !checking.case-owner.has(case.name) { checking.case-owner.set(case.name, []); }
                        checking.case-owner[case.name].push(declared-variant.name);
                    }
                }
                flags-decl(fl) => {
                    // held in a u64: one bit each
                    if fl.flags.len() > 64 {
                        let diagnostic = diagnostics.error(
                            fl.span,
                            "flags {base-name(fl.name)} has {fl.flags.len()} flags: a flags type holds 64 at most",
                            "",
                        );
                        diagnostics.help(diagnostic, "split it into two flags types");
                        tell(checking, diagnostic);
                    }
                    checking.symbols.flags.set(intern(fl.name), fl);
                }
                resource-decl(declared-resource) => checking.symbols.resources.set(intern(declared-resource.name), declared-resource),
                const-decl(constant) => checking.symbols.consts.set(constant.name, constant),
                global-decl(global) => checking.symbols.globals.set(global.name, global),
                type-decl(alias) => checking.symbols.aliases.set(alias.name, alias),
                // a resource's method: its handle is its first param, self
                extern-decl(extern) => {
                    if extern.params.len() > 0 && extern.params[0] == "self" {
                        checking.methods.set(base-name(extern.name), true);
                    }
                }
                _ => {}
            }
        }
        for declaration in decls {
            // (each declaration's errors its own: a global's or a const's check before it leaves
            // in-func its own)
            checking.in-func = "the declarations";
            checking.quiet = false;
            match declaration {
                record-decl(declared-record) => {
                    declared-record.field-types = resolve-types(checking, declared-record.scope, declared-record.field-types, []);
                }
                variant-decl(declared-variant) => {
                    for case in declared-variant.cases {
                        case.payload = resolve-type(checking, declared-variant.scope, case.payload, []);
                    }
                }
                func-decl(function) => {
                    function.param-types = resolve-types(checking, function.scope, function.param-types, function.type-params);
                    function.result = resolve-type(checking, function.scope, function.result, function.type-params);
                    add-sig(checking, function.name, signature(function.type-params, function.param-types, function.params, function.defaults, function.result, function.scope, function.span), function.is-async, false, "");
                    for at in 0..function.params.len() {
                        if function.params.index-of(function.params[at]) < at {
                            checking.span = function.span;
                            type-error(checking, "func {base-name(function.name)} has the parameter {function.params[at]} twice");
                        }
                    }
                    // what its signature names that is not a type: told here, before any body (a
                    // call of it checked first sees an error's type, not the name)
                    let sig = checking.symbols.funcs[function.name];
                    for index in 0..sig.params.len() { sig.params[index] = known(checking, sig.params[index], "a parameter", false); }
                    sig.result = known(checking, sig.result, "the result", false);
                }
                extern-decl(extern) => {
                    extern.param-types = resolve-types(checking, extern.scope, extern.param-types, extern.type-params);
                    extern.result = resolve-type(checking, extern.scope, extern.result, extern.type-params);
                    add-sig(checking, extern.name, signature(extern.type-params, extern.param-types, extern.params, extern.defaults, extern.result, extern.scope, extern.span), extern.is-async, true, extern.wit-module);
                }
                flags-decl(_) => {}
                resource-decl(_) => {}
                const-decl(constant) => check-const(checking, constant),
                global-decl(global) => check-global(checking, global),
                type-decl(alias) => {
                    checking.span = alias.span;
                    // what it names, resolved (the generator names literal and union types at a
                    // component's boundary by it)
                    alias.resolved = alias-type(checking, alias.name);
                    let key = show-type(alias.resolved);
                    if !checking.set-names.has(key) { checking.set-names.set(key, alias.name); }
                }
            }
        }
        // what can be named where a type cannot: told (rule e)
        check-signatures(checking, decls);
        // a record (a value) that holds itself: told
        for declaration in decls {
            match declaration {
                record-decl(declared-record) => {
                    if declared-record.value && holds-inline(checking, intern(declared-record.name), declared-record.field-types, []) {
                        checking.quiet = false;
                        checking.span = declared-record.span;
                        let d2 = diagnostics.error(declared-record.span, "record {base-name(declared-record.name)} holds itself: a value's size would never end", "");
                        diagnostics.help(d2, "hold it where a value is on the heap: a list, a variant's case, or a resource");
                        tell(checking, d2);
                    }
                }
                _ => {}
            }
        }
        for declaration in decls {
            match declaration {
                record-decl(declared-record) => {
                    checking.span = declared-record.span;
                    for index in 0..declared-record.field-types.len() { declared-record.field-types[index] = known(checking, declared-record.field-types[index], "record {declared-record.name}", false); }
                }
                variant-decl(declared-variant) => {
                    checking.span = declared-variant.span;
                    for case in declared-variant.cases { case.payload = known(checking, case.payload, "variant {declared-variant.name}", false); }
                }
                func-decl(function) => {
                    // (one declared twice, told: its body is not the signature kept's, so unchecked)
                    match checking.symbols.funcs.get(function.name) {
                        some(sig) => { if sig.params.len() != function.params.len() { continue; } }
                        none => {}
                    }
                    check-crossings(checking, function);
                    checked-func(checking, function, reusing, kept);
                }
                _ => {}
            }
        }
        note-type-uses(checking);
        // (what the next check of the program may take: what this one checked and kept)
        match context.cache {
            some(cache) => {
                cache.funcs = kept;
                cache.interface = context.interface;
                cache.sources = sources;
            }
            none => {}
        }
        checking.sites
    }

    // whether two lists hold the same texts, in the same order
    same-texts: func(left: list<string>, right: list<string>) -> bool {
        if left.len() != right.len() { return false; }
        for index in 0..left.len() { if left[index] != right[index] { return false; } }
        true
    }

    // a func checked; or, where the cache has it as it is written now and nothing any body's
    // check reads has changed (reusing), its body as that check left it, and what it made and told
    // (its effect sites, its notes, its errors) told again. What it is now kept, by its text
    checked-func: func(checking: Checker, function: Func, reusing: bool, kept: map<string, CheckedBody>) {
        begin-func(checking, function);
        let cache = match checking.context.cache {
            some(value) => value,
            none => {
                check-body(checking, function);
                return;
            }
        };
        let key = checking.context.func-texts.get(function).unwrap-or("");
        if reusing && key != "" && cache.funcs.has(key) {
            let old = cache.funcs[key];
            function.body = old.func.body;
            function.marks = old.func.marks;
            function.unit = old.func.unit;
            function.bindings = old.func.bindings;
            function.is-generator = old.func.is-generator;
            for site in old.sites { checking.sites.push(site); }
            for used in old.uses { checking.context.uses.push(used); }
            for local in old.locals { checking.context.locals.push(local); }
            for member in old.members { checking.context.members.push(member); }
            for body in old.bodies { checking.context.bodies.push(body); }
            for diagnostic in old.errors { diagnostics.report(checking.context, diagnostic); }
            kept.set(key, { func: function, sites: old.sites, uses: old.uses, locals: old.locals, members: old.members, bodies: old.bodies, errors: old.errors, });
            return;
        }
        let sites = checking.sites.len();
        let uses = checking.context.uses.len();
        let locals = checking.context.locals.len();
        let members = checking.context.members.len();
        let bodies = checking.context.bodies.len();
        let errors = checking.context.errors.len();
        check-body(checking, function);
        if key == "" { return; }
        kept.set(key, {
            func: function,
            sites: checking.sites.slice(sites, checking.sites.len()),
            uses: checking.context.uses.slice(uses, checking.context.uses.len()),
            locals: checking.context.locals.slice(locals, checking.context.locals.len()),
            members: checking.context.members.slice(members, checking.context.members.len()),
            bodies: checking.context.bodies.slice(bodies, checking.context.bodies.len()),
            errors: checking.context.errors.slice(errors, checking.context.errors.len()),
        });
    }

    // ---- uses: each name resolved, and what it names (Context.uses: analysis's, a language server's)

    // a name's use, at span: a declaration's key, or a local's binding (kept only for a caller that
    // asks for them, analysis.check's: yelc's own compile keeps none)
    note-use: func(checking: Checker, span: Span, key: string, local: option<Mark>) {
        if span.source < 0 { return; }
        if key == "" {
            match local {
                some(_) => {}
                none => { return; }
            }
        }
        checking.context.uses.push({ span: span, key: key, local: local, ty: Type.unit-type, text: "", });
    }

    // a field of a type that is its fields (a tuple's, an anonymous record's): no declaration names
    // it, so its use carries its type (its key the type and the field, ~T#f, so the uses of one
    // type's field are one another's)
    note-structural: func(checking: Checker, span: Span, given: Type, field-name: string, ty: Type) {
        if span.source < 0 { return; }
        checking.context.uses.push({ span: span, key: "~{show-type(given)}#{field-name}", local: none, ty: ty, text: "", });
    }

    // a type named in an expression (Shape of Shape.circle(5), types.tcp-socket of
    // types.tcp-socket.create(f)): its use, and its module's where it is qualified
    note-type-target: func(checking: Checker, target: Expr, key: string) {
        match target.kind {
            name(_) => note-use(checking, target.span, key, none),
            field(field-access) => {
                note-use(checking, field-access.name-span, key, none);
                let mk = module-ref(checking, field-access.target);
                if mk != "" { note-use(checking, field-access.target.span, mk, none); }
            }
            _ => {}
        }
    }

    // the key of case (or flag) n of a value of type t: its variant's (or flags') key and the
    // case, T#n; an option's or a result's, builtin:option#n, builtin:result#n ("" for none)
    case-key: func(checking: Checker, given: Type, qualified-name: string) -> string {
        let name = base-name(qualified-name);
        match resolve(given) {
            readonly-type(wrapped) => case-key(checking, wrapped, qualified-name),
            named(owner) => {
                let declared = (checking.symbols.variants.has(owner) && checking.symbols.variants[owner].cases.any({ case -> case.name == name }))
                    || (checking.symbols.flags.has(owner) && contains(checking.symbols.flags[owner].flags, name));
                if declared { "{name-text(owner)}#{name}" } else { "" }
            }
            option-type(_) => "builtin:option#{name}",
            result-type(_) => "builtin:result#{name}",
            _ => "",
        }
    }

    // a literal's kind and its value as written (an integer's, a float's text; a char's code
    // point; a string's value; an interpolation's none: no one value), read before the check
    // lowers it (an interpolation becomes the calls that make its text)
    literal-of: func(expression: Expr) -> option<tuple<string, string>> {
        match expression.kind {
            int-lit(text) => some(("int", text)),
            float-lit(text) => some(("float", text)),
            char-lit(code) => some(("char", "{code}")),
            bool-lit(flag) => some(("bool", if flag { "true" } else { "false" })),
            str-lit(contents) => some(("string", contents)),
            interp(_) => some(("interp", "")),
            _ => none,
        }
    }

    // a literal where it is written, of type t as the check settles it: what a language server
    // tells of it
    note-literal: func(checking: Checker, at: Span, literal: option<tuple<string, string>>, given: Type) {
        if at.source < 0 { return; }
        match literal {
            some(found) => {
                let (kind, text) = found;
                checking.context.uses.push({ span: at, key: "literal:{kind}:{at.source}:{at.line}:{at.col}", local: none, ty: given, text: text, });
            }
            none => {}
        }
    }

    // whether a type is its fields (a tuple, an anonymous record: no declaration names them)
    structural: func(given: Type) -> bool {
        match resolve(given) {
            readonly-type(wrapped) => structural(wrapped),
            tuple-type(_) => true,
            anon-record(_) => true,
            _ => false,
        }
    }

    // each declared type's name the parser read: what it names, where it was written (looked up
    // quietly: what may not be named there was told where the type was resolved)
    note-type-uses: func(checking: Checker) {
        for written in checking.context.type-names {
            for key in candidates(checking, written.scope, written.name, "type") {
                if declared(checking, key, "type") && visible(checking, written.scope, key) {
                    if checking.noting { note-use(checking, written.span, key, none); }
                    break;
                }
            }
        }
    }

    // the key of the module named m where sc is (an include, or one of its package's), or "".
    // Another package's private module is never included (packages.yel says so); one of its own
    // package's private to another file is named here only to be told
    module-key: func(checking: Checker, sc: Scope, module-name: string) -> string {
        if sc.includes.has(module-name) { return sc.includes[module-name]; }
        if sc.pkg.modules.has(module-name) {
            let key = sc.pkg.prefix + module-name;
            if !visible(checking, sc, key) { private-error(checking, "module", key); }
            return key;
        }
        ""
    }

    // ================================================================ names: one lookup

    // the key of the name n declared as kind ("func", "type", "const", "global") where sc is: the
    // first of the places it may be declared (written m.n: module m's; else sc's module's, its
    // package's top level, and for a type std's) where it is declared and may be named from sc.
    // One declared where it may not be named from here is not there (the next place is looked at);
    // when that leaves none, the error says why and its key is the answer (no echo of it). ""
    // when it is declared nowhere
    lookup: func(checking: Checker, sc: Scope, name: string, kind: string) -> string {
        let hidden = "";
        for key in candidates(checking, sc, name, kind) {
            if !declared(checking, key, kind) { continue; }
            if visible(checking, sc, key) { return key; }
            if hidden == "" { hidden = key; }
        }
        if hidden != "" { private-error(checking, kind, hidden); }
        hidden
    }

    // a module's member (by the module's key) declared as kind, where the func being checked is: its
    // key ("" for none; one that may not be named here is told, and is the answer)
    member: func(checking: Checker, module: string, name: string, kind: string) -> string {
        let key = module + "." + name;
        if !declared(checking, key, kind) { return ""; }
        if !visible(checking, checking.scope, key) { private-error(checking, kind, key); }
        key
    }

    // where a name may be declared, in the order looked at
    candidates: func(checking: Checker, sc: Scope, name: string, kind: string) -> list<string> {
        let dot = find-byte(name, 46).unwrap-or(-1);
        if dot > 0 {
            let module-name = name.substring(0, dot);
            let mk = module-key(checking, sc, module-name);
            // a std module's (value.value-kind), as its funcs are reached
            if mk == "" && checking.std-modules.has(module-name) { return ["yel:std/" + name,]; }
            if mk == "" { return []; }
            return [mk + "." + name.substring(dot + 1, name.len()),];
        }
        let out: list<string> = [];
        if sc.module != "" { out.push(sc.pkg.prefix + sc.module + "." + name); }
        // (a widget's: the module of a widget set in scope, included or the package's own. What
        // one holds (widget-Tag-holds-Part) is its part's, else holds-any: a container that holds
        // anything)
        if kind == "func" && name.starts-with(WIDGET-FUNC) {
            for key in widget-modules(sc) { out.push(key + "." + name); }
            match name.find("-holds-") {
                some(at) => {
                    let any = name.substring(0, at) + "-holds-any";
                    for key in widget-modules(sc) { out.push(key + "." + any); }
                }
                none => {}
            }
        }
        // (a program without a package's name keys its items as the prelude does: a prelude's func
        // is the prelude's)
        if !(kind == "func" && sc.pkg.prefix == "" && checking.prelude.has(name)) { out.push(sc.pkg.prefix + name); }
        if kind == "type" { out.push("yel:std/" + name); }
        out
    }

    // whether a key is declared as kind
    declared: func(checking: Checker, key: string, kind: string) -> bool {
        if kind == "func" { return checking.symbols.funcs.has(key); }
        if kind == "type" { return is-type-key(checking, key); }
        if kind == "const" { return checking.symbols.consts.has(key); }
        if kind == "global" { return checking.symbols.globals.has(key); }
        false
    }

    // whether what key names may be named where sc is: its package's files, or its own file, for
    // what is private (packages.key-decls' table); anyone who reaches it for the rest
    visible: func(checking: Checker, sc: Scope, key: string) -> bool {
        match checking.visibility.get(key) {
            some(value) => value.pkg.prefix == sc.pkg.prefix && (value.level != "file" || value.file == sc.file),
            none => true,
        }
    }

    // whether types hold the record named target in place (inline: in a record's fields, a tuple,
    // an anonymous record, a fixed list, an option or a result), not behind a pointer (a list, a
    // map, a variant, a resource)
    holds-inline: func(checking: Checker, target: Name, types: list<Type>, seen: list<Name>) -> bool {
        for t0 in types {
            let resolved = resolve(t0);
            let inside: list<Type> = match resolved {
                named(name) => {
                    if name == target { return true; }
                    if checking.symbols.records.has(name) && checking.symbols.records[name].value && !seen.contains(name) {
                        if holds-inline(checking, target, checking.symbols.records[name].field-types, concat-names(seen, name)) { return true; }
                    }
                    []
                }
                tuple-type(xs) => xs,
                anon-record(anonymous) => anonymous.types,
                fixed-list(fixed) => [fixed.item,],
                option-type(inner) => [inner,],
                result-type(outcome) => [outcome.ok, outcome.err,],
                _ => [],
            };
            if holds-inline(checking, target, inside, seen) { return true; }
        }
        false
    }

    concat-names: func(left: list<Name>, name: Name) -> list<Name> {
        let out: list<Name> = [];
        for item in left { out.push(item); }
        out.push(name);
        out
    }

    // ---- what a declaration lets others see

    // how widely a declaration may be named, by its level: 2 by whoever reaches it, 1 by its
    // package's files (@(private)), 0 by its own file (@(private="file"))
    reach: func(level: string) -> s64 { if level == "" { 2 } else if level == "package" { 1 } else { 0 } }

    // each declaration's signature (a func's params and result, a record's fields, a variant's
    // payloads, a global's type, an alias's target) names no type that may be named by fewer than
    // the declaration may: where one could be named and its type not, its type would be a name
    // nobody there can write
    check-signatures: func(checking: Checker, decls: list<Decl>) {
        for declaration in decls {
            match declaration {
                func-decl(function) => signature-types(checking, "func", function.name, function.scope, function.span, concat-types(function.param-types, [function.result,])),
                extern-decl(extern) => signature-types(checking, "func", extern.name, extern.scope, extern.span, concat-types(extern.param-types, [extern.result,])),
                record-decl(declared-record) => signature-types(checking, "record", declared-record.name, declared-record.scope, declared-record.span, declared-record.field-types),
                variant-decl(declared-variant) => signature-types(checking, "variant", declared-variant.name, declared-variant.scope, declared-variant.span, declared-variant.cases.filter({ case -> case.has-payload }).map({ case -> case.payload })),
                global-decl(global) => signature-types(checking, "global", global.name, global.scope, global.span, [global.ty,]),
                type-decl(alias) => signature-types(checking, "type", alias.name, alias.scope, alias.span, [alias.resolved,]),
                _ => {}
            }
        }
    }

    concat-types: func(left: list<Type>, right: list<Type>) -> list<Type> {
        let out: list<Type> = [];
        for item in left { out.push(item); }
        for item in right { out.push(item); }
        out
    }

    // the types a declaration names, each checked against how widely the declaration may be named
    signature-types: func(checking: Checker, kind: string, key: string, sc: Scope, span: Span, types: list<Type>) {
        // (each declaration's own: not an echo of another's)
        checking.quiet = false;
        checking.span = span;
        let names: list<string> = [];
        for member in types { named-types-in(member, names); }
        for name in names {
            match checking.visibility.get(name) {
                some(value) => {
                    if reach(value.level) < reach(sc.private) {
                        let wide = if sc.private == "" { "may be named by whoever reaches it" } else { "may be named by its package's files" };
                        let narrow = if value.level == "file" { "its file (@(private=\"file\"))" } else { "its package (@(private))" };
                        let diagnostic = diagnostics.error(span, "{kind} {base-name(key)} {wide}, but names type {base-name(name)}, which is private to {narrow}", "");
                        diagnostics.help(diagnostic, "make {base-name(key)} as private as {base-name(name)}, or {base-name(name)} as visible as {base-name(key)}");
                        tell(checking, diagnostic);
                    }
                }
                none => {}
            }
        }
    }

    // the declared types a type names, by key, into out: named ones and distinct ones, at any depth
    named-types-in: func(given: Type, out: list<string>) {
        match given {
            named(name) => out.push(name-text(name)),
            distinct-type(distinct) => out.push(distinct.name),
            _ => {}
        }
        for index in 0..child-count(given) { named-types-in(child(given, index), out); }
    }

    // a name of what may not be named here: told, with where it is declared private
    private-error: func(checking: Checker, kind: string, key: string) {
        let visibility = checking.visibility[key];
        let to = if visibility.level == "file" { "its file (@(private=\"file\"))" } else { "its package (@(private))" };
        let diagnostic = diagnostics.error(checking.span, "{kind} {base-name(key)} is private to {to}", "");
        let at = if visibility.span.source >= 0 { "{checking.context.sources[visibility.span.source].path}:{visibility.span.line}" } else { visibility.file };
        diagnostics.note(diagnostic, "declared at {at}");
        tell(checking, diagnostic);
    }

    // the variant a bare case name is a case of where the func being checked is: the one variant
    // that may be named here with a case of that name ("" when more than one may: Type.n is then
    // written), none for none. One that may not be named here is not there; when it is the only
    // one, the error says why (report: false for a question asked, not a use)
    case-variant: func(checking: Checker, name: string, report: bool) -> option<string> {
        if !checking.case-owner.has(name) { return none; }
        let here: list<string> = [];
        let hidden = "";
        for owner in checking.case-owner[name] {
            if visible(checking, checking.scope, owner) { here.push(owner); }
            else if hidden == "" { hidden = owner; }
        }
        if here.len() == 0 {
            if hidden == "" || !report { return none; }
            private-error(checking, "variant", hidden);
            return some(hidden);
        }
        some(if here.len() == 1 { here[0] } else { "" })
    }

    // whether a type's key names one whose members are written Type.member (a variant's or an enum's
    // cases, a flags type's flags, a resource's funcs)
    has-members: func(checking: Checker, key: string) -> bool {
        let type-name = intern(key);
        checking.symbols.variants.has(type-name) || checking.symbols.flags.has(type-name) || checking.symbols.resources.has(type-name)
    }

    is-type-key: func(checking: Checker, key: string) -> bool {
        let type-name = intern(key);
        checking.symbols.records.has(type-name) || checking.symbols.variants.has(type-name) || checking.symbols.flags.has(type-name)
            || checking.symbols.resources.has(type-name) || checking.symbols.aliases.has(key)
    }

    // a type's name as written where sc is (Name, or module.Name), as its key (lookup's);
    // unchanged when there is none (known-type reports it)
    type-key: func(checking: Checker, sc: Scope, name: string) -> string {
        let key = lookup(checking, sc, name, "type");
        if key != "" { return key; }
        // (module.Name of a module that has none: the module's key in what is told)
        let places = candidates(checking, sc, name, "type");
        if find-byte(name, 46) != none && places.len() == 1 { places[0] } else { name }
    }

    // a type as written where sc is, its names as keys (tps: the func's type parameters, left as
    // they are)
    resolve-type: func(checking: Checker, sc: Scope, given: Type, tps: list<string>) -> Type {
        match given {
            named(name) => {
                if contains(tps, name-text(name)) { return given; }
                let key = type-key(checking, sc, name-text(name));
                if checking.symbols.aliases.has(key) {
                    // a distinct type: its own, held as what it names
                    if checking.symbols.aliases[key].distinct {
                        return Type.distinct-type({ name: key, base: alias-type(checking, key), });
                    }
                    return alias-type(checking, key);
                }
                Type.named(intern(key))
            }
            union-type(xs) => union-of(resolve-types(checking, sc, xs, tps)),
            anon-record(anonymous) => {
                for index in 0..anonymous.fields.len() {
                    if anonymous.fields.index-of(anonymous.fields[index]) != index {
                        type-error(checking, "field {anonymous.fields[index]} is written twice in {show-type(given)}");
                    }
                }
                anon-record-of(anonymous.fields, resolve-types(checking, sc, anonymous.types, tps))
            }
            readonly-type(wrapped) => readonly-of(resolve-type(checking, sc, wrapped, tps)),
            range-type(range) => {
                if semtype.decimal-order(range.lo, range.hi) > 0 {
                    type-error(checking, "{range.text} holds no value: its end is before its start");
                }
                given
            }
            _ => map-children(given, { child -> resolve-type(checking, sc, child, tps) }),
        }
    }

    // an alias's type: what it names, resolved where it is declared
    alias-type: func(checking: Checker, key: string) -> Type {
        if contains(checking.expanding, key) {
            type-error(checking, "type {base-name(key)} names itself");
            return Type.error-type;
        }
        checking.expanding.push(key);
        let alias = checking.symbols.aliases[key];
        let resolved = known(checking, resolve-type(checking, alias.scope, alias.target, []), "type {base-name(key)}", false);
        checking.expanding.pop();
        resolved
    }

    // the declarations the type sets open into
    

    // whether every value of a is one of b (types as sets: semtype.yel)
    subtype: func(checking: Checker, narrow: Type, wide: Type) -> bool {
        let symbols = checking.symbols;
        semtype.is-empty(symbols, semtype.diff(symbols, semtype.translate(symbols, narrow), semtype.translate(symbols, wide)))
    }

    // a type a literal or a union of them has left, for an operation on its values (1 | 2 + 1 is
    // an s32)
    widened: func(given: Type) -> Type {
        match resolve(given) {
            singleton(_) => representation(given),
            range-type(_) => representation(given),
            union-type(_) => representation(given),
            _ => given,
        }
    }

    // a literal where literals of a union are wanted: its own type, the one value (a member of the
    // union, or not: unify says)
    literal-singleton: func(expression: Expr, want: Type) -> option<Type> {
        let wanted = resolve(want);
        let wants = match wanted {
            union-type(_) => true,
            singleton(_) => true,
            range-type(_) => true,
            _ => false,
        };
        if !wants || !is-literal(expression) { return none; }
        // the union's kind the literal is written in
        let base = Type.unit-type;
        let fits = false;
        for kind in kinds(wanted) {
            if !fits && literal-fits(expression, kind) {
                base = kind;
                fits = true;
            }
        }
        if !fits { return none; }
        match expression.kind {
            unary(operation) => { operation.value.ty = base; }
            _ => {}
        }
        let key = semtype.literal-key(expression);
        let text = match expression.kind {
            str-lit(contents) => "\"{contents}\"",
            char-lit(character) => "'{from-byte(character)}'",
            _ => key,
        };
        some(Type.singleton({ base: base, key: key, text: text, }))
    }

    // whether a literal is written in kind k
    literal-fits: func(expression: Expr, given: Type) -> bool {
        match expression.kind {
            int-lit(_) => fits-kind(1, given),
            float-lit(_) => fits-kind(2, given),
            char-lit(_) => show-type(given) == "char",
            str-lit(_) => show-type(given) == "string",
            bool-lit(_) => show-type(given) == "bool",
            unary(operation) => {
                match operation.value.kind {
                    int-lit(_) => fits-kind(1, given),
                    float-lit(_) => fits-kind(2, given),
                    _ => false,
                }
            }
            _ => false,
        }
    }

    resolve-types: func(checking: Checker, sc: Scope, ts: list<Type>, tps: list<string>) -> list<Type> {
        let out: list<Type> = [];
        for item in ts { out.push(resolve-type(checking, sc, item, tps)); }
        out
    }

    // a func's name, called where the func being checked is: the module's own, its package's top
    // level, then the builtins' (a name they have more than one of is chosen by builtin-pick, from
    // the call's first argument); "" for none (a case, some, ok)
    func-key: func(checking: Checker, name: string) -> string {
        let own = own-key(checking, name);
        if own != "" { return own; }
        let here = builtins-here(checking, name);
        if here.len() == 1 { return here[0]; }
        ""
    }

    // the builtins named n that may be named where the func being checked is (a std module's
    // private func is std's own)
    builtins-here: func(checking: Checker, name: string) -> list<string> {
        match checking.builtins.get(name) {
            some(keys) => keys.filter({ key -> visible(checking, checking.scope, key) }),
            none => [],
        }
    }

    // whether a func's first parameter takes a call's first argument (as builtin-pick asks)
    takes-first: func(checking: Checker, key: string, args: list<Expr>) -> bool {
        let sig = checking.symbols.funcs[key];
        if sig.params.len() == 0 || args.len() == 0 { return false; }
        let resolved = resolve(widened(check(checking, args[0], fresh(checking), "the first argument of {base-name(key)}")));
        match resolved {
            var(variable) => { if variable.kind == 0 { return true; } }
            _ => {}
        }
        could-fit(sig.params[0], resolved)
    }

    // a func's name as the module's own or its package's top level's (lookup's); "" for neither
    own-key: func(checking: Checker, name: string) -> string { lookup(checking, checking.scope, name, "func") }

    // a builtin's key, under its name
    builtin: func(checking: Checker, key: string) {
        let name = base-name(key);
        if !checking.builtins.has(name) { checking.builtins.set(name, []); }
        checking.builtins[name].push(key);
    }

    // the one of the builtins named n whose first parameter takes the first argument's type (that
    // argument checked here, first: x.f(a) is f(x, a)); "" for no such name
    builtin-pick: func(checking: Checker, name: string, args: list<Expr>) -> string {
        let keys = builtins-here(checking, name);
        if keys.len() == 0 { return ""; }
        if args.len() == 0 {
            type-error(checking, "{name}: which one depends on its first argument, and it has none");
            return "";
        }
        let resolved = resolve(widened(check(checking, args[0], fresh(checking), "the first argument of {name}")));
        match resolved {
            var(variable) => {
                if variable.kind == 0 {
                    type-error(
                        checking,
                        "{name}: which one depends on its first argument's type, not known yet: annotate it",
                    );
                }
            }
            _ => {}
        }
        let fits: list<string> = [];
        for key in keys {
            let sig = checking.symbols.funcs[key];
            if sig.params.len() > 0 && could-fit(sig.params[0], resolved) { fits.push(key); }
        }
        if fits.len() == 1 { return fits[0]; }
        // more than one: the ones taking this type itself before any taking every type (T)
        let particular: list<string> = [];
        for key in fits {
            match checking.symbols.funcs[key].params[0] {
                param(_) => {}
                _ => particular.push(key),
            }
        }
        if particular.len() == 1 { return particular[0]; }
        // still more than one: the most particular, whose first parameter's type is one of every
        // other's (a set<K>, a map<K, ()>, before a map<K, V>)
        for key in particular {
            let narrowest = particular.all({ other -> other == key || could-fit(checking.symbols.funcs[other].params[0], checking.symbols.funcs[key].params[0]) });
            if narrowest { return key; }
        }
        let takes: list<string> = [];
        for key in keys {
            let sig = checking.symbols.funcs[key];
            if sig.params.len() > 0 { takes.push(show-type(sig.params[0])); }
        }
        if fits.len() == 0 {
            type-error(
                checking,
                "{name}: none takes this first argument ({show-type(resolved)}); one takes each of {takes.join(", ")}",
            );
        } else {
            type-error(
                checking,
                "{name}: more than one takes this first argument ({show-type(resolved)}): {takes.join(", ")}",
            );
        }
        ""
    }

    // whether a value of type t could be given where p (a parameter's, its type parameters any) is
    // wanted, settling nothing
    could-fit: func(p0: Type, t1: Type) -> bool {
        // readonly or not, the same kind of value
        let resolved = match resolve(t1) {
            readonly-type(wrapped) => resolve(wrapped),
            _ => resolve(t1),
        };
        let parameter = match p0 {
            readonly-type(wrapped) => wrapped,
            _ => p0,
        };
        match parameter {
            param(_) => { return true; }
            _ => {}
        }
        match resolved {
            var(variable) => { return variable.kind == 0 || fits-kind(variable.kind, parameter); }
            _ => {}
        }
        match parameter {
            fixed-list(left-fixed) => match resolved {
                fixed-list(right-fixed) => { if left-fixed.len != right-fixed.len && left-fixed.len >= 0 { return false; } }
                _ => {}
            },
            // shown as they are (a stream's, a future's and a seq's item fits as a list's does)
            func-type(_) => { return show-type(parameter) == show-type(resolved); }
            readonly-type(_) => { return show-type(parameter) == show-type(resolved); }
            _ => {}
        }
        match pair-parts(parameter, resolved, could-fit) {
            some(value) => value,
            none => show-type(parameter) == show-type(resolved),
        }
    }

    // an interpolation's value with a spec ("{x:>8}": the parser's ~format(x, spec)), else none
    format-call: func(part: Expr) -> option<Call> {
        match part.kind {
            call(call) => if call.name == "~format" { some(call) } else { none },
            _ => none,
        }
    }

    // a value with a spec in an interpolation: checked, and its spec one its type takes (a base or
    // zeros an integer's, a precision a float's)
    check-format: func(checking: Checker, part: Expr, call: Call) {
        let value-type = erase-distinct(resolve(check(checking, call.args[0], fresh(checking), "an interpolation")));
        part.ty = Type.string-type;
        call.args[1].ty = Type.string-type;
        let spec = match call.args[1].kind {
            str-lit(text) => text,
            _ => "",
        };
        // a number's kind (an integer or float literal's not settled yet: an s64's, an f64's)
        let number = match value-type {
            num(name) => name,
            var(variable) => if variable.kind == 1 { "s64" } else if variable.kind == 2 { "f64" } else { "" },
            _ => "",
        };
        let shown = show-type(value-type);
        match format-spec(spec) {
            some(format) => {
                let base = format.kind == "x" || format.kind == "X" || format.kind == "b" || format.kind == "o";
                if base && (number == "" || !is-int(number)) {
                    type-error(checking, "{format.kind} in a spec: expected an integer, found {shown}");
                }
                if format.precision >= 0 && (number == "" || is-int(number)) {
                    type-error(checking, ".{format.precision} in a spec: expected a float, found {shown}");
                }
                if format.zero && number == "" { type-error(checking, "0 in a spec: expected a number, found {shown}"); }
            }
            // the parser has told it
            none => {}
        }
    }

    // a generic func of yel's std
    std-generic: func(checking: Checker, key: string) -> bool {
        if !checking.symbols.funcs.has(key) { return false; }
        starts-with(key, "yel:std/") && checking.symbols.funcs[key].type-params.len() > 0
    }

    // the module a name is, where no local has that name ("" for none)
    module-ref: func(checking: Checker, expression: Expr) -> string {
        match expression.kind {
            name(name) => {
                if !is-none(local-type(checking, name)) { return ""; }
                let key = module-key(checking, checking.scope, name-text(name));
                // a module of the standard library's, by its name (set.add(s, x))
                if key == "" && checking.std-modules.has(name-text(name)) { return "yel:std/" + name-text(name); }
                key
            }
            _ => "",
        }
    }

    // the variant, flags or resource type an expression names (Type, or module.Type), as its key;
    // "" for none
    type-ref: func(checking: Checker, expression: Expr) -> string {
        match expression.kind {
            name(name) => {
                if !is-none(local-type(checking, name)) { return ""; }
                let key = type-key(checking, checking.scope, name-text(name));
                if has-members(checking, key) {
                    key
                } else {
                    ""
                }
            }
            field(field-access) => {
                let mk = module-ref(checking, field-access.target);
                if mk == "" { return ""; }
                let key = member(checking, mk, field-access.name, "type");
                if has-members(checking, key) {
                    key
                } else {
                    ""
                }
            }
            _ => "",
        }
    }

    // a name that is a func (no local has it) used as a value: its key ("" for none). Not a
    // generic func's (which instance?), nor an extern's (a C macro, or C types)
    func-value: func(checking: Checker, name: string) -> string {
        if !is-none(local-type(checking, intern(name))) { return ""; }
        // (a name checked again, its key already: an included package's, as a / says, which no
        // name written has)
        let key = if name.contains("/") && checking.symbols.funcs.has(name) { name } else { func-key(checking, name) };
        if key == "" { return ""; }
        if checking.symbols.funcs[key].type-params.len() > 0 {
            type-error(checking, "{name} is generic: a generic func is not a value yet");
        }
        if is-extern(checking, key) { type-error(checking, "{name} is an extern: an extern is not a value yet"); }
        if is-async-func(checking, key) {
            type-error(checking, "{name} is async: an async func is not a value yet");
        }
        key
    }

    func-sig-type: func(checking: Checker, key: string) -> Type {
        let sig = checking.symbols.funcs[key];
        Type.func-type({ params: sig.params, result: sig.result, })
    }

    // a call through a local holding a func
    call-value: func(checking: Checker, name: string, given: Type, args: list<Expr>) -> Type {
        let params: list<Type> = [];
        let result = fresh(checking);
        match resolve(given) {
            func-type(signature) => {
                params = signature.params;
                result = signature.result;
            }
            var(variable) => {
                if variable.kind != 0 {
                    type-error(checking, "{name} is not a func ({show-type(given)}): it cannot be called");
                }
                // a func not known yet: what the call gives it
                for argument in args { params.push(fresh(checking)); }
                unify(checking, given, Type.func-type({ params: params, result: result, }), "{name}");
            }
            _ => {
                type-error(checking, "{name} is not a func ({show-type(given)}): it cannot be called");
                result = Type.error-type;
            }
        }
        if args.len() != params.len() {
            type-error(checking, "{name} takes {params.len()} arguments, given {args.len()}");
        }
        // each argument checked (one past the params: against the error type, told already)
        for index in 0..args.len() {
            check(checking, args[index], if index < params.len() { params[index] } else { Type.error-type }, "argument {index + 1} of {name}");
        }
        checking.last-type-args = [];
        result
    }

    // get, set and len (the prelude's) on a fixed-length list: its item, set in place (a local's or
    // a record field's), its length; none for any other call (xs is checked either way)
    fixed-call: func(checking: Checker, function-name: string, args: list<Expr>) -> option<Type> {
        if !(function-name == "at" || function-name == "set" || function-name == "len") || own-key(checking, function-name) != ""
            || !checking.builtins.has(function-name) || args.len() == 0 { return none; }
        let lt = resolve(check(checking, args[0], fresh(checking), "a list"));
        let fixed = match lt {
            fixed-list(_) => true,
            _ => false,
        };
        if !fixed { return none; }
        let item = match lt {
            fixed-list(fixed) => fixed.item,
            _ => Type.unit-type,
        };
        let want = if function-name == "len" { 1 } else if function-name == "at" { 2 } else { 3 };
        if args.len() != want {
            type-error(checking, "{function-name} takes {want} arguments");
            return some(Type.error-type);
        }
        if function-name == "len" { return some(Type.num("s64")); }
        check(checking, args[1], Type.num("s64"), "an index");
        if function-name == "at" { return some(item); }
        match args[0].kind {
            name(_) => {}
            field(_) => {}
            _ => type-error(
                checking,
                "a fixed-length list's item is set in a variable or a field, where the list is",
            ),
        }
        check(checking, args[2], item, "the item set");
        some(Type.unit-type)
    }

    // whether name is declared first here (seen: those of its kind's namespace so far), else told
    once: func(checking: Checker, seen: map<string, bool>, kind: string, name: string, span: Span) -> bool {
        if seen.has(name) {
            checking.span = span;
            type-error(checking, "{kind} {base-name(name)} is declared twice");
            return false;
        }
        seen.set(name, true);
        true
    }

    // a func's symbol, with whether it is async, an extern, and a WIT interface's func
    add-sig: func(checking: Checker, name: string, sig: FuncSymbol, is-async: bool, is-extern: bool, wit-module: string) {
        checking.span = sig.span;
        // (declared again: told, the first kept)
        if checking.symbols.funcs.has(name) {
            type-error(checking, "func {name} is declared twice");
            return;
        }
        sig.is-async = is-async;
        sig.is-extern = is-extern;
        sig.wit-module = wit-module;
        checking.symbols.funcs.set(name, sig);
    }

    // a func's signature, its type parameters as such (a yel func's: async, extern, WIT set by
    // add-sig)
    signature: func(tps: list<string>, params: list<Type>, names: list<string>, defaults: list<option<Expr>>, result: Type, scope: Scope, span: Span) -> FuncSymbol {
        let ps: list<Type> = [];
        for parameter in params { ps.push(generalize(parameter, tps)); }
        {
            type-params: tps,
            params: ps,
            names: names,
            defaults: defaults,
            result: generalize(result, tps),
            is-async: false,
            is-extern: false,
            wit-module: "",
            scope: scope,
            span: span,
        }
    }

    // ================================================================ directives and defaults

    // a directive's value where it is written: #file, its file's path; #line and #column, its
    // place's; #func, the func it is in; #location, all of them (std's source-location);
    // #embed(path), a file's bytes (the path from the file's directory, or one yelc --embed names).
    // #caller-location and #caller-expression are a parameter's default's only: the call's
    directive-value: func(checking: Checker, expression: Expr, directive: Directive, want: Type) -> Type {
        let place = expression.span;
        if directive.name == "file" {
            expression.kind = ExprKind.str-lit(source-path(checking, place));
            return Type.string-type;
        }
        if directive.name == "line" || directive.name == "column" {
            expression.kind = ExprKind.int-lit("{if directive.name == "line" { place.line } else { place.col }}");
            return infer-kind(checking, expression, want);
        }
        if directive.name == "func" {
            expression.kind = ExprKind.str-lit(base-name(checking.in-func));
            return Type.string-type;
        }
        if directive.name == "location" {
            expression.kind = location-literal(checking, place);
            return check(checking, expression, location-type(checking), "#location");
        }
        if directive.name == "embed" {
            // (the file read as the sources were: diagnostics.read-embeds)
            let name = match directive.args.get(0) {
                some(given) => match given.kind {
                    str-lit(written) => written,
                    _ => "",
                },
                none => "",
            };
            if name == "" || directive.args.len() != 1 {
                type-error(checking, "#embed takes the file's path, a string written out: #embed(\"motd.txt\")");
                return Type.error-type;
            }
            let at = diagnostics.embed-path(checking.context, source-path(checking, place), name);
            match checking.context.embeds.get(at) {
                some(text) => { expression.kind = ExprKind.str-lit(text); }
                none => {
                    type-error(checking, "#embed: cannot read {at}");
                    return Type.error-type;
                }
            }
            return Type.string-type;
        }
        if directive.name == "caller-location" || directive.name == "caller-expression" {
            type-error(checking, "#{directive.name} is a parameter's default: the {if directive.name == "caller-location" { "place" } else { "text" }} of a call that leaves it out");
            return Type.error-type;
        }
        type-error(checking, "#{directive.name}: no such directive (#file, #line, #column, #func, #location, #embed(path); a parameter's default: #caller-location, #caller-expression(param))");
        Type.error-type
    }

    // std's source-location: a place, as #location and #caller-location give it
    location-type: func(checking: Checker) -> Type {
        let key = intern("yel:std/source-location");
        if !checking.symbols.records.has(key) { type-error(checking, "#location: the standard library declares no source-location"); }
        Type.named(key)
    }

    // { file, line, column, func } of a place, in the func being checked
    location-literal: func(checking: Checker, place: Span) -> ExprKind {
        let field = { name: string, kind: ExprKind ->
            let init: FieldInit = { name: name, value: node(kind, nowhere()), name-span: nowhere(), };
            init
        };
        ExprKind.record-lit([
            field("file", ExprKind.str-lit(source-path(checking, place))),
            field("line", ExprKind.int-lit("{place.line}")),
            field("column", ExprKind.int-lit("{place.col}")),
            field("func", ExprKind.str-lit(base-name(checking.in-func))),
        ])
    }

    // the path of the file a place is in, as it was read ("" for none)
    source-path: func(checking: Checker, place: Span) -> string {
        if place.source < 0 { "" } else { checking.context.sources[place.source].path }
    }

    // a call that leaves its last parameters out: each one's default given (none past the first
    // with no default: the call's count is told wrong). A default as written is its own copy (a
    // literal; #file, #line, #func: the callee's, where it is written), #caller-location the
    // call's place, #caller-expression(p) the text of the argument given for p
    given-defaults: func(checking: Checker, sig: FuncSymbol, args: list<Expr>, at: Span) {
        if args.len() >= sig.params.len() || sig.defaults.len() != sig.params.len() { return; }
        let given = args.len();
        for index in given..sig.params.len() {
            match sig.defaults[index] {
                some(default-value) => {
                    let kind = match default-value.kind {
                        directive(directive) => {
                            if directive.name == "caller-location" {
                                location-literal(checking, at)
                            } else if directive.name == "caller-expression" {
                                let named = if directive.args.len() == 1 { sig.names.index-of(expr-name(directive.args[0])) } else { -1 };
                                ExprKind.str-lit(if named >= 0 && named < given { diagnostics.span-text(checking.context, args[named].span) } else { "" })
                            } else {
                                ExprKind.directive({ name: directive.name, args: directive.args, })
                            }
                        }
                        // (a negative number its own copy: the unary and its literal)
                        unary(operation) => ExprKind.unary({ op: operation.op, value: node(operation.value.kind, operation.value.span), }),
                        let literal => literal,
                    };
                    args.push(node(kind, if is-caller-directive(default-value) { nowhere() } else { default-value.span }));
                }
                none => { return; }
            }
        }
    }

    // whether e is a number written out (1, 0.5)
    is-number-literal: func(expression: Expr) -> bool {
        match expression.kind {
            int-lit(_) => true,
            float-lit(_) => true,
            _ => false,
        }
    }

    // whether a default is the call's (#caller-location, #caller-expression)
    is-caller-directive: func(expression: Expr) -> bool {
        match expression.kind {
            directive(directive) => directive.name == "caller-location" || directive.name == "caller-expression",
            _ => false,
        }
    }

    // a func's defaults, each of its parameter's type: a literal, or a directive
    // (#caller-expression naming one of its parameters)
    check-defaults: func(checking: Checker, sig: FuncSymbol) {
        for index in 0..sig.defaults.len() {
            match sig.defaults[index] {
                some(default-value) => {
                    let what = "the default of {sig.names[index]}";
                    let copy = match default-value.kind {
                        int-lit(_) => some(node(default-value.kind, default-value.span)),
                        float-lit(_) => some(node(default-value.kind, default-value.span)),
                        char-lit(_) => some(node(default-value.kind, default-value.span)),
                        bool-lit(_) => some(node(default-value.kind, default-value.span)),
                        str-lit(_) => some(node(default-value.kind, default-value.span)),
                        // a negative number (-1, -0.5)
                        unary(operation) => if operation.op == "-" && is-number-literal(operation.value) {
                            some(node(ExprKind.unary({ op: "-", value: node(operation.value.kind, operation.value.span), }), default-value.span))
                        } else {
                            none
                        },
                        directive(directive) => {
                            // (checked where it is written: the location a call gives is a string)
                            if directive.name == "caller-location" {
                                some(node(location-literal(checking, default-value.span), default-value.span))
                            } else if directive.name == "caller-expression" {
                                if directive.args.len() != 1 || !sig.names.contains(expr-name(directive.args[0])) {
                                    checking.span = default-value.span;
                                    type-error(checking, "#caller-expression(p): p is one of {base-name(checking.in-func)}'s parameters, whose argument's text it is");
                                }
                                some(node(ExprKind.str-lit(""), nowhere()))
                            } else {
                                some(node(ExprKind.directive({ name: directive.name, args: directive.args, }), default-value.span))
                            }
                        }
                        _ => none,
                    };
                    match copy {
                        some(value) => { let _ = check(checking, value, sig.params[index], what); }
                        none => {
                            checking.span = default-value.span;
                            type-error(checking, "{what} is a literal or a # directive");
                        }
                    }
                }
                none => {}
            }
        }
    }

    // whether the func key names is async (an async func's, or a WIT async func's)
    is-async-func: func(checking: Checker, key: string) -> bool {
        match checking.symbols.funcs.get(key) {
            some(sig) => sig.is-async,
            none => false,
        }
    }

    // whether the func key names is an extern (no func value is made of one)
    is-extern: func(checking: Checker, key: string) -> bool {
        match checking.symbols.funcs.get(key) {
            some(sig) => sig.is-extern,
            none => false,
        }
    }

    // whether the func key names is a WIT interface's (a stream or a future given one is moved:
    // its end leaves the component)
    is-wit: func(checking: Checker, key: string) -> bool {
        match checking.symbols.funcs.get(key) {
            some(sig) => sig.wit-module != "",
            none => false,
        }
    }

    // a func's check begun: the checker's state set for it, and its parameters' defaults checked
    // (its signature's: checked whatever its body)
    begin-func: func(checking: Checker, function: Func) {
        checking.quiet = false;
        checking.in-func = function.name;
        checking.bindings = function.bindings;
        checking.scope = function.scope;
        checking.span = function.span;
        checking.type-params = function.type-params;
        check-defaults(checking, checking.symbols.funcs[function.name]);
    }

    // a func's body checked (begin-func's first)
    check-body: func(checking: Checker, function: Func) {
        let sig = checking.symbols.funcs[function.name];
        checking.scopes = [];
        checking.marks = [];
        checking.depths = [];
        checking.narrows = [];
        checking.in-async = function.is-async;
        checking.async-call = false;
        checking.assigned = map.new();
        assigned-in(function.body, checking.assigned);
        checking.closure-depth = 0;
        checking.unit = function.unit;
        push-scope(checking, function.body.span);
        if checking.noting { checking.context.bodies.push({ span: function.body.span, scope: function.scope, }); }
        for index in 0..function.params.len() { bind(checking, intern(function.params[index]), sig.params[index], function.marks[index]); }
        checking.result = sig.result;
        // a generator (its body yields): a seq<T> given back, its values T; its body's value none
        function.is-generator = yields-in(function.body);
        checking.yield-type = none;
        if function.is-generator {
            match resolve(sig.result) {
                seq-type(item) => { checking.yield-type = some(item); }
                _ => {
                    checking.span = function.span;
                    type-error(checking, "{base-name(function.name)} yields: it gives back a seq<T> (its values T)");
                    // its yields are a generator's all the same (not told again)
                    checking.yield-type = some(Type.error-type);
                }
            }
            if function.is-async { type-error(checking, "{base-name(function.name)} yields: a generator is not an async func"); }
            checking.result = Type.unit-type;
            check-block(checking, function.body, fresh(checking), false);
            return;
        }
        // a func with no result ignores its body's value
        match sig.result {
            unit-type => check-block(checking, function.body, fresh(checking), false),
            _ => check-block(checking, function.body, sig.result, true),
        };
    }

    // whether a block yields (not a closure's)
    yields-in: func(block: Block) -> bool {
        for expression in walk.exprs(block, false) {
            match expression.kind {
                yield-expr(_) => { return true; }
                _ => {}
            }
        }
        false
    }

    // a block's statements: its value's type (unit for none). keep: the value is used (else, as a
    // statement, its last if's or match's branches need not agree)
    check-block: func(checking: Checker, block: Block, want: Type, keep: bool) -> Type {
        push-scope(checking, block.span);
        let value = Type.unit-type;
        // the scopes an if that leaves narrows the rest of the block in
        let exits = 0;
        // a nested block's statements are its own: the one around it is back on its span after
        let saved = checking.span;
        for index in 0..block.stmts.len() {
            checking.span = block.spans[index];
            // each statement's errors its own: one told for each
            checking.quiet = false;
            match block.stmts[index] {
                let-stmt(let-statement) => {
                    let resolved = fresh(checking);
                    // (a let the compiler made, written nowhere: told where its value is)
                    if checking.span.source < 0 { checking.span = let-statement.value.span; }
                    match let-statement.ty {
                        some(ty) => {
                            resolved = known(
                                checking,
                                generalize(resolve-type(checking, checking.scope, ty, checking.type-params), checking.type-params),
                                if let-statement.mark.span.source < 0 { "a view's tag" } else { "the type of {let-statement.name}" },
                                true,
                            );
                        }
                        none => {}
                    }
                    let vt = check(checking, let-statement.value, resolved, "the value of {let-statement.name}");
                    // list<T, ?>: the value's length
                    bind(checking, intern(let-statement.name), if open-length(resolved) { vt } else { resolved }, let-statement.mark);
                }
                let-pattern(pattern-let) => {
                    let resolved = fresh(checking);
                    match pattern-let.ty {
                        some(ty) => {
                            resolved = known(
                                checking,
                                generalize(resolve-type(checking, checking.scope, ty, checking.type-params), checking.type-params),
                                "the type of a let's pattern",
                                false,
                            );
                        }
                        none => {}
                    }
                    let before = checking.context.errors.len();
                    check(checking, pattern-let.value, resolved, "a let's value");
                    let seen: map<string, bool> = map.new();
                    check-pattern(checking, pattern-let.pattern, resolved, seen, false);
                    // what the pattern covers, where its types are sound (no error in it)
                    if well-typed(checking, before) {
                        match uncovered(checking, [pattern-let.pattern,], resolved) {
                            some(value) => type-error(checking, "a let's pattern does not fit {value}: use a match"),
                            none => {}
                        }
                    }
                }
                return-stmt(value) => { check(checking, value, checking.result, "{checking.in-func}'s result"); }
                for-stmt(for-loop) => check-for(checking, for-loop),
                loop-stmt(loop-statement) => {
                    let outer = checking.unit;
                    checking.unit = loop-statement.unit;
                    checking.loops += 1;
                    check-block(checking, loop-statement.body, fresh(checking), false);
                    checking.loops -= 1;
                    checking.unit = outer;
                }
                assign(assignment) => {
                    match binding-of(checking, assignment.name) {
                        some(mark) => {
                            checking.bindings.assigns.set(assignment, mark);
                            if checking.noting { note-use(checking, assignment.name-span, "", some(mark)); }
                        }
                        none => {}
                    }
                    match local-type(checking, assignment.name) {
                        some(target) => check-assign(checking, target, assignment.op, assignment.value, name-text(assignment.name)),
                        none => {
                            // a global: named by its key from here on
                            let gk = global-key(checking, name-text(assignment.name));
                            if gk == "" {
                                // (a const's or a func's name: declared, but no place a value is set)
                                let text = name-text(assignment.name);
                                if const-key(checking, text) != "" {
                                    type-error(checking, "{text} is a const: only a local or a global is assigned");
                                } else if func-key(checking, text) != "" {
                                    type-error(checking, "{text} is a func: only a local or a global is assigned");
                                } else {
                                    not-found(checking, "{assignment.name} is not declared", text, names-here(checking));
                                }
                            } else {
                                let shown = assignment.name;
                                if checking.noting { note-use(checking, assignment.name-span, gk, none); }
                                assignment.name = intern(gk);
                                check-assign(checking, checking.symbols.globals[gk].ty, assignment.op, assignment.value, name-text(shown));
                            }
                        }
                    }
                }
                assign-field(field-assignment) => {
                    let rt = check(checking, field-assignment.target, fresh(checking), "a record");
                    // a value: a new one is made, not changed (no other name sees it change)
                    match resolve(rt) {
                        readonly-type(_) => type-error(
                            checking,
                            ".{field-assignment.name} of a {show-type(rt)}: a readonly value's fields are not assigned",
                        ),
                        anon-record(_) => type-error(
                            checking,
                            ".{field-assignment.name} of a {show-type(rt)}: an anonymous record is a value, its fields not assigned (make another)",
                        ),
                        // a record (a value): its field set where it is, a variable or a field
                        named(name) => {
                            if checking.symbols.records.has(name) && checking.symbols.records[name].value && !is-place(checking, field-assignment.target) {
                                type-error(checking, "a record's field is set in a variable or a field, where the record is (a record is a value: this one is a copy)");
                            }
                        }
                        _ => {}
                    }
                    let assigned = field-type(checking, rt, field-assignment.name);
                    if checking.noting {
                        if structural(rt) {
                            note-structural(checking, field-assignment.name-span, without-readonly(resolve(rt)), field-assignment.name, assigned);
                        } else {
                            note-use(checking, field-assignment.name-span, field-key(checking, rt, field-assignment.name), none);
                        }
                    }
                    check-assign(checking, assigned, field-assignment.op, field-assignment.value, ".{field-assignment.name}");
                }
                expr-stmt(statement) => {
                    if statement.is-value && keep { value = check(checking, statement.value, want, "the value"); }
                    else { discard(checking, statement.value); }
                    // if cond { return; }: what fails cond holds after it
                    match statement.value.kind {
                        if-else(ie) => {
                            if is-none-block(ie.otherwise) && leaves(ie.then) {
                                push-narrowing(checking, facts(checking, ie.cond).no);
                                exits += 1;
                            }
                        }
                        _ => {}
                    }
                }
                break-stmt => { if checking.loops == 0 { type-error(checking, "break outside a loop"); } }
                continue-stmt => { if checking.loops == 0 { type-error(checking, "continue outside a loop"); } }
            }
        }
        for step in 0..exits { pop-scope(checking); }
        pop-scope(checking);
        // a block that never gets to its end (a return, a break, a loop no break leaves) has no
        // value of its own: it is any
        if keep && !leaves(block) {
            if is-never(want) {
                type-error(checking, "a func whose result is never gets to its end: end it with a call that never returns (panic, exit)");
            } else {
                unify(checking, want, value, "the value");
            }
        }
        checking.span = saved;
        value
    }

    // whether a type leaves a list's length to its value (list<T, ?>)
    open-length: func(given: Type) -> bool {
        match given {
            fixed-list(fixed) => fixed.len < 0 || open-length(fixed.item),
            list-type(item) => open-length(item),
            option-type(inner) => open-length(inner),
            result-type(outcome) => open-length(outcome.ok) || open-length(outcome.err),
            tuple-type(xs) => {
                for item in xs { if open-length(item) { return true; } }
                false
            }
            anon-record(anonymous) => {
                for item in anonymous.types { if open-length(item) { return true; } }
                false
            }
            _ => false,
        }
    }

    check-assign: func(checking: Checker, given: Type, op: string, value: Expr, what: string) {
        if op == "=" {
            check(checking, value, given, "the value given {what}");
        } else {
            numeric(checking, given, "{op} on {what}");
            check(checking, value, given, "the right of {op}");
        }
    }

    // a for: its variable and body in the for's unit (an environment each turn, when a closure
    // captures one of its bindings)
    check-for: func(checking: Checker, for-loop: For) {
        let outer = checking.unit;
        push-scope(checking, for-loop.body.span);
        match for-loop.stop {
            none => {
                // a list, or a fixed-length one
                let item = fresh(checking);
                let lt = check(checking, for-loop.start, fresh(checking), "a for's list");
                // a readonly list's items: readonly (they are, settled)
                match resolve(lt) {
                    readonly-type(wrapped) => { lt = wrapped; }
                    _ => {}
                }
                match resolve(lt) {
                    fixed-list(fixed) => { item = fixed.item; }
                    // a generator's values, read as they come
                    seq-type(yielded) => { item = yielded; }
                    _ => unify(checking, Type.list-type(item), lt, "a for's list"),
                }
                checking.unit = for-loop.unit;
                bind(checking, intern(for-loop.name), item, for-loop.mark);
            }
            some(stop) => {
                // a range of any one integer type
                let resolved = fresh-kind(checking, 1);
                check(checking, for-loop.start, resolved, "a range's start");
                check(checking, stop, resolved, "a range's end");
                checking.unit = for-loop.unit;
                bind(checking, intern(for-loop.name), resolved, for-loop.mark);
            }
        }
        checking.loops += 1;
        check-block(checking, for-loop.body, fresh(checking), false);
        checking.loops -= 1;
        pop-scope(checking);
        checking.unit = outer;
    }

    // what a type is to as: "int", "float", "bool", "char", or "" (no conversion has it); an
    // unsettled literal's is its kind's
    cast-class: func(given: Type) -> string {
        match given {
            num(name) => if is-int(name) { "int" } else { "float" },
            bool-type => "bool",
            char-type => "char",
            var(variable) => if variable.kind == 1 { "int" } else if variable.kind == 2 { "float" } else { "" },
            _ => "",
        }
    }

    // x as T: from a number, a bool or a char to a number or a char, as the conversions' table has
    // them (an integer from any, a float from a number, a char from an integer); a literal takes
    // T's type (1 as s64 is an s64)
    infer-cast: func(checking: Checker, cast: Cast) -> Type {
        let target = generalize(resolve-type(checking, checking.scope, cast.ty, checking.type-params), checking.type-params);
        let source = resolve(widened(check(checking, cast.value, fresh(checking), "a value converted")));
        // into or out of a distinct type: between what each is held as (a value its base holds
        // already, as it is; else a number's conversion)
        let to-base = distinct-base(target);
        let from-base = distinct-base(source);
        if !(to-base == target) || !(from-base == source) {
            if unifies(to-base, from-base) || subtype(checking, from-base, to-base) {
                unify(checking, to-base, from-base, "a value converted");
                return target;
            }
            numeric-cast(checking, from-base, to-base);
            return target;
        }
        numeric-cast(checking, source, target)
    }

    // what a distinct type is held as (any other type: itself)
    distinct-base: func(given: Type) -> Type {
        match resolve(given) {
            distinct-type(distinct) => distinct.base,
            _ => given,
        }
    }

    // x as T between numbers, chars and bools (as the conversions' table has them)
    numeric-cast: func(checking: Checker, source: Type, target: Type) -> Type {
        let from = cast-class(source);
        let to = match target {
            var(_) => "",
            _ => cast-class(target),
        };
        if to == "" || to == "bool" {
            type-error(checking, "as gives a number or a char, not {show-type(target)}");
        }
        if from == "" {
            type-error(checking, "as converts a number, a bool or a char, not {show-type(source)}");
        }
        match source {
            var(variable) => {
                if variable.kind == 1 && to == "int" || variable.kind == 2 && to == "float" {
                    unify(checking, target, source, "a literal converted");
                    return target;
                }
            }
            _ => {}
        }
        let ok = to == "int" || to == "float" && (from == "int" || from == "float") || to == "char"
            && from == "int";
        if !ok {
            type-error(
                checking,
                "{show-type(source)} as {show-type(target)}: as gives a char only from an integer, and a float only from a number",
            );
        }
        target
    }

    // a closure literal: its params' types (written, or the wanted func's), its body checked a
    // closure deeper (its return and its loops its own)
    infer-closure: func(checking: Checker, cl: Closure, want: Type) -> Type {
        let count = cl.params.len();
        let wanted: list<Type> = [];
        let result = fresh(checking);
        match resolve(want) {
            func-type(signature) => {
                if signature.params.len() == count {
                    wanted = signature.params;
                    result = signature.result;
                }
            }
            _ => {}
        }
        let params: list<Type> = [];
        for index in 0..count {
            let parameter-type = match cl.types[index] {
                some(declared) => generalize(resolve-type(checking, checking.scope, declared, checking.type-params), checking.type-params),
                none => if wanted.len() == count { wanted[index] } else { fresh(checking) },
            };
            if wanted.len() == count {
                unify(checking, wanted[index], parameter-type, "parameter {cl.params[index]} of a closure");
            }
            params.push(parameter-type);
        }
        let saved-result = checking.result;
        let saved-yield = checking.yield-type;
        checking.yield-type = none;
        let saved-loops = checking.loops;
        let saved-unit = checking.unit;
        // a closure's body waits for nothing (an async closure is not there yet)
        let saved-async = checking.in-async;
        checking.in-async = false;
        checking.closure-depth += 1;
        checking.unit = cl.unit;
        push-scope(checking, cl.body.span);
        for index in 0..count { bind(checking, intern(cl.params[index]), params[index], cl.marks[index]); }
        checking.result = result;
        checking.loops = 0;
        // a closure whose result is unit (a handler) ignores its body's value
        match resolve(result) {
            unit-type => { check-block(checking, cl.body, fresh(checking), false); }
            _ => { check-block(checking, cl.body, result, true); }
        }
        pop-scope(checking);
        checking.closure-depth -= 1;
        checking.in-async = saved-async;
        checking.unit = saved-unit;
        checking.result = saved-result;
        checking.yield-type = saved-yield;
        checking.loops = saved-loops;
        Type.func-type({ params: params, result: result, })
    }

    // an expression whose value is not used: an if's or a match's branches need not agree
    discard: func(checking: Checker, expression: Expr) {
        match expression.kind {
            if-else(branch) => {
                check(checking, branch.cond, Type.bool-type, "an if's condition");
                let branch-facts = facts(checking, branch.cond);
                push-narrowing(checking, branch-facts.yes);
                check-block(checking, branch.then, fresh(checking), false);
                pop-scope(checking);
                push-narrowing(checking, branch-facts.no);
                match branch.otherwise {
                    some(otherwise) => check-block(checking, otherwise, fresh(checking), false),
                    none => Type.unit-type,
                };
                pop-scope(checking);
            }
            match-expr(matching) => infer-match(checking, matching, fresh(checking), false),
            block(block) => check-block(checking, block, fresh(checking), false),
            _ => check(checking, expression, fresh(checking), "a statement"),
        };
    }

    // an expression's type, which must be want's (what says where, for an error)
    check: func(checking: Checker, expression: Expr, want: Type, what: string) -> Type {
        // an error in e is at e: the innermost expression checked
        let saved = checking.span;
        checking.span = expression.span;
        let resolved = infer(checking, expression, want);
        // a type still to be found (a closure's result, an inferred let's) takes a narrowed local's
        // base type, not the one value a test left it (as a literal's: let s = "get" is a string);
        // a local declared of one value (type only = "post") keeps it
        match resolve(want) {
            var(variable) => {
                if variable.kind == 0 && narrowed-to-one(checking, expression, resolved) { resolved = representation(resolved); }
            }
            _ => {}
        }
        expression.ty = resolved;
        if !unifies(want, resolved) {
            if freezes(want, resolved) && (value-local(checking, expression) != "" || value-source(expression) != "") {
                // a value where readonly is wanted: no other name may write it (effects.yel checks
                // it is made here or by a func that makes it, and not used after)
                checking.sites.push({
                    file: checking.scope.file,
                    span: expression.span,
                    in-func: checking.in-func,
                    kind: "freeze",
                    callee: "",
                    index: -1,
                    local: value-local(checking, expression),
                    binding: value-binding(checking, expression),
                    source: value-source(expression),
                    started: false,
                    result-readonly: false,
                    items-readonly: false,
                });
                resolved = want;
            } else {
                // a subset of want's values (else an error), held as want's when it holds them
                // another way
                unify(checking, want, resolved, what);
                if widen-to(expression, resolved, want) { resolved = want; }
            }
        }
        checking.span = saved;
        resolved
    }

    // a call's argument against its parameter. Readonly or not may differ, as the func's effects
    // allow (checked once every func's are known: a readonly value given a parameter the func never
    // writes or keeps; a value given a readonly parameter the func never keeps or gives back)
    check-arg: func(checking: Checker, callee: string, index: s64, arg: Expr, param: Type) {
        // whether it is a start's call (read before the argument's own calls clear it)
        let started = checking.starting;
        checking.starting = false;
        let what = if widget-attribute(base-name(callee), "-as-") != "" {
            "attribute {widget-attribute(base-name(callee), "-as-")}"
        } else if widget-attribute(base-name(callee), "-value-") != "" {
            "attribute {widget-attribute(base-name(callee), "-value-")}"
        } else if widget-attribute(base-name(callee), "-set-") != "" {
            "attribute {widget-attribute(base-name(callee), "-set-")}"
        } else if base-name(callee).starts-with(PROP-AS) {
            "prop {prop-name(base-name(callee).substring(PROP-AS.len(), base-name(callee).len()))}"
        } else if base-name(callee).starts-with(PROP-SETTER) {
            "prop {prop-name(base-name(callee).substring(PROP-SETTER.len(), base-name(callee).len()))}"
        } else {
            "argument {index + 1} of {callee}"
        };
        let saved = checking.span;
        checking.span = arg.span;
        // a readonly parameter is the call's (what it is lent, it reads: a borrow, checked below
        // for each value the argument may be), not a type the argument is made readonly to: a
        // block's or an if's value is lent as a name is
        let resolved = infer(checking, arg, if is-readonly(param) { without-readonly(param) } else { param });
        arg.ty = resolved;
        if !unifies(param, resolved) {
            let given-readonly = is-readonly(resolved) && !is-readonly(param);
            let wanted-readonly = is-readonly(param) && !is-readonly(resolved);
            let relaxed = false;
            if given-readonly {
                // what it reads stays readonly (a list's items are T: T is them, readonly)
                relaxed = unifies(top-type(param), top-type(resolved));
            } else if wanted-readonly {
                relaxed = unifies(without-readonly(param), without-readonly(resolved));
            }
            // an extern's readonly parameter only says it reads it (its result's type follows the
            // argument's: nothing readonly of a value given it comes back), and so does a generic
            // std func's (list.get over memory.yel's intrinsics, as the extern it replaced)
            if relaxed && wanted-readonly && (is-extern(checking, callee) || std-generic(checking, callee)) {
                checking.span = saved;
                return;
            }
            if relaxed {
                // each value it may be (a block's, each branch's): a literal is new, a name and a
                // call's result checked as they are
                for leaf in if given-readonly { [arg,] } else { value-leaves(arg) } {
                    if !given-readonly && is-literal-value(leaf) { continue; }
                    checking.sites.push({
                        file: checking.scope.file,
                        span: leaf.span,
                        in-func: checking.in-func,
                        kind: if given-readonly { "read" } else { "borrow" },
                        callee: callee,
                        index: index,
                        local: value-local(checking, leaf),
                        binding: value-binding(checking, leaf),
                        source: value-source(leaf),
                        started: started,
                        result-readonly: false,
                        items-readonly: false,
                    });
                }
            } else if arg.span.line == 0 {
                // (a #caller-location a call left out: its type is told where the default is
                // written, not at each call)
            } else {
                unify(checking, param, resolved, what);
                widen-to(arg, resolved, param);
            }
        }
        checking.span = saved;
    }

    // a local holding a stream or a future given a WIT func: moved (its end leaves the component),
    // so not used after (effects.yel checks it once every func is read)
    note-move: func(checking: Checker, callee: string, index: s64, arg: Expr) {
        let local = value-local(checking, arg);
        let seen: map<string, bool> = map.new();
        if local == "" || !holds-handles(checking, arg.ty, seen) { return; }
        checking.sites.push({
            file: checking.scope.file,
            span: arg.span,
            in-func: checking.in-func,
            kind: "move",
            callee: callee,
            index: index,
            local: local,
            binding: binding-of(checking, intern(local)),
            source: "",
            started: false,
            result-readonly: false,
            items-readonly: false,
        });
    }

    // a local given one argument readonly and another that may write it (or a closure that may):
    // the readonly name would see it change during the call
    same-value-twice: func(checking: Checker, callee: string, args: list<Expr>, params: list<Type>) {
        for index in 0..args.len() {
            let local = value-local(checking, args[index]);
            if local != "" && is-readonly(params[index]) {
                for other in 0..args.len() {
                    if other != index && !is-readonly(params[other]) && !effects.settled-immutable(params[other])
                        && walk.mentions(args[other], local) {
                        let saved = checking.span;
                        checking.span = args[other].span;
                        type-error-help(
                            checking,
                            "{local} is given argument {index + 1} of {base-name(callee)} readonly, and argument {other + 1} may write it",
                            "",
                            "the readonly argument would see it change during the call: give one of them a copy",
                        );
                        checking.span = saved;
                    }
                }
            }
        }
    }

    // whether a value of type t is where t & readonly is wanted (the same type, readonly)
    freezes: func(want: Type, given: Type) -> bool {
        is-readonly(want) && !is-readonly(given) && unifies(without-readonly(want), without-readonly(given))
    }

    // the local a value is ("" for another value)
    value-local: func(checking: Checker, expression: Expr) -> string {
        match expression.kind {
            name(name) => if is-none(local-type(checking, name)) { "" } else { name-text(name) },
            _ => "",
        }
    }

    // whether e is a local a test narrowed to one value (its type one value; its binding's not)
    narrowed-to-one: func(checking: Checker, expression: Expr, given: Type) -> bool {
        let one = match resolve(given) {
            singleton(_) => true,
            _ => false,
        };
        if !one { return false; }
        match expression.kind {
            name(name) => match binding-of(checking, name) {
                some(mark) => match resolve(mark.ty) {
                    singleton(_) => false,
                    _ => true,
                },
                none => false,
            },
            _ => false,
        }
    }

    // the values an expression may be: a block's last, each branch's of an if, each arm's of a
    // match (through them), else itself
    value-leaves: func(expression: Expr) -> list<Expr> {
        match expression.kind {
            block(block) => block-leaves(block),
            if-else(branch) => {
                let out = block-leaves(branch.then);
                match branch.otherwise {
                    some(else-block) => { for leaf in block-leaves(else-block) { out.push(leaf); } }
                    none => {}
                }
                out
            }
            match-expr(matching) => {
                let out: list<Expr> = [];
                for arm in matching.arms {
                    for leaf in value-leaves(arm.body) { out.push(leaf); }
                }
                out
            }
            _ => [expression,],
        }
    }

    block-leaves: func(block: Block) -> list<Expr> {
        if block.stmts.len() == 0 { return []; }
        match block.stmts[block.stmts.len() - 1] {
            expr-stmt(statement) => if statement.is-value { value-leaves(statement.value) } else { [] },
            _ => [],
        }
    }

    // a literal made here (a list's, a record's, a tuple's, a map's): no other name has it
    is-literal-value: func(expression: Expr) -> bool {
        match expression.kind {
            list-lit(_) => true,
            record-lit(_) => true,
            tuple-lit(_) => true,
            str-lit(_) => true,
            int-lit(_) => true,
            float-lit(_) => true,
            bool-lit(_) => true,
            char-lit(_) => true,
            _ => false,
        }
    }

    // the binding of a local a value is (none for another value)
    value-binding: func(checking: Checker, expression: Expr) -> option<Mark> {
        if value-local(checking, expression) == "" { return none; }
        match expression.kind {
            name(name) => binding-of(checking, name),
            _ => none,
        }
    }

    // the func (by key) whose result a value is ("" for another value)
    value-source: func(expression: Expr) -> string {
        match expression.kind {
            call(called) => called.name,
            method(method-call) => method-call.name,
            _ => "",
        }
    }

    // a type, readonly or not at its top: what it is
    top-type: func(given: Type) -> Type {
        match resolve(given) {
            readonly-type(wrapped) => wrapped,
            _ => given,
        }
    }

    // e against want, its type kept as its own (a pattern's literal: compared as its kind, never
    // converted)
    check-unwidened: func(checking: Checker, expression: Expr, want: Type, what: string) -> Type {
        let saved = checking.span;
        checking.span = expression.span;
        let resolved = infer(checking, expression, want);
        expression.ty = resolved;
        unify(checking, want, resolved, what);
        checking.span = saved;
        resolved
    }

    // e, of type from, where to is wanted: a conversion when to holds its values another way (an
    // s32 where s32 | string is); whether it made one
    widen-to: func(expression: Expr, from: Type, to: Type) -> bool {
        if show-type(represented(from)) == show-type(represented(to)) { return false; }
        let inner: Expr = { kind: expression.kind, span: expression.span, ty: from, };
        expression.kind = ExprKind.widen({ value: inner, ty: to, });
        expression.ty = to;
        true
    }

    // e's type, where want is what is wanted of it (every expression's way in: a literal is
    // noted here, read before infer-kind lowers it, an interpolation into the calls making its text)
    infer: func(checking: Checker, expression: Expr, want: Type) -> Type {
        if !checking.noting { return infer-kind(checking, expression, want); }
        let literal = literal-of(expression);
        let resolved = infer-kind(checking, expression, want);
        note-literal(checking, expression.span, literal, resolved);
        resolved
    }

    infer-kind: func(checking: Checker, expression: Expr, want: Type) -> Type {
        // a literal where a union of literals is wanted: its one value
        match literal-singleton(expression, want) {
            some(found) => { return found; }
            none => {}
        }
        match expression.kind {
            // a literal takes the number type its context wants
            int-lit(_) => {
                let wanted = resolve(want);
                if fits-kind(1, wanted) { return wanted; }
                fresh-kind(checking, 1)
            }
            float-lit(_) => {
                let wanted = resolve(want);
                if fits-kind(2, wanted) { return wanted; }
                fresh-kind(checking, 2)
            }
            char-lit(_) => Type.char-type,
            tuple-lit(items) => {
                let types: list<Type> = [];
                match resolve(want) {
                    tuple-type(xs) => { if xs.len() == items.len() { types = xs; } }
                    _ => {}
                }
                let out: list<Type> = [];
                for index in 0..items.len() {
                    let item-type = if types.len() > 0 { types[index] } else { fresh(checking) };
                    out.push(check(checking, items[index], item-type, "item {index} of a tuple"));
                }
                Type.tuple-type(out)
            }
            bool-lit(_) => Type.bool-type,
            str-lit(_) => Type.string-type,
            directive(directive) => directive-value(checking, expression, directive, want),
            unit => Type.unit-type,
            interp(parts) => {
                for part in parts {
                    match format-call(part) {
                        some(call) => check-format(checking, part, call),
                        none => { check(checking, part, fresh(checking), "an interpolation"); }
                    }
                }
                Type.string-type
            }
            list-lit(items) => {
                let item = fresh(checking);
                match resolve(want) {
                    // a new list, so no other name writes it: readonly where that is wanted (its
                    // items readonly too)
                    readonly-type(rx) => {
                        match resolve(rx) {
                            list-type(item-type) => {
                                for element in items { check(checking, element, item-type, "a list's item"); }
                                return want;
                            }
                            _ => {}
                        }
                    }
                    list-type(item-type) => { item = item-type; }
                    // a fixed-length list where one is wanted: that many items
                    fixed-list(fixed) => {
                        if fixed.len >= 0 && items.len() != fixed.len {
                            type-error(
                                checking,
                                "a list<{show-type(fixed.item)}, {fixed.len}> of {items.len()} items",
                            );
                        }
                        for element in items { check(checking, element, fixed.item, "a list's item"); }
                        return Type.fixed-list({ item: fixed.item, len: items.len(), });
                    }
                    _ => {}
                }
                for element in items { check(checking, element, item, "a list's item"); }
                Type.list-type(item)
            }
            name(name) => {
                // a func as a value: named by its key from here on (the package's own constant or
                // global hides a builtin of its name, as a local does: the prelude's free, say)
                let text = name-text(name);
                let hides-builtin = is-none(local-type(checking, name)) && own-key(checking, text) == ""
                    && (const-key(checking, text) != "" || global-key(checking, text) != "");
                let fk = if hides-builtin { "" } else { func-value(checking, text) };
                if fk != "" {
                    if checking.noting { note-use(checking, expression.span, fk, none); }
                    expression.kind = ExprKind.name(intern(fk));
                    return func-sig-type(checking, fk);
                }
                // a constant: its literal, of its type
                if is-none(local-type(checking, name)) {
                    let ck = const-key(checking, name-text(name));
                    if ck != "" {
                        if checking.noting { note-use(checking, expression.span, ck, none); }
                        let copy = const-copy(checking, ck, expression.span);
                        expression.kind = copy.kind;
                        match checking.symbols.consts[ck].ty {
                            some(declared) => { return check(checking, expression, declared, "the constant {name}"); }
                            none => { return infer(checking, expression, want); }
                        }
                    }
                }
                // a global (no local hides it): named by its key from here on (and one named so
                // already, checked again: a method's target is, as each func that may take it is
                // tried; a module's global's key, or an included package's: a dot or a / in it, which
                // no local's name can have)
                let keyed = find-byte(name-text(name), 46) != none || find-byte(name-text(name), 47) != none;
                if keyed && checking.symbols.globals.has(name-text(name)) {
                    if checking.noting { note-use(checking, expression.span, name-text(name), none); }
                    return checking.symbols.globals[name-text(name)].ty;
                }
                if is-none(local-type(checking, name)) {
                    let gk = global-key(checking, name-text(name));
                    if gk != "" {
                        if checking.noting { note-use(checking, expression.span, gk, none); }
                        expression.kind = ExprKind.name(intern(gk));
                        return checking.symbols.globals[gk].ty;
                    }
                }
                // a local: which binding it is
                match binding-of(checking, name) {
                    some(mark) => {
                        checking.bindings.exprs.set(expression, mark);
                        if checking.noting { note-use(checking, expression.span, "", some(mark)); }
                    }
                    none => {}
                }
                infer-name(checking, name-text(name), want, expression.span)
            }
            call(called) => {
                // (a wait's and a start's: this call's, not an argument's a builtin's pick checks:
                // wait read(made()) waits for read, made() a call of its own; given back to the
                // call this is, before it)
                let waited = checking.async-call;
                let starting = checking.starting;
                checking.async-call = false;
                checking.starting = false;
                let own-call = { -> checking.async-call = waited; checking.starting = starting; };
                // a local holding a func: called through it, as any func value (its name read as
                // where it is: a narrowed one's value of that kind)
                match local-type(checking, intern(called.name)) {
                    some(found) => {
                        expression.kind = ExprKind.apply({
                            callee: { kind: ExprKind.name(intern(called.name)), span: expression.span, ty: found, },
                            args: called.args,
                        });
                        own-call();
                        return infer(checking, expression, want);
                    }
                    none => {}
                }
                // a fixed-length list's at, set or len, as made by a check before this one (an
                // expression a literal's parts are checked twice for): the same again
                if starts-with(called.name, "~") {
                    match fixed-call(checking, called.name.substring(1, called.name.len()), called.args) {
                        some(found) => { return found; }
                        none => {}
                    }
                }
                match fixed-call(checking, called.name, called.args) {
                    some(found) => {
                        called.name = "~" + called.name;
                        return found;
                    }
                    none => {}
                }
                let key = func-key(checking, called.name);
                // (a name already its func's key, as module.f(a) is made: another package's too,
                // which no name here resolves to)
                if key == "" && checking.symbols.funcs.has(called.name) { key = called.name; }
                if key == "" { key = builtin-pick(checking, called.name, called.args); }
                if key != "" {
                    if checking.noting && checking.symbols.funcs.has(key) { note-use(checking, called.name-span, key, none); }
                    called.name = key;
                }
                let given = called.args.len();
                own-call();
                let resolved = infer-call(checking, called.name, called.args, want, called.name-span);
                called.type-args = checking.last-type-args;
                // a case given () carries nothing: its bare name
                if given == 1 && called.args.len() == 0 { expression.kind = ExprKind.name(intern(called.name)); }
                resolved
            }
            method(method-call) => {
                // (a wait's and a start's: this call's, not its target's: wait root().stat() waits
                // for stat, root() a call of its own; given back to the call this is, before it)
                let waited = checking.async-call;
                let starting = checking.starting;
                checking.async-call = false;
                checking.starting = false;
                let own-call = { -> checking.async-call = waited; checking.starting = starting; };
                // Type.case(payload), module.Type.case(payload): the type named by its key from
                // here on
                let tk = type-ref(checking, method-call.target);
                if checking.noting && tk != "" { note-type-target(checking, method-call.target, tk); }
                if checking.noting {
                    let mk-site = if tk == "" { module-ref(checking, method-call.target) } else { "" };
                    if tk != "" || mk-site != "" {
                        checking.context.members.push({ span: method-call.name-span, ty: Type.unit-type, module: mk-site, type-key: tk, });
                    }
                }
                if tk != "" && checking.symbols.resources.has(intern(tk)) {
                    // Resource.f(a): the resource's constructor (new) or a static func
                    let key = tk + "." + method-call.name;
                    if !checking.symbols.funcs.has(key) {
                        wit-not-found(checking, "resource {base-name(tk)} has no func {method-call.name}", method-call.name, tk);
                        return Type.error-type;
                    }
                    expression.kind = ExprKind.call({ name: key, args: method-call.args, type-args: [], name-span: method-call.name-span, });
                    own-call();
                    return infer(checking, expression, want);
                }
                if tk != "" {
                    method-call.target.kind = ExprKind.name(intern(tk));
                    let given = method-call.args.len();
                    let resolved = infer-case(checking, tk, method-call.name, method-call.args, method-call.name-span, want);
                    // Type.case(()) of a case carrying nothing: Type.case
                    if given == 1 && method-call.args.len() == 0 {
                        expression.kind = ExprKind.field({ target: method-call.target, name: method-call.name, name-span: method-call.name-span, });
                    }
                    return resolved;
                }
                // module.f(a): a call of the module's func
                let mk = module-ref(checking, method-call.target);
                if mk != "" {
                    if checking.noting { note-use(checking, method-call.target.span, mk, none); }
                    let key = member(checking, mk, method-call.name, "func");
                    if key == "" {
                        if method-call.name.starts-with(PROP-SETTER) || method-call.name.starts-with(PROP-AS) {
                            no-prop(checking, expr-name(method-call.target), method-call.name, mk);
                        } else {
                            wit-not-found(checking, "module {expr-name(method-call.target)} has no func {method-call.name}", method-call.name, mk);
                        }
                        return Type.error-type;
                    }
                    expression.kind = ExprKind.call({ name: key, args: method-call.args, type-args: [], name-span: method-call.name-span, });
                    own-call();
                    return infer(checking, expression, want);
                }
                // the call's arguments, its target first
                let args: list<Expr> = [method-call.target,];
                for argument in method-call.args { args.push(argument); }
                // xs.len() of a fixed-length list
                match fixed-call(checking, method-call.name, args) {
                    some(found) => {
                        expression.kind = ExprKind.call({ name: "~" + method-call.name, args: args, type-args: [], name-span: method-call.name-span, });
                        return found;
                    }
                    none => {}
                }
                // x.f(a) on a resource's handle: its method
                if checking.methods.has(method-call.name) {
                    match resolve(check(checking, method-call.target, fresh(checking), "a method's target")) {
                        named(name) => {
                            if checking.symbols.resources.has(name) && checking.symbols.funcs.has(name-text(name) + "." + method-call.name) {
                                expression.kind = ExprKind.call({
                                    name: name-text(name) + "." + method-call.name,
                                    args: args,
                                    type-args: [],
                                    name-span: method-call.name-span,
                                });
                    own-call();
                    return infer(checking, expression, want);
                            }
                        }
                        _ => {}
                    }
                }
                // x.f(a): the f of the module x's type is declared in, where it takes x first (a
                // module's funcs on its own types are their methods wherever they go: b.component(…)
                // of std:build's builder)
                let typed = type-module-key(checking, method-call.target, method-call.name, args);
                if typed != "" {
                    if checking.noting { note-use(checking, method-call.name-span, typed, none); }
                    expression.kind = ExprKind.call({ name: typed, args: args, type-args: [], name-span: method-call.name-span, });
                    own-call();
                    return infer(checking, expression, want);
                }
                // x.f(a): the module's own f (or its package's) where its first parameter takes x,
                // else the one of the builtins named f that does (a set's add in a module with an
                // add of its own is the set's)
                let key = own-key(checking, method-call.name);
                if key == "" { key = func-key(checking, method-call.name); }
                else if !takes-first(checking, key, args) && checking.builtins.has(method-call.name) {
                    key = builtin-pick(checking, method-call.name, args);
                }
                if key == "" { key = builtin-pick(checking, method-call.name, args); }
                if key != "" {
                    if checking.noting && checking.symbols.funcs.has(key) { note-use(checking, method-call.name-span, key, none); }
                    method-call.name = key;
                }
                else {
                    // no func of that name: a resource's method yel has not
                    match resolve(check(checking, method-call.target, fresh(checking), "a method's target")) {
                        named(name) => {
                            if checking.symbols.resources.has(name) {
                                wit-not-found(checking, "resource {base-name(name-text(name))} has no method {method-call.name}", method-call.name, name-text(name));
                            }
                        }
                        _ => {}
                    }
                }
                own-call();
                let resolved = infer-call(checking, method-call.name, args, want, method-call.name-span);
                // (the defaults given its parameters left out: the method's arguments, as the
                // call's are)
                for index in method-call.args.len() + 1..args.len() { method-call.args.push(args[index]); }
                if checking.noting { checking.context.members.push({ span: method-call.name-span, ty: method-call.target.ty, module: "", type-key: "", }); }
                method-call.type-args = checking.last-type-args;
                resolved
            }
            field(field-access) => {
                let tk = type-ref(checking, field-access.target);
                if checking.noting && tk != "" { note-type-target(checking, field-access.target, tk); }
                let fmk-site = if tk == "" { module-ref(checking, field-access.target) } else { "" };
                if checking.noting && (tk != "" || fmk-site != "") {
                    checking.context.members.push({ span: field-access.name-span, ty: Type.unit-type, module: fmk-site, type-key: tk, });
                }
                // x. with no name yet (told by the parser): what is before the dot noted, no more
                if field-access.name == "" {
                    if tk == "" && fmk-site == "" {
                        let before = check(checking, field-access.target, fresh(checking), "a value");
                        if checking.noting { checking.context.members.push({ span: field-access.name-span, ty: before, module: "", type-key: "", }); }
                    }
                    return Type.error-type;
                }
                if tk != "" && checking.symbols.resources.has(intern(tk)) {
                    type-error(
                        checking,
                        "{expr-name(field-access.target)}.{field-access.name}: a resource's func is called: {expr-name(field-access.target)}.{field-access.name}(...)",
                    );
                    return Type.error-type;
                }
                if tk != "" {
                    field-access.target.kind = ExprKind.name(intern(tk));
                    return infer-case(checking, tk, field-access.name, [], field-access.name-span, want);
                }
                // module.f as a value
                let fmk = module-ref(checking, field-access.target);
                if checking.noting && fmk != "" { note-use(checking, field-access.target.span, fmk, none); }
                let fk = if fmk == "" { "" } else { member(checking, fmk, field-access.name, "func") };
                if fk != "" {
                    if checking.symbols.funcs[fk].type-params.len() > 0 {
                        type-error(checking, "{fk} is generic: a generic func is not a value yet");
                    }
                    expression.kind = ExprKind.name(intern(fk));
                    return func-sig-type(checking, fk);
                }
                // module.NAME, a module's constant: its literal, of its type
                let ck = if fmk == "" { "" } else { member(checking, fmk, field-access.name, "const") };
                if ck != "" {
                    let copy = const-copy(checking, ck, expression.span);
                    expression.kind = copy.kind;
                    match checking.symbols.consts[ck].ty {
                        some(found) => { return check(checking, expression, found, "the constant {expr-name(field-access.target)}.{field-access.name}"); }
                        none => { return infer(checking, expression, want); }
                    }
                }
                if module-ref(checking, field-access.target) != "" {
                    type-error(
                        checking,
                        "{expr-name(field-access.target)}.{field-access.name}: module {expr-name(field-access.target)} has no constant {field-access.name} (a module's func is called, and its types are named in types)",
                    );
                    return Type.error-type;
                }
                let resolved = check(checking, field-access.target, fresh(checking), "a record");
                if checking.noting { checking.context.members.push({ span: field-access.name-span, ty: resolved, module: "", type-key: "", }); }
                let found = field-type(checking, resolved, field-access.name);
                if checking.noting {
                    if structural(resolved) {
                        note-structural(checking, field-access.name-span, without-readonly(resolve(resolved)), field-access.name, found);
                    } else {
                        note-use(checking, field-access.name-span, field-key(checking, resolved, field-access.name), none);
                    }
                }
                found
            }
            binary(binary) => infer-binary(checking, binary),
            unary(operation) => {
                if operation.op == "-" {
                    // a number type wanted is the operand's too; another (a union holding numbers)
                    // is the result's to fit
                    let operand-want = match resolve(want) {
                        num(_) => want,
                        var(_) => want,
                        _ => fresh(checking),
                    };
                    let resolved = check(checking, operation.value, operand-want, "the operand of -");
                    numeric(checking, resolved, "-");
                    return resolved;
                }
                check(checking, operation.value, Type.bool-type, "the operand of !");
                Type.bool-type
            }
            if-else(branch) => {
                check(checking, branch.cond, Type.bool-type, "an if's condition");
                let branch-facts = facts(checking, branch.cond);
                match branch.otherwise {
                    some(else-block) => {
                        push-narrowing(checking, branch-facts.yes);
                        let resolved = check-block(checking, branch.then, want, true);
                        pop-scope(checking);
                        // both branches against what is wanted (when it is known: the then's
                        // value may be one of its values, "variant" where a union is wanted)
                        let target = match resolve(want) {
                            var(_) => resolved,
                            _ => want,
                        };
                        push-narrowing(checking, branch-facts.no);
                        check-block(checking, else-block, target, true);
                        pop-scope(checking);
                        target
                    }
                    none => {
                        push-narrowing(checking, branch-facts.yes);
                        check-block(checking, branch.then, fresh(checking), false);
                        pop-scope(checking);
                        Type.unit-type
                    }
                }
            }
            is-test(type-test) => infer-is(checking, type-test),
            try-as(attempt) => {
                infer-is(checking, attempt);
                // some of the value, as what the test narrows it to
                let symbols = checking.symbols;
                Type.option-type(split(checking, attempt.value.ty, semtype.translate(symbols, attempt.ty), some(attempt.ty)).yes)
            }
            // checked once already (a conversion the checker made)
            widen(widening) => widening.ty,
            start-expr(starting) => {
                // anywhere: start never waits (the task is the executor's to run, once whoever
                // started it waits, or an async export's call runs its tasks). A sync func or a
                // closure may start one: an effect a load, std's host a stream's pump
                if !is-async-call(checking, starting) {
                    type-error(checking, "start begins an async func's call: start f(…), f an async func");
                }
                checking.async-call = true;
                checking.starting = true;
                Type.future-type(check(checking, starting, fresh(checking), "a started call"))
            }
            wait-expr(waiting) => infer-wait(checking, waiting),
            yield-expr(yielding) => {
                match checking.yield-type {
                    some(found) => { check(checking, yielding, found, "a value yielded"); }
                    none => type-error(checking, "yield is in a generator's body (a func that gives back a seq<T>), not a closure's"),
                }
                Type.unit-type
            }
            block(block) => {
                // a block where a func of no params is wanted: a closure ({ count += 1; })
                match resolve(want) {
                    func-type(signature) => {
                        if signature.params.len() == 0 {
                            expression.kind = ExprKind.closure({
                                params: [],
                                types: [],
                                body: block,
                                marks: [],
                                unit: { env: false, },
                            });
                            return infer(checking, expression, want);
                        }
                    }
                    _ => {}
                }
                check-block(checking, block, want, true)
            }
            closure(cl) => infer-closure(checking, cl, want),
            cast(cast) => infer-cast(checking, cast),
            apply(application) => {
                // a closure called where it is made: the call's wanted result is its body's (as a
                // closure given where a func is wanted takes its params' and result's types from
                // it), so ({ -> [1, 2,] })() is a list<u8, 2> where one is wanted
                let callee-want = match application.callee.kind {
                    closure(_) => {
                        let params: list<Type> = [];
                        for argument in application.args { params.push(fresh(checking)); }
                        Type.func-type({ params: params, result: want, })
                    }
                    _ => fresh(checking),
                };
                call-value(
                    checking,
                    match application.callee.kind {
                        name(name) => name-text(name),
                        _ => "the func called",
                    },
                    check(checking, application.callee, callee-want, "a func called"),
                    application.args,
                )
            }
            record-lit(fields) => infer-record(checking, fields, want),
            match-expr(matching) => infer-match(checking, matching, want, true),
        }
    }

    is-none: func(candidate: option<Type>) -> bool {
        match candidate {
            none => true,
            _ => false,
        }
    }

    infer-name: func(checking: Checker, name: string, want: Type, at: Span) -> Type {
        match local-type(checking, intern(name)) {
            some(found) => { return found; }
            none => {}
        }
        if name == "none" {
            if checking.noting { note-use(checking, at, "builtin:option#none", none); }
            match resolve(want) {
                option-type(_) => { return want; }
                _ => {}
            }
            return Type.option-type(fresh(checking));
        }
        if is-result-case(checking, name, want) {
            if checking.noting { note-use(checking, at, "builtin:result#{name}", none); }
            return infer-result(checking, name, [], want);
        }
        let wanted = wanted-case(checking, name, want);
        if wanted != "" { return infer-case(checking, wanted, name, [], at, want); }
        // the two floats no numeral spells
        if name == "inf" || name == "nan" {
            let wanted = resolve(want);
            if fits-kind(2, wanted) { return wanted; }
            return fresh-kind(checking, 2);
        }
        match case-variant(checking, name, true) {
            some(owner) => {
                if owner == "" {
                    type-error(checking, "{name} is a case of more than one type: write Type.{name}");
                    return Type.error-type;
                }
                return infer-case(checking, owner, name, [], at, want);
            }
            none => {}
        }
        not-found(checking, "{name} is not declared", name, names-here(checking));
        Type.error-type
    }

    // a generic call's result, its arguments checked: a type parameter of a readonly parameter given
    // a value readonly in part is readonly where the result holds it (grid[0] of a readonly grid is a
    // readonly row: the parameter's T is its items, readonly taken off). A generic func's own type
    // parameter is left as it is: its caller's call says what it is
    read-result: func(sig: FuncSymbol, inst: Instance, args: list<Expr>) -> Type {
        let vars: map<string, Type> = map.new();
        let read = false;
        for position in 0..sig.type-params.len() {
            let name = sig.type-params[position];
            let through = false;
            let own = match resolve(inst.type-args[position]) {
                param(_) => true,
                _ => false,
            };
            for index in 0..args.len() {
                if index < sig.params.len() && is-readonly(sig.params[index]) && holds-readonly(args[index].ty)
                    && !own && mentions-type-param(sig.params[index], name) { through = true; }
            }
            vars.set(name, if through { readonly-of(inst.type-args[position]) } else { inst.type-args[position] });
            if through { read = true; }
        }
        if read { substitute(sig.result, vars) } else { inst.result }
    }

    // whether a generic func's parameter i holds only readonly values of its type parameters here
    // (each it names given one: list<T> with T a readonly row), so what of it the func gives back
    // is readonly
    items-readonly: func(sig: FuncSymbol, inst: Instance, index: s64) -> bool {
        if index < 0 || index >= sig.params.len() || !holds-only-params(sig.params[index]) { return false; }
        let named = false;
        for position in 0..sig.type-params.len() {
            if mentions-type-param(sig.params[index], sig.type-params[position]) {
                named = true;
                let type-argument = inst.type-args[position];
                if !is-readonly(type-argument) && !effects.settled-immutable(type-argument) { return false; }
            }
        }
        named
    }

    // whether a declared type is a list or a map of type parameters only (list<T>): each part of
    // a value of it, past the list itself, one of them
    holds-only-params: func(given: Type) -> bool {
        let whole = match given {
            readonly-type(wrapped) => wrapped,
            _ => given,
        };
        let shaped = match whole {
            list-type(_) => true,
            map-type(_) => true,
            _ => false,
        };
        shaped && !any-child(whole, { child -> !is-type-param(child) })
    }

    is-type-param: func(given: Type) -> bool {
        match given {
            param(_) => true,
            readonly-type(wrapped) => is-type-param(wrapped),
            _ => false,
        }
    }

    // whether a type is readonly, or has a part that is (a list of readonly rows: given a readonly
    // parameter, its items are readonly taken off)
    holds-readonly: func(given: Type) -> bool {
        is-readonly(given) || any-child(resolve(given), { child -> holds-readonly(child) })
    }

    // whether a declared type names a type parameter
    mentions-type-param: func(given: Type, name: string) -> bool {
        match given {
            param(parameter-name) => parameter-name == name,
            _ => any-child(given, { child -> mentions-type-param(child, name) }),
        }
    }

    infer-call: func(checking: Checker, name: string, args: list<Expr>, want: Type, at: Span) -> Type {
        // an async func's call: what a wait or a start does (its arguments are not)
        let waited = checking.async-call;
        checking.async-call = false;
        // a start's call: its arguments' sites say so (the flag is this call's, not its arguments')
        let starting = checking.starting;
        checking.starting = false;
        if is-async-func(checking, name) && !waited {
            type-error(
                checking,
                "{base-name(name)} is async: wait {base-name(name)}(…) for its result, or start {base-name(name)}(…) for a future",
            );
        }
        if checking.symbols.funcs.has(name) {
            given-defaults(checking, checking.symbols.funcs[name], args, at);
            let inst = instantiate(checking, checking.symbols.funcs[name]);
            if args.len() != inst.params.len() {
                type-error(checking, "{name} takes {inst.params.len()} arguments, given {args.len()}");
                // its arguments checked on their own; the call's result is still the func's
                for argument in args { check(checking, argument, Type.error-type, "an argument of {name}"); }
                return inst.result;
            }
            let first-site = checking.sites.len();
            for index in 0..args.len() {
                checking.starting = starting;
                check-arg(checking, name, index, args[index], inst.params[index]);
                checking.starting = false;
            }
            // the result, its type arguments known: whether it is readonly
            let result = read-result(checking.symbols.funcs[name], inst, args);
            let readonly-result = is-readonly(resolve(result))
                || effects.settled-immutable(result);
            for site in first-site..checking.sites.len() {
                if checking.sites[site].callee == name {
                    checking.sites[site].result-readonly = readonly-result;
                    checking.sites[site].items-readonly = items-readonly(checking.symbols.funcs[name], inst, checking.sites[site].index);
                }
            }
            same-value-twice(checking, name, args, inst.params);
            if is-wit(checking, name) {
                for index in 0..args.len() { note-move(checking, name, index, args[index]); }
            }
            checking.last-type-args = inst.type-args;
            return result;
        }
        checking.last-type-args = [];
        if name == "some" && args.len() == 1 {
            if checking.noting { note-use(checking, at, "builtin:option#some", none); }
            let inner = fresh(checking);
            match resolve(want) {
                option-type(payload) => { inner = payload; }
                _ => {}
            }
            check(checking, args[0], inner, "some's payload");
            return Type.option-type(inner);
        }
        if is-result-case(checking, name, want) {
            if checking.noting { note-use(checking, at, "builtin:result#{name}", none); }
            return infer-result(checking, name, args, want);
        }
        let wanted = wanted-case(checking, name, want);
        if wanted != "" { return infer-case(checking, wanted, name, args, at, want); }
        match case-variant(checking, name, true) {
            some(owner) => {
                if owner == "" {
                    type-error(checking, "{name} is a case of more than one type: write Type.{name}(...)");
                    return Type.error-type;
                }
                return infer-case(checking, owner, name, args, at, want);
            }
            none => {}
        }
        // no func of that name: told, unless an argument is an error's (x.f() on what an error made
        // is that error's echo)
        let echo = false;
        for argument in args {
            if is-error(check(checking, argument, fresh(checking), "an argument of {name}")) { echo = true; }
        }
        if !echo {
            if name.starts-with(WIDGET-FUNC) { no-widget(checking, name); } else { type-error(checking, "no func {name}"); }
        }
        Type.error-type
    }

    // the variant wanted here, when it has a case n (so a bare case needs no Type. where it is
    // expected)
    wanted-case: func(checking: Checker, name: string, want: Type) -> string {
        match resolve(want) {
            named(type-name) => {
                if !checking.symbols.variants.has(type-name) { return ""; }
                for kc in checking.symbols.variants[type-name].cases {
                    if kc.name == name { return name-text(type-name); }
                }
                ""
            }
            _ => "",
        }
    }

    // whether ok or err is result's: when a result is wanted, or when no variant has that case
    is-result-case: func(checking: Checker, name: string, want: Type) -> bool {
        if name != "ok" && name != "err" { return false; }
        match resolve(want) {
            result-type(_) => true,
            _ => case-variant(checking, name, false) == none,
        }
    }

    // ok, ok(v), err or err(e)
    infer-result: func(checking: Checker, name: string, args: list<Expr>, want: Type) -> Type {
        let ok = fresh(checking);
        let err = fresh(checking);
        match resolve(want) {
            result-type(outcome) => {
                ok = outcome.ok;
                err = outcome.err;
            }
            _ => {}
        }
        let side = if name == "ok" { ok } else { err };
        // ok(()): ok, a side carrying nothing holding ()
        if args.len() == 1 && is-unit-lit(args[0]) { args.pop(); }
        if args.len() == 0 {
            unify(checking, side, Type.unit-type, "{name} with no payload");
        } else {
            if args.len() != 1 { type-error(checking, "{name} takes one payload"); }
            match resolve(side) {
                unit-type => type-error(checking, "{name} carries no payload in a {show-type(want)}"),
                _ => {}
            }
            check(checking, args[0], side, "{name}'s payload");
        }
        Type.result-type({ ok: ok, err: err, })
    }

    // (): what a case carrying nothing holds
    is-unit-lit: func(expression: Expr) -> bool {
        match expression.kind {
            unit => true,
            _ => false,
        }
    }

    // Type.case, or Type.case(payload); a flags type's Type.flag
    infer-case: func(checking: Checker, tname: string, cname: string, args: list<Expr>, at: Span, want: Type) -> Type {
        let owner = intern(tname);
        // a new case, so readonly where that is wanted: its payload readonly too
        let made = if is-readonly(want) && unifies(without-readonly(want), Type.named(owner)) { want } else { Type.named(owner) };
        let frozen = is-readonly(made);
        if checking.noting {
            let declared = (checking.symbols.flags.has(owner) && contains(checking.symbols.flags[owner].flags, cname))
                || (checking.symbols.variants.has(owner) && checking.symbols.variants[owner].cases.any({ case -> case.name == cname }));
            if declared { note-use(checking, at, "{tname}#{cname}", none); }
        }
        if checking.symbols.flags.has(owner) {
            if !contains(checking.symbols.flags[owner].flags, cname) {
                not-found(checking, "{tname} has no flag {cname}", cname, checking.symbols.flags[owner].flags);
            }
            if args.len() != 0 { type-error(checking, "{tname}.{cname} is a flag, not a func"); }
            return Type.named(owner);
        }
        let known = if checking.symbols.variants.has(owner) { checking.symbols.variants[owner].cases } else { [] };
        for candidate in known {
            if candidate.name == cname {
                if !candidate.has-payload && args.len() == 1 && is-unit-lit(args[0]) { args.pop(); }
                // a payload of () may be left out (it carries nothing: Type.case is Type.case(()))
                let unit-payload = match resolve(candidate.payload) {
                    unit-type => true,
                    _ => false,
                };
                if candidate.has-payload && unit-payload && args.len() == 0 { return made; }
                if candidate.has-payload {
                    if args.len() != 1 {
                        type-error(checking, "{tname}.{cname} carries a payload");
                        return Type.named(owner);
                    }
                    check(checking, args[0], if frozen { readonly-of(candidate.payload) } else { candidate.payload }, "{tname}.{cname}'s payload");
                } else if args.len() != 0 {
                    type-error(checking, "{tname}.{cname} carries no payload");
                }
                return made;
            }
        }
        let cases: list<string> = [];
        if checking.symbols.variants.has(owner) {
            for case in checking.symbols.variants[owner].cases { cases.push(case.name); }
        }
        not-found(checking, "{tname} has no case {cname}", cname, cases);
        Type.error-type
    }

    // the key of field f of a value of type t0: its record's (or resource's) key and the field,
    // record#field ("" for one of no declared record: an anonymous record's, a tuple's, a flag)
    field-key: func(checking: Checker, t0: Type, field-name: string) -> string {
        match resolve(t0) {
            readonly-type(wrapped) => field-key(checking, wrapped, field-name),
            named(name) => {
                if checking.symbols.records.has(name) && contains(checking.symbols.records[name].fields, field-name) { "{name-text(name)}#{field-name}" } else { "" }
            }
            _ => "",
        }
    }

    field-type: func(checking: Checker, t0: Type, field-name: string) -> Type {
        let resolved = resolve(t0);
        match resolved {
            // a readonly value's field: readonly too
            readonly-type(wrapped) => readonly-of(field-type(checking, wrapped, field-name)),
            anon-record(anonymous) => {
                let index = index-of(anonymous.fields, field-name);
                if index < 0 {
                    not-found(checking, "a {show-type(resolved)} has no field {field-name}", field-name, anonymous.fields);
                    return Type.error-type;
                }
                anonymous.types[index]
            }
            tuple-type(xs) => {
                let index = tuple-index(field-name);
                if index < 0 || index >= xs.len() {
                    type-error(checking, "a {show-type(resolved)} has no field {field-name}");
                    return Type.error-type;
                }
                xs[index]
            }
            named(name) => {
                // a flag of a flags value, read as a bool
                if checking.symbols.flags.has(name) {
                    if !contains(checking.symbols.flags[name].flags, field-name) {
                        not-found(checking, "{name} has no flag {field-name}", field-name, checking.symbols.flags[name].flags);
                    }
                    return Type.bool-type;
                }
                if !checking.symbols.records.has(name) {
                    type-error(checking, ".{field-name} of {name}, which is not a record");
                    return Type.error-type;
                }
                let info = checking.symbols.records[name];
                let index = index-of(info.fields, field-name);
                if index < 0 {
                    not-found(checking, "{if info.value { "record" } else { "resource" }} {name} has no field {field-name}", field-name, info.fields);
                    return Type.error-type;
                }
                info.field-types[index]
            }
            _ => {
                type-error(
                    checking,
                    ".{field-name} of a {show-type(resolved)}, not a record (its type is not known yet: annotate it)",
                );
                Type.error-type
            }
        }
    }

    infer-binary: func(checking: Checker, binary: Binary) -> Type {
        let op = binary.op;
        if op == "&&" || op == "||" {
            check(checking, binary.left, Type.bool-type, "the left of {op}");
            // the right is reached when the left held (&&) or failed (||)
            let known-facts = facts(checking, binary.left);
            push-narrowing(checking, if op == "&&" { known-facts.yes } else { known-facts.no });
            check(checking, binary.right, Type.bool-type, "the right of {op}");
            pop-scope(checking);
            return Type.bool-type;
        }
        if op == "==" || op == "!=" {
            let resolved = check(checking, binary.left, fresh(checking), "the left of {op}");
            // the two may differ where one's values hold the other's ("get" == s)
            let saved = checking.span;
            checking.span = binary.right.span;
            let rt = infer(checking, binary.right, resolved);
            binary.right.ty = rt;
            if !unifies(resolved, rt) && !unifies(without-readonly(resolved), without-readonly(rt)) {
                // one side's values are the other's: compared as the wider
                if subtype(checking, rt, resolved) { widen-to(binary.right, rt, resolved); }
                else if subtype(checking, resolved, rt) { widen-to(binary.left, resolved, rt); }
                else {
                    type-error(
                        checking,
                        "the right of {op}: expected {show-type(resolved)}, found {show-type(rt)}",
                    );
                }
            }
            checking.span = saved;
            return Type.bool-type;
        }
        let resolved = widened(check(checking, binary.left, fresh(checking), "the left of {op}"));
        if op == "<" || op == "<=" || op == ">" || op == ">=" {
            comparable(checking, resolved, op);
            check(checking, binary.right, resolved, "the right of {op}");
            return Type.bool-type;
        }
        // << and >>: by any integer
        if op == "<<" || op == ">>" {
            integral(checking, resolved, op, false);
            check(checking, binary.right, fresh-kind(checking, 1), "the right of {op}");
            return resolved;
        }
        if op == "|" || op == "&" || op == "^" {
            integral(checking, resolved, op, true);
            check(checking, binary.right, resolved, "the right of {op}");
            return resolved;
        }
        // + joins two strings; the rest (and + otherwise) are on two numbers of one type
        match resolve(resolved) {
            string-type => {
                if op == "+" {
                    check(checking, binary.right, Type.string-type, "the right of +");
                    return Type.string-type;
                }
            }
            _ => {}
        }
        numeric(checking, resolved, op);
        check(checking, binary.right, resolved, "the right of {op}");
        resolved
    }

    // a record literal: the declared record context wants (that, or the one record of a union it
    // wants with exactly these fields), else an anonymous record of its fields' types
    infer-record: func(checking: Checker, fields: list<FieldInit>, want: Type) -> Type {
        let names: list<string> = [];
        for field in fields {
            if contains(names, field.name) {
                // no record has a field twice: its values checked, and the literal an error's
                type-error(checking, "field {field.name} is given twice");
                for given-field in fields { check(checking, given-field.value, fresh(checking), "field {given-field.name}"); }
                return Type.error-type;
            }
            names.push(field.name);
        }
        let wanted = resolve(want);
        match wanted {
            anon-record(anonymous) => {
                if !same-fields(anonymous.fields, names) {
                    type-error(
                        checking,
                        "{show-type(wanted)} has the fields \{ {anonymous.fields.join(", ")} \}, given \{ {names.join(", ")} \}",
                    );
                }
                for field in fields {
                    let index = index-of(anonymous.fields, field.name);
                    check(checking, field.value, if index < 0 { Type.error-type } else { anonymous.types[index] }, "field {field.name}");
                    if checking.noting && index >= 0 { note-structural(checking, field.name-span, wanted, field.name, anonymous.types[index]); }
                }
                return wanted;
            }
            _ => {}
        }
        // a new record, so readonly where that is wanted: its fields readonly too
        let frozen = is-readonly(wanted);
        let target = wanted-record(checking, if frozen { without-readonly(wanted) } else { wanted }, names);
        if target == "" {
            // an anonymous record: each field's own type
            let types: list<Type> = [];
            for field in fields { types.push(check(checking, field.value, fresh(checking), "field {field.name}")); }
            let made = anon-record-of(names, types);
            if checking.noting {
                for index in 0..fields.len() { note-structural(checking, fields[index].name-span, made, fields[index].name, types[index]); }
            }
            return made;
        }
        let record-name = intern(target);
        let info = checking.symbols.records[record-name];
        if checking.noting {
            for field in fields { if contains(info.fields, field.name) { note-use(checking, field.name-span, "{target}#{field.name}", none); } }
        }
        if !same-fields(info.fields, names) {
            type-error(
                checking,
                "{if info.value { "record" } else { "resource" }} {target} has the fields \{ {info.fields.join(", ")} \}, given \{ {names.join(", ")} \}",
            );
        }
        for field in fields {
            let index = index-of(info.fields, field.name);
            let ft = if index < 0 { Type.error-type } else { info.field-types[index] };
            check(
                checking,
                field.value,
                if frozen { readonly-of(ft) } else { ft },
                "field {field.name} of {target}",
            );
        }
        if frozen { readonly-of(Type.named(record-name)) } else { Type.named(record-name) }
    }

    // the declared record a literal with these fields is where w is wanted: w, or the one record
    // of a union w with exactly them; "" for none (the literal is anonymous)
    wanted-record: func(checking: Checker, wanted: Type, names: list<string>) -> string {
        match wanted {
            named(name) => { if checking.symbols.records.has(name) { return name-text(name); } }
            union-type(xs) => {
                let found: list<string> = [];
                for member in xs {
                    match resolve(member) {
                        named(name) => {
                            if checking.symbols.records.has(name) && same-fields(
                                checking.symbols.records[name].fields,
                                names,
                            ) {
                                found.push(name-text(name));
                            }
                        }
                        _ => {}
                    }
                }
                if found.len() == 1 { return found[0]; }
            }
            _ => {}
        }
        ""
    }

    same-fields: func(left: list<string>, right: list<string>) -> bool {
        if left.len() != right.len() { return false; }
        for item in right {
            if !contains(left, item) { return false; }
        }
        true
    }

    // a match: each arm's pattern against the value's type, its guard a bool; the arms' values one
    // type (when kept); every value fits an arm without a guard
    infer-match: func(checking: Checker, matching: Match, want: Type, keep: bool) -> Type {
        let before = checking.context.errors.len();
        let checked = check(checking, matching.value, fresh(checking), "a match's value");
        // (a local narrowed to one value: that value's type, not its representation, the arms
        // matched against)
        let vt = match matching.value.kind {
            name(name) => match scope-type(checking, name) {
                some(found) => if narrowed-to-one(checking, matching.value, found) { found } else { checked },
                none => checked,
            },
            _ => checked,
        };
        let saved = checking.span;
        let symbols = checking.symbols;
        // what the arms before (without guards) left, and the local matched (narrowed in each arm)
        let rest = vt;
        let subject = match matching.value.kind {
            name(name) => some(name),
            _ => none,
        };
        let subject-mark = match subject {
            some(name) => narrowable(checking, name),
            none => none,
        };
        for arm in matching.arms {
            checking.span = arm.span;
            push-scope(checking, arm.span);
            let seen: map<string, bool> = map.new();
            check-pattern(checking, arm.pattern, vt, seen, false);
            let parts = split(
                checking,
                rest,
                pattern-type(checking, symbols, arm.pattern, vt),
                pattern-as-type(checking, arm.pattern),
            );
            // a binding of the whole value: what the arms before left of it, that this one fits
            match arm.pattern {
                name(pn) => { if pn.kind == "bind" { bind(checking, intern(pn.name), parts.yes, pn.mark); } }
                _ => {}
            }
            // the subject narrowed in the arm, unless its pattern binds that name (some(x) on x:
            // the arm's x is the payload)
            match (subject, subject-mark) {
                (some(name), some(mark)) => if seen.has(name-text(name)) {
                    push-narrowing(checking, [])
                } else {
                    push-narrowing(checking, [{ name: name, ty: parts.yes, mark: mark, },])
                },
                _ => push-narrowing(checking, []),
            }
            match arm.guard {
                some(guard) => { check(checking, guard, Type.bool-type, "a match arm's guard"); }
                none => { rest = parts.no; }
            }
            if keep {
                match arm.body.kind {
                    block(block) => check-block(checking, block, want, true),
                    _ => check(checking, arm.body, want, "a match arm"),
                };
            } else {
                discard(checking, arm.body);
            }
            pop-scope(checking);
            pop-scope(checking);
        }
        checking.span = saved;
        if well-typed(checking, before) { exhaustive(checking, matching, vt); }
        if keep { return want; }
        Type.unit-type
    }

    // a pattern against the type t of the value at its place; seen: the names its arm binds; alt:
    // under a |, where nothing binds
    check-pattern: func(checking: Checker, pattern: Pattern, t0: Type, seen: map<string, bool>, alt: bool) {
        // at a union, the members the pattern looks inside (one kind of value)
        let resolved = pattern-member(checking, pattern, t0);
        match pattern {
            wild => {}
            typed(typed) => {
                let ty = known(checking, in-kind(generalize(resolve-type(checking, checking.scope, typed.ty, checking.type-params), checking.type-params), resolved), "a pattern's type", false);
                typed.ty = ty;
                if disjoint(checking, resolved, ty) {
                    type-error(checking, "a {show-type(resolved)} is never a {show-type(ty)}");
                }
                let symbols = checking.symbols;
                typed.test = some(is-pattern(checking, ty, resolved));
                check-pattern(
                    checking,
                    typed.sub,
                    split(checking, resolved, semtype.translate(symbols, ty), some(ty)).yes,
                    seen,
                    alt,
                );
            }
            member(inner-pattern) => check-pattern(checking, inner-pattern.sub, inner-pattern.ty, seen, alt),
            // lo..=hi: two literals of an integer or char type, in order
            range(range) => {
                check-unwidened(checking, range.lo, resolved, "a range pattern's start");
                check-unwidened(checking, range.hi, resolved, "a range pattern's end");
                match representation(resolved) {
                    num(name) => {
                        if !is-int(name) {
                            type-error(
                                checking,
                                "a range pattern on a {name}: ranges are of integers or chars",
                            );
                        }
                    }
                    char-type => {}
                    var(_) => {}
                    _ => type-error(
                        checking,
                        "a range pattern on a {show-type(resolved)}: ranges are of integers or chars",
                    ),
                }
                if semtype.is-empty(checking.symbols, pattern-type(checking, checking.symbols, pattern, resolved)) {
                    type-error(checking, "the range holds no value: its end is before its start");
                }
            }
            literal(literal) => {
                check-unwidened(checking, literal, resolved, "a literal pattern");
                literal-type(checking, resolved, "a literal pattern");
            }
            name(pn) => check-name-pattern(checking, pn, resolved, seen, alt),
            case(pc) => {
                settle(checking, pc.name, resolved);
                if checking.noting { note-use(checking, pc.name-span, case-key(checking, resolved, pc.name), none); }
                let pt = case-payload(checking, pc.name, resolved);
                // a case carrying nothing holds (): its pattern (), _ or a name (bound to ()); an
                // option's some carries a payload, () too
                match resolve(pt) {
                    unit-type => {
                        let empty = pc.name == "some" || match pc.sub {
                            wild => true,
                            tuple(ps) => ps.len() == 0,
                            name(pn) => pn.binds,
                            _ => false,
                        };
                        if !empty {
                            type-error(
                                checking,
                                "{pc.name} carries no payload in a {show-type(resolve(resolved))}",
                            );
                        }
                    }
                    _ => {}
                }
                check-pattern(checking, pc.sub, pt, seen, alt);
            }
            record(pr) => {
                let rt = resolve(resolved);
                let info = match record-shape(checking, rt) {
                    some(value) => value,
                    none => {
                        type-error(
                            checking,
                            "a record pattern on a {show-type(rt)} (annotate the value's type)",
                        );
                        let empty: RecordShape = { fields: [], types: [], value: false, };
                        empty
                    }
                };
                for index in 0..pr.fields.len() {
                    let position = field-index(info.fields, pr.fields[index]);
                    if position < 0 { type-error(checking, "a {show-type(rt)} has no field {pr.fields[index]}"); }
                    // the field's use (but in { x }, whose name is the binding's: the binding is it)
                    let shorthand = match pr.patterns[index] {
                        name(pn) => pn.span == pr.field-spans[index],
                        _ => false,
                    };
                    if checking.noting && position >= 0 && !shorthand {
                        if structural(rt) {
                            note-structural(checking, pr.field-spans[index], without-readonly(rt), pr.fields[index], info.types[position]);
                        } else {
                            note-use(checking, pr.field-spans[index], field-key(checking, rt, pr.fields[index]), none);
                        }
                    }
                    check-pattern(checking, pr.patterns[index], if position < 0 { Type.error-type } else { info.types[position] }, seen, alt);
                }
                // ...rest: an anonymous record of the fields not named
                if pr.rest != "" {
                    if alt {
                        type-error(
                            checking,
                            "{pr.rest} is bound under a |, where a pattern binds nothing",
                        );
                    }
                    if seen.has(pr.rest) {
                        type-error(checking, "{pr.rest} is bound twice in one pattern");
                    }
                    seen.set(pr.rest, true);
                    bind(checking, intern(pr.rest), rest-type(info, pr.fields), pr.rest-mark);
                }
            }
            tuple(ps) => {
                // (): unit's one value (of a union, its () member)
                if ps.len() == 0 {
                    if disjoint(checking, Type.unit-type, resolved) {
                        unify(checking, Type.unit-type, resolved, "a () pattern");
                    }
                    return;
                }
                match resolve(resolved) {
                    var(_) => {
                        let xs: list<Type> = [];
                        for part in ps { xs.push(fresh(checking)); }
                        unify(checking, Type.tuple-type(xs), resolved, "a tuple pattern");
                    }
                    _ => {}
                }
                match resolve(resolved) {
                    tuple-type(xs) => {
                        if xs.len() != ps.len() {
                            type-error(
                                checking,
                                "a tuple pattern of {ps.len()} on a {show-type(resolve(resolved))}",
                            );
                        }
                        for index in 0..ps.len() {
                            check-pattern(checking, ps[index], if index < xs.len() { xs[index] } else { Type.error-type }, seen, alt);
                        }
                    }
                    _ => type-error(checking, "a tuple pattern on a {show-type(resolve(resolved))}"),
                }
            }
            alt(ps) => { for alternative in ps { check-pattern(checking, alternative, resolved, seen, true); } }
        }
    }

    // a record type's fields and their types (a declared record's, an anonymous one's); none for
    // another type
    record-shape: func(checking: Checker, given: Type) -> option<RecordShape> {
        match resolve(given) {
            // a readonly record's fields read readonly
            readonly-type(wrapped) => match record-shape(checking, wrapped) {
                some(info) => {
                    let ts: list<Type> = [];
                    for item in info.types { ts.push(readonly-of(item)); }
                    some({ fields: info.fields, types: ts, value: info.value, })
                }
                none => none,
            },
            named(name) => match checking.symbols.records.get(name) {
                some(declared) => some({ fields: declared.fields, types: declared.field-types, value: declared.value, }),
                none => none,
            },
            anon-record(anonymous) => some({ fields: anonymous.fields, types: anonymous.types, value: true, }),
            _ => none,
        }
    }

    // the anonymous record of a record's fields but named
    rest-type: func(info: RecordShape, named: list<string>) -> Type {
        let fs: list<string> = [];
        let ts: list<Type> = [];
        for index in 0..info.fields.len() {
            if !contains(named, info.fields[index]) {
                fs.push(info.fields[index]);
                ts.push(info.types[index]);
            }
        }
        anon-record-of(fs, ts)
    }

    // a union's members a case, record or tuple pattern looks inside (as a union), which must be
    // one kind of value (it is told by its tag); t itself for another pattern or type
    pattern-member: func(checking: Checker, pattern: Pattern, given: Type) -> Type {
        let members: list<Type> = match resolve(given) {
            union-type(xs) => xs,
            _ => [],
        };
        if members.len() == 0 { return given; }
        let fits: list<Type> = [];
        for member in members {
            let rm = resolve(member);
            let ok = match pattern {
                case(pc) => is-case-name(checking, pc.name, rm),
                name(pn) => is-case-name(checking, pn.name, rm),
                record(pr) => match rm {
                    named(name) => checking.symbols.records.has(name),
                    anon-record(anonymous) => {
                        let all = true;
                        for field in pr.fields {
                            if !contains(anonymous.fields, field) { all = false; }
                        }
                        all
                    }
                    _ => false,
                },
                tuple(ps) => match rm {
                    tuple-type(xs) => ps.len() > 0 && xs.len() == ps.len(),
                    unit-type => ps.len() == 0,
                    _ => false,
                },
                _ => false,
            };
            if ok { fits.push(member); }
        }
        if fits.len() == 0 { return given; }
        let joined = union-of(fits);
        match representation(joined) {
            union-type(_) => type-error(
                checking,
                "the pattern fits more than one kind of {show-type(given)}: match its type first (let x: T)",
            ),
            _ => {}
        }
        joined
    }

    // a name in a pattern: a case of t, else (where names bind) a binding, else a constant
    check-name-pattern: func(checking: Checker, pn: NamePattern, given: Type, seen: map<string, bool>, alt: bool) {
        settle(checking, pn.name, given);
        if is-case-name(checking, pn.name, given) {
            pn.kind = "case";
            if checking.noting { note-use(checking, pn.span, case-key(checking, given, pn.name), none); }
            return;
        }
        if !pn.binds {
            let ck = const-key(checking, pn.name);
            if ck != "" {
                pn.kind = "const";
                pn.key = ck;
                if checking.noting { note-use(checking, pn.span, ck, none); }
                let copy = const-copy(checking, ck, pn.span);
                match checking.symbols.consts[ck].ty {
                    some(ct) => unify(checking, ct, given, "the constant {pn.name}"),
                    none => {}
                }
                check-unwidened(checking, copy, given, "the constant {pn.name}");
                literal-type(checking, given, "the constant {pn.name} as a pattern");
                pn.value = some(copy);
                return;
            }
        }
        if !pn.binds && case-variant(checking, pn.name, false) != none {
            type-error(checking, "{pn.name} is not a case of {show-type(resolve(given))}");
        }
        if !pn.binds {
            type-error(
                checking,
                "{pn.name} is not a case of {show-type(resolve(given))} or a constant: bind it with let {pn.name}",
            );
        }
        if alt { type-error(checking, "{pn.name} is bound under a |, where a pattern binds nothing"); }
        if seen.has(pn.name) { type-error(checking, "{pn.name} is bound twice in one pattern"); }
        seen.set(pn.name, true);
        pn.kind = "bind";
        bind(checking, intern(pn.name), given, pn.mark);
    }

    // that a literal pattern's type is one a literal is written in
    literal-type: func(checking: Checker, given: Type, what: string) {
        match representation(given) {
            union-type(_) => {}
            num(_) => {}
            char-type => {}
            string-type => {}
            bool-type => {}
            var(_) => {}
            _ => type-error(checking, "{what} on a {show-type(resolve(given))}"),
        }
    }

    field-index: func(fields: list<string>, field-name: string) -> s64 {
        for index in 0..fields.len() {
            if fields[index] == field-name { return index; }
        }
        -1
    }

    // a type not known yet, settled by the case n matched against it (none: an option)
    settle: func(checking: Checker, name: string, given: Type) {
        match resolve(given) {
            var(variable) => {
                if variable.kind != 0 { return; }
                if name == "none"
                    || name == "some" { unify(checking, Type.option-type(fresh(checking)), given, "a match"); }
                else if name == "ok" || name == "err" {
                    unify(checking, Type.result-type({ ok: fresh(checking), err: fresh(checking), }), given, "a match");
                } else if name == "true" || name == "false" { unify(checking, Type.bool-type, given, "a match"); }
                else {
                    match case-variant(checking, name, false) {
                        some(owner) => { if owner != "" { unify(checking, Type.named(intern(owner)), given, "a match"); } }
                        none => {}
                    }
                }
            }
            _ => {}
        }
    }

    // whether n is a case of t
    is-case-name: func(checking: Checker, name: string, given: Type) -> bool {
        match resolve(given) {
            readonly-type(wrapped) => is-case-name(checking, name, wrapped),
            union-type(xs) => {
                for member in xs {
                    if is-case-name(checking, name, member) { return true; }
                }
                false
            }
            singleton(single) => match single.base {
                bool-type => name == single.key,
                _ => false,
            },
            option-type(_) => name == "none" || name == "some",
            result-type(_) => name == "ok" || name == "err",
            bool-type => name == "true" || name == "false",
            named(type-name) => {
                if !checking.symbols.variants.has(type-name) { return false; }
                for kc in checking.symbols.variants[type-name].cases {
                    if kc.name == name { return true; }
                }
                false
            }
            _ => false,
        }
    }

    // the payload's type of t's case n (an error when it is not a case); () when it carries nothing
    case-payload: func(checking: Checker, name: string, given: Type) -> Type {
        let rt = resolve(given);
        match rt {
            readonly-type(wrapped) => { return readonly-of(case-payload(checking, name, wrapped)); }
            _ => {}
        }
        // a union's: the payloads of the members with that case
        match rt {
            union-type(xs) => {
                let ps: list<Type> = [];
                for member in xs {
                    if is-case-name(checking, name, member) { ps.push(case-payload(checking, name, member)); }
                }
                if ps.len() == 0 {
                    type-error(checking, "{name} is not a case of {show-type(rt)}");
                    return Type.error-type;
                }
                return union-of(ps);
            }
            _ => {}
        }
        if !is-case-name(checking, name, rt) {
            type-error(checking, "{name} is not a case of {show-type(rt)}");
            return Type.error-type;
        }
        match rt {
            option-type(inner) => { if name == "some" { return inner; } }
            result-type(outcome) => {
                let side = if name == "ok" { outcome.ok } else { outcome.err };
                match resolve(side) {
                    unit-type => {}
                    _ => { return side; }
                }
            }
            named(type-name) => {
                if checking.symbols.variants.has(type-name) {
                    for kc in checking.symbols.variants[type-name].cases {
                        if kc.name == name && kc.has-payload { return kc.payload; }
                    }
                }
            }
            _ => {}
        }
        Type.unit-type
    }

    // ================================================================ exhaustiveness

    // whether no error was found since the errors numbered before (none told, and the statement
    // not quiet: an echo there would not be told): what a pattern covers is only asked of sound types
    well-typed: func(checking: Checker, before: s64) -> bool { checking.context.errors.len() == before && !checking.quiet }

    // that every value fits an arm without a guard: else an error naming one that fits none
    exhaustive: func(checking: Checker, matching: Match, vt: Type) {
        let patterns: list<Pattern> = [];
        for arm in matching.arms {
            match arm.guard {
                some(_) => {}
                none => patterns.push(arm.pattern),
            }
        }
        match uncovered(checking, patterns, vt) {
            some(missing) => type-error(checking, "the match has no arm for {missing}: add one, or a _ arm"),
            none => {}
        }
    }

    // a value of type vt none of the patterns fit, shown as a pattern: the type's values less
    // each pattern's, as sets (semtype.yel); none when none is left
    uncovered: func(checking: Checker, patterns: list<Pattern>, vt0: Type) -> option<string> {
        let symbols = checking.symbols;
        // which values there are (readonly is who may write them, not which they are)
        let vt = without-readonly(vt0);
        let rest = semtype.translate(symbols, vt);
        for pattern in patterns { rest = semtype.diff(symbols, rest, pattern-type(checking, symbols, pattern, vt)); }
        match semtype.sample(symbols, rest) {
            some(missing) => {
                // any value of a union's kind: that kind's pattern
                if missing == "_" && kinds(vt).len() > 1 {
                    for kind in kinds(vt) {
                        let part = kind-part(vt, kind);
                        if !semtype.is-empty(
                            symbols,
                            semtype.inter(symbols, rest, semtype.translate(symbols, part)),
                        ) {
                            return some("let x: {show-type(part)}");
                        }
                    }
                }
                some(missing)
            }
            none => none,
        }
    }

    // the values a pattern (checked) fits, of type t
    pattern-type: func(checking: Checker, symbols: Symbols, pattern: Pattern, t1: Type) -> SemType {
        let t0 = without-readonly(t1);
        let resolved = resolve(pattern-member(checking, pattern, t0));
        match pattern {
            wild => semtype.translate(symbols, resolved),
            // its one value, of the type it was checked as
            literal(literal) => literal-set(symbols, literal),
            typed(typed) => semtype.inter(symbols, semtype.translate(symbols, resolved), semtype.translate(symbols, typed.ty)),
            range(range) => semtype.range(
                resolved,
                semtype.literal-key(range.lo),
                semtype.literal-key(range.hi),
                range.inclusive,
            ),
            member(inner-pattern) => pattern-type(checking, symbols, inner-pattern.sub, inner-pattern.ty),
            name(pn) => {
                if pn.kind == "case" { return case-type(checking, symbols, pn.name, resolved, none); }
                if pn.kind == "const" {
                    match pn.value {
                        some(value) => { return literal-set(symbols, value); }
                        none => {}
                    }
                }
                semtype.translate(symbols, resolved)
            }
            case(pc) => {
                let pt = case-payload(checking, pc.name, resolved);
                case-type(checking, symbols, pc.name, resolved, some(pattern-type(checking, symbols, pc.sub, pt)))
            }
            record(pr) => {
                match resolved {
                    named(rn) => {
                        if !checking.symbols.records.has(rn) { return semtype.translate(symbols, resolved); }
                        let info = checking.symbols.records[rn];
                        let fields: list<SemType> = [];
                        for index in 0..info.fields.len() {
                            let position = field-index(pr.fields, info.fields[index]);
                            fields.push(if position < 0 {
                                semtype.translate(symbols, info.field-types[index])
                            } else {
                                pattern-type(checking, symbols, pr.patterns[position], info.field-types[index])
                            });
                        }
                        semtype.product(name-text(rn), name-text(rn), fields)
                    }
                    anon-record(anonymous) => {
                        let fields: list<SemType> = [];
                        for index in 0..anonymous.fields.len() {
                            let position = field-index(pr.fields, anonymous.fields[index]);
                            fields.push(if position < 0 {
                                semtype.translate(symbols, anonymous.types[index])
                            } else {
                                pattern-type(checking, symbols, pr.patterns[position], anonymous.types[index])
                            });
                        }
                        semtype.product(semtype.anon-tag(anonymous.fields), "", fields)
                    }
                    _ => semtype.translate(symbols, resolved),
                }
            }
            tuple(ps) => {
                if ps.len() == 0 { return semtype.translate(symbols, Type.unit-type); }
                match resolved {
                    tuple-type(xs) => {
                        let fields: list<SemType> = [];
                        for index in 0..ps.len() { fields.push(pattern-type(checking, symbols, ps[index], xs[index])); }
                        semtype.product("tuple/{ps.len()}", "", fields)
                    }
                    _ => semtype.translate(symbols, resolved),
                }
            }
            alt(ps) => {
                let out = semtype.nothing();
                for alternative in ps { out = semtype.union(out, pattern-type(checking, symbols, alternative, resolved)); }
                out
            }
        }
    }

    // a literal's one value (its type a literal type inside a union, else its kind)
    literal-set: func(symbols: Symbols, expression: Expr) -> SemType {
        match resolve(expression.ty) {
            singleton(_) => semtype.translate(symbols, expression.ty),
            _ => semtype.literal(expression.ty, semtype.literal-key(expression)),
        }
    }

    // the values of t's case n, its payload's in sub (none: any payload)
    case-type: func(checking: Checker, symbols: Symbols, name: string, given: Type, sub: option<SemType>) -> SemType {
        let payload = match sub {
            some(meaning) => meaning,
            none => semtype.translate(symbols, case-payload(checking, name, given)),
        };
        // a field for its payload (none for a case carrying nothing; an option's some has one)
        let fields = match resolve(case-payload(checking, name, given)) {
            unit-type => if name == "some" { [payload,] } else { [] },
            _ => [payload,],
        };
        if (name == "true" || name == "false") && show-type(representation(given)) == "bool" {
            return semtype.bools(if name == "true" { 1 } else { 2 });
        }
        match given {
            named(type-name) => semtype.product(name-text(type-name) + "." + name, name-text(type-name), fields),
            _ => semtype.product(name, "", fields),
        }
    }

    // ================================================================ async

    // that a wait or a start is in an async func's body
    need-async: func(checking: Checker, what: string) {
        if !checking.in-async && checking.closure-depth > 0 {
            type-error(
                checking,
                "{what} is not in a closure yet (a closure is not async): {what} in the async func around it",
            );
        }
        if !checking.in-async {
            type-error(
                checking,
                "{what} is only in an async func: make {base-name(checking.in-func)} async (name: async func(…))",
            );
        }
    }

    // whether a builtin named n is async (one of several of that name: which one its first argument
    // picks is settled when the call is checked)
    async-builtin: func(checking: Checker, name: string) -> bool {
        builtins-here(checking, name).any({ key -> is-async-func(checking, key) })
    }

    // whether an expression is a call of an async func (its key settled by the checker, or a name
    // that is one)
    is-async-call: func(checking: Checker, expression: Expr) -> bool {
        match expression.kind {
            call(called) => is-async-func(checking, called.name) || is-async-func(checking, func-key(checking, called.name)) || async-builtin(checking, called.name),
            method(method-call) => {
                // module.f(a): the module's func, and only it; h.f(a) on a resource's handle: its method
                match method-call.target.kind {
                    name(name) => {
                        match local-type(checking, name) {
                            some(found) => {
                                match resolve(found) {
                                    named(type-name) => {
                                        if checking.symbols.resources.has(type-name) { return is-async-func(checking, name-text(type-name) + "." + method-call.name); }
                                    }
                                    _ => {}
                                }
                            }
                            none => {
                                let mk = module-key(checking, checking.scope, name-text(name));
                                if mk != "" { return is-async-func(checking, mk + "." + method-call.name); }
                            }
                        }
                    }
                    _ => {
                        // a handle's method on any other target (a call's result, a tuple's field,
                        // a field): the method of the resource its type is (a target that names a
                        // module's type, or a type, is no value)
                        if type-ref(checking, method-call.target) == "" && module-ref(checking, method-call.target) == "" {
                            match resolve(without-readonly(check(checking, method-call.target, fresh(checking), "a method's target"))) {
                                named(type-name) => {
                                    if checking.symbols.resources.has(type-name) { return is-async-func(checking, name-text(type-name) + "." + method-call.name); }
                                }
                                _ => {}
                            }
                        }
                    }
                }
                is-async-func(checking, method-call.name) || is-async-func(checking, func-key(checking, method-call.name)) || async-builtin(checking, method-call.name)
            }
            _ => false,
        }
    }

    // what one value waited for gives: an async call's result, a future's
    waited: func(checking: Checker, expression: Expr) -> Type {
        if is-async-call(checking, expression) {
            checking.async-call = true;
            return check(checking, expression, fresh(checking), "a call waited for");
        }
        let resolved = check(checking, expression, fresh(checking), "a value waited for");
        match resolve(resolved) {
            future-type(inner) => inner,
            _ => {
                type-error(checking, "wait takes an async func's call or a future, found {show-type(resolved)}");
                Type.error-type
            }
        }
    }

    // wait x: its result; wait a | b: whichever is done first (a union of their results); wait
    // { a: x, b: y }: all of them, an anonymous record of their results
    infer-wait: func(checking: Checker, waiting: Wait) -> Type {
        need-async(checking, "wait");
        let ts: list<Type> = [];
        for value in waiting.values { ts.push(waited(checking, value)); }
        if waiting.mode == "one" { return ts[0]; }
        if waiting.mode == "any" { return union-of(ts); }
        for index in 0..waiting.fields.len() {
            if index-of(waiting.fields, waiting.fields[index]) != index {
                type-error(checking, "field {waiting.fields[index]} is waited for twice");
            }
        }
        anon-record-of(waiting.fields, ts)
    }

    // ================================================================ a component's boundary

    // an exported func's types: a literal or union type that crosses as a WIT enum or variant
    // named by an alias (its WIT name), an enum's strings WIT's names
    check-crossings: func(checking: Checker, function: Func) {
        if !is-export(function.scope, checking.reactor) { return; }
        checking.span = function.span;
        checking.scope = function.scope;
        checking.in-func = function.name;
        let seen: map<string, bool> = map.new();
        let all: list<Type> = [];
        for item in function.param-types { all.push(item); }
        all.push(function.result);
        for item in all {
            // a stream or a future, its own or inside a value: its end crosses (a task of the call
            // pumps it, so the call is an async func's)
            let hseen: map<string, bool> = map.new();
            if holds-handles(checking, item, hseen) { crossing-call(checking, function); }
            check-crossing(checking, item, seen);
        }
    }

    // whether a type holds a stream or a future (in a record's fields, a variant's cases, …)
    holds-handles: func(checking: Checker, t0: Type, seen: map<string, bool>) -> bool {
        let resolved = resolve(t0);
        match resolved {
            stream-type(_) => true,
            future-type(_) => true,
            named(name) => {
                if seen.has(name-text(name)) { return false; }
                seen.set(name-text(name), true);
                if checking.symbols.records.has(name) {
                    for field-type in checking.symbols.records[name].field-types {
                        if holds-handles(checking, field-type, seen) { return true; }
                    }
                }
                if checking.symbols.variants.has(name) {
                    for case in checking.symbols.variants[name].cases {
                        if holds-handles(checking, case.payload, seen) { return true; }
                    }
                }
                false
            }
            _ => any-child(resolved, { item -> holds-handles(checking, item, seen) }),
        }
    }

    crossing-call: func(checking: Checker, function: Func) {
        if !function.is-async {
            type-error(
                checking,
                "a stream or a future crosses WIT only in an async func's type: make {base-name(function.name)} async",
            );
        }
    }

    check-crossing: func(checking: Checker, t0: Type, seen: map<string, bool>) {
        let resolved = resolve(t0);
        match resolved {
            singleton(_) => check-set-crossing(checking, resolved, seen),
            union-type(_) => check-set-crossing(checking, resolved, seen),
            list-type(item) => check-crossing(checking, item, seen),
            fixed-list(fixed) => check-crossing(checking, fixed.item, seen),
            option-type(inner) => check-crossing(checking, inner, seen),
            result-type(outcome) => {
                check-crossing(checking, outcome.ok, seen);
                check-crossing(checking, outcome.err, seen);
            }
            tuple-type(xs) => { for item in xs { check-crossing(checking, item, seen); } }
            stream-type(streamed) => check-crossing(checking, streamed.item, seen),
            future-type(inner) => check-crossing(checking, inner, seen),
            // an anonymous record: a WIT record, named by its alias
            anon-record(anonymous) => {
                if !checking.set-names.has(show-type(resolved)) {
                    type-error(
                        checking,
                        "{show-type(resolved)} crosses WIT as a record, which needs a name: type name = {show-type(resolved)};",
                    );
                }
                for item in anonymous.types { check-crossing(checking, item, seen); }
            }
            named(name) => {
                if seen.has(name-text(name)) { return; }
                seen.set(name-text(name), true);
                // a resource (a shared object) crosses as a WIT resource, a handle: the one a reactor's
                // visible module declares, in that module's funcs (never a copy, which would lose
                // what makes it one)
                if checking.symbols.records.has(name) && !checking.symbols.records[name].value {
                    let sc = checking.resource-scopes[name];
                    if !is-export(sc, checking.reactor) || sc.module != checking.scope.module {
                        let diagnostic = diagnostics.error(checking.span, "resource {base-name(name-text(name))} crosses WIT only as one this component exports: declared in the module whose funcs it crosses, a visible module of a program without main", "");
                        diagnostics.help(diagnostic, "for a value copied across, declare it a record: record {base-name(name-text(name))} \{ … \}");
                        tell(checking, diagnostic);
                    }
                    return;
                }
                if checking.symbols.records.has(name) {
                    for field-type in checking.symbols.records[name].field-types {
                        check-crossing(checking, field-type, seen);
                    }
                }
                if checking.symbols.variants.has(name) {
                    for case in checking.symbols.variants[name].cases { check-crossing(checking, case.payload, seen); }
                }
            }
            _ => {}
        }
    }

    check-set-crossing: func(checking: Checker, given: Type, seen: map<string, bool>) {
        let how = gen.crossing(given);
        if how == "checked" {
            check-crossing(checking, representation(given), seen);
            return;
        }
        if !checking.set-names.has(show-type(given)) {
            type-error(
                checking,
                "{show-type(given)} crosses WIT as {if how == "enum" { "an enum" } else { "a variant" }}, which needs a name: type name = {show-type(given)};",
            );
        }
        if how == "enum" {
            for value in gen.enum-values(given) {
                if !is-wit-name(value) {
                    type-error(
                        checking,
                        "\"{value}\" is no WIT name (kebab-case, a-z, 0-9 and -): it cannot be a WIT enum's case",
                    );
                }
            }
        }
        if how == "variant" { for kind in kinds(given) { check-crossing(checking, kind, seen); } }
    }

    // whether a string is a WIT name: words of a-z and 0-9 (each starting with a letter) joined
    // by -
    is-wit-name: func(name: string) -> bool {
        if name.len() == 0 { return false; }
        let start = true;
        for index in 0..name.len() {
            let ch = name.byte-at(index);
            if ch == 45 {
                if start { return false; }
                start = true;
            } else if ch >= 97 && ch <= 122 {
                start = false;
            } else if ch >= 48 && ch <= 57 {
                if start { return false; }
            } else {
                return false;
            }
        }
        !start
    }

    // ================================================================ is, and narrowing

    // x is T: x's type and T's must share a value; the test, a pattern of x's type
    infer-is: func(checking: Checker, type-test: IsTest) -> Type {
        let vt = check(checking, type-test.value, fresh(checking), "the value an is tests");
        let resolved = known(checking, in-kind(generalize(resolve-type(checking, checking.scope, type-test.ty, checking.type-params), checking.type-params), vt), "an is test's type", false);
        type-test.ty = resolved;
        if disjoint(checking, vt, resolved) {
            type-error(checking, "a {show-type(vt)} is never a {show-type(resolved)}: the test is always false");
        }
        type-test.pattern = some(is-pattern(checking, resolved, vt));
        Type.bool-type
    }

    // a range written as a type (its ends literals: an s32's unless they say), tested against an
    // integer of another kind: that kind's range (x: u64 is 0..18446744073709551615)
    in-kind: func(given: Type, value: Type) -> Type {
        // the value's integer kind (a range's: its base's)
        let base = match resolve(value) {
            range-type(vr) => resolve(vr.base),
            let other => other,
        };
        match given {
            range-type(range) => match base {
                num(name) => if is-int(name) && range.base == Type.num("s32") {
                    Type.range-type({ base: Type.num(name), lo: range.lo, hi: range.hi, text: range.text, })
                } else {
                    given
                },
                _ => given,
            },
            _ => given,
        }
    }

    // whether a and b share no value
    disjoint: func(checking: Checker, left: Type, right: Type) -> bool {
        let symbols = checking.symbols;
        semtype.is-empty(symbols, semtype.inter(symbols, semtype.translate(symbols, left), semtype.translate(symbols, right)))
    }

    // a pattern's values as a type, where it is literals (their checked types): none otherwise
    pattern-as-type: func(checking: Checker, pattern: Pattern) -> option<Type> {
        match pattern {
            literal(literal) => some(literal.ty),
            range(range) => {
                let lo = semtype.literal-key(range.lo);
                let hi = semtype.literal-key(range.hi);
                // an exclusive range's last value, in its own kind (a u64's past s64's)
                let kind = semtype.int-kind(representation(range.lo.ty));
                let last = if range.inclusive { hi } else { semtype.key-before(kind, hi) };
                some(Type.range-type({
                    base: representation(range.lo.ty),
                    lo: lo,
                    hi: last,
                    text: "{lo}..={last}",
                }))
            }
            name(pn) => {
                if pn.kind == "case" && (pn.name == "true" || pn.name == "false") {
                    return some(Type.singleton({
                        base: Type.bool-type,
                        key: pn.name,
                        text: pn.name,
                    }));
                }
                match pn.value {
                    some(found) => some(found.ty),
                    none => none,
                }
            }
            alt(ps) => {
                let ts: list<Type> = [];
                for alternative in ps {
                    match pattern-as-type(checking, alternative) {
                        some(found) => ts.push(found),
                        none => { return none; }
                    }
                }
                some(union-of(ts))
            }
            _ => none,
        }
    }

    // the pattern a value of type vt fits when it is one of t's
    is-pattern: func(checking: Checker, given: Type, vt: Type) -> Pattern {
        if subtype(checking, vt, given) { return Pattern.wild; }
        // a union of kinds: its tag, then the test within the kind's values
        let vk = kinds(vt);
        if vk.len() > 1 {
            let alts: list<Pattern> = [];
            for kind in vk {
                let part = kind-part(vt, kind);
                if !disjoint(checking, part, given) {
                    alts.push(Pattern.member({ ty: part, sub: is-pattern(checking, given, part), }));
                }
            }
            if alts.len() == 1 { return alts[0]; }
            return Pattern.alt(alts);
        }
        let rv = resolve(vt);
        match resolve(given) {
            union-type(xs) => {
                let alts: list<Pattern> = [];
                for member in xs {
                    if !disjoint(checking, member, vt) { alts.push(is-pattern(checking, member, vt)); }
                }
                if alts.len() == 1 { return alts[0]; }
                return Pattern.alt(alts);
            }
            singleton(single) => { return literal-pattern(checking, single); }
            range-type(range) => {
                return Pattern.range({
                    lo: literal-expr(checking, range.base, range.lo),
                    hi: literal-expr(checking, range.base, range.hi),
                    inclusive: true,
                    span: checking.span,
                });
            }
            option-type(tested-inner) => {
                match rv {
                    option-type(value-inner) => {
                        return Pattern.alt([
                            case-pattern(checking, "none"),
                            Pattern.case({ name: "some", sub: is-pattern(checking, tested-inner, value-inner), span: checking.span, name-span: nowhere(), }),
                        ]);
                    }
                    _ => {}
                }
            }
            tuple-type(xs) => {
                match rv {
                    tuple-type(ys) => {
                        let items: list<Pattern> = [];
                        for index in 0..xs.len() { items.push(is-pattern(checking, xs[index], ys[index])); }
                        return Pattern.tuple(items);
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        type-error(checking, "an is test of {show-type(given)} on a {show-type(vt)} is not supported yet");
        Pattern.wild
    }

    // a union's members of kind k (held as k), as a type
    kind-part: func(vt: Type, kind: Type) -> Type {
        let members = union-members(vt);
        let out: list<Type> = [];
        for member in members {
            if show-type(represented(member)) == show-type(kind) { out.push(member); }
        }
        union-of(out)
    }

    // the pattern of a literal type's one value
    literal-pattern: func(checking: Checker, single: Singleton) -> Pattern {
        match single.base {
            bool-type => case-pattern(checking, single.key),
            _ => Pattern.literal(literal-expr(checking, single.base, single.key)),
        }
    }

    case-pattern: func(checking: Checker, name: string) -> Pattern {
        Pattern.name({
            name: name,
            binds: false,
            kind: "case",
            key: "",
            value: none,
            mark: { captured: false, unit: { env: false, }, ty: Type.unit-type, name: name, span: checking.span, slot: -1, },
            span: checking.span,
        })
    }

    // a literal of base type with key's value (a negative's - before it)
    literal-expr: func(checking: Checker, base: Type, key: string) -> Expr {
        if key.byte-at(0) == 45 {
            let inner = literal-expr(checking, base, key.substring(1, key.len()));
            return { kind: ExprKind.unary({ op: "-", value: inner, }), span: checking.span, ty: base, };
        }
        let kind = match base {
            char-type => ExprKind.char-lit(semtype.decimal(key)),
            string-type => ExprKind.str-lit(key),
            num(name) => if is-int(name) { ExprKind.int-lit(key) } else { ExprKind.float-lit(key) },
            _ => ExprKind.unit,
        };
        { kind: kind, span: checking.span, ty: base, }
    }

    // what holds where an expression is true and where it is false: its is tests of names
    facts: func(checking: Checker, expression: Expr) -> Narrowing {
        match expression.kind {
            is-test(type-test) => {
                match type-test.value.kind {
                    name(name) => {
                        match narrowable(checking, name) {
                            some(mark) => {
                                let symbols = checking.symbols;
                                // (the local's type as its scope has it: its expression's may be
                                // its representation, a literal union's string)
                                let parts = split(
                                    checking,
                                    scope-type(checking, name).unwrap-or(type-test.value.ty),
                                    semtype.translate(symbols, type-test.ty),
                                    some(type-test.ty),
                                );
                                return {
                                    yes: [{ name: name, ty: parts.yes, mark: mark, },],
                                    no: [{ name: name, ty: parts.no, mark: mark, },],
                                };
                            }
                            none => {}
                        }
                    }
                    _ => {}
                }
            }
            unary(operation) => {
                if operation.op == "!" {
                    let operand-facts = facts(checking, operation.value);
                    return { yes: operand-facts.no, no: operand-facts.yes, };
                }
            }
            binary(binary) => {
                if binary.op == "&&" || binary.op == "||" {
                    let left-facts = facts(checking, binary.left);
                    let right-facts = facts(checking, binary.right);
                    // both held (&&), or both failed (||): the right's, found under the left's
                    if binary.op == "&&" { return { yes: narrowed-and(left-facts.yes, right-facts.yes), no: [], }; }
                    return { yes: [], no: narrowed-and(left-facts.no, right-facts.no), };
                }
            }
            _ => {}
        }
        { yes: [], no: [], }
    }

    narrowed-and: func(left: list<Narrowed>, right: list<Narrowed>) -> list<Narrowed> {
        let out: list<Narrowed> = [];
        for left-item in left {
            let later = false;
            for right-item in right {
                if right-item.name == left-item.name { later = true; }
            }
            if !later { out.push(left-item); }
        }
        for right-item in right { out.push(right-item); }
        out
    }

    // a local the func never assigns: its binding's mark (none for another name)
    narrowable: func(checking: Checker, name: Name) -> option<Mark> {
        if checking.assigned.has(name) { return none; }
        let count = checking.scopes.len();
        for step in 0..count {
            let index = count - 1 - step;
            if checking.scopes[index].has(name) { return some(checking.marks[index][name]); }
        }
        none
    }

    // a local's type where it is read (the innermost scope's: a narrowing's there)
    scope-type: func(checking: Checker, name: Name) -> option<Type> {
        let count = checking.scopes.len();
        for step in 0..count {
            let index = count - 1 - step;
            if checking.scopes[index].has(name) { return some(checking.scopes[index][name]); }
        }
        none
    }

    // a scope where the names are narrowed (the same bindings, their types narrower)
    push-narrowing: func(checking: Checker, ns: list<Narrowed>) {
        push-scope(checking, if checking.extents.len() > 0 { checking.extents[checking.extents.len() - 1] } else { nowhere() });
        let scope-index = checking.scopes.len() - 1;
        for narrowed in ns {
            checking.scopes[scope-index].set(narrowed.name, narrowed.ty);
            checking.marks[scope-index].set(narrowed.name, narrowed.mark);
            checking.narrows[scope-index].add(narrowed.name);
        }
    }

    // a type's values split by a set p: those in it (yes) and those not (no). Each member of a
    // union goes to one side, or (some of its values in p) to both; yes takes the members of pt
    // (p as a type, when there is one) a partial member holds
    split: func(checking: Checker, vt: Type, pattern: SemType, pt: option<Type>) -> Split {
        let symbols = checking.symbols;
        let members = union-members(vt);
        let yes: list<Type> = [];
        let no: list<Type> = [];
        for member in members {
            let mt = semtype.translate(symbols, member);
            if semtype.is-empty(symbols, semtype.diff(symbols, mt, pattern)) { yes.push(member); }
            else if semtype.is-empty(symbols, semtype.inter(symbols, mt, pattern)) { no.push(member); }
            else {
                no.push(member);
                yes.push(match pt {
                    some(found) => within(checking, found, member),
                    none => member,
                });
            }
        }
        {
            yes: if yes.len() == 0 { vt } else { union-of(yes) },
            no: if no.len() == 0 { vt } else { union-of(no) },
        }
    }

    // t's values that are m's, as a type: t when all are, else t's members that are (m when none
    // is)
    within: func(checking: Checker, given: Type, member: Type) -> Type {
        if subtype(checking, given, member) { return given; }
        let out: list<Type> = [];
        match resolve(given) {
            union-type(xs) => {
                for item in xs {
                    if subtype(checking, item, member) { out.push(item); }
                }
            }
            _ => {}
        }
        if out.len() == 0 { member } else { union-of(out) }
    }

    is-none-block: func(block: option<Block>) -> bool {
        match block {
            some(_) => false,
            none => true,
        }
    }

    // whether a block always leaves (its last statement a return, break or continue, a loop no
    // break leaves, or a call that never returns)
    leaves: func(block: Block) -> bool {
        if block.stmts.len() == 0 { return false; }
        match block.stmts[block.stmts.len() - 1] {
            return-stmt(_) => true,
            break-stmt => true,
            continue-stmt => true,
            loop-stmt(loop-statement) => !breaks-out(loop-statement.body),
            // a call that never returns (panic, exit)
            expr-stmt(statement) => is-never(statement.value.ty),
            _ => false,
        }
    }

    // whether a break in a block leaves the loop around it (not one in a loop of its own, nor a
    // closure's)
    breaks-out: func(block: Block) -> bool {
        for st in walk.stmts(block, false, false) {
            match st {
                break-stmt => { return true; }
                _ => {}
            }
        }
        false
    }

    // the names a block assigns (=, += and the rest), at any depth, closures' too
    assigned-in: func(block: Block, out: map<Name, bool>) {
        for st in walk.stmts(block, true, true) {
            match st {
                assign(assignment) => out.set(assignment.name, true),
                _ => {}
            }
        }
    }

    // ================================================================ constants

    // a constant's name where the func being checked is: the module's own, then its package's top
    // level; "" for neither
    const-key: func(checking: Checker, name: string) -> string { lookup(checking, checking.scope, name, "const") }

    // whether an expression names where a value is: a variable, or a field of a place or of a
    // resource (a record's field is set there, not in a copy)
    is-place: func(checking: Checker, expression: Expr) -> bool {
        match expression.kind {
            name(_) => true,
            field(field-access) => match resolve(field-access.target.ty) {
                named(name) => (checking.symbols.records.has(name) && !checking.symbols.records[name].value) || is-place(checking, field-access.target),
                _ => is-place(checking, field-access.target),
            },
            _ => false,
        }
    }

    // a global's name where the func being checked is (as const-key: the module's own, then its
    // package's top level); "" for neither
    global-key: func(checking: Checker, name: string) -> string { lookup(checking, checking.scope, name, "global") }

    // a global: its type resolved; it starts as a literal of it, or as its zero value (no code of
    // the program runs before its first: what a global needs made, the program makes)
    check-global: func(checking: Checker, global: GlobalDecl) {
        checking.quiet = false;
        checking.span = global.span;
        checking.scope = global.scope;
        checking.in-func = "let {base-name(global.name)}";
        global.ty = resolve-type(checking, global.scope, global.ty, []);
        match global.value {
            some(value) => {
                if !is-literal(value) {
                    let diagnostic = diagnostics.error(global.span, "a global starts as a literal or as its type's zero value", "");
                    diagnostics.help(diagnostic, "no code runs before the program's first: leave it out (let {base-name(global.name)}: T;) and set it where it is first needed");
                    tell(checking, diagnostic);
                }
                literal-type(checking, global.ty, "a global's literal");
                check(checking, value, global.ty, "the global's value");
            }
            none => {
                if !has-zero(checking, global.ty) {
                    let diagnostic = diagnostics.error(global.span, "a {show-type(global.ty)} has no zero value for the global {base-name(global.name)} to start as", "");
                    diagnostics.help(diagnostic, "hold it in an option (let {base-name(global.name)}: option<{show-type(global.ty)}>;): none until it is set");
                    tell(checking, diagnostic);
                }
            }
        }
    }

    // whether a type has a zero value (what a global starts as): a number's 0, false, '\0', "",
    // none, a list, map or set made empty, and a tuple, anonymous record, fixed-length list or
    // distinct type of such. A record, a variant, a result, a func, a stream's or a future's end
    // has none (a record is a reference, never a null one: an option's none is)
    has-zero: func(checking: Checker, given: Type) -> bool {
        match resolve(given) {
            num(_) => true,
            bool-type => true,
            char-type => true,
            string-type => true,
            unit-type => true,
            option-type(_) => true,
            list-type(_) => true,
            map-type(_) => true,
            tuple-type(xs) => xs.all({ item -> has-zero(checking, item) }),
            anon-record(anonymous) => anonymous.types.all({ item -> has-zero(checking, item) }),
            fixed-list(fixed) => has-zero(checking, fixed.item),
            distinct-type(distinct) => has-zero(checking, distinct.base),
            // a flags type's: none set; a record's (a value's): each field's
            named(name) => checking.symbols.flags.has(name) || (checking.symbols.records.has(name) && checking.symbols.records[name].value && checking.symbols.records[name].field-types.all({ item -> has-zero(checking, item) })),
            _ => false,
        }
    }

    // a constant's literal, copied to where it is used (checked there)
    const-copy: func(checking: Checker, key: string, span: Span) -> Expr {
        copy-literal(checking.symbols.consts[key].value, span)
    }

    copy-literal: func(expression: Expr, span: Span) -> Expr {
        let kind = match expression.kind {
            unary(operation) => ExprKind.unary({ op: operation.op, value: copy-literal(operation.value, span), }),
            _ => expression.kind,
        };
        { kind: kind, span: span, ty: Type.unit-type, }
    }

    // a literal: a number (- before one), a string, a char or a bool
    is-literal: func(expression: Expr) -> bool {
        match expression.kind {
            int-lit(_) => true,
            float-lit(_) => true,
            char-lit(_) => true,
            str-lit(_) => true,
            bool-lit(_) => true,
            unary(operation) => {
                if operation.op != "-" { return false; }
                match operation.value.kind {
                    int-lit(_) => true,
                    float-lit(_) => true,
                    _ => false,
                }
            }
            _ => false,
        }
    }

    // a constant: its value a literal (or a directive, which is one where it is written), of its
    // type (when written)
    check-const: func(checking: Checker, constant: ConstDecl) {
        checking.quiet = false;
        checking.span = constant.span;
        checking.scope = constant.scope;
        checking.in-func = "const {base-name(constant.name)}";
        // (a directive a literal where it is written: #embed's file, #file, #line)
        let directive = match constant.value.kind {
            directive(_) => true,
            _ => false,
        };
        if !is-literal(constant.value) && !directive {
            type-error(checking, "a const's value is a literal: a number, a string, a char or a bool (or a directive: #embed(path), #file, #line)");
        }
        match constant.ty {
            some(t0) => {
                let resolved = resolve-type(checking, constant.scope, t0, []);
                constant.ty = some(resolved);
                literal-type(checking, resolved, "a const");
                check(checking, constant.value, resolved, "the const's value");
            }
            none => { check(checking, constant.value, fresh(checking), "the const's value"); }
        }
    }
}
