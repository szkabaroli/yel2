// Lowering: a file's syntax tree (grammar.yel's) to what the checker reads, the declarations and
// their statements, expressions, patterns and types (syntax.yel's AST), each where it is written.
// What the parser only reads, this gives a meaning: the scope a declaration is in (its package,
// module, includes and attributes), a literal's value (a string's escapes, a multiline one's lines
// past its indent), what yel writes for what it says (xs[i] is xs.at(i), wait for a stream's
// loop, an arm for each alternative that binds), and the yel made from what is written (a view's
// resource and funcs, a regex literal's matcher), parsed in turn. Its errors are those of what a
// tree means (a package's name across files, a view's names, a regex's pattern); the language
// server's notes of where each declaration and type name is written are made here too.

// a file being lowered: its context and source, its text and where each line starts (a span's
// line and column), its tree, the scope it declares in, the declarations its expressions made
// (a regex's matcher: the next declaration's place's), and the attributes on what it lowers
resource Lowerer {
    context: Context,
    source: s64,
    text: string,
    lines: list<s64>,
    root: SyntaxNode,
    scope: Scope,
    made: list<Decl>,
    testing: bool,
    observable: bool,
    in-context: bool,
    // @(container): the widget being lowered takes items (parts: only those, @(container(Tab));
    // none: any); @(base): it is only other widgets' base, drawn by none
    container: bool,
    parts: list<string>,
    base: bool,
}

module lower {
    // a reader of sources[source]: its tree parsed (kept in the context's trees), its scope its
    // file's (a first line //+build <target>: what its funcs are made for)
    // the names the file's #embed directives give (each a string written out; another is the
    // checker's error), in order
    embedded: func(lowering: Lowerer) -> list<string> {
        let out: list<string> = [];
        embedded-in(lowering, lowering.root, out);
        out
    }

    @(private) embedded-in: func(lowering: Lowerer, node: SyntaxNode, out: list<string>) {
        for child in tree.child-nodes(node) {
            if tree.kind(child) == NodeKind.directive && tokens(child)[0].green.text == "#embed" {
                match args(lowering, child).get(0) {
                    some(given) => match given.kind {
                        str-lit(name) => out.push(name),
                        _ => {}
                    },
                    none => {}
                }
            }
            embedded-in(lowering, child, out);
        }
    }

    reader: func(context: Context, source: s64) -> Lowerer {
        let green = grammar.parse-file(context, source);
        lowerer(context, source, green)
    }

    @(private) lowerer: func(context: Context, source: s64, green: GreenNode) -> Lowerer {
        let text = context.sources[source].text;
        let lines: list<s64> = [0,];
        for index in 0..text.len() {
            if text.byte-at(index) == 10 { lines.push(index + 1); }
        }
        let lowering: Lowerer = {
            context: context,
            source: source,
            text: text,
            lines: lines,
            root: tree.root(green),
            scope: blank-scope(context.sources[source].path),
            made: [],
            testing: false,
            observable: false,
            container: false,
            parts: [],
            base: false,
            in-context: false,
        };
        if starts-with(text, "//+build ") {
            let line = text.substring(9, text.find-byte(10).unwrap-or(text.len())).trim();
            if line != "native" && line != "wasi" {
                let at: Span = { source: source, line: 1, col: 10, end-line: 1, end-col: 10 + line.len(), };
                diagnostics.report(context, diagnostics.error(at, "a build target is native or wasi, not {line}", ""));
            }
            lowering.scope.build = line;
        }
        lowering
    }

    // the file's declarations, into out (what their expressions made after each)
    declarations: func(lowering: Lowerer, out: list<Decl>) {
        for child in tree.child-nodes(lowering.root) { declaration-made(lowering, child, out); }
    }

    @(private) declaration-made: func(lowering: Lowerer, node: SyntaxNode, out: list<Decl>) {
        declaration(lowering, node, out);
        for extra in lowering.made { out.push(extra); }
        lowering.made = [];
    }

    // ================================================================ the tree read

    // its child nodes
    nodes: func(node: SyntaxNode) -> list<SyntaxNode> { tree.child-nodes(node) }

    first-node: func(node: SyntaxNode) -> option<SyntaxNode> {
        let all = tree.child-nodes(node);
        if all.len() == 0 { none } else { some(all[0]) }
    }

    // its child nodes of kind
    nodes-of: func(node: SyntaxNode, kind: NodeKind) -> list<SyntaxNode> {
        tree.child-nodes(node).filter({ child -> tree.kind(child) == kind })
    }

    // its first child node of kind
    first-of: func(node: SyntaxNode, kind: NodeKind) -> option<SyntaxNode> {
        for child in tree.child-nodes(node) {
            if tree.kind(child) == kind { return some(child); }
        }
        none
    }

    // its own tokens (not its children's), whitespace and comments left out
    tokens: func(node: SyntaxNode) -> list<SyntaxToken> { tree.own-tokens(node) }

    // whether it has a token of its own that is the operator or word v
    has: func(node: SyntaxNode, word: string) -> bool { tree.has-word(node, word) }

    // whether a token is the operator or word v (a name written %name is no word)
    is-word: func(token: SyntaxToken, word: string) -> bool {
        (token.green.kind == TokenKind.op || token.green.kind == TokenKind.id) && token.green.text == word
    }

    // its first own token that is a name (its text past a %: the name's)
    first-name: func(node: SyntaxNode) -> option<SyntaxToken> {
        for token in tokens(node) {
            if token.green.kind == TokenKind.id { return some(token); }
        }
        none
    }

    // a name token's name (%name: what follows the %)
    token-name: func(token: SyntaxToken) -> string {
        if token.green.text.starts-with("%") { token.green.text.substring(1, token.green.text.len()) } else { token.green.text }
    }

    // the first and the last token in it (its children's too), whitespace and comments left out
    first-token: func(node: SyntaxNode) -> option<SyntaxToken> { tree.first-token(node) }

    last-token: func(node: SyntaxNode) -> option<SyntaxToken> { tree.last-token(node) }

    // the token (not trivia) right after n in its parent: none where a node or nothing is
    token-after: func(syntax-node: SyntaxNode) -> option<SyntaxToken> {
        match syntax-node.parent {
            some(parent) => {
                let seen = false;
                for child in tree.children(parent) {
                    match child {
                        node(inner) => {
                            if seen { return none; }
                            if inner.index == syntax-node.index { seen = true; }
                        }
                        token(leaf) => { if seen && !tree.is-trivia(leaf.green.kind) { return some(leaf); } }
                    }
                }
                none
            }
            none => none,
        }
    }

    // the span of the first token at or past byte at in the file (the parser's next token there:
    // the end of the file's, past its last)
    next-token-span: func(lowering: Lowerer, at: s64) -> Span {
        match tree.token-from(lowering.root, at) {
            some(token) => token-span(lowering, token),
            none => span(lowering, lowering.text.len(), lowering.text.len()),
        }
    }

    // ================================================================ spans

    // the line (from 1) byte at is on
    @(private) line-at: func(lowering: Lowerer, at: s64) -> s64 {
        let low = 0;
        let high = lowering.lines.len() - 1;
        loop {
            if low >= high { break; }
            let middle = (low + high + 1) / 2;
            if lowering.lines[middle] <= at { low = middle; } else { high = middle - 1; }
        }
        low + 1
    }

    // bytes from start to end as a span: its first line and column, and those just past its end
    span: func(lowering: Lowerer, start: s64, end: s64) -> Span {
        let first = line-at(lowering, start);
        let last = line-at(lowering, end);
        {
            source: lowering.source,
            line: first,
            col: start - lowering.lines[first - 1] + 1,
            end-line: last,
            end-col: end - lowering.lines[last - 1] + 1,
        }
    }

    token-span: func(lowering: Lowerer, token: SyntaxToken) -> Span { span(lowering, token.offset, token.offset + token.green.text.len()) }

    // a node's span: from its first token to the end of its last
    node-span: func(lowering: Lowerer, node: SyntaxNode) -> Span {
        match first-token(node) {
            some(first) => from-to-end(lowering, token-span(lowering, first), node),
            none => span(lowering, node.offset, node.offset),
        }
    }

    // from where start starts to the end of n's last token (span-from: a span made of what its
    // first part starts at, an operand's span looking past its parens)
    from-to-end: func(lowering: Lowerer, start: Span, node: SyntaxNode) -> Span {
        match last-token(node) {
            some(last) => {
                let end = token-span(lowering, last);
                { source: start.source, line: start.line, col: start.col, end-line: end.end-line, end-col: end.end-col, }
            }
            none => start,
        }
    }

    // the span of the token after n's first own token v (where a name follows a keyword)
    @(private) after-word: func(lowering: Lowerer, syntax-node: SyntaxNode, word: string) -> Span {
        let seen = false;
        for child in tree.children(syntax-node) {
            match child {
                token(leaf) => {
                    if tree.is-trivia(leaf.green.kind) { continue; }
                    if seen { return token-span(lowering, leaf); }
                    if is-word(leaf, word) { seen = true; }
                }
                node(inner) => {
                    if seen {
                        match first-token(inner) {
                            some(first) => { return token-span(lowering, first); }
                            none => {}
                        }
                    }
                }
            }
        }
        node-span(lowering, syntax-node)
    }

    // ================================================================ made of what the parser read

    node: func(kind: ExprKind, span: Span) -> Expr { { kind: kind, span: span, ty: Type.unit-type, } }

    // a binding's mark (not captured, until the checker finds it is), at the name it binds
    new-mark: func(name: string, span: Span) -> Mark { { captured: false, unit: { env: false, }, ty: Type.unit-type, name: name, span: span, slot: -1, } }

    new-marks: func(names: list<string>, spans: list<Span>) -> list<Mark> {
        let out: list<Mark> = [];
        for index in 0..names.len() { out.push(new-mark(names[index], spans[index])); }
        out
    }

    name-pattern: func(name: string, binds: bool, span: Span) -> Pattern {
        Pattern.name({ name: name, binds: binds, kind: "", key: "", value: none, mark: new-mark(name, span), span: span, })
    }

    // ================================================================ types

    // a type node as the type it is (none there: unit)
    type-of: func(lowering: Lowerer, node: option<SyntaxNode>) -> Type {
        match node {
            some(child) => parse-type(lowering, child),
            none => Type.unit-type,
        }
    }

    parse-type: func(lowering: Lowerer, syntax-node: SyntaxNode) -> Type {
        let kind = tree.kind(syntax-node);
        if kind == NodeKind.union-type {
            let members: list<Type> = [];
            for part in nodes(syntax-node) { members.push(parse-type(lowering, part)); }
            return Type.union-type(members);
        }
        if kind == NodeKind.readonly-type { return Type.readonly-type(type-of(lowering, first-node(syntax-node))); }
        if kind == NodeKind.unit-type { return Type.unit-type; }
        if kind == NodeKind.record-type {
            let fields: list<string> = [];
            let types: list<Type> = [];
            for part in nodes-of(syntax-node, NodeKind.record-type-field) {
                match first-name(part) {
                    some(written) => fields.push(token-name(written)),
                    none => fields.push(""),
                }
                types.push(type-of(lowering, first-node(part)));
            }
            return Type.anon-record({ fields: fields, types: types, name: "", });
        }
        if kind == NodeKind.literal-type {
            let expression = expr-of(lowering, first-node(syntax-node));
            return literal-type(expression);
        }
        if kind == NodeKind.range-type {
            let ends = nodes(syntax-node);
            if ends.len() < 2 { return Type.unit-type; }
            let lo = expr(lowering, ends[0]);
            let hi = expr(lowering, ends[1]);
            return range-type(lo, hi, has(syntax-node, "..="));
        }
        if kind == NodeKind.func-type {
            // (where a built-in type's name is written)
            note-built-in(lowering, syntax-node, "func");
            let params: list<Type> = [];
            let result = Type.unit-type;
            let past-arrow = false;
            for child in tree.children(syntax-node) {
                match child {
                    token(leaf) => { if is-word(leaf, "->") { past-arrow = true; } }
                    node(inner) => {
                        if past-arrow { result = parse-type(lowering, inner); } else { params.push(parse-type(lowering, inner)); }
                    }
                }
            }
            return Type.func-type({ params: params, result: result, });
        }
        named-type(lowering, syntax-node)
    }

    // a type named (module.name), its arguments as its name takes them
    named-type: func(lowering: Lowerer, node: SyntaxNode) -> Type {
        let parts: list<string> = [];
        for token in tokens(node) {
            if token.green.kind == TokenKind.id { parts.push(token-name(token)); }
        }
        let name = parts.join(".");
        let args: list<SyntaxNode> = [];
        let marks: list<SyntaxToken> = [];
        match first-of(node, NodeKind.type-args) {
            some(child) => {
                args = nodes(child);
                marks = tokens(child);
            }
            none => {}
        }
        note-built-in(lowering, node, name);
        let arg = { index: s64 -> if index < args.len() { parse-type(lowering, args[index]) } else { Type.unit-type } };
        if name == "map" { return Type.map-type({ key: arg(0), value: arg(1), }); }
        if name == "set" { return Type.map-type({ key: arg(0), value: Type.unit-type, }); }
        if name == "list" || name == "option" || name == "future" || name == "seq" || name == "stream" || name == "writer" {
            let inner = arg(0);
            // list<T, N> or list<T, ?>: fixed-length
            for mark in marks {
                if name == "list" && mark.green.kind == TokenKind.int { return Type.fixed-list({ item: inner, len: decimal(mark.green.text), }); }
                if name == "list" && is-word(mark, "?") { return Type.fixed-list({ item: inner, len: -1, }); }
            }
            if name == "list" { return Type.list-type(inner); }
            if name == "future" { return Type.future-type(inner); }
            if name == "seq" { return Type.seq-type(inner); }
            if name == "stream" || name == "writer" { return Type.stream-type({ item: inner, writer: name == "writer", }); }
            return Type.option-type(inner);
        }
        if name == "tuple" {
            let items: list<Type> = [];
            for argument in args { items.push(parse-type(lowering, argument)); }
            return Type.tuple-type(items);
        }
        if name == "result" {
            let ok = if args.len() > 0 { result-part(lowering, args[0]) } else { Type.unit-type };
            let err = if args.len() > 1 { result-part(lowering, args[1]) } else { Type.unit-type };
            return Type.result-type({ ok: ok, err: err, });
        }
        let num = num-name(name);
        if num != "" { return Type.num(num); }
        if name == "bool" { return Type.bool-type; }
        if name == "char" { return Type.char-type; }
        if name == "string" { return Type.string-type; }
        if name == "buffer" { return Type.buffer-type; }
        if name == "never" { return Type.never-type; }
        // (where a declared type's name is written: what it names the checker finds, once it knows)
        if !lowering.context.exits { lowering.context.type-names.push({ name: name, span: node-span(lowering, node), scope: lowering.scope, }); }
        Type.named(intern(name))
    }

    // a result's payload type, or _ for none
    @(private) result-part: func(lowering: Lowerer, node: SyntaxNode) -> Type {
        if tree.kind(node) == NodeKind.named-type && tokens(node).len() == 1 && tokens(node)[0].green.text == "_" { return Type.unit-type; }
        parse-type(lowering, node)
    }

    // (where a built-in type's name is written: what it is a language server tells)
    @(private) note-built-in: func(lowering: Lowerer, node: SyntaxNode, name: string) {
        if lowering.context.exits || !built-in-type(name) { return; }
        // (its name, module.name: from its first token to its last name's)
        let names = tokens(node).filter({ token -> token.green.kind == TokenKind.id || is-word(token, ".") });
        if names.len() == 0 { return; }
        let first = token-span(lowering, names[0]);
        let last = token-span(lowering, names[names.len() - 1]);
        lowering.context.uses.push({
            span: { source: first.source, line: first.line, col: first.col, end-line: last.end-line, end-col: last.end-col, },
            key: "builtin:{name}",
            local: none,
            ty: Type.unit-type,
            text: "",
        });
    }

    // a decimal's value (a fixed-length list's length)
    @(private) decimal: func(digits: string) -> s64 {
        let total = 0;
        for position in 0..digits.len() {
            let byte = digits.byte-at(position);
            if is-digit(byte) { total = total * 10 + (byte - 48); }
        }
        total
    }

    // a literal type: its one value's (a number's, a string's, a char's, a bool's)
    literal-type: func(expression: Expr) -> Type {
        let base = match expression.kind {
            int-lit(_) => Type.num("s32"),
            float-lit(_) => Type.num("f32"),
            char-lit(_) => Type.char-type,
            str-lit(_) => Type.string-type,
            bool-lit(_) => Type.bool-type,
            unary(operand) => match operand.value.kind {
                float-lit(_) => Type.num("f32"),
                _ => Type.num("s32"),
            },
            _ => Type.unit-type,
        };
        let key = semtype.literal-key(expression);
        let text = match expression.kind {
            str-lit(literal) => "\"{literal}\"",
            char-lit(byte) => "'{from-byte(byte)}'",
            _ => key,
        };
        Type.singleton({ base: base, key: key, text: text, })
    }

    // lo..=hi as a type: its keys (hi the last value: one before an exclusive range's end)
    range-type: func(lo: Expr, hi: Expr, inclusive: bool) -> Type {
        let base = match lo.kind {
            char-lit(_) => Type.char-type,
            int-lit(_) => Type.num("s32"),
            unary(_) => Type.num("s32"),
            _ => Type.unit-type,
        };
        let lk = semtype.literal-key(lo);
        let hk = semtype.literal-key(hi);
        let last = if inclusive { hk } else { semtype.decimal-before(hk) };
        let text = "{range-end-text(lo)}{if inclusive { "..=" } else { ".." }}{range-end-text(hi)}";
        Type.range-type({ base: base, lo: lk, hi: last, text: text, })
    }

    @(private) range-end-text: func(expression: Expr) -> string {
        match expression.kind {
            char-lit(byte) => "'{from-byte(byte)}'",
            _ => semtype.literal-key(expression),
        }
    }

    // a number type's name (int is s32 and float f32; they are written as those)
    num-name: func(name: string) -> string {
        if name == "int" { return "s32"; }
        if name == "float" { return "f32"; }
        for candidate in ["s8", "s16", "s32", "s64", "u8", "u16", "u32", "u64", "f32", "f64",] {
            if name == candidate { return name; }
        }
        ""
    }

    // whether a type's name is yel's own (no declaration names it)
    built-in-type: func(name: string) -> bool {
        [
            "bool", "char", "string", "buffer", "never", "s8", "s16", "s32", "s64", "u8", "u16", "u32", "u64",
            "f32", "f64", "list", "map", "set", "option", "result", "tuple", "stream", "writer", "future", "seq",
        ].contains(name)
    }

    // ================================================================ patterns

    // a pattern; binds: whether a bare name binds here
    pattern: func(lowering: Lowerer, syntax-node: SyntaxNode, binds: bool) -> Pattern {
        let kind = tree.kind(syntax-node);
        if kind == NodeKind.alt-pattern {
            let alts: list<Pattern> = [];
            for child in nodes(syntax-node) { alts.push(pattern(lowering, child, binds)); }
            return Pattern.alt(alts);
        }
        if kind == NodeKind.wild-pattern { return Pattern.wild; }
        if kind == NodeKind.let-pattern {
            match first-node(syntax-node) {
                some(inner) => { return pattern(lowering, inner, true); }
                none => { return Pattern.wild; }
            }
        }
        if kind == NodeKind.typed-pattern {
            // (its name's span the let's, where the pattern starts)
            let start = node-span-first-token(lowering, syntax-node);
            let named = match first-name(syntax-node) {
                some(_) => name-text-after-let(syntax-node),
                none => "",
            };
            return Pattern.typed({ ty: type-of(lowering, first-node(syntax-node)), sub: name-pattern(named, true, start), test: none, });
        }
        if kind == NodeKind.literal-pattern { return Pattern.literal(expr-of(lowering, first-node(syntax-node))); }
        if kind == NodeKind.range-pattern {
            let ends = nodes(syntax-node);
            let lo = if ends.len() > 0 { expr(lowering, ends[0]) } else { node(ExprKind.unit, nowhere()) };
            let hi = if ends.len() > 1 { expr(lowering, ends[1]) } else { node(ExprKind.unit, nowhere()) };
            return Pattern.range({ lo: lo, hi: hi, inclusive: has(syntax-node, "..="), span: node-span(lowering, syntax-node), });
        }
        if kind == NodeKind.record-pattern {
            let fields: list<string> = [];
            let field-spans: list<Span> = [];
            let patterns: list<Pattern> = [];
            let rest = "";
            for child in nodes(syntax-node) {
                if tree.kind(child) == NodeKind.rest-pattern {
                    match first-name(child) {
                        some(token) => { rest = token-name(token); }
                        none => {}
                    }
                    continue;
                }
                match first-name(child) {
                    some(token) => {
                        let field = token-name(token);
                        fields.push(field);
                        field-spans.push(token-span(lowering, token));
                        match first-node(child) {
                            some(sub) => patterns.push(pattern(lowering, sub, binds)),
                            none => patterns.push(name-pattern(field, binds, token-span(lowering, token))),
                        }
                    }
                    none => {}
                }
            }
            let whole = node-span(lowering, syntax-node);
            return Pattern.record({
                fields: fields,
                field-spans: field-spans,
                patterns: patterns,
                rest: rest,
                rest-mark: new-mark(rest, whole),
                span: whole,
            });
        }
        if kind == NodeKind.tuple-pattern {
            let items: list<Pattern> = [];
            for child in nodes(syntax-node) { items.push(pattern(lowering, child, binds)); }
            return Pattern.tuple(items);
        }
        if kind == NodeKind.paren-pattern {
            match first-node(syntax-node) {
                some(inner) => { return pattern(lowering, inner, binds); }
                none => { return Pattern.wild; }
            }
        }
        if kind == NodeKind.case-pattern {
            let named = first-name(syntax-node);
            let name = match named {
                some(token) => token-name(token),
                none => "",
            };
            let name-span = match named {
                some(token) => token-span(lowering, token),
                none => nowhere(),
            };
            let sub = match first-node(syntax-node) {
                some(inner) => pattern(lowering, inner, true),
                none => Pattern.wild,
            };
            return Pattern.case({ name: name, sub: sub, span: node-span(lowering, syntax-node), name-span: name-span, });
        }
        // a name
        match first-name(syntax-node) {
            some(token) => name-pattern(token-name(token), binds, token-span(lowering, token)),
            none => Pattern.wild,
        }
    }

    // the span of a node's first token
    @(private) node-span-first-token: func(lowering: Lowerer, node: SyntaxNode) -> Span {
        match first-token(node) {
            some(token) => token-span(lowering, token),
            none => nowhere(),
        }
    }

    // let n: T: the name after its let
    @(private) name-text-after-let: func(node: SyntaxNode) -> string {
        for token in tokens(node) {
            if token.green.kind == TokenKind.id && token.green.text != "let" { return token-name(token); }
        }
        ""
    }

    // a pattern as patterns whose alternatives bind nothing: each alternative that may bind taken
    // out to the top (some(a(x) | b(x)) is some(a(x)) and some(b(x))), one pattern for each
    alternatives: func(pat: Pattern) -> list<Pattern> {
        match pat {
            alt(ps) => {
                if !may-bind(pat) { return [pat,]; }
                let out: list<Pattern> = [];
                for pattern in ps {
                    for alternative in alternatives(pattern) { out.push(alternative); }
                }
                out
            }
            case(pc) => {
                let out: list<Pattern> = [];
                for alternative in alternatives(pc.sub) { out.push(Pattern.case({ name: pc.name, sub: alternative, span: pc.span, name-span: pc.name-span, })); }
                out
            }
            typed(annotated) => {
                let out: list<Pattern> = [];
                for alternative in alternatives(annotated.sub) { out.push(Pattern.typed({ ty: annotated.ty, sub: alternative, test: annotated.test, })); }
                out
            }
            member(selected) => {
                let out: list<Pattern> = [];
                for alternative in alternatives(selected.sub) { out.push(Pattern.member({ ty: selected.ty, sub: alternative, })); }
                out
            }
            tuple(ps) => {
                let out: list<Pattern> = [];
                for each in product(ps) { out.push(Pattern.tuple(each)); }
                out
            }
            record(pr) => {
                let out: list<Pattern> = [];
                for each in product(pr.patterns) {
                    out.push(Pattern.record({
                        fields: pr.fields,
                        field-spans: pr.field-spans,
                        patterns: each,
                        rest: pr.rest,
                        rest-mark: pr.rest-mark,
                        span: pr.span,
                    }));
                }
                out
            }
            _ => [pat,],
        }
    }

    // each choice of one alternative of each pattern, in order
    product: func(ps: list<Pattern>) -> list<list<Pattern>> {
        let out: list<list<Pattern>> = [[],];
        for pattern in ps {
            let next: list<list<Pattern>> = [];
            for prefix in out {
                for alternative in alternatives(pattern) {
                    let one: list<Pattern> = [];
                    for part in prefix { one.push(part); }
                    one.push(alternative);
                    next.push(one);
                }
            }
            out = next;
        }
        out
    }

    // whether a pattern may bind a name (a name where one binds, ...rest, let n: T)
    may-bind: func(pat: Pattern) -> bool {
        match pat {
            name(pn) => pn.binds,
            case(pc) => may-bind(pc.sub),
            record(pr) => {
                if pr.rest != "" { return true; }
                for pattern in pr.patterns {
                    if may-bind(pattern) { return true; }
                }
                false
            }
            tuple(ps) => {
                for pattern in ps {
                    if may-bind(pattern) { return true; }
                }
                false
            }
            alt(ps) => {
                for pattern in ps {
                    if may-bind(pattern) { return true; }
                }
                false
            }
            typed(_) => true,
            member(selected) => may-bind(selected.sub),
            _ => false,
        }
    }

    // ================================================================ expressions

    expr-of: func(lowering: Lowerer, syntax-node: option<SyntaxNode>) -> Expr {
        match syntax-node {
            some(child) => expr(lowering, child),
            none => node(ExprKind.unit, nowhere()),
        }
    }

    expr: func(lowering: Lowerer, syntax-node: SyntaxNode) -> Expr {
        let kind = tree.kind(syntax-node);
        let parts = nodes(syntax-node);
        let part = { index: s64 -> if index < parts.len() { expr(lowering, parts[index]) } else { node(ExprKind.unit, nowhere()) } };
        if kind == NodeKind.literal {
            let token = tokens(syntax-node)[0];
            let at = token-span(lowering, token);
            if token.green.kind == TokenKind.int { return node(ExprKind.int-lit(token.green.text), at); }
            if token.green.kind == TokenKind.float { return node(ExprKind.float-lit(token.green.text), at); }
            if token.green.kind == TokenKind.char { return node(ExprKind.char-lit(char-code(token.green.text.substring(1, token.green.text.len() - 1))), at); }
            return node(ExprKind.bool-lit(token.green.text == "true"), at);
        }
        if kind == NodeKind.string-lit { return string(lowering, syntax-node); }
        if kind == NodeKind.regex-lit { return regex(lowering, syntax-node); }
        if kind == NodeKind.directive {
            let written = tokens(syntax-node)[0].green.text;
            return node(ExprKind.directive({ name: written.substring(1, written.len()), args: args(lowering, syntax-node), }), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.unit-expr { return node(ExprKind.unit, node-span-first-token(lowering, syntax-node)); }
        if kind == NodeKind.paren-expr { return part(0); }
        if kind == NodeKind.tuple-expr {
            let items: list<Expr> = [];
            for piece in parts { items.push(expr(lowering, piece)); }
            return node(ExprKind.tuple-lit(items), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.list-expr {
            let items: list<Expr> = [];
            for piece in parts { items.push(expr(lowering, piece)); }
            return node(ExprKind.list-lit(items), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.if-expr {
            let cond = part(0);
            let then = if parts.len() > 1 { block(lowering, parts[1]) } else { empty-block() };
            let otherwise: option<Block> = none;
            if parts.len() > 2 {
                let other = parts[2];
                if tree.kind(other) == NodeKind.if-expr {
                    let chained = expr(lowering, other);
                    otherwise = some({
                        stmts: [Stmt.expr-stmt({ value: chained, is-value: true, }),],
                        spans: [chained.span,],
                        span: chained.span,
                    });
                } else {
                    otherwise = some(block(lowering, other));
                }
            }
            return node(ExprKind.if-else({ cond: cond, then: then, otherwise: otherwise, }), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.closure { return node(ExprKind.closure(closure(lowering, syntax-node)), node-span(lowering, syntax-node)); }
        if kind == NodeKind.record-expr {
            let fields: list<FieldInit> = [];
            for child in nodes-of(syntax-node, NodeKind.record-field) {
                match first-name(child) {
                    some(token) => fields.push({ name: token-name(token), value: expr-of(lowering, first-node(child)), name-span: token-span(lowering, token), }),
                    none => {}
                }
            }
            return node(ExprKind.record-lit(fields), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.match-expr {
            let value = part(0);
            let arms: list<Arm> = [];
            for arm in nodes-of(syntax-node, NodeKind.match-arm) {
                for alternative in arm-each(lowering, arm) { arms.push(alternative); }
            }
            return node(ExprKind.match-expr({ value: value, arms: arms, }), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.block { return node(ExprKind.block(block(lowering, syntax-node)), node-span(lowering, syntax-node)); }
        if kind == NodeKind.name-ref {
            match first-name(syntax-node) {
                some(token) => { return node(ExprKind.name(intern(token-name(token))), token-span(lowering, token)); }
                none => { return node(ExprKind.unit, node-span(lowering, syntax-node)); }
            }
        }
        if kind == NodeKind.field-expr {
            let target = part(0);
            let named = member-name(syntax-node);
            match named {
                some(token) => {
                    let name = if token.green.kind == TokenKind.int { token.green.text } else { token-name(token) };
                    return node(ExprKind.field({ target: target, name: name, name-span: token-span(lowering, token), }), from-to-end(lowering, target.span, syntax-node));
                }
                none => {
                    // (x. with no name yet: kept, zero wide just past the dot)
                    let dot = dot-span(lowering, syntax-node);
                    let at: Span = { source: dot.source, line: dot.end-line, col: dot.end-col, end-line: dot.end-line, end-col: dot.end-col, };
                    return node(ExprKind.field({ target: target, name: "", name-span: at, }), from-to-end(lowering, target.span, syntax-node));
                }
            }
        }
        if kind == NodeKind.method-call-expr {
            let target = part(0);
            let named = member-name(syntax-node);
            let name = match named {
                some(token) => token-name(token),
                none => "",
            };
            let name-span = match named {
                some(token) => token-span(lowering, token),
                none => nowhere(),
            };
            return node(
                ExprKind.method({ target: target, name: name, args: args(lowering, syntax-node), type-args: [], name-span: name-span, }),
                from-to-end(lowering, target.span, syntax-node),
            );
        }
        if kind == NodeKind.call-expr {
            let callee = part(0);
            return node(
                ExprKind.call({ name: expr-name(callee), args: args(lowering, syntax-node), type-args: [], name-span: callee.span, }),
                from-to-end(lowering, callee.span, syntax-node),
            );
        }
        if kind == NodeKind.apply-expr {
            let callee = part(0);
            return node(ExprKind.apply({ callee: callee, args: args(lowering, syntax-node), }), from-to-end(lowering, callee.span, syntax-node));
        }
        if kind == NodeKind.index-expr {
            let target = part(0);
            return node(
                ExprKind.method({ target: target, name: "at", args: [part(1),], type-args: [], name-span: nowhere(), }),
                from-to-end(lowering, target.span, syntax-node),
            );
        }
        if kind == NodeKind.binary-expr {
            let left = part(0);
            let op = tokens(syntax-node).map({ token -> token.green.text }).join("");
            return node(ExprKind.binary({ op: op, left: left, right: part(1), }), from-to-end(lowering, left.span, syntax-node));
        }
        if kind == NodeKind.is-expr {
            let value = part(0);
            return node(ExprKind.is-test({ value: value, ty: type-of(lowering, if parts.len() > 1 { some(parts[1]) } else { none }), pattern: none, }), from-to-end(lowering, value.span, syntax-node));
        }
        if kind == NodeKind.cast-expr || kind == NodeKind.try-cast-expr {
            let value = part(0);
            let ty = type-of(lowering, if parts.len() > 1 { some(parts[1]) } else { none });
            let made = if kind == NodeKind.cast-expr {
                ExprKind.cast({ value: value, ty: ty, })
            } else {
                ExprKind.try-as({ value: value, ty: ty, pattern: none, })
            };
            return node(made, from-to-end(lowering, value.span, syntax-node));
        }
        if kind == NodeKind.unary-expr {
            let op = tokens(syntax-node)[0].green.text;
            return node(ExprKind.unary({ op: op, value: part(0), }), node-span(lowering, syntax-node));
        }
        if kind == NodeKind.yield-expr { return node(ExprKind.yield-expr(part(0)), node-span(lowering, syntax-node)); }
        if kind == NodeKind.start-expr { return node(ExprKind.start-expr(part(0)), node-span(lowering, syntax-node)); }
        if kind == NodeKind.wait-expr {
            let fields: list<string> = [];
            let values: list<Expr> = [];
            if has(syntax-node, "\{") {
                for child in nodes-of(syntax-node, NodeKind.wait-field) {
                    match first-name(child) {
                        some(token) => fields.push(token-name(token)),
                        none => fields.push(""),
                    }
                    values.push(expr-of(lowering, first-node(child)));
                }
                return node(ExprKind.wait-expr({ mode: "all", values: values, fields: fields, }), node-span(lowering, syntax-node));
            }
            for piece in parts { values.push(expr(lowering, piece)); }
            let mode: wait-mode = if values.len() > 1 { "any" } else { "one" };
            return node(ExprKind.wait-expr({ mode: mode, values: values, fields: [], }), node-span(lowering, syntax-node));
        }
        node(ExprKind.unit, node-span(lowering, syntax-node))
    }

    // a call's arguments (its arg-list's)
    args: func(lowering: Lowerer, node: SyntaxNode) -> list<Expr> {
        let out: list<Expr> = [];
        match first-of(node, NodeKind.arg-list) {
            some(list) => { for child in nodes(list) { out.push(expr(lowering, child)); } }
            none => {}
        }
        out
    }

    // a member's name: the name (or a tuple field's number) after its .
    @(private) member-name: func(node: SyntaxNode) -> option<SyntaxToken> {
        let dot = false;
        for token in tokens(node) {
            if is-word(token, ".") { dot = true; }
            else if dot && (token.green.kind == TokenKind.id || token.green.kind == TokenKind.int) { return some(token); }
        }
        none
    }

    @(private) dot-span: func(lowering: Lowerer, node: SyntaxNode) -> Span {
        for token in tokens(node) {
            if is-word(token, ".") { return token-span(lowering, token); }
        }
        node-span(lowering, node)
    }

    // a match arm, an arm for each alternative of its pattern that binds (its guard and body
    // lowered again for each: their own nodes, each checked with its own bindings' types)
    arm-each: func(lowering: Lowerer, arm: SyntaxNode) -> list<Arm> {
        let parts = nodes(arm);
        let out: list<Arm> = [];
        if parts.len() == 0 { return out; }
        let guarded = has(arm, "if");
        let count = alternatives(pattern(lowering, parts[0], false)).len();
        for position in 0..count {
            let chosen = alternatives(pattern(lowering, parts[0], false))[position];
            let guard: option<Expr> = if guarded && parts.len() > 1 { some(expr(lowering, parts[1])) } else { none };
            let body-node = parts[parts.len() - 1];
            let body = if parts.len() < (if guarded { 3 } else { 2 }) {
                node(ExprKind.unit, nowhere())
            } else if tree.kind(body-node) == NodeKind.block {
                node(ExprKind.block(block(lowering, body-node)), node-span(lowering, body-node))
            } else {
                expr(lowering, body-node)
            };
            out.push({ pattern: chosen, guard: guard, body: body, span: node-span(lowering, arm), });
        }
        out
    }

    // { params -> body }: a closure literal (its body's block from the -> to the })
    closure: func(lowering: Lowerer, node: SyntaxNode) -> Closure {
        let params: list<string> = [];
        let spans: list<Span> = [];
        let types: list<option<Type>> = [];
        for child in nodes-of(node, NodeKind.closure-param) {
            match first-name(child) {
                some(token) => {
                    params.push(token-name(token));
                    spans.push(token-span(lowering, token));
                }
                none => {
                    params.push("");
                    spans.push(nowhere());
                }
            }
            types.push(match first-node(child) {
                some(ty) => some(parse-type(lowering, ty)),
                none => none,
            });
        }
        let arrow = nowhere();
        for token in tokens(node) {
            if is-word(token, "->") { arrow = token-span(lowering, token); }
        }
        let body = statements(lowering, node, from-to-end(lowering, arrow, node));
        { params: params, types: types, body: body, marks: new-marks(params, spans), unit: { env: false, }, }
    }

    // ---- strings

    // "text {expr} text": a string literal (one piece of text), or an interpolation of its pieces
    // (the text between written nowhere of its own: the compiler's split of it)
    string: func(lowering: Lowerer, syntax-node: SyntaxNode) -> Expr {
        let at = node-span(lowering, syntax-node);
        let kept = kept-bytes(lowering, syntax-node);
        let parts: list<Expr> = [];
        let chars = buffer(16);
        for child in tree.children(syntax-node) {
            match child {
                token(leaf) => {
                    if leaf.green.kind == TokenKind.string-text { decoded-into(leaf, kept, chars); }
                }
                node(inner) => {
                    if tree.kind(inner) != NodeKind.interpolation { continue; }
                    if chars.len() > 0 { parts.push(node(ExprKind.str-lit(chars.to-string()), nowhere())); }
                    chars = buffer(16);
                    let value = expr-of(lowering, first-node(inner));
                    let spec = "";
                    let has-spec = false;
                    for written in tokens(inner) {
                        if written.green.kind == TokenKind.format-spec {
                            spec = written.green.text;
                            has-spec = true;
                        }
                    }
                    if !has-spec { parts.push(value); }
                    else {
                        parts.push(node(ExprKind.call({ name: "~format", args: [value, node(ExprKind.str-lit(spec), nowhere()),], type-args: [], name-span: nowhere(), }), at));
                    }
                }
            }
        }
        if chars.len() > 0 || parts.len() == 0 { parts.push(node(ExprKind.str-lit(chars.to-string()), nowhere())); }
        // (a string of no interpolation: its one piece, where the string is)
        if parts.len() == 1 && is-str-lit(parts[0]) { return node(parts[0].kind, at); }
        node(ExprKind.interp(parts), at)
    }

    // which of a string's bytes are its text's (a multiline one's: its lines past its indent, its
    // first and last line breaks and each line's \r left out), as a range of the file: from, and
    // a mark for each byte to its end
    @(private) kept-bytes: func(lowering: Lowerer, node: SyntaxNode) -> KeptBytes {
        let opening = tokens(node)[0];
        let from = opening.offset + opening.green.text.len();
        let to = match last-token(node) {
            some(token) => if token.green.kind == TokenKind.string-end { token.offset } else { token.offset + token.green.text.len() },
            none => from,
        };
        let marks: list<bool> = [];
        for index in from..to { marks.push(true); }
        if opening.green.text != "\"\"\"" { return { from: from, marks: marks, }; }
        let place = token-span(lowering, opening);
        let multiline = lexer.multiline(lowering.text, lowering.context, lowering.source, opening.offset, place.line, place.col, true);
        let indent = multiline.indent;
        for index in 0..marks.len() { marks[index] = false; }
        // its lines: from past the line break after """ to the line break before the closing line
        let first = from;
        if lowering.text.byte-at(first) == 13 && lowering.text.byte-at(first + 1) == 10 { first += 2; }
        else if lowering.text.byte-at(first) == 10 { first += 1; }
        else { return { from: from, marks: marks, }; }
        let brk = to - indent - 1;
        if brk < first || lowering.text.byte-at(brk) != 10 { return { from: from, marks: marks, }; }
        let stop = brk;
        if stop > first && lowering.text.byte-at(stop - 1) == 13 { stop -= 1; }
        let start = first;
        loop {
            if start > stop { break; }
            let end = start;
            loop {
                if end >= stop || lowering.text.byte-at(end) == 10 { break; }
                end += 1;
            }
            let line-end = if end > start && lowering.text.byte-at(end - 1) == 13 { end - 1 } else { end };
            let text-start = if line-end > start { start + indent } else { start };
            for index in text-start..line-end {
                if index >= from && index < to { marks[index - from] = true; }
            }
            // the line break between two lines: the text's
            if end < stop && end >= from && end < to { marks[end - from] = true; }
            start = end + 1;
        }
        { from: from, marks: marks, }
    }

    // a string's text piece, what it says (its escapes undone), its bytes kept only, into out
    @(private) decoded-into: func(token: SyntaxToken, kept: KeptBytes, out: buffer) {
        let raw = token.green.text;
        let index = 0;
        loop {
            if index >= raw.len() { break; }
            let at = token.offset + index - kept.from;
            let keep = at >= 0 && at < kept.marks.len() && kept.marks[at];
            if !keep {
                index += 1;
                continue;
            }
            if raw.byte-at(index) == 92 {
                let esc = escape(raw, index);
                out.push(esc.text);
                index += esc.width;
            } else {
                out.push-byte(raw.byte-at(index));
                index += 1;
            }
        }
    }

    // the escape at raw[i] (a backslash): its text and how many bytes it takes (WAVE's \\ \"
    // \' \n \r \t \u\{hex\}, and yel's \{ \} \0); one the parser told: nothing
    escape: func(raw: string, index: s64) -> Escape {
        let byte = raw.byte-at(index + 1);
        if byte == 110 { return { text: from-byte(10), width: 2, }; }
        if byte == 116 { return { text: from-byte(9), width: 2, }; }
        if byte == 114 { return { text: from-byte(13), width: 2, }; }
        if byte == 48 { return { text: from-byte(0), width: 2, }; }
        if byte == 92 || byte == 34 || byte == 39 || byte == 123 || byte == 125 { return { text: from-byte(byte), width: 2, }; }
        if byte == 117 && raw.byte-at(index + 2) == 123 {
            let code = 0;
            for position in index + 3..raw.len() {
                let digit = raw.byte-at(position);
                if digit == 125 { return { text: utf8(code), width: position + 1 - index, }; }
                code = code * 16 + hex-value(digit);
            }
        }
        { text: "", width: 2, }
    }

    // a code point as UTF-8
    utf8: func(code: s64) -> string {
        if code < 128 { return from-byte(code); }
        if code < 2048 { return from-byte(192 + code / 64) + from-byte(128 + code % 64); }
        if code < 65536 {
            return from-byte(224 + code / 4096) + from-byte(128 + (code / 64) % 64) + from-byte(128 + code % 64);
        }
        from-byte(240 + code / 262144) + from-byte(128 + (code / 4096) % 64) + from-byte(128 + (code / 64) % 64) + from-byte(128 + code % 64)
    }

    // a char literal's code point: its text (an escape, or one UTF-8 scalar)
    char-code: func(raw: string) -> s64 {
        let bytes = if raw.byte-at(0) == 92 { escape(raw, 0).text } else { raw };
        let count = bytes.len();
        if count == 0 { return 0; }
        let first = bytes.byte-at(0);
        let width = if first < 128 { 1 } else if first >= 240 { 4 } else if first >= 224 { 3 } else { 2 };
        if width == 1 { return first; }
        let code = if width == 2 { first - 192 } else if width == 3 { first - 224 } else { first - 240 };
        for position in 1..width {
            if position < count { code = code * 64 + bytes.byte-at(position) - 128; }
        }
        code
    }

    // a regex literal: its pattern compiled (regexp's: a bad one told where it is written), its
    // matcher a func made (as nodes: the next declaration's place's), and its value std's
    // regex.compiled(…) of them
    regex: func(lowering: Lowerer, syntax-node: SyntaxNode) -> Expr {
        let token = tokens(syntax-node)[0];
        let at = token-span(lowering, token);
        let written = token.green.text;
        let close = written.find-last("/").unwrap-or(0);
        let pattern = written.substring(1, close);
        let flags = written.substring(close + 1, written.len());
        let program = match regexp.compile(pattern, flags) {
            ok(compiled) => compiled,
            err(problem) => {
                diagnostics.report(lowering.context, diagnostics.error(at, "the regex {written}: {problem}", ""));
                return node(ExprKind.unit, at);
            }
        };
        // (its matcher's name: the file's, and where in it the literal is)
        let name = "regex-at-{lowering.source}-{at.line}-{at.col}";
        lowering.made.push(Decl.func-decl(regexp.matcher(program, name, flags.contains("m"), lowering.scope)));
        let value = build.module-call("regex", "compiled", [
            build.text(pattern),
            build.text(flags),
            build.int(program.groups),
            build.int(program.slots),
            build.list-of(program.names.map({ named -> build.text(named) })),
            build.name(name),
        ]);
        // (the literal's value where it is written)
        value.span = at;
        value
    }

    // ================================================================ statements

    empty-block: func() -> Block { { stmts: [], spans: [], span: nowhere(), } }

    // a block's statements, its span from its { to its }
    block: func(lowering: Lowerer, node: SyntaxNode) -> Block { statements(lowering, node, node-span(lowering, node)) }

    // the statements in n (its statement nodes: what an error passed over left out), the block's
    // span whole
    statements: func(lowering: Lowerer, node: SyntaxNode, whole: Span) -> Block {
        let stmts: list<Stmt> = [];
        let spans: list<Span> = [];
        for child in nodes(node) {
            if !is-statement(tree.kind(child)) { continue; }
            stmts.push(statement(lowering, child));
            spans.push(node-span(lowering, child));
        }
        { stmts: stmts, spans: spans, span: whole, }
    }

    is-statement: func(kind: NodeKind) -> bool {
        kind == NodeKind.let-stmt || kind == NodeKind.return-stmt || kind == NodeKind.wait-for-stmt || kind == NodeKind.loop-stmt
            || kind == NodeKind.for-stmt || kind == NodeKind.break-stmt || kind == NodeKind.continue-stmt || kind == NodeKind.assign-stmt
            || kind == NodeKind.expr-stmt
    }

    statement: func(lowering: Lowerer, syntax-node: SyntaxNode) -> Stmt {
        let kind = tree.kind(syntax-node);
        let parts = nodes(syntax-node);
        if kind == NodeKind.let-stmt {
            // (in the order written: its pattern, its type, its value)
            let typed = has(syntax-node, ":");
            let destructures = parts.len() > 0 && is-pattern(tree.kind(parts[0]));
            let bound = if destructures { pattern(lowering, parts[0], true) } else { Pattern.wild };
            let ty: option<Type> = if typed && parts.len() > (if destructures { 2 } else { 1 }) {
                some(parse-type(lowering, parts[if destructures { 1 } else { 0 }]))
            } else {
                none
            };
            let value = if parts.len() > 0 { expr(lowering, parts[parts.len() - 1]) } else { node(ExprKind.unit, nowhere()) };
            if destructures { return Stmt.let-pattern({ pattern: bound, ty: ty, value: value, }); }
            let named-at = after-word(lowering, syntax-node, "let");
            let name = match first-name-after(syntax-node, "let") {
                some(token) => token-name(token),
                none => "",
            };
            return Stmt.let-stmt({ name: name, ty: ty, value: value, mark: new-mark(name, named-at), });
        }
        if kind == NodeKind.return-stmt {
            if parts.len() > 0 { return Stmt.return-stmt(expr(lowering, parts[0])); }
            // (no value: unit, where the token after return is)
            let after = tokens(syntax-node)[0];
            return Stmt.return-stmt(node(ExprKind.unit, next-token-span(lowering, after.offset + after.green.text.len())));
        }
        if kind == NodeKind.wait-for-stmt { return wait-for(lowering, syntax-node); }
        if kind == NodeKind.loop-stmt {
            return Stmt.loop-stmt({ body: if parts.len() > 0 { block(lowering, parts[0]) } else { empty-block() }, unit: { env: false, }, });
        }
        if kind == NodeKind.for-stmt {
            let named = first-name-after(syntax-node, "for");
            let name = match named {
                some(token) => token-name(token),
                none => "",
            };
            let v-at = match named {
                some(token) => token-span(lowering, token),
                none => nowhere(),
            };
            let ranged = has(syntax-node, "..") || has(syntax-node, "..=");
            let start = if parts.len() > 0 { expr(lowering, parts[0]) } else { node(ExprKind.unit, nowhere()) };
            let stop: option<Expr> = if ranged && parts.len() > 1 { some(expr(lowering, parts[1])) } else { none };
            let body = if parts.len() > 0 && tree.kind(parts[parts.len() - 1]) == NodeKind.block { block(lowering, parts[parts.len() - 1]) } else { empty-block() };
            return Stmt.for-stmt({
                name: name,
                start: start,
                stop: stop,
                inclusive: has(syntax-node, "..="),
                body: body,
                mark: new-mark(name, v-at),
                unit: { env: false, },
            });
        }
        if kind == NodeKind.break-stmt { return Stmt.break-stmt; }
        if kind == NodeKind.continue-stmt { return Stmt.continue-stmt; }
        if kind == NodeKind.assign-stmt {
            let target = if parts.len() > 0 { expr(lowering, parts[0]) } else { node(ExprKind.unit, nowhere()) };
            let value = if parts.len() > 1 { expr(lowering, parts[1]) } else { node(ExprKind.unit, nowhere()) };
            let op = "=";
            for token in tokens(syntax-node) {
                if token.green.kind == TokenKind.op && (token.green.text == "=" || token.green.text == "+=" || token.green.text == "-=" || token.green.text == "*="
                    || token.green.text == "/=" || token.green.text == "%=") {
                    op = token.green.text;
                }
            }
            match target.kind {
                name(name) => { return Stmt.assign({ name: name, op: op, value: value, name-span: target.span, }); }
                field(access) => {
                    return Stmt.assign-field({ target: access.target, name: access.name, op: op, value: value, name-span: access.name-span, });
                }
                // xs[i] = v: xs.set(i, v)
                method(called) => {
                    let first = if called.args.len() > 0 { called.args[0] } else { node(ExprKind.unit, nowhere()) };
                    let set = node(ExprKind.method({ target: called.target, name: "set", args: [first, value,], type-args: [], name-span: nowhere(), }), target.span);
                    return Stmt.expr-stmt({ value: set, is-value: false, });
                }
                _ => { return Stmt.expr-stmt({ value: target, is-value: false, }); }
            }
        }
        // an expression statement: the block's value where it ends the block, written with no ;
        let value = if parts.len() > 0 { expr(lowering, parts[0]) } else { node(ExprKind.unit, nowhere()) };
        let closes = match token-after(syntax-node) {
            some(token) => is-word(token, "\}"),
            none => false,
        };
        Stmt.expr-stmt({ value: value, is-value: !has(syntax-node, ";") && closes, })
    }

    is-pattern: func(kind: NodeKind) -> bool {
        kind == NodeKind.wild-pattern || kind == NodeKind.let-pattern || kind == NodeKind.typed-pattern || kind == NodeKind.literal-pattern
            || kind == NodeKind.range-pattern || kind == NodeKind.record-pattern || kind == NodeKind.tuple-pattern
            || kind == NodeKind.paren-pattern || kind == NodeKind.case-pattern || kind == NodeKind.name-pattern || kind == NodeKind.alt-pattern
    }

    // n's own name token right before its own token v (none: an empty list)
    @(private) name-before: func(node: SyntaxNode, word: string) -> list<SyntaxToken> {
        let own = tokens(node);
        for index in 1..own.len() {
            if is-word(own[index], word) && own[index - 1].green.kind == TokenKind.id { return [own[index - 1],]; }
        }
        []
    }

    // the first name token after n's own token v
    @(private) first-name-after: func(node: SyntaxNode, word: string) -> option<SyntaxToken> {
        let seen = false;
        for token in tokens(node) {
            if seen && token.green.kind == TokenKind.id { return some(token); }
            if is-word(token, word) { seen = true; }
        }
        none
    }

    // wait for x in s { body }: the stream once, then a turn for each item, until it is closed:
    // { let ~s = s; for ~t in 0..<s64 max> { match wait ~s.read() { some(let x) => { body }
    // none => { break; } } } }
    wait-for: func(lowering: Lowerer, syntax-node: SyntaxNode) -> Stmt {
        let parts = nodes(syntax-node);
        let named = first-name-after(syntax-node, "for");
        let variable = match named {
            some(token) => token-name(token),
            none => "",
        };
        // (the item's binding where the token after its name is: its in)
        let vspan = match named {
            some(token) => next-token-span(lowering, token.offset + token.green.text.len()),
            none => nowhere(),
        };
        let source = if parts.len() > 0 { expr(lowering, parts[0]) } else { node(ExprKind.unit, nowhere()) };
        let body = if parts.len() > 1 { block(lowering, parts[parts.len() - 1]) } else { empty-block() };
        let sp = node-span(lowering, syntax-node);
        let s-name = "~stream";
        let read = node(ExprKind.method({
            target: node(ExprKind.name(intern(s-name)), sp),
            name: "read",
            args: [],
            type-args: [],
            name-span: nowhere(),
        }), sp,);
        let waited = node(ExprKind.wait-expr({ mode: "one", values: [read,], fields: [], }), sp);
        let item = Pattern.case({ name: "some", sub: name-pattern(variable, true, vspan), span: sp, name-span: nowhere(), });
        let done: Block = { stmts: [Stmt.break-stmt,], spans: [sp,], span: sp, };
        let arms: list<Arm> = [
            { pattern: item, guard: none, body: node(ExprKind.block(body), sp), span: sp, },
            { pattern: name-pattern("none", false, sp), guard: none, body: node(ExprKind.block(done), sp), span: sp, },
        ];
        let each = node(ExprKind.match-expr({ value: waited, arms: arms, }), sp);
        let turn: Block = { stmts: [Stmt.expr-stmt({ value: each, is-value: false, }),], spans: [sp,], span: sp, };
        let turns = Stmt.loop-stmt({ body: turn, unit: { env: false, }, });
        let bound = Stmt.let-stmt({ name: s-name, ty: none, value: source, mark: new-mark(s-name, nowhere()), });
        let all: Block = { stmts: [bound, turns,], spans: [sp, sp,], span: sp, };
        Stmt.expr-stmt({ value: node(ExprKind.block(all), sp), is-value: false, })
    }

    // ================================================================ declarations

    // a declaration, into out: its attributes (@(private), @(observable), @(test), @(context))
    // on what it declares
    declaration: func(lowering: Lowerer, node: SyntaxNode, out: list<Decl>) {
        let kind = tree.kind(node);
        if kind == NodeKind.error { return; }
        // (a cache kept: what other declarations' checks read of it, its interface, noted)
        if lowering.context.cache.is-some() && kind != NodeKind.module-decl { lowering.context.interface.push("{lowering.scope.module}|{kind:?}|{interface-text(lowering, node)}"); }
        let attributes = nodes-of(node, NodeKind.attribute);
        if attributes.len() == 0 {
            declared(lowering, node, kind, out);
            return;
        }
        let outer = lowering.scope;
        let outer-observable = lowering.observable;
        let outer-testing = lowering.testing;
        let outer-context = lowering.in-context;
        let outer-container = lowering.container;
        let outer-parts = lowering.parts;
        let outer-base = lowering.base;
        let level = outer.private;
        for attribute in attributes {
            let words = tokens(attribute);
            for index in 0..words.len() {
                let word = words[index];
                if is-word(word, "private") {
                    level = "package";
                    if index + 1 < words.len() && is-word(words[index + 1], "=") { level = "file"; }
                } else if is-word(word, "observable") {
                    lowering.observable = true;
                } else if is-word(word, "test") {
                    lowering.testing = true;
                } else if is-word(word, "context") {
                    lowering.in-context = true;
                } else if is-word(word, "container") {
                    lowering.container = true;
                    // (container(Tab, …): its parts' names, up to the ))
                    if index + 1 < words.len() && is-word(words[index + 1], "(") {
                        let parts: list<string> = [];
                        for at in index + 2..words.len() {
                            if is-word(words[at], ")") { break; }
                            if words[at].green.kind == TokenKind.id { parts.push(token-name(words[at])); }
                        }
                        lowering.parts = parts;
                    }
                } else if is-word(word, "base") {
                    lowering.base = true;
                }
            }
        }
        lowering.scope = {
            pkg: outer.pkg,
            module: outer.module,
            file: outer.file,
            build: outer.build,
            includes: outer.includes,
            requests: outer.requests,
            private: level,
        };
        declared(lowering, node, kind, out);
        lowering.observable = outer-observable;
        lowering.testing = outer-testing;
        lowering.in-context = outer-context;
        lowering.container = outer-container;
        lowering.parts = outer-parts;
        lowering.base = outer-base;
        lowering.scope = outer;
    }

    // what other declarations' checks read of a declaration: a func's text but its body, any
    // other's whole text
    @(private) interface-text: func(lowering: Lowerer, node: SyntaxNode) -> string {
        let end = tree.end-offset(node);
        if tree.kind(node) == NodeKind.func-decl {
            match first-of(node, NodeKind.block) {
                some(body) => { end = body.offset; }
                none => {}
            }
        }
        lowering.text.substring(node.offset, end)
    }

    // a declaration's keyword: its first own token (record, resource, variant, enum: its
    // attributes are nodes of their own)
    @(private) keyword: func(node: SyntaxNode) -> string {
        let own = tokens(node);
        if own.len() > 0 { own[0].green.text } else { "" }
    }

    // the text of n's own token right after its first token v ("" for none)
    @(private) word-after: func(node: SyntaxNode, word: string) -> string {
        let own = tokens(node);
        for index in 0..own.len() - 1 {
            if is-word(own[index], word) { return own[index + 1].green.text; }
        }
        ""
    }

    // the words of n's own tokens between its first token from and the next to after it
    @(private) between-words: func(node: SyntaxNode, from: string, to: string) -> list<string> {
        let out: list<string> = [];
        let inside = false;
        for token in tokens(node) {
            if inside && is-word(token, to) { return out; }
            if inside { out.push(token.green.text); }
            if !inside && is-word(token, from) { inside = true; }
        }
        out
    }

    // a declaration's name, noted (where a language server takes a definition to)
    @(private) declared-name: func(lowering: Lowerer, node: SyntaxNode, after: string) -> tuple<string, Span> {
        match first-name-after(node, after) {
            some(token) => {
                let at = token-span(lowering, token);
                if !lowering.context.exits { lowering.context.declarations.push({ name: token-name(token), span: at, scope: lowering.scope, }); }
                (token-name(token), at)
            }
            none => ("", nowhere()),
        }
    }

    // a member's name noted (a field's, a flag's, a case's: owner#name)
    @(private) note-member: func(lowering: Lowerer, owner: string, token: SyntaxToken) {
        if !lowering.context.exits { lowering.context.declarations.push({ name: "{owner}#{token-name(token)}", span: token-span(lowering, token), scope: lowering.scope, }); }
    }

    // the span of a declaration's first token past its attributes (its keyword's)
    @(private) keyword-span: func(lowering: Lowerer, node: SyntaxNode) -> Span {
        let own = tokens(node);
        if own.len() > 0 { token-span(lowering, own[0]) } else { node-span(lowering, node) }
    }

    // a string's text as written between its quotes, its tokens among n's own (an include's
    // package, an attribute's value)
    @(private) string-text-at: func(lowering: Lowerer, node: SyntaxNode, index: s64) -> string {
        let all = tokens(node);
        if index >= all.len() || all[index].green.kind != TokenKind.string-start { return ""; }
        let opening = all[index];
        let from = opening.offset + opening.green.text.len();
        let depth = 0;
        for at in index..all.len() {
            let token = all[at];
            if token.green.kind == TokenKind.string-start { depth += 1; }
            if token.green.kind == TokenKind.string-end {
                depth -= 1;
                if depth == 0 { return lowering.text.substring(from, token.offset); }
            }
        }
        lowering.text.substring(from, lowering.text.len())
    }

    // what a declaration node declares
    @(private) declared: func(lowering: Lowerer, syntax-node: SyntaxNode, kind: NodeKind, out: list<Decl>) {
        let parts = nodes(syntax-node).filter({ child -> tree.kind(child) != NodeKind.attribute && tree.kind(child) != NodeKind.c-attribute && tree.kind(child) != NodeKind.error });
        if kind == NodeKind.package-decl {
            let written: list<string> = [];
            let past = false;
            for token in tokens(syntax-node) {
                if is-word(token, ";") { break; }
                if past { written.push(token.green.text); }
                if is-word(token, "package") { past = true; }
            }
            let full = written.join("");
            let id = without-version(full);
            let pkg = lowering.scope.pkg;
            if pkg.id != "" && pkg.id != id {
                let after = match last-token(syntax-node) {
                    some(token) => next-token-span(lowering, token.offset + token.green.text.len()),
                    none => node-span(lowering, syntax-node),
                };
                diagnostics.report(lowering.context, diagnostics.error(after, "this file says package {id}, but the package's others say {pkg.id}", ""));
            }
            pkg.id = id;
            if full != id { pkg.version = full.substring(id.len() + 1, full.len()); }
            return;
        }
        if kind == NodeKind.include-decl {
            let from = keyword-span(lowering, syntax-node);
            let names: list<string> = [];
            let aliases: list<string> = [];
            for included in nodes-of(syntax-node, NodeKind.include-name) {
                let named = tokens(included).filter({ token -> token.green.kind == TokenKind.id && !is-word(token, "as") });
                if named.len() == 0 { continue; }
                names.push(token-name(named[0]));
                aliases.push(token-name(named[named.len() - 1]));
            }
            lowering.scope.requests.push({ spec: string-text-at(lowering, syntax-node, 1), names: names, aliases: aliases, span: from, });
            return;
        }
        if kind == NodeKind.module-decl {
            let named = first-name-after(syntax-node, "module");
            let module-name = match named {
                some(token) => token-name(token),
                none => "",
            };
            let named-at = match named {
                some(token) => token-span(lowering, token),
                none => nowhere(),
            };
            let outer = lowering.scope;
            // (where its declarations start: what its errors point at)
            let inside = match named {
                some(token) => next-token-span(lowering, next-token-offset(lowering, token.offset + token.green.text.len()) + 1),
                none => nowhere(),
            };
            if !lowering.context.exits { lowering.context.modules.push({ name: module-name, span: named-at, scope: outer, }); }
            let direction: direction = "";
            if outer.pkg.modules.has(module-name) && outer.pkg.modules[module-name] != direction {
                diagnostics.report(lowering.context, diagnostics.error(inside, "module {module-name} is declared with another direction elsewhere", ""));
            }
            if outer.pkg.modules.has(module-name) && outer.pkg.private-modules.has(module-name) != (outer.private != "") {
                diagnostics.report(lowering.context, diagnostics.error(inside, "module {module-name} is private in one of its blocks and not in another", ""));
            }
            outer.pkg.modules.set(module-name, direction);
            if outer.private != "" {
                outer.pkg.private-modules.set(module-name, { level: outer.private, pkg: outer.pkg, file: outer.file, span: inside, });
            }
            lowering.scope = {
                pkg: outer.pkg,
                module: module-name,
                file: outer.file,
                build: outer.build,
                includes: outer.includes,
                requests: outer.requests,
                private: outer.private,
            };
            for inner in parts { declaration-made(lowering, inner, out); }
            lowering.scope = outer;
            return;
        }
        if kind == NodeKind.widget-decl {
            widget-declaration(lowering, syntax-node, out);
            return;
        }
        if kind == NodeKind.view-decl {
            view-declaration(lowering, syntax-node, out);
            return;
        }
        let decl-span = keyword-span(lowering, syntax-node);
        if kind == NodeKind.record-decl {
            let value = keyword(syntax-node) == "record";
            let (rname, _) = declared-name(lowering, syntax-node, keyword(syntax-node));
            let fields: list<string> = [];
            let types: list<Type> = [];
            let ignored: list<string> = [];
            for child in nodes-of(syntax-node, NodeKind.field-decl) {
                // (its name: the one before its :, past an @(ignored))
                let named = name-before(child, ":");
                if named.len() == 0 { continue; }
                let field = token-name(named[0]);
                note-member(lowering, rname, named[0]);
                fields.push(field);
                if has(child, "@") { ignored.push(field); }
                types.push(type-of(lowering, first-node(child)));
            }
            out.push(Decl.record-decl({
                span: decl-span,
                scope: lowering.scope,
                name: rname,
                fields: fields,
                field-types: types,
                value: value,
                observable: lowering.observable,
                ignored: ignored,
            }));
            return;
        }
        if kind == NodeKind.type-decl {
            let (tname, _) = declared-name(lowering, syntax-node, "type");
            out.push(Decl.type-decl({
                span: decl-span,
                scope: lowering.scope,
                name: tname,
                target: type-of(lowering, if parts.len() > 0 { some(parts[0]) } else { none }),
                resolved: Type.unit-type,
                distinct: word-after(syntax-node, "=") == "distinct",
            }));
            return;
        }
        if kind == NodeKind.global-decl {
            let (gname, _) = declared-name(lowering, syntax-node, "let");
            let ty = type-of(lowering, if parts.len() > 0 { some(parts[0]) } else { none });
            let value: option<Expr> = if parts.len() > 1 { some(expr(lowering, parts[1])) } else { none };
            out.push(Decl.global-decl({
                span: decl-span,
                scope: lowering.scope,
                name: gname,
                ty: ty,
                value: value,
                context: lowering.in-context,
            }));
            return;
        }
        if kind == NodeKind.const-decl {
            let (cname, _) = declared-name(lowering, syntax-node, "const");
            let typed = has(syntax-node, ":");
            let ty: option<Type> = if typed && parts.len() > 1 { some(parse-type(lowering, parts[0])) } else { none };
            let value = if parts.len() > 0 { expr(lowering, parts[parts.len() - 1]) } else { node(ExprKind.unit, nowhere()) };
            out.push(Decl.const-decl({ span: decl-span, scope: lowering.scope, name: cname, ty: ty, value: value, }));
            return;
        }
        if kind == NodeKind.flags-decl {
            let (fname, _) = declared-name(lowering, syntax-node, "flags");
            let flags: list<string> = [];
            for child in nodes-of(syntax-node, NodeKind.flag) {
                match first-name(child) {
                    some(token) => {
                        note-member(lowering, fname, token);
                        flags.push(token-name(token));
                    }
                    none => {}
                }
            }
            out.push(Decl.flags-decl({ span: decl-span, scope: lowering.scope, name: fname, flags: flags, }));
            return;
        }
        if kind == NodeKind.variant-decl {
            let (tname, _) = declared-name(lowering, syntax-node, keyword(syntax-node));
            let cases: list<CaseDecl> = [];
            for child in nodes-of(syntax-node, NodeKind.case-decl) {
                match first-name(child) {
                    some(token) => {
                        note-member(lowering, tname, token);
                        let payload = first-node(child);
                        cases.push({ name: token-name(token), has-payload: payload.is-some(), payload: type-of(lowering, payload), });
                    }
                    none => {}
                }
            }
            out.push(Decl.variant-decl({ span: decl-span, scope: lowering.scope, name: tname, cases: cases, }));
            return;
        }
        if kind == NodeKind.func-decl { func-declaration(lowering, syntax-node, out); }
    }

    // where the token at or past byte at starts
    @(private) next-token-offset: func(lowering: Lowerer, at: s64) -> s64 {
        match tree.token-from(lowering.root, at) {
            some(token) => token.offset,
            none => lowering.text.len(),
        }
    }

    // name: func<T>(params) -> R { body }, or an extern's (@c(…) name: extern func(…) -> R;)
    @(private) func-declaration: func(lowering: Lowerer, node: SyntaxNode, out: list<Decl>) {
        let cfunc: CFunc = { name: "", keeps: [], gives: [], };
        match first-of(node, NodeKind.c-attribute) {
            some(attribute) => {
                let words = tokens(attribute);
                for index in 0..words.len() {
                    if words[index].green.kind == TokenKind.id && index + 2 < words.len() && is-word(words[index + 1], "=") {
                        let key = token-name(words[index]);
                        let written = string-text-at(lowering, attribute, index + 2);
                        if key == "name" { cfunc.name = written; }
                        else if key == "keeps" { cfunc.keeps.push(written); }
                        else if key == "gives" { cfunc.gives.push(written); }
                    }
                }
            }
            none => {}
        }
        let named = first-name(node);
        let fname = match named {
            some(token) => token-name(token),
            none => "",
        };
        let decl-span = match named {
            some(token) => token-span(lowering, token),
            none => node-span(lowering, node),
        };
        // (what is written between its name's : and func: a func named async is none)
        let qualifiers = between-words(node, ":", "func");
        let is-extern = qualifiers.contains("extern");
        let is-async = qualifiers.contains("async");
        let tps: list<string> = [];
        match first-of(node, NodeKind.type-params) {
            some(tp) => {
                for token in tokens(tp) {
                    if token.green.kind == TokenKind.id { tps.push(token-name(token)); }
                }
            }
            none => {}
        }
        let params: list<string> = [];
        let spans: list<Span> = [];
        let types: list<Type> = [];
        let defaults: list<option<Expr>> = [];
        match first-of(node, NodeKind.param-list) {
            some(list) => {
                for child in nodes-of(list, NodeKind.param) {
                    let parts = nodes(child);
                    match first-name(child) {
                        some(token) => {
                            params.push(token-name(token));
                            spans.push(token-span(lowering, token));
                        }
                        none => {
                            params.push("");
                            spans.push(nowhere());
                        }
                    }
                    types.push(if parts.len() > 0 { parse-type(lowering, parts[0]) } else { Type.unit-type });
                    defaults.push(if parts.len() > 1 { some(expr(lowering, parts[1])) } else { none });
                }
            }
            none => {}
        }
        // its result: the type after its parameters, its body the block after that
        let result = Type.unit-type;
        let body: option<SyntaxNode> = none;
        let past-params = false;
        for child in nodes(node) {
            let kind = tree.kind(child);
            if kind == NodeKind.param-list { past-params = true; }
            else if past-params && kind == NodeKind.block { body = some(child); }
            else if past-params && kind != NodeKind.error { result = parse-type(lowering, child); }
        }
        if is-extern {
            out.push(Decl.extern-decl({
                span: decl-span,
                scope: lowering.scope,
                name: fname,
                type-params: tps,
                params: params,
                param-types: types,
                result: result,
                c-name: cfunc.name,
                keeps: cfunc.keeps,
                gives: cfunc.gives,
                wit-module: "",
                wit-name: "",
                is-async: is-async,
                defaults: defaults,
            }));
            return;
        }
        let made: Func = {
            span: decl-span,
            scope: lowering.scope,
            name: fname,
            type-params: tps,
            params: params,
            param-types: types,
            result: result,
            body: match body {
                some(child) => block(lowering, child),
                none => empty-block(),
            },
            marks: new-marks(params, spans),
            unit: { env: false, },
            is-async: is-async,
            is-generator: false,
            bindings: { exprs: map.new(), assigns: map.new(), },
            defaults: defaults,
            is-test: lowering.testing,
        };
        // (a cache kept: its text as written, where it is: what its checked body is kept by)
        if lowering.context.cache.is-some() {
            lowering.context.func-texts.set(made, "{lowering.context.sources[lowering.source].path}@{node.offset}:{lowering.text.substring(node.offset, tree.end-offset(node))}");
        }
        out.push(Decl.func-decl(made));
    }

    // widget Name { attributes; events }: what an element of it is made of, as funcs of its module
    // (a view of any package that includes the module calls them): widget-Name-make; for each
    // attribute a set (its type the attribute's: what a view gives it, checked); for each event an
    // on (what the event carries, by the type it is declared with, given to the view's closure);
    // and, @(container), container (a view gives a widget items only where it has it)
    @(private) widget-declaration: func(lowering: Lowerer, node: SyntaxNode, out: list<Decl>) {
        let named = first-name-after(node, "widget");
        let wname = match named {
            some(token) => token-name(token),
            none => "",
        };
        let named-at = match named {
            some(token) => token-span(lowering, token),
            none => nowhere(),
        };
        let made = { name: string, params: list<string>, param-types: list<Type>, result: Type, body: list<Stmt> ->
            out.push(Decl.func-decl(build.func(lowering.scope, named-at, "widget-{wname}-{name}", params, param-types, result, body)));
        };
        // (its module a widget set's: no interface of the component)
        if lowering.scope.module != "" { lowering.scope.pkg.modules.set(lowering.scope.module, "widgets"); }
        // (a base: its fields other widgets', nothing of its own)
        if lowering.base { return; }
        let node-type = Type.num("u32");
        made("make", [], [], node-type, [build.value(build.module-call("dom", "create-element", [build.text(wname),])),]);
        if lowering.container {
            made("container", [], [], Type.unit-type, []);
            // (what it holds: its parts, each by name, and none else; else anything)
            if lowering.parts.len() == 0 { made("holds-any", [], [], Type.unit-type, []); }
            for part in lowering.parts { made("holds-{part}", [], [], Type.unit-type, []); }
        }
        let fields: list<SyntaxNode> = [];
        widget-fields(lowering, node, wname, [], fields);
        let names: list<string> = [];
        for field in fields {
            let field-name = name-before(field, ":");
            if field-name.len() == 0 { continue; }
            let written = token-name(field-name[0]);
            let at = token-span(lowering, field-name[0]);
            let shown = if after-on(field, field-name[0]) { "on.{written}" } else { written };
            if names.contains(shown) {
                view-error(lowering, at, "widget {wname} has {shown} already (one of its bases')");
                continue;
            }
            names.push(shown);
            let parts = nodes(field);
            let ty = if parts.len() > 0 { parse-type(lowering, parts[0]) } else { Type.unit-type };
            if after-on(field, field-name[0]) {
                // (on: a closure given the value, run for its case; when: one that takes none, run
                // whatever the event carries)
                let listen = { run: list<Stmt> -> [
                    build.bind("id", build.module-call("view-events", "owned-handler", [build.closure-of(["payload",], run),])),
                    build.run(build.module-call("dom", "add-event-listener", [build.name("node"), build.text(written), build.name("id"),])),
                ] };
                match widget-event(lowering, ty, written, at, false) {
                    some(dispatched) => made("on-{written}", ["node", "run",], [node-type, ty,], Type.unit-type, listen(dispatched)),
                    none => { continue; }
                }
                match widget-event(lowering, ty, written, at, true) {
                    some(dispatched) => made("when-{written}", ["node", "run",], [node-type, Type.func-type({ params: [], result: Type.unit-type, }),], Type.unit-type, listen(dispatched)),
                    none => {}
                }
                continue;
            }
            let case = attribute-case(ty);
            if case == "" {
                view-error(lowering, at, "{written}: a widget's attribute is a string (or strings: \"a\" | \"b\"), bool, s32, f64 or dom.color");
                continue;
            }
            let value = build.method(build.field(build.name("dom"), "attribute-value"), case, [build.name("value"),]);
            made("set-{written}", ["node", "value",], [node-type, ty,], Type.unit-type, [
                build.run(build.module-call("dom", "set-attribute", [build.name("node"), build.text(written), value,])),
            ]);
            // (a value of the attribute's type, as itself: what reads one kept current is typed
            // by, its literals ("bold") the attribute's; and as the host takes it)
            made("as-{written}", ["value",], [ty,], ty, [build.value(build.name("value")),]);
            // (as std's view-nodes.Value; a color's kept only as a style is)
            let as-value = if case == "str" { "text" } else if case == "bool" { "flag" } else if case == "s32" { "whole" } else if case == "f64" { "real" } else { "" };
            if as-value != "" {
                made("value-{written}", ["value",], [ty,], Type.named(intern("view-nodes.Value")), [
                    build.value(build.method(build.field(build.name("view-nodes"), "Value"), as-value, [build.name("value"),])),
                ]);
            }
        }
    }

    // a widget's fields, each base's (Name: Base, …: a widget of its module, in this file) and
    // then its own (one declared again told there), into out; seen: the widgets on the way (a
    // base of itself is told)
    @(private) widget-fields: func(lowering: Lowerer, node: SyntaxNode, wname: string, seen: list<string>, out: list<SyntaxNode>) {
        let own = tokens(node);
        let after = false;
        for token in own {
            if is-word(token, "\{") { break; }
            if is-word(token, ":") {
                after = true;
                continue;
            }
            if !after || token.green.kind != TokenKind.id { continue; }
            let base = token-name(token);
            if base == wname || seen.contains(base) {
                view-error(lowering, token-span(lowering, token), "widget {wname} is a base of itself, through {base}");
                continue;
            }
            match widget-named(node, base) {
                some(found) => {
                    let further: list<string> = [];
                    for inherited in seen { further.push(inherited); }
                    further.push(wname);
                    widget-fields(lowering, found, base, further, out);
                }
                none => view-error(lowering, token-span(lowering, token), "no widget {base} in this module, in this file: a widget's base is one of its own"),
            }
        }
        for child in nodes(node) { if tree.kind(child) == NodeKind.view-field { out.push(child); } }
    }

    // the widget named name in the module n is declared in (none: none there)
    @(private) widget-named: func(node: SyntaxNode, name: string) -> option<SyntaxNode> {
        let module = tree.ancestors(node).filter({ ancestor -> tree.kind(ancestor) == NodeKind.module-decl });
        if module.len() == 0 { return none; }
        widget-in(module[0], name)
    }

    @(private) widget-in: func(node: SyntaxNode, name: string) -> option<SyntaxNode> {
        for child in nodes(node) {
            if tree.kind(child) == NodeKind.widget-decl {
                match first-name-after(child, "widget") {
                    some(token) => { if token-name(token) == name { return some(child); } }
                    none => {}
                }
            }
            match widget-in(child, name) {
                some(found) => { return some(found); }
                none => {}
            }
        }
        none
    }

    // what a widget's event gives the view's closure (run), from what the event carries (payload):
    // nothing (unread: a closure that takes nothing, run whatever the event carries); the
    // event-payload itself; or the value of the case its type is (run only for that case)
    @(private) widget-event: func(lowering: Lowerer, wanted: Type, event: string, at: Span, unread: bool) -> option<list<Stmt>> {
        let shape = match wanted {
            func-type(signature) => signature,
            _ => {
                view-error(lowering, at, "on.{event} is an event: give it a func's type (on.click: func(click-event);)");
                return none;
            }
        };
        match shape.result {
            unit-type => {}
            _ => {
                view-error(lowering, at, "on.{event} gives nothing back: func(T), no -> T");
                return none;
            }
        }
        // (a closure that takes nothing: run whatever the event carries)
        if unread || shape.params.len() == 0 { return some([build.run(build.call("run", [])),]); }
        if shape.params.len() > 1 {
            view-error(lowering, at, "on.{event} gives one value, what the event carries: func(T)");
            return none;
        }
        let written = written-type(shape.params[0]);
        if written == "event-payload" { return some([build.run(build.call("run", [build.name("payload"),])),]); }
        let types = ["click-event", "selection", "string", "drop-event", "key-event", "input-change", "clipboard-data", "grid-cell", "grid-range",];
        let cases = ["click", "select", "value", "drop", "key", "input", "paste", "cell", "range",];
        let index = types.index-of(written);
        if index < 0 {
            view-error(lowering, at, "on.{event}: an event carries an event-payload, or one of its cases' values ({types.join(", ")}), not {written}");
            return none;
        }
        let only = Pattern.case({ name: cases[index], sub: name-pattern("value", true, nowhere()), span: nowhere(), name-span: nowhere(), });
        let given = build.match-values(build.name("payload"), [only, Pattern.wild,], [build.call("run", [build.name("value"),]), node(ExprKind.block(empty-block()), nowhere()),]);
        some([build.run(given),])
    }

    // the case of dom.attribute-value an attribute of type t is set as ("": none)
    @(private) attribute-case: func(given: Type) -> string {
        match given {
            string-type => "str",
            bool-type => "bool",
            num(name) => if name == "s32" || name == "f64" { name } else { "" },
            named(name) => if name-text(name) == "dom.color" { "color" } else { "" },
            singleton(single) => attribute-case(single.base),
            union-type(members) => {
                if members.len() == 0 { return ""; }
                let first = attribute-case(members[0]);
                for member in members { if attribute-case(member) != first { return ""; } }
                first
            }
            _ => "",
        }
    }

    // view Name { fields; its element }: its fields and element as written, then what it is, as
    // nodes (lower-view)
    @(private) view-declaration: func(lowering: Lowerer, syntax-node: SyntaxNode, out: list<Decl>) {
        let named = first-name-after(syntax-node, "view");
        let vname = match named {
            some(token) => token-name(token),
            none => "",
        };
        let named-at = match named {
            some(token) => token-span(lowering, token),
            none => nowhere(),
        };
        let fields: list<ViewField> = [];
        let top: option<ViewElement> = none;
        for child in nodes(syntax-node) {
            let kind = tree.kind(child);
            if kind == NodeKind.view-field {
                let parts = nodes(child);
                let field-name = name-before(child, ":");
                if field-name.len() == 0 { continue; }
                note-member(lowering, vname, field-name[0]);
                let written = token-name(field-name[0]);
                let at = token-span(lowering, field-name[0]);
                let ty = if parts.len() > 0 { parse-type(lowering, parts[0]) } else { Type.unit-type };
                // (a callback: on.name, a func's type; none given, it does nothing. Its field's name
                // on-name: what the view it is in sets, and what on.name in it reads)
                let declared-on = after-on(child, field-name[0]);
                let shown = if declared-on { "on.{written}" } else { written };
                let callback = is-callback(ty);
                if callback && !declared-on { view-error(lowering, at, "{written} is a callback (a func's type): declare it on.{written}: func(…);"); }
                if !callback && declared-on { view-error(lowering, at, "{shown} is a callback: give it a func's type (on.pick: func(string);)"); }
                if !declared-on && written.starts-with("on-") { view-error(lowering, at, "{written}: a callback is on.{written.substring(3, written.len())}"); }
                let value = if parts.len() > 1 {
                    expr(lowering, parts[1])
                } else if callback {
                    doing-nothing(lowering, ty, shown, at)
                } else {
                    view-error(lowering, at, "{shown} needs a value to start with: {shown}: T = value;");
                    node(ExprKind.unit, nowhere())
                };
                let fname = if declared-on { "on-{written}" } else { written };
                // (@(private): the view's own state; @(mount): a prop mount is given, set before the
                // view is first built; let: made of what it reads; @(once) let: made once)
                let mounted = has(child, "mount");
                if mounted && callback { view-error(lowering, at, "{shown} is a callback: mount takes values (@(mount) intent: string)"); }
                let is-let = has(child, "let");
                let once = is-let && has(child, "once");
                let again = if parts.len() > 1 { let written-value = parts[1]; { -> expr(lowering, written-value) } } else { let made = value; { -> made } };
                fields.push({ name: fname, ty: ty, value: value, private: has(child, "private"), mount: mounted, derived: is-let && !once, once: once, again: again, span: at, });
            } else if kind == NodeKind.view-element {
                top = some(view-element(lowering, child));
            }
        }
        match top {
            some(element) => lower-view(lowering, vname, named-at, fields, element, out),
            none => {}
        }
    }

    // Name { items }: an element as written; module.View { props }: another view's (its module)
    @(private) view-element: func(lowering: Lowerer, node: SyntaxNode) -> ViewElement {
        let named = tokens(node).filter({ token -> token.green.kind == TokenKind.id });
        let dotted = tokens(node).len() > 1 && is-word(tokens(node)[1], ".");
        let tag = if named.len() > 0 { token-name(named[if dotted && named.len() > 1 { 1 } else { 0 }]) } else { "" };
        let module = if dotted && named.len() > 1 { token-name(named[0]) } else { "" };
        // (another view's place its tag, View of module.View: where a hover or a jump finds it)
        let at = if named.len() > 0 { token-span(lowering, named[if dotted && named.len() > 1 { 1 } else { 0 }]) } else { nowhere() };
        let module-at = if dotted && named.len() > 1 { token-span(lowering, named[0]) } else { nowhere() };
        let element: ViewElement = { tag: tag, module: module, span: at, module-span: module-at, attributes: [], items: [], };
        view-items(lowering, node, some(element), element.items);
        element
    }

    // the items in n: text, elements, ifs, fors; and an element's attributes and handlers
    @(private) view-items: func(lowering: Lowerer, node: SyntaxNode, where: option<ViewElement>, items: list<ViewItem>) {
        for child in nodes(node) {
            let kind = tree.kind(child);
            if kind == NodeKind.view-text { items.push(ViewItem.text(expr-of(lowering, first-node(child)))); }
            else if kind == NodeKind.view-if { items.push(ViewItem.if-item(view-if(lowering, child))); }
            else if kind == NodeKind.view-for { items.push(ViewItem.for-item(view-for(lowering, child))); }
            else if kind == NodeKind.view-element { items.push(ViewItem.element(view-element(lowering, child))); }
            else if kind == NodeKind.view-children { items.push(ViewItem.children(node-span(lowering, child))); }
            else if kind == NodeKind.view-attribute {
                match where {
                    some(element) => {
                        let own = tokens(child);
                        let style = own.len() > 1 && is-word(own[0], "style") && is-word(own[1], ".");
                        // (on.name: a handler, or another view's callback)
                        let event = own.len() > 1 && is-word(own[0], "on") && is-word(own[1], ".");
                        let ids = own.filter({ token -> token.green.kind == TokenKind.id });
                        let named = ids.slice(if style || event { 1 } else { 0 }, ids.len());
                        // (a style's name its segments, as the vocabulary writes it: pad.x)
                        let aname = if named.len() == 0 { "" } else if style { named.map({ token -> token-name(token) }).join(".") } else { token-name(named[0]) };
                        let at = if named.len() > 0 { token-span(lowering, named[0]) } else { nowhere() };
                        if !style && !event && aname.starts-with("on-") { view-error(lowering, at, "{aname}: a handler is on.{aname.substring(3, aname.len())}"); }
                        element.attributes.push({ name: aname, style: style, event: event, value: expr-of(lowering, first-node(child)), span: at, });
                    }
                    none => {}
                }
            }
        }
    }

    // if cond { items } else { items }
    @(private) view-if: func(lowering: Lowerer, syntax-node: SyntaxNode) -> ViewIf {
        let parts = nodes(syntax-node);
        let cond = if parts.len() > 0 { expr(lowering, parts[0]) } else { node(ExprKind.unit, nowhere()) };
        let then: list<ViewItem> = [];
        let otherwise: list<ViewItem> = [];
        // (the items before the else its then's; an else if, the else's)
        let past-else = false;
        let index = 0;
        for child in tree.children(syntax-node) {
            match child {
                token(leaf) => { if is-word(leaf, "else") { past-else = true; } }
                node(inner) => {
                    index += 1;
                    if index == 1 { continue; }
                    let one: list<ViewItem> = [];
                    let wrapper = inner;
                    view-items-one(lowering, wrapper, one);
                    for item in one {
                        if past-else { otherwise.push(item); } else { then.push(item); }
                    }
                }
            }
        }
        { cond: cond, then: then, otherwise: otherwise, }
    }

    // one item node as items (an if's branch holds them directly)
    @(private) view-items-one: func(lowering: Lowerer, child: SyntaxNode, out: list<ViewItem>) {
        let kind = tree.kind(child);
        if kind == NodeKind.view-text { out.push(ViewItem.text(expr-of(lowering, first-node(child)))); }
        else if kind == NodeKind.view-if { out.push(ViewItem.if-item(view-if(lowering, child))); }
        else if kind == NodeKind.view-for { out.push(ViewItem.for-item(view-for(lowering, child))); }
        else if kind == NodeKind.view-element { out.push(ViewItem.element(view-element(lowering, child))); }
        else if kind == NodeKind.view-children { out.push(ViewItem.children(node-span(lowering, child))); }
    }

    // for name in items key(key) { body }
    @(private) view-for: func(lowering: Lowerer, syntax-node: SyntaxNode) -> ViewFor {
        let parts = nodes(syntax-node);
        let named = first-name-after(syntax-node, "for");
        let body: list<ViewItem> = [];
        for index in 2..parts.len() { view-items-one(lowering, parts[index], body); }
        {
            name: match named {
                some(token) => token-name(token),
                none => "",
            },
            items: if parts.len() > 0 { expr(lowering, parts[0]) } else { node(ExprKind.unit, nowhere()) },
            key: if parts.len() > 1 { expr(lowering, parts[1]) } else { node(ExprKind.unit, nowhere()) },
            body: body,
            span: node-span-first-token(lowering, syntax-node),
            name-span: match named {
                some(token) => token-span(lowering, token),
                none => nowhere(),
            },
        }
    }

    // ================================================================ views (lowered to nodes)

    // what a view is (see view-declaration), into out: its resource, observable (an effect for
    // each binding that reads a field: the host told only of what changed), and its funcs, built
    // as nodes (build: no text written and parsed)
    lower-view: func(lowering: Lowerer, vname: string, named-at: Span, fields: list<ViewField>, top: ViewElement, out: list<Decl>) {
        // (#children in its tree: a field of what it is given to build there, nothing to start
        // with; once only, and never in a for's rows, which would build it again in each)
        let placed = view-children-count(top.items);
        if placed > 1 { view-error(lowering, view-children-span(top.items), "a view puts its children in one place: one #children"); }
        if placed > 0 {
            let nothing = { -> build.closure-of(["view-given-0", "view-given-1", "view-given-2",], []) };
            fields.push({ name: "view-children", ty: view-children-type(), value: nothing(), private: false, mount: false, derived: false, once: false, again: nothing, span: nowhere(), });
        }
        // (its lets: their values in fields of their own, none until made; a let named reads its
        // getter, view-get-name)
        let stored = fields.filter({ field -> !field.derived && !field.once });
        let lets = fields.filter({ field -> field.derived || field.once });
        let writer: ViewWriter = { fields: [], lets: [], getters: [], count: 0, };
        for field in stored { writer.fields.push(field.name); }
        for field in lets { writer.lets.push(field.name); }
        let owner-type = Type.named(intern(vname));
        let self = { -> build.name("self") };
        // the owner of what mount made (unmount lets it go), the top node, whether mounted
        let names: list<string> = [];
        let types: list<Type> = [];
        for field in stored {
            names.push(field.name);
            types.push(field.ty);
        }
        for field in lets {
            names.push("view-let-{field.name}");
            types.push(Type.option-type(field.ty));
            if field.derived {
                names.push("view-watch-{field.name}");
                types.push(Type.option-type(Type.named(intern("observe.Watch"))));
            }
        }
        let own = ["view-owner", "view-tree", "view-mounted",];
        for name in own { names.push(name); }
        types.push(Type.named(intern("reactive.Owner")));
        types.push(Type.num("u32"));
        types.push(Type.named(intern("view-nodes.Mounted")));
        out.push(Decl.record-decl({ span: named-at, scope: lowering.scope, name: vname, fields: names, field-types: types, value: false, observable: true, ignored: own, }));
        // (what each field's value reads of the view's: only what is declared before it)
        let known = fields.map({ field -> field.name });
        let read-by: list<list<string>> = [];
        for index in 0..fields.len() {
            let found: list<string> = [];
            view-names(fields[index].value, known, found);
            for name in found {
                let at = known.index-of(name);
                let what = if at == index { "itself" } else { "{name}, declared after it" };
                if at >= index { view-error(lowering, fields[index].value.span, "{fields[index].name} reads {what}: a field's value reads only those declared before it"); }
            }
            read-by.push(found);
        }
        // new: each field's value to start with, in order; one a later one reads made first, a
        // local of its name (a let read so too)
        let read: list<bool> = fields.map({ _ -> false });
        let index = fields.len();
        loop {
            if index == 0 { break; }
            index -= 1;
            let field = fields[index];
            if (field.derived || field.once) && !read[index] { continue; }
            for name in read-by[index] { read[known.index-of(name)] = true; }
        }
        let making: list<Stmt> = [];
        for index in 0..fields.len() {
            if read[index] { making.push(build.typed-let(fields[index].name, fields[index].ty, fields[index].value)); }
        }
        let starts: list<Expr> = [];
        for field in stored { starts.push(if read[known.index-of(field.name)] { build.name(field.name) } else { field.value }); }
        for field in lets {
            starts.push(build.name("none"));
            if field.derived { starts.push(build.name("none")); }
        }
        starts.push(build.module-call("reactive", "new-owner", []));
        starts.push(build.int(0));
        starts.push(build.module-call("view-nodes", "unmounted", []));
        making.push(build.value(build.record-of(names, starts)));
        let made = { name: string, params: list<string>, param-types: list<Type>, result: Type, body: list<Stmt> ->
            out.push(Decl.func-decl(build.func(lowering.scope, named-at, name, params, param-types, result, body)));
        };
        made("new", [], [], owner-type, making);
        // as it is first built: the state whose value reads the view's fields made again (its props
        // set by now), and each @(once) let made, in order, nothing of it tracked
        let first: list<Stmt> = [];
        for index in 0..fields.len() {
            let field = fields[index];
            let again = field.again;
            if field.once {
                let expression = again();
                let _ = view-bind(lowering, writer, expression);
                first.push(build.run(build.module-call("observe", "untracked", [build.closure([build.set-field(self(), "view-let-{field.name}", build.call("some", [expression,])),]),])));
            } else if field.private && !field.derived && read-by[index].len() > 0 {
                let expression = again();
                let _ = view-bind(lowering, writer, expression);
                first.push(build.run(build.module-call("observe", "untracked", [build.closure([build.set-field(self(), field.name, expression),]),])));
            }
        }
        let inside: list<Stmt> = [];
        // (what std does with this program's dom: templates, a for's rows)
        inside.push(build.bind("view-host-dom", build.module-call("view-host", "host", [])));
        // (its package then has the compiler's view-host module, its dom where this file's is:
        // packages.yel)
        lowering.scope.pkg.views = true;
        for request in lowering.scope.requests {
            if request.names.contains("dom") { lowering.scope.pkg.views-dom = request.spec; }
        }
        let tree = view-element-stmts(lowering, writer, top, { parent: "", anchor: "", nodes: "", }, inside);
        inside.push(build.set-field(self(), "view-tree", build.name(tree)));
        // (what a view that has this one in its tree calls, the package's own: its tree made under
        // an owner of its own, its top node given; let go, its nodes the parent's to remove; a prop
        // set, the parent's flush to run what it changed)
        // (the root package's own, never its WIT's; an included package's for any view in another
        // package to use: what includes it composes its views)
        let own-scope = if lowering.scope.pkg.included { lowering.scope } else { build.private(lowering.scope) };
        let package-own = { name: string, params: list<string>, param-types: list<Type>, result: Type, body: list<Stmt> ->
            out.push(Decl.func-decl(build.func(own-scope, named-at, name, params, param-types, result, body)));
        };
        let building: list<Stmt> = [];
        for statement in first { building.push(statement); }
        building.push(build.set-field(self(), "view-owner", build.module-call("reactive", "new-owner", [])));
        building.push(build.set-field(build.field(self(), "view-mounted"), "on", build.truth(true)));
        building.push(build.run(build.module-call("reactive", "within", [build.field(self(), "view-owner"), build.closure(inside),])));
        building.push(build.value(build.field(self(), "view-tree")));
        package-own("view-build", ["self",], [owner-type,], Type.num("u32"), building);
        // (not mounted: what is let go removes no nodes of its own)
        // (its derived lets' watches let go, each made again when next read)
        let releasing = [
            build.set-field(build.field(self(), "view-mounted"), "on", build.truth(false)),
            build.run(build.module-call("reactive", "dispose", [build.field(self(), "view-owner"),])),
        ];
        for field in lets {
            if !field.derived { continue; }
            releasing.push(build.run(build.module-call("observe", "stop-held", [build.field(self(), "view-watch-{field.name}"),])));
            releasing.push(build.set-field(self(), "view-watch-{field.name}", build.name("none")));
            releasing.push(build.set-field(self(), "view-let-{field.name}", build.name("none")));
        }
        package-own("view-release", ["self",], [owner-type,], Type.unit-type, releasing);
        // each let's getter: a derived one made when read with none made, or with what it read
        // changed since (its watch then sets it none, telling its readers); its maker runs its value
        // tracked, keeping the watch
        // (a let's getter where the let is written: what reads it there, as a hover or a jump finds it)
        let getter = { field: ViewField, body: list<Stmt> ->
            out.push(Decl.func-decl(build.func(own-scope, field.span, "view-get-{field.name}", ["self",], [owner-type,], field.ty, body)));
        };
        for field in lets {
            let held = build.field(self(), "view-let-{field.name}");
            let given = build.value(build.module-call("reactive", "made-value", [build.field(self(), "view-let-{field.name}"),]));
            if field.once {
                getter(field, [given,]);
                continue;
            }
            let stale = build.method(build.module-call("observe", "peek", [build.closure([build.value(held),]),]), "is-none", []);
            getter(field, [
                build.when(stale, [build.run(build.call("view-make-{field.name}", [self(),])),], []),
                given,
            ]);
            let again = field.again;
            let expression = again();
            let _ = view-bind(lowering, writer, expression);
            package-own("view-make-{field.name}", ["self",], [owner-type,], Type.unit-type, [
                build.run(build.module-call("observe", "stop-held", [build.field(self(), "view-watch-{field.name}"),])),
                build.typed-let("view-made", Type.option-type(field.ty), build.name("none")),
                build.set-field(self(), "view-watch-{field.name}", build.call("some", [build.module-call("observe", "track", [
                    build.closure([build.set("view-made", build.call("some", [expression,])),]),
                    build.closure([build.set-field(self(), "view-let-{field.name}", build.name("none")),]),
                ]),])),
                build.set-field(self(), "view-let-{field.name}", build.name("view-made")),
            ]);
        }
        // (a view in another's tree: built, and let go with the owner it is built under)
        package-own("view-owned", ["self",], [owner-type,], Type.num("u32"), [
            build.bind("node", build.call("view-build", [self(),])),
            build.run(build.module-call("reactive", "on-cleanup", [build.closure([build.run(build.call("view-release", [self(),])),]),])),
            build.value(build.name("node")),
        ]);
        for field in stored {
            if field.private { continue; }
            package-own("view-set-{field.name}", ["self", "value",], [owner-type, field.ty,], Type.unit-type, [build.set-field(self(), field.name, build.name("value")),]);
            // (a prop kept current by the view it is in: read, set, and set again each time what
            // read reads changes to a value it was not)
            if !is-callback(field.ty) {
                package-own("view-keep-{field.name}", ["self", "read",], [owner-type, Type.func-type({ params: [], result: field.ty, }),], Type.unit-type, [
                    build.bind("last", build.call("read", [])),
                    build.set-field(self(), field.name, build.name("last")),
                    build.run(build.module-call("reactive", "watch", [build.name("read"), build.name("last"), build.closure-of(["now",], [build.set-field(self(), field.name, build.name("now")),]),])),
                ]);
            }
            // (a value of the prop's type, as itself: what reads one kept current is typed by, its
            // literals the prop's)
            package-own("view-as-{field.name}", ["value",], [field.ty,], field.ty, [build.value(build.name("value")),]);
        }
        // (mount given the root, then each @(mount) prop: set before the tree is first built, as
        // the host's mount(root, intent) gives a page where it opens)
        let mount-names = ["self", "root",];
        let mount-types = [owner-type, Type.num("u32"),];
        let mounting: list<Stmt> = [];
        for field in fields {
            if !field.mount { continue; }
            mount-names.push(field.name);
            mount-types.push(field.ty);
            mounting.push(build.set-field(self(), field.name, build.name(field.name)));
        }
        mounting.push(build.run(build.module-call("dom", "append-child", [build.name("root"), build.call("view-build", [self(),]),])));
        made("mount", mount-names, mount-types, Type.unit-type, mounting);
        // (the tree goes at once)
        made("unmount", ["self",], [owner-type,], Type.unit-type, [
            build.run(build.call("view-release", [self(),])),
            build.run(build.module-call("dom", "remove", [build.field(self(), "view-tree"),])),
        ]);
        made("dispatch", ["self", "handler-id", "payload",], [owner-type, Type.num("u32"), Type.named(intern("event-payload")),], Type.unit-type, [
            build.run(build.module-call("view-events", "dispatch", [build.name("handler-id"), build.name("payload"),])),
        ]);
        for field in stored {
            // (a callback's, a func: no WIT value, a prop for views only)
            if field.private || is-callback(field.ty) { continue; }
            made("get-{field.name}", ["self",], [owner-type,], field.ty, [build.value(build.field(self(), field.name)),]);
            made("set-{field.name}", ["self", "value",], [owner-type, field.ty,], Type.unit-type, [
                build.set-field(self(), field.name, build.name("value")),
                build.run(build.module-call("reactive", "flush", [])),
            ]);
        }
    }

    // an error in what a view names (the view still lowered: each such error told)
    view-error: func(lowering: Lowerer, at: Span, message: string) {
        diagnostics.report(lowering.context, diagnostics.error(at, message, ""));
    }

    // a new local of a view's funcs (view-<what><n>)
    view-local: func(writer: ViewWriter, what: string) -> string {
        writer.count += 1;
        "view-{what}{writer.count}"
    }

    // e, each field it names bare (count) the view's (self.count); whether it names one, or reads
    // a for's row's item (its getter's call), so reads what changes: a binding of it is kept current
    view-bind: func(lowering: Lowerer, writer: ViewWriter, expression: Expr) -> bool {
        let reads-item = false;
        match expression.kind {
            call(invocation) => {
                if writer.getters.contains(invocation.name) { reads-item = true; }
                // (untracked(x): x read, nothing of it kept: what reads it is not made again when it
                // changes)
                if invocation.name == "untracked" && invocation.args.len() == 1 {
                    let inner = invocation.args[0];
                    let _ = view-bind(lowering, writer, inner);
                    expression.kind = build.module-call("observe", "peek", [build.closure([build.value(inner),]),]).kind;
                    return false;
                }
            }
            // (on.name(args): the view's callback called, { let f = self.on-name; f(args) })
            method(invoked) => {
                let callback = "on-{invoked.name}";
                if is-on(invoked.target) && writer.fields.contains(callback) {
                    let held = view-local(writer, "callback");
                    for argument in invoked.args { let _ = view-bind(lowering, writer, argument); }
                    let called = node(ExprKind.call({ name: held, args: invoked.args, type-args: [], name-span: invoked.name-span, }), expression.span);
                    let target = node(ExprKind.name(intern("self")), nowhere());
                    expression.kind = ExprKind.block(build.block([build.bind(held, build.field(target, callback)), build.value(called),]));
                    return true;
                }
            }
            // (on.name: the view's callback, as a value: given along to another view)
            field(accessed) => {
                if is-on(accessed.target) && writer.fields.contains("on-{accessed.name}") {
                    expression.kind = ExprKind.field({ target: node(ExprKind.name(intern("self")), nowhere()), name: "on-{accessed.name}", name-span: accessed.name-span, });
                    return true;
                }
            }
            name(variable) => {
                // (a let: its getter's value)
                if writer.lets.contains(name-text(variable)) {
                    expression.kind = ExprKind.call({ name: "view-get-{name-text(variable)}", args: [node(ExprKind.name(intern("self")), nowhere()),], type-args: [], name-span: expression.span, });
                    return true;
                }
                if writer.fields.contains(name-text(variable)) {
                    expression.kind = ExprKind.field({ target: node(ExprKind.name(intern("self")), nowhere()), name: name-text(variable), name-span: expression.span, });
                    return true;
                }
                return false;
            }
            closure(cl) => {
                for parameter in cl.params {
                    if writer.fields.contains(parameter) { view-error(lowering, expression.span, "{parameter} is a field of the view: name the parameter otherwise"); }
                    if writer.lets.contains(parameter) { view-error(lowering, expression.span, "{parameter} is a let of the view: name the parameter otherwise"); }
                }
            }
            _ => {}
        }
        let xs: list<Expr> = [];
        let bs: list<Block> = [];
        walk.expr-parts(expression, xs, bs);
        let named = reads-item;
        for item in xs { if view-bind(lowering, writer, item) { named = true; } }
        for block in bs { if view-bind-block(lowering, writer, block) { named = true; } }
        named
    }

    // a block's statements, as view-bind: a field assigned (count += 1) the view's
    view-bind-block: func(lowering: Lowerer, writer: ViewWriter, block: Block) -> bool {
        let named = false;
        for position in 0..block.stmts.len() {
            match block.stmts[position] {
                assign(assigned) => {
                    let field = name-text(assigned.name);
                    if writer.lets.contains(field) { view-error(lowering, block.spans[position], "{field} is a let, made of what it reads: it is never assigned"); }
                    if writer.fields.contains(field) {
                        block.stmts[position] = Stmt.assign-field({ target: node(ExprKind.name(intern("self")), nowhere()), name: field, op: assigned.op, value: assigned.value, name-span: assigned.name-span, });
                        named = true;
                    }
                }
                let-stmt(declared) => {
                    if writer.fields.contains(declared.name) || writer.lets.contains(declared.name) { view-error(lowering, block.spans[position], "{declared.name} is a field of the view: name the local otherwise"); }
                }
                for-stmt(repeated) => {
                    if writer.fields.contains(repeated.name) { view-error(lowering, block.spans[position], "{repeated.name} is a field of the view: name the for's variable otherwise"); }
                }
                _ => {}
            }
            let xs: list<Expr> = [];
            let bs: list<Block> = [];
            walk.stmt-parts(block.stmts[position], xs, bs);
            for item in xs { if view-bind(lowering, writer, item) { named = true; } }
            for inner in bs { if view-bind-block(lowering, writer, inner) { named = true; } }
        }
        named
    }

    // whether e is the name on (on.name: a view's callback)
    is-on: func(expression: Expr) -> bool {
        match expression.kind {
            name(named) => name-text(named) == "on",
            _ => false,
        }
    }

    // whether a view's field is written on.name (named: its name's token)
    after-on: func(node: SyntaxNode, named: SyntaxToken) -> bool {
        let own = tokens(node);
        for index in 2..own.len() {
            if own[index].offset == named.offset { return is-word(own[index - 1], ".") && is-word(own[index - 2], "on"); }
        }
        false
    }

    // whether a field's type is a func's (a callback)
    is-callback: func(given: Type) -> bool {
        match given {
            func-type(_) => true,
            _ => false,
        }
    }

    // a callback none was given: a closure of its parameters doing nothing (one that gives a
    // value needs one to start with)
    doing-nothing: func(lowering: Lowerer, given: Type, name: string, at: Span) -> Expr {
        let shape = match given {
            func-type(signature) => signature,
            _ => { return node(ExprKind.unit, nowhere()); }
        };
        match shape.result {
            unit-type => {}
            _ => { view-error(lowering, at, "{name} gives a value: give it one to start with ({name}: func(…) -> T = \{ … \};)"); }
        }
        let params: list<string> = [];
        for index in 0..shape.params.len() { params.push("view-given-{index}"); }
        build.closure-of(params, [])
    }

    // n where it goes: appended to its parent, or put before the anchor of the branch or row it is
    // in and kept as one of its parts (inner: the parts an if's or a for's anchor shows, "" for a
    // node of its own)
    view-place: func(name: string, inner: string, at: ViewPlace, out: list<Stmt>) {
        if at.parent == "" { return; }
        if at.anchor == "" {
            out.push(build.run(build.module-call("dom", "append-child", [build.name(at.parent), build.name(name),])));
        } else {
            out.push(build.run(build.module-call("dom", "insert-before", [build.name(at.parent), build.name(name), build.name(at.anchor),])));
            let part = if inner == "" {
                build.module-call("view-nodes", "node", [build.name(name),])
            } else {
                build.module-call("view-nodes", "shown", [build.name(name), build.name(inner),])
            };
            out.push(build.run(build.method(build.name(at.nodes), "push", [part,])));
        }
    }

    // a widget's element (Tag { … }, the widget Tag of a widget set in scope: its module's
    // widget-Tag-* funcs, the checker's to find): made, each attribute set (one that reads what
    // changes kept current), its handlers added (on.event: a closure, given what the event carries
    // as the widget says), its items made in it (a container's only), and put where it goes; its
    // node's name
    view-element-stmts: func(lowering: Lowerer, writer: ViewWriter, element: ViewElement, at: ViewPlace, out: list<Stmt>) -> string {
        if element.module != "" { return view-component-stmts(lowering, writer, element, at, out); }
        let widget = { name: string, args: list<Expr>, span: Span ->
            let made = node(ExprKind.call({ name: "widget-{element.tag}-{name}", args: args, type-args: [], name-span: span, }), span);
            made
        };
        let local-name = view-local(writer, "node");
        // (its static part a template, view-nodes.template's: the element made with its constant
        // attributes and styles, and, every part of it constant, what it holds; the calls that
        // would have made them kept where they never run, the checker's to check)
        let full = view-static(element);
        let statics = element.attributes.filter({ attribute -> !attribute.event && template-value(attribute.value, attribute.style) != "" });
        if full || statics.len() > 0 {
            let ops = if full { template-ops(element) } else { "E{template-text(element.tag)}{template-attributes(statics)}U" };
            out.push(build.bind(local-name, build.module-call("view-nodes", "template", [build.name("view-host-dom"), build.text(ops),])));
            let checks: list<Stmt> = [];
            view-checks(lowering, element, if full { element.attributes } else { statics }, full, checks);
            out.push(build.when(build.truth(false), checks, []));
            if full {
                view-place(local-name, "", at, out);
                return local-name;
            }
        } else {
            out.push(build.bind(local-name, widget("make", [], element.span)));
        }
        for attribute in element.attributes {
            if !attribute.event && template-value(attribute.value, attribute.style) != "" { continue; }
            if attribute.event {
                let _ = view-bind(lowering, writer, attribute.value);
                // (a closure that takes nothing: run for the event, what it carries not given)
                let unread = match attribute.value.kind {
                    closure(function-literal) => function-literal.params.len() == 0,
                    _ => false,
                };
                out.push(build.run(widget("{if unread { "when" } else { "on" }}-{attribute.name}", [build.name(local-name), attribute.value,], attribute.span)));
                continue;
            }
            let reads = view-bind(lowering, writer, attribute.value);
            if !reads {
                out.push(if attribute.style {
                    build.run(build.module-call("view-host", "style", [build.name(local-name), build.text(attribute.name), attribute.value,]))
                } else {
                    build.run(widget("set-{attribute.name}", [build.name(local-name), attribute.value,], attribute.span))
                });
            } else {
                // its value again each time what it reads changes, the host told only where it
                // differs: one call, its read a closure giving the value as the host takes it (an
                // attribute's by widget-Tag-value-name, typed as the attribute)
                if attribute.style {
                    out.push(build.run(build.module-call("view-host", "keep-style", [build.name(local-name), build.text(attribute.name), build.closure([build.value(attribute.value),]),])));
                } else {
                    out.push(build.run(build.module-call("view-nodes", "keep-attribute", [build.name("view-host-dom"), build.name(local-name), build.text(attribute.name), build.closure([build.value(widget("value-{attribute.name}", [attribute.value,], attribute.span)),]),])));
                }
            }
        }
        if element.items.len() > 0 {
            out.push(build.run(widget("container", [], element.span)));
            // (what it holds, each kind once, where it first is: the checker's to find in what it
            // may hold)
            let held: list<string> = [];
            let places: list<Span> = [];
            view-held(element.items, held, places);
            for index in 0..held.len() { out.push(build.run(widget("holds-{held[index]}", [], places[index]))); }
        }
        for item in element.items { view-item-stmts(lowering, writer, item, { parent: local-name, anchor: "", nodes: "", }, out); }
        view-place(local-name, "", at, out);
        local-name
    }

    // whether a widget's element is constant through and through: its attributes and styles
    // literals, no handlers, what it holds constant text and such elements
    view-static: func(element: ViewElement) -> bool {
        if element.module != "" { return false; }
        for attribute in element.attributes {
            if attribute.event || template-value(attribute.value, attribute.style) == "" { return false; }
        }
        for item in element.items {
            match item {
                text(expression) => match expression.kind {
                    str-lit(_) => {}
                    _ => { return false; }
                },
                element(nested) => { if !view-static(nested) { return false; } }
                _ => { return false; }
            }
        }
        true
    }

    // a constant attribute's or style's value as a template writes it ("": not one it writes: an
    // integer an attribute's, whose type may be f64, or anything computed)
    template-value: func(expression: Expr, style: bool) -> string {
        match expression.kind {
            str-lit(literal) => "s{template-text(literal)}",
            bool-lit(flag) => if flag { "t" } else { "f" },
            float-lit(number) => "d{template-text(hex-bits(f64-bits(parse-f64(number))))}",
            int-lit(digits) => if style && digits.len() > 0 && digits.bytes().all({ byte -> byte >= 48 && byte <= 57 }) { "i{template-text(digits)}" } else { "" },
            _ => "",
        }
    }

    // bits as 16 hex digits
    hex-bits: func(bits: u64) -> string {
        let digits = "0123456789abcdef";
        let out = buffer.buffer(16);
        for place in 0..16 { out.push-byte(digits.byte-at(((bits >> ((15 - place) * 4) as u64) & 15) as s64)); }
        out.to-string()
    }

    // a text in a template: its length in bytes, a colon, its bytes
    template-text: func(written: string) -> string { "{written.len()}:{written}" }

    template-attributes: func(attributes: list<ViewAttribute>) -> string {
        let out = buffer.buffer(64);
        for attribute in attributes {
            out.push(if attribute.style { "S" } else { "A" });
            out.push(template-text(attribute.name));
            out.push(template-value(attribute.value, attribute.style));
        }
        out.to-string()
    }

    // a constant element's template: it, its attributes and styles, what it holds
    template-ops: func(element: ViewElement) -> string {
        let out = buffer.buffer(128);
        out.push("E{template-text(element.tag)}");
        out.push(template-attributes(element.attributes));
        for item in element.items {
            match item {
                text(expression) => match expression.kind {
                    str-lit(literal) => out.push("T{template-text(literal)}"),
                    _ => {}
                },
                element(nested) => out.push(template-ops(nested)),
                _ => {}
            }
        }
        out.push("U");
        out.to-string()
    }

    // the calls a template stands for, for the checker (they never run): the widget made, each
    // attribute set and style given as written, and, all of it a template, what it holds
    view-checks: func(lowering: Lowerer, element: ViewElement, attributes: list<ViewAttribute>, deep: bool, out: list<Stmt>) {
        let widget = { name: string, args: list<Expr>, span: Span ->
            let made = node(ExprKind.call({ name: "widget-{element.tag}-{name}", args: args, type-args: [], name-span: span, }), span);
            made
        };
        out.push(build.run(widget("make", [], element.span)));
        for attribute in attributes {
            out.push(build.run(if attribute.style {
                build.module-call("view-host", "style", [build.int(0), build.text(attribute.name), attribute.value,])
            } else {
                widget("set-{attribute.name}", [build.int(0), attribute.value,], attribute.span)
            }));
        }
        if !deep { return; }
        if element.items.len() > 0 {
            out.push(build.run(widget("container", [], element.span)));
            let held: list<string> = [];
            let places: list<Span> = [];
            view-held(element.items, held, places);
            for index in 0..held.len() { out.push(build.run(widget("holds-{held[index]}", [], places[index]))); }
        }
        for item in element.items {
            match item {
                element(nested) => view-checks(lowering, nested, nested.attributes, true, out),
                _ => {}
            }
        }
    }

    // what a widget's element holds directly (its items, an if's branches' and a for's rows'):
    // each widget's tag, and text; another view's element is not told (its tree is its own)
    view-held: func(items: list<ViewItem>, held: list<string>, places: list<Span>) {
        let add = { kind: string, at: Span ->
            if !held.contains(kind) {
                held.push(kind);
                places.push(at);
            }
        };
        for item in items {
            match item {
                text(expression) => add("text", expression.span),
                element(nested) => { if nested.module == "" { add(nested.tag, nested.span); } }
                if-item(conditional) => {
                    view-held(conditional.then, held, places);
                    view-held(conditional.otherwise, held, places);
                }
                for-item(repeated) => view-held(repeated.body, held, places),
                // (what the view is given is the giver's: not told)
                children(_) => {}
            }
        }
    }

    // another view (module.View { props }): made, each prop given (one that reads what changes
    // kept current), its tree made and put where it goes, and let go with the owner it is made
    // under (its nodes removed with the branch, row or view they are in)
    view-component-stmts: func(lowering: Lowerer, writer: ViewWriter, element: ViewElement, at: ViewPlace, out: list<Stmt>) -> string {
        let child = view-local(writer, "view");
        let local-name = view-local(writer, "node");
        let named = "{element.module}.{element.tag}";
        // (each call where what it is for is written: an error in it told there)
        let call = { name: string, args: list<Expr>, at: Span ->
            let made = build.module-call(element.module, name, args);
            made.span = at;
            let module = build.name(element.module);
            module.span = element.module-span;
            match made.kind {
                method(invoked) => { invoked.target = module; invoked.name-span = at; }
                _ => {}
            }
            made
        };
        let typed = Type.named(intern(named));
        out.push(build.typed-let(child, typed, call("new", [], element.span)));
        for attribute in element.attributes {
            if attribute.style {
                view-error(lowering, element.span, "{named} takes props, not styles: style.{attribute.name} goes on an element in it");
                continue;
            }
            // (on.name: the callback's field, on-name)
            let prop = if attribute.event { "on-{attribute.name}" } else { attribute.name };
            let setting = { value: Expr -> build.run(call("view-set-{prop}", [build.name(child), value,], attribute.span)) };
            let reads = view-bind(lowering, writer, attribute.value);
            // (a callback, on.: given once; what it reads, read when it is called)
            let given-once = attribute.event;
            if !reads || given-once {
                out.push(setting(attribute.value));
            } else {
                // (one call, its read a closure, read as the prop's type: view-as-name)
                out.push(build.run(call("view-keep-{prop}", [build.name(child), build.closure([build.value(call("view-as-{prop}", [attribute.value,], attribute.span)),]),], attribute.span)));
            }
        }
        // (items: its children, built where its #children is by a builder made here, in this
        // view's scope: what they read and set this view's)
        if element.items.len() > 0 {
            let parent = view-local(writer, "parent");
            let anchor = view-local(writer, "anchor");
            let nodes = view-local(writer, "nodes");
            let made: list<Stmt> = [];
            let inside: ViewPlace = { parent: parent, anchor: anchor, nodes: nodes, };
            for item in element.items { view-item-stmts(lowering, writer, item, inside, made); }
            out.push(build.run(call("view-set-view-children", [build.name(child), build.closure-of([parent, anchor, nodes,], made),], element.span)));
        }
        out.push(build.bind(local-name, call("view-owned", [build.name(child),], element.span)));
        view-place(local-name, "", at, out);
        local-name
    }

    view-item-stmts: func(lowering: Lowerer, writer: ViewWriter, item: ViewItem, at: ViewPlace, out: list<Stmt>) {
        match item {
            text(expression) => {
                let reads = view-bind(lowering, writer, expression);
                let local-name = view-local(writer, "text");
                if !reads {
                    out.push(build.bind(local-name, build.module-call("dom", "create-text", [expression,])));
                } else {
                    out.push(build.bind(local-name, build.module-call("view-nodes", "kept-text", [build.name("view-host-dom"), build.closure([build.value(expression),]),])));
                }
                view-place(local-name, "", at, out);
            }
            element(nested) => { let _ = view-element-stmts(lowering, writer, nested, at, out); }
            if-item(conditional) => view-if-stmts(lowering, writer, conditional, at, out),
            for-item(repeated) => view-for-stmts(lowering, writer, repeated, at, out),
            children(_) => view-children-stmts(writer, at, out),
        }
    }

    // #children: the items the view is given (its view-children field: a builder the view it is
    // in made, which builds them in that view's scope), as a branch always shown (std's
    // view-nodes.show): placed before its anchor, let go with what it is in
    view-children-stmts: func(writer: ViewWriter, at: ViewPlace, out: list<Stmt>) {
        let anchor = view-local(writer, "anchor");
        let nodes = view-local(writer, "nodes");
        let given = view-local(writer, "children");
        let before = if at.anchor == "" { build.int(0) } else { build.name(at.anchor) };
        let outer = if at.nodes == "" { build.empty-list() } else { build.name(at.nodes) };
        out.push(build.run(build.module-call("view-nodes", "show", [
            build.name("view-host-dom"),
            build.field(build.name("self"), "view-mounted"),
            build.name(at.parent),
            build.truth(at.anchor != ""),
            before,
            outer,
            build.closure([build.value(build.truth(true)),]),
            build.closure-of([anchor, nodes,], [
                build.bind(given, build.field(build.name("self"), "view-children")),
                build.run(build.call(given, [build.name(at.parent), build.name(anchor), build.name(nodes),])),
            ]),
            build.closure-of([anchor, nodes,], []),
        ])));
    }

    // how many times items place #children (an if's branches, a for's rows, elements' items)
    view-children-count: func(items: list<ViewItem>) -> s64 {
        let count = 0;
        for item in items {
            match item {
                element(nested) => { count += view-children-count(nested.items); }
                if-item(conditional) => { count += view-children-count(conditional.then) + view-children-count(conditional.otherwise); }
                for-item(repeated) => { count += view-children-count(repeated.body); }
                children(_) => { count += 1; }
                text(_) => {}
            }
        }
        count
    }

    // a view's #children's span (the first; nowhere for none)
    view-children-span: func(items: list<ViewItem>) -> Span {
        for item in items {
            match item {
                children(at) => { return at; }
                element(nested) => { let found = view-children-span(nested.items); if found.source >= 0 { return found; } }
                if-item(conditional) => {
                    let found = view-children-span(conditional.then);
                    if found.source >= 0 { return found; }
                    let other = view-children-span(conditional.otherwise);
                    if other.source >= 0 { return other; }
                }
                for-item(repeated) => { let found = view-children-span(repeated.body); if found.source >= 0 { return found; } }
                text(_) => {}
            }
        }
        nowhere()
    }

    // what a view's children are built by: given the parent, the node they go before, and the
    // list their parts go in
    view-children-type: func() -> Type {
        Type.func-type({ params: [Type.num("u32"), Type.num("u32"), view-parts(),], result: Type.unit-type, })
    }

    // if: an anchor where its branch goes, and an effect showing the branch its condition picks
    // (made again only when that changes: what the branch made let go with it). Its anchor's part
    // holds what it shows (a row it is in moves it all)
    view-if-stmts: func(lowering: Lowerer, writer: ViewWriter, conditional: ViewIf, at: ViewPlace, out: list<Stmt>) {
        // (std's view-nodes.show does it: what is shown made by its branch, given where it goes)
        let anchor = view-local(writer, "anchor");
        let nodes = view-local(writer, "nodes");
        view-bind(lowering, writer, conditional.cond);
        let inside: ViewPlace = { parent: at.parent, anchor: anchor, nodes: nodes, };
        let then: list<Stmt> = [];
        for item in conditional.then { view-item-stmts(lowering, writer, item, inside, then); }
        let otherwise: list<Stmt> = [];
        for item in conditional.otherwise { view-item-stmts(lowering, writer, item, inside, otherwise); }
        let before = if at.anchor == "" { build.int(0) } else { build.name(at.anchor) };
        let outer = if at.nodes == "" { build.empty-list() } else { build.name(at.nodes) };
        out.push(build.run(build.module-call("view-nodes", "show", [
            build.name("view-host-dom"),
            build.field(build.name("self"), "view-mounted"),
            build.name(at.parent),
            build.truth(at.anchor != ""),
            before,
            outer,
            build.closure([build.value(conditional.cond),]),
            build.closure-of([anchor, nodes,], then),
            build.closure-of([anchor, nodes,], otherwise),
        ])));
    }

    // list<view-nodes.Part>: what a branch or a row placed
    view-parts: func() -> Type { Type.list-type(Type.named(intern("view-nodes.Part"))) }

    // for: an anchor where its rows go, and an effect keeping a row for each item by its key. A
    // row kept is given its item (the body reads it through a getter: what read it is told when
    // it changes); the rows whose old places run in order stay (view-nodes.in-place), the others
    // move; a row is made for a new key where it goes, and let go for a key gone. The anchor's part
    // holds every row's parts (a row this for is in moves them all)
    view-for-stmts: func(lowering: Lowerer, writer: ViewWriter, repeated: ViewFor, at: ViewPlace, out: list<Stmt>) {
        if writer.fields.contains(repeated.name) { view-error(lowering, repeated.span, "{repeated.name} is a field of the view: name the for's variable otherwise"); }
        // (std's view-nodes.rows does it: a row made by the body, given its getter, the node it goes
        // before and its parts)
        // (its getter named for the item, view-item<n>-<name>, its place the item's: a hover there,
        // or on a read of it, tells the item)
        let getter = "{view-local(writer, "item")}-{repeated.name}";
        let before = view-local(writer, "before");
        let row = view-local(writer, "row");
        view-bind(lowering, writer, repeated.items);
        view-bind(lowering, writer, repeated.key);
        if view-children-count(repeated.body) > 0 { view-error(lowering, view-children-span(repeated.body), "#children goes in one place, not in a for's rows (it would be built again in each)"); }
        // (a row's body reads its item through the row's getter: the item it has now)
        view-rename-items(repeated.body, repeated.name, getter);
        writer.getters.push(getter);
        let made: list<Stmt> = [];
        let inside: ViewPlace = { parent: at.parent, anchor: before, nodes: row, };
        for item in repeated.body { view-item-stmts(lowering, writer, item, inside, made); }
        let placed-before = if at.anchor == "" { build.int(0) } else { build.name(at.anchor) };
        let outer = if at.nodes == "" { build.empty-list() } else { build.name(at.nodes) };
        out.push(build.run(build.module-call("view-nodes", "rows", [
            build.name("view-host-dom"),
            build.field(build.name("self"), "view-mounted"),
            build.name(at.parent),
            build.truth(at.anchor != ""),
            placed-before,
            outer,
            build.closure([build.value(repeated.items),]),
            build.closure-of([repeated.name,], [build.value(repeated.key),]),
            build.closure-at([getter, before, row,], [repeated.name-span, nowhere(), nowhere(),], made),
        ])));
    }

    // the items of a for's row, each read of its item (from) a call of the row's getter (to): the
    // item the row has now. A for in them of the same name reads its own
    view-rename-items: func(items: list<ViewItem>, from: string, to: string) {
        for item in items {
            match item {
                text(expression) => view-rename(expression, from, to),
                element(nested) => {
                    for attribute in nested.attributes { view-rename(attribute.value, from, to); }
                    view-rename-items(nested.items, from, to);
                }
                if-item(conditional) => {
                    view-rename(conditional.cond, from, to);
                    view-rename-items(conditional.then, from, to);
                    view-rename-items(conditional.otherwise, from, to);
                }
                for-item(repeated) => {
                    view-rename(repeated.items, from, to);
                    if repeated.name != from {
                        view-rename(repeated.key, from, to);
                        view-rename-items(repeated.body, from, to);
                    }
                }
                children(_) => {}
            }
        }
    }

    // the names of known e reads (each once)
    view-names: func(expression: Expr, known: list<string>, out: list<string>) {
        match expression.kind {
            name(variable) => {
                let text = name-text(variable);
                if known.contains(text) && !out.contains(text) { out.push(text); }
                return;
            }
            _ => {}
        }
        let xs: list<Expr> = [];
        let bs: list<Block> = [];
        walk.expr-parts(expression, xs, bs);
        for item in xs { view-names(item, known, out); }
        for block in bs { view-names-block(block, known, out); }
    }

    view-names-block: func(block: Block, known: list<string>, out: list<string>) {
        for statement in block.stmts {
            let xs: list<Expr> = [];
            let bs: list<Block> = [];
            walk.stmt-parts(statement, xs, bs);
            for item in xs { view-names(item, known, out); }
            for inner in bs { view-names-block(inner, known, out); }
        }
    }

    view-rename: func(expression: Expr, from: string, to: string) {
        match expression.kind {
            name(variable) => {
                if name-text(variable) == from { expression.kind = ExprKind.call({ name: to, args: [], type-args: [], name-span: expression.span, }); }
                return;
            }
            _ => {}
        }
        let xs: list<Expr> = [];
        let bs: list<Block> = [];
        walk.expr-parts(expression, xs, bs);
        for item in xs { view-rename(item, from, to); }
        for block in bs { view-rename-block(block, from, to); }
    }

    view-rename-block: func(block: Block, from: string, to: string) {
        for statement in block.stmts {
            let xs: list<Expr> = [];
            let bs: list<Block> = [];
            walk.stmt-parts(statement, xs, bs);
            for item in xs { view-rename(item, from, to); }
            for inner in bs { view-rename-block(inner, from, to); }
        }
    }
}

// which of a string's bytes are its text's: from (a byte of the file), and for each byte from
// there whether it is kept
record KeptBytes { from: s64, marks: list<bool>, }

// an escape in a string's or char's text: its bytes, and how many bytes of the text it takes
record Escape { text: string, width: s64, }

// a view as written (view Name { fields; its element }), before it is lowered to its resource and
// funcs (lower-view): its fields (each a prop, but those @(private)), and its element's tree
// derived: a let (made of what it reads, made again when that changes); once: a let made once, as
// the view is first built; again: its value parsed again (what view-build makes it with)
// span: its name's (where what lowering makes of a let says it is written)
resource ViewField { name: string, ty: Type, value: Expr, private: bool, mount: bool, derived: bool, once: bool, again: func() -> Expr, span: Span, }

// module: the module of the view it is ("": the host's element, tag its name); span: its tag's
// module-span: its module's name's (another view's)
resource ViewElement { tag: string, module: string, span: Span, module-span: Span, attributes: list<ViewAttribute>, items: list<ViewItem>, }

// name: value; style.name: value (style: a style of the host's vocabulary); on.name: value
// (event: a widget's handler, or another view's callback)
resource ViewAttribute { name: string, style: bool, event: bool, value: Expr, span: Span, }

record ViewIf { cond: Expr, then: list<ViewItem>, otherwise: list<ViewItem>, }

// for name in items key(key) { body }
resource ViewFor { name: string, items: Expr, key: Expr, body: list<ViewItem>, span: Span, name-span: Span, }

variant ViewItem { text(Expr), element(ViewElement), if-item(ViewIf), for-item(ViewFor), children(Span), }

// what lowering a view keeps: its fields' names, its for rows' item getters' names (a read of one
// reads what changes), and how many locals it has made
resource ViewWriter { fields: list<string>, lets: list<string>, getters: list<string>, count: s64, }

// where a node goes: appended to parent ("": the view's top), or (anchor) put before anchor in
// parent and kept as a part in the list nodes names (what a branch or a row shows: let go and
// moved with it)
record ViewPlace { parent: string, anchor: string, nodes: string, }

// Yel the compiler makes, as nodes: what a view is (its resource and funcs) and a regex literal's
// matcher, built as the AST's values (written nowhere: no source holds them, so no note or place
// of a language server's is made of them), never written as text and parsed

module build {
    // a name, an integer, a string, a bool, -1, [], a list
    name: func(identifier: string) -> Expr { lower.node(ExprKind.name(intern(identifier)), nowhere()) }

    int: func(value: s64) -> Expr { lower.node(ExprKind.int-lit("{value}"), nowhere()) }

    text: func(value: string) -> Expr { lower.node(ExprKind.str-lit(value), nowhere()) }

    truth: func(value: bool) -> Expr { lower.node(ExprKind.bool-lit(value), nowhere()) }

    minus-one: func() -> Expr { lower.node(ExprKind.unary({ op: "-", value: int(1), }), nowhere()) }

    empty-list: func() -> Expr { lower.node(ExprKind.list-lit([]), nowhere()) }

    list-of: func(items: list<Expr>) -> Expr { lower.node(ExprKind.list-lit(items), nowhere()) }

    // f(args), by its name (a func, or a local holding one)
    call: func(function-name: string, args: list<Expr>) -> Expr {
        lower.node(ExprKind.call({ name: function-name, args: args, type-args: [], name-span: nowhere(), }), nowhere())
    }

    // target.f(args): a module's func (dom.remove(n)), or one taking target first (xs.push(x))
    method: func(target: Expr, method-name: string, args: list<Expr>) -> Expr {
        lower.node(ExprKind.method({ target: target, name: method-name, args: args, type-args: [], name-span: nowhere(), }), nowhere())
    }

    // module.f(args)
    module-call: func(module: string, function-name: string, args: list<Expr>) -> Expr { method(name(module), function-name, args) }

    field: func(target: Expr, field-name: string) -> Expr {
        lower.node(ExprKind.field({ target: target, name: field-name, name-span: nowhere(), }), nowhere())
    }

    binary: func(op: string, left: Expr, right: Expr) -> Expr {
        lower.node(ExprKind.binary({ op: op, left: left, right: right, }), nowhere())
    }

    // xs[index], a list's item
    item: func(list: Expr, index: Expr) -> Expr { method(list, "at", [index,]) }

    // { -> stmts }, a closure of no params; { a, b -> stmts }, of params (their types inferred)
    closure: func(stmts: list<Stmt>) -> Expr { closure-of([], stmts) }

    closure-of: func(params: list<string>, stmts: list<Stmt>) -> Expr {
        let spans: list<Span> = [];
        for parameter in params { spans.push(nowhere()); }
        closure-at(params, spans, stmts)
    }

    // the same, each param where spans says it is written
    closure-at: func(params: list<string>, spans: list<Span>, stmts: list<Stmt>) -> Expr {
        let types: list<option<Type>> = [];
        for parameter in params { types.push(none); }
        lower.node(ExprKind.closure({ params: params, types: types, body: block(stmts), marks: lower.new-marks(params, spans), unit: { env: false, }, }), nowhere())
    }

    // if cond { yes } else { no }, as a value
    choice: func(cond: Expr, yes: list<Stmt>, no: list<Stmt>) -> Expr {
        lower.node(ExprKind.if-else({ cond: cond, then: block(yes), otherwise: some(block(no)), }), nowhere())
    }

    block: func(stmts: list<Stmt>) -> Block {
        let spans: list<Span> = [];
        for statement in stmts { spans.push(nowhere()); }
        { stmts: stmts, spans: spans, span: nowhere(), }
    }

    // ---- statements

    // let n = value (bind); let n: ty = value; let _ = value;
    bind: func(variable: string, value: Expr) -> Stmt { Stmt.let-stmt({ name: variable, ty: none, value: value, mark: lower.new-mark(variable, nowhere()), }) }

    typed-let: func(variable: string, ty: Type, value: Expr) -> Stmt { Stmt.let-stmt({ name: variable, ty: some(ty), value: value, mark: lower.new-mark(variable, nowhere()), }) }

    // n = value; n op= value
    set: func(variable: string, value: Expr) -> Stmt { set-with(variable, "=", value) }

    set-with: func(variable: string, op: string, value: Expr) -> Stmt {
        Stmt.assign({ name: intern(variable), op: op, value: value, name-span: nowhere(), })
    }

    // target.f = value
    set-field: func(target: Expr, field-name: string, value: Expr) -> Stmt {
        Stmt.assign-field({ target: target, name: field-name, op: "=", value: value, name-span: nowhere(), })
    }

    // e; (its value let go) and e (a block's value)
    run: func(expression: Expr) -> Stmt { Stmt.expr-stmt({ value: expression, is-value: false, }) }

    value: func(expression: Expr) -> Stmt { Stmt.expr-stmt({ value: expression, is-value: true, }) }

    // if cond { yes } (else { no }: none for an empty no)
    when: func(cond: Expr, yes: list<Stmt>, no: list<Stmt>) -> Stmt {
        let otherwise: option<Block> = if no.len() == 0 { none } else { some(block(no)) };
        run(lower.node(ExprKind.if-else({ cond: cond, then: block(yes), otherwise: otherwise, }), nowhere()))
    }

    // loop { body }, break, return value
    forever: func(body: list<Stmt>) -> Stmt { Stmt.loop-stmt({ body: block(body), unit: { env: false, }, }) }

    give: func(value: Expr) -> Stmt { Stmt.return-stmt(value) }

    // match value { arms }, each arm a pattern and its statements
    match-of: func(value: Expr, patterns: list<Pattern>, bodies: list<list<Stmt>>) -> Expr {
        let arms: list<Arm> = [];
        for index in 0..patterns.len() {
            arms.push({ pattern: patterns[index], guard: none, body: lower.node(ExprKind.block(block(bodies[index])), nowhere()), span: nowhere(), });
        }
        lower.node(ExprKind.match-expr({ value: value, arms: arms, }), nowhere())
    }

    // match value { arms }, each arm a pattern and its value
    match-values: func(value: Expr, patterns: list<Pattern>, values: list<Expr>) -> Expr {
        let arms: list<Arm> = [];
        for index in 0..patterns.len() { arms.push({ pattern: patterns[index], guard: none, body: values[index], span: nowhere(), }); }
        lower.node(ExprKind.match-expr({ value: value, arms: arms, }), nowhere())
    }

    // { name: value, … }, a record literal
    record-of: func(names: list<string>, values: list<Expr>) -> Expr {
        let inits: list<FieldInit> = [];
        for index in 0..names.len() { inits.push({ name: names[index], value: values[index], name-span: nowhere(), }); }
        lower.node(ExprKind.record-lit(inits), nowhere())
    }

    // a func of scope: its name, its params' names and types, its result, its body
    func: func(scope: Scope, span: Span, name: string, params: list<string>, types: list<Type>, result: Type, body: list<Stmt>) -> Func {
        let spans: list<Span> = [];
        let defaults: list<option<Expr>> = [];
        for parameter in params {
            spans.push(nowhere());
            defaults.push(none);
        }
        {
            span: span,
            scope: scope,
            name: name,
            type-params: [],
            params: params,
            param-types: types,
            result: result,
            body: block(body),
            marks: lower.new-marks(params, spans),
            unit: { env: false, },
            is-async: false,
            is-generator: false,
            bindings: { exprs: map.new(), assigns: map.new(), },
            defaults: defaults,
            is-test: false,
        }
    }

    // a scope as @(private) makes it (its package's own)
    private: func(sc: Scope) -> Scope {
        { pkg: sc.pkg, module: sc.module, file: sc.file, build: sc.build, includes: sc.includes, requests: sc.requests, private: "package", }
    }
}

// a regex's tree: the empty pattern; a code point; any (.); a class (its ranges, closed, as code
// points: lo, hi, ...); ^ and $ (at a line's too, under m); \b (\B: not); a group (index -1: not
// one that captures); one after another; one of several; one repeated (max -1: no bound)
variant RegexNode {
    empty,
    code(s64),
    class(list<s64>),
    line-start,
    line-end,
    boundary(bool),
    group(RegexGroup),
    sequence(list<RegexNode>),
    choice(list<RegexNode>),
    repeat(RegexRepeat),
}

record RegexGroup { index: s64, body: RegexNode, }

record RegexRepeat { body: RegexNode, min: s64, max: s64, greedy: bool, }

// an instruction: what it does (op: below), its operands, its class's ranges
resource RegexInst { op: s64, a: s64, b: s64, ranges: list<s64>, }

// what a pattern compiles to: its instructions, its groups (the whole match the first), the slots
// its matcher keeps (two for each group, then one for each loop that may match nothing), and each
// group's name ("" for none)
resource RegexProgram { insts: list<RegexInst>, groups: s64, slots: s64, names: list<string>, }

// the pattern being read: its code points, where, its flags, its groups so far and their names
resource RegexReader {
    codes: list<s64>,
    at: s64,
    fold: bool,
    lines: bool,
    dot-all: bool,
    groups: s64,
    names: list<string>,
    error: string,
}

module regexp {
    // the instructions' ops
    const CODE: s64 = 0;
    const CLASS: s64 = 1;
    const SPLIT: s64 = 2;
    const JUMP: s64 = 3;
    const SAVE: s64 = 4;
    const LINE-START: s64 = 5;
    const LINE-END: s64 = 6;
    const BOUNDARY: s64 = 7;
    const ENTER: s64 = 8;
    const PROGRESS: s64 = 9;
    const DONE: s64 = 10;

    // the largest code point
    const MAX-CODE: s64 = 1114111;

    // a pattern and its flags compiled, or what is wrong with them
    compile: func(pattern: string, flags: string) -> result<RegexProgram, string> {
        let reader: RegexReader = {
            codes: [],
            at: 0,
            fold: false,
            lines: false,
            dot-all: false,
            groups: 1,
            names: ["",],
            error: "",
        };
        for index in 0..flags.len() {
            let flag = flags.byte-at(index);
            if flag == 105 { reader.fold = true; }
            else if flag == 109 { reader.lines = true; }
            else if flag == 115 { reader.dot-all = true; }
            else if flag == 103 { return err("no flag g: find-all, replace-all and split take each match"); }
            else { return err("no flag {from-byte(flag)}: the flags are i, m and s"); }
        }
        for code in pattern.chars() { reader.codes.push(code as s64); }
        let tree = alternatives(reader);
        if reader.error == "" && reader.at < reader.codes.len() { reader.error = "an unmatched ) at {reader.at}"; }
        if reader.error != "" { return err(reader.error); }
        let program: RegexProgram = { insts: [], groups: reader.groups, slots: reader.groups * 2, names: reader.names, };
        emit(program, SAVE, 0, 0, []);
        compile-node(program, tree);
        emit(program, SAVE, 1, 0, []);
        emit(program, DONE, 0, 0, []);
        if program.insts.len() > 20000 { return err("too large: {program.insts.len()} instructions (a smaller count, \{n,m\}, makes fewer)"); }
        ok(program)
    }

    // ---- reading

    // one of several (a | b), as far as a ) or the end
    @(private) alternatives: func(reader: RegexReader) -> RegexNode {
        let options: list<RegexNode> = [sequence(reader),];
        loop {
            if reader.error != "" || reader.at >= reader.codes.len() || reader.codes[reader.at] != 124 { break; }
            reader.at += 1;
            options.push(sequence(reader));
        }
        if options.len() == 1 { options[0] } else { RegexNode.choice(options) }
    }

    // one after another, each repeated as a quantifier after it says
    @(private) sequence: func(reader: RegexReader) -> RegexNode {
        let parts: list<RegexNode> = [];
        loop {
            if reader.error != "" || reader.at >= reader.codes.len() { break; }
            let code = reader.codes[reader.at];
            if code == 124 || code == 41 { break; }
            let atom = atom(reader);
            parts.push(quantified(reader, atom));
        }
        if parts.len() == 1 { parts[0] } else if parts.len() == 0 { RegexNode.empty } else { RegexNode.sequence(parts) }
    }

    // an atom, and the quantifier after it if any (*, +, ?, {n}, {n,}, {n,m}; a ? after: lazy)
    @(private) quantified: func(reader: RegexReader, atom: RegexNode) -> RegexNode {
        if reader.at >= reader.codes.len() { return atom; }
        let code = reader.codes[reader.at];
        let min = -1;
        let max = -1;
        if code == 42 { min = 0; max = -1; reader.at += 1; }
        else if code == 43 { min = 1; max = -1; reader.at += 1; }
        else if code == 63 { min = 0; max = 1; reader.at += 1; }
        else if code == 123 {
            let start = reader.at;
            reader.at += 1;
            let low = number(reader);
            if low < 0 {
                // ({ not a count: itself)
                reader.at = start;
                return atom;
            }
            min = low;
            max = low;
            if reader.at < reader.codes.len() && reader.codes[reader.at] == 44 {
                reader.at += 1;
                max = if reader.at < reader.codes.len() && reader.codes[reader.at] == 125 { -1 } else { number(reader) };
            }
            if reader.at >= reader.codes.len() || reader.codes[reader.at] != 125 {
                reader.error = "a count not closed at {start}";
                return atom;
            }
            reader.at += 1;
            if max >= 0 && max < min {
                reader.error = "a count {min} past its most, {max}";
                return atom;
            }
            if max > 1000 || min > 1000 {
                reader.error = "a count past 1000";
                return atom;
            }
        } else { return atom; }
        match atom {
            line-start => { reader.error = "nothing to repeat: ^"; }
            line-end => { reader.error = "nothing to repeat: $"; }
            boundary(_) => { reader.error = "nothing to repeat: \\b"; }
            _ => {}
        }
        let greedy = true;
        if reader.at < reader.codes.len() && reader.codes[reader.at] == 63 {
            greedy = false;
            reader.at += 1;
        }
        RegexNode.repeat({ body: atom, min: min, max: max, greedy: greedy, })
    }

    // a decimal count (-1 for none)
    @(private) number: func(reader: RegexReader) -> s64 {
        let value = -1;
        loop {
            if reader.at >= reader.codes.len() { break; }
            let code = reader.codes[reader.at];
            if code < 48 || code > 57 { break; }
            value = (if value < 0 { 0 } else { value }) * 10 + code - 48;
            if value > 100000 { value = 100000; }
            reader.at += 1;
        }
        value
    }

    // a group, a class, ., ^, $, an escape, or a code point
    @(private) atom: func(reader: RegexReader) -> RegexNode {
        let code = reader.codes[reader.at];
        reader.at += 1;
        if code == 40 { return group(reader); }
        if code == 91 { return RegexNode.class(class(reader)); }
        if code == 46 {
            // . : any but a line break (s: any)
            return RegexNode.class(if reader.dot-all { [0, MAX-CODE,] } else { complement([10, 10, 13, 13, 8232, 8233,]) });
        }
        if code == 94 { return RegexNode.line-start; }
        if code == 36 { return RegexNode.line-end; }
        if code == 92 { return escape(reader); }
        if code == 42 || code == 43 || code == 63 {
            reader.error = "nothing to repeat at {reader.at - 1}";
            return RegexNode.empty;
        }
        if code == 123 && reader.at < reader.codes.len() && is-digit(reader.codes[reader.at]) {
            reader.error = "nothing to repeat at {reader.at - 1}";
            return RegexNode.empty;
        }
        literal(reader, code)
    }

    // ( … ): a group that captures, (?: … ) one that does not, (?<name> … ) one named
    @(private) group: func(reader: RegexReader) -> RegexNode {
        let index = -1;
        if reader.at + 1 < reader.codes.len() && reader.codes[reader.at] == 63 {
            let kind = reader.codes[reader.at + 1];
            if kind == 58 {
                reader.at += 2;
            } else if kind == 60 && reader.at + 2 < reader.codes.len() && reader.codes[reader.at + 2] != 61 && reader.codes[reader.at + 2] != 33 {
                reader.at += 2;
                let name = buffer(8);
                loop {
                    if reader.at >= reader.codes.len() {
                        reader.error = "a group's name not closed";
                        return RegexNode.empty;
                    }
                    let code = reader.codes[reader.at];
                    reader.at += 1;
                    if code == 62 { break; }
                    if !(is-digit(code) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 45) {
                        reader.error = "a group's name is letters, digits, - and _";
                        return RegexNode.empty;
                    }
                    name.push-char(code as char);
                }
                let named = name.to-string();
                if named == "" || reader.names.contains(named) {
                    reader.error = if named == "" { "a group's name is empty" } else { "two groups named {named}" };
                    return RegexNode.empty;
                }
                index = reader.groups;
                reader.groups += 1;
                reader.names.push(named);
            } else {
                reader.error = "(?{from-byte(kind)}: no such group (lookaround is not compiled: (?: … ) and (?<name> … ) are)";
                return RegexNode.empty;
            }
        } else {
            index = reader.groups;
            reader.groups += 1;
            reader.names.push("");
        }
        let body = alternatives(reader);
        if reader.error != "" { return RegexNode.empty; }
        if reader.at >= reader.codes.len() || reader.codes[reader.at] != 41 {
            reader.error = "a group not closed";
            return RegexNode.empty;
        }
        reader.at += 1;
        RegexNode.group({ index: index, body: body, })
    }

    // [ … ]: its ranges ([^ … ]: those not in it), each a code point, a range a-z, or an escape
    @(private) class: func(reader: RegexReader) -> list<s64> {
        let negated = reader.at < reader.codes.len() && reader.codes[reader.at] == 94;
        if negated { reader.at += 1; }
        let ranges: list<s64> = [];
        let first = true;
        loop {
            if reader.at >= reader.codes.len() {
                reader.error = "a class not closed";
                return [];
            }
            let code = reader.codes[reader.at];
            if code == 93 && !first { break; }
            first = false;
            reader.at += 1;
            let low = code;
            if code == 92 {
                if reader.at >= reader.codes.len() {
                    reader.error = "a \\ at the end";
                    return [];
                }
                let following = reader.codes[reader.at];
                reader.at += 1;
                match class-escape(following) {
                    some(set) => {
                        for range in set { ranges.push(range); }
                        continue;
                    }
                    none => {}
                }
                low = escaped-code(reader, following);
            }
            // a range a-z (a - before ] is itself)
            if reader.at + 1 < reader.codes.len() && reader.codes[reader.at] == 45 && reader.codes[reader.at + 1] != 93 {
                reader.at += 1;
                let high = reader.codes[reader.at];
                reader.at += 1;
                if high == 92 && reader.at < reader.codes.len() {
                    let following = reader.codes[reader.at];
                    reader.at += 1;
                    high = escaped-code(reader, following);
                }
                if high < low {
                    reader.error = "a range out of order: {low as char}-{high as char}";
                    return [];
                }
                ranges.push(low);
                ranges.push(high);
            } else {
                ranges.push(low);
                ranges.push(low);
            }
        }
        reader.at += 1;
        let set = if reader.fold { folded(normal(ranges)) } else { normal(ranges) };
        if negated { complement(set) } else { set }
    }

    // \ and what follows: a class (\d \w \s and their complements), \b \B, or a code point
    @(private) escape: func(reader: RegexReader) -> RegexNode {
        if reader.at >= reader.codes.len() {
            reader.error = "a \\ at the end";
            return RegexNode.empty;
        }
        let code = reader.codes[reader.at];
        reader.at += 1;
        if code == 98 { return RegexNode.boundary(false); }
        if code == 66 { return RegexNode.boundary(true); }
        if code >= 49 && code <= 57 {
            reader.error = "\\{from-byte(code)}: back references are not compiled";
            return RegexNode.empty;
        }
        match class-escape(code) {
            some(set) => { return RegexNode.class(normal(set)); }
            none => {}
        }
        literal(reader, escaped-code(reader, code))
    }

    // a code point as the pattern says it (i: a letter in either case)
    @(private) literal: func(reader: RegexReader, code: s64) -> RegexNode {
        if reader.fold && ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) { return RegexNode.class(folded([code, code,])); }
        RegexNode.code(code)
    }

    // \d \D \w \W \s \S: their ranges (none: another escape)
    @(private) class-escape: func(code: s64) -> option<list<s64>> {
        let digits = [48, 57,];
        let word = [48, 57, 65, 90, 95, 95, 97, 122,];
        let space = [9, 13, 32, 32, 160, 160, 5760, 5760, 8192, 8202, 8232, 8233, 8239, 8239, 8287, 8287, 12288, 12288, 65279, 65279,];
        if code == 100 { return some(digits); }
        if code == 68 { return some(complement(digits)); }
        if code == 119 { return some(word); }
        if code == 87 { return some(complement(word)); }
        if code == 115 { return some(space); }
        if code == 83 { return some(complement(space)); }
        none
    }

    // the code point an escape is: \n \t \r \f \v \0, \xHH, \uHHHH, \u{H…}, or the code point
    // itself (\. \/ \\ …)
    @(private) escaped-code: func(reader: RegexReader, code: s64) -> s64 {
        if code == 110 { return 10; }
        if code == 116 { return 9; }
        if code == 114 { return 13; }
        if code == 102 { return 12; }
        if code == 118 { return 11; }
        if code == 48 { return 0; }
        if code == 120 { return hex(reader, 2); }
        if code == 117 {
            if reader.at < reader.codes.len() && reader.codes[reader.at] == 123 {
                reader.at += 1;
                let value = 0;
                let digits = 0;
                loop {
                    if reader.at >= reader.codes.len() || reader.codes[reader.at] == 125 { break; }
                    match to-digit(reader.codes[reader.at], 16) {
                        some(digit) => { value = value * 16 + digit; }
                        none => {
                            reader.error = "\\u\{…\} takes hex digits";
                            return 0;
                        }
                    }
                    digits += 1;
                    reader.at += 1;
                }
                reader.at += 1;
                if digits == 0 || value > MAX-CODE { reader.error = "\\u\{…\} is a code point, up to 10FFFF"; }
                return value;
            }
            return hex(reader, 4);
        }
        code
    }

    // n hex digits' value
    @(private) hex: func(reader: RegexReader, count: s64) -> s64 {
        let value = 0;
        for index in 0..count {
            if reader.at >= reader.codes.len() {
                reader.error = "{count} hex digits were expected";
                return 0;
            }
            match to-digit(reader.codes[reader.at], 16) {
                some(digit) => { value = value * 16 + digit; }
                none => {
                    reader.error = "{count} hex digits were expected";
                    return 0;
                }
            }
            reader.at += 1;
        }
        value
    }

    // ---- ranges (pairs lo, hi of code points)

    // sorted and joined: none overlapping or touching
    @(private) normal: func(ranges: list<s64>) -> list<s64> {
        let pairs: list<tuple<s64, s64>> = [];
        let index = 0;
        loop {
            if index + 1 >= ranges.len() { break; }
            pairs.push((ranges[index], ranges[index + 1]));
            index += 2;
        }
        pairs.sort({ one, other -> one.0 < other.0 });
        let out: list<s64> = [];
        for pair in pairs {
            let (low, high) = pair;
            if out.len() > 0 && low <= out[out.len() - 1] + 1 {
                if high > out[out.len() - 1] { out[out.len() - 1] = high; }
            } else {
                out.push(low);
                out.push(high);
            }
        }
        out
    }

    // what a set does not hold, of every code point
    @(private) complement: func(ranges: list<s64>) -> list<s64> {
        let set = normal(ranges);
        let out: list<s64> = [];
        let next = 0;
        let index = 0;
        loop {
            if index + 1 >= set.len() { break; }
            if set[index] > next {
                out.push(next);
                out.push(set[index] - 1);
            }
            next = set[index + 1] + 1;
            index += 2;
        }
        if next <= MAX-CODE {
            out.push(next);
            out.push(MAX-CODE);
        }
        out
    }

    // a set with each ASCII letter's other case too (i)
    @(private) folded: func(ranges: list<s64>) -> list<s64> {
        let out: list<s64> = [];
        let index = 0;
        loop {
            if index + 1 >= ranges.len() { break; }
            let low = ranges[index];
            let high = ranges[index + 1];
            out.push(low);
            out.push(high);
            // the letters in it, the other case
            let upper-low = if low > 65 { low } else { 65 };
            let upper-high = if high < 90 { high } else { 90 };
            if upper-low <= upper-high {
                out.push(upper-low + 32);
                out.push(upper-high + 32);
            }
            let lower-low = if low > 97 { low } else { 97 };
            let lower-high = if high < 122 { high } else { 122 };
            if lower-low <= lower-high {
                out.push(lower-low - 32);
                out.push(lower-high - 32);
            }
            index += 2;
        }
        normal(out)
    }

    // ---- compiling

    @(private) emit: func(program: RegexProgram, op: s64, one: s64, other: s64, ranges: list<s64>) -> s64 {
        program.insts.push({ op: op, a: one, b: other, ranges: ranges, });
        program.insts.len() - 1
    }

    // a node's instructions, at the end of program's
    @(private) compile-node: func(program: RegexProgram, node: RegexNode) {
        match node {
            empty => {}
            code(character) => { let _ = emit(program, CODE, character, 0, []); }
            class(ranges) => { let _ = emit(program, CLASS, 0, 0, ranges); }
            line-start => { let _ = emit(program, LINE-START, 0, 0, []); }
            line-end => { let _ = emit(program, LINE-END, 0, 0, []); }
            boundary(negated) => { let _ = emit(program, BOUNDARY, if negated { 1 } else { 0 }, 0, []); }
            group(grouped) => {
                if grouped.index >= 0 { let _ = emit(program, SAVE, grouped.index * 2, 0, []); }
                compile-node(program, grouped.body);
                if grouped.index >= 0 { let _ = emit(program, SAVE, grouped.index * 2 + 1, 0, []); }
            }
            sequence(parts) => { for part in parts { compile-node(program, part); } }
            choice(options) => {
                // split to each, the first tried first; each jumps past the others when it is done
                let jumps: list<s64> = [];
                for index in 0..options.len() {
                    if index + 1 < options.len() {
                        let split = emit(program, SPLIT, 0, 0, []);
                        program.insts[split].a = program.insts.len();
                        compile-node(program, options[index]);
                        jumps.push(emit(program, JUMP, 0, 0, []));
                        program.insts[split].b = program.insts.len();
                    } else {
                        compile-node(program, options[index]);
                    }
                }
                for jump in jumps { program.insts[jump].a = program.insts.len(); }
            }
            repeat(repeating) => repeated(program, repeating),
        }
    }

    // body min times, then up to max more (any more: a loop), the ones past min each a choice (a
    // greedy one tried first, a lazy one last); a loop whose body may match nothing ends where it
    // does
    @(private) repeated: func(program: RegexProgram, repeat: RegexRepeat) {
        for index in 0..repeat.min { compile-node(program, repeat.body); }
        if repeat.max < 0 {
            let empty = nullable(repeat.body);
            let slot = program.slots;
            if empty { program.slots += 1; }
            let top = emit(program, SPLIT, 0, 0, []);
            let body = program.insts.len();
            if empty { let _ = emit(program, ENTER, slot, 0, []); }
            compile-node(program, repeat.body);
            if empty { let _ = emit(program, PROGRESS, slot, 0, []); }
            let _ = emit(program, JUMP, top, 0, []);
            choose(program, top, body, program.insts.len(), repeat.greedy);
            return;
        }
        let splits: list<s64> = [];
        for index in repeat.min..repeat.max {
            let split = emit(program, SPLIT, 0, 0, []);
            splits.push(split);
            program.insts[split].a = program.insts.len();
            compile-node(program, repeat.body);
        }
        for split in splits { choose(program, split, program.insts[split].a, program.insts.len(), repeat.greedy); }
    }

    // a split's two ways: the body's first where greedy, else past it first
    @(private) choose: func(program: RegexProgram, split: s64, body: s64, past: s64, greedy: bool) {
        program.insts[split].a = if greedy { body } else { past };
        program.insts[split].b = if greedy { past } else { body };
    }

    // whether a node may match nothing
    @(private) nullable: func(node: RegexNode) -> bool {
        match node {
            empty => true,
            code(_) => false,
            class(_) => false,
            line-start => true,
            line-end => true,
            boundary(_) => true,
            group(grouped) => nullable(grouped.body),
            sequence(parts) => parts.all({ part -> nullable(part) }),
            choice(options) => options.any({ option -> nullable(option) }),
            repeat(repeating) => repeating.min == 0 || nullable(repeating.body),
        }
    }

    // ---- writing

    // program's matcher, as nodes: name(text, start, slots) -> bool, @(private) in scope, its
    // states a match on pc. Its choices and the slots it sets are kept on a stack, as std's regex
    // keeps them (choose, save): a failure goes back to the last choice (back)
    matcher: func(program: RegexProgram, name: string, lines: bool, scope: Scope) -> Func {
        let patterns: list<Pattern> = [];
        let arms: list<list<Stmt>> = [];
        for index in 0..program.insts.len() {
            patterns.push(Pattern.literal(build.int(index)));
            arms.push(state(program.insts[index], index + 1, lines));
        }
        patterns.push(Pattern.wild);
        // a failure: back to the last choice (none: no match)
        arms.push([
            build.set("pc", build.module-call("regex", "back", [build.name("stack"), build.name("slots"),])),
            build.when(build.binary("<", build.name("pc"), build.int(0)), [build.give(build.truth(false)),], []),
            build.set("at", popped()),
        ]);
        let body = [
            build.typed-let("stack", Type.list-type(Type.num("s64")), build.empty-list()),
            build.bind("pc", build.int(0)),
            build.bind("at", build.name("start")),
            build.bind("size", length("text")),
            build.forever([build.run(build.match-of(build.name("pc"), patterns, arms)),]),
        ];
        build.func(
            build.private(scope),
            nowhere(),
            name,
            ["text", "start", "slots",],
            [Type.string-type, Type.num("s64"), Type.list-type(Type.num("s64")),],
            Type.bool-type,
            body,
        )
    }

    // one state's statements: what its instruction does, the state it goes on to (pc), -1 where
    // it fails
    @(private) state: func(inst: RegexInst, next: s64, lines: bool) -> list<Stmt> {
        let go = { to: s64 -> build.set("pc", build.int(to)) };
        let fail = { -> build.set("pc", build.minus-one()) };
        let to = { yes: Expr -> build.set("pc", build.choice(yes, [build.value(build.int(next)),], [build.value(build.minus-one()),])) };
        let at = build.name("at");
        if inst.op == CODE { return [code-test(inst.a, next),]; }
        if inst.op == CLASS {
            return [build.when(
                build.binary("<", at, build.name("size")),
                [
                    build.bind("step", build.module-call("regex", "next-code", [build.name("text"), build.name("at"),])),
                    build.bind("c", build.binary(">>", build.name("step"), build.int(3))),
                    build.when(ranges-test(inst.ranges), [build.set-with("at", "+=", build.binary("&", build.name("step"), build.int(7))), go(next),], [fail(),]),
                ],
                [fail(),],
            ),];
        }
        if inst.op == SPLIT { return [build.run(build.module-call("regex", "choose", [build.name("stack"), build.int(inst.b), at,])), go(inst.a),]; }
        if inst.op == JUMP { return [go(inst.a),]; }
        if inst.op == SAVE || inst.op == ENTER {
            return [build.run(build.module-call("regex", "save", [build.name("stack"), build.name("slots"), build.int(inst.a), at,])), go(next),];
        }
        if inst.op == PROGRESS {
            return [build.set("pc", build.choice(build.binary("==", at, build.item(build.name("slots"), build.int(inst.a))), [build.value(build.minus-one()),], [build.value(build.int(next)),])),];
        }
        if inst.op == LINE-START {
            let start = build.binary("==", at, build.int(0));
            return [to(if lines { build.binary("||", start, build.binary("==", text-byte(build.binary("-", build.name("at"), build.int(1))), build.int(10))) } else { start }),];
        }
        if inst.op == LINE-END {
            let end = build.binary("==", at, build.name("size"));
            return [to(if lines { build.binary("||", end, build.binary("==", text-byte(build.name("at")), build.int(10))) } else { end }),];
        }
        if inst.op == BOUNDARY {
            let boundary = build.module-call("regex", "boundary", [build.name("text"), build.name("at"),]);
            return [to(build.binary(if inst.a == 1 { "!=" } else { "==" }, boundary, build.truth(true))),];
        }
        [build.give(build.truth(true)),]
    }

    // a code point's test: its UTF-8 bytes there, one after another
    @(private) code-test: func(code: s64, next: s64) -> Stmt {
        let bytes = "{code as char}".bytes();
        let test = build.binary("<=", build.binary("+", build.name("at"), build.int(bytes.len())), build.name("size"));
        for index in 0..bytes.len() {
            let there = text-byte(build.binary("+", build.name("at"), build.int(index)));
            test = build.binary("&&", test, build.binary("==", there, build.int(bytes[index] as s64)));
        }
        build.when(test, [build.set-with("at", "+=", build.int(bytes.len())), build.set("pc", build.int(next)),], [build.set("pc", build.minus-one()),])
    }

    // whether c is in ranges
    @(private) ranges-test: func(ranges: list<s64>) -> Expr {
        let test: option<Expr> = none;
        let code-name = { -> build.name("c") };
        let index = 0;
        loop {
            if index + 1 >= ranges.len() { break; }
            let low = ranges[index];
            let high = ranges[index + 1];
            let one = if low == high {
                build.binary("==", code-name(), build.int(low))
            } else if low == 0 {
                build.binary("<=", code-name(), build.int(high))
            } else if high == MAX-CODE {
                build.binary(">=", code-name(), build.int(low))
            } else {
                build.binary("&&", build.binary(">=", code-name(), build.int(low)), build.binary("<=", code-name(), build.int(high)))
            };
            test = some(match test {
                some(before) => build.binary("||", before, one),
                none => one,
            });
            index += 2;
        }
        test.unwrap-or(build.truth(false))
    }

    // text.byte-at(at), stack.pop(), a list's len() (not named as the methods:
    // a func of the module would take their calls)
    @(private) text-byte: func(at: Expr) -> Expr { build.method(build.name("text"), "byte-at", [at,]) }

    @(private) popped: func() -> Expr { build.method(build.name("stack"), "pop", []) }

    @(private) length: func(name: string) -> Expr { build.method(build.name(name), "len", []) }
}
