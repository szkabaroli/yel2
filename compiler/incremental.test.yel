// The incremental check, tested (yelc test compiler): a check that takes what an earlier one kept
// (Context.cache: unchanged files' trees, unchanged funcs' checked bodies) finds what a check of
// nothing kept finds, edit after edit of a real file: the same problems, references and targets
// (each where it is, its signature and its docs). And it does take them: an untouched func's body
// is the earlier check's

from "std:testing" include expect;

module incremental-tests {
    // the compiler's package checked with file's text as given: from what cache keeps (none: from
    // nothing)
    @(private) checked: async func(file: string, text: string, cache: option<Incremental>) -> analysis.Checked {
        let overlays: map<string, string> = map.new();
        overlays.set(file, text);
        let context = analysis.context("compiler", overlays);
        context.cache = cache;
        wait analysis.check(context, "runtime/prelude.yel", [])
    }

    // what a check found, as text: its problems, then each reference (where, and what it names),
    // then each target
    @(private) found: func(c: analysis.Checked) -> string {
        let out: list<string> = [];
        for p in c.problems { out.push("problem {p.place.path}:{p.place.line}:{p.place.col} {p.message}"); }
        for r in c.references {
            let t = c.targets[r.target];
            out.push("reference {r.place.path}:{r.place.line}:{r.place.col} {t.container}.{t.name}");
        }
        for t in c.targets { out.push("target {t.container}.{t.name} {t.place.path}:{t.place.line}:{t.place.col} {t.signature} | {t.docs}"); }
        out.join("\n")
    }

    // the first line where two texts differ, and each's
    @(private) first-difference: func(was: string, now: string) -> string {
        let a = was.split("\n");
        let b = now.split("\n");
        for index in 0..a.len() {
            if index >= b.len() || a[index] != b[index] {
                return "line {index}:\n  full:        {a[index]}\n  incremental: {if index < b.len() { b[index] } else { "(none)" }}";
            }
        }
        "the incremental has {b.len() - a.len()} more lines"
    }

    // file's text edited (from given with what), checked from the cache and from nothing: the same
    @(private) same-as-full: async func(cache: Incremental, file: string, text: string, given: string, with: string) -> analysis.Checked {
        if !text.contains(given) { expect.fail("{file} has no {given:?} to edit"); }
        let edited = text.replace(given, with);
        let incremental = wait checked(file, edited, some(cache));
        let full = wait checked(file, edited, none);
        let was = found(full);
        let now = found(incremental);
        if was != now { expect.fail("an incremental check differs from a full one, after {given:?} became {with:?}: {first-difference(was, now)}"); }
        incremental
    }

    // a func's body edited, then another's: each check the same as a full one; an untouched func's
    // body taken from the check before
    @(test) body-edits: async func() {
        let file = "compiler/lower.yel";
        let text = expect.ok(wait diagnostics.read-file(file));
        let cache = incremental();
        let first = wait checked(file, text, some(cache));
        let second = wait same-as-full(cache, file, text, "        let all = tree.child-nodes(n);\n", "        let all = tree.child-nodes(n);\n        let counted = all.len();\n");
        // (an untouched func, in another file: its body the first check's, not checked again)
        expect.holds(same-body(first, second, "lexer.lex-file"));
        expect.holds(!same-body(first, second, "lower.first-node"));
        // (an error made in a body: told as a full check tells it)
        let third = wait same-as-full(cache, file, text, "        let all = tree.child-nodes(n);\n", "        let all = tree.child-nodes(n);\n        let broken: s64 = \"text\";\n");
        expect.holds(third.problems.len() > 0);
        // (lines added above funcs of the same file: they move, and are checked again)
        let _ = wait same-as-full(cache, file, text, "module lower \{\n", "module lower \{\n\n\n");
    }

    // a signature edited: every body checked again (one may read it), the same as a full check
    @(test) signature-edit: async func() {
        let file = "compiler/lower.yel";
        let text = expect.ok(wait diagnostics.read-file(file));
        let cache = incremental();
        let first = wait checked(file, text, some(cache));
        let second = wait same-as-full(cache, file, text, "    first-node: func(n: SyntaxNode) -> option<SyntaxNode> \{", "    first-node: func(n: SyntaxNode, unused: s64 = 0) -> option<SyntaxNode> \{");
        expect.holds(!same-body(first, second, "lexer.lex-file"));
    }

    // whether the func named key has the same checked body (its marks: the one list) in two checks
    @(private) same-body: func(a: analysis.Checked, b: analysis.Checked, key: string) -> bool {
        let x = func-named(a, key);
        let y = func-named(b, key);
        match (x, y) {
            (some(f), some(g)) => f.marks == g.marks,
            _ => false,
        }
    }

    @(private) func-named: func(c: analysis.Checked, key: string) -> option<Func> {
        for d in c.compiled.prog.decls {
            match d {
                func-decl(f) => { if f.name.ends-with(key) { return some(f); } }
                _ => {}
            }
        }
        none
    }
}
