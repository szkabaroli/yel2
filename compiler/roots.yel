// The collector's roots: which funcs can collect, and which locals the collector must see (a slot
// in the func's frame). yel may collect in any call that allocates, not only between turns.

// what the walk over a func learns: the positions (two for each statement: its uses, then what it
// allocates) of each local's first def and last use, where allocations happen, and, for each loop
// being walked, the locals used in it
resource Ranges {
    first-def: list<s64>,
    last-use: list<s64>,
    allocs: list<s64>,
    pos: s64,
    loop-uses: list<list<s64>>,
}

module opt {
    // whether a statement's value can collect: 0 no; 1 yes, after its arguments are handed over (a
    // yel func's call: the callee keeps what it needs); 2 yes, while it still reads its arguments
    // (the runtime's call, an alloc, a string made of pieces)
    collects: func(node: Node, allocating: map<Name, bool>) -> s64 {
        if (node.fx & fx().call) == 0 { return 0; }
        match node.kind {
            call(called) => {
                if called.key == "" { 2 }
                else if allocating.get-or(called.name, false) { 1 }
                else { 0 }
            }
            alloc(allocation) => if allocation.stack { 0 } else { 2 },
            interp(_) => 2,
            // a func value's: which is not known, so any may collect
            call-ref(_) => 1,
            _ => 0,
        }
    }

    // a statement's value: itself, or what it assigns
    value: func(node: Node) -> Node {
        match node.kind {
            assign(assignment) => assignment.value,
            _ => node,
        }
    }

    // which funcs can collect (by C name): a fixed point, from none
    allocating-funcs: func(funcs: list<IrFunc>) -> map<Name, bool> {
        let allocating: map<Name, bool> = map.new();
        for function in funcs { allocating.set(function.name, false); }
        for round in 0..1000 {
            let changed = false;
            for function in funcs {
                if !allocating[function.name] && body-collects(function.body, allocating) {
                    allocating.set(function.name, true);
                    changed = true;
                }
            }
            if !changed { return allocating; }
        }
        allocating
    }

    body-collects: func(body: list<Node>, allocating: map<Name, bool>) -> bool {
        for node in flatten(body) {
            if collects(value(node), allocating) > 0 { return true; }
        }
        false
    }

    // which of a func's locals the collector must see: those holding a value (pointers or not: the
    // renderer asks only for those with pointers) live across a point where it may collect
    rooted: func(function: IrFunc, allocating: map<Name, bool>) -> list<bool> {
        let count = function.locals.len();
        let ranges: Ranges = { first-def: [], last-use: [], allocs: [], pos: 0, loop-uses: [], };
        for local in 0..count {
            ranges.first-def.push(-1);
            ranges.last-use.push(-1);
        }
        // a parameter is defined on entry, and so is a closure's environment
        for parameter in function.params { ranges.first-def[parameter] = 0; }
        if function.env-param >= 0 { ranges.first-def[function.env-param] = 0; }
        walk(ranges, function.body, allocating);
        // how many allocations happen before each position
        let before: list<s64> = [];
        let allocated = 0;
        for position in 0..ranges.pos + 5 {
            before.push(allocated);
            if allocated < ranges.allocs.len() && ranges.allocs[allocated] == position { allocated += 1; }
        }
        let out: list<bool> = [];
        for local in 0..count {
            let defined = ranges.first-def[local];
            let latest = ranges.last-use[local];
            // an allocation strictly between its def and its last use
            let across = defined >= 0 && latest > defined + 1 && before[latest] - before[defined + 1] > 0;
            out.push(across);
        }
        out
    }

    use: func(ranges: Ranges, local: s64, at: s64) {
        if at > ranges.last-use[local] { ranges.last-use[local] = at; }
        for uses in ranges.loop-uses { uses.push(local); }
    }

    def: func(ranges: Ranges, local: s64, at: s64) {
        if ranges.first-def[local] < 0 { ranges.first-def[local] = at; }
    }

    // a statement at the next position: its uses (at 2k, or, while its value still reads them,
    // after its allocation), its allocation (2k + 1), what it assigns (2k + 2)
    step: func(ranges: Ranges, node: Node, allocating: map<Name, bool>) {
        ranges.pos += 2;
        let at = ranges.pos;
        let kind = collects(value(node), allocating);
        let read: list<s64> = [];
        reads(node, read);
        for local in read { use(ranges, local, if kind == 2 { at + 2 } else { at }); }
        if kind > 0 { ranges.allocs.push(at + 1); }
        match node.kind {
            assign(assignment) => def(ranges, assignment.dest, at + 2),
            _ => {}
        }
    }

    walk: func(ranges: Ranges, body: list<Node>, allocating: map<Name, bool>) {
        for node in body {
            match node.kind {
                loop(looping) => loop-range(ranges, looping, allocating),
                _ => {
                    step(ranges, node, allocating);
                    for index in 0..nested-count(node) { walk(ranges, nested-body(node, index), allocating); }
                }
            }
        }
    }

    // a loop: its test before each turn, its body, its step after; what is used in it and was
    // defined before it is live to its end (it runs again)
    loop-range: func(ranges: Ranges, looping: LoopNode, allocating: map<Name, bool>) {
        ranges.pos += 2;
        let start = ranges.pos;
        ranges.loop-uses.push([]);
        match looping.test {
            some(test) => step(ranges, test, allocating),
            none => {}
        }
        walk(ranges, looping.body, allocating);
        match looping.step {
            some(after) => step(ranges, after, allocating),
            none => {}
        }
        ranges.pos += 2;
        let end = ranges.pos;
        let used = ranges.loop-uses.pop();
        for local in used {
            if ranges.first-def[local] < start && ranges.last-use[local] < end { ranges.last-use[local] = end; }
        }
    }
}
