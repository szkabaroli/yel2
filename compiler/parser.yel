// The parser: tokens to declarations (with their scopes: package, module, includes).

// scope: where the declarations being read go
// recovering: past an error, until the statement or declaration it is in is passed over (errors
// meanwhile are its echoes: not reported); quiet: the file's lexer found errors (those are told: its
// tokens may be wrong past them, so the parser's errors in it would be echoes)
record Parser {
    toks: list<Token>,
    pos: s64,
    context: Context,
    source: s64,
    scope: Scope,
    recovering: bool,
    quiet: bool,
}

// "text {expr} text": a string literal, or an interpolation of pieces (at is the string's span)
// where a literal's text is in the file: its first byte's line and column; each later line of it
// starts at column indent + 1 (a multiline string's lines gave up their indent)
record Origin { line: s64, col: s64, indent: s64, }

// an escape in a string's or char's text: its bytes, and how many bytes of the text it takes
record Escape { text: string, width: s64, }

module parser {
    // a parser of src, (part of) the text of sources[source], from its line first-line, column
    // first-col
    parser: func(context: Context, source: s64, src: string, first-line: s64, first-col: s64) -> Parser {
        let before = context.errors.len();
        let toks = lexer.lex(src, context, source, first-line, first-col);
        let p: Parser = {
            toks: toks,
            pos: 0,
            context: context,
            recovering: false,
            quiet: context.errors.len() > before,
            source: source,
            scope: blank-scope(context.sources[source].path),
        };
        // a file's first line //+build <target>: what its funcs are made for
        if first-line == 1 && first-col == 1 && starts-with(src, "//+build ") {
            let line = src.substring(9, src.find-byte(10).unwrap-or(src.len())).trim();
            if line != "native" && line != "wasi" {
                let at: Span = { source: source, line: 1, col: 10, end-line: 1, end-col: 10 + line.len(), };
                diagnostics.report(context, diagnostics.error(at, "a build target is native or wasi, not {line}", ""));
            }
            p.scope.build = line;
        }
        p
    }

    // the token o past the next (the end of the file's for any past it: a parser recovering from an
    // error may look there)
    tok: func(p: Parser, o: s64) -> Token {
        let at = p.pos + o;
        if at >= p.toks.len() { return p.toks[p.toks.len() - 1]; }
        if at < 0 { return p.toks[0]; }
        p.toks[at]
    }

    // the next token's span
    here: func(p: Parser) -> Span { tok(p, 0).span }

    // from start to the end of the last token taken
    span-from: func(p: Parser, start: Span) -> Span {
        let last = tok(p, -1).span;
        { source: start.source, line: start.line, col: start.col, end-line: last.end-line, end-col: last.end-col, }
    }

    text: func(p: Parser) -> string { tok(p, 0).text }

    // the next token as an error says what was found: quoted, or the end of the file
    found: func(p: Parser) -> string {
        if is-kind(p, 0, TokenKind.eof) { "the end of the file" } else { "'{text(p)}'" }
    }

    // the next token taken (never past the end of the file's)
    advance: func(p: Parser) {
        if p.pos < p.toks.len() - 1 { p.pos += 1; }
    }

    // whether the token at offset o is the operator or name v
    at-off: func(p: Parser, v: string, o: s64) -> bool {
        let t = tok(p, o);
        t.kind != TokenKind.str && t.kind != TokenKind.int && t.text == v
    }

    at: func(p: Parser, v: string) -> bool { at-off(p, v, 0) }

    is-kind: func(p: Parser, o: s64, k: TokenKind) -> bool { tok(p, o).kind == k }

    // a syntax error at the next token, kept: the parser goes on (recovering, until the statement or
    // declaration is passed over); its callers give back a stand-in for what was not there
    fail: func(p: Parser, message: string) { fail-at(p, here(p), message); }

    // an error at what a span covers (a statement's target, once past it)
    fail-at: func(p: Parser, at: Span, message: string) {
        if p.recovering || p.quiet { return; }
        p.recovering = true;
        diagnostics.report(p.context, diagnostics.error(at, message, ""));
    }

    // a missing token is reported just past the last one taken, where it belongs
    fail-missing: func(p: Parser, message: string) {
        if p.pos == 0 {
            fail(p, message);
            return;
        }
        let last = tok(p, -1).span;
        let at: Span = {
            source: last.source,
            line: last.end-line,
            col: last.end-col,
            end-line: last.end-line,
            end-col: last.end-col + 1,
        };
        fail-at(p, at, message);
    }

    // past an error, the statement or declaration it is in passed over (from its first token,
    // start): to its ; (taken), past a { … } that closes it (and a ; after), or to the } of what
    // holds it (left for its holder). Its brackets are matched as they open and close: one left
    // open (a ( with no ) before the }) is given up, so a } still closes what it belongs to, and a
    // ; inside only ( and [ ends it all the same. The parser goes on from there, no longer
    // recovering
    pass-over: func(p: Parser, start: s64) {
        p.recovering = false;
        let open: list<string> = [];
        for index in start..p.toks.len() {
            let t = p.toks[index];
            if t.kind == TokenKind.eof {
                p.pos = index;
                return;
            }
            let bracket = t.kind == TokenKind.op;
            if bracket && (t.text == "\{" || t.text == "(" || t.text == "[") { open.push(t.text); }
            else if bracket && (t.text == "\}" || t.text == ")" || t.text == "]") {
                let opener = if t.text == "\}" { "\{" } else if t.text == ")" { "(" } else { "[" };
                // the brackets it closes past, left open, given up
                loop {
                    if open.len() == 0 || open[open.len() - 1] == opener { break; }
                    open.pop();
                }
                if open.len() == 0 {
                    // the holder's: left for it
                    if index >= p.pos { p.pos = index; }
                    return;
                }
                open.pop();
                if open.len() == 0 && t.text == "\}" && index + 1 >= p.pos {
                    let next = p.toks[index + 1].text;
                    // if … { } else { }: the else is the statement's too; a ; after it, taken
                    if next == ";" {
                        p.pos = index + 2;
                        return;
                    }
                    if next != "else" {
                        p.pos = index + 1;
                        return;
                    }
                }
            } else if bracket && t.text == ";" && !contains(open, "\{") && index >= p.pos {
                p.pos = index + 1;
                return;
            }
        }
    }

    next: func(p: Parser) -> string {
        let v = text(p);
        advance(p);
        v
    }

    // v taken; where the next token is another, an error (and it is left)
    expect: func(p: Parser, v: string) {
        if !at(p, v) {
            fail-missing(p, "expected '{v}', found {found(p)}");
            return;
        }
        advance(p);
    }

    name: func(p: Parser) -> string {
        if !is-kind(p, 0, TokenKind.id) { fail(p, "expected a name, found {found(p)}"); }
        next(p)
    }

    // a number type's name (int is s32 and float f32; they are written as those)
    num-name: func(n: string) -> string {
        if n == "int" { return "s32"; }
        if n == "float" { return "f32"; }
        for k in ["s8", "s16", "s32", "s64", "u8", "u16", "u32", "u64", "f32", "f64",] {
            if n == k { return n; }
        }
        ""
    }

    // a type: a name (module.Name for a module's), list<T>, option<T>, map<string, T>, result<T, E> (_ or
    // left out: no payload), tuple<T, ...>
    // a fixed-length list's length: a decimal from 1
    fixed-len: func(p: Parser, s: string) -> s64 {
        let n = 0;
        for k in 0..s.len() {
            let c = s.byte-at(k);
            if !is-digit(c)
                || n > 100000000 { fail(p, "a list's length is a decimal integer: {s}"); }
            n = n * 10 + (c - 48);
        }
        if n < 1 { fail(p, "a fixed-length list holds at least one item"); }
        n
    }

    // a type: one, or a union of several (A | B)
    parse-type: func(p: Parser) -> Type {
        let first = readonly-member(p);
        if !at(p, "|") { return first; }
        let members = [first,];
        for step in p.pos..p.toks.len() {
            if !at(p, "|") { return Type.union-type(members); }
            advance(p);
            members.push(readonly-member(p));
        }
        Type.union-type(members)
    }

    // wait for x in s { body }: the stream once, then a turn for each item, until it is closed:
    // { let ~s = s; for ~t in 0..<s64 max> { match wait ~s.read() { some(let x) => { body }
    // none => { break; } } } }
    wait-for: func(p: Parser) -> Stmt {
        let start = here(p);
        advance(p);
        advance(p);
        let v = name(p);
        let vspan = here(p);
        expect(p, "in");
        let source = expr(p);
        let body = block(p);
        let sp = span-from(p, start);
        let s-name = "~stream";
        let read = node(ExprKind.method({
            target: node(ExprKind.name(intern(s-name)), sp),
            name: "read",
            args: [],
            type-args: [],
        }), sp,);
        let waited = node(ExprKind.wait-expr({ mode: "one", values: [read,], fields: [], }), sp);
        let item = Pattern.case({ name: "some", sub: name-pattern(v, true, vspan), span: sp, });
        let done: Block = { stmts: [Stmt.break-stmt,], spans: [sp,], };
        let arms: list<Arm> = [
            { pattern: item, guard: none, body: node(ExprKind.block(body), sp), span: sp, },
            {
                pattern: name-pattern("none", false, sp),
                guard: none,
                body: node(ExprKind.block(done), sp),
                span: sp,
            },
        ];
        let each = node(ExprKind.match-expr({ value: waited, arms: arms, }), sp);
        let turn: Block = {
            stmts: [Stmt.expr-stmt({ value: each, is-value: false, }),],
            spans: [sp,],
        };
        let turns = Stmt.loop-stmt({ body: turn, unit: { env: false, }, });
        let bound = Stmt.let-stmt({ name: s-name, ty: none, value: source, mark: new-mark(), });
        let all: Block = { stmts: [bound, turns,], spans: [sp, sp,], };
        Stmt.expr-stmt({ value: node(ExprKind.block(all), sp), is-value: false, })
    }

    // a type, and & readonly after it (tighter than |)
    readonly-member: func(p: Parser) -> Type {
        let t = type-member(p);
        if at(p, "&") && at-off(p, "readonly", 1) {
            advance(p);
            advance(p);
            return Type.readonly-type(t);
        }
        t
    }

    // lo..=hi as a type: its keys (hi the last value: one before an exclusive range's end)
    range-type: func(p: Parser, lo: Expr, hi: Expr, inclusive: bool) -> Type {
        let base = match lo.kind {
            char-lit(x) => Type.char-type,
            int-lit(x) => Type.num("s32"),
            unary(u) => Type.num("s32"),
            _ => {
                fail(p, "a range type is of integers or chars");
                Type.unit-type
            }
        };
        let lk = semtype.literal-key(lo);
        let hk = semtype.literal-key(hi);
        let last = if inclusive { hk } else { key-before(hk) };
        let text = "{range-end-text(lo)}{if inclusive { "..=" } else { ".." }}{range-end-text(hi)}";
        Type.range-type({ base: base, lo: lk, hi: last, text: text, })
    }

    range-end-text: func(e: Expr) -> string {
        match e.kind {
            char-lit(x) => "'{from-byte(x)}'",
            _ => semtype.literal-key(e),
        }
    }

    // the decimal key one less (an exclusive range's last value)
    key-before: func(k: string) -> string { semtype.decimal-before(k) }

    // a type a union is made of: a literal (its one value: "get", 3, -1, 'a', true), (), or a type
    // named
    type-member: func(p: Parser) -> Type {
        if is-kind(p, 0, TokenKind.int) || is-kind(p, 0, TokenKind.float)
            || is-kind(p, 0, TokenKind.str) || is-kind(p, 0, TokenKind.char) || at(p, "-")
            && (is-kind(p, 1, TokenKind.int) || is-kind(p, 1, TokenKind.float)) || at(p, "true")
            || at(p, "false") {
            let e = unary(p);
            // lo..=hi (lo..hi): a range of integers or chars
            if at(p, "..=") || at(p, "..") {
                let inclusive = at(p, "..=");
                advance(p);
                let hi = unary(p);
                return range-type(p, e, hi, inclusive);
            }
            let base = match e.kind {
                int-lit(x) => Type.num("s32"),
                float-lit(x) => Type.num("f32"),
                char-lit(x) => Type.char-type,
                str-lit(x) => Type.string-type,
                bool-lit(x) => Type.bool-type,
                unary(u) => match u.value.kind {
                    float-lit(x) => Type.num("f32"),
                    _ => Type.num("s32"),
                },
                _ => {
                    fail(p, "a literal type is a number, a string, a char or a bool");
                    Type.unit-type
                }
            };
            let key = semtype.literal-key(e);
            let text = match e.kind {
                str-lit(x) => "\"{x}\"",
                char-lit(x) => "'{from-byte(x)}'",
                _ => key,
            };
            return Type.singleton({ base: base, key: key, text: text, });
        }
        // (): unit, no value's type
        if at(p, "(") {
            advance(p);
            expect(p, ")");
            return Type.unit-type;
        }
        // { x: s32, y: string }: an anonymous record (the checker puts its fields in order)
        if at(p, "\{") {
            advance(p);
            let fields: list<string> = [];
            let types: list<Type> = [];
            for step in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    return Type.anon-record({ fields: fields, types: types, });
                }
                fields.push(name(p));
                expect(p, ":");
                types.push(parse-type(p));
                if !at(p, "\}") { expect(p, ","); }
            }
        }
        let n = name(p);
        if at(p, ".") {
            advance(p);
            n = n + "." + name(p);
        }
        // func(T, U) -> R
        if n == "func" && at(p, "(") {
            advance(p);
            let params: list<Type> = [];
            for step in p.pos..p.toks.len() {
                if at(p, ")") { break; }
                params.push(parse-type(p));
                if !at(p, ")") { expect(p, ","); }
            }
            expect(p, ")");
            let result = Type.unit-type;
            if at(p, "->") {
                advance(p);
                result = parse-type(p);
            }
            return Type.func-type({ params: params, result: result, });
        }
        // map<K, V>, set<T>: a map<T, ()>
        if n == "map" || n == "set" {
            expect(p, "<");
            let first = parse-type(p);
            if n == "set" {
                expect(p, ">");
                return Type.map-type({ key: first, value: Type.unit-type, });
            }
            expect(p, ",");
            let value = parse-type(p);
            expect(p, ">");
            return Type.map-type({ key: first, value: value, });
        }
        if n == "list" || n == "option" || n == "future" || n == "seq" || n == "stream" || n == "writer" {
            expect(p, "<");
            let inner = parse-type(p);
            if at(p, ",") { advance(p); }
            // list<T, N> or list<T, ?>: fixed-length
            if n == "list" && (at(p, "?") || is-kind(p, 0, TokenKind.int)) {
                let len = if at(p, "?") { -1 } else { fixed-len(p, text(p)) };
                advance(p);
                expect(p, ">");
                return Type.fixed-list({ item: inner, len: len, });
            }
            expect(p, ">");
            if n == "list" { return Type.list-type(inner); }
            if n == "future" { return Type.future-type(inner); }
            if n == "seq" { return Type.seq-type(inner); }
            if n == "stream" || n == "writer" {
                return Type.stream-type({ item: inner, writer: n == "writer", });
            }
            return Type.option-type(inner);
        }
        if n == "tuple" {
            expect(p, "<");
            let items: list<Type> = [];
            for step in p.pos..p.toks.len() {
                if at(p, ">") {
                    advance(p);
                    if items.len() == 0 { fail(p, "a tuple needs a type (no value's type is ())"); }
                    return Type.tuple-type(items);
                }
                items.push(parse-type(p));
                if !at(p, ">") { expect(p, ","); }
            }
        }
        if n == "result" {
            let ok = Type.unit-type;
            let err = Type.unit-type;
            if at(p, "<") {
                advance(p);
                ok = result-part(p);
                if at(p, ",") {
                    advance(p);
                    if !at(p, ">") {
                        err = result-part(p);
                        if at(p, ",") { advance(p); }
                    }
                }
                expect(p, ">");
            }
            return Type.result-type({ ok: ok, err: err, });
        }
        if n == "_" { fail(p, "_ is only a result's absent payload"); }
        let num = num-name(n);
        if num != "" { return Type.num(num); }
        if n == "bool" { return Type.bool-type; }
        if n == "char" { return Type.char-type; }
        if n == "string" { return Type.string-type; }
        if n == "buffer" { return Type.buffer-type; }
        if n == "never" { return Type.never-type; }
        Type.named(intern(n))
    }

    // a result's payload type, or _ for none
    result-part: func(p: Parser) -> Type {
        if at(p, "_") {
            advance(p);
            return Type.unit-type;
        }
        parse-type(p)
    }

    // a pattern as patterns whose alternatives bind nothing: each alternative that may bind taken
    // out to the top (some(a(x) | b(x)) is some(a(x)) and some(b(x))), one pattern for each
    alternatives: func(pat: Pattern) -> list<Pattern> {
        match pat {
            alt(ps) => {
                if !may-bind(pat) { return [pat,]; }
                let out: list<Pattern> = [];
                for q in ps {
                    for e in alternatives(q) { out.push(e); }
                }
                out
            }
            case(pc) => {
                let out: list<Pattern> = [];
                for e in alternatives(pc.sub) { out.push(Pattern.case({ name: pc.name, sub: e, span: pc.span, })); }
                out
            }
            typed(x) => {
                let out: list<Pattern> = [];
                for e in alternatives(x.sub) { out.push(Pattern.typed({ ty: x.ty, sub: e, test: x.test, })); }
                out
            }
            member(x) => {
                let out: list<Pattern> = [];
                for e in alternatives(x.sub) { out.push(Pattern.member({ ty: x.ty, sub: e, })); }
                out
            }
            tuple(ps) => {
                let out: list<Pattern> = [];
                for each in product(ps) { out.push(Pattern.tuple(each)); }
                out
            }
            record(pr) => {
                let out: list<Pattern> = [];
                for each in product(pr.patterns) {
                    out.push(Pattern.record({
                        fields: pr.fields,
                        patterns: each,
                        rest: pr.rest,
                        rest-mark: pr.rest-mark,
                        span: pr.span,
                    }));
                }
                out
            }
            _ => [pat,],
        }
    }

    // each choice of one alternative of each pattern, in order
    product: func(ps: list<Pattern>) -> list<list<Pattern>> {
        let out: list<list<Pattern>> = [[],];
        for q in ps {
            let next: list<list<Pattern>> = [];
            for prefix in out {
                for e in alternatives(q) {
                    let one: list<Pattern> = [];
                    for x in prefix { one.push(x); }
                    one.push(e);
                    next.push(one);
                }
            }
            out = next;
        }
        out
    }

    // whether a pattern may bind a name (a name where one binds, ...rest, let n: T)
    may-bind: func(pat: Pattern) -> bool {
        match pat {
            name(pn) => pn.binds,
            case(pc) => may-bind(pc.sub),
            record(pr) => {
                if pr.rest != "" { return true; }
                for q in pr.patterns {
                    if may-bind(q) { return true; }
                }
                false
            }
            tuple(ps) => {
                for q in ps {
                    if may-bind(q) { return true; }
                }
                false
            }
            alt(ps) => {
                for q in ps {
                    if may-bind(q) { return true; }
                }
                false
            }
            typed(x) => true,
            member(x) => may-bind(x.sub),
            _ => false,
        }
    }

    // a pattern: alternatives (p | q), each a single one; binds: whether a bare name binds here
    pattern: func(p: Parser, binds: bool) -> Pattern {
        let first = single-pattern(p, binds);
        if !at(p, "|") { return first; }
        let alts = [first,];
        for step in p.pos..p.toks.len() {
            if !at(p, "|") { return Pattern.alt(alts); }
            advance(p);
            alts.push(single-pattern(p, binds));
        }
        Pattern.alt(alts)
    }

    // _; let and a pattern (its names binding); a literal (a number, - before one, a string, a
    // char); { field: pattern, field } (a field alone: its name's pattern); (a, b); name(payload's
    // pattern) (its names binding); a name
    single-pattern: func(p: Parser, binds: bool) -> Pattern {
        let start = here(p);
        if at(p, "_") {
            advance(p);
            return Pattern.wild;
        }
        if at(p, "let") {
            advance(p);
            // let n: T, a value of type T (one type: a | after it is the pattern's; a union is
            // named by an alias)
            if is-kind(p, 0, TokenKind.id) && at-off(p, ":", 1) {
                let n = name(p);
                advance(p);
                let ty = type-member(p);
                return Pattern.typed({ ty: ty, sub: name-pattern(n, true, start), test: none, });
            }
            return single-pattern(p, true);
        }
        if is-kind(p, 0, TokenKind.int) || is-kind(p, 0, TokenKind.float)
            || is-kind(p, 0, TokenKind.str) || is-kind(p, 0, TokenKind.char) || at(p, "-") && (
            is-kind(p, 1, TokenKind.int) || is-kind(p, 1, TokenKind.float)
        ) {
            let lo = unary(p);
            // lo..=hi (lo..hi): a range
            if at(p, "..=") || at(p, "..") {
                let inclusive = at(p, "..=");
                advance(p);
                let hi = unary(p);
                return Pattern.range({
                    lo: lo,
                    hi: hi,
                    inclusive: inclusive,
                    span: span-from(p, start),
                });
            }
            return Pattern.literal(lo);
        }
        if at(p, "\{") {
            advance(p);
            let fields: list<string> = [];
            let patterns: list<Pattern> = [];
            let rest = "";
            for step in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    return Pattern.record({
                        fields: fields,
                        patterns: patterns,
                        rest: rest,
                        rest-mark: new-mark(),
                        span: span-from(p, start),
                    });
                }
                // ...rest: the fields not named, last
                if at(p, "...") {
                    advance(p);
                    rest = name(p);
                    if !at(p, "\}") { expect(p, ","); }
                    if !at(p, "\}") { fail(p, "...{rest} is a record pattern's last"); }
                    continue;
                }
                let fstart = here(p);
                let f = name(p);
                fields.push(f);
                if at(p, ":") {
                    advance(p);
                    patterns.push(pattern(p, binds));
                } else {
                    patterns.push(name-pattern(f, binds, fstart));
                }
                if !at(p, "\}") { expect(p, ","); }
            }
        }
        if at(p, "(") {
            advance(p);
            if at(p, ")") {
                advance(p);
                return Pattern.tuple([]);
            }
            let first = pattern(p, binds);
            if at(p, ")") {
                advance(p);
                return first;
            }
            let items = [first,];
            for step in p.pos..p.toks.len() {
                if at(p, ")") {
                    advance(p);
                    return Pattern.tuple(items);
                }
                expect(p, ",");
                if at(p, ")") {
                    advance(p);
                    return Pattern.tuple(items);
                }
                items.push(pattern(p, binds));
            }
        }
        let n = name(p);
        if at(p, "(") {
            advance(p);
            let sub = pattern(p, true);
            expect(p, ")");
            return Pattern.case({ name: n, sub: sub, span: span-from(p, start), });
        }
        name-pattern(n, binds, start)
    }

    name-pattern: func(n: string, binds: bool, span: Span) -> Pattern {
        Pattern.name({
            name: n,
            binds: binds,
            kind: "",
            key: "",
            value: none,
            mark: new-mark(),
            span: span,
        })
    }

    // a binding's mark (not captured, until the checker finds it is)
    new-mark: func() -> Mark { { captured: false, unit: { env: false, }, ty: Type.unit-type, } }

    new-marks: func(n: s64) -> list<Mark> {
        let out: list<Mark> = [];
        for k in 0..n { out.push(new-mark()); }
        out
    }

    // whether a { opens a closure literal: its params (names, each with a type or not, between
    // commas) and then -> (a record literal's name: value never reaches one)
    closure-ahead: func(p: Parser) -> bool {
        if at-off(p, "->", 1) { return true; }
        let k = 1;
        for step in 0..p.toks.len() {
            if !is-kind(p, k, TokenKind.id) { return false; }
            k += 1;
            if at-off(p, ":", k) {
                // a type: up to a , or -> outside its brackets (an anonymous record's { } among them;
                // a } that closes the literal's own { ends it: no closure, whatever came before,
                // a shift's << among it)
                k += 1;
                let depth = 0;
                let braces = 0;
                for skip in 0..p.toks.len() {
                    if depth == 0 && braces == 0 && (at-off(p, ",", k) || at-off(p, "->", k)) { break; }
                    if at-off(p, "\{", k) { braces += 1; }
                    if at-off(p, "\}", k) {
                        if braces == 0 { return false; }
                        braces -= 1;
                    }
                    if at-off(p, "(", k) || at-off(p, "<", k) || at-off(p, "[", k) { depth += 1; }
                    if at-off(p, ")", k) || at-off(p, ">", k) || at-off(p, "]", k) { depth -= 1; }
                    if at-off(p, ";", k) || at-off(p, "=", k) || depth < 0 || is-kind(p, k, TokenKind.eof) {
                        return false;
                    }
                    k += 1;
                }
            }
            if at-off(p, "->", k) { return true; }
            if !at-off(p, ",", k) { return false; }
            k += 1;
        }
        false
    }

    // { params -> body }: a closure literal (its body a block's, without its {)
    closure: func(p: Parser) -> Closure {
        expect(p, "\{");
        let params: list<string> = [];
        let types: list<option<Type>> = [];
        for step in p.pos..p.toks.len() {
            if at(p, "->") { break; }
            params.push(name(p));
            if at(p, ":") {
                advance(p);
                types.push(some(parse-type(p)));
            } else {
                types.push(none);
            }
            if !at(p, "->") { expect(p, ","); }
        }
        expect(p, "->");
        {
            params: params,
            types: types,
            body: block-rest(p),
            marks: new-marks(params.len()),
            unit: { env: false, },
        }
    }

    // an expression that is all of what is parsed (an interpolation's)
    whole-expr: func(p: Parser) -> Expr {
        let e = expr(p);
        if !is-kind(p, 0, TokenKind.eof) {
            fail(p, "unexpected {found(p)} after an interpolation's expression");
        }
        e
    }

    block: func(p: Parser) -> Block {
        expect(p, "\{");
        block-rest(p)
    }

    // a block's statements, after its {, and its }
    block-rest: func(p: Parser) -> Block {
        let stmts = [];
        let spans = [];
        for step in p.pos..p.toks.len() {
            if at(p, "\}") {
                advance(p);
                return { stmts: stmts, spans: spans, };
            }
            let start = here(p);
            let first = p.pos;
            stmts.push(statement(p));
            spans.push(span-from(p, start));
            if p.recovering { pass-over(p, first); }
        }
        { stmts: stmts, spans: spans, }
    }

    statement: func(p: Parser) -> Stmt {
        if at(p, "let") {
            advance(p);
            // a record's, a tuple's or _: a pattern, its names binding
            let destructures = at(p, "\{") || at(p, "(") || at(p, "_");
            let pat = if destructures { pattern(p, true) } else { Pattern.wild };
            let n = if destructures { "" } else { name(p) };
            let ty = none;
            if at(p, ":") {
                advance(p);
                ty = some(parse-type(p));
            }
            expect(p, "=");
            let value = expr(p);
            expect(p, ";");
            if destructures { return Stmt.let-pattern({ pattern: pat, ty: ty, value: value, }); }
            return Stmt.let-stmt({ name: n, ty: ty, value: value, mark: new-mark(), });
        }
        if at(p, "return") {
            advance(p);
            let value = node(ExprKind.unit, here(p));
            if !at(p, ";") { value = expr(p); }
            expect(p, ";");
            return Stmt.return-stmt(value);
        }
        // wait for x in s { … }: each item of a stream, waited for in turn
        if at(p, "wait") && at-off(p, "for", 1) {
            return wait-for(p);
        }
        // loop { … } (loop is a name otherwise)
        if at(p, "loop") && at-off(p, "\{", 1) {
            advance(p);
            return Stmt.loop-stmt({ body: block(p), unit: { env: false, }, });
        }
        if at(p, "for") {
            advance(p);
            let v = name(p);
            expect(p, "in");
            let start = expr(p);
            let stop = none;
            let inclusive = false;
            if at(p, "..") || at(p, "..=") {
                inclusive = next(p) == "..=";
                stop = some(expr(p));
            }
            return Stmt.for-stmt({
                name: v,
                start: start,
                stop: stop,
                inclusive: inclusive,
                body: block(p),
                mark: new-mark(),
                unit: { env: false, },
            });
        }
        if at(p, "break") || at(p, "continue") {
            let word = next(p);
            expect(p, ";");
            return if word == "break" { Stmt.break-stmt } else { Stmt.continue-stmt };
        }
        // an if, a match or a block that starts a statement is the statement (as Rust's): what
        // follows its } is the next one, not an operator's other side (if c { … } -1 is two); in
        // parens it is an operand like any ((if c { a } else { b }) - 1)
        let e = if at(p, "if") || at(p, "match") || at(p, "\{") { postfix(p) } else { expr(p) };
        for op in ["=", "+=", "-=", "*=", "/=", "%=",] {
            if at(p, op) {
                advance(p);
                let value = expr(p);
                expect(p, ";");
                match e.kind {
                    name(n) => { return Stmt.assign({ name: n, op: op, value: value, }); }
                    field(f) => {
                        return Stmt.assign-field({
                            target: f.target,
                            name: f.name,
                            op: op,
                            value: value,
                        });
                    }
                    // xs[i] = v: xs.set(i, v)
                    method(m) => {
                        if m.name != "at" || m.args.len() != 1 {
                            fail-at(p, e.span, "only a variable, a field or a list's item can be assigned");
                        }
                        if op != "=" {
                            fail-at(
                                p,
                                e.span,
                                "xs[i] {op} v would read xs and i twice: write xs[i] = xs[i] {from-byte(op.byte-at(0))} v",
                            );
                        }
                        let set = node(ExprKind.method({
                            target: m.target,
                            name: "set",
                            args: [m.args[0], value,],
                            type-args: [],
                        }), e.span,);
                        return Stmt.expr-stmt({ value: set, is-value: false, });
                    }
                    _ => fail-at(p, e.span, "only a variable, a field or a list's item can be assigned"),
                }
            }
        }
        if at(p, ";") {
            advance(p);
            return Stmt.expr-stmt({ value: e, is-value: false, });
        }
        // an if, a match or a block needs no `;`: it is the block's value only when it ends the
        // block
        if ends-at-brace(e) { return Stmt.expr-stmt({ value: e, is-value: at(p, "\}"), }); }
        if !at(p, "\}") { fail(p, "expected ';' after an expression, found {found(p)}"); }
        Stmt.expr-stmt({ value: e, is-value: true, })
    }

    expr: func(p: Parser) -> Expr { binary(p, 0) }

    // yel's precedence, lowest first
    level-ops: func(level: s64) -> list<string> {
        if level == 0 { ["||",] }
        else if level == 1 { ["&&",] }
        else if level == 2 { ["==", "!=",] }
        else if level == 3 { ["<", "<=", ">", ">=",] }
        else if level == 4 { ["|",] }
        else if level == 5 { ["^",] }
        else if level == 6 { ["&",] }
        else if level == 7 { ["<<", ">>",] }
        else if level == 8 { ["+", "-",] }
        else { ["*", "/", "%",] }
    }

    // the operator of ops at p, or "": << and >> are two adjacent < or > tokens (and then no
    // comparison)
    op-at: func(p: Parser, ops: list<string>) -> string {
        if !is-kind(p, 0, TokenKind.op) { return ""; }
        let t = text(p);
        let doubled = (t == "<" || t == ">") && at-off(p, t, 1) && adjacent(p);
        for op in ops {
            if doubled && op == t + t { return op; }
            if !doubled && op == t { return op; }
        }
        ""
    }

    // whether the next two tokens touch
    adjacent: func(p: Parser) -> bool {
        let a = tok(p, 0).span;
        let b = tok(p, 1).span;
        a.end-line == b.line && a.end-col == b.col
    }

    binary: func(p: Parser, level: s64) -> Expr {
        if level == 10 { return cast(p); }
        let ops = level-ops(level);
        let left = binary(p, level + 1);
        // x is T, as a comparison is (its type may be a union: x is "a" | "b")
        if level == 3 && at(p, "is") {
            advance(p);
            let ty = parse-type(p);
            return node(
                ExprKind.is-test({ value: left, ty: ty, pattern: none, }),
                span-from(p, left.span),
            );
        }
        for step in p.pos..p.toks.len() {
            let op = op-at(p, ops);
            if op == "" { return left; }
            advance(p);
            if op == "<<" || op == ">>" { advance(p); }
            let right = binary(p, level + 1);
            left = node(
                ExprKind.binary({ op: op, left: left, right: right, }),
                span-from(p, left.span),
            );
        }
        left
    }

    // x as T: tighter than * and +, looser than - and ! (-x as s64 is (-x) as s64), as Rust's
    cast: func(p: Parser) -> Expr {
        let e = unary(p);
        for step in p.pos..p.toks.len() {
            if !at(p, "as") { return e; }
            advance(p);
            // x as? T: an option, of the value where it is a T
            if at(p, "?") {
                advance(p);
                let ty = type-member(p);
                e = node(
                    ExprKind.try-as({ value: e, ty: ty, pattern: none, }),
                    span-from(p, e.span),
                );
            } else {
                // one type (a | after it is an expression's: x as u8 | y)
                let ty = type-member(p);
                e = node(ExprKind.cast({ value: e, ty: ty, }), span-from(p, e.span));
            }
        }
        e
    }

    unary: func(p: Parser) -> Expr {
        // yield v: a generator's next value
        if at(p, "yield") {
            let start = here(p);
            advance(p);
            let value = expr(p);
            return node(ExprKind.yield-expr(value), span-from(p, start));
        }
        // start f(x): an async call begun (a name after it: start alone is a variable's)
        if at(p, "start") && is-kind(p, 1, TokenKind.id) {
            let start = here(p);
            advance(p);
            let call = postfix(p);
            return node(ExprKind.start-expr(call), span-from(p, start));
        }
        // wait f(x), wait a | b, wait { a: x, b: y } (a name or { name: after it: wait alone is a
        // variable's)
        let waits = is-kind(p, 1, TokenKind.id) || at-off(p, "\{", 1) && is-kind(p, 2, TokenKind.id)
            && at-off(p, ":", 3);
        if at(p, "wait") && waits {
            let start = here(p);
            advance(p);
            if at(p, "\{") {
                advance(p);
                let fields: list<string> = [];
                let values: list<Expr> = [];
                for step in p.pos..p.toks.len() {
                    if at(p, "\}") {
                        advance(p);
                        return node(
                            ExprKind.wait-expr({ mode: "all", values: values, fields: fields, }),
                            span-from(p, start),
                        );
                    }
                    fields.push(name(p));
                    expect(p, ":");
                    values.push(expr(p));
                    if !at(p, "\}") { expect(p, ","); }
                }
            }
            let values = [postfix(p),];
            for step in p.pos..p.toks.len() {
                if !at(p, "|") { break; }
                advance(p);
                values.push(postfix(p));
            }
            let mode: wait-mode = if values.len() > 1 { "any" } else { "one" };
            return node(
                ExprKind.wait-expr({ mode: mode, values: values, fields: [], }),
                span-from(p, start),
            );
        }
        if at(p, "-") || at(p, "!") {
            let start = here(p);
            let op = next(p);
            let value = unary(p);
            return node(ExprKind.unary({ op: op, value: value, }), span-from(p, start));
        }
        postfix(p)
    }

    call-args: func(p: Parser) -> list<Expr> {
        expect(p, "(");
        let out = [];
        for step in p.pos..p.toks.len() {
            if at(p, ")") {
                advance(p);
                return out;
            }
            out.push(expr(p));
            if !at(p, ")") { expect(p, ","); }
        }
        out
    }

    postfix: func(p: Parser) -> Expr {
        // an if, a match or a block ends at its brace ({ … }.f is not read as one); in parens it is
        // an operand like any ((match x { … }).len())
        let parenthesized = at(p, "(");
        let e = primary(p);
        if ends-at-brace(e) && !parenthesized { return e; }
        for step in p.pos..p.toks.len() {
            if at(p, ".") {
                // x.f(a): a call with x first (xs.len() is len(xs)), or Type.case(payload); x.f: a
                // field, or Type.case
                advance(p);
                // t.0: a tuple's field
                if is-kind(p, 0, TokenKind.int) {
                    let index = next(p);
                    e = node(ExprKind.field({ target: e, name: index, }), span-from(p, e.span));
                } else {
                    let f = name(p);
                    if at(p, "(") {
                        let args = call-args(p);
                        e = node(
                            ExprKind.method({ target: e, name: f, args: args, type-args: [], }),
                            span-from(p, e.span),
                        );
                    } else {
                        e = node(ExprKind.field({ target: e, name: f, }), span-from(p, e.span));
                    }
                }
            } else if at(p, "(") && is-name(e) {
                let args = call-args(p);
                e = node(
                    ExprKind.call({ name: expr-name(e), args: args, type-args: [], }),
                    span-from(p, e.span),
                );
            } else if at(p, "(") {
                // a call of any other expression's value: xs[i](), make()(), (x.f)(a)
                let args = call-args(p);
                e = node(ExprKind.apply({ callee: e, args: args, }), span-from(p, e.span));
            } else if at(p, "[") {
                // xs[i] is xs.at(i): a method, so no local named at hides it
                advance(p);
                let index = expr(p);
                expect(p, "]");
                e = node(
                    ExprKind.method({ target: e, name: "at", args: [index,], type-args: [], }),
                    span-from(p, e.span),
                );
            } else {
                return e;
            }
        }
        e
    }

    primary: func(p: Parser) -> Expr {
        let start = here(p);
        if is-kind(p, 0, TokenKind.int) { return node(ExprKind.int-lit(next(p)), start); }
        if is-kind(p, 0, TokenKind.float) { return node(ExprKind.float-lit(next(p)), start); }
        if is-kind(p, 0, TokenKind.char) {
            return node(ExprKind.char-lit(char-code(p, next(p), start)), start);
        }
        if is-kind(p, 0, TokenKind.str) {
            let t = tok(p, 0);
            advance(p);
            // a multiline string's text starts on the line after its """, each line past its indent
            let origin: Origin = if t.indent < 0 {
                { line: start.line, col: start.col + 1, indent: 0, }
            } else {
                { line: start.line + 1, col: t.indent + 1, indent: t.indent, }
            };
            return interpolation(p, t.text, start, origin, t.template);
        }
        if at(p, "true") || at(p, "false") {
            return node(ExprKind.bool-lit(next(p) == "true"), start);
        }
        // (e), or a tuple: (a, b), and (a,) of one
        if at(p, "(") {
            advance(p);
            // (): unit
            if at(p, ")") {
                advance(p);
                return node(ExprKind.unit, start);
            }
            let e = expr(p);
            if at(p, ")") {
                advance(p);
                return e;
            }
            expect(p, ",");
            let items = [e,];
            for step in p.pos..p.toks.len() {
                if at(p, ")") {
                    advance(p);
                    return node(ExprKind.tuple-lit(items), span-from(p, start));
                }
                items.push(expr(p));
                if !at(p, ")") { expect(p, ","); }
            }
        }
        if at(p, "[") {
            advance(p);
            let items = [];
            for step in p.pos..p.toks.len() {
                if at(p, "]") {
                    advance(p);
                    return node(ExprKind.list-lit(items), span-from(p, start));
                }
                items.push(expr(p));
                if !at(p, "]") { expect(p, ","); }
            }
        }
        if at(p, "if") {
            advance(p);
            let cond = expr(p);
            let then = block(p);
            let otherwise: option<Block> = none;
            if at(p, "else") {
                advance(p);
                if at(p, "if") {
                    let chained = primary(p);
                    otherwise = some({
                        stmts: [Stmt.expr-stmt({ value: chained, is-value: true, }),],
                        spans: [chained.span,],
                    });
                } else {
                    otherwise = some(block(p));
                }
            }
            return node(
                ExprKind.if-else({ cond: cond, then: then, otherwise: otherwise, }),
                span-from(p, start),
            );
        }
        // a closure literal: { params -> body }
        if at(p, "\{") && closure-ahead(p) {
            return node(ExprKind.closure(closure(p)), span-from(p, start));
        }
        // a record literal: { name: value, ... } (any other `{` is a block)
        if at(p, "\{") && is-kind(p, 1, TokenKind.id) && at-off(p, ":", 2) {
            advance(p);
            let fields = [];
            for step in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    return node(ExprKind.record-lit(fields), span-from(p, start));
                }
                let f = name(p);
                expect(p, ":");
                fields.push({ name: f, value: expr(p), });
                if !at(p, "\}") { expect(p, ","); }
            }
        }
        if at(p, "match") {
            advance(p);
            let value = expr(p);
            expect(p, "\{");
            let arms = [];
            for step in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    return node(
                        ExprKind.match-expr({ value: value, arms: arms, }),
                        span-from(p, start),
                    );
                }
                // an arm whose alternatives bind (for-stmt(x) | loop-stmt(x) => …): an arm for each,
                // the same guard and body (parsed again for each: their own nodes), each checked
                // with its own bindings' types
                let arm-pos = p.pos;
                let count = alternatives(pattern(p, false)).len();
                for i in 0..count {
                    p.pos = arm-pos;
                    let arm-start = here(p);
                    let pattern = alternatives(pattern(p, false))[i];
                    let guard: option<Expr> = none;
                    if at(p, "if") {
                        advance(p);
                        guard = some(expr(p));
                    }
                    expect(p, "=>");
                    let body = node(ExprKind.unit, here(p));
                    // a block; a { that opens a record literal ({ name: value, … }: no block starts
                    // so) or a closure is an expression's
                    let literal = is-kind(p, 1, TokenKind.id) && at-off(p, ":", 2) || closure-ahead(p);
                    if at(p, "\{") && !literal {
                        let b = block(p);
                        body = node(ExprKind.block(b), span-from(p, body.span));
                    } else {
                        body = expr(p);
                    }
                    if at(p, ",") { advance(p); }
                    arms.push({
                        pattern: pattern,
                        guard: guard,
                        body: body,
                        span: span-from(p, arm-start),
                    });
                }
            }
        }
        if at(p, "\{") {
            let b = block(p);
            return node(ExprKind.block(b), span-from(p, start));
        }
        if is-kind(p, 0, TokenKind.id) { return node(ExprKind.name(intern(next(p))), start); }
        fail(p, "unexpected {found(p)}");
        node(ExprKind.unit, start)
    }

    // the line and column of raw[i], raw being a literal's text from o
    place: func(raw: string, o: Origin, i: s64) -> Span {
        let nl = last-newline(raw, 0, i);
        let line = o.line + newlines(raw, 0, i);
        let col = if nl < 0 { o.col + i } else { i - nl + o.indent };
        { source: -1, line: line, col: col, end-line: line, end-col: col, }
    }

    interpolation: func(p: Parser, raw: string, at: Span, o: Origin, template: bool) -> Expr {
        let parts = [];
        let chars = [];
        let n = raw.len();
        let i = 0;
        for step in 0..n + 1 {
            if i >= n {
                if chars.len() > 0 || parts.len() == 0 {
                    parts.push(node(ExprKind.str-lit(chars.join("")), at));
                }
                if parts.len() == 1 && is-str-lit(parts[0]) { return parts[0]; }
                return node(ExprKind.interp(parts), at);
            }
            let c = raw.byte-at(i);
            if c == 92 {
                let esc = escape(p, raw, i, o);
                chars.push(esc.text);
                i += esc.width;
            } else if c == 123 && (!template || opens-interp(raw, i)) {
                let end = brace-end(raw, i + 1);
                if chars.len() > 0 { parts.push(node(ExprKind.str-lit(chars.join("")), at)); }
                chars = [];
                // the expression keeps its place in the file; a spec after it ("{x:>8}") shapes its
                // text (std's format)
                let where = place(raw, o, i + 1);
                let colon = spec-colon(raw, i + 1, end);
                let value = whole-expr(parser(p.context, p.source, raw.substring(i + 1, if colon < 0 { end } else { colon }), where.line, where.col));
                if colon < 0 { parts.push(value); }
                else {
                    let spec = raw.substring(colon + 1, end);
                    match format-spec(spec) {
                        some(_) => {}
                        none => raw-fail(p, raw, colon + 1, o, "unknown format spec '{spec}': [[fill]align][0][width][.precision][? x X b o]"),
                    }
                    parts.push(node(ExprKind.call({ name: "~format", args: [value, node(ExprKind.str-lit(spec), at),], type-args: [], }), at));
                }
                i = end + 1;
            } else {
                chars.push(from-byte(c));
                i += 1;
            }
        }
        node(ExprKind.unit, at)
    }

    // the escape at raw[i] (a backslash), in a literal at span at: WAVE's (\\ \" \' \n \r \t
    // \u\{hex\}) and yel's \{ (and \} and \0, the bootstrap's)
    escape: func(p: Parser, raw: string, i: s64, at: Origin) -> Escape {
        let d = raw.byte-at(i + 1);
        if d == 110 { return { text: from-byte(10), width: 2, }; }
        if d == 116 { return { text: from-byte(9), width: 2, }; }
        if d == 114 { return { text: from-byte(13), width: 2, }; }
        if d == 48 { return { text: from-byte(0), width: 2, }; }
        if d == 92 || d == 34 || d == 39 || d == 123 || d == 125 {
            return { text: from-byte(d), width: 2, };
        }
        if d == 117 && raw.byte-at(i + 2) == 123 {
            let code = 0;
            for j in i + 3..raw.len() {
                let h = raw.byte-at(j);
                if h == 125 {
                    if j == i + 3 || code > 1114111 || (code >= 55296 && code <= 57343) {
                        raw-fail(p, raw, i, at, "\\u\{...\} needs a Unicode scalar value");
                    }
                    return { text: utf8(code), width: j + 1 - i, };
                }
                if !radix-digit(h, 16) || j - i > 9 {
                    raw-fail(p, raw, i, at, "\\u\{...\} takes 1 to 6 hex digits");
                }
                code = code * 16 + hex-value(h);
            }
        }
        raw-fail(p, raw, i, at, "unknown escape \\{from-byte(d)}");
        { text: "", width: 2, }
    }

    // an error at raw[i], raw being a literal's text from o
    raw-fail: func(p: Parser, raw: string, i: s64, o: Origin, message: string) {
        let where = place(raw, o, i);
        let at: Span = { source: p.source, line: where.line, col: where.col, end-line: where.line, end-col: where.col + 2, };
        fail-at(p, at, message);
    }

    // a code point as UTF-8
    utf8: func(code: s64) -> string {
        if code < 128 { return from-byte(code); }
        if code < 2048 { return from-byte(192 + code / 64) + from-byte(128 + code % 64); }
        if code < 65536 {
            return from-byte(224 + code / 4096) + from-byte(128 + (code / 64) % 64) + from-byte(
                128 + code % 64
            );
        }
        from-byte(240 + code / 262144) + from-byte(128 + (code / 4096) % 64) + from-byte(
            128 + (code / 64) % 64
        ) + from-byte(128 + code % 64)
    }

    // a char literal's code point: its text (an escape, or one UTF-8 scalar) at span at
    char-code: func(p: Parser, raw: string, span: Span) -> s64 {
        let at: Origin = { line: span.line, col: span.col + 1, indent: 0, };
        let bytes = raw;
        if raw.byte-at(0) == 92 {
            let esc = escape(p, raw, 0, at);
            if esc.width != raw.len() { raw-fail(p, raw, 0, at, "a char is one character"); }
            bytes = esc.text;
        }
        let n = bytes.len();
        let b = bytes.byte-at(0);
        let width = if b < 128 { 1 } else if b >= 240 { 4 } else if b >= 224 { 3 } else { 2 };
        if n == 0 || n != width { raw-fail(p, raw, 0, at, "a char is one character"); }
        if width == 1 { return b; }
        let code = 0;
        if width == 2 { code = b - 192; }
        if width == 3 { code = b - 224; }
        if width == 4 { code = b - 240; }
        for k in 1..width { code = code * 64 + bytes.byte-at(k) - 128; }
        code
    }

    // where an interpolation's spec starts (its colon) between from and to: the last colon outside
    // brackets, strings and chars; -1 for none
    spec-colon: func(raw: string, from: s64, to: s64) -> s64 {
        let depth = 0;
        let colon = -1;
        let at = from;
        for step in from..to + 1 {
            if at < to {
                let byte = raw.byte-at(at);
                if byte == 34 { at = string-end(raw, at + 1); }
                else if byte == 39 {
                    // a char: past its closing quote (an escaped one skipped)
                    at += 1;
                    for skip in at..to {
                        if at < to && raw.byte-at(at) != 39 { at += if raw.byte-at(at) == 92 { 2 } else { 1 }; }
                    }
                }
                else if byte == 40 || byte == 91 || byte == 123 { depth += 1; }
                else if byte == 41 || byte == 93 || byte == 125 { depth -= 1; }
                else if byte == 58 && depth == 0 { colon = at; }
                at += 1;
            }
        }
        colon
    }

    // the closing brace of an interpolation that starts at i (strings inside it skipped)
    brace-end: func(raw: string, from: s64) -> s64 {
        let n = raw.len();
        let i = from;
        let depth = 1;
        for step in 0..n + 1 {
            if i >= n { return n; }
            let c = raw.byte-at(i);
            if c == 34 {
                i = string-end(raw, i + 1) + 1;
            } else {
                if c == 123 { depth += 1; }
                if c == 125 {
                    depth -= 1;
                    if depth == 0 { return i; }
                }
                i += 1;
            }
        }
        n
    }

    declarations: func(p: Parser, out: list<Decl>) {
        for step in p.pos..p.toks.len() {
            if is-kind(p, 0, TokenKind.eof) { return; }
            recovering-declaration(p, out);
        }
    }

    // a declaration, or (past an error in it) what is left of it passed over
    recovering-declaration: func(p: Parser, out: list<Decl>) {
        let first = p.pos;
        declaration(p, out);
        if p.recovering { pass-over(p, first); }
        // nothing taken (a stray }): passed, so the next one starts past it
        if p.pos == first { advance(p); }
    }

    declaration: func(p: Parser, out: list<Decl>) {
        // package ns:name@version;
        if at(p, "package") && is-kind(p, 1, TokenKind.id) && !at-off(p, ":", 1) {
            advance(p);
            let full = package-id(p);
            let id = without-version(full);
            let pkg = p.scope.pkg;
            if p.scope.module != "" {
                fail(p, "a package is named at the top of a file, not in a module");
            }
            if pkg.id != "" && pkg.id != id {
                fail(p, "this file says package {id}, but the package's others say {pkg.id}");
            }
            pkg.id = id;
            if full != id { pkg.version = full.substring(id.len() + 1, full.len()); }
            return;
        }
        // from "<package>" include a, b as c;
        if at(p, "from") && is-kind(p, 1, TokenKind.str) {
            let span = here(p);
            if p.scope.module != "" {
                fail(p, "an include goes at the top of a file, not in a module");
            }
            advance(p);
            let spec = next(p);
            if next(p) != "include" { fail-missing(p, "expected include"); }
            let names: list<string> = [];
            let aliases: list<string> = [];
            include-names(p, names, aliases);
            p.scope.requests.push({ spec: spec, names: names, aliases: aliases, span: span, });
            return;
        }
        let direction: direction = "";
        if at(p, "export") {
            advance(p);
            direction = "export";
        }
        if at(p, "extern") && at-off(p, "module", 1) {
            fail(p, "extern module, an interface the host implements, comes with WIT imports");
        }
        // module name { ... }: one layer
        if at(p, "module") && is-kind(p, 1, TokenKind.id) && at-off(p, "\{", 2) {
            if p.scope.module != "" {
                fail(p, "module {p.scope.module} holds a module: modules are one layer");
            }
            advance(p);
            let m = name(p);
            expect(p, "\{");
            let outer = p.scope;
            if outer.pkg.modules.has(m) && outer.pkg.modules[m] != direction {
                fail(p, "module {m} is declared with another direction elsewhere");
            }
            outer.pkg.modules.set(m, direction);
            p.scope = {
                pkg: outer.pkg,
                module: m,
                file: outer.file,
                build: outer.build,
                includes: outer.includes,
                requests: outer.requests,
            };
            for s in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    p.scope = outer;
                    return;
                }
                if is-kind(p, 0, TokenKind.eof) {
                    fail(p, "module {m} is not closed");
                    p.scope = outer;
                    return;
                }
                recovering-declaration(p, out);
            }
        }
        let decl-span = here(p);
        if at(p, "record") {
            advance(p);
            let rname = name(p);
            expect(p, "\{");
            let fields = [];
            let types = [];
            for s in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    out.push(Decl.record-decl({
                        span: decl-span,
                        scope: p.scope,
                        name: rname,
                        fields: fields,
                        field-types: types,
                    }));
                    return;
                }
                fields.push(name(p));
                expect(p, ":");
                types.push(parse-type(p));
                if !at(p, "\}") { expect(p, ","); }
            }
        }
        // type name = T; (as WIT writes an alias)
        if at(p, "type") && is-kind(p, 1, TokenKind.id) && at-off(p, "=", 2) {
            advance(p);
            let tname = name(p);
            expect(p, "=");
            // distinct T: a type of its own (distinct is a name otherwise)
            let distinct = at(p, "distinct") && !at-off(p, ";", 1) && !at-off(p, "|", 1);
            if distinct { advance(p); }
            let target = parse-type(p);
            expect(p, ";");
            out.push(Decl.type-decl({
                span: decl-span,
                scope: p.scope,
                name: tname,
                target: target,
                resolved: Type.unit-type,
                distinct: distinct,
            }));
            return;
        }
        // let name: T; let name: T = value; (a global)
        if at(p, "let") && is-kind(p, 1, TokenKind.id) {
            advance(p);
            let gname = name(p);
            expect(p, ":");
            let ty = parse-type(p);
            let value: option<Expr> = none;
            if at(p, "=") {
                advance(p);
                value = some(expr(p));
            }
            expect(p, ";");
            out.push(Decl.global-decl({ span: decl-span, scope: p.scope, name: gname, ty: ty, value: value, }));
            return;
        }
        // const name = value; const name: T = value;
        if at(p, "const") && is-kind(p, 1, TokenKind.id) {
            advance(p);
            let cname = name(p);
            let ty: option<Type> = none;
            if at(p, ":") {
                advance(p);
                ty = some(parse-type(p));
            }
            expect(p, "=");
            let value = expr(p);
            expect(p, ";");
            out.push(Decl.const-decl({
                span: decl-span,
                scope: p.scope,
                name: cname,
                ty: ty,
                value: value,
            }));
            return;
        }
        if at(p, "flags") {
            advance(p);
            let fname = name(p);
            expect(p, "\{");
            let flags: list<string> = [];
            for s in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    out.push(Decl.flags-decl({
                        span: decl-span,
                        scope: p.scope,
                        name: fname,
                        flags: flags,
                    }));
                    return;
                }
                flags.push(name(p));
                if !at(p, "\}") { expect(p, ","); }
            }
        }
        if at(p, "variant") || at(p, "enum") {
            advance(p);
            let tname = name(p);
            expect(p, "\{");
            let cases = [];
            for s in p.pos..p.toks.len() {
                if at(p, "\}") {
                    advance(p);
                    out.push(Decl.variant-decl({
                        span: decl-span,
                        scope: p.scope,
                        name: tname,
                        cases: cases,
                    }));
                    return;
                }
                let c = name(p);
                let has = false;
                let payload = Type.unit-type;
                if at(p, "(") {
                    advance(p);
                    payload = parse-type(p);
                    expect(p, ")");
                    has = true;
                }
                cases.push({ name: c, has-payload: has, payload: payload, });
                if !at(p, "\}") { expect(p, ","); }
            }
        }
        // @c(name = "c_func", keeps = "p", gives = "q"): an extern's C name, and what it does with
        // its parameters that their types cannot say
        let cfunc: CFunc = { name: "", keeps: [], gives: [], };
        if at(p, "@") {
            advance(p);
            if name(p) != "c" { fail(p, "the only attribute is @c(name = \"...\")"); }
            expect(p, "(");
            loop {
                let key = name(p);
                expect(p, "=");
                if !is-kind(p, 0, TokenKind.str) { fail(p, "expected a string: @c({key} = \"...\")"); }
                let v = next(p);
                if key == "name" { cfunc.name = v; }
                else if key == "keeps" { cfunc.keeps.push(v); }
                else if key == "gives" { cfunc.gives.push(v); }
                else { fail(p, "@c takes name, keeps and gives"); }
                if !at(p, ",") { break; }
                advance(p);
            }
            expect(p, ")");
            if cfunc.name == "" { fail(p, "expected @c(name = \"...\")"); }
        }
        decl-span = here(p);
        let fname = name(p);
        expect(p, ":");
        let is-extern = at(p, "extern");
        if is-extern { advance(p); }
        // async func: it may wait
        let is-async = at(p, "async");
        if is-async { advance(p); }
        expect(p, "func");
        // type parameters: func<T, U>(...)
        let tps: list<string> = [];
        if at(p, "<") {
            advance(p);
            for s in p.pos..p.toks.len() {
                if at(p, ">") {
                    advance(p);
                    return declare-params(
                        p,
                        out,
                        decl-span,
                        fname,
                        is-extern,
                        is-async,
                        cfunc,
                        tps,
                    );
                }
                tps.push(name(p));
                if !at(p, ">") { expect(p, ","); }
            }
        }
        declare-params(p, out, decl-span, fname, is-extern, is-async, cfunc, tps);
    }

    // a package's id as written up to its `;` (ns:name@version)
    package-id: func(p: Parser) -> string {
        let parts: list<string> = [];
        for s in p.pos..p.toks.len() {
            if at(p, ";") {
                advance(p);
                return parts.join("");
            }
            if is-kind(p, 0, TokenKind.eof) { fail(p, "expected ';' after the package's name"); }
            parts.push(next(p));
        }
        parts.join("")
    }

    // an include's names, each with its alias (a as b), up to its `;`
    include-names: func(p: Parser, names: list<string>, aliases: list<string>) {
        for s in p.pos..p.toks.len() {
            let n = name(p);
            let alias = n;
            if at(p, "as") {
                advance(p);
                alias = name(p);
            }
            names.push(n);
            aliases.push(alias);
            if at(p, ";") {
                advance(p);
                return;
            }
            expect(p, ",");
        }
    }

    // a func's parameters, result and body (or, for an extern, its `;`)
    declare-params: func(
        p: Parser,
        out: list<Decl>,
        decl-span: Span,
        fname: string,
        is-extern: bool,
        is-async: bool,
        cfunc: CFunc,
        tps: list<string>,
    ) {
        expect(p, "(");
        let params = [];
        let types = [];
        for s in p.pos..p.toks.len() {
            if at(p, ")") {
                advance(p);
                let result = Type.unit-type;
                if at(p, "->") {
                    advance(p);
                    result = parse-type(p);
                }
                if is-extern {
                    if cfunc.name == "" { fail(p, "extern func {fname} needs @c(name = \"...\")"); }
                    expect(p, ";");
                    out.push(Decl.extern-decl({
                        span: decl-span,
                        scope: p.scope,
                        name: fname,
                        type-params: tps,
                        params: params,
                        param-types: types,
                        result: result,
                        c-name: cfunc.name,
                        keeps: cfunc.keeps,
                        gives: cfunc.gives,
                        wit-module: "",
                        wit-name: "",
                        is-async: is-async,
                    }));
                } else {
                    out.push(Decl.func-decl({
                        span: decl-span,
                        scope: p.scope,
                        name: fname,
                        type-params: tps,
                        params: params,
                        param-types: types,
                        result: result,
                        body: block(p),
                        marks: new-marks(params.len()),
                        unit: { env: false, },
                        is-async: is-async,
                        is-generator: false,
                        bindings: { exprs: map.new(), assigns: map.new(), },
                    }));
                }
                return;
            }
            params.push(name(p));
            expect(p, ":");
            types.push(parse-type(p));
            if !at(p, ")") { expect(p, ","); }
        }
    }
}
