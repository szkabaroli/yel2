// escape.yel, tested (yelc test compiler): small programs built as IR (analysis.lower), and what
// the program's flow says of them: which locals share a value, what each func does with its
// parameters (writes, keeps, gives back), whether its result is new, and which records stay on the
// stack. The readonly and move checks and the releases all read these

from "std:testing" include expect;

module escape-tests {
    // a func's summary: by its key, the flow's facts of it
    @(private) summary: async func(source: string, name: string) -> tuple<Lowered, IrFunc> {
        let lowered = wait lowering.built(source);
        (lowered, lowering.func-named(lowered, name))
    }

    // a parameter given back is the result; a literal is a new one
    @(test) gives-back-a-parameter: async func() {
        let (lowered, same) = wait summary(c"
            same: func(items: list<s64>) -> list<s64> { items }
            made: func() -> list<s64> { [1, 2,] }

            main: func() {
                let kept = same(made());
            }
        ", "same");
        expect.equal(lowered.facts.param-gives[same.name], [true,]);
        expect.equal(lowered.facts.fresh-result[same.name], false);
        let made = lowering.func-named(lowered, "made");
        expect.equal(lowered.facts.fresh-result[made.name], true);
    }

    // a parameter pushed to is written; one only read is not; and through a func that writes it
    @(test) writes-through-calls: async func() {
        let (lowered, add) = wait summary(c"
            add: func(items: list<s64>) { items.push(1); }
            size: func(items: list<s64>) -> s64 { items.len() }
            again: func(items: list<s64>) { add(items); }

            main: func() {
                let items = [0,];
                again(items);
                let count = size(items);
            }
        ", "add");
        expect.equal(lowered.facts.param-writes[add.name], [true,]);
        let size = lowering.func-named(lowered, "size");
        expect.equal(lowered.facts.param-writes[size.name], [false,]);
        let again = lowering.func-named(lowered, "again");
        expect.equal(lowered.facts.param-writes[again.name], [true,]);
    }

    // what observe counts as written: not an @(observable) resource's field, written through a
    // list's item (it tells of its own fields), but a plain resource's, and a list of lists' items
    @(test) changes-stop-at-observable-items: async func() {
        let (lowered, rename) = wait summary(c"
            @(observable) resource sheet { name: string, }
            resource plain { name: string, }
            rename: func(sheets: list<sheet>) -> list<string> { sheets.map({ one -> one.name = \"x\"; one.name }) }
            rename-plain: func(items: list<plain>) -> list<string> { items.map({ one -> one.name = \"x\"; one.name }) }
            grow: func(rows: list<list<s64>>) { for row in rows { row.push(1); } }

            main: func() {
                let sheets: list<sheet> = [{ name: \"a\", },];
                let named = rename(sheets);
                let items: list<plain> = [{ name: \"a\", },];
                let others = rename-plain(items);
                grow([[1,],]);
            }
        ", "rename");
        expect.equal(lowered.facts.param-writes[rename.name], [true,]);
        expect.equal(lowered.facts.param-changes[rename.name], [false,]);
        let plain = lowering.func-named(lowered, "rename-plain");
        expect.equal(lowered.facts.param-changes[plain.name], [true,]);
        let grow = lowering.func-named(lowered, "grow");
        expect.equal(lowered.facts.param-changes[grow.name], [true,]);
    }

    // how many times the func tells observe a field is about to change (the will-set markers its
    // calls kept once the flow settled them)
    @(private) will-sets: func(function: IrFunc) -> s64 {
        let count = 0;
        for node in flatten(function.body) {
            match node.kind {
                call(called) => { if called.key == "yel:std/observe.will-set" { count += 1; } }
                _ => {}
            }
        }
        count
    }

    // a list filtered from an observable resource's field is a new list: sorting it changes the
    // copy, not the field, so nothing reading the field is told (a view reading it would loop). The
    // field's own list, pushed to or sorted, is told
    @(test) a-filtered-copy-is-not-its-field: async func() {
        let lowered = wait lowering.built(c"
            @(observable) resource state { nodes: list<s64>, least: s64, }

            shown: func(app: state) -> list<s64> {
                let found = app.nodes.filter({ node -> node > 0 });
                found.sort({ left, right -> left < right });
                found
            }
            filtered: func(app: state) -> list<s64> { app.nodes.filter({ node -> node > 0 }) }
            // (Drive's shape: the filter's closure reads the resource, through a func given it)
            above: func(app: state, node: s64) -> bool { node > app.least }
            captured: func(app: state) -> list<s64> {
                let found = app.nodes.filter({ node -> above(app, node) && node != app.least });
                found.sort({ left, right -> left < right });
                found
            }
            grows: func(app: state) { app.nodes.push(1); }
            sorts: func(app: state) { app.nodes.sort({ left, right -> left < right }); }

            main: func() {
                let app: state = { nodes: [2, 1,], least: 0, };
                let one = shown(app);
                let three = captured(app);
                let two = filtered(app);
                grows(app);
                sorts(app);
            }
        ");
        expect.equal(will-sets(lowering.func-named(lowered, "shown")), 0);
        expect.equal(will-sets(lowering.func-named(lowered, "filtered")), 0);
        expect.equal(will-sets(lowering.func-named(lowered, "captured")), 0);
        expect.equal(will-sets(lowering.func-named(lowered, "grows")), 1);
        expect.equal(will-sets(lowering.func-named(lowered, "sorts")), 1);
    }

    // filtering a list whose items hold a list (a record with a list field) only reads it: a view
    // giving its own list field to such a func is not told the field changed (Drive's grid: its
    // folders, a let made by filtering its nodes prop, told nodes changed each time it was made,
    // and so was made again, forever)
    @(test) filtering-items-that-hold-lists-reads-them: async func() {
        let lowered = wait lowering.built(c"
            record entry { id: s64, name: string, tags: list<string>, }
            @(observable) resource state { nodes: list<entry>, }

            pick: func(nodes: list<entry>) -> list<entry> { nodes.filter({ one -> one.id > 0 }) }
            through: func(app: state) -> list<entry> { pick(app.nodes) }
            direct: func(app: state) -> list<entry> { app.nodes.filter({ one -> one.id > 0 }) }

            main: func() {
                let app: state = { nodes: [{ id: 1, name: \"a\", tags: [\"a\",], },], };
                let one = through(app);
                let two = direct(app);
            }
        ");
        expect.equal(will-sets(lowering.func-named(lowered, "through")), 0);
        expect.equal(will-sets(lowering.func-named(lowered, "direct")), 0);
        let pick = lowering.func-named(lowered, "pick");
        expect.equal(lowered.facts.param-changes[pick.name], [false,]);
    }

    // the same of a parameter: a filtered copy sorted writes the copy, not the parameter; but a
    // list of lists filtered holds the parameter's own lists, so pushing into one writes it
    @(test) a-filtered-copy-is-not-its-parameter: async func() {
        let (lowered, sorted) = wait summary(c"
            sorted: func(items: list<s64>) -> list<s64> {
                let copy = items.filter({ item -> item > 0 });
                copy.sort({ left, right -> left < right });
                copy
            }
            grow-some: func(rows: list<list<s64>>) {
                let some = rows.filter({ row -> row.len() > 0 });
                for row in some { row.push(1); }
            }

            main: func() {
                let kept = sorted([2, 1,]);
                grow-some([[1,],]);
            }
        ", "sorted");
        expect.equal(lowered.facts.param-writes[sorted.name], [false,]);
        let grow = lowering.func-named(lowered, "grow-some");
        expect.equal(lowered.facts.param-writes[grow.name], [true,]);
    }

    // a parameter pushed into another is kept in it, not let escape
    @(test) kept-in-another-parameter: async func() {
        let (lowered, keep) = wait summary(c"
            keep: func(into: list<list<s64>>, items: list<s64>) { into.push(items); }

            main: func() {
                let all: list<list<s64>> = [];
                keep(all, [1,]);
            }
        ", "keep");
        expect.equal(lowered.facts.param-kept-in[keep.name][1], [0,]);
        expect.equal(lowered.facts.param-escapes[keep.name], [false, false,]);
    }

    // a copy is another name for the same value: one group
    @(test) copies-share-a-group: async func() {
        let (lowered, share) = wait summary(c"
            share: func() -> s64 {
                let first = [1,];
                let second = first;
                let other = [2,];
                second.push(3);
                first.len() + other.len()
            }

            main: func() {
                let count = share();
            }
        ", "share");
        let groups = lowered.facts.groups[share.name];
        let first = opt.find(groups, lowering.local-named(share, "first"));
        expect.equal(opt.find(groups, lowering.local-named(share, "second")), first);
        expect.not-equal(opt.find(groups, lowering.local-named(share, "other")), first);
        expect.holds(groups.written[first]);
    }

    // a resource that never leaves the func making it is kept on its stack; one given back, or an
    // async func's (gone from the stack while it waits), on the heap
    @(test) places-records: async func() {
        let lowered = wait lowering.built(c"
            resource cell { value: s64, }

            kept: func() -> s64 {
                let held: cell = { value: 3, };
                held.value
            }

            given: func() -> cell {
                let held: cell = { value: 3, };
                held
            }

            waits: async func() -> s64 {
                let held: cell = { value: 3, };
                wait sleep(0);
                held.value
            }

            main: async func() {
                let value = kept() + given().value + wait waits();
            }
        ");
        expect.equal(stacked(lowered, "kept"), [true,]);
        expect.equal(stacked(lowered, "given"), [false,]);
        expect.equal(stacked(lowered, "waits"), [false,]);
    }

    // for each record a func makes, in order, whether it goes on its stack
    @(private) stacked: func(lowered: Lowered, name: string) -> list<bool> {
        let function = lowering.func-named(lowered, name);
        opt.place-records(lowered.facts, function);
        let out: list<bool> = [];
        for node in flatten(function.body) {
            match node.kind {
                assign(assigned) => {
                    match assigned.value.kind {
                        alloc(allocated) => { out.push(allocated.stack); }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        out
    }
}
