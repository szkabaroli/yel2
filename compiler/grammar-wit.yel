// Reading WIT: a package's interfaces (their uses, types and funcs), as the packages module turns
// them into yel modules. A world is skipped: a yel program's own is made from what it uses.

// a WIT package as read: its id (ns:name), version, file, and interfaces by name
// a WIT package: its id and version, its first file (where it is) and all of them (a package may be
// in several), its interfaces
resource WitPackage { id: string, version: string, file: string, files: list<string>, interfaces: map<string, WitInterface>, }
resource WitInterface {
    name: string,
    uses: list<WitUse>,
    types: list<WitTypeDef>,
    funcs: list<WitFunc>,
}
// use ns:name/iface.{a, b as c} (pkg "" for one of the same package's)
record WitUse { pkg: string, iface: string, names: list<string>, aliases: list<string>, }
// a type: kind record (fields, types), variant or enum (cases), flags (fields), alias (target), or
// resource (funcs: its constructor, methods and static funcs)
type wit-type-kind = "alias" | "record" | "variant" | "enum" | "flags" | "resource";

resource WitTypeDef {
    name: string,
    kind: wit-type-kind,
    fields: list<string>,
    types: list<Type>,
    cases: list<CaseDecl>,
    target: Type,
    funcs: list<WitFunc>,
}
// a func; a resource's has a kind: "constructor", "method" (its handle is the first param, self),
// or "static"; an interface's is "func"
type wit-func-kind = "func" | "constructor" | "method" | "static";

resource WitFunc {
    name: string,
    kind: wit-func-kind,
    params: list<string>,
    types: list<Type>,
    result: Type,
    // async func: it may wait (a yel async func's call: wait f(…))
    is-async: bool,
}


// (the parser's: its token cursor, grammar.yel's, read without a tree that is kept)
module grammar {
    // a WIT file's package
    wit-file: func(context: Context, source: s64) -> WitPackage {
        let file = context.sources[source].path;
        let g = grammar(context, source);
        let pkg: WitPackage = { id: "", version: "", file: file, files: [file,], interfaces: map.new(), };
        for step in g.pos..g.toks.len() {
            skip-gates(g);
            if is-kind(g, 0, TokenKind.eof) { return pkg; }
            if at(g, "package") {
                advance(g);
                let full = package-id(g);
                pkg.id = without-version(full);
                if pkg.id != full {
                    pkg.version = full.substring(pkg.id.len() + 1, full.len());
                }
            } else if at(g, "interface") {
                advance(g);
                let n = wit-name(g);
                pkg.interfaces.set(n, wit-interface(g, n));
            } else if at(g, "world") {
                advance(g);
                wit-name(g);
                skip-braces(g);
            } else if at(g, "use") {
                wit-use(g);
            } else {
                fail(g, "expected an interface or a world in WIT, found {found(g)}");
            }
        }
        pkg
    }

    // a WIT name: kebab-case, % before one that is a keyword
    wit-name: func(g: Grammar) -> string {
        if at(g, "%") { advance(g); }
        name(g)
    }

    // @since(version = 0.2.0), @unstable(feature = x), @deprecated(...): gates, skipped
    skip-gates: func(g: Grammar) {
        for step in g.pos..g.toks.len() {
            if !at(g, "@") { return; }
            advance(g);
            name(g);
            if at(g, "(") { skip-parens(g); }
        }
    }

    skip-parens: func(g: Grammar) {
        let depth = 0;
        for step in g.pos..g.toks.len() {
            if at(g, "(") { depth += 1; }
            if at(g, ")") {
                depth -= 1;
                if depth == 0 {
                    advance(g);
                    return;
                }
            }
            if is-kind(g, 0, TokenKind.eof) { fail(g, "unclosed '('"); }
            advance(g);
        }
    }

    // a { ... } skipped whole (a world, a resource's methods)
    skip-braces: func(g: Grammar) {
        let depth = 0;
        for step in g.pos..g.toks.len() {
            if at(g, "\{") { depth += 1; }
            if at(g, "\}") {
                depth -= 1;
                if depth == 0 {
                    advance(g);
                    return;
                }
            }
            if is-kind(g, 0, TokenKind.eof) { fail(g, "unclosed '\{'"); }
            advance(g);
        }
    }

    wit-interface: func(g: Grammar, n: string) -> WitInterface {
        let face: WitInterface = { name: n, uses: [], types: [], funcs: [], };
        expect(g, "\{");
        for step in g.pos..g.toks.len() {
            skip-gates(g);
            if at(g, "\}") {
                advance(g);
                return face;
            }
            if at(g, "use") { face.uses.push(wit-use(g)); }
            else if at(g, "type") {
                advance(g);
                let tn = wit-name(g);
                expect(g, "=");
                let target = wit-type(g);
                expect(g, ";");
                face.types.push({
                    name: tn,
                    kind: "alias",
                    fields: [],
                    types: [],
                    cases: [],
                    target: target,
                    funcs: [],
                });
            } else if at(g, "record") {
                advance(g);
                let tn = wit-name(g);
                expect(g, "\{");
                let fields: list<string> = [];
                let types: list<Type> = [];
                wit-fields(g, "\}", fields, types);
                face.types.push({
                    name: tn,
                    kind: "record",
                    fields: fields,
                    types: types,
                    cases: [],
                    target: Type.unit-type,
                    funcs: [],
                });
            } else if at(g, "variant") || at(g, "enum") {
                let kind: wit-type-kind = if at(g, "variant") { "variant" } else { "enum" };
                advance(g);
                let tn = wit-name(g);
                expect(g, "\{");
                let cases: list<CaseDecl> = [];
                wit-cases(g, cases);
                face.types.push({
                    name: tn,
                    kind: kind,
                    fields: [],
                    types: [],
                    cases: cases,
                    target: Type.unit-type,
                    funcs: [],
                });
            } else if at(g, "flags") {
                advance(g);
                let tn = wit-name(g);
                expect(g, "\{");
                let flags: list<string> = [];
                wit-flags(g, flags);
                face.types.push({
                    name: tn,
                    kind: "flags",
                    fields: flags,
                    types: [],
                    cases: [],
                    target: Type.unit-type,
                    funcs: [],
                });
            } else if at(g, "resource") {
                advance(g);
                let tn = wit-name(g);
                let funcs: list<WitFunc> = [];
                if at(g, ";") { advance(g); } else { wit-resource(g, tn, funcs); }
                face.types.push({
                    name: tn,
                    kind: "resource",
                    fields: [],
                    types: [],
                    cases: [],
                    target: Type.unit-type,
                    funcs: funcs,
                });
            } else {
                let fname = wit-name(g);
                expect(g, ":");
                face.funcs.push(wit-func(g, fname, "func"));
            }
        }
        face
    }

    // a func's type after its name and colon, to its ;: [static] [async] func(params) [-> result]
    wit-func: func(g: Grammar, n: string, kind: wit-func-kind) -> WitFunc {
        let k = kind;
        if at(g, "static") {
            advance(g);
            k = "static";
        }
        // an async func (WASI 0.3): a call waits (yel's async)
        let is-async = at(g, "async");
        if is-async { advance(g); }
        expect(g, "func");
        expect(g, "(");
        let params: list<string> = [];
        let types: list<Type> = [];
        wit-fields(g, ")", params, types);
        let result = Type.unit-type;
        if at(g, "->") {
            advance(g);
            result = wit-type(g);
        }
        expect(g, ";");
        { name: n, kind: k, params: params, types: types, result: result, is-async: is-async, }
    }

    // a resource's { ... }: its constructor, methods and static funcs
    wit-resource: func(g: Grammar, r: string, funcs: list<WitFunc>) {
        expect(g, "\{");
        for step in g.pos..g.toks.len() {
            skip-gates(g);
            if at(g, "\}") {
                advance(g);
                return;
            }
            if at(g, "constructor") {
                advance(g);
                expect(g, "(");
                let params: list<string> = [];
                let types: list<Type> = [];
                wit-fields(g, ")", params, types);
                // a constructor may fail: its result is then written
                let result = Type.named(intern(r));
                if at(g, "->") {
                    advance(g);
                    result = wit-type(g);
                }
                expect(g, ";");
                funcs.push({
                    name: "new",
                    kind: "constructor",
                    params: params,
                    types: types,
                    result: result,
                    is-async: false,
                });
            } else {
                let fname = wit-name(g);
                expect(g, ":");
                funcs.push(wit-func(g, fname, "method"));
            }
        }
    }

    // name: type pairs up to close (a record's fields, a func's params), close taken
    wit-fields: func(g: Grammar, close: string, names: list<string>, types: list<Type>) {
        for s in g.pos..g.toks.len() {
            skip-gates(g);
            if at(g, close) {
                advance(g);
                return;
            }
            names.push(wit-name(g));
            expect(g, ":");
            types.push(wit-type(g));
            if !at(g, close) { expect(g, ","); }
        }
    }

    wit-cases: func(g: Grammar, cases: list<CaseDecl>) {
        for s in g.pos..g.toks.len() {
            skip-gates(g);
            if at(g, "\}") {
                advance(g);
                return;
            }
            let c = wit-name(g);
            let has = false;
            let payload = Type.unit-type;
            if at(g, "(") {
                advance(g);
                payload = wit-type(g);
                expect(g, ")");
                has = true;
            }
            cases.push({ name: c, has-payload: has, payload: payload, });
            if !at(g, "\}") { expect(g, ","); }
        }
    }

    wit-flags: func(g: Grammar, flags: list<string>) {
        for s in g.pos..g.toks.len() {
            skip-gates(g);
            if at(g, "\}") {
                advance(g);
                return;
            }
            flags.push(wit-name(g));
            if !at(g, "\}") { expect(g, ","); }
        }
    }

    // use ns:name/iface@version.{a, b as c}; or use iface.{a};
    wit-use: func(g: Grammar) -> WitUse {
        expect(g, "use");
        let first = wit-name(g);
        let pkg = "";
        let iface = first;
        if at(g, ":") {
            advance(g);
            pkg = first + ":" + wit-name(g);
            expect(g, "/");
            iface = wit-name(g);
            if at(g, "@") { skip-version(g); }
        }
        expect(g, ".");
        expect(g, "\{");
        let names: list<string> = [];
        let aliases: list<string> = [];
        wit-use-names(g, names, aliases);
        expect(g, ";");
        { pkg: pkg, iface: iface, names: names, aliases: aliases, }
    }

    // @version, up to the . before {
    skip-version: func(g: Grammar) {
        advance(g);
        for s in g.pos..g.toks.len() {
            if at(g, ".") && at-off(g, "\{", 1) { return; }
            advance(g);
        }
    }

    // a use's names (a as b) up to its }, taken
    wit-use-names: func(g: Grammar, names: list<string>, aliases: list<string>) {
        for s in g.pos..g.toks.len() {
            if at(g, "\}") {
                advance(g);
                return;
            }
            let n = wit-name(g);
            let alias = n;
            if at(g, "as") {
                advance(g);
                alias = wit-name(g);
            }
            names.push(n);
            aliases.push(alias);
            if !at(g, "\}") { expect(g, ","); }
        }
    }

    // a WIT type, as a yel type: a name stays a name (the packages module resolves it); own<r> and
    // borrow<r> are r (a handle both)
    wit-type: func(g: Grammar) -> Type {
        let n = wit-name(g);
        if n == "list" || n == "option" {
            expect(g, "<");
            let inner = wit-type(g);
            // list<T, N>: fixed-length
            if n == "list" && at(g, ",") {
                advance(g);
                let len = fixed-len(g, text(g));
                advance(g);
                expect(g, ">");
                return Type.fixed-list({ item: inner, len: len, });
            }
            expect(g, ">");
            return if n == "list" { Type.list-type(inner) } else { Type.option-type(inner) };
        }
        if n == "tuple" {
            expect(g, "<");
            let items: list<Type> = [];
            for s in g.pos..g.toks.len() {
                if at(g, ">") {
                    advance(g);
                    return Type.tuple-type(items);
                }
                items.push(wit-type(g));
                if !at(g, ">") { expect(g, ","); }
            }
        }
        if n == "result" {
            let ok = Type.unit-type;
            let err = Type.unit-type;
            if at(g, "<") {
                advance(g);
                if at(g, "_") { advance(g); } else { ok = wit-type(g); }
                if at(g, ",") {
                    advance(g);
                    err = wit-type(g);
                }
                expect(g, ">");
            }
            return Type.result-type({ ok: ok, err: err, });
        }
        // a stream or a future (WASI 0.3): yel's (of unit where it has no item)
        if n == "stream" || n == "future" {
            let item = Type.unit-type;
            if at(g, "<") {
                advance(g);
                if at(g, "_") { advance(g); } else { item = wit-type(g); }
                expect(g, ">");
            }
            if n == "future" { return Type.future-type(item); }
            return Type.stream-type({ item: item, writer: false, });
        }
        if n == "borrow" || n == "own" {
            expect(g, "<");
            let r = wit-name(g);
            expect(g, ">");
            return Type.named(intern(r));
        }
        if n == "float32" { return Type.num("f32"); }
        if n == "float64" { return Type.num("f64"); }
        let num = lower.num-name(n);
        if num != "" && n != "int" && n != "float" { return Type.num(num); }
        if n == "bool" { return Type.bool-type; }
        if n == "char" { return Type.char-type; }
        if n == "string" { return Type.string-type; }
        Type.named(intern(n))
    }
}
