// Reading WIT: a package's interfaces (their uses, types and funcs), as the packages module turns
// them into yel modules. A world is skipped: a yel program's own is made from what it uses.

// a WIT package as read: its id (ns:name), version, file, and interfaces by name
// a WIT package: its id and version, its first file (where it is) and all of them (a package may be
// in several), its interfaces
resource WitPackage { id: string, version: string, file: string, files: list<string>, interfaces: map<string, WitInterface>, }
resource WitInterface {
    name: string,
    uses: list<WitUse>,
    types: list<WitTypeDef>,
    funcs: list<WitFunc>,
}
// use ns:name/iface.{a, b as c} (pkg "" for one of the same package's)
record WitUse { pkg: string, iface: string, names: list<string>, aliases: list<string>, }
// a type: kind record (fields, types), variant or enum (cases), flags (fields), alias (target), or
// resource (funcs: its constructor, methods and static funcs)
type wit-type-kind = "alias" | "record" | "variant" | "enum" | "flags" | "resource";

resource WitTypeDef {
    name: string,
    kind: wit-type-kind,
    fields: list<string>,
    types: list<Type>,
    cases: list<CaseDecl>,
    target: Type,
    funcs: list<WitFunc>,
}
// a func; a resource's has a kind: "constructor", "method" (its handle is the first param, self),
// or "static"; an interface's is "func"
type wit-func-kind = "func" | "constructor" | "method" | "static";

resource WitFunc {
    name: string,
    kind: wit-func-kind,
    params: list<string>,
    types: list<Type>,
    result: Type,
    // async func: it may wait (a yel async func's call: wait f(…))
    is-async: bool,
}


// (the parser's: its token cursor, grammar.yel's, read without a tree that is kept)
module grammar {
    // a WIT file's package
    wit-file: func(context: Context, source: s64) -> WitPackage {
        let file = context.sources[source].path;
        let parsing = grammar(context, source);
        let pkg: WitPackage = { id: "", version: "", file: file, files: [file,], interfaces: map.new(), };
        for step in parsing.pos..parsing.toks.len() {
            skip-gates(parsing);
            if is-kind(parsing, 0, TokenKind.eof) { return pkg; }
            if at(parsing, "package") {
                advance(parsing);
                let full = package-id(parsing);
                pkg.id = without-version(full);
                if pkg.id != full {
                    pkg.version = full.substring(pkg.id.len() + 1, full.len());
                }
            } else if at(parsing, "interface") {
                advance(parsing);
                let name = wit-name(parsing);
                pkg.interfaces.set(name, wit-interface(parsing, name));
            } else if at(parsing, "world") {
                advance(parsing);
                wit-name(parsing);
                skip-braces(parsing);
            } else if at(parsing, "use") {
                wit-use(parsing);
            } else {
                fail(parsing, "expected an interface or a world in WIT, found {found(parsing)}");
            }
        }
        pkg
    }

    // a WIT name: kebab-case, % before one that is a keyword
    wit-name: func(parsing: Grammar) -> string {
        if at(parsing, "%") { advance(parsing); }
        name(parsing)
    }

    // @since(version = 0.2.0), @unstable(feature = x), @deprecated(...): gates, skipped
    skip-gates: func(parsing: Grammar) {
        for step in parsing.pos..parsing.toks.len() {
            if !at(parsing, "@") { return; }
            advance(parsing);
            name(parsing);
            if at(parsing, "(") { skip-parens(parsing); }
        }
    }

    skip-parens: func(parsing: Grammar) {
        let depth = 0;
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, "(") { depth += 1; }
            if at(parsing, ")") {
                depth -= 1;
                if depth == 0 {
                    advance(parsing);
                    return;
                }
            }
            if is-kind(parsing, 0, TokenKind.eof) { fail(parsing, "unclosed '('"); }
            advance(parsing);
        }
    }

    // a { ... } skipped whole (a world, a resource's methods)
    skip-braces: func(parsing: Grammar) {
        let depth = 0;
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, "\{") { depth += 1; }
            if at(parsing, "\}") {
                depth -= 1;
                if depth == 0 {
                    advance(parsing);
                    return;
                }
            }
            if is-kind(parsing, 0, TokenKind.eof) { fail(parsing, "unclosed '\{'"); }
            advance(parsing);
        }
    }

    wit-interface: func(parsing: Grammar, name: string) -> WitInterface {
        let face: WitInterface = { name: name, uses: [], types: [], funcs: [], };
        expect(parsing, "\{");
        for step in parsing.pos..parsing.toks.len() {
            skip-gates(parsing);
            if at(parsing, "\}") {
                advance(parsing);
                return face;
            }
            if at(parsing, "use") { face.uses.push(wit-use(parsing)); }
            else if at(parsing, "type") {
                advance(parsing);
                let tn = wit-name(parsing);
                expect(parsing, "=");
                let target = wit-type(parsing);
                expect(parsing, ";");
                face.types.push({
                    name: tn,
                    kind: "alias",
                    fields: [],
                    types: [],
                    cases: [],
                    target: target,
                    funcs: [],
                });
            } else if at(parsing, "record") {
                advance(parsing);
                let tn = wit-name(parsing);
                expect(parsing, "\{");
                let fields: list<string> = [];
                let types: list<Type> = [];
                wit-fields(parsing, "\}", fields, types);
                face.types.push({
                    name: tn,
                    kind: "record",
                    fields: fields,
                    types: types,
                    cases: [],
                    target: Type.unit-type,
                    funcs: [],
                });
            } else if at(parsing, "variant") || at(parsing, "enum") {
                let kind: wit-type-kind = if at(parsing, "variant") { "variant" } else { "enum" };
                advance(parsing);
                let tn = wit-name(parsing);
                expect(parsing, "\{");
                let cases: list<CaseDecl> = [];
                wit-cases(parsing, cases);
                face.types.push({
                    name: tn,
                    kind: kind,
                    fields: [],
                    types: [],
                    cases: cases,
                    target: Type.unit-type,
                    funcs: [],
                });
            } else if at(parsing, "flags") {
                advance(parsing);
                let tn = wit-name(parsing);
                expect(parsing, "\{");
                let flags: list<string> = [];
                wit-flags(parsing, flags);
                face.types.push({
                    name: tn,
                    kind: "flags",
                    fields: flags,
                    types: [],
                    cases: [],
                    target: Type.unit-type,
                    funcs: [],
                });
            } else if at(parsing, "resource") {
                advance(parsing);
                let tn = wit-name(parsing);
                let funcs: list<WitFunc> = [];
                if at(parsing, ";") { advance(parsing); } else { wit-resource(parsing, tn, funcs); }
                face.types.push({
                    name: tn,
                    kind: "resource",
                    fields: [],
                    types: [],
                    cases: [],
                    target: Type.unit-type,
                    funcs: funcs,
                });
            } else {
                let fname = wit-name(parsing);
                expect(parsing, ":");
                face.funcs.push(wit-func(parsing, fname, "func"));
            }
        }
        face
    }

    // a func's type after its name and colon, to its ;: [static] [async] func(params) [-> result]
    wit-func: func(parsing: Grammar, name: string, kind: wit-func-kind) -> WitFunc {
        let resolved = kind;
        if at(parsing, "static") {
            advance(parsing);
            resolved = "static";
        }
        // an async func (WASI 0.3): a call waits (yel's async)
        let is-async = at(parsing, "async");
        if is-async { advance(parsing); }
        expect(parsing, "func");
        expect(parsing, "(");
        let params: list<string> = [];
        let types: list<Type> = [];
        wit-fields(parsing, ")", params, types);
        let result = Type.unit-type;
        if at(parsing, "->") {
            advance(parsing);
            result = wit-type(parsing);
        }
        expect(parsing, ";");
        { name: name, kind: resolved, params: params, types: types, result: result, is-async: is-async, }
    }

    // a resource's { ... }: its constructor, methods and static funcs
    wit-resource: func(parsing: Grammar, owner: string, funcs: list<WitFunc>) {
        expect(parsing, "\{");
        for step in parsing.pos..parsing.toks.len() {
            skip-gates(parsing);
            if at(parsing, "\}") {
                advance(parsing);
                return;
            }
            if at(parsing, "constructor") {
                advance(parsing);
                expect(parsing, "(");
                let params: list<string> = [];
                let types: list<Type> = [];
                wit-fields(parsing, ")", params, types);
                // a constructor may fail: its result is then written
                let result = Type.named(intern(owner));
                if at(parsing, "->") {
                    advance(parsing);
                    result = wit-type(parsing);
                }
                expect(parsing, ";");
                funcs.push({
                    name: "new",
                    kind: "constructor",
                    params: params,
                    types: types,
                    result: result,
                    is-async: false,
                });
            } else {
                let fname = wit-name(parsing);
                expect(parsing, ":");
                funcs.push(wit-func(parsing, fname, "method"));
            }
        }
    }

    // name: type pairs up to close (a record's fields, a func's params), close taken
    wit-fields: func(parsing: Grammar, close: string, names: list<string>, types: list<Type>) {
        for step in parsing.pos..parsing.toks.len() {
            skip-gates(parsing);
            if at(parsing, close) {
                advance(parsing);
                return;
            }
            names.push(wit-name(parsing));
            expect(parsing, ":");
            types.push(wit-type(parsing));
            if !at(parsing, close) { expect(parsing, ","); }
        }
    }

    wit-cases: func(parsing: Grammar, cases: list<CaseDecl>) {
        for step in parsing.pos..parsing.toks.len() {
            skip-gates(parsing);
            if at(parsing, "\}") {
                advance(parsing);
                return;
            }
            let case-name = wit-name(parsing);
            let has = false;
            let payload = Type.unit-type;
            if at(parsing, "(") {
                advance(parsing);
                payload = wit-type(parsing);
                expect(parsing, ")");
                has = true;
            }
            cases.push({ name: case-name, has-payload: has, payload: payload, });
            if !at(parsing, "\}") { expect(parsing, ","); }
        }
    }

    wit-flags: func(parsing: Grammar, flags: list<string>) {
        for step in parsing.pos..parsing.toks.len() {
            skip-gates(parsing);
            if at(parsing, "\}") {
                advance(parsing);
                return;
            }
            flags.push(wit-name(parsing));
            if !at(parsing, "\}") { expect(parsing, ","); }
        }
    }

    // use ns:name/iface@version.{a, b as c}; or use iface.{a};
    wit-use: func(parsing: Grammar) -> WitUse {
        expect(parsing, "use");
        let first = wit-name(parsing);
        let pkg = "";
        let iface = first;
        if at(parsing, ":") {
            advance(parsing);
            pkg = first + ":" + wit-name(parsing);
            expect(parsing, "/");
            iface = wit-name(parsing);
            if at(parsing, "@") { skip-version(parsing); }
        }
        expect(parsing, ".");
        expect(parsing, "\{");
        let names: list<string> = [];
        let aliases: list<string> = [];
        wit-use-names(parsing, names, aliases);
        expect(parsing, ";");
        { pkg: pkg, iface: iface, names: names, aliases: aliases, }
    }

    // @version, up to the . before {
    skip-version: func(parsing: Grammar) {
        advance(parsing);
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, ".") && at-off(parsing, "\{", 1) { return; }
            advance(parsing);
        }
    }

    // a use's names (a as b) up to its }, taken
    wit-use-names: func(parsing: Grammar, names: list<string>, aliases: list<string>) {
        for step in parsing.pos..parsing.toks.len() {
            if at(parsing, "\}") {
                advance(parsing);
                return;
            }
            let name = wit-name(parsing);
            let alias = name;
            if at(parsing, "as") {
                advance(parsing);
                alias = wit-name(parsing);
            }
            names.push(name);
            aliases.push(alias);
            if !at(parsing, "\}") { expect(parsing, ","); }
        }
    }

    // a WIT type, as a yel type: a name stays a name (the packages module resolves it); own<r> and
    // borrow<r> are r (a handle both)
    wit-type: func(parsing: Grammar) -> Type {
        let name = wit-name(parsing);
        if name == "list" || name == "option" {
            expect(parsing, "<");
            let inner = wit-type(parsing);
            // list<T, N>: fixed-length
            if name == "list" && at(parsing, ",") {
                advance(parsing);
                let len = fixed-len(parsing, text(parsing));
                advance(parsing);
                expect(parsing, ">");
                return Type.fixed-list({ item: inner, len: len, });
            }
            expect(parsing, ">");
            return if name == "list" { Type.list-type(inner) } else { Type.option-type(inner) };
        }
        if name == "tuple" {
            expect(parsing, "<");
            let items: list<Type> = [];
            for step in parsing.pos..parsing.toks.len() {
                if at(parsing, ">") {
                    advance(parsing);
                    return Type.tuple-type(items);
                }
                items.push(wit-type(parsing));
                if !at(parsing, ">") { expect(parsing, ","); }
            }
        }
        if name == "result" {
            let ok = Type.unit-type;
            let err = Type.unit-type;
            if at(parsing, "<") {
                advance(parsing);
                if at(parsing, "_") { advance(parsing); } else { ok = wit-type(parsing); }
                if at(parsing, ",") {
                    advance(parsing);
                    err = wit-type(parsing);
                }
                expect(parsing, ">");
            }
            return Type.result-type({ ok: ok, err: err, });
        }
        // a stream or a future (WASI 0.3): yel's (of unit where it has no item)
        if name == "stream" || name == "future" {
            let item = Type.unit-type;
            if at(parsing, "<") {
                advance(parsing);
                if at(parsing, "_") { advance(parsing); } else { item = wit-type(parsing); }
                expect(parsing, ">");
            }
            if name == "future" { return Type.future-type(item); }
            return Type.stream-type({ item: item, writer: false, });
        }
        if name == "borrow" || name == "own" {
            expect(parsing, "<");
            let handle = wit-name(parsing);
            expect(parsing, ">");
            return Type.named(intern(handle));
        }
        if name == "float32" { return Type.num("f32"); }
        if name == "float64" { return Type.num("f64"); }
        let num = lower.num-name(name);
        if num != "" && name != "int" && name != "float" { return Type.num(num); }
        if name == "bool" { return Type.bool-type; }
        if name == "char" { return Type.char-type; }
        if name == "string" { return Type.string-type; }
        Type.named(intern(name))
    }
}
