// The bitcode backend (yelc --backend bitcode): the IR, after the optimizer, lowered into an LLVM
// module (bitcode.yel) instead of rendered as C, linked with the runtime (runtime/yel.c, the C
// backend's too) built for the target. A start: strings (a { i64, ptr }, as a ystr; their literals,
// print and eprint), the integers (s8 to u64, bool, char),
// their arithmetic as yel's (wrapping; / and % stopping at zero as the runtime does, a signed one
// by -1 the negation; a shift by its amount modulo the width), comparisons, the bit operators,
// conversions, locals, ifs, loops (break, continue, a block's label), returns and calls between the
// program's funcs, and calls of the runtime's C functions, as the target's C calling convention
// passes their values (the calling module, below). Anything else stops the compiler saying what is not done yet.
//
// Each local is a slot (an alloca in the entry block, which holds allocas only, loaded and stored), as
// clang makes C at -O0:
// no SSA built here; LLVM's mem2reg makes registers of them. main is C's (__main_argc_argv on
// wasm), calling the runtime's start (the collector, the arguments), the program's main, and its end
// (stdout flushed, main's value the exit code).

from "std:cli" include environment;

// a func being lowered: the module (and its types), the func, its IR, the block instructions go to,
// each local's slot (none for a () one), and the loops and labeled blocks around (each label, where
// its continue goes: -1 for a block's, and where its break goes)
resource Lower {
    m: BcModule,
    types: Types,
    made: Made,
    f: BcFunc,
    ir: IrFunc,
    block: s64,
    slots: list<option<BcValue>>,
    labels: list<s64>,
    continues: list<s64>,
    breaks: list<s64>,
    // the program's funcs by C name (their index in the module)
    index: map<string, s64>,
    // the externs by C name (their yel name: print)
    externs: map<string, string>,
    // the target's C calling convention (calling.abi's)
    abi: string,
    // its records on the stack (by the local they are assigned to); its frame (frame-start's:
    // framed, the frame, its slots and their count, and each local's first slot (-1 for none) and
    // pointers' paths)
    stack-objects: map<s64, BcValue>,
    framed: bool,
    frame: BcValue,
    roots: BcValue,
    root-count: s64,
    root-at: list<s64>,
    root-paths: list<list<list<s64>>>,
    // what an intrinsic gave (map-intrinsic's)
    given: option<BcValue>,
    // an async func's step: its frame (the param) and the frame's type; each wait's state's block
    task: BcValue,
    task-type: s64,
    resumes: map<s64, s64>,
    // where its result is written, given in memory (in-memory's sret: the hidden first param)
    result-memory: option<BcValue>,
}

// what a module's types are made of: the module, the program's declarations, the target's C ABI
// (imports: a WIT import's wrapper's C name to its native host's: imports-hosts in gen.yel), and
// whether its C widens a narrow integer for the one it gives it to (calling.extends-narrow)
resource Types { m: BcModule, g: Gen, abi: string, imports: map<string, string>, extends: bool, }

// (gen's core imports: Types.g.core-imports, by their C names)

// what the module's funcs share: the globals made so far (by C name: payload-less cases, type
// descriptors); the runtime's C functions called, by name, each whether every call of it is pure
// (codegen's pure-call: it reads and writes no memory, and collects nothing)
// (calling-pure: the call being made is such a one); the program's globals, by key (each a
// variable of the module's, zero to start with)
resource Made { singletons: map<string, s64>, pure: map<string, bool>, calling-pure: bool, globals: map<string, s64>, }

// a canonical struct (abi.yel's A_<id>): its members (their C names, and their canonical types:
// abi-of's), and its union's (the last member, u: each case's, and none, a byte)
record CanonicalParts { names: list<string>, types: list<Type>, union-names: list<string>, union-types: list<Type>, }

// a step of a C path into a value: the struct it is in and its field's index (container -1: a
// union's case, at the union's own address)
record PathStep { container: s64, index: s64, }

module llvm {
    // the program's funcs as a module's bitcode (triple: its target, whose C calling convention calls the runtime)
    // (funcs: those the program's roots reach: gen.yel's opt.reachable; externs: the externs' yel
    // names by C name)
    module: func(generator: Gen, funcs: list<IrFunc>, triple: string, externs: map<string, string>, imports: map<string, string>) -> string {
        let compilation = bitcode.module-of(triple);
        let abi = calling.abi(triple);
        if abi == "" { diagnostics.fail("yelc --backend bitcode: no C calling convention for the target {triple} yet"); }
        let types: Types = { m: compilation, g: generator, abi: abi, imports: imports, extends: calling.extends-narrow(triple), };
        let made: Made = { singletons: map.new(), pure: map.new(), calling-pure: false, globals: map.new(), };
        let index: map<string, s64> = map.new();
        if generator.context.debug {
            bitcode.debug-info(compilation, "yelc");
            // (the compile unit's file: the first, main's)
            for function in funcs {
                if function.key == "main" && function.span.source >= 0 { let _ = bitcode.file-index(compilation, source-path(generator, function.span.source)); }
            }
        }
        // a func made only for another target (a helper's build: a native host's wrapper, a
        // component's): not this module's
        let wasm = abi == "wasm32";
        funcs = funcs.filter({ function -> function.build == "" || (function.build == "native") != wasm });
        for function in funcs {
            // a result given in memory: where it goes first (in-memory's); a closure's C function
            // takes its environment next (a func value's adapter: unused)
            let params: list<s64> = [];
            let result-in-memory = !function.async && in-memory(types, function, function.result);
            if result-in-memory { params.push(bitcode.pointer-type(compilation)); }
            if function.closure { params.push(bitcode.pointer-type(compilation)); }
            // (a () param passes nothing, as a call gives it)
            for parameter in function.params {
                if gives-value(function.locals[parameter].ty) { params.push(param-type(types, function, function.locals[parameter].ty)); }
            }
            if function.async {
                // an async func (a generator too): its step (its frame given: done 1, or waiting 0),
                // and its start (its frame made, its arguments in it)
                let pointer = bitcode.pointer-type(compilation);
                index.set(function.c-name, bitcode.add-func(compilation, function.c-name, bitcode.func-type(compilation, bitcode.int-type(compilation, 32), [pointer,]), 1, true, true));
                index.set(start-name(function), bitcode.add-func(compilation, start-name(function), bitcode.func-type(compilation, pointer, params), params.len(), true, true));
                described(types, function, index[function.c-name]);
                described(types, function, index[start-name(function)]);
                continue;
            }
            // a component's export: the host's to call (by its name, on wasm)
            let result = if result-in-memory { bitcode.void-type(compilation) } else { result-type(types, function, function.result) };
            let at = bitcode.add-func(compilation, function.c-name, bitcode.func-type(compilation, result, params), params.len(), true, function.export-name == "");
            if function.export-name != "" && wasm {
                bitcode.set-attributes(compilation, at, [{ index: -1, attributes: bitcode.string-attribute("wasm-export-name", function.export-name), },]);
            }
            index.set(function.c-name, at);
            described(types, function, at);
        }
        for function in funcs {
            lower-func(types, made, function, index, externs);
            if function.async { task-start(types, made, function, index, externs); }
        }
        main-entry(types, funcs, index, triple);
        // none of it unwinds (yel has no exceptions, the runtime's C none either); a C function
        // only ever called pure touches no memory and returns (so a call of it may be merged,
        // moved out of a loop, or dropped when its value is not used)
        // (built for size, --opt size: each func the program defines says so, optsize and minsize,
        // as clang's -Oz marks a C function: what LLVM inlines and unrolls by)
        let small = generator.context.mode == "size";
        for at in 0..compilation.funcs.len() {
            bitcode.add-function-attributes(compilation, at, bitcode.nounwind());
            if small && compilation.funcs[at].defined { bitcode.add-function-attributes(compilation, at, bitcode.small()); }
            if !compilation.funcs[at].defined && made.pure.get-or(compilation.funcs[at].name, false) {
                bitcode.add-function-attributes(compilation, at, concat(concat(bitcode.memory-none(), bitcode.nofree()), concat(bitcode.nosync(), bitcode.willreturn())));
            }
        }
        bitcode.write(compilation)
    }

    // ---- types

    // a string: a ystr's { i64 len, ptr data }
    string-type: func(compilation: BcModule) -> s64 { bitcode.struct-type(compilation, [bitcode.int-type(compilation, 64), bitcode.pointer-type(compilation),]) }

    is-string: func(given: Type) -> bool {
        match resolve(given) {
            string-type => true,
            _ => false,
        }
    }

    // a func's result type: () and never void
    result-type: func(ty: Types, function: IrFunc, given: Type) -> s64 {
        if gives-value(given) { value-type(ty, function, given) } else { bitcode.void-type(ty.m) }
    }

    // whether a value of t is one (not a () nor a never)
    gives-value: func(given: Type) -> bool { !is-unit(given) && !is-never(given) }

    is-unit: func(given: Type) -> bool {
        match resolve(given) {
            unit-type => true,
            _ => false,
        }
    }

    // a number's bits (an f32's 32)
    int-bits: func(name: string) -> s64 {
        if name == "s8" || name == "u8" { return 8; }
        if name == "s16" || name == "u16" { return 16; }
        if name == "s32" || name == "u32" || name == "f32" { return 32; }
        64
    }

    is-float: func(t0: Type) -> bool {
        match resolve(t0) {
            num(name) => name == "f32" || name == "f64",
            range-type(range) => is-float(range.base),
            singleton(single) => is-float(single.base),
            _ => false,
        }
    }

    // a value's bits in its type (1 for a bool, 32 for a char)
    bits: func(t0: Type) -> s64 {
        match resolve(t0) {
            num(name) => int-bits(name),
            bool-type => 1,
            char-type => 32,
            range-type(range) => bits(range.base),
            singleton(single) => bits(single.base),
            _ => 64,
        }
    }

    signed: func(t0: Type) -> bool {
        match resolve(t0) {
            num(name) => name.byte-at(0) == 115,
            range-type(range) => signed(range.base),
            singleton(single) => signed(single.base),
            _ => false,
        }
    }

    // a value's alignment in a local's slot, as an alloca's, a load's or a store's record has it
    align: func(lowering: Lower, given: Type) -> u64 { align-code(size-align(lowering.types, lowering.ir, given)[1]) }

    // ---- funcs

    new-lower: func(types: Types, made: Made, function: BcFunc, ir: IrFunc, index: map<string, s64>, externs: map<string, string>) -> Lower {
        {
            m: types.m, types: types, made: made, f: function, ir: ir, block: 0, slots: [], labels: [], continues: [], breaks: [],
            index: index, externs: externs, abi: types.abi,
            stack-objects: map.new(), framed: false, frame: BcValue.constant(0), roots: BcValue.constant(0), root-count: 0,
            root-at: [], root-paths: [], given: none, task: BcValue.param(0), task-type: 0, resumes: map.new(),
            result-memory: none,
        }
    }

    // a func of source's debug info (yelc -g): its subprogram, on the line it is declared on, in
    // its file (absolute: what a debugger finds it by); its instructions' first location there
    described: func(types: Types, ir: IrFunc, at: s64) {
        let compilation = types.m;
        if !compilation.debug || ir.span.source < 0 || ir.span.line <= 0 { return; }
        let function = compilation.funcs[at];
        function.subprogram = some({
            name: base-name(ir.key),
            linkage: function.name,
            file: bitcode.file-index(compilation, source-path(types.g, ir.span.source)),
            line: ir.span.line,
        });
        function.line = ir.span.line;
        function.col = ir.span.col;
    }

    // each named local's debug info (yelc -g): its variable, declared at its slot, where its
    // binding is written (else where the func is), a parameter's number among the params
    declare-locals: func(lowering: Lower) {
        let ir = lowering.ir;
        match lowering.f.subprogram {
            some(_) => {}
            none => { return; }
        }
        for position in 0..ir.locals.len() {
            let local = ir.locals[position];
            if local.name == "" { continue; }
            let slot = match lowering.slots[position] {
                some(at) => at,
                none => { continue; }
            };
            let line = ir.span.line;
            let col = ir.span.col;
            match local.binding {
                some(mark) => {
                    if mark.span.source == ir.span.source && mark.span.line > 0 {
                        line = mark.span.line;
                        col = mark.span.col;
                    }
                }
                none => {}
            }
            lowering.f.variables.push({
                name: local.name,
                line: line,
                col: col,
                arg: ir.params.index-of(position) + 1,
                ty: debug-type(lowering.types, ir, local.ty),
                slot: slot,
            });
        }
    }

    // a value's debug type (an index into the module's), as its slot holds it: a number, a bool,
    // a char as DWARF's base types; a string's { len, data }; a record's or a variant's object
    // behind its pointer (its fields; a variant's tag); a tuple's, an anonymous record's, an
    // option's or a result's fields; a list, a map, a stream as a pointer; anything else a struct
    // of its size, by its name. Each made once, by how its type shows
    debug-type: func(ty: Types, function: IrFunc, t0: Type) -> s64 {
        let compilation = ty.m;
        let resolved = resolve(t0);
        let key = show-type(resolved);
        match compilation.debug-type-keys.get(key) {
            some(index) => { return index; }
            none => {}
        }
        if needs-representing(resolved) {
            // a record (a value): held as the anonymous record of its fields, named as declared
            let shown = represented(resolved);
            match (resolved, shown) {
                (named(name), anon-record(anonymous)) => {
                    let made = debug-struct(ty, function, base-name(name-text(name)), anonymous.fields, anonymous.types);
                    compilation.debug-type-keys.set(key, made);
                    return made;
                }
                _ => { return debug-type(ty, function, shown); }
            }
        }
        let pointer-bits = calling.pointer-bytes(ty.abi) * 8;
        let bits = size-align(ty, function, resolved)[0] * 8;
        // DWARF's encodings: boolean 2, float 4, signed 5, unsigned 7, unsigned char 8, UTF 16
        let made = match resolved {
            num(name) => bitcode.debug-type(compilation, 0, name, bits, if name == "f32" || name == "f64" { 4 } else if signed(resolved) { 5 } else { 7 }, -1, 0, []),
            bool-type => bitcode.debug-type(compilation, 0, "bool", 8, 2, -1, 0, []),
            char-type => bitcode.debug-type(compilation, 0, "char", 32, 16, -1, 0, []),
            string-type => {
                let len = debug-type(ty, function, Type.num("s64"));
                let byte = bitcode.debug-type(compilation, 0, "u8", 8, 8, -1, 0, []);
                let data = bitcode.debug-type(compilation, 1, "", pointer-bits, 0, byte, 0, []);
                let members = [
                    bitcode.debug-type(compilation, 2, "len", 64, 0, len, 0, []),
                    bitcode.debug-type(compilation, 2, "data", pointer-bits, 0, data, 64, []),
                ];
                bitcode.debug-type(compilation, 3, "string", 64 + pointer-bits, 0, -1, 0, members)
            }
            named(name) => {
                let kind = gen.named-kind(ty.g, name);
                // a variant held by value: its struct (its tag shown)
                if kind == "variant" && gen.value-variant(ty.g, name) {
                    let tag = bitcode.debug-type(compilation, 2, "tag", 32, 0, debug-type(ty, function, Type.num("u32")), 0, []);
                    let made = bitcode.debug-type(compilation, 3, base-name(name-text(name)), bits, 0, -1, 0, [tag,]);
                    compilation.debug-type-keys.set(key, made);
                    return made;
                }
                if kind == "record" || kind == "variant" {
                    // (the pointer made first, and known by its key: a field may point at it)
                    let pointer = bitcode.debug-type(compilation, 1, "", pointer-bits, 0, -1, 0, []);
                    compilation.debug-type-keys.set(key, pointer);
                    let object = if kind == "record" {
                        let declaration = ty.g.symbols.records[name];
                        debug-struct(ty, function, base-name(name-text(name)), declaration.fields, declaration.field-types)
                    } else {
                        let tag = bitcode.debug-type(compilation, 2, "tag", 32, 0, debug-type(ty, function, Type.num("u32")), 0, []);
                        bitcode.debug-type(compilation, 3, base-name(name-text(name)), object-layout(ty, function, name)[0] * 8, 0, -1, 0, [tag,])
                    };
                    compilation.debug-types[pointer].base = object;
                    return pointer;
                }
                bitcode.debug-type(compilation, 0, base-name(name-text(name)), bits, 7, -1, 0, [])
            }
            tuple-type(xs) => {
                let names: list<string> = [];
                for index in 0..xs.len() { names.push("{index}"); }
                debug-struct(ty, function, key, names, xs)
            }
            // (a record held by value: the anonymous record of its fields, named as declared)
            anon-record(anonymous) => debug-struct(ty, function, if anonymous.name != "" { base-name(anonymous.name) } else { key }, anonymous.fields, anonymous.types),
            option-type(contained) => debug-struct(ty, function, key, ["some", "value",], [Type.bool-type, contained,]),
            result-type(outcome) => debug-struct(ty, function, key, ["ok", "value", "error",], [Type.bool-type, outcome.ok, outcome.err,]),
            list-type(_) => debug-opaque(ty, key, pointer-bits),
            map-type(_) => debug-opaque(ty, key, pointer-bits),
            buffer-type => debug-opaque(ty, key, pointer-bits),
            stream-type(_) => debug-opaque(ty, key, pointer-bits),
            future-type(_) => debug-opaque(ty, key, pointer-bits),
            seq-type(_) => debug-opaque(ty, key, pointer-bits),
            _ => bitcode.debug-type(compilation, 3, key, bits, 0, -1, 0, []),
        };
        compilation.debug-type-keys.set(key, made);
        made
    }

    // a struct of fields (their names and types), laid out as the module's struct of them is
    debug-struct: func(ty: Types, function: IrFunc, name: string, names: list<string>, types: list<Type>) -> s64 {
        let members: list<s64> = [];
        let offset = 0;
        let align = 1;
        for index in 0..names.len() {
            let layout = size-align(ty, function, types[index]);
            offset = round-up(offset, layout[1]);
            let base = debug-type(ty, function, types[index]);
            members.push(bitcode.debug-type(ty.m, 2, names[index], layout[0] * 8, 0, base, offset * 8, []));
            offset += layout[0];
            if layout[1] > align { align = layout[1]; }
        }
        bitcode.debug-type(ty.m, 3, name, round-up(offset, align) * 8, 0, -1, 0, members)
    }

    // a pointer to what DWARF is not told the inside of (a list's, a map's), by its type's name
    debug-opaque: func(ty: Types, name: string, pointer-bits: s64) -> s64 {
        let object = bitcode.debug-type(ty.m, 3, name, 0, 0, -1, 0, []);
        bitcode.debug-type(ty.m, 1, "", pointer-bits, 0, object, 0, [])
    }

    // a source's path, absolute (what a debugger finds it by, from anywhere)
    source-path: func(generator: Gen, source: s64) -> string {
        let path = generator.context.sources[source].path;
        if path.starts-with("/") { path } else { "{environment.get-initial-cwd().unwrap-or(".")}/{path}" }
    }

    // where the instructions made next come from: n's place, where it has one in the func's own
    // file (one inlined from another file's: the place before it)
    locate: func(lowering: Lower, node: Node) {
        if node.span.line > 0 && node.span.source == lowering.ir.span.source {
            lowering.f.line = node.span.line;
            lowering.f.col = node.span.col;
        }
    }

    lower-func: func(types: Types, made: Made, ir: IrFunc, index: map<string, s64>, externs: map<string, string>) {
        let compilation = types.m;
        let function = compilation.funcs[index[ir.c-name]];
        let lowering = new-lower(types, made, function, ir, index, externs);
        if ir.async {
            task-step(lowering);
            return;
        }
        // the params given in memory it never writes: read where the caller has them (their slot
        // the param itself), never copied; by local, the param
        let first = if in-memory(types, ir, ir.result) { 1 } else { 0 };
        let given: map<s64, s64> = map.new();
        let written = written-locals(ir);
        let at = if ir.closure { first + 1 } else { first };
        for position in 0..ir.params.len() {
            let local = ir.params[position];
            if gives-value(ir.locals[local].ty) {
                if in-memory(types, ir, ir.locals[local].ty) && !written.has(local) { given.set(local, at); }
                at += 1;
            }
        }
        // each local's slot, in the entry block, zeroed (as C's = { 0 }); one in memory not (it is
        // written before it is read, and its zeroing stays where its slot is given to a call: a
        // store for each field)
        let i32 = bitcode.int-type(compilation, 32);
        let one = bitcode.integer(function, i32, 1);
        for index in 0..ir.locals.len() {
            let local = ir.locals[index];
            if !gives-value(local.ty) {
                lowering.slots.push(none);
            } else if given.has(index) {
                lowering.slots.push(some(BcValue.param(given[index])));
            } else {
                let ty = value-type(types, ir, local.ty);
                let slot = must(bitcode.add-inst(function, 0, 19, [
                    BcOperand.raw(ty as u64),
                    BcOperand.raw(i32 as u64),
                    BcOperand.absolute(one),
                    BcOperand.raw(align(lowering, local.ty) | 64),
                ], true));
                if !in-memory(types, ir, local.ty) { store(lowering, slot, bitcode.null(function, ty), local.ty); }
                lowering.slots.push(some(slot));
            }
        }
        declare-locals(lowering);
        // the collector's roots (its frame pushed), then each param's value stored in its slot
        // (and its pointers in their roots)
        frame-start(lowering);
        // (a result given in memory: where it goes, the first param)
        if first == 1 { lowering.result-memory = some(BcValue.param(0)); }
        at = if ir.closure { first + 1 } else { first };
        // a closure's environment (its param after that), in its local
        if ir.env-param >= 0 {
            match lowering.slots[ir.env-param] {
                some(slot) => store(lowering, slot, BcValue.param(first), ir.locals[ir.env-param].ty),
                none => {}
            }
            root(lowering, ir.env-param);
        }
        // each param in its slot: one given in memory copied from there
        for position in 0..ir.params.len() {
            let ty = ir.locals[ir.params[position]].ty;
            match lowering.slots[ir.params[position]] {
                some(slot) => {
                    if given.has(ir.params[position]) {} else if in-memory(types, ir, ty) { copy(lowering, slot, BcValue.param(at), ty, false); } else { store(lowering, slot, BcValue.param(at), ty); }
                    at += 1;
                }
                none => {}
            }
            root(lowering, ir.params[position]);
        }
        // the body from block 1 (the entry block takes the allocas made on the way: a call's
        // scratch memory), which the entry block goes to once it has them all
        lowering.block = bitcode.new-block(function);
        stmts(lowering, ir.body);
        // a body that gets to its end: a () func returns; another cannot get there
        if !bitcode.ended(function, lowering.block) {
            if is-unit(ir.result) {
                frame-end(lowering);
                inst(lowering, 10, [], false);
            } else {
                inst(lowering, 15, [], false);
            }
        }
        let _ = bitcode.add-inst(function, 0, 11, [BcOperand.raw(1),], false);
    }

    // C's main (wasi-libc's start calls __main_argc_argv for one taking them): the runtime's start
    // (y_start), the program's main, the runtime's end with its value (y_finish), as the C backend's
    main-entry: func(types: Types, funcs: list<IrFunc>, index: map<string, s64>, triple: string) {
        let compilation = types.m;
        let main-ir = funcs.filter({ function -> function.key == "main" });
        // a component of exports only (a reactor): no main
        if main-ir.len() == 0 && funcs.any({ function -> function.export-name != "" }) { return; }
        if main-ir.len() == 0 { diagnostics.fail("yelc --backend bitcode: the program has no main"); }
        let ir = main-ir[0];
        let i32 = bitcode.int-type(compilation, 32);
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        let name = if triple.contains("wasm") { "__main_argc_argv" } else { "main" };
        let at = bitcode.add-func(compilation, name, bitcode.func-type(compilation, i32, [i32, pointer,]), 2, true, false);
        let function = compilation.funcs[at];
        let start = bitcode.declared(compilation, "y_start", bitcode.func-type(compilation, pointer, [i32, pointer,]), 2);
        let finish = bitcode.declared(compilation, "y_finish", bitcode.func-type(compilation, i32, [i64,]), 1);
        let call = { callee: s64, args: list<BcValue>, gives: bool ->
            let operands: list<BcOperand> = [
                BcOperand.raw(0),
                BcOperand.raw(1 << 15),
                BcOperand.raw(compilation.funcs[callee].ty as u64),
                BcOperand.value(BcValue.function(callee)),
            ];
            for argument in args { operands.push(BcOperand.value(argument)); }
            bitcode.add-inst(function, 0, 34, operands, gives)
        };
        // the arguments (a list<string>), for a main that takes them
        let arguments = must(call(start, [BcValue.param(0), BcValue.param(1),], true));
        // the program's globals made, before its first code (gen.globals-helpers)
        if index.has("y_globals_init") {
            let globals = bitcode.declared(compilation, "y_globals", bitcode.func-type(compilation, bitcode.void-type(compilation), [pointer, pointer,]), 2);
            let _ = call(globals, [BcValue.function(index["y_globals_init"]), BcValue.function(index["y_globals_mark"]),], false);
        }
        let given: list<BcValue> = if ir.params.len() > 0 { [arguments,] } else { [] };
        // an async main: its task, the executor's root (std's async.run-tasks), as the C main's
        if ir.async {
            let task = must(call(index[start-name(ir)], given, true));
            let _ = call(index[types.g.funcs["yel:std/async.run-tasks"].c-name], [task,], false);
            // its result, from its frame (field 1), the exit status: read before anything
            // allocates again, so no collection lets the done task go first (as the C backend's)
            let status = if is-unit(ir.result) {
                bitcode.integer(function, i64, 0)
            } else {
                let frame = task-frame(types, ir);
                let field = must(bitcode.add-inst(function, 0, 43, [
                    BcOperand.raw(1),
                    BcOperand.raw(frame as u64),
                    BcOperand.value(task),
                    BcOperand.value(bitcode.integer(function, i32, 0)),
                    BcOperand.value(bitcode.integer(function, i32, 1)),
                ], true));
                let value = must(bitcode.add-inst(function, 0, 20, [
                    BcOperand.value(field),
                    BcOperand.raw(value-type(types, ir, ir.result) as u64),
                    BcOperand.raw(align-code(size-align(types, ir, ir.result)[1])),
                    BcOperand.raw(0),
                ], true));
                if bits(ir.result) == 64 { value } else {
                    must(bitcode.add-inst(function, 0, 3, [
                        BcOperand.value(value),
                        BcOperand.raw(i64 as u64),
                        BcOperand.raw(if signed(ir.result) { 2 } else { 1 }),
                    ], true))
                }
            };
            let done = must(call(finish, [status,], true));
            let _ = bitcode.add-inst(function, 0, 10, [BcOperand.value(done),], false);
            return;
        }
        let result = call(index[ir.c-name], given, !is-unit(ir.result));
        let code = match result {
            some(returned) => {
                let width = bits(ir.result);
                if width == 64 { returned }
                else { must(bitcode.add-inst(function, 0, 3, [BcOperand.value(returned), BcOperand.raw(i64 as u64), BcOperand.raw(if signed(ir.result) { 2 } else { 1 }),], true)) }
            }
            none => bitcode.integer(function, i64, 0),
        };
        let status = must(call(finish, [code,], true));
        let _ = bitcode.add-inst(function, 0, 10, [BcOperand.value(status),], false);
    }

    // ---- statements

    // a body, cut at its first terminator (what follows never runs, and may be codegen's
    // placeholder: a () assigned to an arm's value after its return), as render.yel's render-stmts
    stmts: func(lowering: Lower, body: list<Node>) {
        for node in body {
            stmt(lowering, node);
            let ends = match node.kind {
                return(_) => true,
                break(_) => true,
                continue(_) => true,
                unreachable(_) => true,
                halt => true,
                _ => false,
            };
            if ends { return; }
        }
    }

    // a statement lowered, its instructions at its place (and its parts' at theirs)
    stmt: func(lowering: Lower, node: Node) {
        let line = lowering.f.line;
        let col = lowering.f.col;
        locate(lowering, node);
        stmt-kind(lowering, node);
        lowering.f.line = line;
        lowering.f.col = col;
    }

    stmt-kind: func(lowering: Lower, node: Node) {
        match node.kind {
            assign(assigned) => {
                // a value in memory: moved into the local's slot
                match lowering.slots[assigned.dest] {
                    some(slot) => if in-memory(lowering.types, lowering.ir, assigned.value.ty) {
                        moved(lowering, slot, assigned.value, lowering.ir.locals[assigned.dest].ty, false);
                        root(lowering, assigned.dest);
                        return;
                    },
                    none => {}
                }
                let computed = match assigned.value.kind {
                    alloc(allocated) => some(alloc-object(lowering, assigned.dest, allocated)),
                    interp(interpolation) => some(interpolated(lowering, interpolation)),
                    _ => value(lowering, assigned.value),
                };
                match lowering.slots[assigned.dest] {
                    some(slot) => store(lowering, slot, must(computed), lowering.ir.locals[assigned.dest].ty),
                    none => {}
                }
                root(lowering, assigned.dest);
            }
            store(stored) => field-store(lowering, stored),
            if(conditional) => {
                let test = must(value(lowering, conditional.test));
                let yes = bitcode.new-block(lowering.f);
                let no = bitcode.new-block(lowering.f);
                let after = bitcode.new-block(lowering.f);
                branch(lowering, test, yes, no);
                lowering.block = yes;
                stmts(lowering, conditional.yes);
                jump(lowering, after);
                lowering.block = no;
                stmts(lowering, conditional.no);
                jump(lowering, after);
                lowering.block = after;
            }
            loop(looping) => {
                // head: the test (none: always); body; step (where continue goes); after
                let head = bitcode.new-block(lowering.f);
                let body = bitcode.new-block(lowering.f);
                let step = bitcode.new-block(lowering.f);
                let after = bitcode.new-block(lowering.f);
                jump(lowering, head);
                lowering.block = head;
                match looping.test {
                    some(condition) => branch(lowering, must(value(lowering, condition)), body, after),
                    none => jump(lowering, body),
                }
                lowering.block = body;
                lowering.labels.push(looping.label);
                lowering.continues.push(step);
                lowering.breaks.push(after);
                stmts(lowering, looping.body);
                lowering.labels.pop();
                lowering.continues.pop();
                lowering.breaks.pop();
                jump(lowering, step);
                lowering.block = step;
                match looping.step {
                    some(expression) => { let _ = value(lowering, expression); }
                    none => {}
                }
                jump(lowering, head);
                lowering.block = after;
            }
            block(labeled) => {
                let after = bitcode.new-block(lowering.f);
                lowering.labels.push(labeled.label);
                lowering.continues.push(-1);
                lowering.breaks.push(after);
                stmts(lowering, labeled.body);
                lowering.labels.pop();
                lowering.continues.pop();
                lowering.breaks.pop();
                jump(lowering, after);
                lowering.block = after;
            }
            break(label) => {
                jump(lowering, lowering.breaks[target(lowering, label, false)]);
                lowering.block = bitcode.new-block(lowering.f);
            }
            continue(label) => {
                jump(lowering, lowering.continues[target(lowering, label, true)]);
                lowering.block = bitcode.new-block(lowering.f);
            }
            return(returned) => {
                if lowering.ir.async {
                    task-done(lowering, returned);
                    lowering.block = bitcode.new-block(lowering.f);
                    return;
                }
                if is-unit(lowering.ir.result) {
                    let _ = value(lowering, returned);
                    frame-end(lowering);
                    inst(lowering, 10, [], false);
                } else if lowering.result-memory != none {
                    moved(lowering, must(lowering.result-memory), returned, lowering.ir.result, true);
                    frame-end(lowering);
                    inst(lowering, 10, [], false);
                } else {
                    let result = must(value(lowering, returned));
                    frame-end(lowering);
                    inst(lowering, 10, [BcOperand.value(result),], false);
                }
                lowering.block = bitcode.new-block(lowering.f);
            }
            // a match no arm fits (the C backend's shows the value: here, only that it fits none)
            // a match no arm fits: the program stops, showing the value (as the C backend's)
            unreachable(unmatched) => {
                let shown = interpolated(lowering, { parts: [unmatched.value,], formatters: [unmatched.formatter,], });
                let _ = c-call(lowering, "yel_no_match", [shown,], [Type.string-type,], Type.never-type);
                inst(lowering, 15, [], false);
                lowering.block = bitcode.new-block(lowering.f);
            }
            call(_) => { let _ = value(lowering, node); }
            // an async func's: where a wait goes on (its state's block), its leaving (that state
            // kept), a generator's value given
            resume(state) => {
                let block = bitcode.new-block(lowering.f);
                jump(lowering, block);
                lowering.block = block;
                lowering.resumes.set(state, block);
            }
            suspend(state) => {
                store-as(lowering, header-field(lowering, 1), bitcode.integer(lowering.f, bitcode.int-type(lowering.m, 32), state as u64), 3);
                inst(lowering, 10, [BcOperand.value(bitcode.integer(lowering.f, bitcode.int-type(lowering.m, 32), 0)),], false);
                lowering.block = bitcode.new-block(lowering.f);
            }
            yield(yielded) => {
                match value(lowering, yielded) {
                    some(given) => store-as(lowering, task-field(lowering, 1), given, align(lowering, lowering.ir.result)),
                    none => {}
                }
            }
            // after a call that never returns
            halt => {
                inst(lowering, 15, [], false);
                lowering.block = bitcode.new-block(lowering.f);
            }
            const(_) => {}
            local(_) => {}
            _ => unsupported(lowering.ir, "a statement ({kind-name(node)})"),
        }
    }

    // the loop or block a break or continue leaves (label -1: the innermost loop): its place in the
    // stacks
    target: func(lowering: Lower, label: s64, looping: bool) -> s64 {
        for step in 0..lowering.labels.len() {
            let at = lowering.labels.len() - 1 - step;
            let is-loop = lowering.continues[at] >= 0;
            if label < 0 && is-loop { return at; }
            if label >= 0 && lowering.labels[at] == label && (is-loop || !looping) { return at; }
        }
        unsupported(lowering.ir, "a break or continue with nothing to leave")
    }

    // ---- values

    // n's value (none: a () one), its instructions at its place (what uses it after: at its own)
    value: func(lowering: Lower, node: Node) -> option<BcValue> {
        let line = lowering.f.line;
        let col = lowering.f.col;
        locate(lowering, node);
        let made = value-kind(lowering, node);
        lowering.f.line = line;
        lowering.f.col = col;
        made
    }

    value-kind: func(lowering: Lower, node: Node) -> option<BcValue> {
        match node.kind {
            const(constant) => {
                if is-unit(node.ty) { return none; }
                let ty = value-type(lowering.types, lowering.ir, node.ty);
                match constant {
                    int(integer) => some(bitcode.integer(lowering.f, ty, integer)),
                    float(number) => some(if bits(node.ty) == 32 { bitcode.float(lowering.f, ty, f32-bits(number as f32)) } else { bitcode.float(lowering.f, ty, f64-bits(number)) }),
                    bool(flag) => some(bitcode.integer(lowering.f, ty, if flag { 1 } else { 0 })),
                    unit => none,
                    text(literal) => some(string-literal(lowering, literal)),
                    case-value(selected) => some(singleton-value(lowering, selected)),
                    // NULL, a value struct of zeros
                    null => some(bitcode.null(lowering.f, ty)),
                    zero => some(bitcode.null(lowering.f, ty)),
                }
            }
            scan(scanned) => some(scan-value(lowering, scanned)),
            static-list(static) => some(BcValue.global(if static.flat { static-items-global(lowering, static) } else { static-list-global(lowering, static) })),
            descriptor(described) => some(BcValue.global(descriptor-global(lowering, described.ty))),
            load(loaded) => field-load(lowering, node, loaded),
            make(making) => some(make-value(lowering, node, making)),
            list-get(indexed) => list-item(lowering, node, indexed),
            local(variable) => match lowering.slots[variable] {
                some(slot) => some(load(lowering, slot, lowering.ir.locals[variable].ty)),
                none => none,
            },
            // a runtime helper's (key ""), or one of the module's: the program's, gen's helpers
            call(called) => if called.key == "" && !lowering.index.has(called.c-name) { helper(lowering, node, called) } else { call(lowering, node, called, none) },
            deref(pointer) => {
                if is-unit(node.ty) { return none; }
                some(load-as(lowering, must(value(lowering, pointer)), field-type(lowering.types, lowering.ir, node.ty), align(lowering, node.ty)))
            }
            global(symbol) => {
                if is-unit(node.ty) { return none; }
                some(load-as(lowering, global-address(lowering, symbol, node.ty), field-type(lowering.types, lowering.ir, node.ty), align(lowering, node.ty)))
            }
            address-of(target) => some(place-address(lowering, target)),
            size-of(sized) => some(bitcode.integer(lowering.f, value-type(lowering.types, lowering.ir, Type.num("usize")), size-align(lowering.types, lowering.ir, sized)[0] as u64)),
            element(member) => {
                let base = must(value(lowering, member.base));
                let index = convert(lowering, must(value(lowering, member.index)), member.index.ty, Type.num("s64"));
                some(item-address(lowering, base, field-type(lowering.types, lowering.ir, member.item), index))
            }
            bin(operation) => {
                if operation.op == "&&" || operation.op == "||" { return some(short-circuit(lowering, operation)); }
                some(binary(lowering, operation.op, must(value(lowering, operation.a)), must(value(lowering, operation.b)), operation.a.ty))
            }
            un(unary) => {
                let operand = must(value(lowering, unary.a));
                let ty = value-type(lowering.types, lowering.ir, node.ty);
                if unary.op == "!" { return some(binop(lowering, 12, operand, bitcode.integer(lowering.f, ty, 1))); }
                if unary.op == "~" { return some(binop(lowering, 12, operand, bitcode.integer(lowering.f, ty, 18446744073709551615))); }
                // fneg (UNOP 0)
                if unary.op == "-" && is-float(node.ty) { return inst(lowering, 56, [BcOperand.value(operand), BcOperand.raw(0),], true); }
                if unary.op == "-" { return some(binop(lowering, 1, bitcode.integer(lowering.f, ty, 0), operand)); }
                unsupported(lowering.ir, "the operator {unary.op}")
            }
            convert(converted) => some(convert(lowering, must(value(lowering, converted)), converted.ty, node.ty)),
            func-ref(function-reference) => some(func-value(lowering, function-reference)),
            call-ref(call-reference) => call-ref(lowering, node, call-reference, none),
            // a loop's step (i += 1): done, giving nothing
            assign(_) => {
                stmt(lowering, node);
                none
            }
            _ => {
                unsupported(lowering.ir, "a value ({kind-name(node)})")
            }
        }
    }

    // a call of one of the program's funcs; a result given in memory written into (none: memory
    // of its own, read back)
    call: func(lowering: Lower, node: Node, called: CallNode, into: option<BcValue>) -> option<BcValue> {
        let name = called.c-name;
        if !lowering.index.has(name) { unsupported(lowering.ir, "a call of {called.c-name} (not in the module)"); }
        let callee = lowering.index[name];
        let operands: list<BcOperand> = [
            BcOperand.raw(0),
            BcOperand.raw(1 << 15),
            BcOperand.raw(lowering.m.funcs[callee].ty as u64),
            BcOperand.value(BcValue.function(callee)),
        ];
        let memory = result-memory(lowering, node.ty, into);
        match memory {
            some(at) => operands.push(BcOperand.value(at)),
            none => {}
        }
        for operand in called.args {
            match argument(lowering, operand) {
                some(evaluated) => operands.push(BcOperand.value(evaluated)),
                none => {}
            }
        }
        let made = inst(lowering, 34, operands, gives-value(node.ty) && memory == none);
        read-back(lowering, node.ty, memory, into, made)
    }

    // ---- values in memory: one bigger than a string crosses a call of the program's funcs as C's
    // bigger structs do, a param as a pointer to it (the callee copies it into its slot first),
    // a result written where a hidden first param says (sret). Moved by memcpy, not field by
    // field: a record of strings is two dozen loads and stores each time otherwise, and a call
    // may write straight into the local it is assigned to

    in-memory: func(ty: Types, function: IrFunc, given: Type) -> bool { gives-value(given) && size-align(ty, function, given)[0] > 16 }

    // the locals a func writes: assigns, stores into them, their address taken
    written-locals: func(ir: IrFunc) -> map<s64, bool> {
        let out: map<s64, bool> = map.new();
        for node in flatten(ir.body) { writes(node, out); }
        out
    }

    writes: func(node: Node, out: map<s64, bool>) {
        let held: list<s64> = [];
        match node.kind {
            assign(assigned) => out.set(assigned.dest, true),
            store(stored) => reads(stored.target, held),
            address-of(target) => reads(target, held),
            _ => {}
        }
        for local in held { out.set(local, true); }
        for index in 0..operand-count(node) { writes(operand(node, index), out); }
    }

    // a param's type as the program's funcs take it
    param-type: func(ty: Types, function: IrFunc, given: Type) -> s64 { if in-memory(ty, function, given) { bitcode.pointer-type(ty.m) } else { value-type(ty, function, given) } }

    // a value of t copied from one place to another (C's memcpy, which LLVM knows; memmove where
    // they may overlap)
    copy: func(lowering: Lower, to: BcValue, from: BcValue, given: Type, overlap: bool) {
        let compilation = lowering.m;
        let pointer = bitcode.pointer-type(compilation);
        let size-type = bitcode.int-type(compilation, calling.pointer-bytes(lowering.abi) * 8);
        let size = bitcode.integer(lowering.f, size-type, size-align(lowering.types, lowering.ir, given)[0] as u64);
        let _ = c-function(lowering, if overlap { "memmove" } else { "memcpy" }, pointer, [pointer, pointer, size-type,], [to, from, size,]);
    }

    // an argument as the program's funcs take it: a value in memory by a pointer to it (a local's
    // own slot: the callee copies it before anything else), any other as itself (none: a ())
    argument: func(lowering: Lower, node: Node) -> option<BcValue> {
        if !in-memory(lowering.types, lowering.ir, node.ty) { return value(lowering, node); }
        match node.kind {
            local(variable) => match lowering.slots[variable] {
                some(slot) => { return some(slot); }
                none => {}
            },
            _ => {}
        }
        // (a call's in memory of its own; another a copy: what is in memory elsewhere may change
        // while the callee reads it)
        match called-into(lowering, node) {
            some(memory) => { return some(memory); }
            none => {}
        }
        let memory = scratch-of(lowering, value-type(lowering.types, lowering.ir, node.ty), size-align(lowering.types, lowering.ir, node.ty)[1]);
        moved(lowering, memory, node, node.ty, true);
        some(memory)
    }

    // where a call's result of t goes, given in memory: into, or memory of its own (none: given
    // as itself)
    result-memory: func(lowering: Lower, given: Type, into: option<BcValue>) -> option<BcValue> {
        if !in-memory(lowering.types, lowering.ir, given) { return none; }
        match into {
            some(at) => some(at),
            none => some(scratch-of(lowering, value-type(lowering.types, lowering.ir, given), size-align(lowering.types, lowering.ir, given)[1])),
        }
    }

    // a call's value: what it gave, or (in memory of its own) read from there
    read-back: func(lowering: Lower, given: Type, memory: option<BcValue>, into: option<BcValue>, made: option<BcValue>) -> option<BcValue> {
        match memory {
            some(at) => if into == none { some(load(lowering, at, given)) } else { none },
            none => made,
        }
    }

    // whether a node is a call of the program's funcs (one that writes a result in memory where
    // it is told)
    writes-memory: func(lowering: Lower, node: Node) -> bool {
        match node.kind {
            call(called) => !(called.key == "" && !lowering.index.has(called.c-name)),
            call-ref(_) => true,
            _ => false,
        }
    }

    // where a value already is in memory, read where it is (a local's slot, a field, an item, a
    // deref's, a global's; none: one computed)
    value-memory: func(lowering: Lower, node: Node) -> option<BcValue> {
        match node.kind {
            local(variable) => lowering.slots[variable],
            load(loaded) => field-memory(lowering, loaded, path-steps(lowering, loaded.base.ty, loaded.path, loaded.arrow)),
            deref(pointer) => value(lowering, pointer),
            list-get(indexed) => some(item-memory(lowering, indexed, node.ty)),
            global(symbol) => some(global-address(lowering, symbol, node.ty)),
            _ => none,
        }
    }

    // a call's value in memory of its own (none: v is not a call of the program's funcs)
    called-into: func(lowering: Lower, node: Node) -> option<BcValue> {
        if !writes-memory(lowering, node) { return none; }
        let memory = result-memory(lowering, node.ty, none);
        match node.kind {
            call(called) => { let _ = call(lowering, node, called, memory); }
            call-ref(call-reference) => { let _ = call-ref(lowering, node, call-reference, memory); }
            _ => {}
        }
        memory
    }

    // a value of t (v's) put at memory: a call's written there itself (own: memory nothing else
    // reads, a func's result) or copied from memory of its own (LLVM then has it write there
    // itself), one already in memory copied (memmove: a field of a local may be put in the local),
    // any other stored
    moved: func(lowering: Lower, memory: BcValue, node: Node, given: Type, own: bool) {
        if own {
            match node.kind {
                call(called) => if writes-memory(lowering, node) {
                    let _ = call(lowering, node, called, some(memory));
                    return;
                },
                call-ref(call-reference) => {
                    let _ = call-ref(lowering, node, call-reference, some(memory));
                    return;
                }
                _ => {}
            }
        }
        match called-into(lowering, node) {
            some(from) => {
                copy(lowering, memory, from, given, false);
                return;
            }
            none => {}
        }
        match value-memory(lowering, node) {
            some(from) => {
                copy(lowering, memory, from, given, true);
                return;
            }
            none => {}
        }
        store(lowering, memory, must(value(lowering, node)), given);
    }

    // a && b, a || b (a pattern's tests: the second may read what only the first makes sure is
    // there): b only where a does not decide, as C's
    short-circuit: func(lowering: Lower, binary: BinNode) -> BcValue {
        let i1 = bitcode.int-type(lowering.m, 1);
        let answer = scratch-of(lowering, i1, 1);
        let operand = must(value(lowering, binary.a));
        store-as(lowering, answer, operand, 1);
        let more = bitcode.new-block(lowering.f);
        let done = bitcode.new-block(lowering.f);
        if binary.op == "&&" { branch(lowering, operand, more, done); } else { branch(lowering, operand, done, more); }
        lowering.block = more;
        store-as(lowering, answer, must(value(lowering, binary.b)), 1);
        jump(lowering, done);
        lowering.block = done;
        load-as(lowering, answer, i1, 1)
    }

    // a core import's function (on wasm: the host's, by its module and name)
    core-import-func: func(lowering: Lower, imported: CoreImport) -> s64 {
        let compilation = lowering.m;
        let params: list<s64> = imported.params.map({ parameter -> value-type(lowering.types, lowering.ir, parameter) });
        let result = result-type(lowering.types, lowering.ir, imported.result);
        let at = bitcode.declared(compilation, imported.c-name, bitcode.func-type(compilation, result, params), params.len());
        bitcode.set-attributes(compilation, at, [{ index: -1, attributes: concat(bitcode.string-attribute("wasm-import-module", imported.module), bitcode.string-attribute("wasm-import-name", imported.name)), },]);
        at
    }

    // a call through a func value ({ fn, env }): its C function, given its environment first (after
    // where its result goes, given in memory: into, as call's)
    call-ref: func(lowering: Lower, node: Node, call-reference: CallRefNode, into: option<BcValue>) -> option<BcValue> {
        let compilation = lowering.m;
        let pointer = bitcode.pointer-type(compilation);
        let callee = must(value(lowering, call-reference.callee));
        let function = extract(lowering, callee, [0,]);
        let params: list<s64> = [];
        let args: list<BcValue> = [];
        let memory = result-memory(lowering, node.ty, into);
        match memory {
            some(at) => {
                params.push(pointer);
                args.push(at);
            }
            none => {}
        }
        params.push(pointer);
        args.push(extract(lowering, callee, [1,]));
        for operand in call-reference.args {
            match argument(lowering, operand) {
                some(evaluated) => {
                    params.push(param-type(lowering.types, lowering.ir, operand.ty));
                    args.push(evaluated);
                }
                none => {}
            }
        }
        let result = if memory != none { bitcode.void-type(compilation) } else { result-type(lowering.types, lowering.ir, node.ty) };
        let fn-ty = bitcode.func-type(compilation, result, params);
        let operands = [BcOperand.raw(0), BcOperand.raw(1 << 15), BcOperand.raw(fn-ty as u64), BcOperand.value(function),];
        for evaluated in args { operands.push(BcOperand.value(evaluated)); }
        let made = inst(lowering, 34, operands, gives-value(node.ty) && memory == none);
        read-back(lowering, node.ty, memory, into, made)
    }

    // a func as a value: its C function (a func value's adapter, a closure's body)
    func-value: func(lowering: Lower, function-reference: FuncRefNode) -> BcValue {
        if lowering.index.has(function-reference.c) { return BcValue.function(lowering.index[function-reference.c]); }
        if lowering.index.has(function-reference.c-name) { return BcValue.function(lowering.index[function-reference.c-name]); }
        // a core import (a stream's builtin, the host's), declared as its import says
        let generator = lowering.types.g;
        if generator.core-imports.has(function-reference.c-name) && lowering.abi == "wasm32" { return BcValue.function(core-import-func(lowering, generator.core-imports[function-reference.c-name])); }
        // the runtime's scan
        if function-reference.c-name.starts-with("y_scan_") {
            let compilation = lowering.m;
            return BcValue.function(bitcode.declared(compilation, function-reference.c-name, bitcode.func-type(compilation, bitcode.void-type(compilation), [bitcode.pointer-type(compilation),]), 1));
        }
        unsupported(lowering.ir, "the func {function-reference.c-name} as a value (not in the module)")
    }

    // a runtime helper the IR calls: an integer's arithmetic, yel's way; else a C function of the
    // runtime's (an extern whose C is a function's name, not a macro's text), called as C would
    helper: func(lowering: Lower, node: Node, called: CallNode) -> option<BcValue> {
        let name = called.c-name;
        let ops = ["add", "sub", "mul", "div", "mod", "shl", "shr", "neg",];
        for op in ops {
            if name.starts-with("y_{op}_") {
                let produced = node.ty;
                let left = must(value(lowering, called.args[0]));
                if op == "neg" { return some(binop(lowering, 1, bitcode.integer(lowering.f, value-type(lowering.types, lowering.ir, produced), 0), left)); }
                let right = must(value(lowering, called.args[1]));
                if op == "add" { return some(binop(lowering, 0, left, right)); }
                if op == "sub" { return some(binop(lowering, 1, left, right)); }
                if op == "mul" { return some(binop(lowering, 2, left, right)); }
                if op == "div" || op == "mod" { return some(divide(lowering, op == "div", left, right, produced)); }
                return some(shift(lowering, op == "shl", left, right, called.args[1].ty, produced));
            }
        }
        if name == "y_list_of" || name == "y_list_new" { return list-made(lowering, node, called); }
        // a list literal of constants: its static items copied (y_list_of_data(n, size, items, scan)),
        // or its static data, each list in it too (y_list_static(data, descriptor))
        if name == "y_list_of_data" {
            let i64 = bitcode.int-type(lowering.m, 64);
            let pointer = bitcode.pointer-type(lowering.m);
            let made = bitcode.declared(lowering.m, name, bitcode.func-type(lowering.m, pointer, [i64, i64, pointer, pointer,]), 4);
            // (the item's size an int64_t, as the runtime takes it: a usize is 32 bits on wasm32)
            let item = match resolve(node.ty) {
                list-type(contained) => contained,
                _ => unsupported(lowering.ir, "a list made of {show-type(node.ty)}"),
            };
            let size = bitcode.integer(lowering.f, i64, size-align(lowering.types, lowering.ir, item)[0] as u64);
            return runtime-call(lowering, made, [must(value(lowering, called.args[0])), size, must(value(lowering, called.args[2])), must(value(lowering, called.args[3])),], true);
        }
        if name == "y_list_static" {
            let pointer = bitcode.pointer-type(lowering.m);
            let made = bitcode.declared(lowering.m, name, bitcode.func-type(lowering.m, pointer, [pointer, pointer,]), 2);
            return runtime-call(lowering, made, [must(value(lowering, called.args[0])), must(value(lowering, called.args[1])),], true);
        }
        // a future's result: where its frame keeps it (after the header)
        if name.starts-with("y_result_") {
            if !gives-value(node.ty) { return none; }
            let frame = bitcode.struct-type(lowering.m, [async-type(lowering.m), field-type(lowering.types, lowering.ir, node.ty),]);
            return some(load-as(lowering, field-address(lowering, must(value(lowering, called.args[0])), frame, 1), field-type(lowering.types, lowering.ir, node.ty), align(lowering, node.ty)));
        }
        // wait a | b | …: which was done first, of the tasks in an array (no C varargs)
        if name == "yel_async_first" {
            let compilation = lowering.m;
            let pointer = bitcode.pointer-type(compilation);
            let i64 = bitcode.int-type(compilation, 64);
            let tasks = scratch-of(lowering, bitcode.array-type(compilation, called.args.len() - 1, pointer), calling.pointer-bytes(lowering.abi));
            for position in 1..called.args.len() {
                store-as(lowering, item-address(lowering, tasks, pointer, bitcode.integer(lowering.f, i64, (position - 1) as u64)), must(value(lowering, called.args[position])), align-code(calling.pointer-bytes(lowering.abi)));
            }
            return some(c-function(lowering, "yel_async_first_of", bitcode.int-type(compilation, 32), [bitcode.int-type(compilation, 32), pointer,], [must(value(lowering, called.args[0])), tasks,]));
        }
        let conversion = cast-helper(lowering, node, called);
        if conversion != none { return conversion; }
        let key = lowering.externs.get-or(name, "");
        // an extern whose C is a template, not a function's name
        if !is-identifier(name) {
            if key == "" { unsupported(lowering.ir, "the runtime's {name}"); }
            return intrinsic(lowering, node, called, key);
        }
        // a generic extern: a C macro (taking each type argument's C type, scan and descriptor
        // first), done here or by the runtime's function for it
        if key != "" && lowering.types.g.funcs.has(key) && lowering.types.g.funcs[key].type-params.len() > 0 {
            return macro-call(lowering, node, called, key);
        }
        let args: list<BcValue> = [];
        let types: list<Type> = [];
        for argument in called.args {
            match value(lowering, argument) {
                some(evaluated) => {
                    args.push(evaluated);
                    types.push(argument.ty);
                }
                // a (): C's yunit, 0
                none => {
                    args.push(bitcode.integer(lowering.f, bitcode.int-type(lowering.m, 8), 0));
                    types.push(Type.unit-type);
                }
            }
        }
        lowering.made.calling-pure = (node.fx & (fx().call | fx().read-mem | fx().write-mem)) == 0;
        let given = c-call(lowering, name, args, types, node.ty);
        lowering.made.calling-pure = false;
        given
    }

    // the runtime's conversions that C leaves undefined, defined (yel.h's static inline ones): a
    // float to an integer saturating (NaN 0: LLVM's fptosi.sat, fptoui.sat), f64 to f32 an infinity
    // past f32's range, an integer to a char U+FFFD where no Unicode scalar value; a fixed-length
    // list's index checked (none: not one of them)
    cast-helper: func(lowering: Lower, node: Node, called: CallNode) -> option<BcValue> {
        let compilation = lowering.m;
        let name = called.c-name;
        if name.starts-with("y_sat_") {
            let target = name.substring(6, name.len());
            let from = called.args[0].ty;
            let width = int-bits(target);
            let intrinsic = "llvm.{if target.byte-at(0) == 115 { "fptosi" } else { "fptoui" }}.sat.i{width}.f{bits(from)}";
            let ty = value-type(lowering.types, lowering.ir, node.ty);
            let callee = bitcode.declared(compilation, intrinsic, bitcode.func-type(compilation, ty, [value-type(lowering.types, lowering.ir, from),]), 1);
            return runtime-call(lowering, callee, [must(value(lowering, called.args[0])),], true);
        }
        // a float's IEEE bits (yel.h's y_bits_f64, y_bits_f32: static inline): a bitcast (11), an
        // f32's widened
        if name == "y_bits_f64" || name == "y_bits_f32" {
            let operand = must(value(lowering, called.args[0]));
            let i64 = bitcode.int-type(compilation, 64);
            if name == "y_bits_f64" { return some(must(inst(lowering, 3, [BcOperand.value(operand), BcOperand.raw(i64 as u64), BcOperand.raw(11),], true))); }
            let i32 = bitcode.int-type(compilation, 32);
            let bits32 = must(inst(lowering, 3, [BcOperand.value(operand), BcOperand.raw(i32 as u64), BcOperand.raw(11),], true));
            return some(must(inst(lowering, 3, [BcOperand.value(bits32), BcOperand.raw(i64 as u64), BcOperand.raw(1),], true)));
        }
        // a float of its IEEE bits (y_f64_of, y_f32_of: static inline): a bitcast, an f32's of the
        // low 32
        if name == "y_f64_of" || name == "y_f32_of" {
            let operand = must(value(lowering, called.args[0]));
            let float = value-type(lowering.types, lowering.ir, node.ty);
            if name == "y_f64_of" { return some(must(inst(lowering, 3, [BcOperand.value(operand), BcOperand.raw(float as u64), BcOperand.raw(11),], true))); }
            let bits32 = must(inst(lowering, 3, [BcOperand.value(operand), BcOperand.raw(bitcode.int-type(compilation, 32) as u64), BcOperand.raw(0),], true));
            return some(must(inst(lowering, 3, [BcOperand.value(bits32), BcOperand.raw(float as u64), BcOperand.raw(11),], true)));
        }
        // what crossed the boundary, checked (yel.h's static inline y_abi_char, y_abi_tag): else
        // the runtime's y_abi_bad
        if name == "y_abi_char" || name == "y_abi_tag" {
            let i32 = bitcode.int-type(compilation, 32);
            let operand = must(value(lowering, called.args[0]));
            let bad = if name == "y_abi_char" {
                let outside = compare(lowering, 34, operand, bitcode.integer(lowering.f, i32, 1114111));
                let surrogate = binop(lowering, 10, compare(lowering, 35, operand, bitcode.integer(lowering.f, i32, 55296)), compare(lowering, 37, operand, bitcode.integer(lowering.f, i32, 57343)));
                binop(lowering, 11, outside, surrogate)
            } else {
                compare(lowering, 35, operand, must(value(lowering, called.args[1])))
            };
            let stop = bitcode.new-block(lowering.f);
            let go = bitcode.new-block(lowering.f);
            branch(lowering, bad, stop, go);
            lowering.block = stop;
            let _ = c-function(lowering, "y_abi_bad", bitcode.void-type(compilation), [i32,], [bitcode.integer(lowering.f, i32, if name == "y_abi_char" { 4 } else { 5 }),]);
            inst(lowering, 15, [], false);
            lowering.block = go;
            return some(operand);
        }
        if name == "y_f64_to_f32" {
            let operand = must(value(lowering, called.args[0]));
            let f64 = value-type(lowering.types, lowering.ir, called.args[0].ty);
            let f32 = value-type(lowering.types, lowering.ir, node.ty);
            // past FLT_MAX and half its ulp (0x1.ffffffp127): an infinity
            let limit = bitcode.float(lowering.f, f64, 5183643170835005440);
            let lower = bitcode.float(lowering.f, f64, 14407015207689781248);
            let near = must(inst(lowering, 3, [BcOperand.value(operand), BcOperand.raw(f32 as u64), BcOperand.raw(7),], true));
            let infinity = bitcode.float(lowering.f, f32, 2139095040);
            let negative-infinity = bitcode.float(lowering.f, f32, 4286578688);
            let high = select(lowering, compare(lowering, 3, operand, limit), infinity, near);
            return some(select(lowering, compare(lowering, 5, operand, lower), negative-infinity, high));
        }
        if name == "y_to_char" {
            let operand = must(value(lowering, called.args[0]));
            let i64 = bitcode.int-type(compilation, 64);
            let i32 = bitcode.int-type(compilation, 32);
            let number = { amount: u64 -> bitcode.integer(lowering.f, i64, amount) };
            let outside = binop(lowering, 11, compare(lowering, 40, operand, number(0)), compare(lowering, 38, operand, number(1114111)));
            let surrogate = binop(lowering, 10, compare(lowering, 39, operand, number(55296)), compare(lowering, 41, operand, number(57343)));
            let bad = binop(lowering, 11, outside, surrogate);
            let code = must(inst(lowering, 3, [BcOperand.value(operand), BcOperand.raw(i32 as u64), BcOperand.raw(0),], true));
            return some(select(lowering, bad, bitcode.integer(lowering.f, i32, 65533), code));
        }
        if name == "y_bound" {
            let index = must(value(lowering, called.args[0]));
            let length = must(value(lowering, called.args[1]));
            let i64 = bitcode.int-type(compilation, 64);
            let outside = binop(lowering, 11, compare(lowering, 40, index, bitcode.integer(lowering.f, i64, 0)), compare(lowering, 39, index, length));
            let stop = bitcode.new-block(lowering.f);
            let go = bitcode.new-block(lowering.f);
            branch(lowering, outside, stop, go);
            lowering.block = stop;
            let _ = c-function(lowering, "y_index_out_of_range", bitcode.void-type(compilation), [i64, i64,], [index, length,]);
            inst(lowering, 15, [], false);
            lowering.block = go;
            return some(index);
        }
        none
    }

    // a generic extern's macro (std's streams' and futures', the prelude's black-box), by its yel
    // name: its arguments after its type arguments
    macro-call: func(lowering: Lower, node: Node, called: CallNode, key: string) -> option<BcValue> {
        let compilation = lowering.m;
        let skip = opt.type-args-before(called.args);
        let pointer = bitcode.pointer-type(compilation);
        let name = if key.starts-with("yel:std/") { key.substring(8, key.len()) } else { key };
        let arg = { -> must(value(lowering, called.args[skip])) };
        if name == "streams.close" {
            let _ = c-function(lowering, "y_writer_close", bitcode.int-type(compilation, 8), [pointer,], [arg(),]);
            return none;
        }
        if name == "async.release-future" {
            let _ = c-function(lowering, "y_future_release", bitcode.void-type(compilation), [pointer,], [arg(),]);
            return none;
        }
        // natively nothing; in a component, the runtime lets the host's end go
        if name == "streams.release-end" {
            if lowering.abi == "wasm32" { let _ = c-function(lowering, "y_stream_release", bitcode.void-type(compilation), [pointer,], [arg(),]); }
            return none;
        }
        // the value, which the optimizer must take as unknown: kept in memory it reads back
        if name == "black-box" {
            if !gives-value(node.ty) { return none; }
            let ty = field-type(lowering.types, lowering.ir, node.ty);
            let held = scratch-of(lowering, ty, size-align(lowering.types, lowering.ir, node.ty)[1]);
            let _ = inst(lowering, 44, [BcOperand.value(held), BcOperand.value(arg()), BcOperand.raw(align(lowering, node.ty)), BcOperand.raw(1),], false);
            return some(must(inst(lowering, 20, [BcOperand.value(held), BcOperand.raw(ty as u64), BcOperand.raw(align(lowering, node.ty)), BcOperand.raw(1),], true)));
        }
        unsupported(lowering.ir, "the macro {called.c-name} (of {name})")
    }

    // whether a C name is a function's (letters, digits and _), not a macro's text
    is-identifier: func(name: string) -> bool {
        if name.len() == 0 { return false; }
        for index in 0..name.len() {
            let byte = name.byte-at(index);
            let letter = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95;
            if !letter && !(index > 0 && byte >= 48 && byte <= 57) { return false; }
        }
        true
    }

    // ---- calls of C (the runtime's), as the target's calling convention passes their values

    // a call of the C function name with args (each of its type in types), giving a value of the
    // result type (none for () or never, which C gives as a yunit)
    c-call: func(lowering: Lower, name: string, args: list<BcValue>, types: list<Type>, result: Type) -> option<BcValue> {
        let compilation = lowering.m;
        let pointer = bitcode.pointer-type(compilation);
        let layouts: list<Layout> = [];
        for argument-type in types { layouts.push(c-layout(lowering, argument-type)); }
        let gives = !is-unit(result) && !is-never(result);
        let result-layout = if gives { c-layout(lowering, result) } else { calling.scalar(lowering.abi, ScalarKind.integer, 8) };
        let signature = calling.signature(lowering.abi, layouts, some(result-layout));
        let returning = match signature.result {
            some(passed) => passed,
            none => calling.direct(),
        };
        let params: list<s64> = [];
        let values: list<BcValue> = [];
        let attributes: list<BcParamAttributes> = [];
        // the result: as itself, in parts (one, or a struct of them), or written where a hidden first
        // param says (sret)
        let result-ty = bitcode.void-type(compilation);
        let written: option<BcValue> = none;
        if returning.how == PassingKind.direct {
            // a () or never: a yel extern's C gives a yunit (a byte), the runtime's own (y_mark)
            // gives nothing
            result-ty = if gives { value-type(lowering.types, lowering.ir, result) } else if lowering.externs.has(name) { bitcode.int-type(compilation, 8) } else { bitcode.void-type(compilation) };
            if gives { attributes.push({ index: 0, attributes: extension(result, lowering.types.extends), }); }
        } else if returning.how == PassingKind.parts {
            result-ty = parts-type(compilation, returning.parts);
        } else {
            let memory = scratch(lowering, result-layout);
            params.push(pointer);
            values.push(memory);
            attributes.push({ index: 1, attributes: concat(bitcode.sret(value-type(lowering.types, lowering.ir, result)), bitcode.aligned(result-layout.align)), });
            written = some(memory);
        }
        for position in 0..args.len() {
            let passing = signature.params[position];
            let argument-type = types[position];
            if passing.how == PassingKind.direct {
                attributes.push({ index: params.len() + 1, attributes: extension(argument-type, lowering.types.extends), });
                params.push(value-type(lowering.types, lowering.ir, argument-type));
                values.push(args[position]);
            } else if passing.how == PassingKind.parts {
                let memory = scratch(lowering, layouts[position]);
                store-as(lowering, memory, args[position], align-code(layouts[position].align));
                for part in passing.parts {
                    let ty = part-type(compilation, part);
                    params.push(ty);
                    values.push(load-as(lowering, at-offset(lowering, memory, part.offset), ty, align-code(part-align(lowering, part))));
                }
            } else {
                // a pointer to a copy: the callee's (byval) or the caller's
                let memory = scratch(lowering, layouts[position]);
                store-as(lowering, memory, args[position], align-code(layouts[position].align));
                if passing.how == PassingKind.byval {
                    attributes.push({ index: params.len() + 1, attributes: concat(bitcode.byval(value-type(lowering.types, lowering.ir, argument-type)), bitcode.aligned(layouts[position].align)), });
                }
                params.push(pointer);
                values.push(memory);
            }
        }
        // a core import (the canonical ABI's): the host's on wasm (its module and name), natively
        // the runtime's C for it
        let declared-name = name;
        let generator = lowering.types.g;
        if generator.core-imports.has(name) {
            let imported = generator.core-imports[name];
            if lowering.abi == "wasm32" {
                attributes.push({ index: -1, attributes: concat(bitcode.string-attribute("wasm-import-module", imported.module), bitcode.string-attribute("wasm-import-name", imported.name)), });
            } else {
                if imported.wasm-only { unsupported(lowering.ir, "the import {imported.module}#{imported.name} natively (std's host gives it)"); }
                declared-name = imported.native;
            }
        }
        let callee = bitcode.declared(compilation, declared-name, bitcode.func-type(compilation, result-ty, params), params.len());
        let set = bitcode.set-attributes(compilation, callee, attributes);
        lowering.made.pure.set(declared-name, lowering.made.pure.get-or(declared-name, true) && lowering.made.calling-pure);
        let operands: list<BcOperand> = [
            BcOperand.raw(set),
            BcOperand.raw(1 << 15),
            BcOperand.raw(compilation.funcs[callee].ty as u64),
            BcOperand.value(BcValue.function(callee)),
        ];
        for evaluated in values { operands.push(BcOperand.value(evaluated)); }
        // (a value where the callee's type gives one: a func declared before is called as it is)
        let given = inst(lowering, 34, operands, result-of(compilation, callee) != bitcode.void-type(compilation));
        if !gives { return none; }
        match written {
            some(memory) => { return some(load-as(lowering, memory, value-type(lowering.types, lowering.ir, result), align-code(result-layout.align))); }
            none => {}
        }
        if returning.how == PassingKind.direct { return given; }
        // in parts: each stored where it goes in the value's memory, the value loaded from it
        let memory = scratch(lowering, result-layout);
        let parts = returning.parts;
        for index in 0..parts.len() {
            let part = if parts.len() == 1 { must(given) } else { must(inst(lowering, 26, [BcOperand.value(must(given)), BcOperand.raw(index as u64),], true)) };
            store-as(lowering, at-offset(lowering, memory, parts[index].offset), part, align-code(part-align(lowering, parts[index])));
        }
        some(load-as(lowering, memory, value-type(lowering.types, lowering.ir, result), align-code(result-layout.align)))
    }

    // a value's C layout: a scalar's (a bool C's, a char a uint32_t), or a string's ystr
    c-layout: func(lowering: Lower, t0: Type) -> Layout {
        let resolved = resolve(t0);
        if is-string(resolved) {
            return calling.layout(lowering.abi, [
                { kind: ScalarKind.integer, bits: 64, offset: 0, },
                { kind: ScalarKind.pointer, bits: 64, offset: 0, },
            ]);
        }
        match resolved {
            num(name) => calling.scalar(lowering.abi, if name == "f32" || name == "f64" { ScalarKind.float } else { ScalarKind.integer }, if name == "usize" { calling.pointer-bytes(lowering.abi) * 8 } else { int-bits(name) }),
            bool-type => calling.scalar(lowering.abi, ScalarKind.integer, 1),
            char-type => calling.scalar(lowering.abi, ScalarKind.integer, 32),
            address-type => calling.scalar(lowering.abi, ScalarKind.pointer, 64),
            unit-type => calling.scalar(lowering.abi, ScalarKind.integer, 8),
            _ => {
                // a pointer (a list, a buffer, an object)
                let paths = pointer-paths(lowering.types, lowering.ir, resolved);
                if paths.len() == 1 && paths[0].len() == 0 { return calling.scalar(lowering.abi, ScalarKind.pointer, 64); }
                // an enum, flags, a handle: an integer
                if paths.len() == 0 && declared-name(resolved) != "" && !value-variant(lowering.types, resolved) { return calling.scalar(lowering.abi, ScalarKind.integer, size-align(lowering.types, lowering.ir, resolved)[0] * 8); }
                // a value struct (an option, a result, a tuple, a record of fields, a union, a
                // fixed-length list, a func value): its scalars where C lays them out
                let scalars: list<Scalar> = [];
                c-scalars(lowering, resolved, 0, scalars);
                let layout = size-align(lowering.types, lowering.ir, resolved);
                calling.aggregate(scalars, layout[0], layout[1])
            }
        }
    }

    // the scalars of a value of type t at offset bytes into a struct (into out), as C lays them
    // out: a nested struct's at its own offset (its padding kept), a bool a byte, a () a byte
    c-scalars: func(lowering: Lower, t0: Type, offset: s64, out: list<Scalar>) {
        let resolved = resolve(t0);
        if needs-representing(resolved) {
            c-scalars(lowering, represented(resolved), offset, out);
            return;
        }
        let ty = lowering.types;
        let parts = { types: list<Type>, first: list<list<s64>> ->
            let sizes: list<list<s64>> = [];
            for known in first { sizes.push(known); }
            for given in types { sizes.push(size-align(ty, lowering.ir, given)); }
            let offsets = struct-offsets(sizes);
            for position in 0..types.len() { c-scalars(lowering, types[position], offset + offsets[first.len() + position], out); }
            offsets
        };
        let flag: list<list<s64>> = [[1, 1,],];
        match resolved {
            num(name) => out.push({ kind: if is-float(resolved) { ScalarKind.float } else { ScalarKind.integer }, bits: if name == "usize" { calling.pointer-bytes(lowering.abi) * 8 } else { int-bits(name) }, offset: offset, }),
            bool-type => out.push({ kind: ScalarKind.integer, bits: 8, offset: offset, }),
            char-type => out.push({ kind: ScalarKind.integer, bits: 32, offset: offset, }),
            unit-type => out.push({ kind: ScalarKind.integer, bits: 8, offset: offset, }),
            string-type => {
                out.push({ kind: ScalarKind.integer, bits: 64, offset: offset, });
                out.push({ kind: ScalarKind.pointer, bits: 64, offset: offset + 8, });
            }
            option-type(contained) => {
                out.push({ kind: ScalarKind.integer, bits: 8, offset: offset, });
                let _ = parts([contained,], flag);
            }
            result-type(outcome) => {
                out.push({ kind: ScalarKind.integer, bits: 8, offset: offset, });
                let _ = parts([outcome.ok, outcome.err,], flag);
            }
            tuple-type(xs) => { let _ = parts(xs, []); }
            anon-record(anonymous) => {
                if anonymous.types.len() == 0 { out.push({ kind: ScalarKind.integer, bits: 8, offset: offset, }); }
                else { let _ = parts(anonymous.types, []); }
            }
            union-type(xs) => {
                out.push({ kind: ScalarKind.integer, bits: 32, offset: offset, });
                let _ = parts(xs, [[4, 4,],]);
            }
            fixed-list(fixed) => {
                let size = size-align(ty, lowering.ir, fixed.item)[0];
                for position in 0..fixed.len { c-scalars(lowering, fixed.item, offset + position * size, out); }
            }
            func-type(_) => {
                let pointer-size = calling.pointer-bytes(lowering.abi);
                out.push({ kind: ScalarKind.pointer, bits: 64, offset: offset, });
                out.push({ kind: ScalarKind.pointer, bits: 64, offset: offset + pointer-size, });
            }
            // a variant held by value: its tag, then its union's words (integers, as C's union of
            // them is where any case holds one)
            named(name) => {
                if value-variant(ty, resolved) {
                    out.push({ kind: ScalarKind.integer, bits: 32, offset: offset, });
                    let union = union-layout(ty, lowering.ir, name);
                    let at = offset + struct-offsets([[4, 4,], union,])[1];
                    for position in 0..union[0] / union[1] { out.push({ kind: ScalarKind.integer, bits: union[1] * 8, offset: at + position * union[1], }); }
                } else {
                    let paths = pointer-paths(ty, lowering.ir, resolved);
                    if paths.len() == 1 && paths[0].len() == 0 {
                        out.push({ kind: ScalarKind.pointer, bits: 64, offset: offset, });
                    } else {
                        out.push({ kind: ScalarKind.integer, bits: size-align(ty, lowering.ir, resolved)[0] * 8, offset: offset, });
                    }
                }
            }
            // a pointer (a record's, a variant's object, a list), an enum, flags, a handle
            _ => {
                let paths = pointer-paths(ty, lowering.ir, resolved);
                if paths.len() == 1 && paths[0].len() == 0 {
                    out.push({ kind: ScalarKind.pointer, bits: 64, offset: offset, });
                } else {
                    out.push({ kind: ScalarKind.integer, bits: size-align(ty, lowering.ir, resolved)[0] * 8, offset: offset, });
                }
            }
        }
    }

    // a narrow integer param's (or result's) widening: a bool's or an unsigned one's with zeros, a
    // signed one's with its sign; none where the target's C widens nothing (extends: false)
    extension: func(given: Type, extends: bool) -> list<u64> {
        if !extends || is-string(given) || bits(given) >= 32 { return []; }
        if signed(given) { bitcode.signext() } else { bitcode.zeroext() }
    }

    part-type: func(compilation: BcModule, part: Part) -> s64 {
        let item = match part.kind {
            integer => bitcode.int-type(compilation, part.bits),
            float => bitcode.float-type(compilation, part.bits),
            pointer => bitcode.pointer-type(compilation),
        };
        match part.form {
            scalar => item,
            array => bitcode.array-type(compilation, part.count, item),
            vector => bitcode.vector-type(compilation, part.count, item),
            fields => {
                let items: list<s64> = [];
                for repetition in 0..part.count { items.push(item); }
                bitcode.struct-type(compilation, items)
            }
        }
    }

    // a result in parts: one part's type, or a struct of them
    parts-type: func(compilation: BcModule, parts: list<Part>) -> s64 {
        if parts.len() == 1 { return part-type(compilation, parts[0]); }
        let fields: list<s64> = [];
        for part in parts { fields.push(part-type(compilation, part)); }
        bitcode.struct-type(compilation, fields)
    }

    // a part's alignment in bytes (its item's)
    part-align: func(lowering: Lower, part: Part) -> s64 {
        match part.kind {
            pointer => calling.pointer-bytes(lowering.abi),
            _ => if part.bits <= 8 { 1 } else { part.bits / 8 },
        }
    }

    // memory for a value of a layout, in the entry block: its size in i64 words (as much as any of
    // its parts reads), 8-aligned
    scratch: func(lowering: Lower, layout: Layout) -> BcValue {
        let compilation = lowering.m;
        let i32 = bitcode.int-type(compilation, 32);
        let words = (layout.size + 7) / 8;
        let ty = bitcode.array-type(compilation, if words < 1 { 1 } else { words }, bitcode.int-type(compilation, 64));
        must(bitcode.add-inst(lowering.f, 0, 19, [
            BcOperand.raw(ty as u64),
            BcOperand.raw(i32 as u64),
            BcOperand.absolute(bitcode.integer(lowering.f, i32, 1)),
            BcOperand.raw(4 | 64),
        ], true))
    }

    // the address offset bytes into memory (getelementptr inbounds i8)
    at-offset: func(lowering: Lower, memory: BcValue, offset: s64) -> BcValue {
        if offset == 0 { return memory; }
        let compilation = lowering.m;
        let i64 = bitcode.int-type(compilation, 64);
        must(inst(lowering, 43, [
            BcOperand.raw(1),
            BcOperand.raw(bitcode.int-type(compilation, 8) as u64),
            BcOperand.value(memory),
            BcOperand.value(bitcode.integer(lowering.f, i64, offset as u64)),
        ], true))
    }

    // an alignment as a load's or a store's record has it (log2 of the bytes, + 1)
    align-code: func(bytes: s64) -> u64 {
        if bytes <= 1 { 1 } else if bytes == 2 { 2 } else if bytes == 4 { 3 } else { 4 }
    }

    load-as: func(lowering: Lower, address: BcValue, ty: s64, align: u64) -> BcValue {
        must(inst(lowering, 20, [BcOperand.value(address), BcOperand.raw(ty as u64), BcOperand.raw(align), BcOperand.raw(0),], true))
    }

    store-as: func(lowering: Lower, address: BcValue, value: BcValue, align: u64) {
        let _ = inst(lowering, 44, [BcOperand.value(address), BcOperand.value(value), BcOperand.raw(align), BcOperand.raw(0),], false);
    }

    concat: func(one: list<u64>, other: list<u64>) -> list<u64> {
        let out: list<u64> = [];
        for value in one { out.push(value); }
        for value in other { out.push(value); }
        out
    }

    // a / b or a % b: a division by zero stops the program (yel: division by zero), a signed one by
    // -1 is a's negation (or 0), never C's overflow
    divide: func(lowering: Lower, quotient: bool, left: BcValue, right: BcValue, given: Type) -> BcValue {
        let ty = value-type(lowering.types, lowering.ir, given);
        let zero = bitcode.integer(lowering.f, ty, 0);
        let stop = bitcode.new-block(lowering.f);
        let go = bitcode.new-block(lowering.f);
        branch(lowering, compare(lowering, 32, right, zero), stop, go);
        lowering.block = stop;
        let compilation = lowering.m;
        let die = bitcode.declared(compilation, "y_die", bitcode.func-type(compilation, bitcode.void-type(compilation), [bitcode.pointer-type(compilation),]), 1);
        let message = c-string-global(compilation, "division by zero");
        let _ = runtime-call(lowering, die, [BcValue.global(message),], false);
        inst(lowering, 15, [], false);
        lowering.block = go;
        if !signed(given) { return binop(lowering, if quotient { 3 } else { 5 }, left, right); }
        // by -1: no division (INT_MIN / -1 overflows): the result chosen after one by 1
        let minus = bitcode.integer(lowering.f, ty, 18446744073709551615);
        let by-minus = compare(lowering, 32, right, minus);
        let divisor = select(lowering, by-minus, bitcode.integer(lowering.f, ty, 1), right);
        let result = binop(lowering, if quotient { 4 } else { 6 }, left, divisor);
        let instead = if quotient { binop(lowering, 1, zero, left) } else { zero };
        select(lowering, by-minus, instead, result)
    }

    // a << b or a >> b, b (of its own integer type) modulo a's width; >> of a signed one keeps the
    // sign
    shift: func(lowering: Lower, left: bool, shifted: BcValue, distance: BcValue, bt: Type, given: Type) -> BcValue {
        let ty = value-type(lowering.types, lowering.ir, given);
        let amount = convert(lowering, distance, bt, given);
        let masked = binop(lowering, 10, amount, bitcode.integer(lowering.f, ty, (bits(given) - 1) as u64));
        binop(lowering, if left { 7 } else if signed(given) { 9 } else { 8 }, shifted, masked)
    }

    // a op b: a comparison (signed or not by a's type), or a bit operator
    binary: func(lowering: Lower, op: string, left: BcValue, right: BcValue, given: Type) -> BcValue {
        if is-float(given) {
            // fcmp: oeq 1, ogt 2, oge 3, olt 4, ole 5, une 14 (as C's: != is true of a NaN)
            let predicates = ["==", ">", ">=", "<", "<=",];
            let at = predicates.index-of(op);
            if at >= 0 { return compare(lowering, (at + 1) as u64, left, right); }
            if op == "!=" { return compare(lowering, 14, left, right); }
            // fadd, fsub, fmul, fdiv (BINOP's add, sub, mul, sdiv on floats)
            let ops = ["+", "-", "*", "/",];
            let code = [0, 1, 2, 4,];
            let index = ops.index-of(op);
            if index >= 0 { return binop(lowering, code[index] as u64, left, right); }
            unsupported(lowering.ir, "the operator {op} on {show-type(given)}");
        }
        let is-signed = signed(given);
        if op == "==" { return compare(lowering, 32, left, right); }
        if op == "!=" { return compare(lowering, 33, left, right); }
        if op == "<" { return compare(lowering, if is-signed { 40 } else { 36 }, left, right); }
        if op == "<=" { return compare(lowering, if is-signed { 41 } else { 37 }, left, right); }
        if op == ">" { return compare(lowering, if is-signed { 38 } else { 34 }, left, right); }
        if op == ">=" { return compare(lowering, if is-signed { 39 } else { 35 }, left, right); }
        // a for's counter steps with a plain + (it never goes past its end)
        if op == "+" { return binop(lowering, 0, left, right); }
        if op == "-" { return binop(lowering, 1, left, right); }
        if op == "*" { return binop(lowering, 2, left, right); }
        // a shift as it is (not yel's: the IR's own, as a status word's): shl 7, lshr 8, ashr 9
        if op == "<<" { return binop(lowering, 7, left, right); }
        if op == ">>" { return binop(lowering, if is-signed { 9 } else { 8 }, left, right); }
        if op == "&" { return binop(lowering, 10, left, right); }
        if op == "|" { return binop(lowering, 11, left, right); }
        if op == "^" { return binop(lowering, 12, left, right); }
        unsupported(lowering.ir, "the operator {op} on {show-type(given)}")
    }

    // v (of type from) as type to: wider by its sign, narrower cut; a bool's 0 or 1
    convert: func(lowering: Lower, value: BcValue, from: Type, to: Type) -> BcValue {
        let have = bits(from);
        let want = bits(to);
        let ty = value-type(lowering.types, lowering.ir, to);
        // floats: fptrunc 7, fpext 8; an integer's: sitofp 6, uitofp 5 (a float to an integer is
        // the runtime's y_sat_*)
        if is-float(to) {
            if is-float(from) {
                if have == want { return value; }
                return must(inst(lowering, 3, [BcOperand.value(value), BcOperand.raw(ty as u64), BcOperand.raw(if want < have { 7 } else { 8 }),], true));
            }
            return must(inst(lowering, 3, [BcOperand.value(value), BcOperand.raw(ty as u64), BcOperand.raw(if signed(from) { 6 } else { 5 }),], true));
        }
        // integers (an enum's, flags', a handle's too: their widths as the module has them), and
        // pointers (none to change)
        let compilation = lowering.m;
        let from-ty = value-type(lowering.types, lowering.ir, from);
        // an address as a number (a usize: what the host is given) and back: ptrtoint 9, inttoptr 10
        if compilation.type-codes[from-ty] == 25 && compilation.type-codes[ty] == 7 { return must(inst(lowering, 3, [BcOperand.value(value), BcOperand.raw(ty as u64), BcOperand.raw(9),], true)); }
        if compilation.type-codes[from-ty] == 7 && compilation.type-codes[ty] == 25 { return must(inst(lowering, 3, [BcOperand.value(value), BcOperand.raw(ty as u64), BcOperand.raw(10),], true)); }
        if compilation.type-codes[from-ty] != 7 || compilation.type-codes[ty] != 7 { return value; }
        let from-bits = compilation.type-operands[from-ty][0] as s64;
        let to-bits = compilation.type-operands[ty][0] as s64;
        if from-bits == to-bits { return value; }
        let op = if to-bits < from-bits { 0 } else if signed(from) { 2 } else { 1 };
        must(inst(lowering, 3, [BcOperand.value(value), BcOperand.raw(ty as u64), BcOperand.raw(op),], true))
    }

    // ---- instructions

    inst: func(lowering: Lower, code: s64, operands: list<BcOperand>, gives: bool) -> option<BcValue> {
        bitcode.add-inst(lowering.f, lowering.block, code, operands, gives)
    }

    binop: func(lowering: Lower, opcode: u64, left: BcValue, right: BcValue) -> BcValue {
        must(inst(lowering, 2, [BcOperand.value(left), BcOperand.value(right), BcOperand.raw(opcode),], true))
    }

    // icmp (CMP2): eq 32, ne 33, ugt 34, uge 35, ult 36, ule 37, sgt 38, sge 39, slt 40, sle 41
    compare: func(lowering: Lower, predicate: u64, left: BcValue, right: BcValue) -> BcValue {
        must(inst(lowering, 28, [BcOperand.value(left), BcOperand.value(right), BcOperand.raw(predicate),], true))
    }

    select: func(lowering: Lower, test: BcValue, yes: BcValue, no: BcValue) -> BcValue {
        must(inst(lowering, 29, [BcOperand.value(yes), BcOperand.value(no), BcOperand.value(test),], true))
    }

    load: func(lowering: Lower, slot: BcValue, given: Type) -> BcValue {
        let ty = value-type(lowering.types, lowering.ir, given);
        must(inst(lowering, 20, [BcOperand.value(slot), BcOperand.raw(ty as u64), BcOperand.raw(align(lowering, given)), BcOperand.raw(0),], true))
    }

    store: func(lowering: Lower, slot: BcValue, value: BcValue, given: Type) {
        let _ = inst(lowering, 44, [BcOperand.value(slot), BcOperand.value(value), BcOperand.raw(align(lowering, given)), BcOperand.raw(0),], false);
    }

    // a branch on test (an i1)
    branch: func(lowering: Lower, test: BcValue, yes: s64, no: s64) {
        let _ = inst(lowering, 11, [BcOperand.raw(yes as u64), BcOperand.raw(no as u64), BcOperand.value(test),], false);
    }

    // to block, where the one being written has not ended already
    jump: func(lowering: Lower, block: s64) {
        if !bitcode.ended(lowering.f, lowering.block) { let _ = inst(lowering, 11, [BcOperand.raw(block as u64),], false); }
    }

    // a call of a func the module declares (the runtime's)
    // (a value where the callee's type gives one, whatever the caller expects: a void C function
    // gives none)
    runtime-call: func(lowering: Lower, callee: s64, args: list<BcValue>, gives: bool) -> option<BcValue> {
        let _ = gives;
        // (a call the backend makes: not known pure)
        lowering.made.pure.set(lowering.m.funcs[callee].name, false);
        let operands: list<BcOperand> = [
            BcOperand.raw(0),
            BcOperand.raw(1 << 15),
            BcOperand.raw(lowering.m.funcs[callee].ty as u64),
            BcOperand.value(BcValue.function(callee)),
        ];
        for argument in args { operands.push(BcOperand.value(argument)); }
        inst(lowering, 34, operands, result-of(lowering.m, callee) != bitcode.void-type(lowering.m))
    }

    // a string literal (its C name: S3): a global of its bytes, and the { length, data } of it
    string-literal: func(lowering: Lower, text: string) -> BcValue {
        let compilation = lowering.m;
        let global = bytes-global(compilation, text);
        let ty = string-type(compilation);
        let empty = bitcode.undefined(lowering.f, ty);
        let sized = must(inst(lowering, 27, [BcOperand.value(empty), BcOperand.value(bitcode.integer(lowering.f, bitcode.int-type(compilation, 64), text.len() as u64)), BcOperand.raw(0),], true));
        must(inst(lowering, 27, [BcOperand.value(sized), BcOperand.value(BcValue.global(global)), BcOperand.raw(1),], true))
    }

    // the global holding text, made once
    bytes-global: func(compilation: BcModule, text: string) -> s64 {
        for index in 0..compilation.globals.len() {
            let global = compilation.globals[index];
            if !global.terminated && !global.external && global.align == 1 && global.bytes == text { return index; }
        }
        bitcode.add-bytes(compilation, "yel.string.{compilation.globals.len()}", text)
    }

    // a global holding a C string (a message for the runtime's y_die): its index, made once
    c-string-global: func(compilation: BcModule, text: string) -> s64 {
        for index in 0..compilation.globals.len() {
            if compilation.globals[index].terminated && compilation.globals[index].bytes == text { return index; }
        }
        bitcode.add-c-string(compilation, "yel.c-string.{compilation.globals.len()}", text)
    }

    // ---- reading the IR

    kind-name: func(node: Node) -> string {
        match node.kind {
            const(_) => "a constant",
            local(_) => "a local",
            assign(_) => "an assignment",
            bin(operation) => "the operator {operation.op}",
            un(unary) => "the operator {unary.op}",
            convert(_) => "a conversion",
            load(_) => "a field's read",
            store(_) => "a field's write",
            if(_) => "an if",
            loop(_) => "a loop",
            break(_) => "a break",
            continue(_) => "a continue",
            block(_) => "a block",
            return(_) => "a return",
            unreachable(_) => "a match no arm fits",
            halt => "a call that never returns",
            resume(_) => "a wait",
            suspend(_) => "a wait",
            yield(_) => "a yield",
            call(called) => "a call of {called.c-name}",
            func-ref(_) => "a func as a value",
            call-ref(_) => "a call of a func value",
            alloc(_) => "a record or a case made",
            make(_) => "a value made of parts",
            list-get(_) => "a list's item",
            interp(_) => "an interpolated string",
            deref(_) => "a value at an address",
            address-of(_) => "an address",
            size-of(_) => "a size",
            element(_) => "an item's address",
            type-arg(_) => "a type argument",
            global(_) => "a global",
            scan(_) => "a scan",
            static-list(_) => "a list's static data",
            descriptor(_) => "a type's descriptor",
        }
    }

    // the value a node that has one gives
    must: func(optional: option<BcValue>) -> BcValue {
        match optional {
            some(value) => value,
            none => panic("llvm: a value was wanted of what gives none"),
        }
    }

    unsupported: func(function: IrFunc, what: string) -> never {
        diagnostics.fail("yelc --backend bitcode: {what} is not done yet (in {function.key})")
    }

    // ================================================================ values beyond scalars
    //
    // Values beyond scalars, laid out as the C backend's (gen.yel's c-type, value-struct,
    // type-decls): a record's or a variant's object (behind a pointer),
    // a value struct (an option, a result, a tuple, an anonymous record, a union, a fixed-length list, a
    // func value), a list's items. Their fields are read and written by the C paths the IR names
    // (o->f_x, v.value, o->u.c_case), as GEPs into the object or extractvalues of the value; objects are
    // made by y_new (or on the func's stack), traced by funcs made here; and the collector's roots are a
    // frame (y_frame) of slots for the pointers of each rooted local, pushed on y_top while the func
    // runs, as render.yel's.

    // ---- types

    // a value's type in the module, as the C backend's c-type: a scalar, a ystr, a pointer (a list,
    // a map, a record's or a variant's object), or a value struct
    value-type: func(ty: Types, function: IrFunc, t0: Type) -> s64 {
        let compilation = ty.m;
        let resolved = resolve(t0);
        if needs-representing(resolved) { return value-type(ty, function, represented(resolved)); }
        let pointer = bitcode.pointer-type(compilation);
        match resolved {
            num(name) => if name == "f32" || name == "f64" { bitcode.float-type(compilation, int-bits(name)) } else if name == "usize" { bitcode.int-type(compilation, calling.pointer-bytes(ty.abi) * 8) } else { bitcode.int-type(compilation, int-bits(name)) },
            canonical-type(canonical) => canonical-struct(ty, function, canonical),
            bool-type => bitcode.int-type(compilation, 1),
            char-type => bitcode.int-type(compilation, 32),
            string-type => string-type(compilation),
            range-type(range) => value-type(ty, function, range.base),
            singleton(single) => value-type(ty, function, single.base),
            buffer-type => pointer,
            address-type => pointer,
            list-type(_) => pointer,
            map-type(_) => pointer,
            future-type(_) => pointer,
            seq-type(_) => pointer,
            stream-type(_) => pointer,
            option-type(contained) => bitcode.struct-type(compilation, [bitcode.int-type(compilation, 1), field-type(ty, function, contained),]),
            result-type(outcome) => bitcode.struct-type(compilation, [bitcode.int-type(compilation, 1), field-type(ty, function, outcome.ok), field-type(ty, function, outcome.err),]),
            tuple-type(xs) => bitcode.struct-type(compilation, xs.map({ item -> field-type(ty, function, item) })),
            union-type(xs) => {
                let fields = [bitcode.int-type(compilation, 32),];
                for item in xs { fields.push(field-type(ty, function, item)); }
                bitcode.struct-type(compilation, fields)
            }
            anon-record(anonymous) => {
                if anonymous.types.len() == 0 { return bitcode.struct-type(compilation, [bitcode.int-type(compilation, 8),]); }
                bitcode.struct-type(compilation, anonymous.types.map({ item -> field-type(ty, function, item) }))
            }
            fixed-list(fixed) => bitcode.struct-type(compilation, [bitcode.array-type(compilation, fixed.len, field-type(ty, function, fixed.item)),]),
            func-type(_) => bitcode.struct-type(compilation, [pointer, pointer,]),
            named(name) => {
                let kind = gen.named-kind(ty.g, name);
                // (a variant held by value: its struct, as its object's)
                if kind == "variant" && gen.value-variant(ty.g, name) { return variant-object(ty, function, name-text(name)); }
                if kind == "record" || kind == "variant" { return pointer; }
                if kind == "flags" && ty.g.symbols.flags[name].flags.len() > 32 { return bitcode.int-type(compilation, 64); }
                bitcode.int-type(compilation, 32)
            }
            _ => unsupported(function, "a value of {show-type(resolved)}"),
        }
    }

    // a value's type where it is a field (an item, a payload): a () is C's yunit there, a byte
    field-type: func(ty: Types, function: IrFunc, given: Type) -> s64 {
        if is-unit(given) || is-never(given) { bitcode.int-type(ty.m, 8) } else { value-type(ty, function, given) }
    }

    // a value's size and alignment in bytes, as C lays its type out on the target
    size-align: func(ty: Types, function: IrFunc, t0: Type) -> list<s64> {
        let resolved = resolve(t0);
        if needs-representing(resolved) { return size-align(ty, function, represented(resolved)); }
        if is-unit(resolved) || is-never(resolved) { return [1, 1,]; }
        let pointer-size = calling.pointer-bytes(ty.abi);
        let flag: list<s64> = [1, 1,];
        match resolved {
            num(name) => {
                let bytes = if name == "usize" { pointer-size } else { int-bits(name) / 8 };
                [bytes, bytes,]
            }
            canonical-type(canonical) => canonical-layout(ty, function, canonical),
            bool-type => flag,
            char-type => [4, 4,],
            string-type => struct-layout([[8, 8,], [pointer-size, pointer-size,],]),
            range-type(range) => size-align(ty, function, range.base),
            singleton(single) => size-align(ty, function, single.base),
            option-type(contained) => struct-layout([flag, size-align(ty, function, contained),]),
            result-type(outcome) => struct-layout([flag, size-align(ty, function, outcome.ok), size-align(ty, function, outcome.err),]),
            tuple-type(xs) => struct-layout(xs.map({ element -> size-align(ty, function, element) })),
            union-type(xs) => {
                let fields: list<list<s64>> = [[4, 4,],];
                for element in xs { fields.push(size-align(ty, function, element)); }
                struct-layout(fields)
            }
            anon-record(anonymous) => if anonymous.types.len() == 0 { flag } else { struct-layout(anonymous.types.map({ element -> size-align(ty, function, element) })) },
            fixed-list(fixed) => {
                let item = size-align(ty, function, fixed.item);
                [item[0] * fixed.len, item[1],]
            }
            func-type(_) => struct-layout([[pointer-size, pointer-size,], [pointer-size, pointer-size,],]),
            named(name) => {
                let kind = gen.named-kind(ty.g, name);
                if kind == "variant" && gen.value-variant(ty.g, name) { return variant-layout(ty, function, name); }
                if kind == "record" || kind == "variant" { return [pointer-size, pointer-size,]; }
                if kind == "flags" && ty.g.symbols.flags[name].flags.len() > 32 { return [8, 8,]; }
                [4, 4,]
            }
            // a pointer: a list, a map, a buffer, a stream, a started call
            _ => [pointer-size, pointer-size,],
        }
    }

    // a struct's size and alignment, of its fields' (each padded to its alignment, the whole to the
    // largest)
    struct-layout: func(fields: list<list<s64>>) -> list<s64> {
        let offset = 0;
        let align = 1;
        for field in fields {
            offset = round-up(offset, field[1]) + field[0];
            if field[1] > align { align = field[1]; }
        }
        [round-up(offset, align), align,]
    }

    round-up: func(number: s64, to: s64) -> s64 { (number + to - 1) / to * to }

    // ---- canonical structs (the canonical ABI's, abi.yel's A_<id>: as C lays them out)

    // a canonical struct's members, as abi-struct declares them
    canonical-parts: func(ty: Types, function: IrFunc, t0: Type) -> CanonicalParts {
        let generator = ty.g;
        let resolved = resolve(t0);
        let u8 = Type.num("u8");
        let usize = Type.num("usize");
        let out: CanonicalParts = { names: [], types: [], union-names: [], union-types: [], };
        let member = { name: string, part: Type ->
            out.names.push(name);
            out.types.push(part);
        };
        // a union's case (a () has none), and its none
        let case = { name: string, part: Type ->
            if gen.has-member(part) {
                out.union-names.push(name);
                out.union-types.push(gen.abi-of(generator, part));
            }
        };
        let union = { ->
            out.union-names.push("none");
            out.union-types.push(u8);
            member("u", Type.unit-type);
        };
        match resolved {
            string-type => {
                member("ptr", Type.address-type);
                member("len", usize);
            }
            list-type(_) => {
                member("ptr", Type.address-type);
                member("len", usize);
            }
            fixed-list(fixed) => member("items", Type.fixed-list({ item: gen.abi-of(generator, fixed.item), len: fixed.len, })),
            option-type(contained) => {
                member("tag", u8);
                member("value", gen.abi-of(generator, contained));
            }
            result-type(outcome) => {
                member("tag", u8);
                case("ok", outcome.ok);
                case("err", outcome.err);
                union();
            }
            tuple-type(xs) => {
                for position in 0..xs.len() { member("f{position}", gen.abi-of(generator, xs[position])); }
            }
            anon-record(anonymous) => {
                if anonymous.fields.len() == 0 { member("none", u8); }
                for position in 0..anonymous.fields.len() { member("f_" + gen.mangle(anonymous.fields[position]), gen.abi-of(generator, anonymous.types[position])); }
            }
            union-type(_) => {
                let ks = kinds(resolved);
                member("tag", gen.tag-num(ks.len()));
                for position in 0..ks.len() { case("c{position}", ks[position]); }
                union();
            }
            named(declared) => {
                if generator.symbols.records.has(declared) {
                    let declaration = generator.symbols.records[declared];
                    let types = gen.wit-field-types(generator, declared);
                    for position in 0..declaration.fields.len() { member("f_" + gen.mangle(declaration.fields[position]), gen.abi-of(generator, types[position])); }
                } else {
                    let declaration = generator.symbols.variants[declared];
                    member("tag", gen.tag-num(declaration.cases.len()));
                    for alternative in declaration.cases {
                        if alternative.has-payload { case("c_" + gen.mangle(alternative.name), gen.wit-payload(generator, declared, alternative.name)); }
                    }
                    union();
                }
            }
            _ => unsupported(function, "the canonical layout of {show-type(resolved)}"),
        }
        out
    }

    // a canonical union's size and alignment (its largest member's)
    canonical-union: func(ty: Types, function: IrFunc, parts: CanonicalParts) -> list<s64> {
        let size = 1;
        let align = 1;
        for part in parts.union-types {
            let layout = size-align(ty, function, part);
            if layout[0] > size { size = layout[0]; }
            if layout[1] > align { align = layout[1]; }
        }
        [round-up(size, align), align,]
    }

    // a canonical struct's type: its members (its union: words of its alignment, enough for the
    // largest case)
    canonical-struct: func(ty: Types, function: IrFunc, given: Type) -> s64 {
        let parts = canonical-parts(ty, function, given);
        let fields: list<s64> = [];
        for position in 0..parts.names.len() {
            if parts.names[position] == "u" {
                let union = canonical-union(ty, function, parts);
                fields.push(bitcode.array-type(ty.m, union[0] / union[1], bitcode.int-type(ty.m, union[1] * 8)));
            } else {
                fields.push(field-type(ty, function, parts.types[position]));
            }
        }
        bitcode.struct-type(ty.m, fields)
    }

    canonical-layout: func(ty: Types, function: IrFunc, given: Type) -> list<s64> {
        let parts = canonical-parts(ty, function, given);
        let sizes: list<list<s64>> = [];
        for position in 0..parts.names.len() {
            if parts.names[position] == "u" { sizes.push(canonical-union(ty, function, parts)); }
            else { sizes.push(size-align(ty, function, parts.types[position])); }
        }
        struct-layout(sizes)
    }

    // an lvalue's address: a local's slot, a field's, a value at an address (its address), a
    // list's item's
    place-address: func(lowering: Lower, node: Node) -> BcValue {
        match node.kind {
            local(variable) => match lowering.slots[variable] {
                some(slot) => { return slot; }
                none => {}
            },
            load(loaded) => match field-memory(lowering, loaded, path-steps(lowering, loaded.base.ty, loaded.path, loaded.arrow)) {
                some(at) => { return at; }
                none => {}
            },
            deref(pointer) => { return must(value(lowering, pointer)); }
            list-get(indexed) => { return item-memory(lowering, indexed, node.ty); }
            global(symbol) => { return global-address(lowering, symbol, node.ty); }
            _ => {}
        }
        unsupported(lowering.ir, "the address of {kind-name(node)}")
    }

    // a global's variable (of type t, in memory as a field is): made once, zero to start with
    global-address: func(lowering: Lower, key: string, given: Type) -> BcValue {
        if !lowering.made.globals.has(key) {
            let at = bitcode.add-variable(lowering.m, gen.global-c(key), field-type(lowering.types, lowering.ir, given), align-code(size-align(lowering.types, lowering.ir, given)[1]));
            lowering.made.globals.set(key, at);
        }
        BcValue.global(lowering.made.globals[key])
    }

    // a record's object (R_x): its fields' struct ({ i8 } for none)
    record-object: func(ty: Types, function: IrFunc, name: Name) -> s64 {
        let declaration = ty.g.symbols.records[name];
        if declaration.fields.len() == 0 { return bitcode.struct-type(ty.m, [bitcode.int-type(ty.m, 8),]); }
        bitcode.struct-type(ty.m, declaration.field-types.map({ item -> field-type(ty, function, item) }))
    }

    record-layout: func(ty: Types, function: IrFunc, name: Name) -> list<s64> {
        let declaration = ty.g.symbols.records[name];
        if declaration.fields.len() == 0 { return [1, 1,]; }
        struct-layout(declaration.field-types.map({ item -> size-align(ty, function, item) }))
    }

    // a variant's object (V_x): its tag, and a union of its cases' payloads (as words of the
    // largest alignment of them, enough for the largest)
    variant-object: func(ty: Types, function: IrFunc, name: string) -> s64 {
        let compilation = ty.m;
        let union = union-layout(ty, function, intern(name));
        let word = bitcode.int-type(compilation, union[1] * 8);
        bitcode.struct-type(compilation, [bitcode.int-type(compilation, 32), bitcode.array-type(compilation, union[0] / union[1], word),])
    }

    union-layout: func(ty: Types, function: IrFunc, name: Name) -> list<s64> {
        let size = 1;
        let align = 1;
        for alternative in ty.g.symbols.variants[name].cases {
            if !alternative.has-payload { continue; }
            let part = size-align(ty, function, alternative.payload);
            if part[0] > size { size = part[0]; }
            if part[1] > align { align = part[1]; }
        }
        [round-up(size, align), align,]
    }

    variant-layout: func(ty: Types, function: IrFunc, name: Name) -> list<s64> {
        struct-layout([[4, 4,], union-layout(ty, function, name),])
    }

    // a named type's object (a record's or a variant's)
    object-type: func(ty: Types, function: IrFunc, name: string) -> s64 {
        if ty.g.symbols.records.has(intern(name)) { record-object(ty, function, intern(name)) } else { variant-object(ty, function, name) }
    }

    object-layout: func(ty: Types, function: IrFunc, name: Name) -> list<s64> {
        if ty.g.symbols.records.has(name) { record-layout(ty, function, name) } else { variant-layout(ty, function, name) }
    }

    // whether a type is a variant held by value (gen.value-variant's)
    value-variant: func(ty: Types, given: Type) -> bool {
        match resolve(given) {
            named(name) => gen.value-variant(ty.g, name),
            _ => false,
        }
    }

    // the name a type is declared by (a record's or a variant's, behind a pointer), or ""
    declared-name: func(given: Type) -> string {
        match resolve(given) {
            named(name) => name-text(name),
            _ => "",
        }
    }

    // ---- C paths

    // the steps of a C path into a value of type t (arrow: into the object t points at): o->f_x,
    // o->u.c_case, v.value, v.f0
    path-steps: func(lowering: Lower, given: Type, path: list<string>, arrow: bool) -> list<PathStep> {
        let ty = lowering.types;
        let steps: list<PathStep> = [];
        let current = given;
        let object = arrow;
        let union-of = "";
        // a canonical struct's union, its members next (u.ok)
        let union-steps: list<CanonicalParts> = [];
        for part in path {
            if union-steps.len() > 0 {
                let parts = union-steps.pop();
                let at = parts.union-names.index-of(part);
                if at < 0 { unsupported(lowering.ir, "the union member {part}"); }
                steps.push({ container: -1, index: -1, });
                current = parts.union-types[at];
                continue;
            }
            if union-of != "" {
                // a case of a variant's union: its payload, at the union's address
                let declaration = ty.g.symbols.variants[intern(union-of)];
                let found = false;
                for alternative in declaration.cases {
                    if alternative.has-payload && "c_{gen.mangle(alternative.name)}" == part {
                        current = alternative.payload;
                        found = true;
                    }
                }
                if !found { unsupported(lowering.ir, "the path {path.join(".")}"); }
                steps.push({ container: -1, index: -1, });
                union-of = "";
                continue;
            }
            // a variant held by value: its tag and its union, as in its object
            if object || value-variant(ty, current) {
                let name = declared-name(current);
                if name == "" {
                    // a runtime struct's field (xs->len): a list's, a buffer's
                    let runtime = runtime-field(lowering, current, part);
                    steps.push(runtime);
                    current = Type.num("s64");
                    object = false;
                    continue;
                }
                let container = object-type(ty, lowering.ir, name);
                if ty.g.symbols.records.has(intern(name)) {
                    let declaration = ty.g.symbols.records[intern(name)];
                    let index = -1;
                    for position in 0..declaration.fields.len() {
                        if "f_{gen.mangle(declaration.fields[position])}" == part { index = position; }
                    }
                    if index < 0 { unsupported(lowering.ir, "the path {path.join(".")}"); }
                    steps.push({ container: container, index: index, });
                    current = declaration.field-types[index];
                } else if part == "tag" {
                    steps.push({ container: container, index: 0, });
                    current = Type.num("s32");
                } else if part == "u" {
                    steps.push({ container: container, index: 1, });
                    union-of = name;
                } else {
                    unsupported(lowering.ir, "the path {path.join(".")}");
                }
                object = false;
                continue;
            }
            match resolve(current) {
                canonical-type(canonical) => {
                    // a canonical struct's member (its union: u, then a case's member, at the
                    // union's address)
                    let parts = canonical-parts(lowering.types, lowering.ir, canonical);
                    let at = parts.names.index-of(part);
                    if at < 0 { unsupported(lowering.ir, "the member {part} of {show-type(current)}"); }
                    steps.push({ container: value-type(ty, lowering.ir, current), index: at, });
                    if part == "u" { union-steps.push(parts); }
                    current = parts.types[at];
                    continue;
                }
                _ => {}
            }
            let container = value-type(ty, lowering.ir, current);
            let at = field-index(lowering, current, part);
            steps.push({ container: container, index: at, });
            current = field-at(current, at);
        }
        steps
    }

    // a field of the runtime's struct a pointer of type t points at: a list's (ylist: len, cap,
    // size), a buffer's (ybuffer: len, cap)
    runtime-field: func(lowering: Lower, given: Type, part: string) -> PathStep {
        match resolve(given) {
            list-type(_) => {
                let names = ["len", "cap", "size",];
                let at = names.index-of(part);
                if at >= 0 { return { container: ylist-type(lowering.m), index: at, }; }
            }
            buffer-type => {
                let names = ["len", "cap",];
                let at = names.index-of(part);
                if at >= 0 { return { container: ybuffer-type(lowering.m), index: at, }; }
            }
            stream-type(_) => {
                let names = ["items", "cap", "closed", "reader", "writer", "host",];
                let at = names.index-of(part);
                if at >= 0 { return { container: ystream-type(lowering.m), index: at, }; }
            }
            _ => {}
        }
        unsupported(lowering.ir, "the field {part} of {show-type(given)}")
    }

    // a value struct's field by its C name: its index
    field-index: func(lowering: Lower, t0: Type, part: string) -> s64 {
        let resolved = resolve(t0);
        if needs-representing(resolved) { return field-index(lowering, represented(resolved), part); }
        match resolved {
            option-type(_) => {
                if part == "has" { return 0; }
                if part == "value" { return 1; }
            }
            result-type(_) => {
                if part == "is_err" { return 0; }
                if part == "ok" { return 1; }
                if part == "err" { return 2; }
            }
            tuple-type(xs) => {
                for position in 0..xs.len() {
                    if part == "f{position}" { return position; }
                }
            }
            union-type(xs) => {
                if part == "tag" { return 0; }
                for position in 0..xs.len() {
                    if part == "c{position}" { return position + 1; }
                }
            }
            anon-record(anonymous) => {
                for position in 0..anonymous.fields.len() {
                    if part == "f_{gen.mangle(anonymous.fields[position])}" { return position; }
                }
            }
            string-type => {
                if part == "len" { return 0; }
                if part == "data" { return 1; }
            }
            func-type(_) => {
                if part == "fn" { return 0; }
                if part == "env" { return 1; }
            }
            fixed-list(_) => {
                if part == "items" { return 0; }
            }
            _ => {}
        }
        unsupported(lowering.ir, "the field {part} of {show-type(resolved)}")
    }

    // the type of a value struct's field at an index
    field-at: func(t0: Type, at: s64) -> Type {
        let resolved = resolve(t0);
        if needs-representing(resolved) { return field-at(represented(resolved), at); }
        match resolved {
            option-type(contained) => if at == 0 { Type.bool-type } else { contained },
            result-type(outcome) => if at == 0 { Type.bool-type } else if at == 1 { outcome.ok } else { outcome.err },
            tuple-type(xs) => xs[at],
            union-type(xs) => if at == 0 { Type.num("s32") } else { xs[at - 1] },
            anon-record(anonymous) => anonymous.types[at],
            string-type => if at == 0 { Type.num("s64") } else { Type.address-type },
            _ => Type.unit-type,
        }
    }

    // where a path leads from an address (each step a GEP into its struct; a union's case its own
    // address)
    path-address: func(lowering: Lower, address: BcValue, steps: list<PathStep>) -> BcValue {
        let at = address;
        for step in steps {
            if step.container >= 0 { at = field-address(lowering, at, step.container, step.index); }
        }
        at
    }

    // a struct's field's address (getelementptr inbounds ty, at, 0, index)
    field-address: func(lowering: Lower, at: BcValue, container: s64, index: s64) -> BcValue {
        let i32 = bitcode.int-type(lowering.m, 32);
        must(inst(lowering, 43, [
            BcOperand.raw(1),
            BcOperand.raw(container as u64),
            BcOperand.value(at),
            BcOperand.value(bitcode.integer(lowering.f, i32, 0)),
            BcOperand.value(bitcode.integer(lowering.f, i32, index as u64)),
        ], true))
    }

    // an item's address: items + index * its size (getelementptr inbounds item, items, index)
    item-address: func(lowering: Lower, items: BcValue, item: s64, index: BcValue) -> BcValue {
        must(inst(lowering, 43, [BcOperand.raw(1), BcOperand.raw(item as u64), BcOperand.value(items), BcOperand.value(index),], true))
    }

    // a field of a value (extractvalue, at each index)
    extract: func(lowering: Lower, value: BcValue, indices: list<s64>) -> BcValue {
        if indices.len() == 0 { return value; }
        let operands = [BcOperand.value(value),];
        for index in indices { operands.push(BcOperand.raw(index as u64)); }
        must(inst(lowering, 26, operands, true))
    }

    // ---- reading and writing fields

    // a load node's value: from the object its base points at, or (a value struct) from the local
    // holding it, or out of the value
    field-load: func(lowering: Lower, node: Node, loaded: LoadNode) -> option<BcValue> {
        if is-unit(node.ty) { return none; }
        let ty = field-type(lowering.types, lowering.ir, node.ty);
        let align = align-code(size-align(lowering.types, lowering.ir, node.ty)[1]);
        let steps = path-steps(lowering, loaded.base.ty, loaded.path, loaded.arrow);
        match field-memory(lowering, loaded, steps) {
            some(address) => some(load-as(lowering, address, ty, align)),
            none => {
                // a union's case (a variant's held by value) is read from memory: the value put in
                // some first
                if steps.any({ step -> step.container < 0 }) {
                    let held = loaded.base.ty;
                    let layout = size-align(lowering.types, lowering.ir, held);
                    let copy = scratch-of(lowering, value-type(lowering.types, lowering.ir, held), layout[1]);
                    store-as(lowering, copy, must(value(lowering, loaded.base)), align-code(layout[1]));
                    return some(load-as(lowering, path-address(lowering, copy, steps), ty, align));
                }
                let indices: list<s64> = [];
                for step in steps { indices.push(step.index); }
                some(extract(lowering, must(value(lowering, loaded.base)), indices))
            }
        }
    }

    // a load node's address, where its value is in memory: an object's field, or a local's (none:
    // a value computed)
    field-memory: func(lowering: Lower, loaded: LoadNode, steps: list<PathStep>) -> option<BcValue> {
        if loaded.arrow { return some(path-address(lowering, must(value(lowering, loaded.base)), steps)); }
        match loaded.base.kind {
            local(variable) => match lowering.slots[variable] {
                some(slot) => some(path-address(lowering, slot, steps)),
                none => none,
            },
            // a value at an address (a canonical struct the runtime gave), or a field of one
            deref(pointer) => some(path-address(lowering, must(value(lowering, pointer)), steps)),
            global(symbol) => some(path-address(lowering, global-address(lowering, symbol, loaded.base.ty), steps)),
            load(inner) => match field-memory(lowering, inner, path-steps(lowering, inner.base.ty, inner.path, inner.arrow)) {
                some(at) => some(path-address(lowering, at, steps)),
                none => none,
            },
            _ => none,
        }
    }

    // a store: its value where its target (a field, a list's item) is; a local's slots again where
    // the target is in a local
    field-store: func(lowering: Lower, storing: StoreNode) {
        // a value in memory: a call's (made first: it may move what the target is in), or one in
        // memory already, copied there
        let from: option<BcValue> = none;
        if in-memory(lowering.types, lowering.ir, storing.value.ty) {
            from = called-into(lowering, storing.value);
            if from == none { from = value-memory(lowering, storing.value); }
        }
        let computed = if from == none { value(lowering, storing.value) } else { none };
        let value-of = match computed {
            some(stored) => stored,
            // a () stored: C's yunit, 0
            none => bitcode.integer(lowering.f, bitcode.int-type(lowering.m, 8), 0),
        };
        let align = align-code(size-align(lowering.types, lowering.ir, storing.target.ty)[1]);
        let put = { address: BcValue, given: BcValue, aligned: u64 ->
            match from {
                some(source) => copy(lowering, address, source, storing.value.ty, true),
                none => store-as(lowering, address, given, aligned),
            }
        };
        match storing.target.kind {
            load(loaded) => {
                let steps = path-steps(lowering, loaded.base.ty, loaded.path, loaded.arrow);
                match field-memory(lowering, loaded, steps) {
                    some(address) => put(address, value-of, align),
                    none => unsupported(lowering.ir, "a field's write into a value no local holds"),
                }
                if !loaded.arrow { root-base(lowering, loaded.base); }
            }
            list-get(indexed) => {
                put(item-memory(lowering, indexed, storing.target.ty), value-of, align);
                if indexed.fixed { root-base(lowering, indexed.list); }
            }
            deref(pointer) => put(must(value(lowering, pointer)), value-of, align),
            global(symbol) => put(global-address(lowering, symbol, storing.target.ty), value-of, align),
            // a whole local (a lowered scalar, written in place): its slot, its roots again
            local(variable) => {
                match lowering.slots[variable] {
                    some(slot) => put(slot, value-of, align),
                    none => {}
                }
                root(lowering, variable);
            }
            _ => unsupported(lowering.ir, "a write to {kind-name(storing.target)}"),
        }
    }

    // a local written in place (a field of its value struct): its slots again
    root-base: func(lowering: Lower, base: Node) {
        match base.kind {
            local(variable) => root(lowering, variable),
            _ => {}
        }
    }

    // a list's item (a list's heap items; a fixed-length list's in its value)
    list-item: func(lowering: Lower, node: Node, list-get: ListGetNode) -> option<BcValue> {
        if is-unit(node.ty) { return none; }
        let ty = field-type(lowering.types, lowering.ir, node.ty);
        some(load-as(lowering, item-memory(lowering, list-get, node.ty), ty, align-code(size-align(lowering.types, lowering.ir, node.ty)[1])))
    }

    // an item's address: in a list's items (ylist's 4th field), or in a fixed-length list's value
    // (a local's slot, else a copy of the value)
    item-memory: func(lowering: Lower, list-get: ListGetNode, item: Type) -> BcValue {
        let compilation = lowering.m;
        let index = must(value(lowering, list-get.index));
        let item-ty = field-type(lowering.types, lowering.ir, item);
        if !list-get.fixed {
            let list = must(value(lowering, list-get.list));
            let items = load-as(lowering, field-address(lowering, list, ylist-type(compilation), 3), bitcode.pointer-type(compilation), align-code(calling.pointer-bytes(lowering.abi)));
            return item-address(lowering, items, item-ty, index);
        }
        // where the list is: a local's slot, an object's field (a closure's environment's), else a
        // copy of its value (read only)
        let holder = match list-get.list.kind {
            local(variable) => lowering.slots[variable],
            load(loaded) => field-memory(lowering, loaded, path-steps(lowering, loaded.base.ty, loaded.path, loaded.arrow)),
            global(symbol) => some(global-address(lowering, symbol, list-get.list.ty)),
            _ => none,
        };
        let memory = match holder {
            some(slot) => slot,
            none => {
                let copy = scratch-of(lowering, value-type(lowering.types, lowering.ir, list-get.list.ty), size-align(lowering.types, lowering.ir, list-get.list.ty)[1]);
                store-as(lowering, copy, must(value(lowering, list-get.list)), align-code(size-align(lowering.types, lowering.ir, list-get.list.ty)[1]));
                copy
            }
        };
        let items = field-address(lowering, memory, value-type(lowering.types, lowering.ir, list-get.list.ty), 0);
        item-address(lowering, items, item-ty, index)
    }

    // a list (ylist): its length, room and items' size, its items, what scans one
    ylist-type: func(compilation: BcModule) -> s64 {
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        bitcode.struct-type(compilation, [i64, i64, i64, pointer, pointer,])
    }

    // memory for one value of type ty, in the entry block
    scratch-of: func(lowering: Lower, ty: s64, align: s64) -> BcValue {
        let i32 = bitcode.int-type(lowering.m, 32);
        must(bitcode.add-inst(lowering.f, 0, 19, [
            BcOperand.raw(ty as u64),
            BcOperand.raw(i32 as u64),
            BcOperand.absolute(bitcode.integer(lowering.f, i32, 1)),
            BcOperand.raw(align-code(align) | 64),
        ], true))
    }

    // ---- values made

    // a value struct made of its parts (each at its field: in order, or by its C name), the rest
    // zero
    make-value: func(lowering: Lower, node: Node, make: MakeNode) -> BcValue {
        let ty = value-type(lowering.types, lowering.ir, node.ty);
        // a variant held by value: made in memory (its case's payload is in its union), zero but
        // its tag and that payload
        if value-variant(lowering.types, node.ty) {
            let layout = size-align(lowering.types, lowering.ir, node.ty);
            let made = scratch-of(lowering, ty, layout[1]);
            store-as(lowering, made, bitcode.null(lowering.f, ty), align-code(layout[1]));
            for position in 0..make.parts.len() {
                let part = make.parts[position];
                match value(lowering, part) {
                    some(evaluated) => {
                        let steps = path-steps(lowering, node.ty, make.fields[position].split("."), false);
                        store-as(lowering, path-address(lowering, made, steps), evaluated, align-code(size-align(lowering.types, lowering.ir, part.ty)[1]));
                    }
                    none => {}
                }
            }
            return load-as(lowering, made, ty, align-code(layout[1]));
        }
        let made = bitcode.null(lowering.f, ty);
        // (a fixed-length list's items: in its struct's array)
        let fixed = match resolve(node.ty) {
            fixed-list(_) => true,
            _ => false,
        };
        for position in 0..make.parts.len() {
            let at = if make.fields[position] == "" { position } else { field-index(lowering, node.ty, make.fields[position]) };
            let indices: list<BcOperand> = if fixed { [BcOperand.raw(0), BcOperand.raw(at as u64),] } else { [BcOperand.raw(at as u64),] };
            match value(lowering, make.parts[position]) {
                some(evaluated) => {
                    let operands = [BcOperand.value(made), BcOperand.value(evaluated),];
                    for index in indices { operands.push(index); }
                    made = must(inst(lowering, 27, operands, true));
                }
                none => {}
            }
        }
        made
    }

    // a record or a case object: on the heap (y_new: zeroed, traced by its trace), or on the
    // func's stack (made, zeroed, as the func starts)
    alloc-object: func(lowering: Lower, dest: s64, allocation: AllocNode) -> BcValue {
        if allocation.stack {
            if !lowering.stack-objects.has(dest) { unsupported(lowering.ir, "an object on the stack it did not make"); }
            return lowering.stack-objects[dest];
        }
        let compilation = lowering.m;
        let size-type = bitcode.int-type(compilation, calling.pointer-bytes(lowering.abi) * 8);
        let pointer = bitcode.pointer-type(compilation);
        let y-new = bitcode.declared(compilation, "y_new", bitcode.func-type(compilation, pointer, [size-type, pointer,]), 2);
        let size = object-layout(lowering.types, lowering.ir, intern(allocation.rec))[0];
        must(runtime-call(lowering, y-new, [bitcode.integer(lowering.f, size-type, size as u64), trace-value(lowering, allocation.trace, allocation.rec),], true))
    }

    // a payload-less case (the C backend's static K_v__c): a constant global of its tag, the rest
    // zero, made once
    singleton-value: func(lowering: Lower, constant: CaseConstant) -> BcValue {
        let name = gen.singleton(constant.owner, constant.name);
        if lowering.made.singletons.has(name) { return BcValue.global(lowering.made.singletons[name]); }
        let declaration = lowering.types.g.symbols.variants[intern(constant.owner)];
        let tag = -1;
        for position in 0..declaration.cases.len() {
            if declaration.cases[position].name == constant.name { tag = position; }
        }
        let layout = variant-layout(lowering.types, lowering.ir, intern(constant.owner));
        let bytes = buffer(layout[0]);
        for position in 0..layout[0] { bytes.push-byte(if position < 4 { (tag >> (position * 8)) & 255 } else { 0 }); }
        let at = bitcode.add-aligned-bytes(lowering.m, name, bytes.to-string(), align-code(layout[1]));
        lowering.made.singletons.set(name, at);
        BcValue.global(at)
    }

    // ---- the collector's roots

    // the pointers a value of type t holds: each as the indices to it in the value (none: the value
    // itself), as gen's ptr-paths: a string's bytes, a list, map, record or variant, and those
    // inside a value struct
    pointer-paths: func(ty: Types, function: IrFunc, t0: Type) -> list<list<s64>> {
        let resolved = resolve(t0);
        if needs-representing(resolved) { return pointer-paths(ty, function, represented(resolved)); }
        let itself: list<list<s64>> = [[],];
        let none-held: list<list<s64>> = [];
        match resolved {
            string-type => [[1,],],
            buffer-type => itself,
            func-type(_) => [[1,],],
            list-type(_) => itself,
            fixed-list(fixed) => {
                let out: list<list<s64>> = [];
                for position in 0..fixed.len {
                    for path in pointer-paths(ty, function, fixed.item) { out.push(prefixed([0, position,], path)); }
                }
                out
            }
            map-type(_) => itself,
            future-type(_) => itself,
            seq-type(_) => itself,
            stream-type(_) => itself,
            option-type(contained) => pointer-paths(ty, function, contained).map({ path -> prefixed([1,], path) }),
            result-type(outcome) => {
                let out = pointer-paths(ty, function, outcome.ok).map({ path -> prefixed([1,], path) });
                for path in pointer-paths(ty, function, outcome.err) { out.push(prefixed([2,], path)); }
                out
            }
            tuple-type(xs) => parts-pointers(ty, function, xs, 0),
            union-type(xs) => parts-pointers(ty, function, xs, 1),
            anon-record(anonymous) => parts-pointers(ty, function, anonymous.types, 0),
            named(name) => {
                let kind = gen.named-kind(ty.g, name);
                if kind == "variant" && gen.value-variant(ty.g, name) {
                    // held by value: each case's pointers in the union's words (as union-word reads
                    // them: the word, then where in it)
                    let word = union-layout(ty, function, name)[1];
                    let out: list<list<s64>> = [];
                    for alternative in ty.g.symbols.variants[name].cases {
                        if !alternative.has-payload { continue; }
                        for offset in pointer-offsets(ty, function, alternative.payload) { out.push([1, offset / word, -1 - (word * 100 + offset % word),]); }
                    }
                    out
                } else if kind == "record" || kind == "variant" {
                    itself
                } else {
                    none-held
                }
            }
            _ => none-held,
        }
    }

    // where a value of type t holds each of its pointers, in bytes from its start, as
    // pointer-paths finds them
    pointer-offsets: func(ty: Types, function: IrFunc, t0: Type) -> list<s64> {
        let resolved = resolve(t0);
        if needs-representing(resolved) { return pointer-offsets(ty, function, represented(resolved)); }
        let pointer-size = calling.pointer-bytes(ty.abi);
        let parts = { types: list<Type>, first: list<list<s64>> ->
            let sizes: list<list<s64>> = [];
            for known in first { sizes.push(known); }
            for given in types { sizes.push(size-align(ty, function, given)); }
            let offsets = struct-offsets(sizes);
            let out: list<s64> = [];
            for position in 0..types.len() {
                for offset in pointer-offsets(ty, function, types[position]) { out.push(offsets[first.len() + position] + offset); }
            }
            out
        };
        let flag: list<list<s64>> = [[1, 1,],];
        match resolved {
            string-type => [8,],
            func-type(_) => [pointer-size,],
            fixed-list(fixed) => {
                let size = size-align(ty, function, fixed.item)[0];
                let out: list<s64> = [];
                for position in 0..fixed.len {
                    for offset in pointer-offsets(ty, function, fixed.item) { out.push(position * size + offset); }
                }
                out
            }
            option-type(contained) => parts([contained,], flag),
            result-type(outcome) => parts([outcome.ok, outcome.err,], flag),
            tuple-type(xs) => parts(xs, []),
            union-type(xs) => parts(xs, [[4, 4,],]),
            anon-record(anonymous) => parts(anonymous.types, []),
            named(name) => {
                if gen.value-variant(ty.g, name) {
                    let at = struct-offsets([[4, 4,], union-layout(ty, function, name),])[1];
                    let out: list<s64> = [];
                    for alternative in ty.g.symbols.variants[name].cases {
                        if !alternative.has-payload { continue; }
                        for offset in pointer-offsets(ty, function, alternative.payload) { out.push(at + offset); }
                    }
                    return out;
                }
                pointer-paths(ty, function, resolved).map({ _ -> 0 })
            }
            _ => pointer-paths(ty, function, resolved).map({ _ -> 0 }),
        }
    }

    // a pointer of a value (held) at its path (pointer-paths'): a part of it, or one in a union's
    // word (the path's last step -1 - (the word's bytes * 100 + where in it)), read as a pointer
    union-word: func(lowering: Lower, held: BcValue, path: list<s64>) -> BcValue {
        let last = if path.len() > 0 { path[path.len() - 1] } else { 0 };
        if last >= 0 { return extract(lowering, held, path); }
        let code = -1 - last;
        let word-bytes = code / 100;
        let shift = code % 100;
        let compilation = lowering.m;
        let pointer-bits = calling.pointer-bytes(lowering.abi) * 8;
        let word = extract(lowering, held, path.slice(0, path.len() - 1));
        if shift > 0 { word = binop(lowering, 8, word, bitcode.integer(lowering.f, bitcode.int-type(compilation, word-bytes * 8), (shift * 8) as u64)); }
        if word-bytes * 8 > pointer-bits { word = must(inst(lowering, 3, [BcOperand.value(word), BcOperand.raw(bitcode.int-type(compilation, pointer-bits) as u64), BcOperand.raw(0),], true)); }
        must(inst(lowering, 3, [BcOperand.value(word), BcOperand.raw(bitcode.pointer-type(compilation) as u64), BcOperand.raw(10),], true))
    }

    parts-pointers: func(ty: Types, function: IrFunc, parts: list<Type>, first: s64) -> list<list<s64>> {
        let out: list<list<s64>> = [];
        for index in 0..parts.len() {
            for path in pointer-paths(ty, function, parts[index]) { out.push(prefixed([first + index,], path)); }
        }
        out
    }

    prefixed: func(head: list<s64>, rest: list<s64>) -> list<s64> {
        let out: list<s64> = [];
        for step in head { out.push(step); }
        for step in rest { out.push(step); }
        out
    }

    // a frame (y_frame: the one before, its slots' count and slots, its stack objects' count and
    // list)
    frame-type: func(compilation: BcModule) -> s64 {
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        bitcode.struct-type(compilation, [pointer, i64, pointer, i64, pointer,])
    }

    // the func's roots, as it starts (in its entry block): a slot for each pointer of each rooted
    // local, its records on the stack (those holding pointers traced), and its frame pushed on
    // y_top
    frame-start: func(lowering: Lower) {
        let compilation = lowering.m;
        let function = lowering.f;
        let ir = lowering.ir;
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        let count = 0;
        for position in 0..ir.locals.len() {
            let paths = pointer-paths(lowering.types, lowering.ir, ir.locals[position].ty);
            lowering.root-paths.push(paths);
            let rooted = !lowering.types.g.context.turns && (ir.rooted.len() == 0 || ir.rooted[position]);
            let has-slot = match lowering.slots[position] {
                some(_) => true,
                none => false,
            };
            if paths.len() > 0 && rooted && has-slot {
                lowering.root-at.push(count);
                count += paths.len();
            } else {
                lowering.root-at.push(-1);
            }
        }
        // the records on the stack: made, zeroed
        let objects: list<BcValue> = [];
        let traces: list<BcValue> = [];
        for node in flatten(ir.body) {
            match node.kind {
                assign(assigned) => match assigned.value.kind {
                    alloc(allocated) => {
                        if allocated.stack && !lowering.stack-objects.has(assigned.dest) {
                            let ty = object-type(lowering.types, ir, allocated.rec);
                            let layout = object-layout(lowering.types, ir, intern(allocated.rec));
                            let object = scratch-of(lowering, ty, layout[1]);
                            let _ = bitcode.add-inst(function, 0, 44, [BcOperand.value(object), BcOperand.value(bitcode.null(function, ty)), BcOperand.raw(align-code(layout[1])), BcOperand.raw(0),], false);
                            lowering.stack-objects.set(assigned.dest, object);
                            if allocated.trace != "NULL" && !lowering.types.g.context.turns {
                                objects.push(object);
                                traces.push(trace-value(lowering, allocated.trace, allocated.rec));
                            }
                        }
                    }
                    _ => {}
                },
                _ => {}
            }
        }
        if count == 0 && objects.len() == 0 { return; }
        lowering.framed = true;
        let null = bitcode.null(function, pointer);
        let slots = null;
        if count > 0 {
            let ty = bitcode.array-type(compilation, count, pointer);
            slots = scratch-of(lowering, ty, calling.pointer-bytes(lowering.abi));
            let _ = bitcode.add-inst(function, 0, 44, [BcOperand.value(slots), BcOperand.value(bitcode.null(function, ty)), BcOperand.raw(align-code(calling.pointer-bytes(lowering.abi))), BcOperand.raw(0),], false);
            lowering.roots = slots;
            lowering.root-count = count;
        }
        let objs = null;
        if objects.len() > 0 {
            let entry = bitcode.struct-type(compilation, [pointer, pointer,]);
            let ty = bitcode.array-type(compilation, objects.len(), entry);
            objs = scratch-of(lowering, ty, calling.pointer-bytes(lowering.abi));
            for position in 0..objects.len() {
                let at = entry-gep(lowering, ty, objs, position);
                entry-store(lowering, entry-field(lowering, entry, at, 0), objects[position]);
                entry-store(lowering, entry-field(lowering, entry, at, 1), traces[position]);
            }
        }
        let frame-ty = frame-type(compilation);
        let frame = scratch-of(lowering, frame-ty, 8);
        let top = BcValue.global(bitcode.external-global(compilation, "y_top", pointer));
        let prev = must(bitcode.add-inst(function, 0, 20, [BcOperand.value(top), BcOperand.raw(pointer as u64), BcOperand.raw(align-code(calling.pointer-bytes(lowering.abi))), BcOperand.raw(0),], true));
        entry-store(lowering, entry-field(lowering, frame-ty, frame, 0), prev);
        entry-store(lowering, entry-field(lowering, frame-ty, frame, 1), bitcode.integer(function, i64, count as u64));
        entry-store(lowering, entry-field(lowering, frame-ty, frame, 2), slots);
        entry-store(lowering, entry-field(lowering, frame-ty, frame, 3), bitcode.integer(function, i64, objects.len() as u64));
        entry-store(lowering, entry-field(lowering, frame-ty, frame, 4), objs);
        entry-store(lowering, top, frame);
        lowering.frame = frame;
    }

    // in the entry block: an array's item's address, a struct's field's, a store
    entry-gep: func(lowering: Lower, ty: s64, at: BcValue, index: s64) -> BcValue {
        let i32 = bitcode.int-type(lowering.m, 32);
        must(bitcode.add-inst(lowering.f, 0, 43, [
            BcOperand.raw(1),
            BcOperand.raw(ty as u64),
            BcOperand.value(at),
            BcOperand.value(bitcode.integer(lowering.f, i32, 0)),
            BcOperand.value(bitcode.integer(lowering.f, i32, index as u64)),
        ], true))
    }

    entry-field: func(lowering: Lower, ty: s64, at: BcValue, index: s64) -> BcValue { entry-gep(lowering, ty, at, index) }

    entry-store: func(lowering: Lower, at: BcValue, value: BcValue) {
        let _ = bitcode.add-inst(lowering.f, 0, 44, [BcOperand.value(at), BcOperand.value(value), BcOperand.raw(align-code(calling.pointer-bytes(lowering.abi))), BcOperand.raw(0),], false);
    }

    // a local just assigned: its pointers into its slots
    root: func(lowering: Lower, variable: s64) {
        if variable >= lowering.root-at.len() || lowering.root-at[variable] < 0 { return; }
        let held-in = lowering.slots[variable];
        if held-in == none { return; }
        let slot = must(held-in);
        let compilation = lowering.m;
        let pointer = bitcode.pointer-type(compilation);
        let held = load(lowering, slot, lowering.ir.locals[variable].ty);
        let paths = lowering.root-paths[variable];
        let slots-ty = bitcode.array-type(compilation, lowering.root-count, pointer);
        for position in 0..paths.len() {
            let extracted = union-word(lowering, held, paths[position]);
            let at = field-address(lowering, lowering.roots, slots-ty, lowering.root-at[variable] + position);
            store-as(lowering, at, extracted, align-code(calling.pointer-bytes(lowering.abi)));
        }
    }

    // the frame popped (a return): y_top its one before again
    frame-end: func(lowering: Lower) {
        if !lowering.framed { return; }
        let compilation = lowering.m;
        let pointer = bitcode.pointer-type(compilation);
        let align = align-code(calling.pointer-bytes(lowering.abi));
        let prev = load-as(lowering, field-address(lowering, lowering.frame, frame-type(compilation), 0), pointer, align);
        store-as(lowering, BcValue.global(bitcode.external-global(compilation, "y_top", pointer)), prev, align);
    }

    // ---- async funcs (as render.yel's render-async): a state machine. Its frame (the task's
    // header, its result, every local, so they last while it waits; traced), its start (a frame
    // made, its arguments in it) and its step (back to the state it left, on until it waits again,
    // 0, or is done, 1)

    // a task's header (y_async: its step, the state it waits in, done, spawned, queued, when it was
    // done, its owner, its release, its async context's values, its number and its name)
    async-type: func(compilation: BcModule) -> s64 {
        let i32 = bitcode.int-type(compilation, 32);
        let pointer = bitcode.pointer-type(compilation);
        bitcode.struct-type(compilation, [pointer, i32, i32, i32, i32, bitcode.int-type(compilation, 64), pointer, pointer, pointer, bitcode.int-type(compilation, 64), pointer,])
    }

    async-layout: func(abi: string) -> list<s64> {
        let pointer-size = calling.pointer-bytes(abi);
        struct-layout([[pointer-size, pointer-size,], [4, 4,], [4, 4,], [4, 4,], [4, 4,], [8, 8,], [pointer-size, pointer-size,], [pointer-size, pointer-size,], [pointer-size, pointer-size,], [8, 8,], [pointer-size, pointer-size,],])
    }

    // an async func's name, as YEL_ASYNC_TRACE tells its tasks (std's without its package)
    task-name: func(ir: IrFunc) -> string {
        if ir.key.starts-with("yel:std/") { ir.key.substring(8, ir.key.len()) } else { ir.key }
    }

    // an async func's start: s_<name>, as the C backend names it
    start-name: func(function: IrFunc) -> string { "s" + function.c-name.substring(1, function.c-name.len()) }

    // its frame: the header, its result, each local (a () one's a byte, as C's yunit)
    task-frame: func(ty: Types, function: IrFunc) -> s64 {
        let fields = [async-type(ty.m), field-type(ty, function, function.result),];
        for local in function.locals { fields.push(field-type(ty, function, local.ty)); }
        bitcode.struct-type(ty.m, fields)
    }

    task-layout: func(ty: Types, function: IrFunc) -> list<s64> {
        let fields = [async-layout(ty.abi), size-align(ty, function, function.result),];
        for local in function.locals { fields.push(size-align(ty, function, local.ty)); }
        struct-layout(fields)
    }

    // a field of the frame (1 its result, 2 + i local i's), and of its header
    task-field: func(lowering: Lower, index: s64) -> BcValue { field-address(lowering, lowering.task, lowering.task-type, index) }

    header-field: func(lowering: Lower, index: s64) -> BcValue { field-address(lowering, task-field(lowering, 0), async-type(lowering.m), index) }

    // the step's body: each local's slot its field of the frame; from the state it waits in (a
    // dispatch to each wait's block), else from the start
    task-step: func(lowering: Lower) {
        let ir = lowering.ir;
        lowering.task-type = task-frame(lowering.types, ir);
        for position in 0..ir.locals.len() {
            if gives-value(ir.locals[position].ty) {
                lowering.slots.push(bitcode.add-inst(lowering.f, 0, 43, [
                    BcOperand.raw(1),
                    BcOperand.raw(lowering.task-type as u64),
                    BcOperand.value(lowering.task),
                    BcOperand.value(bitcode.integer(lowering.f, bitcode.int-type(lowering.m, 32), 0)),
                    BcOperand.value(bitcode.integer(lowering.f, bitcode.int-type(lowering.m, 32), (2 + position) as u64)),
                ], true));
            } else {
                lowering.slots.push(none);
            }
        }
        let dispatch = bitcode.new-block(lowering.f);
        let body = bitcode.new-block(lowering.f);
        lowering.block = body;
        stmts(lowering, ir.body);
        if !bitcode.ended(lowering.f, lowering.block) { task-done(lowering, unit-const()); }
        // the dispatch: each state's block, else the body
        lowering.block = dispatch;
        let i32 = bitcode.int-type(lowering.m, 32);
        let state = load-as(lowering, header-field(lowering, 1), i32, 3);
        for resumption in lowering.resumes.keys() {
            let next = bitcode.new-block(lowering.f);
            branch(lowering, compare(lowering, 32, state, bitcode.integer(lowering.f, i32, resumption as u64)), lowering.resumes[resumption], next);
            lowering.block = next;
        }
        jump(lowering, body);
        let _ = bitcode.add-inst(lowering.f, 0, 11, [BcOperand.raw(dispatch as u64),], false);
    }

    // done: its result kept in its frame (a generator's: none), done set, 1
    task-done: func(lowering: Lower, node: Node) {
        let i32 = bitcode.int-type(lowering.m, 32);
        if !lowering.ir.generator {
            match value(lowering, node) {
                some(result) => store-as(lowering, task-field(lowering, 1), result, align(lowering, lowering.ir.result)),
                none => {}
            }
        }
        store-as(lowering, header-field(lowering, 2), bitcode.integer(lowering.f, i32, 1), 3);
        inst(lowering, 10, [BcOperand.value(bitcode.integer(lowering.f, i32, 1)),], false);
    }

    // its start: a frame (y_new, traced), its step set, its arguments in their locals
    task-start: func(types: Types, made: Made, ir: IrFunc, index: map<string, s64>, externs: map<string, string>) {
        let compilation = types.m;
        let lowering = new-lower(types, made, compilation.funcs[index[start-name(ir)]], ir, index, externs);
        lowering.task-type = task-frame(types, ir);
        let pointer = bitcode.pointer-type(compilation);
        let size-type = bitcode.int-type(compilation, calling.pointer-bytes(types.abi) * 8);
        let y-new = bitcode.declared(compilation, "y_new", bitcode.func-type(compilation, pointer, [size-type, pointer,]), 2);
        let size = task-layout(types, ir)[0];
        let frame = must(runtime-call(lowering, y-new, [bitcode.integer(lowering.f, size-type, size as u64), BcValue.function(task-trace(lowering)),], true));
        lowering.task = frame;
        store-as(lowering, header-field(lowering, 0), BcValue.function(index[ir.c-name]), align-code(calling.pointer-bytes(types.abi)));
        store-as(lowering, header-field(lowering, 10), BcValue.global(c-string-global(compilation, task-name(ir))), align-code(calling.pointer-bytes(types.abi)));
        // its release: stepped in Y_RELEASE_STATE (it lets its host's end go)
        if ir.release {
            let release = bitcode.declared(compilation, "y_async_release_by_step", bitcode.func-type(compilation, bitcode.void-type(compilation), [pointer,]), 1);
            store-as(lowering, header-field(lowering, 7), BcValue.function(release), align-code(calling.pointer-bytes(types.abi)));
        }
        let at = 0;
        for position in 0..ir.params.len() {
            let local = ir.params[position];
            if gives-value(ir.locals[local].ty) {
                // (one given in memory copied from there)
                if in-memory(types, ir, ir.locals[local].ty) {
                    copy(lowering, task-field(lowering, 2 + local), BcValue.param(at), ir.locals[local].ty, false);
                } else {
                    store-as(lowering, task-field(lowering, 2 + local), BcValue.param(at), align(lowering, ir.locals[local].ty));
                }
                at += 1;
            }
        }
        inst(lowering, 10, [BcOperand.value(frame),], false);
    }

    // the frame's trace: the pointers of its result and of each local marked
    task-trace: func(lowering: Lower) -> s64 {
        let compilation = lowering.m;
        let ir = lowering.ir;
        let pointer = bitcode.pointer-type(compilation);
        let at = bitcode.add-func(compilation, "y_trace_Q" + ir.c-name.substring(1, ir.c-name.len()), bitcode.func-type(compilation, bitcode.void-type(compilation), [pointer,]), 1, true, true);
        let task = new-lower(lowering.types, lowering.made, compilation.funcs[at], ir, lowering.index, lowering.externs);
        task.task-type = lowering.task-type;
        let mark = bitcode.declared(compilation, "y_mark", bitcode.func-type(compilation, bitcode.void-type(compilation), [pointer,]), 1);
        let fields = [ir.result,];
        for local in ir.locals { fields.push(local.ty); }
        for position in 0..fields.len() {
            let paths = pointer-paths(lowering.types, lowering.ir, fields[position]);
            if paths.len() == 0 { continue; }
            let held = load-as(task, field-address(task, BcValue.param(0), task.task-type, position + 1), field-type(lowering.types, ir, fields[position]), align(task, fields[position]));
            for path in paths { let _ = runtime-call(task, mark, [union-word(task, held, path),], false); }
        }
        inst(task, 10, [], false);
        at
    }

    // ---- traces and scans (gen's helpers: funcs of the module)

    // a trace's value (its C name, NULL for none): the helper that marks an object's pointers
    trace-value: func(lowering: Lower, name: string, rec: string) -> BcValue {
        if name == "NULL" { return bitcode.null(lowering.f, bitcode.pointer-type(lowering.m)); }
        if !lowering.index.has(name) { unsupported(lowering.ir, "the trace {name} (of {rec}: no helper)"); }
        BcValue.function(lowering.index[name])
    }

    // what scans one item of a list of t (its address given): none, the runtime's for a string or
    // a pointer, else gen's helper
    scan-value: func(lowering: Lower, given: Type) -> BcValue {
        let compilation = lowering.m;
        let pointer = bitcode.pointer-type(compilation);
        let name = gen.scan-fn(lowering.types.g, given);
        if name == "NULL" { return bitcode.null(lowering.f, pointer); }
        if lowering.index.has(name) { return BcValue.function(lowering.index[name]); }
        if name != "y_scan_str" && name != "y_scan_ptr" { unsupported(lowering.ir, "the scan {name} (no helper)"); }
        BcValue.function(bitcode.declared(compilation, name, bitcode.func-type(compilation, bitcode.void-type(compilation), [pointer,]), 1))
    }

    // ---- the runtime's lists and the std intrinsics on them

    // y_list_of(n, size, items, scan) (a list literal: its items stored in memory first) and
    // y_list_new(0, size, scan) (an empty one), for the list type the call gives
    list-made: func(lowering: Lower, node: Node, called: CallNode) -> option<BcValue> {
        let compilation = lowering.m;
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        let item = match resolve(node.ty) {
            list-type(contained) => contained,
            _ => unsupported(lowering.ir, "a list made of {show-type(node.ty)}"),
        };
        let size = bitcode.integer(lowering.f, i64, size-align(lowering.types, lowering.ir, item)[0] as u64);
        let scan = scan-value(lowering, item);
        if called.c-name == "y_list_new" {
            let made = bitcode.declared(compilation, "y_list_new", bitcode.func-type(compilation, pointer, [i64, i64, pointer,]), 3);
            return runtime-call(lowering, made, [must(value(lowering, called.args[0])), size, scan,], true);
        }
        let parts = match called.args[2].kind {
            make(making) => making.parts,
            _ => unsupported(lowering.ir, "a list's items not made in place"),
        };
        let item-ty = field-type(lowering.types, lowering.ir, item);
        let align = size-align(lowering.types, lowering.ir, item)[1];
        let items = scratch-of(lowering, bitcode.array-type(compilation, parts.len(), item-ty), align);
        for position in 0..parts.len() {
            let at = item-address(lowering, items, item-ty, bitcode.integer(lowering.f, i64, position as u64));
            match value(lowering, parts[position]) {
                some(evaluated) => store-as(lowering, at, evaluated, align-code(align)),
                none => {}
            }
        }
        let made = bitcode.declared(compilation, "y_list_of", bitcode.func-type(compilation, pointer, [i64, i64, pointer, pointer,]), 4);
        runtime-call(lowering, made, [bitcode.integer(lowering.f, i64, parts.len() as u64), size, items, scan,], true)
    }

    // an extern whose C is a template (the C backend writes its text where it is called): std's
    // memory intrinsics, a string's and a buffer's length, a string's byte, by their yel names
    // (std's without "yel:std/")
    intrinsic: func(lowering: Lower, node: Node, called: CallNode, key: string) -> option<BcValue> {
        let compilation = lowering.m;
        let i64 = bitcode.int-type(compilation, 64);
        let i32 = bitcode.int-type(compilation, 32);
        let i8 = bitcode.int-type(compilation, 8);
        let pointer = bitcode.pointer-type(compilation);
        let word = align-code(8);
        let name = if key.starts-with("yel:std/") { key.substring(8, key.len()) } else { key };
        // its arguments, after its type arguments
        let skip = opt.type-args-before(called.args);
        let args: list<BcValue> = [];
        let arg-nodes: list<Node> = [];
        for position in skip..called.args.len() {
            arg-nodes.push(called.args[position]);
            match value(lowering, called.args[position]) {
                some(evaluated) => args.push(evaluated),
                none => args.push(bitcode.integer(lowering.f, i8, 0)),
            }
        }
        let list-field = { index: s64 -> field-address(lowering, args[0], ylist-type(compilation), index) };
        let buffer-field = { index: s64 -> field-address(lowering, args[0], ybuffer-type(compilation), index) };
        let address = { operand: BcValue -> cast(lowering, operand, pointer, 10) };
        let number = { operand: BcValue -> cast(lowering, operand, i64, 9) };
        let size-type = bitcode.int-type(compilation, calling.pointer-bytes(lowering.abi) * 8);
        let sized = { operand: BcValue -> if size-type == i64 { operand } else { cast(lowering, operand, size-type, 0) } };
        // lists
        if name == "memory.list-length" { return some(load-as(lowering, list-field(0), i64, word)); }
        if name == "memory.list-room" { return some(load-as(lowering, list-field(1), i64, word)); }
        if name == "memory.item-size" { return some(load-as(lowering, list-field(2), i64, word)); }
        if name == "memory.set-length" {
            store-as(lowering, list-field(0), args[1], word);
            return none;
        }
        if name == "memory.items-address" { return some(number(load-as(lowering, list-field(3), pointer, word))); }
        if name == "memory.set-items" {
            store-as(lowering, list-field(3), address(args[1]), word);
            store-as(lowering, list-field(1), args[2], word);
            return none;
        }
        if name == "memory.item-at" || name == "memory.set-item" {
            let get: ListGetNode = { list: arg-nodes[0], index: arg-nodes[1], ctype: "", fixed: false, };
            if name == "memory.item-at" { return list-item(lowering, node, get); }
            let item = arg-nodes[2].ty;
            if !is-unit(item) { store-as(lowering, item-memory(lowering, get, item), args[2], align-code(size-align(lowering.types, lowering.ir, item)[1])); }
            return none;
        }
        if name == "memory.new-items" {
            let bytes = c-function(lowering, "y_list_bytes", size-type, [i64, i64,], [load-as(lowering, list-field(2), i64, word), args[1],]);
            return some(number(c-function(lowering, "y_new_bytes", pointer, [size-type,], [bytes,])));
        }
        // buffers
        if name == "memory.buffer-length" || name == "buffer.len" { return some(load-as(lowering, buffer-field(0), i64, word)); }
        if name == "memory.buffer-room" { return some(load-as(lowering, buffer-field(1), i64, word)); }
        if name == "memory.buffer-data" { return some(number(load-as(lowering, buffer-field(2), pointer, word))); }
        if name == "memory.set-buffer-length" {
            store-as(lowering, buffer-field(0), args[1], word);
            return none;
        }
        if name == "memory.set-buffer-data" {
            store-as(lowering, buffer-field(2), address(args[1]), word);
            store-as(lowering, buffer-field(1), args[2], word);
            return none;
        }
        // bytes at addresses
        if name == "memory.new-bytes" { return some(number(c-function(lowering, "y_new_bytes", pointer, [size-type,], [sized(args[0]),]))); }
        if name == "memory.store-byte" {
            store-as(lowering, address(args[0]), cast(lowering, args[1], i8, 0), 1);
            return none;
        }
        if name == "memory.load-byte" { return some(cast(lowering, load-as(lowering, address(args[0]), i8, 1), i64, 1)); }
        if name == "memory.copy-bytes" {
            let _ = c-function(lowering, "memcpy", pointer, [pointer, pointer, size-type,], [address(args[0]), address(args[1]), sized(args[2]),]);
            return none;
        }
        if name == "memory.same-bytes" || name == "memory.compare-bytes" {
            let order = c-function(lowering, "memcmp", i32, [pointer, pointer, size-type,], [address(args[0]), address(args[1]), sized(args[2]),]);
            if name == "memory.same-bytes" { return some(compare(lowering, 32, order, bitcode.integer(lowering.f, i32, 0))); }
            return some(cast(lowering, order, i64, 2));
        }
        if name == "memory.string-data" { return some(number(extract(lowering, args[0], [1,]))); }
        if name == "memory.string-at" {
            let made = must(inst(lowering, 27, [BcOperand.value(bitcode.undefined(lowering.f, string-type(compilation))), BcOperand.value(args[1]), BcOperand.raw(0),], true));
            return some(must(inst(lowering, 27, [BcOperand.value(made), BcOperand.value(address(args[0])), BcOperand.raw(1),], true)));
        }
        if name == "memory.bytes-list" {
            let made = c-function(lowering, "y_list_of", pointer, [i64, i64, pointer, pointer,], [args[1], bitcode.integer(lowering.f, i64, 1), address(args[0]), bitcode.null(lowering.f, pointer),]);
            return some(made);
        }
        // a string as C wants a path (a copy ending in 0, the system's memory), and that let go
        if name == "memory.c-path" { return some(number(c-call-pointer(lowering, "y_cstr", [args[0],], [arg-nodes[0].ty,]))); }
        if name == "memory.free" {
            let _ = c-function(lowering, "free", bitcode.void-type(compilation), [pointer,], [address(args[0]),]);
            return none;
        }
        // a list's first count items taken off (the rest moved to its front)
        if name == "memory.remove-front" {
            let length = load-as(lowering, list-field(0), i64, word);
            let size = load-as(lowering, list-field(2), i64, word);
            let items = load-as(lowering, list-field(3), pointer, word);
            let from = item-address(lowering, items, i8, binop(lowering, 2, args[1], size));
            let bytes = binop(lowering, 2, binop(lowering, 1, length, args[1]), size);
            let _ = c-function(lowering, "memmove", pointer, [pointer, pointer, size-type,], [items, from, sized(bytes),]);
            store-as(lowering, list-field(0), binop(lowering, 1, length, args[1]), word);
            return none;
        }
        // a resource's handle and its number
        if name == "memory.handle-number" { return some(convert(lowering, args[0], arg-nodes[0].ty, Type.num("s64"))); }
        if name == "memory.handle" { return some(convert(lowering, args[0], arg-nodes[0].ty, node.ty)); }
        if name == "memory.hold-collector" || name == "memory.release-collector" {
            hold(lowering, name == "memory.hold-collector");
            return none;
        }
        // maps
        if name.starts-with("memory.") && map-intrinsic(lowering, node, name, args, arg-nodes) { return map-result(lowering); }
        // type descriptors (std's value walker reads them), and what it reads through one
        let descriptor-field = { index: s64 -> field-address(lowering, address(args[0]), ytype-type(compilation), index) };
        if name == "value.type-kind" { return some(cast(lowering, load-as(lowering, descriptor-field(0), i8, 1), i32, 1)); }
        if name == "value.type-count" { return some(load-as(lowering, descriptor-field(1), i32, 3)); }
        if name == "value.type-size" { return some(cast(lowering, load-as(lowering, descriptor-field(2), i32, 3), i64, 1)); }
        if name == "value.type-part" || name == "value.part-name" {
            let table = load-as(lowering, descriptor-field(if name == "value.type-part" { 3 } else { 5 }), pointer, word);
            let entry = load-as(lowering, item-address(lowering, table, pointer, cast(lowering, args[1], i64, 2)), pointer, word);
            if name == "value.type-part" { return some(number(entry)); }
            let length = c-function(lowering, "strlen", size-type, [pointer,], [entry,]);
            let wide = if size-type == i64 { length } else { cast(lowering, length, i64, 1) };
            return c-call(lowering, "y_str_of", [entry, wide,], [Type.address-type, Type.num("s64"),], Type.string-type);
        }
        if name == "value.part-offset" {
            let table = load-as(lowering, descriptor-field(4), pointer, word);
            return some(cast(lowering, load-as(lowering, item-address(lowering, table, i32, cast(lowering, args[1], i64, 2)), i32, 3), i64, 1));
        }
        if name == "value.load-at" {
            if !gives-value(node.ty) { return none; }
            return some(load-as(lowering, address(args[0]), field-type(lowering.types, lowering.ir, node.ty), align-code(size-align(lowering.types, lowering.ir, node.ty)[1])));
        }
        if name == "value.list-length" { return some(cast(lowering, load-as(lowering, field-address(lowering, address(args[0]), ylist-type(compilation), 0), i64, word), i32, 0)); }
        if name == "value.list-items" { return some(number(load-as(lowering, field-address(lowering, address(args[0]), ylist-type(compilation), 3), pointer, word))); }
        if name == "value.map-length" { return some(cast(lowering, load-as(lowering, field-address(lowering, address(args[0]), ymap-type(compilation), 0), i64, word), i32, 0)); }
        if name == "value.hash-bits" { return some(c-function(lowering, "y_hash_bits", i64, [i64,], [args[0],])); }
        if name == "value.hash-mix" { return some(c-function(lowering, "y_hash_mix", i64, [i64, i64,], [args[0], args[1],])); }
        // streams between tasks (ystream: its items, room, whether closed, the reader and the
        // writer parked on it, its host end)
        if name.starts-with("streams.") {
            let stream-field = { index: s64 -> field-address(lowering, args[0], ystream-type(compilation), index) };
            let item = match resolve(node.ty) {
                stream-type(streamed) => streamed.item,
                list-type(contained) => contained,
                _ => node.ty,
            };
            if name == "streams.writer-new" {
                let size = bitcode.integer(lowering.f, i64, size-align(lowering.types, lowering.ir, item)[0] as u64);
                return some(c-function(lowering, "y_stream_new", pointer, [i64, pointer, i64,], [size, scan-value(lowering, item), args[0],]));
            }
            if name == "streams.stream-of" { return some(args[0]); }
            if name == "streams.stream-items" { return some(load-as(lowering, stream-field(0), pointer, word)); }
            if name == "streams.stream-closed" { return some(compare(lowering, 33, load-as(lowering, stream-field(2), i32, 3), bitcode.integer(lowering.f, i32, 0))); }
            if name == "streams.from-host" { return some(compare(lowering, 33, load-as(lowering, stream-field(5), i32, 3), bitcode.integer(lowering.f, i32, 0))); }
            if name == "streams.writer-room" {
                let items = load-as(lowering, stream-field(0), pointer, word);
                let length = load-as(lowering, field-address(lowering, items, ylist-type(compilation), 0), i64, word);
                return some(compare(lowering, 40, length, load-as(lowering, stream-field(1), i64, word)));
            }
            // (the runtime's: the task the stream wakes, and what it waits for told by YEL_ASYNC_TRACE)
            if name == "streams.park-reader" || name == "streams.park-writer" {
                let parked = if name == "streams.park-reader" { "yel_stream_park_reader" } else { "yel_stream_park_writer" };
                let _ = c-function(lowering, parked, bitcode.void-type(compilation), [pointer,], [args[0],]);
                return none;
            }
            if name == "streams.wake-writer" || name == "streams.wake-reader" {
                let at = stream-field(if name == "streams.wake-reader" { 3 } else { 4 });
                let _ = c-function(lowering, "y_wake", bitcode.void-type(compilation), [pointer,], [load-as(lowering, at, pointer, word),]);
                store-as(lowering, at, bitcode.null(lowering.f, pointer), word);
                return none;
            }
            if name == "streams.take-first" {
                let ty = field-type(lowering.types, lowering.ir, node.ty);
                let into = scratch-of(lowering, ty, size-align(lowering.types, lowering.ir, node.ty)[1]);
                store-as(lowering, into, bitcode.null(lowering.f, ty), align(lowering, node.ty));
                let at = c-function(lowering, "y_list_take_first", pointer, [pointer, pointer,], [args[0], into,]);
                if !gives-value(node.ty) { return none; }
                return some(load-as(lowering, at, ty, align(lowering, node.ty)));
            }
            if name == "streams.fill-from-host" { return some(c-function(lowering, "yel_stream_fill", pointer, [pointer,], [args[0],])); }
        }
        // the executor's
        if name == "async.has-ready" { return some(c-function(lowering, "yel_async_has_ready", bitcode.int-type(compilation, 1), [], [])); }
        if name == "async.task-done" {
            let done = load-as(lowering, field-address(lowering, args[0], async-type(compilation), 2), i32, 3);
            return some(compare(lowering, 33, done, bitcode.integer(lowering.f, i32, 0)));
        }
        // strings
        if name == "text.len" { return some(extract(lowering, args[0], [0,])); }
        if name == "from-byte" {
            let byte = scratch-of(lowering, i8, 1);
            store-as(lowering, byte, cast(lowering, args[0], i8, 0), 1);
            return c-call(lowering, "y_str_of", [byte, bitcode.integer(lowering.f, i64, 1),], [Type.address-type, Type.num("s64"),], Type.string-type);
        }
        if name == "byte-at" {
            // the byte (0 to 255) at an index in the string, -1 past its ends
            let length = extract(lowering, args[0], [0,]);
            let inside = binop(lowering, 10, compare(lowering, 39, args[1], bitcode.integer(lowering.f, i64, 0)), compare(lowering, 40, args[1], length));
            let safe = select(lowering, inside, args[1], bitcode.integer(lowering.f, i64, 0));
            let byte = load-as(lowering, item-address(lowering, extract(lowering, args[0], [1,]), i8, safe), i8, 1);
            return some(select(lowering, inside, cast(lowering, byte, i64, 1), bitcode.integer(lowering.f, i64, 18446744073709551615)));
        }
        if name == "unreachable" {
            inst(lowering, 15, [], false);
            lowering.block = bitcode.new-block(lowering.f);
            return none;
        }
        unsupported(lowering.ir, "the extern {name} (C: {called.c-name})")
    }

    // a map (ymap): its length, entries made and room for them, a key's and a value's size, the
    // index's room; the index, the entries' hashes, keys and values; what scans a key and a value;
    // a key's hash and equality
    ymap-type: func(compilation: BcModule) -> s64 {
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        bitcode.struct-type(compilation, [i64, i64, i64, i64, i64, i64, pointer, pointer, pointer, pointer, pointer, pointer, pointer, pointer,])
    }

    // std's memory intrinsics on maps (whether name is one): its value, if any, in l.given
    map-intrinsic: func(lowering: Lower, node: Node, name: string, args: list<BcValue>, nodes: list<Node>) -> bool {
        let compilation = lowering.m;
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        let word = align-code(8);
        let at = align-code(calling.pointer-bytes(lowering.abi));
        let give = { value: BcValue -> lowering.given = some(value); };
        lowering.given = none;
        if name == "memory.new-map" {
            let kinds = match resolve(node.ty) {
                map-type(mapped) => [mapped.key, mapped.value,],
                _ => unsupported(lowering.ir, "a map made of {show-type(node.ty)}"),
            };
            let generator = lowering.types.g;
            let helper = { helper-name: string ->
                if !lowering.index.has(helper-name) { unsupported(lowering.ir, "the helper {helper-name}"); }
                BcValue.function(lowering.index[helper-name])
            };
            let size = { given: Type -> bitcode.integer(lowering.f, i64, size-align(lowering.types, lowering.ir, given)[0] as u64) };
            give(c-function(lowering, "y_map_make", pointer, [i64, pointer, pointer, pointer, i64, pointer, i64,], [
                size(kinds[0]), scan-value(lowering, kinds[0]), helper(gen.key-hash-fn(generator, kinds[0])), helper(gen.key-eq-fn(generator, kinds[0])),
                size(kinds[1]), scan-value(lowering, kinds[1]), args[0],
            ]));
            return true;
        }
        let field = { index: s64 -> field-address(lowering, args[0], ymap-type(compilation), index) };
        let counts = ["memory.map-length", "memory.entry-count", "memory.entry-room", "", "", "memory.index-room",];
        let count-at = counts.index-of(name);
        if count-at >= 0 {
            give(load-as(lowering, field(count-at), i64, word));
            return true;
        }
        if name == "memory.set-map-length" || name == "memory.set-entry-count" {
            store-as(lowering, field(if name == "memory.set-map-length" { 0 } else { 1 }), args[1], word);
            return true;
        }
        if name == "memory.adopt" {
            let other = { index: s64 -> field-address(lowering, args[1], ymap-type(compilation), index) };
            for index in [6, 7, 8, 9,] { store-as(lowering, field(index), load-as(lowering, other(index), pointer, at), at); }
            for index in [2, 5, 1,] { store-as(lowering, field(index), load-as(lowering, other(index), i64, word), word); }
            return true;
        }
        let kinds = match resolve(nodes[0].ty) {
            map-type(mapped) => [mapped.key, mapped.value,],
            _ => [Type.unit-type, Type.unit-type,],
        };
        if name == "memory.key-hash" {
            let key-ty = field-type(lowering.types, lowering.ir, kinds[0]);
            let key = scratch-of(lowering, key-ty, size-align(lowering.types, lowering.ir, kinds[0])[1]);
            store-as(lowering, key, args[1], align-code(size-align(lowering.types, lowering.ir, kinds[0])[1]));
            let hash = load-as(lowering, field(12), pointer, at);
            let fn-ty = bitcode.func-type(compilation, i64, [pointer,]);
            give(must(inst(lowering, 34, [BcOperand.raw(0), BcOperand.raw(1 << 15), BcOperand.raw(fn-ty as u64), BcOperand.value(hash), BcOperand.value(key),], true)));
            return true;
        }
        // an entry's or an index slot's place in one of its arrays (index 6, hashes 7, keys 8, values 9)
        let slot = { array: s64, ty: s64, index: BcValue -> item-address(lowering, load-as(lowering, field(array), pointer, at), ty, index) };
        let element = { given: Type -> field-type(lowering.types, lowering.ir, given) };
        let aligned = { given: Type -> align-code(size-align(lowering.types, lowering.ir, given)[1]) };
        if name == "memory.index-entry" || name == "memory.entry-hash" {
            give(load-as(lowering, slot(if name == "memory.index-entry" { 6 } else { 7 }, i64, args[1]), i64, word));
            return true;
        }
        if name == "memory.set-index-entry" || name == "memory.set-entry-hash" {
            store-as(lowering, slot(if name == "memory.set-index-entry" { 6 } else { 7 }, i64, args[1]), args[2], word);
            return true;
        }
        if name == "memory.key-at" || name == "memory.value-at" {
            let chosen = if name == "memory.key-at" { kinds[0] } else { kinds[1] };
            if gives-value(chosen) { give(load-as(lowering, slot(if name == "memory.key-at" { 8 } else { 9 }, element(chosen), args[1]), element(chosen), aligned(chosen))); }
            return true;
        }
        if name == "memory.set-key" || name == "memory.set-value" {
            let chosen = if name == "memory.set-key" { kinds[0] } else { kinds[1] };
            store-as(lowering, slot(if name == "memory.set-key" { 8 } else { 9 }, element(chosen), args[1]), args[2], aligned(chosen));
            return true;
        }
        if name == "memory.clear-entry" {
            store-as(lowering, slot(8, element(kinds[0]), args[1]), bitcode.null(lowering.f, element(kinds[0])), aligned(kinds[0]));
            store-as(lowering, slot(9, element(kinds[1]), args[1]), bitcode.null(lowering.f, element(kinds[1])), aligned(kinds[1]));
            return true;
        }
        if name == "memory.clear-index" {
            let size-type = bitcode.int-type(compilation, calling.pointer-bytes(lowering.abi) * 8);
            let bytes = binop(lowering, 2, load-as(lowering, field(5), i64, word), bitcode.integer(lowering.f, i64, 8));
            let sized = if size-type == i64 { bytes } else { cast(lowering, bytes, size-type, 0) };
            let _ = c-function(lowering, "memset", pointer, [pointer, bitcode.int-type(compilation, 32), size-type,], [load-as(lowering, field(6), pointer, at), bitcode.integer(lowering.f, bitcode.int-type(compilation, 32), 0), sized,]);
            return true;
        }
        false
    }

    // what a map intrinsic gave (none for one that gives nothing)
    map-result: func(lowering: Lower) -> option<BcValue> { lowering.given }

    // a call of a C function giving a pointer (char *, void *), its args of yel types
    c-call-pointer: func(lowering: Lower, name: string, args: list<BcValue>, types: list<Type>) -> BcValue {
        must(c-call(lowering, name, args, types, Type.address-type))
    }

    // a stream (ystream): its items, room, whether closed, its reader and writer parked, its host
    // end (the fields after: the host's, read by the runtime only)
    ystream-type: func(compilation: BcModule) -> s64 {
        let pointer = bitcode.pointer-type(compilation);
        let i32 = bitcode.int-type(compilation, 32);
        bitcode.struct-type(compilation, [pointer, bitcode.int-type(compilation, 64), i32, pointer, pointer, i32,])
    }

    // a buffer (ybuffer): its length and room, its bytes
    ybuffer-type: func(compilation: BcModule) -> s64 {
        let i64 = bitcode.int-type(compilation, 64);
        bitcode.struct-type(compilation, [i64, i64, bitcode.pointer-type(compilation),])
    }

    // a cast (CAST: trunc 0, zext 1, sext 2, ptrtoint 9, inttoptr 10)
    cast: func(lowering: Lower, value: BcValue, ty: s64, op: u64) -> BcValue {
        must(inst(lowering, 3, [BcOperand.value(value), BcOperand.raw(ty as u64), BcOperand.raw(op),], true))
    }

    // a call of a C function of scalars (the runtime's, libc's), declared with its C types
    // (a void one's value: none to use, a null pointer stands for it)
    c-function: func(lowering: Lower, name: string, result: s64, params: list<s64>, args: list<BcValue>) -> BcValue {
        let callee = bitcode.declared(lowering.m, name, bitcode.func-type(lowering.m, result, params), params.len());
        match runtime-call(lowering, callee, args, true) {
            some(evaluated) => evaluated,
            none => bitcode.null(lowering.f, bitcode.pointer-type(lowering.m)),
        }
    }

    // the collector held (y_gc_hold, a C long, one more) or released (one less); never where it
    // runs only between turns (context.turns: nothing is collected meanwhile)
    hold: func(lowering: Lower, more: bool) {
        if lowering.types.g.context.turns { return; }
        let compilation = lowering.m;
        let long = bitcode.int-type(compilation, calling.pointer-bytes(lowering.abi) * 8);
        let counter = BcValue.global(bitcode.external-global(compilation, "y_gc_hold", long));
        let align = align-code(calling.pointer-bytes(lowering.abi));
        let now = load-as(lowering, counter, long, align);
        store-as(lowering, counter, binop(lowering, if more { 0 } else { 1 }, now, bitcode.integer(lowering.f, long, 1)), align);
    }

    // an interpolated string: each piece written into a buffer by its writer (std's: a program
    // func), the collector held meanwhile, the buffer's string
    interpolated: func(lowering: Lower, interpolation: InterpNode) -> BcValue {
        let compilation = lowering.m;
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        hold(lowering, true);
        let new-buffer = bitcode.declared(compilation, "yel_buffer_new", bitcode.func-type(compilation, pointer, [i64,]), 1);
        let buffer-value = must(runtime-call(lowering, new-buffer, [bitcode.integer(lowering.f, i64, 16),], true));
        for position in 0..interpolation.parts.len() {
            let writer = match interpolation.formatters[position] {
                writer(name) => name,
                // std's walker over the value's descriptor, its text pushed
                render(rendered) => {
                    write-rendered(lowering, buffer-value, interpolation.parts[position], rendered);
                    continue;
                }
            };
            if !lowering.index.has(writer) { unsupported(lowering.ir, "the writer {writer}"); }
            let callee = lowering.index[writer];
            let operands: list<BcOperand> = [
                BcOperand.raw(0),
                BcOperand.raw(1 << 15),
                BcOperand.raw(compilation.funcs[callee].ty as u64),
                BcOperand.value(BcValue.function(callee)),
                BcOperand.value(buffer-value),
            ];
            match argument(lowering, interpolation.parts[position]) {
                some(evaluated) => {
                    // as C converts it to the writer's param (an s32 to write-int's s64)
                    let want = compilation.type-operands[compilation.funcs[callee].ty][3] as s64;
                    let have = value-type(lowering.types, lowering.ir, interpolation.parts[position].ty);
                    let given = if want != have && compilation.type-codes[want] == 7 && compilation.type-codes[have] == 7 {
                        cast(lowering, evaluated, want, if compilation.type-operands[want][0] < compilation.type-operands[have][0] { 0 } else if signed(interpolation.parts[position].ty) { 2 } else { 1 })
                    } else {
                        evaluated
                    };
                    operands.push(BcOperand.value(given));
                }
                none => {}
            }
            let _ = inst(lowering, 34, operands, bitcode.void-type(compilation) != result-of(compilation, callee));
        }
        let text = must(c-call(lowering, "yel_buffer_string", [buffer-value,], [Type.buffer-type,], Type.string-type));
        hold(lowering, false);
        text
    }

    // a func's result type (its function type's second operand)
    result-of: func(compilation: BcModule, callee: s64) -> s64 { compilation.type-operands[compilation.funcs[callee].ty][1] as s64 }

    // a value's text by std's walker (value.render over its type's descriptor, display or WAVE),
    // pushed at a buffer's end
    write-rendered: func(lowering: Lower, buffer-value: BcValue, part: Node, shown: RenderFormat) {
        let compilation = lowering.m;
        let i64 = bitcode.int-type(compilation, 64);
        let generator = lowering.types.g;
        let render = generator.funcs[gen.render-key()].c-name;
        let push = generator.funcs["yel:std/buffer.push"].c-name;
        if !lowering.index.has(render) || !lowering.index.has(push) { unsupported(lowering.ir, "std's value.render (not in the module)"); }
        // the value where the walker reads it
        let ty = field-type(lowering.types, lowering.ir, part.ty);
        let align = size-align(lowering.types, lowering.ir, part.ty)[1];
        let held = scratch-of(lowering, ty, align);
        match value(lowering, part) {
            some(evaluated) => store-as(lowering, held, evaluated, align-code(align)),
            none => {}
        }
        let descriptor = BcValue.global(descriptor-global(lowering, shown.held));
        let text = must(module-call(lowering, lowering.index[render], [cast(lowering, descriptor, i64, 9), cast(lowering, held, i64, 9), bitcode.integer(lowering.f, bitcode.int-type(compilation, 1), if shown.display { 1 } else { 0 }),]));
        let _ = module-call(lowering, lowering.index[push], [buffer-value, text,]);
    }

    // a call of one of the module's funcs (by its index)
    module-call: func(lowering: Lower, callee: s64, args: list<BcValue>) -> option<BcValue> {
        let compilation = lowering.m;
        let operands = [BcOperand.raw(0), BcOperand.raw(1 << 15), BcOperand.raw(compilation.funcs[callee].ty as u64), BcOperand.value(BcValue.function(callee)),];
        for operand in args { operands.push(BcOperand.value(operand)); }
        inst(lowering, 34, operands, result-of(compilation, callee) != bitcode.void-type(compilation))
    }

    // ---- type descriptors (runtime/yel.h's ytype, as gen's type-desc makes them for C): what
    // std's value walker reads to show, compare or hash any value

    // a descriptor: its kind, its count (a fixed list's length; its fields, cases, kinds or flags),
    // its value's size, and its parts' descriptors, offsets and names (each an array, or null)
    ytype-type: func(compilation: BcModule) -> s64 {
        let pointer = bitcode.pointer-type(compilation);
        bitcode.struct-type(compilation, [bitcode.int-type(compilation, 8), bitcode.int-type(compilation, 32), bitcode.int-type(compilation, 32), pointer, pointer, pointer,])
    }

    // the descriptor of type held: a global, made once (its parts' after it: a type may hold itself)
    descriptor-global: func(lowering: Lower, held0: Type) -> s64 {
        let held = resolve(held0);
        let generator = lowering.types.g;
        let name = "Y_D_" + gen.type-id(generator, held);
        if lowering.made.singletons.has(name) { return lowering.made.singletons[name]; }
        let compilation = lowering.m;
        let at = bitcode.add-aggregate(compilation, name, ytype-type(compilation), [], align-code(8));
        lowering.made.singletons.set(name, at);
        let kinds = [
            "UNIT", "BOOL", "CHAR", "SIGNED", "UNSIGNED", "F32", "F64", "STRING", "BUFFER", "MAP", "LIST", "FIXED", "OPTION",
            "RESULT", "TUPLE", "ANON_RECORD", "RECORD", "VARIANT", "ENUM", "FLAGS", "HANDLE", "UNION", "FUNC", "FUTURE", "SEQ",
            "STREAM", "VALUE_RECORD", "VALUE_VARIANT",
        ];
        let kind = "UNIT";
        let count = 0;
        let parts: list<option<Type>> = [];
        let offsets: list<s64> = [];
        let names: list<string> = [];
        let layout = { fields: list<Type> -> fields.map({ shape -> size-align(lowering.types, lowering.ir, shape) }) };
        match held {
            num(numeric) => { kind = if numeric == "f32" { "F32" } else if numeric == "f64" { "F64" } else if is-signed(numeric) { "SIGNED" } else { "UNSIGNED" }; }
            bool-type => { kind = "BOOL"; }
            char-type => { kind = "CHAR"; }
            string-type => { kind = "STRING"; }
            buffer-type => { kind = "BUFFER"; }
            map-type(_) => { kind = "MAP"; }
            func-type(_) => { kind = "FUNC"; }
            future-type(_) => { kind = "FUTURE"; }
            seq-type(_) => { kind = "SEQ"; }
            stream-type(_) => { kind = "STREAM"; }
            list-type(item) => {
                kind = "LIST";
                parts.push(some(item));
            }
            fixed-list(fixed) => {
                kind = "FIXED";
                count = fixed.len;
                parts.push(some(fixed.item));
            }
            option-type(inner) => {
                kind = "OPTION";
                parts.push(some(inner));
                offsets = struct-offsets([[1, 1,], size-align(lowering.types, lowering.ir, inner),]);
            }
            result-type(sides) => {
                kind = "RESULT";
                parts = [some(sides.ok), some(sides.err),];
                offsets = struct-offsets([[1, 1,], size-align(lowering.types, lowering.ir, sides.ok), size-align(lowering.types, lowering.ir, sides.err),]);
            }
            tuple-type(members) => {
                kind = "TUPLE";
                count = members.len();
                for member in members { parts.push(some(member)); }
                offsets = struct-offsets(layout(members));
            }
            anon-record(fields) => {
                kind = if fields.name != "" { "VALUE_RECORD" } else { "ANON_RECORD" };
                count = fields.fields.len();
                for member in fields.types { parts.push(some(member)); }
                offsets = struct-offsets(layout(fields.types));
                names = fields.fields;
            }
            union-type(members) => {
                kind = "UNION";
                count = members.len();
                for member in members { parts.push(some(member)); }
                let sizes: list<list<s64>> = [[4, 4,],];
                for measured in layout(members) { sizes.push(measured); }
                offsets = struct-offsets(sizes);
            }
            named(type-name) => {
                let declared = gen.named-kind(generator, type-name);
                if declared == "record" {
                    kind = "RECORD";
                    let decl = generator.symbols.records[type-name];
                    // (an observable resource's registrar, its last field, not shown)
                    count = gen.observed-count(decl);
                    for position in 0..count { parts.push(some(decl.field-types[position])); }
                    offsets = struct-offsets(layout(decl.field-types)).slice(0, count);
                    names = decl.fields.slice(0, count);
                } else if declared == "flags" {
                    kind = "FLAGS";
                    count = generator.symbols.flags[type-name].flags.len();
                    names = generator.symbols.flags[type-name].flags;
                } else if declared == "handle" {
                    kind = "HANDLE";
                    names = [base-name(name-text(type-name)),];
                } else {
                    let decl = generator.symbols.variants[type-name];
                    kind = if declared == "enum" {
                        "ENUM"
                    } else if gen.value-variant(generator, type-name) {
                        "VALUE_VARIANT"
                    } else {
                        "VARIANT"
                    };
                    count = decl.cases.len();
                    let payload-at = struct-offsets([[4, 4,], union-layout(lowering.types, lowering.ir, type-name),])[1];
                    if declared != "enum" { offsets.push(0); }
                    for alternative in decl.cases {
                        names.push(alternative.name);
                        if declared != "enum" {
                            if alternative.has-payload {
                                parts.push(some(alternative.payload));
                                offsets.push(payload-at);
                            } else {
                                parts.push(none);
                                offsets.push(0);
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        let pointer = bitcode.pointer-type(compilation);
        let i32 = bitcode.int-type(compilation, 32);
        let address = { global: s64 -> element-address(compilation, global) };
        let null: BcElement = { ty: pointer, kind: 1, value: 0, };
        // its tables: arrays of its parts' descriptors (or null), offsets and names
        let parts-at = if parts.len() == 0 { null } else {
            let items: list<BcElement> = [];
            for part in parts {
                match part {
                    some(described) => items.push(address(descriptor-global(lowering, described))),
                    none => items.push(null),
                }
            }
            address(bitcode.add-aggregate(compilation, name + "_parts", bitcode.array-type(compilation, items.len(), pointer), items, align-code(8)))
        };
        let offsets-at = if offsets.len() == 0 { null } else {
            let items: list<BcElement> = offsets.map({ offset -> element-integer(i32, offset as u64) });
            address(bitcode.add-aggregate(compilation, name + "_offsets", bitcode.array-type(compilation, items.len(), i32), items, align-code(4)))
        };
        let names-at = if names.len() == 0 { null } else {
            let items: list<BcElement> = names.map({ label -> address(c-string-global(compilation, label)) });
            address(bitcode.add-aggregate(compilation, name + "_names", bitcode.array-type(compilation, items.len(), pointer), items, align-code(8)))
        };
        let size = size-align(lowering.types, lowering.ir, held)[0];
        compilation.globals[at].elements = [
            element-integer(bitcode.int-type(compilation, 8), kinds.index-of(kind) as u64),
            element-integer(i32, count as u64),
            element-integer(i32, size as u64),
            parts-at,
            offsets-at,
            names-at,
        ];
        at
    }

    // an aggregate's element: a global's address, an integer
    element-address: func(compilation: BcModule, global: s64) -> BcElement { { ty: bitcode.pointer-type(compilation), kind: 2, value: global as u64, } }

    element-integer: func(ty: s64, bits: u64) -> BcElement { { ty: ty, kind: 0, value: bits, } }

    // ---- constants as static data

    // a list's static data (a literal of constants, codegen's): its header, a ylist (len, cap, size,
    // items, scan), and its items, laid out as C lays them out (each at its C offset, the bytes
    // between them zero): a global each, made once; the header's
    static-list-global: func(lowering: Lower, data: StaticList) -> s64 {
        let name = "Y_SL_" + data.c-name;
        if lowering.made.singletons.has(name) { return lowering.made.singletons[name]; }
        let compilation = lowering.m;
        let items = static-items-global(lowering, data);
        let item = match resolve(data.ty) {
            list-type(contained) => contained,
            _ => unsupported(lowering.ir, "static data of {show-type(data.ty)}"),
        };
        let size = size-align(lowering.types, lowering.ir, item)[0];
        let i64 = bitcode.int-type(compilation, 64);
        let pointer = bitcode.pointer-type(compilation);
        let count = data.items.len() as u64;
        let scan: BcElement = match scan-value(lowering, item) {
            function(at) => { ty: pointer, kind: 3, value: at as u64, },
            _ => { ty: pointer, kind: 1, value: 0, },
        };
        let header = bitcode.add-aggregate(compilation, name, bitcode.struct-type(compilation, [i64, i64, i64, pointer, pointer,]), [
            element-integer(i64, count),
            element-integer(i64, count),
            element-integer(i64, size as u64),
            element-address(compilation, items),
            scan,
        ], align-code(8));
        lowering.made.singletons.set(name, header);
        header
    }

    // a list's static items, laid out as C lays them out: a global, made once
    static-items-global: func(lowering: Lower, data: StaticList) -> s64 {
        let name = "Y_SL_" + data.c-name + "_items";
        if lowering.made.singletons.has(name) { return lowering.made.singletons[name]; }
        let item = match resolve(data.ty) {
            list-type(contained) => contained,
            _ => unsupported(lowering.ir, "static data of {show-type(data.ty)}"),
        };
        let size = size-align(lowering.types, lowering.ir, item)[0];
        let placed: list<StaticScalar> = [];
        for index in 0..data.items.len() { static-scalars(lowering, item, data.items[index], index * size, placed); }
        let items = static-bytes(lowering, name, placed, size * data.items.len());
        lowering.made.singletons.set(name, items);
        items
    }

    // a static value of type t at offset bytes, as the scalars C lays it out as (into out)
    static-scalars: func(lowering: Lower, t0: Type, constant: StaticValue, offset: s64, out: list<StaticScalar>) {
        let compilation = lowering.m;
        let resolved = resolve(t0);
        if needs-representing(resolved) {
            static-scalars(lowering, represented(resolved), constant, offset, out);
            return;
        }
        let pointer-bytes = calling.pointer-bytes(lowering.abi);
        let integer = { bytes: s64, bits: u64 ->
            out.push({ offset: offset, bytes: bytes, element: element-integer(bitcode.int-type(compilation, bytes * 8), widened(bits, bytes * 8)), });
        };
        match constant {
            int(bits) => {
                let bytes = match resolved {
                    num(name) => if name == "usize" { pointer-bytes } else { int-bits(name) / 8 },
                    bool-type => 1,
                    char-type => 4,
                    _ => size-align(lowering.types, lowering.ir, resolved)[0],
                };
                integer(bytes, bits);
            }
            float(number) => {
                let single = match resolved {
                    num(name) => name == "f32",
                    _ => false,
                };
                if single { integer(4, f32-bits(number as f32) as u64); } else { integer(8, f64-bits(number)); }
            }
            text(literal) => {
                integer(8, literal.len() as u64);
                out.push({ offset: offset + 8, bytes: pointer-bytes, element: element-address(compilation, bytes-global(compilation, literal)), });
            }
            list(data) => out.push({ offset: offset, bytes: pointer-bytes, element: element-address(compilation, static-list-global(lowering, data)), }),
            parts(members) => {
                let types: list<Type> = match resolved {
                    anon-record(anonymous) => anonymous.types,
                    tuple-type(items) => items,
                    _ => unsupported(lowering.ir, "static data of {show-type(resolved)}"),
                };
                let sizes: list<list<s64>> = [];
                for item in types { sizes.push(size-align(lowering.types, lowering.ir, item)); }
                let offsets = struct-offsets(sizes);
                for index in 0..members.len() { static-scalars(lowering, types[index], members[index], offset + offsets[index], out); }
            }
        }
    }

    // bits of an integer bytes * 8 wide, sign-extended to 64 (as a constant record writes it)
    widened: func(bits: u64, width: s64) -> u64 {
        if width >= 64 { return bits; }
        let mask = (1 << width as u64) - 1;
        let low = bits & mask;
        if (low >> (width - 1) as u64) & 1 == 1 { low | (18446744073709551615 ^ mask) } else { low }
    }

    // a global of scalars placed in total bytes: a packed struct of them, the bytes between them
    // zero
    static-bytes: func(lowering: Lower, name: string, placed: list<StaticScalar>, total: s64) -> s64 {
        let compilation = lowering.m;
        let types: list<s64> = [];
        let elements: list<BcElement> = [];
        let at = 0;
        let gap = { bytes: s64 ->
            if bytes > 0 {
                let ty = bitcode.array-type(compilation, bytes, bitcode.int-type(compilation, 8));
                let zeros: BcElement = { ty: ty, kind: 1, value: 0, };
                types.push(ty);
                elements.push(zeros);
            }
        };
        for one in placed {
            gap(one.offset - at);
            types.push(one.element.ty);
            elements.push(one.element);
            at = one.offset + one.bytes;
        }
        gap(total - at);
        bitcode.add-aggregate(compilation, name, bitcode.packed-struct-type(compilation, types), elements, align-code(8))
    }

    // where each field of a struct is (each padded to its alignment), in bytes
    struct-offsets: func(fields: list<list<s64>>) -> list<s64> {
        let out: list<s64> = [];
        let offset = 0;
        for field in fields {
            offset = round-up(offset, field[1]);
            out.push(offset);
            offset += field[0];
        }
        out
    }
}

// ================================================================ C calling conventions

// C's calling conventions, as the bitcode backend needs them to call the runtime: how a C
// function's params and result cross a call on a target, as clang lowers them. A scalar goes as
// itself; a struct by value goes as each target's ABI says:
//
//   arm64 (AAPCS64, Apple's alike): at most 16 bytes in registers, as an i64 or [2 x i64] (floats
//     only, at most 4 of one kind: as an array of them); a bigger one by a pointer to a copy the
//     caller makes, and a bigger result written where a hidden pointer says (sret)
//   x86-64 (System V): at most 16 bytes as one scalar per eightbyte (an integer's, a pointer's or a
//     double's), while registers last; else in memory (byval), a bigger result by sret
//   wasm32 (the C ABI clang's wasm targets keep): a struct of one scalar as that scalar; any other
//     in memory (byval), its result by sret
//
// The caller (llvm.yel) stores a struct into memory and loads each part from it (or passes the
// memory itself), as clang does: the parts are offsets into the struct's bytes.

// a scalar of a C value: an integer (bits: its width), a float (32 or 64) or a pointer, at offset
// bytes in it
record Scalar { kind: ScalarKind, bits: s64, offset: s64, }

variant ScalarKind {
    integer,
    float,
    pointer,
}

// a C value's layout: a scalar (aggregate false: its one scalar), or a struct's scalars, size and
// alignment in bytes
record Layout { aggregate: bool, scalars: list<Scalar>, size: s64, align: s64, }

// a scalar of static data: where it is (bytes into its global), how many bytes, and its value
record StaticScalar { offset: s64, bytes: s64, element: BcElement, }

// one IR param (or result) a value crosses as: count of one scalar kind, as one scalar, an array
// of them (arm64's [2 x i64], [n x double]) or a vector (x86-64's <2 x float>), loaded from offset
// bytes into it, as clang writes it
resource Part { kind: ScalarKind, bits: s64, count: s64, offset: s64, form: PartForm, }

variant PartForm {
    scalar,
    array,
    vector,
    fields,
}

// how a value crosses a call: as itself (a scalar), in parts, or in memory (a pointer to a copy:
// byval when the copy is the callee's, as on x86-64 and wasm32; for a result, sret)
record Passing { how: PassingKind, parts: list<Part>, }

variant PassingKind {
    direct,
    parts,
    memory,
    byval,
}

// a C signature's passing: each param's, and the result's (none: void)
record Signature { params: list<Passing>, result: option<Passing>, }

module calling {
    // the ABI a target triple names: "arm64", "x86-64", "wasm32", or "" for one not known
    abi: func(triple: string) -> string {
        if triple.starts-with("aarch64") || triple.starts-with("arm64") { return "arm64"; }
        if triple.starts-with("x86_64") && !triple.contains("windows") { return "x86-64"; }
        if triple.starts-with("wasm32") { return "wasm32"; }
        ""
    }

    // whether the target's C widens a narrow integer (a bool, an 8- or 16-bit one) to 32 bits for
    // the one it gives it to (clang's signext and zeroext): x86-64's, Apple's arm64 and wasm32's do;
    // AArch64's own (AAPCS64: Linux, Windows) leaves the upper bits unknown, the receiver's to widen
    extends-narrow: func(triple: string) -> bool {
        let aarch64 = triple.starts-with("aarch64") || triple.starts-with("arm64");
        let apple = triple.contains("apple") || triple.contains("darwin") || triple.contains("macos") || triple.contains("ios");
        !aarch64 || apple
    }

    // a pointer's bytes on a target
    pointer-bytes: func(abi: string) -> s64 { if abi == "wasm32" { 4 } else { 8 } }

    scalar-bytes: func(abi: string, scalar: Scalar) -> s64 {
        match scalar.kind {
            pointer => pointer-bytes(abi),
            _ => if scalar.bits <= 8 { 1 } else { scalar.bits / 8 },
        }
    }

    // a struct's layout from its fields' scalars (each field one scalar, laid out as C does)
    layout: func(abi: string, fields: list<Scalar>) -> Layout {
        let scalars: list<Scalar> = [];
        let offset = 0;
        let align = 1;
        for field in fields {
            let bytes = scalar-bytes(abi, field);
            offset = (offset + bytes - 1) / bytes * bytes;
            scalars.push({ kind: field.kind, bits: field.bits, offset: offset, });
            offset += bytes;
            if bytes > align { align = bytes; }
        }
        { aggregate: true, scalars: scalars, size: (offset + align - 1) / align * align, align: align, }
    }

    // a struct's layout from its scalars as they are laid out (each at its offset: a nested
    // struct's padding kept), its size and alignment
    aggregate: func(scalars: list<Scalar>, size: s64, align: s64) -> Layout {
        { aggregate: true, scalars: scalars, size: size, align: align, }
    }

    // a scalar's layout (as a param or result: it goes as itself)
    scalar: func(abi: string, kind: ScalarKind, bits: s64) -> Layout {
        let single: Scalar = { kind: kind, bits: bits, offset: 0, };
        let bytes = scalar-bytes(abi, single);
        { aggregate: false, scalars: [single,], size: bytes, align: bytes, }
    }

    // how a signature's params and result cross on a target (abi: abi(triple)'s)
    signature: func(abi: string, params: list<Layout>, result: option<Layout>) -> Signature {
        if abi == "arm64" { return arm64(params, result); }
        if abi == "x86-64" { return x86-64(params, result); }
        wasm32(params, result)
    }

    direct: func() -> Passing { { how: PassingKind.direct, parts: [], } }

    in-memory: func(byval: bool) -> Passing { { how: if byval { PassingKind.byval } else { PassingKind.memory }, parts: [], } }

    in-parts: func(parts: list<Part>) -> Passing { { how: PassingKind.parts, parts: parts, } }

    // ---- arm64

    arm64: func(params: list<Layout>, result: option<Layout>) -> Signature {
        let out: list<Passing> = [];
        for parameter in params { out.push(arm64-value(parameter)); }
        let returned = match result {
            some(layout) => {
                // a float-only struct's result: as that struct ({ double, double }: clang's)
                let passing = arm64-value(layout);
                if passing.how == PassingKind.parts && passing.parts[0].kind == ScalarKind.float {
                    passing.parts[0].form = PartForm.fields;
                }
                some(passing)
            }
            none => none,
        };
        { params: out, result: returned, }
    }

    // (a result in memory: sret, which the caller makes the same way)
    arm64-value: func(layout: Layout) -> Passing {
        if !layout.aggregate { return direct(); }
        if layout.size > 16 { return in-memory(false); }
        // a homogeneous float aggregate: 1 to 4 floats of one width, in float registers
        let floats = layout.scalars.filter({ scalar -> scalar.kind == ScalarKind.float });
        if floats.len() == layout.scalars.len() && floats.len() <= 4 && floats.len() > 0 {
            let bits = floats[0].bits;
            if floats.all({ scalar -> scalar.bits == bits }) {
                return in-parts([{ kind: ScalarKind.float, bits: bits, count: floats.len(), offset: 0, form: PartForm.array, },]);
            }
        }
        let words = (layout.size + 7) / 8;
        in-parts([{ kind: ScalarKind.integer, bits: 64, count: words, offset: 0, form: if words > 1 { PartForm.array } else { PartForm.scalar }, },])
    }

    // ---- x86-64 (System V)

    x86-64: func(params: list<Layout>, result: option<Layout>) -> Signature {
        // the registers left: 6 for integers and pointers, 8 for floats
        let integers = 6;
        let floats = 8;
        let returned: option<Passing> = none;
        match result {
            some(layout) => {
                let passing = x86-64-value(layout);
                if passing.how == PassingKind.memory || (layout.aggregate && layout.size > 16) {
                    // sret: its pointer takes a register
                    integers -= 1;
                    returned = some(in-memory(false));
                } else {
                    returned = some(passing);
                }
            }
            none => {}
        }
        let out: list<Passing> = [];
        for parameter in params {
            let passing = x86-64-value(parameter);
            if passing.how == PassingKind.memory {
                out.push(in-memory(true));
                continue;
            }
            // what it needs of each kind of register, if it has them all; else all of it in memory
            let need-integers = 0;
            let need-floats = 0;
            if passing.how == PassingKind.direct {
                if parameter.scalars[0].kind == ScalarKind.float { need-floats = 1; } else { need-integers = 1; }
            } else {
                for part in passing.parts {
                    if part.kind == ScalarKind.float { need-floats += 1; } else { need-integers += 1; }
                }
            }
            if need-integers <= integers && need-floats <= floats {
                integers -= need-integers;
                floats -= need-floats;
                out.push(passing);
            } else if passing.how == PassingKind.direct {
                // a scalar goes on the stack as itself
                out.push(passing);
            } else {
                out.push(in-memory(true));
            }
        }
        { params: out, result: returned, }
    }

    // a value's eightbytes, each an integer's (any integer or pointer in it) or a float's; a bigger
    // value in memory
    x86-64-value: func(layout: Layout) -> Passing {
        if !layout.aggregate { return direct(); }
        if layout.size > 16 { return in-memory(true); }
        let parts: list<Part> = [];
        let offset = 0;
        loop {
            if offset >= layout.size { break; }
            let inside = layout.scalars.filter({ scalar -> scalar.offset >= offset && scalar.offset < offset + 8 });
            let bytes = if layout.size - offset < 8 { layout.size - offset } else { 8 };
            if inside.len() == 1 && inside[0].offset == offset {
                // one scalar at the eightbyte's start: as itself
                let scalar = inside[0];
                parts.push({ kind: scalar.kind, bits: scalar.bits, count: 1, offset: offset, form: PartForm.scalar, });
            } else if inside.len() > 0 && inside.all({ scalar -> scalar.kind == ScalarKind.float }) {
                // floats only (two f32s): one SSE register, as <2 x float>
                parts.push({ kind: ScalarKind.float, bits: 32, count: 2, offset: offset, form: PartForm.vector, });
            } else {
                parts.push({ kind: ScalarKind.integer, bits: integer-bits(bytes), count: 1, offset: offset, form: PartForm.scalar, });
            }
            offset += 8;
        }
        in-parts(parts)
    }

    // an integer part's bits, of bytes (the last eightbyte's: as few as hold them)
    integer-bits: func(bytes: s64) -> s64 {
        if bytes <= 1 { return 8; }
        if bytes <= 2 { return 16; }
        if bytes <= 4 { return 32; }
        64
    }

    // ---- wasm32

    wasm32: func(params: list<Layout>, result: option<Layout>) -> Signature {
        let out: list<Passing> = [];
        for parameter in params { out.push(wasm32-value(parameter, true)); }
        let returned = match result {
            some(layout) => some(wasm32-value(layout, false)),
            none => none,
        };
        { params: out, result: returned, }
    }

    // a struct of one scalar as that scalar; any other in memory (byval; a result: sret)
    wasm32-value: func(layout: Layout, param: bool) -> Passing {
        if !layout.aggregate { return direct(); }
        if layout.scalars.len() == 1 {
            let scalar = layout.scalars[0];
            return in-parts([{ kind: scalar.kind, bits: scalar.bits, count: 1, offset: 0, form: PartForm.scalar, },]);
        }
        in-memory(param)
    }
}
