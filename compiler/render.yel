// Render: a func's IR (ir.yel) as C: render-expr for a value, render-stmt for a statement, a body
// cut at its first terminator, a label written only where a goto names it. Part of the
// generator's module. Besides: the func's frame, the collector's
// roots (a slot for each pointer of a rooted local, written where the local is assigned).

// the func being written: its C lines; each local's C name, and its pointers (as C) and where their
// slots start (-1: it has none); how many slots its frame has; the labels of the loops around, and
// the labels a goto names
resource Render {
    g: Gen,
    f: IrFunc,
    lines: list<string>,
    names: list<string>,
    paths: list<list<string>>,
    slot-at: list<s64>,
    slots: s64,
    framed: bool,
    loops: list<s64>,
    used-labels: map<string, bool>,
}

module gen {
    // a local's C name: v<n>_<name>, or t<n> for a temporary
    local-c: func(function: IrFunc, local: s64) -> string {
        // an async func's locals: in its frame (they last while it waits)
        if function.async { return "fr->l{local}"; }
        let name = function.locals[local].name;
        if name == "" { "t{local}" } else { "v{local}_{mangle(name)}" }
    }

    line: func(rendering: Render, content: string) { rendering.lines.push(content); }

    // a local just assigned: its pointers into its slots
    root: func(rendering: Render, local: s64) {
        let first = rendering.slot-at[local];
        if first < 0 { return; }
        let paths = rendering.paths[local];
        for position in 0..paths.len() { line(rendering, "ys[{first + position}] = (void *)({paths[position]});"); }
    }

    // the local a store's target is in, where it is in the local's own value (a fixed list's item,
    // a value's field, at any depth), not through a pointer
    place-local: func(node: Node) -> option<s64> {
        match node.kind {
            local(slot) => some(slot),
            list-get(listed) => if listed.fixed { place-local(listed.list) } else { none },
            load(loaded) => if loaded.arrow { none } else { place-local(loaded.base) },
            _ => none,
        }
    }

    // ================================================================ values

    render-expr: func(rendering: Render, node: Node) -> string {
        let generator = rendering.g;
        match node.kind {
            const(constant) => constant-c(generator, constant, node.ty),
            scan(scanned) => scan-fn(generator, scanned),
            static-list(listed) => if listed.flat { "((void *){listed.c-name}_items)" } else { "(&{listed.c-name})" },
            descriptor(described) => "(&{described.c-name})",
            global(key) => global-c(key),
            local(slot) => rendering.names[slot],
            bin(binary) => "({render-expr(rendering, binary.a)} {binary.op} {render-expr(rendering, binary.b)})",
            un(unary) => "({unary.op}{render-expr(rendering, unary.a)})",
            convert(inner) => "(({c-type(generator, node.ty)}){render-expr(rendering, inner)})",
            load(loaded) => "{operand-c(rendering, loaded.base)}{if loaded.arrow { "->" } else { "." }}{loaded.path.join(".")}",
            func-ref(referenced) => referenced.c,
            call-ref(called) => {
                let args: list<string> = [];
                for argument in called.args { args.push(top-expr(rendering, argument)); }
                // a func value: its C function, given its environment first
                let callee = operand-c(rendering, called.callee);
                let env = [callee + ".env",];
                for argument in args { env.push(argument); }
                "{callee}.fn({env.join(", ")})"
            }
            call(called) => {
                let args: list<string> = [];
                for argument in called.args {
                    match argument.kind {
                        type-arg(arg) => { for part in type-arg-c(generator, called.c-name, args.len(), arg) { args.push(part); } }
                        _ => args.push(top-expr(rendering, argument)),
                    }
                }
                if find-byte(called.c-name, 36) != none || called.c-name.byte-at(0) == 40 { return expand(called.c-name, args); }
                "{called.c-name}({args.join(", ")})"
            }
            make(made) => {
                let parts: list<string> = [];
                for position in 0..made.parts.len() {
                    let value = top-expr(rendering, made.parts[position]);
                    parts.push(if made.fields[position] == "" { value } else { ".{made.fields[position]} = {value}" });
                }
                c"(({made.ctype}){ {parts.join(", ")} })"
            }
            deref(address) => "(*({c-type(generator, node.ty)} *)({render-expr(rendering, address)}))",
            address-of(place) => "(&{operand-c(rendering, place)})",
            size-of(sized) => "sizeof({c-type(generator, sized)})",
            element(indexed) => "(&(({c-type(generator, indexed.item)} *)({render-expr(rendering, indexed.base)}))[{top-expr(rendering, indexed.index)}])",
            list-get(read) => if read.fixed {
                "{operand-c(rendering, read.list)}.items[{top-expr(rendering, read.index)}]"
            } else {
                "(({read.ctype} *){operand-c(rendering, read.list)}->items)[{top-expr(rendering, read.index)}]"
            },
            // a loop's step
            assign(assignment) => "{rendering.names[assignment.dest]} = {top-expr(rendering, assignment.value)}",
            _ => panic("{rendering.f.c-name}: a statement where a value was expected"),
        }
    }

    // C that writes value's text at the buffer yb's end: by its writer (std's format.write-*), or
    // by std's value.render over its type's descriptor, the value held where it can point at it
    // (the interpolation holds the collector)
    format-line: func(rendering: Render, formatter: Formatter, value: Node) -> string {
        let shown = match formatter {
            writer(name) => { return "{name}(yb, {top-expr(rendering, value)});"; }
            render(rendered) => rendered,
        };
        let walker = rendering.g.funcs[gen.render-key()].c-name;
        let push = rendering.g.funcs["yel:std/buffer.push"].c-name;
        let held = "{c-type(rendering.g, value.ty)} y_v = {top-expr(rendering, value)};";
        let call = "{walker}((int64_t)(uintptr_t)&{type-desc(rendering.g, shown.held)}, (int64_t)(uintptr_t)&y_v, {shown.display})";
        c"{ {held} {push}(yb, {call}); }"
    }

    // an extern's type argument's C (slot: the C arguments before it, so a template's $n): its C
    // type, and its scan (a template's only where it reads it, else 0) and a template's
    // descriptor, and a key's hash and equality. Made as codegen makes the call (the helpers it
    // names with it), written again by render
    type-arg-c: func(generator: Gen, c-name: string, slot: s64, argument: TypeArg) -> list<string> {
        let out = [c-type(generator, argument.ty),];
        if !is-template(c-name) {
            out.push(scan-fn(generator, argument.ty));
        } else {
            out.push(if mentions(c-name, slot + 2) { scan-fn(generator, argument.ty) } else { "0" });
            out.push(if mentions(c-name, slot + 3) { "&" + type-desc(generator, argument.ty) } else { "0" });
        }
        if argument.key {
            out.push(key-hash-fn(generator, argument.ty));
            out.push(key-eq-fn(generator, argument.ty));
        }
        out
    }

    // a constant's C, as a value of type t
    constant-c: func(generator: Gen, constant: Constant, wanted: Type) -> string {
        match constant {
            int(value) => int-c(generator, value, wanted),
            float(value) => float-c(value, wanted),
            bool(value) => if value { "true" } else { "false" },
            unit => "0",
            null => "NULL",
            text(content) => literal(generator, content),
            case-value(valued) => "(&{singleton(valued.owner, valued.name)})",
            zero => c"(({c-type(generator, wanted)}){ 0 })",
        }
    }

    // an integer's C: an int32_t's as a number, a char's as UINT32_C, others cast to their type
    // (a negative one by its bits, the cast wrapping it)
    int-c: func(generator: Gen, value: u64, wanted: Type) -> string {
        let ct = c-type(generator, wanted);
        if ct == "bool" { return if value == 0 { "false" } else { "true" }; }
        match resolve(wanted) {
            char-type => { return "UINT32_C({value})"; }
            _ => {}
        }
        let negative = (value as s64) < 0;
        if ct == "int32_t" && !negative && value < 2147483648 { return "{value}"; }
        if negative { return "(({ct})(int64_t)UINT64_C({value}))"; }
        if value < 1000000000 { "(({ct}){value})" } else { "(({ct})UINT64_C({value}))" }
    }

    // a float's C: exactly, as a hexadecimal float (an f32's cast from it), or NAN or INFINITY
    float-c: func(value: f64, wanted: Type) -> string {
        let single = match resolve(wanted) {
            num(name) => name == "f32",
            _ => false,
        };
        let bits = f64-bits(value);
        let sign = if (bits >> 63) != 0 { "-" } else { "" };
        let exponent = ((bits >> 52) & 2047) as s64;
        let fraction = bits & 4503599627370495;
        let digits = "0123456789abcdef";
        let hex: list<string> = [];
        for position in 0..13 {
            let digit = ((fraction >> (((12 - position) * 4) as u64)) & 15) as s64;
            hex.push(digits.substring(digit, digit + 1));
        }
        let written = if exponent == 2047 {
            if fraction != 0 { "NAN" } else { "({sign}INFINITY)" }
        } else if exponent == 0 && fraction == 0 {
            "{sign}0.0"
        } else if exponent == 0 {
            "{sign}0x0.{hex.join("")}p-1022"
        } else {
            "{sign}0x1.{hex.join("")}p{exponent - 1023}"
        };
        if single { "((float){written})" } else { "((double){written})" }
    }

    // an intrinsic's C: its template with $n the nth argument's C as it is (the template puts a
    // value's in parentheses: a type's cannot be), the highest first so $1 is not read inside $12
    expand: func(template: string, args: list<string>) -> string {
        let out = template;
        for step in 0..args.len() {
            let index = args.len() - step;
            out = out.replace("$" + "{index}", args[index - 1]);
        }
        out
    }

    // a value where any expression fits (at the comma's precedence): an operator's outer
    // parentheses dropped
    top-expr: func(rendering: Render, node: Node) -> string {
        match node.kind {
            bin(binary) => "{render-expr(rendering, binary.a)} {binary.op} {render-expr(rendering, binary.b)}",
            un(unary) => "{unary.op}{render-expr(rendering, unary.a)}",
            _ => render-expr(rendering, node),
        }
    }

    // a node as the base of -> or .: in parentheses unless a local
    operand-c: func(rendering: Render, node: Node) -> string {
        match node.kind {
            local(slot) => rendering.names[slot],
            _ => "({render-expr(rendering, node)})",
        }
    }

    // ================================================================ statements

    // a body, cut at its first terminator (what follows never runs)
    render-stmts: func(rendering: Render, body: list<Node>) {
        for node in body {
            render-stmt(rendering, node);
            let ends = match node.kind {
                return(_) => true,
                break(_) => true,
                continue(_) => true,
                unreachable(_) => true,
                halt => true,
                _ => false,
            };
            if ends { return; }
        }
    }

    render-stmt: func(rendering: Render, node: Node) {
        match node.kind {
            assign(assignment) => {
                let destination = rendering.names[assignment.dest];
                match assignment.value.kind {
                    alloc(allocation) => {
                        if allocation.stack { line(rendering, "{destination} = &yr{assignment.dest};"); }
                        else { line(rendering, "{destination} = y_new(sizeof({allocation.ctype}), {allocation.trace});"); }
                    }
                    // std's writers fill a buffer (nothing collected meanwhile: the buffer is held
                    // only here)
                    interp(joined) => {
                        // (no hold where the collector runs only between turns)
                        line(rendering, c"{");
                        if !rendering.g.context.turns { line(rendering, "y_gc_hold++;"); }
                        line(rendering, "ybuffer *yb = yel_buffer_new(16);");
                        for position in 0..joined.parts.len() {
                            line(rendering, format-line(rendering, joined.formatters[position], joined.parts[position]));
                        }
                        line(rendering, "{destination} = yel_buffer_string(yb);");
                        if !rendering.g.context.turns { line(rendering, "y_gc_hold--;"); }
                        line(rendering, c"}");
                    }
                    _ => line(rendering, "{destination} = {top-expr(rendering, assignment.value)};"),
                }
                root(rendering, assignment.dest);
            }
            store(stored) => {
                line(rendering, "{render-expr(rendering, stored.target)} = {top-expr(rendering, stored.value)};");
                // an item set in a local's fixed-length list, a field of a local's value: the local's
                // slots again
                match place-local(stored.target) {
                    some(slot) => root(rendering, slot),
                    none => {}
                }
            }
            // an intrinsic's value not used: a cast says so (C warns of an unused comma)
            call(called) => line(rendering, if find-byte(called.c-name, 36) != none || called.c-name.byte-at(0) == 40 { "(void){render-expr(rendering, node)};" } else { "{render-expr(rendering, node)};" }),
            call-ref(_) => line(rendering, "{render-expr(rendering, node)};"),
            if(branch) => {
                if branch.yes.len() == 0 && branch.no.len() == 0 { return; }
                line(rendering, c"if ({top-expr(rendering, branch.test)}) {");
                render-stmts(rendering, branch.yes);
                if branch.no.len() > 0 {
                    line(rendering, c"} else {");
                    render-stmts(rendering, branch.no);
                }
                line(rendering, c"}");
            }
            loop(looping) => {
                let test = match looping.test {
                    some(tested) => top-expr(rendering, tested),
                    none => "",
                };
                match looping.step {
                    some(stepped) => line(rendering, c"for (; {test}; {render-expr(rendering, stepped)}) {"),
                    none => line(rendering, c"while ({if test == "" { "1" } else { test }}) {"),
                }
                rendering.loops.push(looping.label);
                render-stmts(rendering, looping.body);
                if looping.label >= 0 && rendering.used-labels.has("{looping.label}_c") {
                    line(rendering, "yl{looping.label}_c:;");
                }
                rendering.loops.pop();
                line(rendering, c"}");
                if looping.label >= 0 && rendering.used-labels.has("{looping.label}_b") {
                    line(rendering, "yl{looping.label}_b:;");
                }
            }
            break(label) => {
                if label < 0 || innermost(rendering, label) { line(rendering, "break;"); }
                else {
                    rendering.used-labels.set("{label}_b", true);
                    line(rendering, "goto yl{label}_b;");
                }
            }
            continue(label) => {
                if label < 0 || innermost(rendering, label) { line(rendering, "continue;"); }
                else {
                    rendering.used-labels.set("{label}_c", true);
                    line(rendering, "goto yl{label}_c;");
                }
            }
            block(grouped) => {
                if grouped.body.len() == 0 && grouped.label < 0 { return; }
                line(rendering, c"{");
                render-stmts(rendering, grouped.body);
                line(rendering, c"}");
                if grouped.label >= 0 && rendering.used-labels.has("{grouped.label}_b") {
                    line(rendering, "yl{grouped.label}_b:;");
                }
            }
            return(value) => {
                // an async func's: its result kept in its frame, and done
                // a generator's: done, its last value read (none here)
                if rendering.f.generator {
                    line(rendering, "fr->h.done = 1;");
                    line(rendering, "return 1;");
                    return;
                }
                if rendering.f.async {
                    line(rendering, "fr->result = {top-expr(rendering, value)};");
                    line(rendering, "fr->h.done = 1;");
                    line(rendering, "return 1;");
                    return;
                }
                if rendering.framed { line(rendering, "y_top = yf.prev;"); }
                // a helper's () result: C's void
                if rendering.f.void-result { line(rendering, "return;"); } else { line(rendering, "return {top-expr(rendering, value)};"); }
            }
            // where an async func goes on when stepped again, and its leaving (that state kept)
            resume(state) => line(rendering, "ya{state}:;"),
            yield(value) => line(rendering, "fr->result = {top-expr(rendering, value)};"),
            suspend(state) => {
                line(rendering, "fr->h.state = {state};");
                line(rendering, "return 0;");
            }
            unreachable(unreached) => {
                line(rendering, c"{");
                line(rendering, "y_gc_hold++;");
                line(rendering, "ybuffer *yb = yel_buffer_new(16);");
                line(rendering, format-line(rendering, unreached.formatter, unreached.value));
                line(rendering, "yel_no_match(yel_buffer_string(yb));");
                line(rendering, c"}");
            }
            halt => line(rendering, "__builtin_unreachable();"),
            // a pure value whose value is not used does nothing
            _ => {}
        }
    }

    // whether label is the innermost loop's
    innermost: func(rendering: Render, label: s64) -> bool {
        rendering.loops.len() > 0 && rendering.loops[rendering.loops.len() - 1] == label
    }

    // ================================================================ a func

    // a func as C: its declaration's line into protos, and its definition into out
    // an async func: a state machine. Its frame (Q_<name>: the task's header, its result, every
    // local, so they last while it waits; traced by the collector), its start (s_<name>: a frame
    // made, its arguments in it) and its step (the C func: back to the state it left, on until it
    // waits again, 0, or is done, 1)
    render-async: func(rendering: Render, function: IrFunc, out: list<string>) {
        let generator = rendering.g;
        // named by its step's C name (a generic func's instances each their own)
        let frame-name = "Q" + function.c-name.substring(1, function.c-name.len());
        // its locals: fields of the frame (the frame is traced: no slots)
        for local in 0..function.locals.len() {
            rendering.names.push(local-c(function, local));
            rendering.paths.push([]);
            rendering.slot-at.push(-1);
        }
        let fields = ["y_async h;", "{c-type(generator, function.result)} result;",];
        for local in 0..function.locals.len() { fields.push("{c-type(generator, function.locals[local].ty)} l{local};"); }
        generator.value-decls.push(c"typedef struct { {fields.join(" ")} } {frame-name};");
        // the frame's trace: every pointer in it
        let trace = "y_trace_" + frame-name;
        generator.helper-protos.push("static void {trace}(void *obj);");
        generator.helper-bodies.push(c"static void {trace}(void *obj) {");
        generator.helper-bodies.push("\t{frame-name} *fr = obj;");
        for path in ptr-paths(generator, function.result, "fr->result") { generator.helper-bodies.push("\ty_mark({path});"); }
        for local in 0..function.locals.len() {
            for path in ptr-paths(generator, function.locals[local].ty, "fr->l{local}") {
                generator.helper-bodies.push("\ty_mark({path});");
            }
        }
        generator.helper-bodies.push(c"}");
        generator.helper-bodies.push("");
        // the start: a frame, its parameters set
        let params: list<string> = [];
        for position in 0..function.params.len() { params.push("{c-type(generator, function.locals[function.params[position]].ty)} a{position}"); }
        let ps = if params.len() == 0 { "void" } else { params.join(", ") };
        let start = "static y_async *s{function.c-name.substring(1, function.c-name.len())}({ps})";
        generator.protos.push(start + ";");
        out.push(start + c" {");
        // its parameters rooted while the frame is made: the caller hands them over (a yel func's
        // call), and a collection in y_new would free them before the frame holds them
        let held: list<string> = [];
        if !generator.context.turns {
            for position in 0..function.params.len() {
                for path in ptr-paths(generator, function.locals[function.params[position]].ty, "a{position}") { held.push("(void *)({path})"); }
            }
        }
        if held.len() > 0 {
            out.push(c"\tvoid *ys[{held.len()}] = { {held.join(", ")} };");
            out.push(c"\ty_frame yf = { y_top, {held.len()}, ys, 0, NULL };");
            out.push("\ty_top = &yf;");
        }
        out.push("\t{frame-name} *fr = y_new(sizeof({frame-name}), {trace});");
        if held.len() > 0 { out.push("\ty_top = yf.prev;"); }
        out.push("\tfr->h.step = {function.c-name};");
        // (its name: what YEL_ASYNC_TRACE tells its tasks by, std's without its package)
        let named = if function.key.starts-with("yel:std/") { function.key.substring(8, function.key.len()) } else { function.key };
        out.push("\tfr->h.name = \"{named}\";");
        if function.release { out.push("\tfr->h.release = y_async_release_by_step;"); }
        for position in 0..function.params.len() { out.push("\tfr->l{function.params[position]} = a{position};"); }
        out.push("\treturn (y_async *)fr;");
        out.push(c"}");
        out.push("");
        // the step: back to where it waited (each wait's state a label), then on
        line(rendering, "{frame-name} *fr = y_self;");
        // each state's place (its resume: a wait's, a release's)
        let states: list<s64> = [];
        for node in flatten(function.body) {
            match node.kind {
                resume(state) => states.push(state),
                _ => {}
            }
        }
        if states.len() > 0 {
            line(rendering, c"switch (fr->h.state) {");
            for state in states { line(rendering, "case {state}: goto ya{state};"); }
            line(rendering, c"}");
        }
        render-stmts(rendering, function.body);
        let signature = "static int32_t {function.c-name}(void *y_self)";
        emit-func(generator, signature, rendering.lines, out);
    }

    render-func: func(generator: Gen, function: IrFunc, out: list<string>) {
        let rendering: Render = {
            g: generator,
            f: function,
            lines: [],
            names: [],
            paths: [],
            slot-at: [],
            slots: 0,
            framed: false,
            loops: [],
            used-labels: map.new(),
        };
        // an async func: a frame, a start and a step (its own rendering)
        if function.async {
            render-async(rendering, function, out);
            return;
        }
        // every rooted local holding pointers has slots, one for each
        for local in 0..function.locals.len() {
            let name = local-c(function, local);
            let paths = ptr-paths(generator, function.locals[local].ty, name);
            rendering.names.push(name);
            rendering.paths.push(paths);
            let rooted = !generator.context.turns && (function.rooted.len() == 0 || function.rooted[local]);
            if paths.len() > 0 && rooted {
                rendering.slot-at.push(rendering.slots);
                rendering.slots += paths.len();
            } else {
                rendering.slot-at.push(-1);
            }
        }
        // a closure's C function takes the environment it was made in first
        let params: list<string> = if function.closure { ["void *y_env",] } else { [] };
        let is-param: list<bool> = [];
        for local in 0..function.locals.len() { is-param.push(false); }
        for parameter in function.params {
            params.push("{c-type(generator, function.locals[parameter].ty)} {local-c(function, parameter)}");
            is-param[parameter] = true;
        }
        // the records kept on the stack: their storage, and (those holding pointers) the frame's
        // list of them, traced as the collector's roots
        let objs: list<string> = [];
        for node in flatten(function.body) {
            match node.kind {
                assign(assignment) => {
                    match assignment.value.kind {
                        alloc(allocation) => {
                            if allocation.stack {
                                line(rendering, c"{allocation.ctype} yr{assignment.dest} = { 0 };");
                                if allocation.trace != "NULL" && !generator.context.turns { objs.push(c"{ &yr{assignment.dest}, {allocation.trace} }"); }
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        // the frame: the collector's roots
        rendering.framed = rendering.slots > 0 || objs.len() > 0;
        if rendering.framed {
            if rendering.slots > 0 { line(rendering, c"void *ys[{rendering.slots}] = { 0 };"); }
            if objs.len() > 0 { line(rendering, c"y_stack_obj yo[{objs.len()}] = { {objs.join(", ")} };"); }
            let ys = if rendering.slots > 0 { "ys" } else { "NULL" };
            let yo = if objs.len() > 0 { "yo" } else { "NULL" };
            line(rendering, c"y_frame yf = { y_top, {rendering.slots}, {ys}, {objs.len()}, {yo} };");
            line(rendering, "y_top = &yf;");
        }
        for local in 0..function.locals.len() {
            if !is-param[local] { line(rendering, c"{c-type(generator, function.locals[local].ty)} {local-c(function, local)} = { 0 };"); }
        }
        for parameter in function.params { root(rendering, parameter); }
        if function.env-param >= 0 {
            line(rendering, "{rendering.names[function.env-param]} = y_env;");
            root(rendering, function.env-param);
        }
        render-stmts(rendering, function.body);
        // a body that gets to its end (a helper's: a trace, a lowering) pops its frame there too
        let ends = function.body.len() > 0 && match function.body[function.body.len() - 1].kind {
            return(_) => true,
            halt => true,
            _ => false,
        };
        if rendering.framed && !ends { line(rendering, "y_top = yf.prev;"); }
        let ps = if params.len() == 0 { "void" } else { params.join(", ") };
        let result = if function.void-result { "void" } else { c-type(generator, function.result) };
        // a component's export: the host's to call, by its name
        if function.export-name != "" {
            out.push("Y_EXPORT(\"{c-escape(function.export-name)}\")");
            emit-func(generator, "{result} {function.c-name}({ps})", rendering.lines, out);
            return;
        }
        let signature = "static {result} {function.c-name}({ps})";
        emit-func(generator, signature, rendering.lines, out);
    }

    // a function's prototype and its body, indented by brace: a line that closes one goes out
    // first, one that opens one goes in after
    emit-func: func(generator: Gen, signature: string, lines: list<string>, out: list<string>) {
        generator.protos.push(signature + ";");
        out.push(signature + c" {");
        let depth = 1;
        let tabs = [from-byte(9),];
        for line in lines {
            let len = line.len();
            if len > 0 && line.byte-at(0) == 125 { depth -= 1; }
            for step in tabs.len()..depth + 1 { tabs.push(tabs[tabs.len() - 1] + from-byte(9)); }
            out.push(tabs[depth - 1] + line);
            if len > 0 && line.byte-at(len - 1) == 123 { depth += 1; }
        }
        out.push(c"}");
        out.push("");
    }
}
