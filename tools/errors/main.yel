// An error test (tests/errors/*.yel), as build.yel runs each: errors <yelc> <test.yel> <out-dir>.
// The test must not compile: yelc reports each error its first lines name (// error: line:col:
// message, the diagnostic's message at that place; // error: path:line:col: message for another
// file's; // error: message, anywhere in the test), each // help: and // note: among them, and no
// other error (past one, yelc's last line counts them, which is not one more). Nothing is told
// where all is so; else what was wanted and what yelc said, and the exit is 1.

from "std:cli" include environment, exit;
from "std:filesystem" include types, preopens;
from "std:process" include process;

main: async func() {
    let given: list<string> = environment.get-arguments();
    if given.len() != 4 {
        eprint("errors <yelc> <test.yel> <out-dir>\n");
        exit.exit(err(()));
    }
    let (yelc, test, out) = (given[1], given[2], given[3]);
    let name = test.substring(match test.find-last("/") { some(slash) => slash + 1, none => 0, }, test.len());
    let told = out + "/" + name + ".err";
    let compiled = match process.run-with(yelc, [test, out + "/" + name + ".c",], "", [], told) {
        ok(ended) => match ended {
            code(n) => n == 0,
            signal(_) => false,
        },
        err(why) => {
            eprint("{test}: {why}\n");
            exit.exit(err(()));
        }
    };
    let source = (wait read(test)).unwrap-or("");
    let first = source.split("\n").get(0).unwrap-or("");
    if compiled {
        eprint("{test}: compiled, expected: {first}\n");
        exit.exit(err(()));
    }
    let output = (wait read(told)).unwrap-or("");
    let lines = output.split("\n");
    let wanted = 0;
    let well = true;
    for line in source.split("\n") {
        if line.starts-with("// error: ") {
            let want = line.substring(10, line.len());
            wanted += 1;
            let (place, message) = match want.find(": ") {
                some(at) => (want.substring(0, at), want.substring(at + 2, want.len())),
                none => (want, want),
            };
            // (a place in another file, one in the test, or none: the whole line the message)
            let (at, said) = if place.contains("/") {
                (place, message)
            } else if place == want || !all-place(place) {
                (test, want)
            } else {
                ("{test}:{place}", message)
            };
            if !lines.contains("error: {said}") || !output.contains("--> {at}") { well = false; }
        } else if line.starts-with("// help: ") || line.starts-with("// note: ") {
            let rest = line.substring(3, line.len());
            let kind = rest.substring(0, rest.find(": ").unwrap-or(0));
            if !output.contains("= {kind}: {rest.substring(kind.len() + 2, rest.len())}") { well = false; }
        } else {
            break;
        }
    }
    let errors = lines.filter({ one -> one.starts-with("error: ") }).len();
    if errors > 1 { errors -= 1; }
    if errors != wanted { well = false; }
    if !well {
        eprint("{test}: expected {wanted} errors ({first}), got:\n{output}");
        exit.exit(err(()));
    }
}

// whether text is a place in the test: digits and colons only
all-place: func(place: string) -> bool {
    for index in 0..place.len() {
        let byte = place.byte-at(index);
        if byte != 58 && (byte < 48 || byte > 57) { return false; }
    }
    true
}

// a file's bytes (none: it cannot be read)
read: async func(at: string) -> option<string> {
    let dirs = preopens.get-directories();
    for index in 1..dirs.len() { dirs[index].0.drop(); }
    let root = dirs[0].0;
    let opened = wait root.open-at(types.path-flags.symlink-follow, at, types.open-flags.create & types.open-flags.directory, types.descriptor-flags.read);
    root.drop();
    match opened {
        ok(file) => {
            let (bytes, reading) = file.read-via-stream(0);
            let out = buffer(65536);
            loop {
                let chunk = wait streams.read-some(bytes, 65536);
                if chunk.len() == 0 { break; }
                out.push-bytes(chunk);
            }
            let ended = wait reading;
            file.drop();
            match ended {
                ok(_) => some(out.to-string()),
                err(_) => none,
            }
        }
        err(_) => none,
    }
}
