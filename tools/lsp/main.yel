// yel-lsp: yel's language server: JSON-RPC over stdio (rpc.yel, over std:cli's streams and
// std:encoding/json), LSP's lifecycle and document sync (server.yel), the compiler's errors as
// diagnostics and formatting as yelc --fmt does (check.yel, server.yel), and what names name:
// definition, references, highlights, and a hover with a func's signature or a value's type
// (symbols.yel, from the checker's record of each name it resolved). Nothing of the compiler yet: hover tells the
// name under the cursor, diagnostics only lines too wide. tools/lsp/run.sh builds it and plays a
// session through it.
//
//   yel-lsp [prelude.yel]    messages on stdin, replies on stdout, framing errors on stderr; the
//                            runtime's prelude (default: its home's, YEL_HOME or the directory
//                            above its own file's, as yelc's; else runtime/prelude.yel from the
//                            directory it starts in), beside it the standard library and WIT

from "std:cli" include environment;

main: async func(args: list<string>) -> s32 {
    let given = if args.len() > 0 { args[0] } else { default-prelude() };
    // (absolute, as the editor's URIs are)
    let prelude = if given.starts-with("/") { given } else { "{environment.get-initial-cwd().unwrap-or(".")}/{given}" };
    let state = server.new(rpc.connect(), prelude);
    let code: s32 = 0;
    loop {
        match wait rpc.next(state.connection) {
            message(body) => {
                wait server.handle(state, body);
                if state.done {
                    code = state.exit-code;
                    break;
                }
            }
            malformed(error) => {
                eprint("yel-lsp: {error}\n");
                if state.connection.ended {
                    code = 1;
                    break;
                }
            }
            // stdin closed with no exit: the editor is gone
            ended => {
                code = if state.shut-down { 0 } else { 1 };
                break;
            }
        }
    }
    wait rpc.close(state.connection);
    code
}

// the prelude given none: YEL_HOME's, else its own home's (bin/yel-lsp's: the release's root;
// build/yel-lsp's: the repository's), else the one in the directory it starts in
default-prelude: func() -> string {
    for pair in environment.get-environment() {
        let (name, value) = pair;
        if name == "YEL_HOME" && value != "" { return value + "/runtime/prelude.yel"; }
    }
    let me = executable-path();
    match me.find-last("/") {
        some(slash) => {
            let dir = me.substring(0, slash);
            match dir.find-last("/") {
                some(up) => dir.substring(0, up) + "/runtime/prelude.yel",
                none => "runtime/prelude.yel",
            }
        }
        none => "runtime/prelude.yel",
    }
}
